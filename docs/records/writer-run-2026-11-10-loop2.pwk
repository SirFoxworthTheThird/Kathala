2,"version":1},{"id":"2Ptvx-dfQEfBsXJhFPitI","worldId":"foAA-e0BfCHw7HM7C_gzA","mapLayerId":null,"linkedMapLayerId":null,"name":"The harbour office","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1794354260995,"updatedAt":1794354260995,"version":1},{"id":"Au1gIqrD6e6j_7sgnG2bu","worldId":"foAA-e0BfCHw7HM7C_gzA","mapLayerId":null,"linkedMapLayerId":null,"name":"The Guild chandlery","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1794354238346,"updatedAt":1794354238346,"version":1},{"id":"CMKElmy_O6SRZfdfH3RaW","worldId":"foAA-e0BfCHw7HM7C_gzA","mapLayerId":null,"linkedMapLayerId":null,"name":"Orrin's house","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1794354186048,"updatedAt":1794354186048,"version":1},{"id":"LaF7gVeLUJc5GiY1t9-D2","worldId":"foAA-e0BfCHw7HM7C_gzA","mapLayerId":null,"linkedMapLayerId":null,"name":"Mallory's office","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1794354186133,"updatedAt":1794354186133,"version":1},{"id":"YOy7Hy4NBXVeDxkOan56s","worldId":"foAA-e0BfCHw7HM7C_gzA","mapLayerId":null,"linkedMapLayerId":null,"name":"The Gull and Lantern","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1794354045417,"updatedAt":1794354045417,"version":1},{"id":"j_PEozkBzr6Bl55spf8s5","worldId":"foAA-e0BfCHw7HM7C_gzA","mapLayerId":null,"linkedMapLayerId":null,"name":"Hollin Abbey","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1794354219913,"updatedAt":1794354219913,"version":1},{"id":"mMxMfXd_pmfG5ZKNUT9J1","worldId":"foAA-e0BfCHw7HM7C_gzA","mapLayerId":null,"linkedMapLayerId":null,"name":"The Customs House","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1794354016067,"updatedAt":1794354016067,"version":1}],"characters":[{"id":"JwjYNchpcqPGBeKCu67L3","worldId":"foAA-e0BfCHw7HM7C_gzA","name":"Nessa Brack","aliases":[],"description":"Keeps the Gull and Lantern. Broad, red-armed, a voice built for calling across water. Widow of Davey, a revenue-cutter man.","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1794353915830,"updatedAt":1794353915830},{"id":"MULaV5QYuxMGeE1WuzMWa","worldId":"foAA-e0BfCHw7HM7C_gzA","name":"Bel Ashcombe","aliases":[],"description":"Smuggler, master of the lugger Merrow. About thirty, grey eyes, gold earring, an enormous coat that belonged to someone more respectable. Fined eleven times.","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1794353913428,"updatedAt":1794353913428},{"id":"O5j-lW2Tg6s5q0Hfld1e-","worldId":"foAA-e0BfCHw7HM7C_gzA","name":"Sister Wren Oduya","aliases":[],"description":"Archivist at Hollin Abbey. Very old, very small, milky-edged eyes. Taught Tamsin letters and numbers.","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1794353914638,"updatedAt":1794353914638},{"id":"REjgysRwaxPL00WcwmGdr","worldId":"foAA-e0BfCHw7HM7C_gzA","name":"Orrin Hask","aliases":[],"description":"Harbourmaster of Saltgate for twenty years. Tamsin's uncle. Big, soft, red-faced, beard kept short for his late wife Marra. Wears the brass tide-key.","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1794353912227,"updatedAt":1794353912227},{"id":"RZwM1Sn0yCF_ge6IYbFyU","worldId":"foAA-e0BfCHw7HM7C_gzA","name":"Pell","aliases":[],"description":"Message-runner for the clerks, twelve. Gap-toothed. Everything looks like his aunt.","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1794353915236,"updatedAt":1794353915236},{"id":"TBe5yFZ9Bsucd7-b_kOIp","worldId":"foAA-e0BfCHw7HM7C_gzA","name":"Idris Mallory","aliases":[],"description":"Chief assessor at the Customs House. Pale eyes, clove pastilles, never without his hat. Took the pledge thirty years ago.","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1794353912830,"updatedAt":1794353912830},{"id":"hZxugZlR6Cxf_LgfaE8HW","worldId":"foAA-e0BfCHw7HM7C_gzA","name":"Tamsin Vey","aliases":[],"description":"Tide-clerk at the Saltgate Customs House, 24. Orphan, raised by her uncle the harbourmaster. Finds the one wrong figure in a column of four hundred.","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1794353866111,"updatedAt":1794353866111},{"id":"uwrxpudXM_9SKsEUsdsVC","worldId":"foAA-e0BfCHw7HM7C_gzA","name":"Corvan Thale","aliases":[],"description":"Magistrate of Saltgate. About fifty, clean-shaven, long clever face, dark hair silvering. Court ring, cane he does not need. Seal: tower and key.","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1794353914028,"updatedAt":1794353914028}],"items":[{"id":"-P1b_qq5m0J2nowxEdUTA","imageId":null,"worldId":"foAA-e0BfCHw7HM7C_gzA","name":"Mallory's hat","description":"","iconType":"misc","tags":[],"version":1},{"id":"VUeMq70WubV9JOGwwp0KQ","imageId":null,"worldId":"foAA-e0BfCHw7HM7C_gzA","name":"The warehouse book","description":"","iconType":"misc","tags":[],"version":1},{"id":"fuSElCr51DgscjxQ07LHj","imageId":null,"worldId":"foAA-e0BfCHw7HM7C_gzA","name":"The tide-key","description":"","iconType":"misc","tags":[],"version":1},{"id":"m57G_Jzh_D8B8mrYiwzTx","imageId":null,"worldId":"foAA-e0BfCHw7HM7C_gzA","name":"Thale's letter","description":"","iconType":"misc","tags":[],"version":1},{"id":"whM23O54CjhebwIu25B6e","imageId":null,"worldId":"foAA-e0BfCHw7HM7C_gzA","name":"The salt ledger","description":"","iconType":"misc","tags":[],"version":1}],"characterSnapshots":[{"wor