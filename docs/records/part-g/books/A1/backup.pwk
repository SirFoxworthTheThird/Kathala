d":"y6C9-EqExNyuwD7c_mI0B","characterId":"gILzK7IqKsFnAE2B2bpSU","role":"Marshal of Security","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"KFhTGWJaG8xOO8A5YvLAl","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"GgtSx3VPaKojkxWprtRj3","characterId":"X6xy9-8XqigaVlg_V-Pe5","role":null,"startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"L_389_TZMxO27F1DnY9bb","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"GgtSx3VPaKojkxWprtRj3","characterId":"ba36zRukMnL6eifQ8p0Lp","role":null,"startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"O-2r0wrcmxHeOVVnvhdeZ","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"y6C9-EqExNyuwD7c_mI0B","characterId":"kKPEd-csxdzTE5plAVRqJ","role":"Director","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"PtDjEcszThm_0i5meTxFX","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"6gdS8EoD_79pqWUmH_FON","characterId":"TC-L5WFMaTQ21rKCAn0bz","role":"Archivist","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"QHl5VP6hBAg0yzBOqrxF3","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"2xgqCKzE3VPTV4sIcgGWD","characterId":"cxOiILo2zDng_KzycPfs7","role":"Organiser","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"T-PWVGu8N0LpDy3LoSzH7","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"aEnF3hOq268c3hy5gB9ly","characterId":"q5e2z38Tumh-e8RRj3Spg","role":"Commander","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"UHz5PezilDGC5Ii5ysuT-","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"RDos_kLTbvc3Uu5fvSUzL","characterId":"CmFRcUGePy467_xgF7b73","role":"Captain, Vigil","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"VgmL2xyppLzHnoREnDW4E","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"2xgqCKzE3VPTV4sIcgGWD","characterId":"Q_bPbcsNtraUTJg8xxckn","role":"Chaplain","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"gNXWBAaMWMZYi6zPUeFUG","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"6gdS8EoD_79pqWUmH_FON","characterId":"M1JAnaMBtxnLCSlQrX2Uy","role":"Prior","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"h7nQPa9xlOYny_SYApny2","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"RDos_kLTbvc3Uu5fvSUzL","characterId":"aerWNgb1iDGcDjVj6rA85","role":"Chief Engineer, Vigil","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"m_pSxavOkop1sRJHGrkiC","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"6gdS8EoD_79pqWUmH_FON","characterId":"lXowrO8WucvQ-z-5V8Y1Z","role":"Throat-Reader","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"ntlFXZ07o7lSnH5OhNla3","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"56KYyfh-jyKWK3fbjZWPh","characterId":"O4qiUlm4ij88IkBV4Edp7","role":"Speaker","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"wF239aURsmFQj0XEqwEs_","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"CtikfV1SdQDweEp0Gv1Xt","characterId":"zO_Df258F-V33Vsnq0pOr","role":null,"startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"wsVpejt8dKuoaTH4Wk9vi","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"CtikfV1SdQDweEp0Gv1Xt","characterId":"cTQk2fuL3YmSOlYDRwOM2","role":null,"startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"zstXpeRmuL06sol3F-AzD","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"RDos_kLTbvc3Uu5fvSUzL","characterId":"L-imTuCYhT3JgMhau4AL8","role":"Admiral","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692}],"factionRelationships":[],"knowledgeFacts":[{"id":"015Zt7TUQNzQXC3J66jYk","worldId":"os-ym7EwunyTMDieuRMb1","title":"The Founder's Fork was Ambrose's","description":"The Wardens' relic is Ambrose Lyle's tuning fork. Its engraving reads 'for Clare', his daughter — not 'For Clarity'.","tags":["anchor"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"I7ePb3LHnBkbwM-0-KziD","worldId":"os-ym7EwunyTMDieuRMb1","title":"The Keeping is an instrument of governance","description":"Hesper Vane designed the Keeping, and sold it to the Ostrander Board in her Memorandum, as the means by which the Reach would go on sending glass and obeying after the Withdrawal: a sacrifice that makes the one who reads the Needle indispensable.","tags":["the lie","core"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"IkiPA02xh8HVNK_h_V5Bz","worldId":"os-ym7EwunyTMDieuRMb1","title":"Teo flew to cross, not to keep","description":"Teo Kesh never released her glass. She flew the Small Mercy into the Long Night to cross to the Inward with Ambrose's proof.","tags":["Concession","core"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"JMlrWvUPIQ5h6yONcuW2C","worldId":"os-ym7EwunyTMDieuRMb1","title":"The Bell can ring the throat","description":"Ambrose's old sounding buoy, driven with the harp and tuned to the Fork, can set the throat ringing at its true pitch and shake the accretion loose.","tags":["Ebb"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"KFv4LDL4RBR_iU2xaUan9","worldId":"os-ym7EwunyTMDieuRMb1","title":"Hesper Vane was the First Warden","description":"The First Warden of the Throat, founder of the Wardens, was Hesper Vane.","tags":["the lie","core"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"LBh90vXXADKopblOGAVG4","worldId":"os-ym7EwunyTMDieuRMb1","title":"The Draw is rigged","description":"The Wheel is weighted: for the last four Draws the Shoals foils were cut at half-thickness so they ride higher in the drum, and at every Draw one name — the sleeve name — is not drawn at all but carried in by the High Warden.","tags":["Severance"],"readerLearnsAtEventId":"aBdlcGQrMOBsNYer8rVoH","originEventId":null,"createdAt":1793092190073,"updatedAt":1793108997313,"version":2},{"id":"VI4kk959-9KoNUaZElIl6","worldId":"os-ym7EwunyTMDieuRMb1","title":"The throat is choked with glass","description":"The Needle is not starving. Its waist is crowded with a vast accretion of brine-glass: it is choking.","tags":["Ebb"],"readerLearnsAtEventId":"THBsTqir_QIx3ULEcfdlD","originEventId":null,"createdAt":1793092190073,"updatedAt":1793109150469,"version":2},{"id":"W9g9rAbp1-ejWBbEnT3sl","worldId":"os-ym7EwunyTMDieuRMb1","title":"The Keeping makes the scar","description":"Glass released at the waist does not burn away. It accretes, a layer for each Keeping. Sixty Keepings will close the throat.","tags":["the lie","core"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"Woh-PRBGK-YHo6TLA_Y87","worldId":"os-ym7EwunyTMDieuRMb1","title":"The oldest Return is the Small Mercy","description":"Among what the Needle gave back at the Sixtieth Narrowing was Teo Kesh's tug, with Teo in it, and her log.","tags":["anchor","core"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"WsEl90_k-wjIayDw1wKNR","worldId":"os-ym7EwunyTMDieuRMb1","title":"The Narrowing passes on its own","description":"The deep Narrowing of 2291 is the trough of a slow beat between two natural rhythms. The Needle recovers whether or not anything is fed to it. Every Keeping since has been timed to a recovery already under way.","tags":["the lie","core"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"Xt4F40RHLSpkWlBxYLoeU","worldId":"os-ym7EwunyTMDieuRMb1","title":"Mor chose Pell","description":"High Warden Mor had Pell Asante's name chosen, not drawn, to bend Speaker Efua Asante's vote on the war.","tags":["Severance"],"readerLearnsAtEventId":"n73cd1cDO-B8ga_Z2G4au","originEventId":null,"createdAt":1793092190073,"updatedAt":1793109509665,"version":2},{"id":"_6wDAG_zh_hiWOLCKLRJI","worldId":"os-ym7EwunyTMDieuRMb1","title":"The oldest harp records were cut","description":"The Anchorhold archive holds no harp records from before 2 May 2291: forty-four years of Concession records were 'transferred to the keeping of the First Warden' and never returned, and the rack was forced. The archivists call it the Blank Year.","tags":["Severance","the lie"],"readerLearnsAtEventId":"vc7JLtzv1t642c2LR_7a5","originEventId":null,"createdAt":1793092190073,"updatedAt":1793108997313,"version":2},{"id":"icsjrVZimN_nxUy3CkJpV","worldId":"os-ym7EwunyTMDieuRMb1","title":"Ambrose was murdered","description":"Ambrose Lyle did not fall from the Lectern gallery; Brandt's men killed him on Hesper Vane's order.","tags":["Concession"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"q8_9hak1Uv92PbWh1XBsw","worldId":"os-ym7EwunyTMDieuRMb1","title":"The High Wardens inherit the lie","description":"Each High Warden, at investiture, reads the First Warden's Testament and learns that the Keeping is unnecessary; each keeps it.","tags":["Severance","the lie"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"vg237gzCd8I57sB9PpQke","worldId":"os-ym7EwunyTMDieuRMb1","title":"The Hunger Tone is not the Fork's note","description":"The harp has been tuned since the First Keeping to the Hunger Tone, which is not the pitch of the Founder's Fork. Tuned to the Hunger Tone, the harp cannot hear the Needle recover.","tags":["the lie"],"readerLearnsAtEventId":"vc7JLtzv1t642c2LR_7a5","originEventId":null,"createdAt":1793092190073,"updatedAt":1793108947878,"version":2}],"knowledgeReveals":[{"worldId":"os-ym7EwunyTMDieuRMb1","factId":"Xt4F40RHLSpkWlBxYLoeU","characterId":"TC-L5WFMaTQ21rKCAn0bz","eventId":"n73cd1cDO-B8ga_Z2G4au","note":"","id":"2YNOWaPliF96h88fxp_bQ","createdAt":1793109509649,"updatedAt":1793109509649,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","factId":"VI4kk959-9KoNUaZElIl6","characterId":"lXowrO8WucvQ-z-5V8Y1Z","eventId":"THBsTqir_QIx3ULEcfdlD","note":"","id":"3Y-ClIo8zO6IE4-hM3_Ew","createdAt":1793109150387,"updatedAt":1793109150387,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","factId":"VI4kk959-9KoNUaZElIl6","characterId":"M1JAnaMBtxnLCSlQrX2Uy","eventId":"EPajjYElKpPpwffw-xPff","note":"","id":"EZN-FgjsNar7FxjCdnm-x","createdAt":1793109151439,"updatedAt":1793109151439,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","factId":"vg237gzCd8I57sB9PpQke","characterId":"TC-L5WFMaTQ21rKCAn0bz","eventId":"vc7JLtzv1t642c2LR_7a5","note":"","id":"Kbb7MDvu4bV__ghBk18bW","createdAt":1793108947841,"updatedAt":1793108947841,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","factId":"LBh90vXXADKopblOGAVG4","characterId":"TC-L5WFMaTQ21rKCAn0bz","eventId":"n73cd1cDO-B8ga_Z2G4au","note":"","id":"QSEu2R2hnEf687mMaRdCo","createdAt":1793109509521,"updatedAt":1793109509521,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","factId":"Xt4F40RHLSpkWlBxYLoeU","characterId":"CmFRcUGePy467_xgF7b73","eventId":"n73cd1cDO-B8ga_Z2G4au","note":"","id":"WrvQL5fpnT8J-k-YwzMp3","createdAt":1793109509592,"updatedAt":1793109509592,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","factId":"vg237gzCd8I57sB9PpQke","characterId":"lXowrO8WucvQ-z-5V8Y1Z","eventId":"THBsTqir_QIx3ULEcfdlD","note":"","id":"Y4Xe21oQnC1LyRQKP4wc-","createdAt":1793109150454,"updatedAt":1793109150454,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","factId":"vg237gzCd8I57sB9PpQke","characterId":"CmFRcUGePy467_xgF7b73","eventId":"n73cd1cDO-B8ga_Z2G4au","note":"","id":"azjl-c0cJrEExhQcQuDgd","createdAt":1793109509563,"updatedAt":1793109509563,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","factId":"_6wDAG_zh_hiWOLCKLRJI","characterId":"CmFRcUGePy467_xgF7b73","eventId":"n73cd1cDO-B8ga_Z2G4au","note":"","id":"fRNP4A_u5Ij8lKTX8_MET","createdAt":1793109509538,"updatedAt":1793109509538,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","factId":"_6wDAG_zh_hiWOLCKLRJI","characterId":"TC-L5WFMaTQ21rKCAn0bz","eventId":"vc7JLtzv1t642c2LR_7a5","note":"","id":"gxtI8Exh8VJ-rskzlSxqd","createdAt":1793108947800,"updatedAt":1793108947800,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","factId":"VI4kk959-9KoNUaZElIl6","characterId":"eZ6bZoVov0ITLh7fBrY_0","eventId":"Ths_2rRHebAxDhyJU5avw","note":"","id":"k6J9T5L-c-5IDZCMHb2jW","createdAt":1793109150774,"updatedAt":1793109150774,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","factId":"Xt4F40RHLSpkWlBxYLoeU","characterId":"O4qiUlm4ij88IkBV4Edp7","eventId":"-WBiz1PuSJ5VBpOzkPGLv","note":"","id":"txF_cDUTqFiyvguE4mSt5","createdAt":1793109510365,"updatedAt":1793109510365,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","factId":"LBh90vXXADKopblOGAVG4","characterId":"CmFRcUGePy467_xgF7b73","eventId":"aBdlcGQrMOBsNYer8rVoH","note":"","id":"uZPTa374VCnCNYoaI22f3","createdAt":1793108948429,"updatedAt":1793108948429,"version":1}],"characterGoals":[],"sceneTexts":[{"id":"-vzwS-YzQjVrr5WC6Y_eJ","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"N5ZwGMDS7hhoaJ_4H7mXu","text":"She was sitting on the dock floor with her back against the Mercy's landing strut and a bottle of Fat Diz's worst between her knees when Ambrose found her, a little after midnight.\n\nLulu was asleep in the Mercy's cockpit above them, curled up in the pilot's seat under Teo's flight jacket with her bag of bolts in her arms. Mother Salome had brought her down from the gallery that afternoon, after, and stood with her on the dock while the Mercy limped in on one attitude jet with her tow-hook hanging off, and Lulu had walked across the dock to Teo before the engines had even spun down and said, *Where's the Brannock?* — just that, with her bolts in her arms — and Teo had knelt down on the dock and told her. Lulu had not cried. She had listened, and nodded, and asked if she could sit in the Mercy, and had climbed up into the pilot's seat and sat there looking out of the canopy at the empty cradle where the Brannock should have been, until she fell asleep.\n\nAmbrose sat down on the dock floor beside Teo without asking. He did it stiffly, an old man getting down onto steel, and when he was down he sat for a while with his long arms round his knees, looking at the empty cradle.\n\n\"I'm sorry,\" he said.\n\n\"Everyone's sorry.\" She drank. \"She's sorry. She said so. On all the screens. *Remember him.*\" She laughed, a bad sound. \"They struck his debts. Lulu's free. She's nine and she's free. Isn't that wonderful.\"\n\nHe did not say anything.\n\n\"It worked, though.\" She turned the bottle in her hands. \"Didn't it. I heard the broadcast. The waist came up. He went in and he did it and it came up. He didn't die for nothing. That's something. Isn't it? Tell me that's something.\"\n\n\"It didn't help,\" said Ambrose.\n\nShe went still.\n\n\"It didn't help,\" he said again, very quietly, looking at the cradle. \"The waist would have come up at a quarter past two if he had stayed in the Lantern. There's a short rhythm in it — a pause every few days. I told her about it. She found out when the next one was. She timed the trial to it.\" He was quiet for a moment. \"And there's something else. The buoy heard it. When the glass went in — something stayed. At the waist. A sort of ringing. It's still there. It wasn't there before. I don't know what it is. But the glass didn't — feed anything, Teo. It didn't splint anything. It went in, and it burned, and something stayed, and that's all.\"\n\nTeo put the bottle down on the dock floor, very carefully, so it would not fall over.\n\n\"Then say so,\" she said.\n\n\"To whom?\"\n\n\"To *everyone*. Get on the screens. Get in the Assembly Hall and stand on the platform and tell them what you just told me. Tell them about the pause. Tell them she timed it. Tell them about your ringing.\" She was on her knees now, facing him, and she did not remember getting there. \"You're the harp man. They'll believe you. They believe your charts, every pilot on the station flies by your charts. Tell them.\"\n\n\"I can't prove it.\"\n\n\"You just — \"\n\n\"I can't *prove* it, Teo.\" For the first time his voice cracked. \"I have a hypothesis. I have four paper traces and a sum on an envelope and a ringing I can't explain. If I stand up in the Assembly Hall and say that the Director is lying, she will stand up after me and say, in numbers, that the waist came up after the glass went in, and every person in that hall saw it come up. And they'll believe her. Of course they will. She has the numbers. All I've got is *why*.\" He pressed the heels of his hands against his eyes. \"And I sail in twenty-six days. I have a berth. Cabin twelve. I have a daughter I haven't seen since she was four. If I stand up in that hall — \"\n\n\"You'll lose your berth.\"\n\n\"I'll lose my berth,\" he said, behind his hands. \"At least.\"\n\nTeo looked at him for a long time: an old man in a cardigan, sitting on the floor of a dock in the middle of the night with his hands over his face.\n\nThen she spat. On the dock, between them. She had not known she was going to do it.\n\n\"He went in for twenty-six days of your life,\" she said. \"That's all he cost. Twenty-six days and a cabin.\" She stood up. She was not quite steady. \"Go home, harp man. Go home to your daughter. I hope she's worth it.\"\n\nShe climbed up the Mercy's strut into the cockpit, and lifted Lulu out of the pilot's seat in her flight jacket, bolts and all — the girl did not wake, only muttered something and put her arms round Teo's neck — and climbed down again with her, and walked away across the dock toward the Lantern Row lift without looking back.\n\nWhen she reached the lift and turned round to press the button, he was still sitting where she had left him, on the floor, under the Mercy's broken tow-hook, in the dark.","wordCount":895,"createdAt":1793109315874,"updatedAt":1793109315874},{"id":"2jOBjpMcUtpB6yVGA8e8x","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"MsoDYs8uBRN2hIMogMo0z","text":"Pell called on the first of November, on the Anchorhold link, at the hour the nine were allowed calls.\n\nShe looked well. That was the first thing. Her face filled the little screen in Juno's cabin, flushed and bright-eyed, her hair cut short now in the Keepers' fashion, the bead at her throat on its black cord, and behind her a common room with a window on the mouth and somebody laughing off-screen.\n\n\"You look terrible,\" Pell said cheerfully. \"Are you eating?\"\n\n\"I'm eating.\"\n\n\"You're not. You've got your not-eating face. Mum's got it too, I saw her on the Assembly broadcast. You've both got it.\" Pell grinned. \"I'm eating enough for all three of us. They feed us like we're being fattened for something.\"\n\n\"Pell.\"\n\n\"It's a joke, Juno.\" Pell's grin softened. \"Sorry. It's what we do up here. You have to. Ezra says if you don't laugh about it you have to think about it, and if you think about it you'll go out of the airlock without a suit.\" She glanced off-screen. \"He's very funny. He does an impression of the flight instructor that makes Tavish laugh, and Tavish doesn't laugh at anything. You'd like him.\"\n\nThey talked for twenty minutes. Pell did most of the talking. The simulators, which she was good at, it turned out — she had a feel for the throat's line, the instructors said; she had the second-best scores in the nine. Abbe Sorrell, the Shoals girl, who had started eating again and had told Pell, at three in the morning, about her mother's ice-farm on Corrie Rock. Sister Quill, who came to the harp hall most nights and sat with Pell under the dome and talked to her about the records, and had looked at the painting for a long time and said it matched something old. The harp itself. *I go and sit with it every night. I can't sleep anyway. I just sit and listen. It's like being inside it already.*\n\nJuno listened, and nodded, and said the things you say, and the slate lay face-down on the desk beside the screen where Pell could not see it, with its list of names in a dead clerk's careful hand.\n\n\"You sound strange,\" Pell said, near the end.\n\n\"I'm tired.\"\n\n\"No. Strange. You keep looking at something.\" Pell peered at the screen as if she could see round its edge. \"What's wrong?\"\n\n*They chose you,* Juno thought. *The Needle didn't. A man chose you, with a foil in his sleeve, to make our mother vote for a war. And I can't prove it, and if I tell you, you'll either not believe me or you'll believe me, and I don't know which is worse.*\n\n\"Nothing's wrong,\" she said. \"The war's wrong. I'm tired. That's all.\"\n\nPell looked at her for a long moment through the screen, with the mouth of the Needle behind her in the common-room window, huge and dark. Then she smiled, the listening smile.\n\n\"Thirty-four days,\" she said. \"Then you'll be at the Anchorhold. On escort. You'll be right there when I go in. Sister Quill says the escort ships are close enough to see the skiffs go into the mouth. You'll see me go.\" Her voice was very gentle. \"I'm glad it's you. I'm glad you'll be the one watching.\"\n\nThe link closed. Juno sat in the dark of her cabin for a long time.\n\nThen she turned the slate over, and read the list again — all four Draws, all four sleeve names, the four careful lines of who each one had belonged to and why — and then, because she could not help it, she read the last line again, the one about Rhee's brother, and the complaint that half their year had signed, and she put her hand over her mouth.\n\n*It's never you,* the clerk had said. *It's always the one you love.*\n\nShe thought of Rhee's message, sent on the old cadet band. *Ask them how the names are chosen.* He had known. Perhaps not this, not the sleeve, not the foils. But he had known something, for eleven years, and he had tried to tell her in the only way he could.\n\nShe did not answer him. Not yet. But she took a blank sheet of paper from her desk drawer — paper, not a slate, nothing that could be logged — and wrote on it in pencil the frequency of the old cadet band, and folded it small, and put it in the breast pocket of her uniform, over her heart, where she would know it was there.\n","wordCount":769,"createdAt":1793108946578,"updatedAt":1793108946578},{"id":"48a1if9G_J_oti7MYzXYH","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"4LM2G0ftK_Z4aA7o0lcyX","text":"The charter came through on the dispatch board at five in the morning, which was how Teo knew it was going to be bad.\n\n*PRIORITY CHARTER. TUG AND PILOT, ONE DAY. DOCK FOUR, 0800. PASSENGER AND CARGO TO THROAT MOUTH, INNER MARKERS. RATE: 600 MARKS AGAINST INDENTURE.*\n\nShe read it three times on the little screen in her bunk-cube in the pilots' dorm on Anchorage, with the cube's one bulb buzzing over her head and somebody being sick in the cube next door. Six hundred marks. She had never seen a rate like it. Six hundred marks was three months of glass runs. Six hundred marks was a whole column on the chit. And *inner markers*, which meant past the last beacon, past the place where the lanes stopped and the throat began, into the zone where the tidal shear came off the mouth in long invisible waves and tore at your hull like a dog at a rope. Nobody went to the inner markers in a tug. You went to the inner markers in a throat-hauler with a reader aboard and shear-plating three hands thick.\n\nShe was at Dock Four at seven-forty.\n\nThe passenger was already there. She had expected a Concern technician, some bright young thing from the Lectern with a slate and an attitude. What she got was an old man in a cardigan, sitting on a packing crate on the dock floor with his hands between his knees and a pair of reading glasses pushed up on his forehead, looking up at the Small Mercy in her cradle with an expression of mild, polite concern, as if she were a dog that might or might not bite.\n\n\"Miss Kesh?\" He stood up when he saw her. He was taller than she had thought. \"Ambrose Lyle. From the Lectern. I'm told you're the best tug pilot on the station.\"\n\n\"Who told you that?\"\n\n\"The dispatch office. I asked them who would actually be able to do it, rather than who was free, and they gave me your name, and then they gave me a long list of reasons I shouldn't hire you, and then they said that was the same thing.\" He smiled, slightly. \"I'm sorry about the hour.\"\n\n\"You're the harp man.\"\n\n\"I'm the harp man.\"\n\nShe looked at him. She had heard of him all her life without ever seeing him, the way you hear of the Director or the Board: the man who read the Needle. The man who told the pilots where the throat would be. Every through-pilot on the station had his charts on their boards and swore by them, and she had sometimes thought of him as a sort of oracle in a dome, remote and terrible. He had a coffee stain on his cardigan.\n\n\"What's the cargo?\" she said.\n\nHe showed her. It was in the crate he had been sitting on: a long cylinder of dull grey alloy two metres from end to end, with a cluster of short fins at one end and a lattice of fine wires at the other, strung on a frame like the ribs of an umbrella. It looked hand-made. It looked very carefully hand-made.\n\n\"It's a sounding buoy,\" he said. \"It listens to the throat, the way the harp does. Only from much closer. The harp is a long way back, and the Narrowing — \" He stopped. \"The Narrowing is doing things I can't hear properly from the Lectern. I want ears at the mouth. Right at the edge, as close as I can get it. If I can put it at the inner markers it'll sit there in the mouth's pull and sing to me for years.\"\n\n\"You want me to fly into the shear and throw that out the airlock.\"\n\n\"I want you to fly into the shear and let me throw it out the airlock,\" he said. \"I'll do the throwing. I would very much like you to do the flying.\"\n\nShe almost laughed. She did not. \"Why me? You've got a dozen throat-haulers with shear-plate sitting in the yards with nowhere to go. The lanes are closed half of every shift.\"\n\n\"The throat-haulers belong to the Concern,\" Ambrose Lyle said, \"and the Concern would like to know why I want to go, and I'd rather not tell it until I know what I'm going to find.\" He looked at her over the buoy. \"You're contract. You belong to yourself.\"\n\n\"I belong to the Concern to the tune of forty-one thousand marks.\"\n\n\"Yes,\" he said gently. \"But not to the Director's office. Not this morning.\"\n\nTeo thought about that for a while.\n\n\"Six hundred,\" she said.\n\n\"Six hundred.\"\n\n\"And you sign a waiver that if you die it was your idea.\"\n\n\"I'll write it out by hand,\" he said, and she believed him.\n\nThey loaded the buoy into the Mercy's little cargo bay together, with the dock's chain-hoist and a lot of swearing on her part and a lot of apologising on his. When it was in its straps he did a thing she did not expect. He took out of his jacket pocket a fork — a tuning fork, the brass kind, with a long stem — and struck it against the heel of his hand, and fitted the stem into a socket in the buoy's end-plate that she had taken for a mounting bolt. It slid in like a key. The fine wires of the lattice, which had been still, began very faintly to hum. He bent close to them with his head on one side, listening, for a long minute, and turned a screw somewhere inside the frame with a jeweller's driver, and listened again. Then he drew the fork out of its socket and the humming died, and he wiped the fork on his cardigan and put it back in his pocket.\n\n\"What was that?\" she said.\n\n\"Calibration. Everything has to be tuned to something.\" He patted his pocket. \"That's what everything I've built is tuned to. The harp, the buoy, all of it. So that they all agree with one another about what they're hearing.\"\n\n\"What if you lose it?\"\n\nHe looked startled, and then amused, and then something else. \"Then I suppose nothing would agree with anything,\" he said. \"I try not to lose it.\"\n\nShe had seen the engraving on the stem when he wiped it. *FOR CLARE.*\n\n\"Who's Clare?\" she said, and immediately wished she had not, because his face changed.\n\n\"My daughter,\" he said. \"She's in Ardent. I haven't seen her since she was four.\" He did not look at her. \"I'm going home on the *Providence*. In April. I'm going to give it to her.\"\n\n\"That's a strange present.\"\n\n\"Yes,\" he said. \"She'll think so too.\"","wordCount":1127,"createdAt":1793093336084,"updatedAt":1793093336084},{"id":"4LHguFBmr9daFyQSt4T0e","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"n73cd1cDO-B8ga_Z2G4au","text":"The *Vigil*'s wardroom was the size of a large cupboard and smelled of burned insulation, and at two in the morning, twenty-two hours after the raid, it held the captain, the archivist, a heap of singed books, and a brass tuning fork lying on the table between them on a folded napkin.\n\nPell was asleep in Juno's cabin, sedated by the ship's medic. The other surviving Keepers were in the Anchorhold's spindle, in the High Warden's own guest rooms, under guard. Four of the nine had died when the second wheel was struck: Ezra Lind, and Tavish Orme, and the baker, and the woman who had once been a novice. The Wardens had issued a statement within the hour. *The Shoals have murdered the Keepers of the Thirtieth. The Draw will be held again, for four, at the Compact Hall, in five days.* The Keeping would go on. The glass had survived, behind its armoured doors. The glass always survived.\n\nAdaeze had not let go of the Fork until Juno's medic tried to take her robe off to dress the burns on her hands, and then she had taken it out and laid it on the table and sat looking at it, with her bandaged hands in her lap, for a long time.\n\n\"I struck it,\" she said. \"Ten days ago. Did I tell you?\"\n\n\"No.\"\n\n\"I'm the archivist. I clean it once a month. I've cleaned it two hundred times.\" She looked at it on its napkin. \"Ten days ago I struck it. Against my hand. It's a tuning fork. You're supposed to strike them.\" She laughed, a little, without much breath. \"Your sister asked me once what it was for, a tuning fork you don't tune with. I said it was the sort of question she would ask.\"\n\nJuno waited.\n\nAdaeze told her. The First Keeping's records. The spool for the second of May that was the first spool in the rack, and the nothing before it. The catalogue: *transferred to the keeping of the First Warden. Not returned.* The forced rack, the sheared clamps. The Blank Year. And the Fork, struck in the alcove, its note going out into the hall and meeting the harp's drone and fighting it. *Wah. Wah. Wah.* The Hunger Tone and the Fork, not the same note.\n\n\"I don't know what it means,\" she said. \"I've been trying to think what it means for ten days. Somebody took forty-four years of records out of the archive on the day after the First Keeping and never brought them back. Somebody tuned the harp to a note that isn't the note of the instrument it's supposed to have been tuned by. And the order has been calling the gap a joke for three hundred years.\" She looked up. \"I keep thinking that if it were a mistake, someone would have noticed. Someone would have struck the Fork before me. In three hundred years. Someone.\" Her voice went very quiet. \"Unless they did. And then they did what I've done. Which is nothing.\"\n\nJuno looked at her for a while. Then she said, \"Danny. Would you get it, please.\"\n\nMarsh, who had been standing at the door, went out. He came back four minutes later with flour on his sleeves and a blank Navy slate in his hand, and put it on the table beside the Fork.\n\n\"The galley flour bin,\" he said, to Adaeze's look. \"The Captain said somewhere stupid.\"\n\nJuno turned the slate round and pushed it across the table, and told her about Mara Teague.\n\nThe archivist read the list. She read it slowly, the way she read everything, with her bandaged finger moving down the lines. The half-thickness foils. Nineteen of thirty-six. The sleeve names: four Draws, four names, four careful lines in a dead clerk's hand. She stopped at the last one and read it twice. Then she sat back.\n\n\"Teague,\" she said. \"Mara Teague. I knew her. I didn't know she — \" She stopped. \"She died in custody. I saw the notice. A heart condition.\"\n\n\"Yes.\"\n\n\"She didn't have a heart condition. She used to run the stairs at the Hall at lunchtime. All eight hundred metres. Every day for nineteen years.\" Adaeze closed her eyes. \"Oh, Mara.\"\n\n\"Is it true?\" said Juno. \"You'd know. You keep the Draw records. Is it true?\"\n\nAdaeze did not answer at once. She opened her eyes and looked, not at the slate, but at the singed heap of books on the floor in the corner of the wardroom. Then she got up, stiffly, and knelt down by the heap and went through it with her bandaged hands, slowly, until she found what she was looking for: a thin black ledger with a scorched spine. She brought it back to the table and opened it.\n\n\"The Draw ledger,\" she said. \"The archive's copy. The clerks send one up after every Draw; I file it. Every foil, every name, in the order they come out of the Wheel.\" She turned the pages. \"I've always noticed — I thought it was a clerk's mark. A tick. One name in every Draw has a little mark beside it. A small *s*, in the margin. I asked about it once, when I was new. They said it meant the foil had been *sealed*. Checked. I never — \" Her finger stopped. \"Here. The Twenty-Ninth.\"\n\nJuno leaned over. The ledger's page, in a clerk's neat hand: nine names. And beside the third, in the margin, very small, an *s*.\n\n*Callum Calder.*\n\nAdaeze turned to the end, to the newest pages, to the Thirtieth, in the same hand, dated the eighth of October. Nine names. She did not have to look for it. Juno could see it from across the table.\n\n*7. Pell Asante, of the Speaker's house.* And in the margin, small and neat and ordinary: *s*.\n\nNeither of them said anything for a long time.\n\n\"He chose her,\" said Adaeze at last. Her voice was perfectly level and her face was grey. \"The High Warden. He put her name in his sleeve and drew it out and read it to the Hall. To make your mother — \" She stopped. \"And he declined your petition. To your face. He told you the Draw was the only fair thing in the Reach.\"\n\n\"Yes,\" said Juno.\n\nThe archivist looked down at the Fork on its napkin. She reached out one bandaged hand and touched it, very lightly, the way you would touch the face of someone sleeping.\n\n\"I took the grey,\" she said, \"because somebody has to keep the records honestly.\" She was quiet. \"I've been keeping them honestly for twenty years. All of them. Every name.\" She laid her hand flat over the Fork. \"I just never read the margins.\"","wordCount":1133,"createdAt":1793109506781,"updatedAt":1793109506781},{"id":"72P-ncMqgaAnTkPsyxuzT","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"m1shtvj-OXNak3rDkSDEs","text":"The sled was riding high again, and Teo Kesh had been cursing it for an hour.\n\nForty tonnes of crated brine-glass on a tow-frame half a kilometre long, and the loaders at the Pans had stacked it heavy at the back the way they always did when the shift was ending and nobody cared, so that every time she fired the Small Mercy's mains the whole frame wanted to swing round and come and look at her. She had trimmed it twice. She had told Pans Loading what she thought of their mothers. Now she sat with her boots up on the console and her hands loose on the yoke, feeling the tow through the seat of her coveralls, and let the tug do what tugs were for, which was pull.\n\nThe Small Mercy was forty-one years old. She had been Teo's mother's before she was Teo's, and somebody else's before that, and she had been re-hulled twice and re-engined once and patched more times than anybody had logged. Her cockpit smelled of coolant and of the oranges Teo bought at a ruinous price from the hydroponics barge and ate in the long middle of the run, and of Teo, and of forty years of other pilots under that. There was a crack in the forward canopy shaped like a river delta. There was a clip on the console where the debt chit lived. Teo did not look at the chit. She knew what it said. It said 41,212 marks, and on the line under that, in smaller figures, what she had paid off this month, which was less than what had been added to it, which was the joke.\n\nAhead of her, over the curve of the console and through the delta crack, the Needle was coming up.\n\nYou did not see it so much as see what it did. A patch of sky the width of a thumbnail at arm's length where the stars were wrong: pulled long, smeared into arcs, crowded at the rim like fish against a net. At the centre of the wrongness there was a darkness that was not black but a deep bruised colour no one had a good name for, and around it a faint circle of light that the old pilots called the Eye. Anchorage Station hung off to the side of it, a spindle and two wheels lit up like a party, and the traffic lanes ran in toward the mouth in strings of beacon lights, green in and amber out, the way they had for fifty years.\n\nTeo had been looking at the Needle every working day of her life. It had stopped being strange when she was nine. It had not stopped being the only door.\n\n\"Mercy, Brannock.\" The radio, Corrigan's voice, too cheerful for the hour. \"You still dragging that cow?\"\n\n\"She's dragging me.\"\n\n\"Told you. Load your own. Never let Pans load you on a shift change.\"\n\n\"I was asleep on a shift change, Corr, that's the point of a shift change.\"\n\n\"I'm three hundred back of you. I can see your sled swinging from here. It's beautiful. It's like watching a cathedral fall over very slowly.\"\n\n\"Go and fly into something.\"\n\nHe laughed. Corrigan Dace had a laugh that had got her into trouble more than once, a long time ago, before Lulu, before he had sold the half-share in the Brannock to cover his wife's medical and then lost the wife anyway. They had stopped sleeping together about the time they had both started owing more than they could ever pay, which Teo privately thought was not a coincidence. Debt took up the room in you where other things went.\n\nShe touched the bead at her throat, a habit. It was a nub of brine-glass the size of a pea, cloudy, faintly blue, on a cord gone black with her sweat. Nico had cut it from his first seam in Shaft Nine and given it to her when he was sixteen and she was twenty-four and still thought she would get them both out. He had told her, very seriously, that glass always knew where the Needle was. It was the kind of thing cutters said. But she had noticed, over the years, that the bead lay a little to the left of where it should on her breastbone when she was out on the lanes, a little toward the mouth, and it had bothered her more than she would have admitted to Nico, who believed things.\n\nThe radio clicked over to the approach channel.\n\n\"All inbound traffic, Anchorage Approach.\" Not the usual controller, not the bored boy with the Ardent accent who flirted with the tug pilots. A woman, clipped. \"All inbound traffic, hold at your current marker. I say again, hold at your current marker. Outbound traffic, cancel throat entry, return to Anchorage. Acknowledge.\"\n\nTeo took her boots off the console.\n\nAlong the lanes the beacon strings were changing. The green in-lane lights were blinking to amber one marker at a time, rolling down the string toward her like a rumour. Far ahead, at the mouth, a long-hauler that had been lined up to go through — one of the big Ostrander freighters, three hundred metres of hull with the company sunburst on its flank — was firing its forward thrusters, slowly, the way a big ship did everything, backing away from the dark.\n\n\"Mercy acknowledges, holding at marker nine,\" she said, and cut the mains, and felt the sled overtake her a little on the tether and come up short with a jolt that rattled her teeth. She cursed it. She was looking at the Needle.\n\nIt was the same. That was what she would remember afterward: that it looked the same. The same bruised dark, the same smeared stars. And then, as she watched, the ring of light around the Eye flickered, as though something had passed across it, and the arcs of starlight at the rim shivered and drew in, very slightly, the way a pupil does in a bright room.\n\n\"Did you see that,\" said Corrigan on the private channel.\n\n\"I saw it.\"\n\n\"What was that.\"\n\n\"I don't know.\"\n\n\"It flinched,\" Corrigan said. \"Teo. The bastard flinched.\"\n\nThe bead at her throat lay very still against her skin. She put her hand over it without thinking and held it there, and the two of them sat at their markers three hundred metres apart and said nothing at all for a while, and watched the long-hauler back away from the mouth like a man backing away from a dog.\n\nThey held for three hours. Approach would say nothing except *hold*, and then *stand by*, and then, at last, *inbound traffic, proceed to dock in sequence*, without explanation, as if the three hours had not happened. Teo brought the sled in to Dock Four on a bad angle because her hands were cold, and the dock crew swore at her, and she swore back, and signed for forty tonnes of glass on a slate that added eleven marks to her chit for the late docking. Eleven marks. She looked at the figure for a long time.\n\n\"Ask them what's going on,\" Corrigan said on the radio, still out at his marker, still waiting his turn.\n\n\"I'm a tug pilot,\" she said. \"Nobody tells tug pilots anything. That's how you can tell we're tug pilots.\"\n\nBut she stood for a minute at the dock window after the crew had gone, with her helmet under her arm, looking up the long curve of the station toward the Needle-ward end where the Lectern was, the observatory, its dome lit up as she had never seen it lit at this hour of a shift. She could see figures moving behind the glass. She could not see what they were doing. She could guess that they were frightened, because she was.","wordCount":1316,"createdAt":1793092538612,"updatedAt":1793092538612},{"id":"87arjOiCOz2sgaYrzQpnO","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"BGuMiCoqSHask6lx4yaIC","text":"At nine hundred metres the salt sweated.\n\nNico Kesh had been cutting in Shaft Nine for ten years and he still noticed it every shift, the moment the cage dropped past the eight-hundred mark and the air turned thick and warm and the walls began to glisten: a fine bright beading of brine on the grey-white rock, catching the lamps, running in slow threads down the cuts. The old cutters said the salt was crying. The older cutters said it was the glass breathing, down in the seams, and that if you put your ear to the wall in the deep galleries at the end of a shift when the machines were off you could hear it. Nico had tried, at sixteen. He had heard something. He had never been able to say what.\n\nThe seam they were working that week was the Lower Nine, a long low gallery where the glass ran in a vein as thick as a man's thigh between two beds of hard salt, and the Concession had put two shifts on it since the Director's address. Then three. Keeping glass, the overseers called it, with a kind of embarrassed reverence, as though it were for a church. The quota boards at the cage-head had been repainted with a new line at the bottom, in red: *KEEPING ALLOCATION*. The number on it went up every day.\n\nFennick lost his hand at the end of the second shift on the twenty-third.\n\nNico did not see it happen. He was twenty metres along the gallery with his own cutter in the vein, and he heard the burst — a flat hard crack like a pistol shot in a small room, which was the sound glass made when it let go — and then the scream, and by the time he got there Fennick was sitting in the dust with his back against the wall holding his right arm up in front of his face and looking at it with an expression of polite surprise, and there was nothing on the end of it below the wrist but a mess, and the vein beside him was a starred white crater the size of a dinner plate where the glass had shattered under his blade.\n\n\"Too fast,\" Fennick said, to nobody. \"I was going too fast. They said go fast.\"\n\nThey got him up in the cage. They got a tourniquet on him. Nico rode up with him, holding his good hand, and Fennick talked the whole way up, very calmly, about his daughter's birthday, and passed out at the six-hundred mark.\n\nThe vote was that night, in the shaft canteen, with the dust still on everyone.\n\nNico stood on a table to call it. He had not planned what he was going to say. He did not need to. The canteen was full, three shifts' worth, a hundred and forty cutters and loaders and cage-men crammed in among the long tables in the bad light, and every one of them had heard the burst or heard about it, and the red line on the quota board was in every one of their heads, and Nico stood on the table and said Fennick's name and then said nothing at all for a while, and let them look at him.\n\n\"They want us to cut faster,\" he said at last. \"So they can take what we cut and throw it into the dark.\"\n\nNobody said anything.\n\n\"That's what the Keeping is. You heard her. She's going to put our glass in little ships and send it out to the Needle and drop it down the hole. Our glass. That we cut. That Fennick cut. And the price of it — \" He held up his own right hand and turned it, slowly, in the light. \"The price of it's this. And she doesn't even know if it'll work. Nobody knows. She *said* nobody knows. She just — needs us to do something with our hands so we don't use them for anything else.\"\n\n\"What else would we use them for?\" somebody called from the back.\n\n\"That's the question, isn't it,\" Nico said.\n\nThere was a ripple of laughter, rough, not quite comfortable. He waited for it to die.\n\n\"I'm not asking you to do anything stupid,\" he said. \"I'm asking you to stop. That's all. When the Keeping shipment's due — when they come down to load the glass for the throat — we stop. We put down the cutters and we sit down in the galleries and we don't cut. Not for the Keeping. We'll cut for the Inward, we'll cut quota, we'll cut what pays the debts. But not for the dark. Not one more hand for the dark.\" He looked round at them. \"That's it. That's the vote. Who's with me?\"\n\nThey voted with their hands. It was not unanimous. It was not close.\n\nTeo was waiting for him at the cage-head when he came up, sitting on an upturned ore bucket in her flight jacket with her arms folded, and he knew from her face that she had heard.\n\n\"You're out of your mind,\" she said.\n\n\"Hello, Teo.\"\n\n\"A *strike*. In the middle of the — Nico, do you know what Brandt's going to do?\"\n\n\"Arrest me, probably.\" He sat down on the next bucket. He was very tired, suddenly; the whole day was in his shoulders. \"Fennick lost his hand.\"\n\n\"I heard.\"\n\n\"They told him to go fast. For the Keeping.\"\n\n\"I *heard*, Nico.\" She rubbed her face. \"Listen to me. Six weeks. That's all it is. Six weeks and the *Providence* sails and the Narrowing comes and goes and the whole thing's over one way or another. Keep your head down for six weeks. Please. For me.\"\n\n\"And then what? Then the Concern's gone and she's still here and the debts are still here and we're still cutting, and nothing's changed except we did what we were told one more time.\" He looked at her. \"You know what she's doing. You know it better than me. You fly the lanes, you've seen the Needle. Does it look *hungry* to you?\"\n\nTeo did not answer. She was thinking, he could see, of something. Her hand had gone, the way it always did, to the bead at her throat.\n\nMother Salome came out of the canteen behind him with the Tally under her arm in its blanket. She stopped beside them, tall and stooped, and looked down at the two of them on their buckets for a long moment, the way she had looked at them when they were children and their mother was alive and they had been fighting over something in the passage.\n\n\"He's right,\" she said to Teo. \"And you're right. That's the trouble with this family. You're both always right, and you never listen to each other.\" She shifted the Tally under her arm. \"I'm going up to Fennick's wife. Somebody should tell her before the Concession does.\"\n\nWhen she had gone, Teo said quietly, \"I'm frightened for you, Nic.\"\n\n\"I know.\"\n\n\"No. You don't.\" She looked at the cage-head, at the quota board, at the red line. \"I was at the inner markers ten days ago. In the Mercy. With the harp man — Lyle. Ambrose Lyle. He was putting a buoy out.\" She was quiet. \"He doesn't know why it's narrowing, Nico. The man who reads it. He doesn't know. He said so. And she stood up in the Assembly two days later and told everybody it was starving.\"\n\nNico stared at her.\n\n\"I'm not saying you're right,\" Teo said. \"I'm saying I don't know. And when I don't know, I keep my head down.\" She got up off the bucket. \"Keep your head down. Please.\"","wordCount":1295,"createdAt":1793108785208,"updatedAt":1793108785208},{"id":"88zbYhw6Vd3Yu3UzMKOK2","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"6eoYk6Q04qKDdt7k9x4Sr","text":"The petitions for substitution came to Adaeze Quill because nobody else wanted them, and because she was the archivist, and the archivist was where things went when the order did not know what to do with them.\n\nThere had been eleven so far, in the ten days since the Draw. There were always petitions. A mother for her son, a husband for his wife, a woman of thirty-nine for her nephew of eighteen; they came up from Tallow Under on the supply shuttle in envelopes of good paper, or in person, in their best clothes, and sat in the chair across Adaeze's desk in the little office off the archive and explained, very carefully, as if she might not have understood the Articles, that they were of age and willing and asked only to take the place of the one they loved. Adaeze listened to every one. She wrote them out fair, in the old hand, on the order's vellum, and sealed them with her own seal, and sent them up to the High Warden, and the High Warden declined them. He had declined every one for nineteen years. Four had been granted in the whole history of the Compact. It was not a door, the substitution; it was a painting of a door on a wall. Everyone knew it. They came anyway. Adaeze thought that the coming was the point — that people needed to have knocked.\n\nThe twelfth was in naval greys, and sat down across the desk without being asked.\n\n\"Commander Asante,\" said Adaeze.\n\n\"You know me.\"\n\n\"Everyone in the Anchorhold knows your sister's name.\" Adaeze folded her hands. \"And I saw you, once, at your commissioning. You were nineteen. You had your hair much shorter. Your sister was very small and kept wandering off into the harp hall.\"\n\nJuno Asante looked at her properly for the first time. Adaeze saw herself being looked at: a woman of forty-four in Warden's grey, round-faced, with ink on her fingers and her hair tied back in the plain knot of the order and a pair of reader's spectacles on a cord round her neck. Nobody remarkable. She had never minded being nobody remarkable.\n\n\"I've come to petition,\" said the Commander.\n\n\"I know.\"\n\n\"I'm thirty-one. I'm of Draw age. I'm a volunteer. Under the Articles, Section Nine — \"\n\n\"I know the Articles, Commander.\" Adaeze said it gently. \"I'll write it out. I'll write it out as well as anybody has ever written one, and I'll seal it, and I'll take it up to the High Warden myself, which is more than I do for most of them. I want you to know that before I tell you the rest.\"\n\n\"Which is?\"\n\n\"That he will decline it.\"\n\nThe Commander's jaw set. \"You don't know that.\"\n\n\"He has declined every petition for substitution since he was invested. Two hundred and six of them, at the last three Draws. I've written every one.\" Adaeze pulled a sheet of vellum toward her and uncapped her pen. \"I've read the reasons too. They're always the same. The Needle chose; it is not for the Wardens to correct the Needle. It's theologically sound. I'm afraid it's also unanswerable.\"\n\nShe began to write. *To the High Warden of the Throat, from Juno Efua Asante, Lieutenant Commander of the Compact Navy, of the Speaker's house, being of age and of sound mind — .* She wrote in the old hand, the slanting formal script the order had used since before the Compact, and she could feel the Commander watching the pen move.\n\n\"You believe that,\" Juno Asante said. \"That the Needle chooses.\"\n\nAdaeze kept writing. \"I believe the Wheel is a lottery and the Needle is a wormhole,\" she said, \"and that between them, every four thousand days, nine people are asked to do something very terrible on behalf of everyone else. I believe it has kept the door open for three hundred years. Whether the Needle *chooses* — \" She dipped the pen. \"I'm the archivist, Commander. I believe in records. The records say that every time we have kept it, it has opened. That's what I believe.\"\n\n\"And the people who don't come back?\"\n\nAdaeze stopped writing.\n\n\"I have their names,\" she said. \"Every one, every Keeping. Two hundred and sixty-one. They're in the archive behind that door. I read them, on the anniversaries.\" She looked up. \"I'm not a fool, Commander. I'm not a fanatic. I didn't take the grey because I think it's beautiful. I took it because somebody has to keep the records honestly, and I thought it might as well be someone who could bear to read them.\"\n\nThe Commander was quiet. Adaeze finished the petition and sanded it and folded it and dripped the grey wax and pressed her seal into it, and held it up.\n\n\"Would you like to see the harp?\" she said. \"While you're here. Your sister did, when she was eight. She stood in front of it for an hour. We had to carry her out.\"\n\nThey went through the archive — a long vaulted room, cold, lined floor to ceiling with racks of harp-records on spools and crystal and the oldest of them on paper, three hundred years of the Needle's voice written down — and through the iron door at its end into the harp hall.\n\nIt had been the Lectern once, in the Concession's time. The dome was the same dome, a hemisphere of old glass looking out on the mouth, and the floor was the same floor, worn into hollows by three centuries of feet. The harp stood in the middle of it. Adaeze had served here for twenty years and it still stopped her breath, sometimes, coming through the door. A frame of fused silica taller than a man, gone faintly gold with age, strung with nine courses of resonator wire that caught the grey light of the mouth and held it. It was singing. It was always singing. The long, wide, many-stranded drone of the throat, low and soft, filling the hall, so that coming into it was like walking into the inside of a held breath.\n\n\"The frame is original,\" Adaeze said quietly. \"The First Warden's. The wires have been restrung many times. We tune them every morning to the Hunger Tone.\" She nodded to a small alcove off the hall, behind a grille of black iron, where a lamp burned. \"The Fork is kept there, between Draws. It's struck once, at every Keeping, here, at the moment the Keepers go in. That's all. It's never used for tuning. It's too precious.\"\n\n\"What's it for, then? A tuning fork you don't tune with.\"\n\nAdaeze smiled. \"That's the sort of question your sister would ask.\"\n\nThe Commander did not smile. She stood in the middle of the hall with her hands at her sides and looked at the harp, and then up through the dome at the mouth, the bruise-dark wound with its rim of bent light, and Adaeze watched her face and saw on it something that she had seen on many faces in twenty years and had never been able to name. Not fear. Something more like grief, arriving early.\n\n\"She'll be up here,\" the Commander said. \"Training. For seven weeks.\"\n\n\"Yes.\"\n\n\"Will you — \" She stopped.\n\n\"I'll look in on her,\" said Adaeze. \"I look in on all of them.\"","wordCount":1234,"createdAt":1793093539610,"updatedAt":1793093539610},{"id":"91L5AJ5XhbwPJeYEi2T3W","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"uwhWJbZQj0ns1hWP9t3B3","text":"They gave the nine a dormitory on the second wheel, nine narrow cells off a common room with a window on the mouth, and they gave them each a bead.\n\nIt was the first thing, the night they arrived: a Warden going round the common room with a little wooden box, and each of them taking one out, a nub of cloudy brine-glass the size of a pea on a black cord. You wore it from the night you came up until the night you flew. Pell put hers on at once and felt it settle into the hollow of her throat, cool, and lie there, very slightly to the left. Toward the mouth. The Warden said it always would.\n\n\"It's to remind you,\" the Warden said, \"that you are already part of it.\"\n\nEzra Lind, sitting on the bench beside her, turned his bead over in his ink-stained fingers and said, under his breath, \"Part of what, though,\" and then looked horrified at himself, and put it on very fast.\n\nBy the fourth day Pell liked him best of all of them. There was Tavish Orme, who was thirty-eight and had three children and did not speak to anyone; there was Abbe Sorrell, the Shoals girl they had brought in on a Navy ship with her hands cuffed, who had stopped fighting on the second day and stopped eating on the third; there were five others whose faces Pell was learning, a baker and a lift-mechanic and a woman who had been a Warden novice once and left. And there was Ezra, who was twenty-two and a clerk in the dock office and had never flown anything bigger than a cargo sled across a hangar floor, and who was so frightened, all the time, that it came out of him as jokes.\n\n\"The thing is,\" he said to her in the simulator bay on the fourth day, strapped into the mock cockpit of a Keeper's skiff with the screens full of grey-gold throat and his hands white on the stick, \"the thing is that I failed my sled licence twice. Twice. They told me I didn't have the spatial reasoning. And now the Needle has looked into my soul and said, *Ezra Lind, you are the man to fly into my throat.* I think the Needle's made a clerical error. I think I should file a complaint.\"\n\n\"File it with Sister Quill,\" Pell said. \"She does the paperwork.\"\n\n\"I tried. She said the Needle doesn't accept complaints. She said it very kindly.\" He banked, too hard, and the simulator screamed at him and the screens went red. \"Oh, for — that's the fourth time I've died today. Do you think it counts? Do you think if you die enough times in the simulator the Needle lets you off the real one?\"\n\n\"I don't think it works like that.\"\n\n\"No,\" said Ezra, and looked at the red screen, and his face changed for a second, and he said in a different voice, \"No, I don't suppose it does,\" and then he reset the simulator and made a joke about the instructor's moustache.\n\nThe skiffs were very simple. That was what surprised Pell. She had imagined something grand, something like the ships in the old paintings in the Compact Hall; but a Keeper's skiff was twelve metres of narrow hull with a single seat and a cradle under the belly for the glass, and an engine, and a release lever painted white. You flew it into the mouth at the start of the Long Night, when the throat was tightening, following the reader's line, and you flew it down the throat as far as the waist, and at the waist you pulled the white lever and the glass went, and then you turned round and flew back the way you came. That was all. The instructors went over it and over it. The line, the waist, the lever, the turn. The line, the waist, the lever, the turn.\n\nThey did not talk about how many turned and did not come back. Nobody did. Pell knew the number anyway, the way everybody in the Reach knew it: a little under half. Two hundred and sixty-one names in Sister Quill's archive. She thought about it sometimes, at night, in her cell, with the bead lying cool against her throat. She waited to be frightened. She was not frightened. She was something else that she did not have a word for, something that hummed in her like the harp.\n\nShe went to the harp hall on the sixth night, very late, because she could not sleep and because it was the only place in the Anchorhold she wanted to be.\n\nSister Quill was there. She was sitting on the floor with her back against the wall under the dome, in the dark, with her spectacles in her lap, listening. She looked up when Pell came in and did not seem surprised.\n\n\"I come here too,\" she said. \"When I can't sleep. Sit down, if you like.\"\n\nPell sat down beside her. The harp sang in front of them, gold-wired, the long low many-stranded drone of the throat, and above them in the dome the mouth hung, huge, its rim of light trembling very faintly. It had begun to tremble on the fourth day. The readers said it was the Narrowing beginning in earnest. You could see it if you watched for long enough: a slow shiver at the edges, like heat over a road.\n\n\"Can I ask you something?\" Pell said.\n\n\"You can ask.\"\n\n\"What does it look like? The waist. Inside.\"\n\nAdaeze Quill was quiet for a while.\n\n\"I don't know,\" she said. \"Nobody does. The ones who come back don't speak of it. It's a rule of the order — they're asked not to, and they don't. I've asked some of them myself, privately, when I was younger and more curious. They wouldn't tell me.\" She turned the spectacles over in her lap. \"One of them — an old man, he'd flown the Twenty-Sixth — told me that it wasn't a thing that had words. That's all he'd say.\"\n\n\"I've painted it,\" Pell said.\n\nThe Warden turned her head.\n\n\"I've been painting it since I was eight. Since I heard this.\" Pell nodded at the harp. \"I never get it right. I brought one with me. They said one bag.\" She did not know why she was saying this. \"Do you want to see it?\"\n\nShe went and got it from her cell. When she came back Sister Quill had lit the little lamp in the alcove beside the reliquary grille, and Pell held the canvas up in its light. It was the throat one, the one she had chosen on the floor of her room in Tallow Under while Juno knelt among the canvases: the long tunnel of folded light, gold and grey and a colour that was not quite either, opening and opening down its length toward a place at the centre where everything drew in, tight as the iris of an eye, and in the middle of that, very small, something that was not quite white.\n\nSister Quill looked at it for a long time.\n\n\"Where did you see that?\" she said at last. Her voice was odd.\n\n\"I didn't see it. I heard it. I just — that's what the harp sounds like. To me. That's what it sounds like inside.\"\n\n\"The iris,\" said the Warden softly. \"In the middle. Drawn in.\"\n\n\"That's the waist. I think. That's where it goes tight.\" Pell looked at her. \"Why? What's wrong?\"\n\n\"Nothing's wrong.\" Sister Quill took off her spectacles, which she had put on to look, and folded them carefully. \"There's a description in the archive. Very old — one of the oldest things we have. An account of the throat in a Narrowing, written by a reader, from before the Compact. Most of it's lost. But there's a passage — \" She stopped. \"It says almost exactly that. *Drawn in like an iris. And at the centre, a light I have no name for.*\" She gave a small, uncertain laugh. \"I've read it a hundred times. I never saw it until now.\"\n\nThey sat together in the lamplight in front of the singing harp, the painting propped against Pell's knees, and neither of them said anything for a long time. Pell's bead lay against her throat, cool, leaning very slightly toward the mouth.\n\n\"I'm not afraid,\" Pell said finally. \"Everyone keeps waiting for me to be afraid.\"\n\n\"I know,\" said Adaeze Quill. \"I've noticed.\" She put a hand, briefly, on the back of Pell's neck, the way you would with a child. \"It's all right not to be. And it will be all right, if you are.\"","wordCount":1468,"createdAt":1793093539110,"updatedAt":1793093539110},{"id":"Al5buU7_7Qp-yi0vBJVpN","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"b8BaZ7zgb3d0zVGfhIW_4","text":"The High Warden received her the next morning, which was itself, Juno understood, a kind of answer.\n\nHis rooms were at the very top of the Anchorhold's spindle, at the Needle-ward end: a long low gallery with a curved window filling one wall, so that the mouth hung outside it vast and dark, like a painting of nothing. It was almost bare. A desk. Two chairs. A cabinet of old black wood with a lock. On the floor a carpet of some deep red stuff so old that its pattern had worn to the weft in a path from the door to the desk, as if the same feet had walked that line for centuries. Cassius Mor stood at the window with his back to her when the novice showed her in, and did not turn round at once.\n\n\"Commander Asante,\" he said to the glass. \"Sit down. Please.\"\n\nShe did not sit. After a moment he turned, and smiled at her — a warm, tired, genuinely kind smile, the smile of a man who has been expecting a difficult conversation and is sorry it has to happen — and came and sat behind the desk himself, and gestured again at the chair, and this time she sat, because standing had become ridiculous.\n\nHer petition lay on the desk between them, its grey seal broken.\n\n\"Sister Adaeze writes a beautiful hand,\" Mor said. \"And she has put your case as well as it could be put. Better. I've read it twice.\" He laid his palm on the vellum, gently, as if it were a living thing. \"I'm going to decline it, Commander. I expect you know that. I wanted to tell you so myself, rather than send it down with a seal on it, because I think you are owed that, and because I wanted you to understand why.\"\n\n\"The Needle chose,\" Juno said.\n\n\"The Needle chose.\" He nodded slowly. \"You think that's a formula. A thing we say. It is a thing we say. But it is also true, and I would like you to try, just for a moment, to hear it as true.\" He leaned forward. \"The Draw is the only thing in the Reach that is perfectly fair. Do you understand? The only thing. The Speaker's daughter and the dock clerk and the Shoals girl in a rock with no name — every one of them a slip of foil in the same drum. No money buys you out of it. No family. No office. It is the one place where we are all the same. That is why it works, Commander. That is why the Reach has borne it for three hundred years. Because it is fair.\" He spread his hands. \"And if I let the Speaker's daughter out, because the Speaker's other daughter is a decorated officer who has come in her greys to ask me — then it is not fair any more. Then it is a thing the powerful can get their children out of. And the next time the Wheel turns, every mother in the Fourth Terrace will know it. And the Draw will be broken. And the Keeping with it.\"\n\nIt was a good speech. Juno had heard admirals give worse. She sat and let it go past her and watched his face.\n\n\"There are four substitutions in the record,\" she said.\n\n\"There are. In three hundred years. Each of them for reasons which I would not wish on your family.\" He sighed. \"Commander. I know what you are. I know what you've done in this war. I know you've been out in the Shoals for six years taking names off registries for the Draw — \" a small, delicate pause — \"and I know what that has cost you, because I have read your reports, and you write them very honestly. You of all people know what the Draw costs. You of all people know what it would mean if it were seen to bend.\"\n\nShe did not answer.\n\n\"How is your mother?\" Mor said.\n\nThe change of direction was so smooth that it took her a second to feel it.\n\n\"She's well.\"\n\n\"I'm glad. She carries a great deal. I know it.\" He looked at her with what seemed to be real concern. \"The appropriation for the Shoals campaign comes before the Assembly next week. I understand she hasn't yet said how she'll vote.\"\n\n\"I don't discuss my mother's votes, High Warden.\"\n\n\"No. Quite right.\" He smiled again. \"I mention it only because the Keeping cannot be flown if the Shoals can raid the glass stores at will. You know better than I how close they came last month. The Keeping must be protected, this time of all times. The Thirtieth is deep. Deeper than anything in two hundred years. If the escort is not funded — \" He let it trail away, and shook his head slightly, as if at the size of the thought. \"Well. I hope she will remember that her daughter flies in it. I'm sure she will.\"\n\nJuno looked at him for a long moment. Outside the window, beyond his shoulder, the mouth of the Needle hung huge and patient, and she thought of the Hall, ten days ago: the seventh slip of foil held up to the light; the High Warden's eyes lifting from it, before he read, across the floor to the Speaker's terrace. Only for a moment.\n\n\"Thank you for seeing me, High Warden,\" she said, and stood.\n\n\"Commander.\" He stood too, courteous. \"Your sister is extraordinary. I've met her. She has a gift for this that I have rarely seen. She is not afraid. You should be very proud.\"\n\n\"I am.\"\n\n\"Then let her go,\" said Cassius Mor gently. \"It is the last thing you can give her.\"","wordCount":969,"createdAt":1793093539325,"updatedAt":1793093539325},{"id":"AuUvgsClV3DuSEotFxD1i","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"EPajjYElKpPpwffw-xPff","text":"The Prior came into the hall at noon, on his two sticks, alone, and stood in the doorway, and listened.\n\nLucan had known he would come. The whole station could hear the harp now; it rang through the spindle like a bell through a church, and the other Wardens had been gathering in the passages all morning, whispering, and not coming in. The Prior did not whisper. He stood in the doorway in his grey with the frayed cuffs and his white head lifted, listening, for a long time. Then his eyes went to the reliquary grille, with its hinge-pins lying on the floor beneath it, and the empty grey cushion.\n\n\"Where is it?\" he said.\n\nLucan took the Fork out of his sleeve and held it up.\n\nIsra, beside him, felt the old man's look go over her and dismiss her, the way you would dismiss a chair. It rested on Lucan. It rested on the Fork. Then, slowly, on the screen.\n\n\"Explain,\" said Prior Saar.\n\nLucan explained. He did it better the third time; Isra listened to him do it and thought that he had found the words now, standing in front of the man who had taught him to sing the Hunger Tone at seventeen. The new wire that would not lie down. The shard. The Fork, and the beat. The night's work. The bell. The thing in the throat. He took the Prior to the screen and showed him, and the old man stood leaning on his sticks and looked at it, at the great banded mass in the waist and the crooked thread of the passage, for a very long time without speaking.\n\n\"Twelve years,\" the Prior said finally, to the screen. \"I've looked at that trace for fifty-eight years, Brother. Twelve with you.\" He did not say anything else for a while.\n\n\"Prior,\" said Lucan. \"The Lamplighter — \"\n\n\"I know.\"\n\n\"If she takes a hundred skiffs into that and releases — \"\n\n\"I *know*, Lucan.\" The old man turned from the screen. His face, Isra saw, was grey, and very calm, the calm of somebody who has been hit and has not yet fallen down. \"Put it back.\"\n\nLucan stared at him.\n\n\"The Fork. Put it back on its cushion, and put the pins back in the grille. Then retune the harp. To the Hunger Tone. All of it. Tonight.\"\n\n\"Prior — \"\n\n\"Her reader is coming tomorrow.\" Saar's voice was perfectly level. \"The Lamplighter's. For the readings. You know she is; she said so. He will come into this hall and he will hear that.\" He moved his head slightly toward the ringing harp. \"And then he will look at that screen. And then he will go back to Tallow and tell Mercy Oduya that the Wardens of the Throat have desecrated the First Warden's Fork, and tuned the harp to a heresy, and are saying that the Needle is not hungry but sick — sick with *glass*, Brother. Sick with what she has spent twenty-five years telling the Reach to give it. Sick with what her son flew into it.\" He did not raise his voice. \"What do you think she will do?\"\n\nLucan was silent.\n\n\"I'll tell you what I think,\" said the Prior. \"I think she will come here with her black coats, and her Deacon, and she will burn this hall. And the harp. And the Fork. And us. And then she will fly her hundred skiffs into the throat anyway, with nobody left alive who can read it, and that will be the end of it.\" He shifted on his sticks. \"There are twelve of us. I keep telling you. *Twelve.*\"\n\n\"So we say nothing.\"\n\n\"So we wait. So we think. So we do not hand her the match.\" Saar held out his hand, old and shaking, palm up. \"The Fork, Brother.\"\n\nLucan looked at the Fork in his own hand. Isra watched him look at it. Then he stepped forward and laid it in the Prior's palm, and the old man's fingers closed over it.\n\n\"Retune the harp,\" Saar said. \"Tonight.\" He turned toward the door on his sticks, and stopped, and without looking round said, in a different voice, an old man's voice, almost gentle: \"It says *For Clarity*, you know. On the stem. I used to think that was the finest thing ever written on anything.\" He was quiet for a moment. \"Retune the harp.\"\n\nHe went out. They heard his sticks go away down the passage, tap and tap, very slowly.\n\nLucan stood in the middle of the hall with his empty hands at his sides. Isra waited. After a long time he went to the console and, without a word, plugged a little data-stick into its side, and copied the trace onto it, and pulled it out, and put it in her hand, and closed her fingers round it.\n\n\"Not here,\" he said. \"Not in the Anchor. Somewhere stupid. Somewhere nobody would look.\"\n\n\"I live in the Gutter,\" said Isra. \"Everywhere's somewhere stupid.\"","wordCount":841,"createdAt":1793109149199,"updatedAt":1793109149199},{"id":"CZm_1-lhL0rz3VPnSDXVk","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"Hy3VAW4LN10Gaa4qhfEBE","text":"The Compact Hall had been built, so the guides said, on the floor of the old Concession meeting-house, and if you stood at the very back under the gallery, where the ceiling came down low, you could still see the original salt wall: rough, grey-white, with the marks of the cutting machines on it in long curved grooves like the inside of a shell. Everything else had been built up and out from there over three hundred years. The Hall rose in tiers now, cut terraces of salt dressed with pale stone, and a light-well opened at the top of it to the surface eight hundred metres above, so that when Caul was up the whole Hall filled with a slow banded amber like the inside of a cut agate. Caul was up. It was always up for the Draw. The Wardens arranged it so.\n\nJuno stood on the Speaker's terrace in her dress greys between her mother and her sister and did not look at the Wheel.\n\nShe looked at the Tally instead. It hung on the original salt wall behind the Wardens' bench, as it had for as long as there had been a Compact: a plate of old steel half a metre across, dark, pitted, oddly unimpressive, in a frame of polished brass far too fine for it. The Founders' Tally. As a child she had been told it bore the names of the dead of the Concession, the miners and cutters who had died in the salt before there was a Compact, and that the first Keepers were on it too, and she had stood on tiptoe and looked for them and been disappointed, because three centuries of hands had touched it and worn it smooth, and you could not read a single name. You could feel them, if you were allowed to touch it, which children were, once, on their Naming Day — rows of shallow scratches under your fingers, like braille in a language nobody spoke any more. She remembered the cold of it. She remembered thinking that it was the oldest thing she had ever touched.\n\n\"Stop fidgeting,\" her mother said, without moving her lips.\n\n\"I'm not fidgeting.\"\n\n\"You're doing the thing with your thumb.\"\n\nJuno stopped doing the thing with her thumb. Efua Asante, Speaker of the Assembly of the Compact of the Reach, stood beside her in black and silver with her hands folded and her face composed into an expression of grave civic attention that Juno had seen her wear at funerals, budget debates and her own husband's cremation, and that Juno had never once been able to see behind. She was sixty-one. She had been Speaker for eight years and had spent the last six of them trying to end a war that the Assembly would not let her end, and she looked, Juno thought, very tired, in a way that only someone who had known her face for thirty-one years would see.\n\nOn Juno's other side Pell was not fidgeting at all.\n\nShe stood very straight in the plain white smock that everyone of Draw age wore to the Hall, with her hands loose at her sides and her chin up and her eyes on the Wheel, and she was smiling a little. Not the nervous smile you saw on some of the faces in the tiers around them, the bright fixed grin of someone telling themselves it was one in four thousand. Something quieter. As if she were listening to music.\n\n\"Pell,\" Juno said.\n\n\"Mm.\"\n\n\"Are you all right?\"\n\n\"I'm fine.\" Pell glanced at her, and the smile widened into something more like her own. \"You look awful. Did they not let you sleep on the way in?\"\n\n\"I boarded a ship full of children.\"\n\n\"Oh, Juno.\" Pell's face changed. \"Were they —\"\n\n\"They're fine. They're cold and they're in a cell and they're going to be handed over to the Wardens, but they're fine.\" She heard her own voice and did not like it. \"Sorry. It's not — sorry. Ignore me.\"\n\nPell reached over and squeezed her hand, briefly, the way she had done when she was six and Juno was eighteen and leaving for the Academy, as if Pell were the one who had to be brave about it. Then the bell rang, and the Hall went quiet, and the Wardens came in.\n\nThey came from the back, through the salt door, in procession: thirty or forty of them in the grey of the order with the silver thread at the cuffs, walking slowly, two by two, singing. Juno had never liked the song. It was very old, and it had no tune she could hold onto — a long held drone that the Wardens called the Hunger Tone, under which the voices of the procession wandered up and down in a kind of chant, so that the whole thing sounded less like singing than like something enormous breathing in its sleep. The Hall took it up. You were supposed to. Thousands of voices finding the drone, holding it, until the salt walls hummed with it and you could feel it in your teeth. Pell was singing. Their mother was singing, in her perfect civic contralto. Juno moved her lips.\n\nAt the end of the procession came the High Warden.\n\nCassius Mor was sixty-six and walked like a much younger man, upright, unhurried, his white hair cropped close to a long well-made skull. He did not sing. He carried, on a cushion of grey velvet held out before him in both hands, the Founder's Fork: a tuning fork of brass, fifteen centimetres long, its tines worn bright, its stem engraved with letters three centuries of polishing had worn down to ghosts. Juno had seen it up close once, at a reception at the Anchorhold when she was a cadet. You could make out FOR CL and nothing after. The Wardens' motto came from it. *For Clarity.* It was said to have been the First Warden's own, the instrument by which the First Warden had first heard the Needle's hunger; it was the holiest object in the Reach, and it was carried before the Wheel at every Draw, and at every Keeping it was struck once in the Lectern at the Anchorhold at the moment the Keepers went in.\n\nMor laid it on the bench beneath the Tally, on its cushion. The drone died away. In the silence he raised his hands.\n\n\"The First Warden heard the Needle's hunger,\" he said, \"and the Reach answered.\"\n\n\"*We feed the door, that it may stay a door,*\" said the Hall, eight thousand voices at once, and Juno with them, because that much she could never not say; it was in her like her own name.\n\n\"What the Needle keeps,\" said Mor, \"it keeps for us.\"\n\n\"*It keeps for us.*\"\n\n\"Twenty-nine times,\" said Mor, \"the door has narrowed in our keeping. Twenty-nine times we have answered, and twenty-nine times it has opened again. We come now to the Thirtieth.\" He let the silence hold. His voice was warm, unhurried, beautifully pitched; he spoke the way a good doctor tells you it is going to hurt. \"The readers at the Anchorhold tell me it will be deep. Deeper than any in two hundred years. Some of you are afraid, and you are right to be. I am afraid. But we have done this before, and we know how it is done. We give what is asked of us, and the door opens. That is the covenant. It is the oldest promise in the Reach. It has never been broken.\" He turned, and laid his hand on the Wheel. \"Nine are asked. Let the Wheel choose them.\"\n\nThe Wheel was brass, a drum the size of a man lying down, on a cradle of black iron. It held, so the guides said, every name in the Reach between the ages of eighteen and forty, each on its own slip of steel foil, and it turned on its cradle with a long grinding hush that you could hear from every tier of the Hall. Two Wardens turned it. Juno watched it turn. Despite herself, despite everything, she watched it turn, and the foil slipped and hissed inside it like rain on a hull, and her mouth was dry.\n\nIt stopped. A Warden opened the hatch. Mor reached in and drew out a slip of foil and held it up to the light-well, and read.\n\n\"Tavish Orme, of the Fourth Terrace.\"\n\nSomebody screamed, high up in the tiers. Not the man himself — someone near him. A mother, a wife. Juno did not look. The Wardens went up into the tiers, two of them, toward the sound, and the Wheel turned again.\n\n\"Abbe Sorrell, of Corrie Rock in the Shoals.\"\n\nA murmur, this time. A Shoals name, by registry; Abbe Sorrell would not be in the Hall. Somewhere out in the Shoals a Navy boarding party would be carrying a slate to a habitat to find her. It might be the *Vigil*. Juno closed her eyes for a second and opened them.\n\n\"Ezra Lind, of the Dockside.\"\n\nA young man in the tier below them sat down suddenly on the salt step as if his legs had been cut, and stayed sitting, with his hands over his mouth. He had a dock clerk's ink stains on his fingers. He looked about twenty-two.\n\nThe Wheel turned. Four. Five. Six. Juno counted them without hearing the names. She was aware of her mother beside her, not moving; of the light-well's amber shifting slowly on the far wall as Caul turned; of the Tally's dull steel square above the bench. She was aware of Pell's hand, which had found hers again at some point and was holding it, quite loosely, warm and dry.\n\nThe Wheel stopped for the seventh time. Mor reached into it. He drew out a slip and held it up to the light, and looked at it. And then he looked — Juno would think about this afterward, for a long time, turning it over and over the way you turn a stone in your pocket — he looked up, across the floor of the Hall, at the Speaker's terrace. Only for a moment. Then he read the name, slowly, as if he wanted every syllable of it to reach the back of the Hall.\n\n\"Pell Asante,\" said the High Warden, \"of the Speaker's house.\"\n\nThe Hall made a sound Juno had never heard it make: a great soft collective intake of breath, eight thousand people drawing in air at once. Then silence.\n\nJuno did not move. She could not. Her body had become a single held thing. Beside her, she heard her mother make a very small noise in her throat, the kind of noise you make when you have been cut and have not yet looked at the cut.\n\nAnd Pell let go of her hand.\n\nShe stepped forward to the edge of the terrace, into the light, in her white smock, and stood there so that the Hall could see her. She was smiling. It was not a brave smile; it was not for anyone. It was the smile she had worn all morning, the listening smile, and Juno understood, watching her sister's face lifted toward the amber light-well with tears running quietly down it, that Pell was happy. That Pell had wanted this. That she had stood in the Hall all morning listening to the Hunger Tone and waiting to be chosen, the way you wait for someone you love to come through a door.\n\nThe Wardens came for her. Pell went down the steps to them without looking back.","wordCount":1951,"createdAt":1793092973748,"updatedAt":1793092973748},{"id":"CeKl9zLTrk4W_lfE32Hu9","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"jZixxF2eaRvPHhrSsthe9","text":"\"There is no basis for it,\" Ambrose said.\n\nThe Director's Gallery was at the top of the station's spindle, the Needle-ward end, a long low room with a curved window that took up the whole of one wall, so that the mouth of the Needle hung outside it like a vast dark painting. Hesper Vane had furnished it with almost nothing: a desk, two chairs, a cabinet, a rug of some deep red Inward wool that must have cost more than Ambrose's harp. She sat behind the desk now with her hands folded on it. He had not sat down.\n\n\"I never said it was starving,\" he said. \"I never said anything about a ring weakening. I never said that feeding glass to it would do anything at all. Nobody has ever said that. There is no data. There is no theory. You made it up.\"\n\n\"I extrapolated.\"\n\n\"From what?\"\n\n\"From what you told me.\" Her voice was perfectly level. \"You told me the waist is narrowing. You told me you don't know why. You told me the throat is held open by exotic matter. You told me brine-glass is exotic matter. You told me you have no model and no theory and four data points and a lot of hope.\" She spread her hands slightly on the desk. \"I have given them a model. I have given them a theory. I have taken away the hope and given them something better.\"\n\n\"Which is what?\"\n\n\"Something to do.\"\n\nHe stared at her.\n\n\"People can bear almost anything, Ambrose,\" Hesper Vane said, \"except not knowing what to do. You know this. You've watched it, these last two weeks — the bars, the dorms, the shafts. Forty thousand people who have just been told that the company that owns them is leaving and that the door to the rest of the universe may be closing behind it. What do you think they will do with that? If they have nothing to do with it?\" She did not wait for an answer. \"They will riot. They will stop cutting. They will tear Anchorage apart looking for someone to blame and they will find me, because I am the one who is staying. I have given them something to do. I have given them a way to save themselves. Whether it works — \"\n\n\"It won't work.\"\n\n\"You don't know that either.\" She looked at him, and her eyes were very steady. \"Do you? Can you tell me — with data, Ambrose, with a theory — that it won't?\"\n\nHe opened his mouth and shut it.\n\n\"No,\" she said. \"You can't. You've said so to me twice.\" She leaned back in her chair. \"So. The Narrowing will do whatever it does. If the Needle opens again, the Keeping will have kept it open. If it doesn't, nothing would have. Either way, for forty-seven days, the Reach will have something to do other than burn itself down. That is the whole of my policy. You may disapprove of it. I would think less of you if you didn't.\"\n\n\"And the pilots?\"\n\nSomething moved in her face, very briefly, and was gone. \"The pilots will be volunteers. Every one. I will not order anyone into the throat. They will be paid more than anyone in the Reach has ever been paid for anything, and the ones who come back will be heroes, and their families will be free.\" A pause. \"And the ones who don't come back will be heroes too.\"\n\nAmbrose turned away and looked out of the window at the mouth. He thought of the buoy out there at the inner markers, two days in the pull now, singing to him across two million kilometres: the long, slow, even drawing-in of the waist, and under it the other thing, the swell, the tide. Louder there. Real. He had sat in the Lectern last night with the headphones on and listened to it until three in the morning. It had a period, he was almost sure, of a little over four minutes. He did not know what it was. He did not know what it meant.\n\nHe had not told her about it. He realised, standing at her window, that he was not going to — not yet, not until he knew. He did not examine why.\n\n\"Your berth on the *Providence*,\" Hesper Vane said behind him, \"is confirmed for the twenty-eighth. Senior grade, as I said. Cabin twelve. I checked.\" He heard her slate click. \"Forty-four days, Ambrose. Do your job until then. Read the throat, give me the numbers every six hours, don't speak to the bars. And then go home.\"\n\nHe put his hand in his jacket pocket and closed it round the fork.\n\n\"Yes, Director,\" he said.\n","wordCount":796,"createdAt":1793093335260,"updatedAt":1793093335260},{"id":"D2QH--5Ef_J5Kh9DIuw4a","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"vc7JLtzv1t642c2LR_7a5","text":"It was the archivist's duty, at every Keeping, to read the First.\n\nNot the whole of it. Nobody had the whole of it. But on the night of the Long Night, while the Keepers flew and the Reach sang, the archivist stood in the harp hall beside the High Warden and read aloud from the harp records of the First Keeping — the waist's narrowing and its holding and its opening again, three hundred and seventeen years ago, in the numbers the First Warden's own readers had written down — so that the Reach would hear that it had been done before and had worked. Adaeze had read them at the Twenty-Ninth, eleven years ago, her first Keeping as archivist, with her voice shaking. She meant to read them better this time. So on the twenty-eighth of October, with thirty-eight days to go, she went down into the deep stacks to find them and copy them out fair.\n\nThe First Keeping's records were where they had always been: in the oldest rack, at the far end of the archive, in the cold, on spools of a crystal so old it had gone faintly yellow. The first spool's label was in the slanting hand of the order. *Harp. 2 May 2291. First Day After the Keeping.* She took it down and fed it into the old reader and listened to it while she copied: the throat's chord, steadying, opening; the readers' voices, flat with exhaustion, calling numbers. *Waist twenty-four. Twenty-six. Holding.* She knew it by heart.\n\nIt was only when she went to the rack for the spool before it — the Long Night itself, the night of the Keeping — that she found there was not one.\n\nShe stood in front of the rack for some time. Then she went and got a lamp.\n\nThe spool for the second of May was the first spool in the rack. She had always known that, the way you know the first page of a book is the first page, without ever thinking about it. There was nothing before it. No Long Night. No first of May. No April, no March, none of the readings from the weeks before the First Keeping, when the waist was narrowing and the First Warden heard its hunger and the Reach answered. The archive began on the morning after. It began, Adaeze realised, standing in the cold with the lamp in her hand, as if the Keeping had worked and somebody had then started writing it down.\n\nBut the Concession had had readers. The liturgy said so. *The readers of the Concession heard it narrow.* There had been a harp — this harp, the First Warden's harp, singing in the hall above her head. There had been forty years of records before the First Keeping. Where were they?\n\nShe went to the catalogue. The catalogue of the archive was itself a historical document, three hundred years of archivists' entries in a dozen hands, and its first page was older than the Compact. She found the entry she wanted in the very first column. *Concession harp records, 2247 to 1 May 2291: transferred to the keeping of the First Warden.*\n\nAnd beside it, in a different and later hand, very small: *Not returned.*\n\nThat was all.\n\nShe went back to the rack with the lamp and looked at it properly, as an archivist looks, and saw what she had walked past for twenty years. At the end of the oldest rack, before the first spool, there was a space a hand's breadth wide where no spools were; and on the rack's old steel, in that space, there were marks. Bright scratches, long since dulled, where something had been pulled out hard. Clamps, sheared. The bolt-holes for a drawer that was not there.\n\nThe older archivists had a joke, when she was a novice. When you could not find a thing, they said it was in the Blank Year. It meant the time before the First Keeping, about which the order had nothing: nothing in the stacks, nothing in the catalogue, nothing anywhere but the liturgy and a single loose sheet in the reliquary inventory, a reader's description of the throat that someone had once found tucked into a book and kept. *Drawn in like an iris.* Adaeze had laughed at the joke, at twenty-four. She had never once thought to ask why there should be a Blank Year at all, in an order whose whole purpose was to keep the record.\n\nShe did not go back up to the harp hall until evening. When she did, it was to clean the Fork.\n\nThat was her duty too. Once a month, and before every Draw and every Keeping, the archivist took the Founder's Fork from its cushion in the reliquary and cleaned it with a soft cloth and a little oil, and laid it back. She had done it two hundred times. She went into the alcove behind the iron grille and lifted it from the grey velvet and held it to the lamp, as she always did, and turned it: fifteen centimetres of old brass, the tines worn bright, the stem's engraving worn to ghosts. FOR CL. She had always loved that. *For Clarity.* As if the First Warden had cut the order's whole purpose into the instrument with which the hunger was first heard.\n\nShe cleaned it. The harp sang behind her in the hall, its long wide drone. And when she had finished, standing at the grille with the oiled Fork in her hand and the drone in her ears, Adaeze Quill did a thing that no archivist had done in her lifetime, and very likely in anyone's. She struck it.\n\nJust lightly. Against the heel of her hand, the way you would strike any fork. It was a tuning fork. It had been made to be struck.\n\nThe note came up out of it, pure and thin, and went out into the hall, and met the harp.\n\nThey did not agree.\n\nIt was not much. A hair. A quarter of a tone, perhaps less. But the Fork's note and the harp's drone were not the same note, and where they met they fought: a slow wavering throb in the air, *wah, wah, wah*, the sound two strings make when they are almost but not quite in tune, beating against each other. She stood in the alcove and listened to it beat until the Fork's note died away in her hand.\n\nThe harp was tuned every morning to the Hunger Tone. The Hunger Tone was the note the First Warden had heard the Needle's hunger in. The Fork was the instrument with which the First Warden had heard it.\n\nAnd they were not the same note.\n\nShe laid the Fork back on its cushion with great care. Her hands were steady; she noted that, distantly, the way she would have noted the condition of a spool. She went back to her little office off the archive and closed the door and sat down at her desk and opened, not the order's daybook, but the small private notebook that she had kept since she was a novice, in which she wrote the things she did not know what to do with. She wrote the date. She wrote:\n\n*No harp records before 2 May 2291. Forty-four years transferred to the First Warden. Not returned. Rack forced.*\n\n*The Fork is not tuned to the Hunger Tone. I struck it. They beat.*\n\nShe looked at the two lines for a long time. Then she wrote a third, and looked at it, and did not cross it out:\n\n*Why would anyone tune the harp away from the Fork?*","wordCount":1287,"createdAt":1793108947384,"updatedAt":1793108947384},{"id":"DF_5K_ypw4t8ssXyidO_g","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"ML9Npe3xZ6wpAxEVO7kvG","text":"The Lantern came into the Gutter at the change of the shift, when everybody was home, which was how Isra knew they had planned it.\n\nThey came down Rope Street in a long black line with lamps, real lamps, oil lamps on poles, swinging, so that the light ran ahead of them along the salt walls in long wavering yellow tongues and the shadows of the doorways jumped. Two by two. Knocking. Every door. Isra heard them coming from the far end of the tunnel and had time to do one thing, and the thing she did was take the shard out of her shirt and put it in her mouth.\n\nIt was cold. It tasted of salt and metal and the deep cold of the mouth. She tucked it into her cheek and sat down on the end of Hanne's bed and folded her hands.\n\n\"Girl,\" said Hanne, watching her.\n\n\"Shh.\"\n\nThey knocked on the ship-door. Pike, who had been sitting on the floor by the heater with his back to the wall, half-asleep, looked at Isra, and got up slowly and opened it.\n\nThere were four of them, young, in black, with the lamp on the shoulder. Behind them, in the tunnel, Deacon Rusk, holding no lamp, his hands clasped behind his back.\n\n\"Good evening,\" said the Deacon. \"Old Hanne. Isra. And — Pike, isn't it? Ostap Pike. I didn't know you'd come down to the Gutter.\" He smiled. \"I'm sorry to call so late. It's the levy. You'll have heard.\"\n\n\"We heard,\" said Pike.\n\n\"Then you'll know what we're looking for. Glass. Any glass at all. Cut, raw, dust, Return, beads, bowls, buttons, it doesn't matter. All glass is tithe.\" He nodded to the four young ones, and they came in.\n\nIt did not take them long. Hanne's room was full of things, but there was not much in it worth anything, and almost nothing of glass. They found a jar of glass-dust that Hanne kept for the cittern strings, to rub on them, she said, it made them speak. They found three old beads on a thread in the bottom of a tin of buttons. They found Pike's inhaler, which had a little cartridge of fine glass powder in it that the Pans doctor said eased the lungs, and the boy who found it looked at it and then at Pike, and Pike looked back at him and said nothing, and the boy put it in his bag.\n\n\"That's his medicine,\" said Isra. It came out muffled, round the shard. She did not care.\n\nThe boy looked at the Deacon. The Deacon looked at Isra, pleasantly, for a long moment.\n\n\"All glass is tithe,\" he said. \"I'm sorry. I'm sure the Pans doctor can find him something else.\"\n\n\"There isn't anything else.\"\n\n\"Then he'll have to manage,\" said Deacon Rusk. \"As we all will. We're all giving something, Isra Venn. The Lamplighter's giving her son. Some of us are giving our lives. A man's cough is not very much to ask.\" He tilted his head. \"Is there anything in your mouth?\"\n\nThe room went still.\n\n\"No,\" said Isra.\n\n\"Open it.\"\n\nShe did not. Pike moved — a small movement, just a shift of his weight, toward the Deacon — and two of the young ones moved too, toward Pike, with their hands going to their belts, and for a second it was all there in the little warm room, ready to happen.\n\n\"Oh, for the love of the door,\" said Hanne loudly.\n\nEveryone looked at her. She was sitting up against the wall with her cittern across her knees, small and brown and folded, and she was glaring at the Deacon with her bird's eyes as if he were a child who had trodden mud on her floor.\n\n\"I knew your mother,\" she said. \"Hettie Rusk. She sang flat. She sang flat at the Fifty-Seventh and she sang flat at her wedding and she sang flat at your naming, I was there, I heard her. And she'd be ashamed of you, standing in an old woman's room in the middle of the night going through her button tin. There's nothing in the girl's mouth but her tongue. It's the only thing in this family that's ever been worth anything, and you can't have it.\" She plucked the low string of the cittern, hard, a single angry note. \"Get out.\"\n\nThe Deacon looked at her for a long moment. Then, to Isra's astonishment, he laughed — a real laugh, light and surprised.\n\n\"My mother did sing flat,\" he said. \"Good night, Old Hanne.\" And he nodded to the four, and they went, with the jar and the beads and Pike's inhaler in their bags, and the lamps went away down Rope Street swinging, and the next door along began to be knocked on.\n\nIsra spat the shard into her palm. She was shaking.\n\nUnder the low string's dying note, in her cold wet hand, she felt it hum.\n\nPike sat down on the floor by the heater, slowly, the way he did everything now, and put his face in his hands. When he coughed, it went on for a long time. She sat down beside him and held the rag for him, and when it was over he did not take his hands from his face.\n\n\"I could have had him,\" she said. \"Rusk. I could have — you shouldn't have stopped me.\"\n\n\"I didn't stop you.\"\n\n\"You were going to.\"\n\n\"I was going to stop *them*,\" Pike said through his hands. \"Stop them stopping you. There's a difference.\" He lowered his hands. His eyes were red. \"Isra. Listen. Don't fight the Lantern. You don't know what they are.\"\n\n\"I know what they are. They're Rusk and a lot of boys with lamps.\"\n\n\"I was one of the boys with lamps.\" He said it flatly. \"Hanne told you. I know she did. I flew escort for the Lamplighter at the Fifty-Ninth. I was on the *Patience* with Rusk.\" He looked at the heater, at its little orange glow. \"We took the Keepers out to the mouth. Seven skiffs. Kids, mostly. Volunteers. They'd been in the Lantern House for weeks, singing, they'd been — \" He moved his hand. \"They were happy. You've never seen anything like it. They were so happy. And we took them out to the mouth at the start of the Long Night and they went in one after another, in a line, like birds. And one of them turned round.\"\n\nHanne had gone very still, on the bed. Isra did not move.\n\n\"Just turned round,\" said Pike. \"Right at the edge. Pulled up and turned and came back out toward us. We didn't know if something was wrong with the skiff. Or with him. And Rusk got on the channel and told him to turn back to the mouth, and he didn't, he just kept coming, and Rusk told him again, and he said something. On the open channel. We all heard it.\" His voice was very quiet. \"He said, *I don't want to. I'm sorry. I don't want to.*\"\n\n\"Pike,\" said Isra.\n\n\"And Rusk said, *Fire,*\" said Pike. \"And we did. The *Patience*'s forward guns. I was on the second gun. I fired.\" He looked at his hands, the big ruined hands that were so gentle on the grapple arm. \"We hit the engine. The skiff went dead. And it drifted. Just drifted, back toward the mouth, very slowly, with the pull. We watched it go in. Rusk said, *Well, he's a Keeper now,* and we turned for home.\" He was quiet for a while. \"I never knew his name. They didn't give us names, on the escort. I asked, after. Nobody would tell me.\"\n\nThe heater ticked. Down Rope Street the knocking went on, door after door, and the lamps swung, and somewhere far off somebody was shouting.\n\n\"That's what they are,\" said Ostap Pike. \"That's the Lantern. Don't fight it, Isra. It doesn't lose.\"\n\nIsra sat with the shard in her fist, and her other hand on his back, and said nothing. On the bed Hanne put the cittern aside, very gently, and lay down with her face to the wall, and after a while Isra realised that the old woman was crying, without a sound, the way you do when you have been doing it all your life.\n","wordCount":1399,"createdAt":1793093821575,"updatedAt":1793093821575},{"id":"E1kpxAiXVVUiu3osili5E","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"ifku_JzAmcnMrrHn5FNm6","text":"The Lantern was the third bar on Lantern Row and the only one where the beer was made from anything you could identify, and on the night of the second of March it was full to the walls.\n\nTeo came down the stair from the Pans lift still in her flight coveralls and found Nico at their usual table at the back, under the vent that dripped, with his cutter's goggles pushed up into his hair and the grey dust of Shaft Nine still in the creases of his knuckles, holding forth. He was always holding forth. He was twenty-six and had been holding forth since he could stand. Around him, five or six young cutters were listening with the expressions of people who had heard it before and liked it anyway.\n\n\"— because they need us more than we need them. That's the whole thing. That's all you have to understand. Who cuts the glass? We cut the glass. Who hauls it? Teo hauls it.\" He saw her and pointed. \"There. A worker. Look at her. Look at the state of her. Teo, tell them who needs who.\"\n\n\"I need a drink,\" she said, and he laughed and pushed his across the table to her, and she drank half of it and sat down.\n\nShe was always surprised by how glad she was to see him. It caught her every time, under the breastbone where the bead lay. He had their mother's long face and their father's terrible laugh and none of the caution either of them had died of, and when he was talking he lit up like a beacon string, and she had spent twenty years trying to keep him from walking into things and loved him for walking into them anyway.\n\n\"They held the lanes three hours,\" she said, low, under the noise. \"Something's wrong with the Needle.\"\n\nThe light went out of his face, a little. \"What kind of wrong?\"\n\n\"Corr says it flinched. I say I don't know. Approach wouldn't say anything. The Lectern's lit up like it's Founders' Day.\"\n\nCorrigan came in an hour later with Lulu on his shoulders, because he had nobody to leave her with on a long shift and the Lantern's owner had a soft spot for her and fed her fried salt-eel from the kitchen. She was nine and had her father's laugh and a bag of bolts she was collecting for reasons she would not explain, and she climbed down onto the bench next to Teo and showed her the new ones, and Teo admired them, and Corrigan sat down heavily and drank Nico's second beer without asking.\n\n\"Eleven marks,\" he said. \"Late docking. Eleven marks for holding where they told me to hold.\"\n\n\"I got eleven too.\"\n\n\"Everyone got eleven.\" He rubbed his face. \"They're going to say something tonight. There's a broadcast at twenty hundred. All screens. Mandatory. Fat Diz behind the bar says the screens in the Pans dorms have been showing the sunburst all afternoon.\"\n\n\"Fat Diz says a lot of things.\"\n\n\"Fat Diz says the Concern's pulling out,\" Corrigan said.\n\nNobody said anything. The bar went on being loud around them.\n\nMother Salome came in a little before twenty hundred, the way she always did on the nights there was trouble, as if she could smell it in the ventilation. She was sixty-odd, tall and stooped, ordained by nobody, with a face like a cliff that had been rained on for a long time. She did not drink. She went from table to table with her hand on people's shoulders, and she carried under her arm, wrapped in an old blanket, the Tally.\n\nTeo had seen it a hundred times and it still did something to her stomach. It was a plate of steel half a metre across, cut with a torch from one of the support beams they had dragged out of Shaft Nine after the collapse of eighty-six, and on it, in rows, scratched with a nail and a cutter's stylus and anything else to hand, were the names of the shaft's dead. Thirty-one from the collapse, at the top, in Salome's careful capitals. Below them the others, from bursts and glass-lung and falls and the slow ordinary ways, in a dozen different hands. Salome brought it out when somebody died and let the family scratch the name. She brought it out, too, on nights like this one, without explanation, and set it on the bar, and people touched it as they went past. Teo had never asked why.\n\nThe screens over the bar flicked to the sunburst at twenty hundred exactly, and the room went quiet in a ripple from the front to the back, and then Hesper Vane was there.\n\nShe was in her office, the Director's Gallery on Anchorage — Teo knew it from the window behind her, and the edge of the Needle in the window, bruise-coloured. She sat very straight and spoke without notes. She did not hurry.\n\nShe said that the Board of the Ostrander Concern had determined not to renew its Charter for the Reach. She said that the Concern was grateful. She said that all salaried staff of the Concern would be withdrawn, with such equipment as justified its passage, on the *Ostrander Providence*, departing the twenty-eighth of April, and that this would conclude the Concern's direct presence in the Reach. She said that the Concession continued; that all contracts, indentures and debts remained in force and remained the property of the Concern; that they would be administered locally, by an office of the Concession which she herself would head; and that the shipment of brine-glass to the Inward would continue at the current quotas. She said that she was confident that the people of the Reach would meet this change with the steadiness for which they were known.\n\nThen she said, in exactly the same voice, that Anchorage had today observed the beginning of a Narrowing of the Needle — a natural event, previously observed on four occasions — and that this Narrowing was expected to be deeper and longer than those before it; that throat traffic would be restricted from time to time; and that the Concession's throat-readers were monitoring it closely. She said that there was no cause for alarm. She said goodnight.\n\nThe screens went back to the sunburst.\n\nFor a moment nobody in the Lantern moved at all. Then everybody did. Somebody threw a glass at the screen and missed. Somebody was crying. Fat Diz was shouting for order and getting none. At the next table a cutter Teo half knew was standing on the bench yelling *what does it mean, remain the property, what does that mean* at nobody, over and over, as if one of them might know.\n\nTeo sat very still.\n\nIt meant what it said. That was the thing about Hesper Vane: everything she said meant exactly what it said, and you only had to listen. It meant that the Concern was leaving and taking its money and its people and its doctors and its ships, and leaving behind the paper. It meant that forty-one thousand two hundred and twenty-three marks — she had the new figure by heart already — were still owed, to a company that would be on the other side of the Needle, and would go on being owed, and would be collected by whoever sat in that office with the bruise in the window. It meant that she would haul glass for the Concession until she died, the way her mother had, and her mother's mother, and that the oranges would get more expensive, because everything would.\n\nAnd it meant that the door — the one door, the only door, the door she had looked at every working day of her life and stopped finding strange at nine — was doing something nobody had seen it do before. *No cause for alarm.* Hesper Vane had said it in the same voice as everything else. Teo had heard the Lectern's lights in it.\n\n\"They can't,\" Nico was saying. He was on his feet. His face had gone white under the dust. \"They can't just — keep the paper and leave. That's not — there are laws.\"\n\n\"Whose?\" said Corrigan, quietly. He had Lulu pulled in against his side. \"The laws are in Ardent, Nic. With the Concern.\"\n\n\"Then we don't pay.\" Nico looked round at the cutters, at the bar, at the whole loud frightened room, and Teo saw it come into his face, the thing she had spent twenty years keeping him from walking into, and saw that this time there was nothing she could do. \"They're leaving. Who's going to make us? The Director and her Marshal and whoever's too poor to get on the *Providence*? They need the glass. They said so. *The shipment of brine-glass will continue.* Who cuts it?\"\n\n\"Nico,\" she said.\n\n\"Who cuts it, Teo?\"\n\nThe cutters around the table were looking at him. Some of them were nodding.\n\nAcross the room Mother Salome had set the Tally down on the bar. She stood beside it with one hand flat on the steel, the way you would put a hand on the neck of a frightened animal, and she was looking at nobody, or at all of them. As Teo watched, people began to move past the bar and touch it, as they always did, without being asked — a hand, a fingertip, a palm — and go on. A cutter with a burn scar across his jaw. A woman with a baby. Lulu, slipping out from under her father's arm, standing on tiptoe to reach. One by one, the whole time the shouting went on, they went up and touched the names.\n\nTeo did not go. She sat with Nico's beer going warm in her hand and her other hand over the bead at her throat, which lay, she noticed — she could not help noticing — a little to the left. A little toward the mouth.","wordCount":1675,"createdAt":1793092538394,"updatedAt":1793092538394},{"id":"FYEqMXDaEPhjrGTqbJkZ-","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"pZV3tKudVeOMx5daISqWX","text":"The archive was on fire.\n\nAdaeze did not know how. The archive was in the spindle, not the wheels; it should have been the safest place in the Anchorhold. But the dead wheel's spokes ran into the spindle's heart, and when the wheel tore loose it had wrenched something deep in the structure, and somewhere behind the racks an old Concession power conduit had split and was spitting fire into three hundred years of paper. She had been at her desk, as she was most nights, with her private notebook open. She had smelled the smoke before the alarms. She had gone out into the archive and seen the far end of it lit up orange.\n\nShe did not leave. She did not consider leaving. She ran the other way, toward the oldest racks, toward the fire, with her sleeve over her face.\n\nThe oldest spools were crystal and would survive heat, a while. The paper would not. She pulled the paper first — the tuning logs, the daybooks, the bound volumes of the first readers after the Blank Year — and threw them into an armful and ran them out into the passage and dumped them on the floor and went back. The smoke got thicker. On the third trip she could not see the racks at all, and found them by touch, and her eyes were streaming and her lungs had begun to feel like something torn. On the fourth trip she remembered the Fork.\n\nThe reliquary was off the harp hall, not the archive. It was not burning. But the harp hall was on the far side of the archive from the passage, and the archive was a corridor of fire between them, and she stood in the smoke with her arms full of daybooks and thought, quite clearly, *If the hall goes, the Fork goes,* and dropped the daybooks, and went through.\n\nShe would not remember most of it. Heat on the side of her face. Her robe catching at the hem and her beating it out with her bare hands. The iron door of the harp hall, hot to the touch, and then the hall itself, clear, cool, enormous, the harp singing under the dome as if nothing in the world were wrong, and the mouth hanging over it, and — sitting on the floor in front of the harp in her nightshirt, with a body across her knees — Pell Asante.\n\nAdaeze stopped.\n\nIt was Ezra Lind. His face was blue. There was frost on his lashes and in his hair. Pell had his head in her lap and was holding it, with both hands, very carefully, the way you would hold a bowl of water, and looking down into his face, and not crying.\n\n\"He came to find me,\" said Pell. She said it to Adaeze as if continuing a conversation. \"When the wheel went. I was here. I'm always here at night. He knew. He came through the dormitory to find me and the section went while he was in it, and he got the door shut behind him, and he got as far as the spindle lock, and somebody pulled him in.\" She looked up. \"He walked here. On his own. He walked all the way here from the lock. He wanted to tell me he'd found me.\" She looked down again. \"And then he sat down.\"\n\n\"Pell,\" said Adaeze.\n\n\"He failed his sled licence twice,\" said Pell. \"He told me. He said the Needle had made a clerical error.\" And then she did cry, all at once, bending over the dead boy's face with her whole body shaking and no sound coming out of her at all.\n\nAdaeze went to the reliquary. She did that first. She would think about that, afterward, for a long time — that she had gone to the grille before she went to the girl — and she would never be sure whether it had been faith or something less. She unlocked the grille with her archivist's key, and took the Fork from its grey cushion, and put it inside her robe, against her skin, where it lay cold and heavy. Then she went and knelt beside Pell on the floor in front of the harp and put her arms round her, and the dead boy too, and held them both.\n\nThat was how Juno Asante found them, eleven minutes later, coming through the iron door from the burning archive in a damage-control suit with a cutting torch in one hand and three of her crew behind her, with her faceplate up and her face black with smoke.\n\nShe stopped in the doorway, as Adaeze had.\n\nThen she came across the hall and knelt down in front of her sister.\n\n\"Pell.\"\n\nPell lifted her head. She looked at Juno for a long moment as if she did not know her. Then she said, quite clearly, \"Juno, he's dead,\" and Juno said, \"I know, I know he is, I'm here,\" and took her sister's face in her two gloved hands.\n\nThey got everyone out through the harp hall's far door, the one that led up the spindle away from the fire: Adaeze, and Pell, and two of Juno's crew carrying Ezra Lind between them on a stretcher made of a Warden's cloak. On the way past the passage door Adaeze stopped, and Juno, behind her, saw what she was looking at: the heap of daybooks and bound volumes and tuning logs on the passage floor, where she had dumped them, singed, smoke-blackened, lying in a spreading pool of the foam the station's suppressors had finally begun to spray.\n\n\"Those,\" said Adaeze. \"Please. Those.\"\n\nJuno looked at her, and at the books, and did not ask. \"Marsh. Get those. All of them.\"","wordCount":965,"createdAt":1793109507219,"updatedAt":1793109507219},{"id":"Gdg879pA4HIO5MVWIi38A","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"9Zu1VoadNFCr60Qvn4LVB","text":"The Gutter was the outermost ring of old Tallow, the oldest part of the town, where the first tunnels had been cut down into the salt by the first machines before anybody living could remember. It had been abandoned once, Hanne said, in the good times, when Tallow had spread itself up into terraces and light-wells and gardens. Now the terraces were cracked and dark and most of the light-wells had fallen in, and the Lantern held what was left of the upper town, and the Gutter was full again: bone-pickers, Shoals families who had come in from the rocks when the rocks ran out of air, people who could not pay for heat higher up. The tunnels were narrow and low and smelled of salt and cooking and cold, and everything in them was the same grey-white as the walls, and the only colour anywhere was what people had painted.\n\nHanne's room was at the end of a dead-end tunnel off Rope Street, behind a door that had once been part of a ship. It was warm, because Isra paid for it to be warm. It was full of things: rags and pots and bundles of dried salt-weed and a thousand scraps of paper and plastic and foil, all of them covered in Hanne's writing, the songs and the scraps of songs and the stories she had collected for sixty years, and the sayings, and the lists of names. It smelled of her, and of the weed she smoked, and of the old wood of the cittern.\n\nShe was sitting on the bed with the cittern on her knee when Isra came in, tuning it.\n\n\"You're late,\" she said. \"And you've got nothing. I can tell by your face. They took it.\"\n\n\"They took it.\"\n\n\"The Lantern.\"\n\n\"Deacon Rusk.\" Isra sat down on the floor with her back against the bed and her head against her grandmother's knee, which she had not done since she was small, and Hanne put a hand on her hair and left it there, and went on tuning with the other.\n\n\"Rusk,\" said Hanne, \"is a little shit.\"\n\n\"Yes.\"\n\n\"His mother was a little shit before him. I knew her. She sang flat.\" Hanne plucked a string, frowned, turned a peg. \"I heard her, you know. Mercy. On the speakers. A hundred Keepers.\"\n\n\"Pike says she'll get them.\"\n\n\"Pike would know.\" Hanne's hand moved on her hair. \"He flew escort for her, at the Fifty-Ninth. Did you know that? Before you took him on. He was one of her boys, then. He doesn't talk about it.\" She plucked the string again. \"Nobody comes back from the Lantern the same.\"\n\nIsra had not known that. She sat with it for a while.\n\n\"Sing me something,\" she said.\n\n\"What do you want?\"\n\n\"I don't care. Something old.\"\n\nHanne thought. She was seventy-three and looked older, small and brown and folded, with a face like a dried apple and eyes like a bird's, and she had been a teller all her life, like her mother before her and her mother's father. A teller kept things. That was all it meant. In the Quiet, Hanne said, when the machines that kept things had all broken and the Compact had broken and nobody could read anything older than their grandmother's handwriting, the tellers had kept what there was to keep, in their heads and their mouths and their hands. Most of it was wrong. Hanne said that too. *Most of it's wrong, girl, but it's all we've got, and wrong is better than nothing, because you can fix wrong.*\n\nShe played a few bars, slowly, and then she sang.\n\nIt was the one everybody knew, or knew the start of: the Long Night. The tune was the Hunger Tone underneath, the long drone on the low string that you heard in the Lantern House and in the Wardens' chapel at the Anchor, but Hanne's version had words over it, old words, worn smooth.\n\n*The door grew narrow in the dark,\nthe Reach was cold and small,\nthe First Warden heard it hunger\nand the Reach gave of its all.*\n\n*They loaded glass in little ships\nand flew them through the night,\nand what the Needle keeps, it keeps,\nand in the morning, light.*\n\nThere were more verses. There were always more verses; Hanne had collected forty of them, from forty different tellers, and they contradicted one another on almost every point. Isra had heard them all. She listened anyway, with her eyes closed, her head on her grandmother's knee and the warm drone of the low string going through her.\n\n\"Is it true?\" she said, when it was finished.\n\n\"Which bit?\"\n\n\"Any of it. That it's hungry. That feeding it works. That there was a First Warden who heard it.\" She opened her eyes. \"Gran, everybody on the speakers is going to be saying it's true for sixty days. I want to know if it's true.\"\n\nHanne was quiet for a long moment.\n\n\"I don't know,\" she said. \"I'll tell you what I know, and you can do what you like with it. There was a Concession, before the Compact. That's true. A company from the Inward that owned everything and everybody, and dug the salt, and shipped the glass out through the door. There was a first Narrowing, a bad one, and there was a first Keeping, and the door opened. That's true too, or it's what everybody says, which isn't the same, but it's what we've got. Then there was the Compact, for three hundred years, and the Wardens, and the Draw, and they kept the door every four thousand days, and it opened. Then there was the Severance, and then there was the Quiet, and everything broke, and when it came back together nobody could remember properly how anything had been done. The Wardens kept on keeping. Then they kept less. Then for a while, my gran said, hardly anybody kept at all, and then the Lantern came and started again.\" She shrugged. \"That's it. That's what I know. Whether it's hungry I couldn't tell you. Nobody's ever asked it.\"\n\n\"The Lamplighter says the Returns mean it's starving.\"\n\n\"The Lamplighter would. She has to say something, poor cow. She put her own boy in it.\" Hanne set the cittern upright against her knee. \"The Wardens say it's dying. That's all I've heard from them, the last ten years. *It's dying.* Never why.\"\n\nIsra was quiet. Then, without quite knowing why she did it, she unclipped the fist of banded glass from her belt and held it up.\n\n\"I kept this back. From the Return. Look.\"\n\nHanne took it and turned it in the lamplight, and her eyebrows went up. \"Well, that's a pretty thing. Layered. I've never seen glass layered like that.\" She held it closer to her face, squinting. \"Like a cake.\"\n\n\"It was at the root. Where it grew out of the hull. It's all like that, all the way down, and it all leans the same way.\" Isra did not know how to say what she meant. \"Like it was pushed. Like something pushed the ship out and the glass grew while it was being pushed.\"\n\nHanne looked at her, and then at the glass, and did not say anything. Then she did a strange thing: she held the chunk of glass out over the cittern, close to the strings, the way you might hold a cup under a tap, and with her other hand she plucked the low string. The drone sounded. And the glass — Isra heard it, she would have sworn she heard it — the glass hummed back. Very faint. A note under the note, sweet and thin, like a fingertip on the rim of a wineglass, there and then gone as the string died.\n\nThey both sat very still.\n\n\"Huh,\" said Hanne.\n\n\"What was that?\"\n\n\"I don't know.\" Her grandmother's voice was odd. She plucked the string again, and again they heard it, the faint sweet answering hum from the glass in her hand. \"My gran used to say — this was her gran's, I think, or some teller before — she used to say that glass sang, back when the door was well. That the cutters used to hear it singing in the seams, down in the salt, like it was answering something. I always thought it was one of those things people say.\" She looked down at the glass. \"I've never heard it. Not once in my life.\"\n\n\"It's not singing now. It's — answering the string. That's all.\"\n\n\"Is it?\" said Hanne.\n\nShe held the glass out to Isra, and Isra took it. It was cold in her hand, from the mouth, the deep cold that never quite went out of Return glass. She held it, and Hanne plucked the low string one more time, and Isra felt it, through the palm of her hand, tiny, unmistakable: the glass shivering against her skin, like something alive. Like something trying to tell her a thing in a language she did not have.\n\nOutside in the tunnel somebody's speaker was playing the Lamplighter's proclamation again, from the beginning, the warm low voice coming small and tinny through the ship-door. *Children of the Reach. Listen to me now.*\n\nIsra put the glass inside her shirt, against her skin, where she could feel it, and sat with her head against her grandmother's knee, and listened.\n","wordCount":1576,"createdAt":1793093146685,"updatedAt":1793093146685},{"id":"HvGyen8JRPnJpI6MX_Njf","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"HK0cNzC8O31steAchWygx","text":"He told her the next morning, because of Teo Kesh's face.\n\nHe had not meant to. He had meant to wait five weeks and watch and know. But he had lain awake all night with the pilot's question in his ears — *is there anything at all that you know* — and the honest answer was that there was, a little; that there was a sum on the back of an envelope and a swell in four old paper traces, and that a man was going to fly into the Needle in six days and it might be for nothing. So at nine in the morning he went up to the Gallery, without an appointment, and Hesper Vane's secretary looked at his face and let him in.\n\nHe told her everything. The swell. The old traces, the fork, the drift corrected. The two rhythms. The long tide at its bottom. He laid the envelope on her desk with the sum on it. He told her it was not proven; that it was a hypothesis; that it would take five weeks to know. And he told her that if it was right, the Needle would reach its narrowest on or about the first of May and then begin to recover on its own, whatever anyone did, and that therefore there was no reason to send Corrigan Dace into the throat on the second of April. Or anyone. Ever.\n\nShe listened to all of it without interrupting, as she always did. She did not touch the envelope. When he had finished she sat for a while with her hands folded on the desk, looking at it.\n\n\"Who else have you told?\" she said.\n\nHe blinked. \"No one.\"\n\n\"Miss Shore?\"\n\n\"No. She knows I've been looking at the old traces. Not why. Not what I found.\"\n\n\"Your daughter?\"\n\nHe thought of the letter in his breast pocket, unsent, with the others. \"No.\"\n\n\"Good,\" said Hesper Vane.\n\nShe picked up the envelope then, and turned it over, and looked at the sum on the back for a long time, and Ambrose watched her read it and understood, slowly and with a sensation like cold water rising in a room, that she was following it. All of it. Every step.\n\n\"If this is right,\" she said at last, \"the waist will narrow steadily until the end of April. And then turn.\"\n\n\"If it's right.\"\n\n\"And between now and then? Does your swell do anything else? Are there smaller turns? Places where the waist pauses, or recovers a little, before it goes on down?\"\n\n\"There — \" He stopped. \"There's a short ripple on the long one. A few days' period. The waist narrows in steps, not smoothly. It'll pause, sometimes. Recover a point or two. Then go on down.\"\n\n\"When is the next pause?\"\n\nHe looked at her.\n\n\"The trial is on the second of April,\" Hesper Vane said evenly. \"If there is a pause in the narrowing at or about the second of April, then the trial will be followed by a pause in the narrowing. People will see the trial, and then they will see the throat hold. Perhaps even open, a little.\" She laid the envelope down. \"That would be very helpful, Ambrose. You understand that? That would be extremely helpful. To everyone. It would make the Keeping work.\"\n\n\"It wouldn't *work*. It would — it would just be timed to — \"\n\n\"It would be seen to work,\" she said. \"Which is what matters to the people who will be asked to fly it. And to cut for it. And not to burn Anchorage down in the meantime.\" She looked at him with her steady grey eyes. \"When is the next pause?\"\n\nHe said nothing.\n\n\"Ambrose.\"\n\n\"I'd like to go back to the Lectern now, Director.\"\n\nShe held his eyes for a long moment. Then she nodded, very slightly, as if he had answered.\n\n\"Of course,\" she said. \"Thank you for bringing this to me. It's important work. I'd like you to keep working on it, and I'd like it to stay between the two of us until it's proven. Lock the file. You've locked it already, I expect. Good.\" She picked up her slate. \"I'll ask Miss Shore for the short-term projections. She can read a trace as well as anyone, I'm told. You trained her.\"\n\nHe went out. He walked back down the spindle to the Lectern with his hand in his jacket pocket round the fork, and he could not afterward remember a single step of the way.\n","wordCount":760,"createdAt":1793108784252,"updatedAt":1793108784252},{"id":"IPJxcnKZ1IY1SON4SHfcI","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"NMFiRPEGMSBYJ4zYLOJeS","text":"The order came through the day after she got back aboard: the *Vigil* was detached from the Shoals patrol and assigned to the close escort of the Thirtieth Keeping, with station at the Anchorhold from the twentieth of November until the Narrowing.\n\n\"They're giving us the Keeping,\" said Marsh, reading it off the slate in her day cabin with his eyebrows up. \"That's — Captain, that's an honour. That's a flag posting. Six weeks parked at the Anchorhold guarding the glass stores and then we fly the Keepers to the mouth.\" He looked up and saw her face, and his own changed. \"Oh. Oh, Captain. I didn't think. I'm sorry.\"\n\n\"Don't be. It's an honour.\" Juno took the slate off him. \"Somebody pulled a string for it. I'd like to know whose.\"\n\n\"The Admiral, probably.\"\n\n\"Probably,\" Juno said, and did not believe it.\n\nMor, she thought. Or her mother. Either of them could have done it, for opposite reasons. She did not know which would be worse.\n\nThe other message came in on the evening watch, on a channel it should not have been able to use: a Shoals relay, bounced off three rocks and an abandoned ore station, unencrypted, plain text, addressed to her by name. Marsh brought it to her himself, with the door shut behind him.\n\n\"It came in on the old Academy frequency,\" he said. \"The cadet band. Nobody's used it in years. Comms only caught it because Siddiq's a sentimental idiot and still listens to it.\" He put the slate down in front of her. \"Captain, if this gets logged — \"\n\n\"It's logged,\" Juno said. \"Everything's logged. Leave it with me.\"\n\nHe left it with her. She read it once.\n\n*JUNO. I HEARD ABOUT PELL. I'M SORRY. YOU KNOW I AM. ASK THEM HOW THE NAMES ARE CHOSEN. — R.*\n\nShe sat with the slate in her hands for a long time.\n\nRhee Calder had been in her year at the Academy. They had shared a simulator pod for two years and a bed for six months of the third, and he had been the best pilot in their intake and the worst at doing as he was told, and she had loved him in the uncomplicated way you love someone at twenty. He had a younger brother, Callum. At the Twenty-Ninth Draw, eleven years ago, when Juno was twenty and Rhee was twenty and Callum was eighteen, the Wheel had turned and Callum Calder's name had come out of it. He had flown. He had not come back. Rhee had gone very quiet, and stayed quiet through their last year, and two days after commissioning he had taken a Compact patrol cutter out on a routine flight to the Shoals and not brought it back either. Six years ago, when the Shoals refused their quota, the Free League's first fleet commander had been a man the Compact papers called the Saltjack, and the face in the grainy picture had been his.\n\nShe had fired on his ships. He had fired on hers. They had never spoken since.\n\n*Ask them how the names are chosen.*\n\nShe thought of the Hall. The seventh slip of foil. The High Warden's eyes lifting to the Speaker's terrace before he read. *I hope she will remember that her daughter flies in it.* She thought of Sister Quill at her desk: *two hundred and six petitions. He has declined every one.* The one place in the Reach where everyone was the same.\n\nShe logged the message, as regulations required, with a note — *unsolicited enemy contact, no reply sent* — and sent it up the chain to Squadron. Then she sat for a while longer in the dark of her cabin, with the *Vigil*'s engines thrumming through the deck and the slate's afterglow fading on her palm, and found that she had memorised it anyway.\n","wordCount":646,"createdAt":1793093538710,"updatedAt":1793093538710},{"id":"IY3iXRX5aK4tHe0lADAAB","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"ClR43RbcbdVKODlz1mtSi","text":"The old traces were on paper.\n\nThe Lectern's archive was a narrow room behind the dome, lined with steel drawers, and in the bottom drawers, under fifty years of spools and crystals, were the harp records of the first Narrowings: long rolls of thermal paper from the days before the station had memory to spare, printed with the traces in faded violet ink. Ambrose had not looked at them since he wrote his paper on the Narrowing of fifty-eight, twenty years ago. Nobody had. He spent the night of the twenty-fourth on the floor of the archive with all four of them unrolled around him, weighted at the corners with coffee mugs, his reading glasses on and a lamp on the floor beside his knee, while Bettany slept at her console in the dome with her head on her arms.\n\nHe was looking for the swell.\n\nHe had listened to it every night since the buoy went out. It was there. It was not the instrument; the buoy heard it louder than the harp did, from two million kilometres closer, and the buoy and the harp were different instruments built ten years apart and agreed about nothing except what they were both hearing. A long slow rise and fall under the throat's chord, with a period of a little over four minutes. Not steady. That was the thing. The period was *drifting* — lengthening, very slightly, day by day, the way a pendulum's swing lengthens when you let out the string. He had a column of figures for it in his notebook. He did not like what the figures were starting to look like.\n\nIf it was real now, it had been real before.\n\nThe trouble with the old traces was that they were made on the first harp, the little one, the prototype he had built in Ardent and shipped through in crates before the real harp was finished; and the little harp had drifted badly. Its strings had crept, the way strings do. Every trace on those old rolls was a little out — sharp, flat, smeared — by an amount that changed from day to day. You could not lay them over each other and compare them. Everyone who had studied the old Narrowings had said so, including Ambrose, in print.\n\nBut he had tuned the little harp, every morning, to the fork.\n\nHe had forgotten that until three nights ago, lying awake in his bunk. He had tuned it every morning to the fork, and logged the tuning, and the tuning logs were on the same paper rolls, in the margins, in his own younger handwriting: *0600, ref 440, strings 3 and 7 flat 2c, corrected.* Every morning for five years. Which meant that every trace on those rolls could be referred back to the same note — to the fork, to a scream in a delivery room in Ardent — and corrected, day by day, for exactly how far the strings had drifted. It was tedious work. It took him all night. He did it with a pencil and a slide rule and the fork itself lying on the paper beside him, as if it might help.\n\nAt four in the morning he stopped and sat back on his heels and took his glasses off and looked at what he had done.\n\nThe swell was there. In all four.\n\nFaint, under the drift; but there, once you had taken the drift away. The same slow rise and fall under the throat's chord. In forty-seven, in fifty-eight, in sixty-nine, in eighty. And in each of them it was at a different place in its own long cycle — he could see that now, laying the corrected traces side by side — rising in one, falling in another, near its crest in fifty-eight, near its trough in eighty. And the depth of each Narrowing followed it. Exactly. Where the swell had been high, the Narrowing had been shallow. Where it had been low, the Narrowing had been deep. Eighty, the deepest before this, had come with the swell near its lowest.\n\nTwo rhythms. That was what he was looking at. The breathing — the Narrowing, every four thousand days, regular as a clock. And under it something much slower, a long tide with a period of decades, rising and falling, so that sometimes the breath came at high water and was hardly a breath at all, and sometimes it came at low water and went deep. Two rhythms beating against each other, the way two strings a hair out of tune beat against each other, *wah-wah-wah*, louder and softer, louder and softer.\n\nAnd if the long tide had been falling through eighty, it would be lower now. At its lowest. At the very bottom.\n\nHe did the sum on the back of an envelope with his hands not quite steady. He did it three times. The swell's drifting period, the slow lengthening he had been logging all week, was exactly what you would expect from a tide approaching its turn — slowing, as a pendulum slows at the top of its swing, before it comes back. If the pattern held — *if* — the long tide would turn somewhere in the last days of April. And the waist would go down, and down, to a little above twenty per cent, perhaps, on or about the first of May. And then, on its own, because the tide had turned, it would begin to come back.\n\nHe did not know that. He had four Narrowings and a hypothesis. He had a swell he could not explain and a sum on the back of an envelope. If he had seen it in a student's paper he would have written *suggestive* in the margin and sent it back. To know it he would have to watch: watch the swell's period, every night, for the next five weeks, and see whether it slowed and turned exactly when the sum said it would. If it did, he would know.\n\nHe sat on the archive floor in the lamplight among the paper rolls and the coffee mugs, and the fork lay on the paper beside his knee, and he thought: *nobody has to fly into it.* And then, more carefully: *nobody may have to.*\n\nHe picked up a clean sheet of paper and wrote at the top of it, *Dear Clare*. He had begun a great many letters that way over the years. He had sent very few of them. He wrote:\n\n*I think I have found something. I can't tell anybody yet, because I'm not sure, and because the person I'd have to tell first is not someone who would use it kindly. So I'm telling you, because you are a long way away and won't read this for months, if I send it, which I probably won't. The Needle breathes, love. It has two breaths, a short one and a long one, and they beat against each other like strings. Your note is what let me hear it. The note you were born screaming, that I tuned everything to. I don't know if that makes any sense. It is four in the morning.*\n\n*I'm coming home on the Providence. I'll bring the fork. I'll explain.*\n\nHe folded the letter and put it in his breast pocket with the others, and put the fork in the pocket of his jacket, and went out into the dome, where the harp was singing its thin high strained chord under the bruise of the mouth and Bettany was asleep at her console with her cheek on her slate. He stood and listened to the harp for a while. Then he woke her, gently, and sent her to bed, and sat down at his own console and opened a new file and named it, after some thought, *SWELL*, and locked it to his own key.","wordCount":1318,"createdAt":1793108784854,"updatedAt":1793108784854},{"id":"N7pq356Jb33DmDQ8dpj2C","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"7A-3QhcGlYSpYsRlTXcJh","text":"The Anchor looked, from the outside, like something that had died with its eyes open.\n\nIsra had seen it before, from the Ossuary — a far-off spindle with two wheels, dark against the bruise of the mouth — but she had never been close, and coming in on it in the Gristle she found that she did not like it. It was too big. It had been built for thousands of people and was lived in by a dozen, and you could see which parts they lived in, because those parts had lights: a cluster of windows at the near end of the spindle, a band of them round one wheel. The other wheel did not turn. It hung there motionless, its windows black, its spokes furred with frost, and somewhere on its rim a loose panel was flapping in a wind that did not exist, opening and closing, opening and closing, catching the grey light of the mouth each time like a slow wink.\n\n\"Gristle, Anchor.\" An old man's voice on the radio, dry, unhurried. \"State your business.\"\n\n\"Bone-picker. I've got wire. Resonator wire, good, a full spool. I was told the Wardens buy it.\"\n\nA pause. \"Brother Lucan buys it. Dock Four. Mind the second ring of the dock, it's loose.\"\n\nThe dock was huge and empty and cold and the second ring was very loose. Isra tied the Gristle up with her own lines rather than trust the dock clamps, and climbed out with the spool of wire over her shoulder in its sack, and stood in the middle of the great dark hangar under the one working light, and waited, and felt the place around her: miles of corridor, hundreds of rooms, all of it silent, all of it cold. She had stripped Returns with dead men in them and felt less watched.\n\nThe man who came for her was younger than she had expected. A Warden — the grey robe, the silver at the cuffs gone dull and the cuffs themselves frayed — but not much older than her, thin and quick, with a long face and ink on his fingers and a pair of reader's spectacles shoved up into untidy dark hair. He came across the hangar at a sort of half-run and stopped in front of her a little out of breath.\n\n\"You've got wire,\" he said.\n\n\"I've got wire.\"\n\n\"Is it — sorry. Brother Lucan.\" He held out an inky hand and then seemed to think better of it and put it back in his sleeve. \"Is it really resonator wire? Not cable? People bring cable. They think because it's thin — \"\n\nIsra swung the sack down and opened it. The spool inside was a hand across, wound tight with wire so fine it looked like a strand of light, silver, unoxidised, because she had found it sealed in a cannister in the bowels of an old Compact ore-hauler that had been drifting at the edge of the Ossuary for longer than anybody remembered. She had known what it was because Hanne had told her what to look for, years ago. *If you ever find wire that rings when you pluck it, girl, don't sell it to the Pans. Take it to the Wardens. They'll give you anything.*\n\nBrother Lucan knelt down on the hangar floor and took a length of the wire between his fingertips, very carefully, and plucked it. It rang. In the cold empty hangar the note went up into the dark like a bird. He shut his eyes.\n\n\"Where did you get this?\"\n\n\"Return. Old one. Before the Quiet.\"\n\n\"It's Compact. It's real Compact resonator stock. We haven't had any in — \" He opened his eyes and looked up at her. \"What do you want for it?\"\n\nShe had planned to ask for a lot. She found she did not quite know how much was a lot to a man in a frayed robe in a station that was mostly dark. \"What've you got?\"\n\n\"Not much,\" he said honestly. \"Food. We have food. We have a greenhouse on the near wheel that does better than anything in Tallow, and the Prior lets me trade from it. And medicine, some. And — \" He hesitated. \"I don't suppose you want to see the harp? People sometimes do. Before they decide.\"\n\nShe had not meant to. She went.\n\nHe led her up through the spindle, through long dim passages where his footsteps echoed and the air smelled of old metal and incense and cold, past doors that opened on dark rooms full of nothing, until they came to a vaulted gallery lined with empty racks, and an iron door at its end, and through it into the harp hall.\n\nIsra stopped in the doorway.\n\nThe mouth filled the dome. She had seen it every working day of her life, from the Ossuary, from the Pans; she had never seen it like this, so close, so huge, leaning over the glass like something looking in. And under it, in the middle of the worn floor, the harp. A frame of something like gold glass, taller than Pike, strung with long lines of wire that held the grey light of the mouth and glowed with it faintly; and it was singing. A low, wide, many-stranded sound that she felt more than heard, in her chest and her teeth and the soles of her feet. It was the Hunger Tone — she knew it from Hanne's cittern, from the Lantern House speakers — only it was not quite. It was the Hunger Tone the way a person's voice in another room is their voice.\n\n\"It reads the throat,\" Lucan said quietly beside her. \"The throat makes a sort of — noise, all the time. Gravitational noise. The wires pick it up and sing it. A reader listens and works out the shape of it. Where the waist is. How narrow.\" He went to the harp and laid his palm flat against the frame, the way you would touch a horse. \"This frame is the First Warden's. It's the oldest made thing in the Reach. The wires are whatever we can get.\" He grimaced. \"Which hasn't been much, lately. Three of the low courses are spliced. Two of them are just — wrong. I tune them every morning and by the evening they've drifted. Your wire would — \" He stopped, and looked at the spool on her shoulder, with an expression on his face that she recognised from the Pans buyers when they saw good Return glass. Hunger. \"It would make a difference.\"\n\n\"Show me,\" she said.\n\nHe restrung one of the spliced courses while she watched. It took an hour. He did it on his knees on the cold floor with his spectacles on and a little pair of pliers, talking the whole time, half to her and half to himself: how the wire had to be tensioned, how it had to be seated, how you could hear a bad seating as a kind of buzz in the chord. When he had finished he stood back and tuned it. He did that by ear. He stood with his eyes shut and his head on one side and *sang* — a low long note, the drone she knew — and turned the peg at the top of the frame a hair at a time until the new wire stopped fighting the note and lay down inside it.\n\n\"The Hunger Tone,\" he said, when he had finished. \"That's what we tune to. Every reader learns it at investiture. The Prior sings it, and you sing it back, until you can't not.\"\n\n\"What about that?\" Isra nodded toward a little alcove off the hall, behind an iron grille, where a lamp burned in front of something small and brass on a grey cushion. She had seen it when she came in.\n\n\"That's the Fork. The First Warden's Fork.\" He said it with a kind of embarrassed reverence, as if he were introducing her to his grandmother. \"It's — well. It's the holiest thing we've got. It's said to be what the First Warden heard the hunger with. It's struck once at every Keeping, here, when the Keepers go in. You can see the motto on it, if you get close. *For Clarity.*\" He made a face. \"Mostly worn off. It says FOR CL.\"\n\n\"Don't you tune with it?\"\n\n\"Oh, no. No. It's a relic.\"\n\n\"It's a tuning fork.\"\n\n\"It's a *relic* tuning fork.\" But he was smiling a little. \"You sound like me when I was a novice. The Prior used to send me to the chapel for a day for saying things like that.\"\n\nShe did not smile back. She was thinking of something else. Without meaning to, she had put her hand flat against her chest, over the shard of banded glass that she had worn inside her shirt for twelve days now, on a cord, against her skin. She had been holding it there since he started tuning. It had not stirred. Not once. Not when he plucked the new wire, not when the whole harp took the note and sang it back.\n\n\"Can I tell you something stupid?\" she said.\n\nHe looked surprised. \"Of course.\"\n\nShe took the shard out and showed him, and told him. The Return, the layered root, the bands like a cliff. Hanne's cittern. The low string, and the glass humming back.\n\nBrother Lucan held the shard in the light of the reliquary lamp for a long time, turning it, his spectacles down on his nose.\n\n\"It hummed,\" he said. \"At your grandmother's cittern.\"\n\n\"Every time she plucked the low string.\"\n\nHe went to the harp and held the shard against the frame, close to the new wire, and plucked it. The note sang out. The shard lay in his hand, dull, silent.\n\nHe plucked it again. Nothing.\n\n\"Maybe it's broken,\" Isra said. \"Maybe whatever it did, it's stopped.\"\n\n\"Maybe.\" He did not sound as if he thought so. He gave it back to her, and his eyes went for a second, she noticed, to the reliquary, to the little brass fork on its cushion; and then away again, quickly, as if he had caught himself looking at something he should not. \"What's your grandmother's cittern tuned to?\"\n\n\"I don't know. Whatever she tunes it to. It was her gran's. She tunes it by ear.\"\n\n\"Huh,\" said Lucan.\n\nHe was quiet for a moment. Then, in a different voice, brisk, as if changing the subject on purpose: \"Would you like to see the Bell? Before you go? It's the other old thing we've got. Most people don't know it's there.\"\n\nHe took her to a telescope at the side of the dome, an old heavy brass thing on a pivot, and fussed with it, and stepped back. She put her eye to it.\n\nAt first there was only the mouth, filling everything, grey-gold at the rim. Then, very small, at the edge, she saw it: a little grey cylinder hanging in the glow, motionless, nose toward the dark, with something at its tail end that might once have been a frame of wires, open like the ribs of an umbrella, now bent and furred with frost.\n\n\"It's a buoy,\" said Lucan. \"A listening buoy, we think, like a little harp. It's been there longer than the order's records go back. Longer than the Quiet, certainly. The mouth's pull holds it. It hasn't moved in three hundred years that we know of. It doesn't do anything now. It's dead.\" He paused. \"The old Wardens used to say the First Warden put it there. To listen to the Needle from close by. So they called it the Bell.\"\n\nIsra looked at it for a long time through the cold brass eyepiece: a small dead thing, holding its place at the edge of the dark, listening to nothing.\n\n\"I'll take food,\" she said, straightening. \"And medicine. For a man with glass-lung. Whatever you've got. And you can have the spool.\"","wordCount":2012,"createdAt":1793093822169,"updatedAt":1793093822169},{"id":"SVRlYbcfZJGiCyDkkyFOg","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"ebwH9gT0DAJ1sHnICO72u","text":"They were cutting a cradle into the Brannock's belly when Teo came onto Dock Four, and she knew before she saw Corrigan's face.\n\nThe tug sat in her cradle with her undersides opened up and a team of Concern fitters crawling over her with torches, welding a frame of new steel girders into the space where her sled-coupling had been. A cradle. For a load, carried under, released by a lever. Teo had seen the drawing on the dispatch board that morning, pinned up beside the notice: *TRIAL KEEPING. ONE VESSEL. VOLUNTEER PILOT ACCEPTED.* She had read it and gone cold and told herself it was somebody else.\n\nHe was sitting on a crate at the edge of the dock with Lulu beside him, eating fried salt-eel out of a paper cone and watching the fitters work. He saw Teo coming and stood up and wiped his hands on his coveralls and did not try to look as if it was anything but what it was.\n\n\"Lulu,\" he said, \"go and see if Fat Diz's boy is on the dock office, would you? Ask him if he's got any bolts.\"\n\nLulu looked at her father and then at Teo, with the expression of a nine-year-old who knows exactly why she is being sent away, and went.\n\n\"You signed,\" Teo said.\n\n\"I signed.\"\n\n\"The *trial*. Corrigan. The trial. Not even the Keeping. She's sending one ship in, in the middle of the Narrowing, to see what happens. To *see*. You're the experiment.\"\n\n\"I'm the experiment,\" Corrigan agreed. \"Experiment gets the same as everybody else. Debts cancelled in full. Mine, Lulu's, my father's. It's in writing. I've got it in writing, Teo, with the sunburst on.\" He patted his chest pocket. \"And the trial goes on the second of April, so I don't have to sit around for five weeks thinking about it. I just go.\"\n\n\"You might not come back.\"\n\n\"I might not come back,\" he agreed again, gently. \"I know that.\"\n\nShe wanted to hit him. She stood on the dock with the fitters' torches spitting behind him and wanted to hit him so badly that her hands shook. \"Then *why*?\"\n\nHe was quiet for a while. He looked over at the Brannock, at her opened belly and the new steel going in.\n\n\"I'm tired, Teo,\" he said.\n\n\"Everybody's tired.\"\n\n\"No. I mean — \" He rubbed the back of his neck. \"I'm forty. I've been flying glass since I was seventeen. I owe more now than I did when I started. Mira's been dead four years and I'm still paying for her dying. Lulu's going to start paying for it the day I stop. That's — that's it. That's the whole of my life, laid out in a line, and I can see the end of it from here.\" He looked at her. \"And somebody's just come along and said, *fly one run, Corr. One. And none of that's true any more.* One run. And maybe I come back and maybe I don't, but either way, Lulu's free. Either way. Do you know what that's worth? You do. You know exactly what that's worth. You've got a chit on your console too.\"\n\nShe did know. That was the worst of it. She could feel it in her own chest like a hand: *cancelled in full.* Forty thousand six hundred and eighty marks, even after Lyle's six hundred. Struck off. Gone.\n\n\"I flew the inner markers with Lyle,\" she said. \"The harp man. In the Mercy. You know what it's like out there? The shear? I nearly lost her. I nearly went *in*. And that was the edge, Corr. That was two weeks ago. It's narrower now.\"\n\n\"Then I'll be careful.\"\n\n\"You'll be — \" She stopped. She found that she was crying, which she had not done in front of him in eleven years, and was furious about it. \"You'll be *careful*.\"\n\nHe came and put his arms round her, there on the dock, with the fitters looking and pretending not to, and she let him, with her face in his shoulder, which smelled of salt-eel and coolant and him.\n\n\"Look after Lulu,\" he said into her hair. \"If.\"\n\n\"Don't.\"\n\n\"If,\" he said. \"Just if.\"\n\nShe went to the Lectern that evening. She had never been up the spindle before; contract pilots did not go to the Needle-ward end. Nobody stopped her. She found the dome by following the sound — a thin high strained singing that got louder as she climbed — and found Ambrose Lyle alone at a console under the bruise of the mouth with his headphones round his neck and a column of figures on his screen.\n\nHe looked up and saw her and his face did something complicated.\n\n\"Miss Kesh.\"\n\n\"Teo.\"\n\n\"Teo.\" He stood. \"Is something wrong?\"\n\n\"Corrigan Dace has volunteered for the trial,\" she said. \"The Brannock. Second of April. He's my — he's a friend. I need to know. You're the one who'd know.\" She heard her voice and steadied it. \"How dangerous is it? Really?\"\n\nAmbrose looked at her for a long moment. He looked, she thought, like a man who had been asked a question he had been dreading, and had decided, somewhere in the dread, that he was going to answer it honestly.\n\n\"Very,\" he said. \"The waist on the second will be about thirty-five per cent of nominal, if the trend holds. No one has ever flown a throat that narrow. The shear at the waist will be — I don't know. Worse than anything you saw at the inner markers. Much worse.\" He paused. \"And the glass. When he releases it. Nobody knows what brine-glass does when you put it into the throat at the waist. Nobody's ever done it. It might do nothing. It might — \" He spread his hands. \"It's negative energy, Teo. Raw. In a place where everything is already bent. I don't know what it does.\"\n\n\"So he might die for nothing.\"\n\nAmbrose was quiet.\n\n\"Is there anything,\" she said, \"anything at all, that you know, that would stop it? That would make her call it off?\"\n\nSomething moved in his face. She saw it. She saw him almost say something, and stop, and look away from her at the screen with its column of figures, and back.\n\n\"I don't know yet,\" he said. \"I'm sorry. I don't know yet.\"","wordCount":1068,"createdAt":1793108784619,"updatedAt":1793108784619},{"id":"Sj7iF2uJpwtFvbZf8-Vsb","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"aXBT-PzJf6aKLcLyvEl3T","text":"The Assembly Hall in Tallow was the oldest room in the Reach: a cavern cut into the salt by the first Concession machines, its walls still scored with their long curved grooves, its ceiling so low at the back that tall men stooped. Nobody had built anything in it. Nobody had put up a gallery or a terrace or dressed the salt with stone. There were benches, and a platform at the front, and a single bank of floodlights that made everyone look ill, and that was all. The Concession held its notices here, and its inquiries, and its debt hearings, and on the fifteenth of March it held the Director's address, and the room was so full that people stood in the doorways and sat on the floor between the benches and climbed on each other's shoulders at the back.\n\nTeo stood against the wall halfway down, with Corrigan beside her and Nico on her other side, and watched Hesper Vane walk out onto the platform without any notes.\n\nShe did not hurry. She walked to the front of the platform and stood there with her hands folded and waited for the room to be quiet, and it took a long time, and she waited, until it was.\n\n\"You know there is a Narrowing,\" she said. \"I told you so on the second. I told you it would be deep. I'm here to tell you how deep.\"\n\nShe told them. She told them in numbers. She did it the way Teo imagined she did everything, precisely and in order, without softening anything: the waist at sixty-one per cent of nominal on the second, at fifty-two on the ninth, at forty-eight this morning. The rate of narrowing. The projections. She said that the Concession's throat-readers did not know whether the waist would stop narrowing before it reached zero. She said that if it reached zero the Needle would close, and that a closed Needle had never been observed, and that no one could say whether it would ever open again.\n\nThe room had been quiet. It became something else, a silence with a held breath in it.\n\n\"I am not here to frighten you,\" Hesper Vane said. \"I am here to tell you what we are going to do about it.\"\n\nShe told them that too.\n\nShe said that the throat of the Needle was held open by a ring of exotic matter at its waist — that this was known, that it had been known for fifty years. She said that brine-glass was the same kind of matter, in a cruder form. She said that the Concession's analysis indicated that the waist was narrowing because the ring was weakening: because it was, in effect, starving. And she said that if brine-glass were delivered to the waist during the Narrowing, released there at the narrowest point, it would brace the ring as a splint braces a bone, and the throat would hold.\n\n\"We will feed it,\" Hesper Vane said. \"That is the long and the short of it. We have the glass. We are sitting on the largest deposit of brine-glass in human space. We will take it out to the Needle in the Narrowing and we will feed it to the throat, and the throat will hold. I am calling it the Keeping.\" She let the word sit. \"It will require pilots. It will require pilots who are willing to take a small ship, loaded with glass, into the throat during the Narrowing, to the waist, and release their load there, and come back. I will not pretend to you that this is safe. It is not safe. It has never been done. It is the most dangerous flight anybody in the Reach has ever been asked to make.\"\n\nShe looked out over the room.\n\n\"So I will make this offer, and I will make it once. Any pilot who flies a Keeping run — any pilot who goes to the waist and releases their glass — will have their indenture cancelled. In full. Not reduced. Cancelled. And not only theirs. Their family's. Every debt held by the Concern against every member of their household, struck off the books on the day they fly.\" A pause. \"That is my offer. Thank you.\"\n\nThe noise came up out of the room like water out of a burst pipe.\n\nTeo did not hear most of it. She was looking at Hesper Vane, standing quite still on the platform with her hands folded, waiting for it to subside the way she had waited for the silence; and she was thinking of Ambrose Lyle's face in the mirror with the headphones on, two days ago, at the inner markers. *Like a drawstring. Very slowly. Very evenly.* He had not said anything about starving. He had not said anything about a ring weakening. He had said *I don't know why it's narrowing*, and he had been the man who would know.\n\n\"Feed it,\" said someone at the front, very loud. Mother Salome. She had stood up on her bench, tall and stooped, a head above everyone round her, and the floodlights made her face look like a carving. \"You want to feed it. Feed it what, Director? Our glass, you said. Our glass, that our children cut out of the salt and die of. Our pilots, that you'll send into the dark in little ships. You want us to feed it our children.\"\n\n\"I want you to keep it open,\" said Hesper Vane. \"So that your children have a door.\"\n\n\"A door for what? Your ships leave in six weeks. What's on the other side of that door for us, Director? The Board? Ardent? The people who hold our paper?\"\n\n\"Everything is on the other side of that door,\" Hesper Vane said evenly. \"Medicine. Machines. Seed stock. Every ship that will ever come to the Reach. Every ship that will ever leave it. If the Needle closes, Mother, there is no other side. There is the Reach, alone, forever. Ask yourself whether your children would thank you for that.\"\n\nSalome stood on her bench and said nothing. Teo had never seen her with nothing to say.\n\n\"It's a lie,\" said Nico.\n\nHe said it quite quietly, beside Teo, and then much louder, and then he was on the bench too, and the cutters round him were looking up at him with their faces lit by the floodlights. \"It's a lie. She doesn't know it's starving. Nobody knows. She's just — she's *saying* it. She needs the glass shipped and she needs us scared and she needs us to — \"\n\n\"Nico,\" Teo said. \"Get down.\"\n\n\"— to keep sending it after they've *gone*, that's what this is, it's a way of keeping us — \"\n\nMarshal Brandt's men came through the crowd from the doorway, four of them, big, unhurried, in the grey of Concern Security, and the crowd parted for them the way water parts for a hull. Nico saw them coming and kept talking. He was still talking when they reached him. Two of them took his arms and lifted him down off the bench as easily as lifting a child, and he kicked and shouted, and one of the cutters beside him swung a fist, and Brandt himself, who had come up behind his men, put out one large hand and caught the fist in mid-air and held it, without apparent effort, and looked at the cutter until he lowered his eyes.\n\n\"Out,\" said Brandt. \"All of you. Now. Quietly.\"\n\nThey took Nico out. Teo went after him. She shoved her way along the wall with Corrigan behind her, and caught them in the passage outside, where the Security men had put Nico against the salt and were going through his pockets. Brandt was watching. When he saw Teo he raised one finger, not to her, but to his men, and they stopped.\n\n\"Kesh,\" said Brandt. \"The pilot.\"\n\n\"He's my brother.\"\n\n\"I know who he is.\" Brandt's voice was mild. \"Take him home. He's not charged. The Director doesn't want anybody charged tonight. Take him home and tell him the Director doesn't want anybody charged tonight.\" He looked at Nico. \"Tonight.\"\n\nThey let him go. He came off the wall with blood on his lip and his eyes blazing, and Teo took him by the back of the neck the way their mother used to, and walked him away down the passage, and he let her.\n\nCorrigan walked with them in silence as far as the Lantern Row lift. Then, at the lift door, with Nico gone ahead into the car, he put his hand on Teo's arm.\n\n\"Teo.\"\n\n\"Don't.\"\n\n\"I haven't said anything.\"\n\n\"You're going to say *cancelled in full*. You're going to say *Lulu's too*.\"\n\nHe was quiet. His hand stayed on her arm. Under the lift's bad light his face looked older than it was, and she remembered all at once, for no reason, a night eleven years ago on the Brannock with the canopy full of stars and his laugh in the dark.\n\n\"Lulu's too,\" he said softly. \"Teo. She's nine. She'll be paying off Mira's medical till she's fifty. Mine. My father's. She'll never — \"\n\n\"It's never been done, Corr. You heard her. Nobody knows what's at the waist. Nobody's ever *been* to the waist in a Narrowing. I was at the inner markers two days ago in the Mercy and I nearly didn't come back, and that's the *edge*.\"\n\nHe looked at her strangely. \"You were at the inner markers?\"\n\n\"Charter.\"\n\n\"In a *tug*?\"\n\n\"Don't change the subject.\"\n\n\"I'm not.\" He let go of her arm. He smiled, a little, the old smile. \"I'm just thinking that if you can do it in a tug,\" he said, \"so can I.\"\n\nThe lift door opened. Nico was inside, holding the door, with blood on his lip. Teo got in. Corrigan did not.\n\n\"Corr,\" she said.\n\n\"I'll see you on the lanes,\" he said, and the door closed.","wordCount":1672,"createdAt":1793093335588,"updatedAt":1793093335588},{"id":"X4SquWmRjfvfaiSB8TRPe","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"hIQNqeXMQkvte9h5r5HPV","text":"She got back to the Pans after midnight and found the bone-pickers' dock full of black coats.\n\nThey had come at the shift-change again. They had come down on the dock with lamps and crowbars and gone through every skiff tied up there — the Coopers', the Mallon girls', old Teodric's, the Gristle's empty berth — and taken up the deck plates and opened the tanks and cut into the insulation, looking for glass. They had found some. Bone-pickers always kept some back. They had found enough to be angry about the rest, and they had dragged three people out onto the dock and beaten them in front of the others, slowly, under the lamps, so that everybody would remember.\n\nOne of the three had been Pike.\n\nHe had not even been on the dock. He had come down from the Gutter with his fever on him, the Mallon girls said, because someone had run up Rope Street shouting that the Lantern was on the boats, and he had thought of the Gristle; and he had walked out onto the dock in his shirt, coughing, to stand in front of her empty berth, as though there were something there to protect. And the boys with the lamps had asked him where the Gristle was and where her glass was, and he had told them he didn't know, and they had asked him again.\n\nIsra found him on Hanne's bed in the room at the end of Rope Street, with Hanne sitting beside him holding a wet rag to his face. His ribs were strapped with strips torn off one of Hanne's old shawls. One eye was shut. When he breathed it whistled, and when he coughed it was so bad that Hanne had to hold him up.\n\n\"Didn't tell them,\" he said, when he saw Isra. It came out in a wet whisper. \"Didn't know. You didn't tell me where you were going. Good girl.\"\n\nShe sat down on the floor by the bed with the data-stick in her fist and her other hand on his big broken hand, and for a long time she did not say anything at all.\n\nHanne watched her over the rag with her bird's eyes.\n\n\"Well?\" said the old woman at last, very quietly. \"Where *were* you going?\"\n\nIsra opened her fist and looked at the little stick lying in her palm.\n\n\"To see what's in the throat,\" she said. \"Gran. I saw it. It's not hungry.\" She looked up. \"It's full of glass. It's choking on it. And she's going to give it more.\"\n\nHanne did not say anything. She put the rag down on the edge of the bowl and reached across Pike and took her cittern from where it leaned against the wall, and set it on her knee, and plucked the low string, once, very softly, so as not to wake anybody in the tunnel.\n\nInside Isra's shirt, against her skin, the shard hummed back.\n","wordCount":495,"createdAt":1793109148843,"updatedAt":1793109148843},{"id":"XIfydHoQy7NIA__zfYSZ9","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"fX6guNlO_7rM3diVA0x-p","text":"The Speaker's rooms were on the Terrace level of Tallow Under, high enough to have a window onto one of the great light-wells, and when Juno was a child she had thought it was the finest view in the Reach: a hundred metres of shaft dropping away below, terraced and planted, lit by Caul's banded glow from above and by the thousand small lamps of the houses cut into its walls, like looking down into a well full of stars. She stood at it now with a glass in her hand that she had not drunk from and looked at nothing.\n\nThe Wardens had brought Pell home at nineteen hundred. They would come for her again in the morning to take her up to the Anchorhold, where the nine would live and train together until the Narrowing — fifty-eight days, now. She had been given the night with her family. It was customary.\n\nPell was in her room, packing. She had been packing for an hour. Juno could hear her through the wall, moving about, humming. Humming the Hunger Tone.\n\nTheir mother sat at the table with a slate in front of her that she was not reading.\n\n\"I'll put in for substitution,\" Juno said to the window.\n\n\"Juno.\"\n\n\"It's allowed. A volunteer of age can stand in for a drawn Keeper with the High Warden's leave. I'm thirty-one. I'm of age. It's in the Articles.\"\n\n\"It's in the Articles,\" her mother agreed. \"It has been granted four times in three hundred years.\"\n\n\"Then it'll be five.\"\n\n\"Juno.\" Efua Asante put the slate down. \"Sit down.\"\n\n\"I don't want to sit down.\"\n\n\"I know. Sit down anyway.\"\n\nJuno sat down. Her mother looked at her across the table, and for a moment the civic face slipped, and what was under it was so naked and so old that Juno had to look away.\n\n\"You think I haven't thought of it,\" her mother said quietly. \"You think I didn't think of it before he'd finished saying her name. I'm the Speaker. There is nothing in the Articles I haven't read. There is no petition, no appeal, no procedure, no favour I could call in, that I have not thought of in the last six hours.\" She spread her hands flat on the table. They were shaking slightly; Juno had never seen them shake. \"And she doesn't want any of them.\"\n\n\"She's nineteen.\"\n\n\"She's nineteen,\" her mother agreed. \"And she's my daughter, and she believes in it, and she wants to go. Have you talked to her?\"\n\nJuno had not. She had come home and gone to the window.\n\nShe went to Pell's room. The door was open. Pell was sitting on the floor among her canvases, with a duffel half-packed beside her, holding a painting on her knees and looking at it. The room smelled of oil and turpentine and the faint sweet resin of the varnish she used. Every wall was covered. Pell painted the Needle. She had painted nothing else since she was fourteen: the Needle from Hollin's surface, a smear of wrong stars over the salt pans; the Needle from the Anchorhold, huge and bruise-dark; the Needle as nobody had ever seen it, from inside, from the throat, in colours that did not exist — a long tunnel of folded light opening and opening into something that was not quite white. Juno had never known what to say about them. They frightened her a little.\n\n\"Hey,\" Pell said, without looking up.\n\n\"Hey.\"\n\n\"I can't take all of them. They said one bag.\" Pell turned the painting on her knees toward the light. It was one of the throat ones. \"I thought maybe this one. Do you think this one?\"\n\n\"Pell.\"\n\n\"I know.\" Pell put the painting down very carefully, face up, on the floor. \"I know what you're going to say. You're going to say you'll put in for substitution.\"\n\n\"Yes.\"\n\n\"Please don't.\"\n\n\"Pell —\"\n\n\"Please don't, Juno.\" Her sister looked up at her, finally, and her eyes were red and perfectly calm. \"I know you think it's — I know what you think. You've been out there for six years taking names off Shoals kids. You think it's a machine for killing people. I know.\" She took a breath. \"But it's not, to me. It's never been. Ever since I was little I've — you remember when we went up to the Anchorhold for your commissioning, and they let us into the Lectern, and I heard the harp? I was eight. I heard it and I thought, *that's it, that's the sound, that's what everything is.* And I've been painting it ever since and I can never get it right. I can never get the inside of it right.\" She gestured at the walls, at the tunnels of impossible light. \"And now I'm going to see it. Me. Out of everyone. The Wheel chose me.\" Her voice shook for the first time. \"Do you know what that's like? To be chosen? To have your name come out of the Wheel and know that it means something, that you mean something, that the whole Reach is going to stand in the Hall and sing for you? I'm not afraid, Juno. I keep waiting to be afraid and I'm not.\"\n\nJuno knelt down among the canvases, because her legs were not reliable, and put her arms round her sister, and Pell let her, and they stayed like that for a long time without speaking. Pell smelled of turpentine. Through the wall, from the window, came the far, faint sound of someone singing in the light-well below: the Hunger Tone, held and held, as it would be held in every house in Tallow Under tonight.\n\nWhen Juno came back out, her mother was standing at the window where Juno had stood.\n\n\"Well?\" said Efua.\n\n\"She wants to go.\"\n\n\"Yes.\"\n\n\"I'm putting in for substitution anyway.\"\n\n\"I know you are.\" Her mother did not turn round. In the glass Juno could see her reflection, faint, laid over the well of lights below; the civic face was back on, perfectly composed. \"Juno. When he read the name. Did you see his face?\"\n\nJuno was quiet for a moment.\n\n\"He looked at our terrace,\" she said. \"Before he read it.\"\n\n\"Yes,\" said her mother. \"He did.\"\n\nNeither of them said anything else. Below them, in the well, the singing went on, and on, and on.\n","wordCount":1072,"createdAt":1793092973448,"updatedAt":1793092973448},{"id":"XJwbEs-_-YLKEd6LzuYMg","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"l5bRaZgZBxOt2ptfbKZe3","text":"The harp was singing in a key Ambrose Lyle had never heard it use.\n\nHe had built the thing. Twenty-three years ago, a younger man with a younger man's back, he had strung its first course of resonator wires across a frame of fused silica in a workshop in Port Ardent and shipped it through the Needle in crates and assembled it here under the dome, and he had played it — that was the word everyone used, though it was a matter of listening and not of playing — every working day since. He knew its voice the way you knew the voice of someone you had been married to. It hummed. In its ordinary moods it hummed a soft, wide, many-stranded chord, the throat's noise turned into sound, and a reader sat at the console and listened and watched the traces and drew the throat's shape for the pilots who would fly it. It had sung louder before, and softer. It had never sung like this: thin, high, drawn tight, the whole chord pulled up into its upper strings and straining there like a held breath.\n\n\"Again,\" he said.\n\nBettany Shore, at the second console, ran the sweep again. She was twenty-two and had been his junior for eight months, and she had the kind of face that showed everything, and what it showed now was that she wanted very much to be told that this was normal.\n\n\"Waist reading's at sixty-one per cent of nominal,\" she said. \"It was seventy-four an hour ago. It was ninety-eight yesterday.\"\n\n\"And the rate?\"\n\n\"It's slowing. I think it's slowing.\" She looked at him. \"That's good, isn't it? If it's slowing?\"\n\nAmbrose did not answer. He took off his reading glasses, and polished them on his shirt, and put them back on, which was what he did instead of swearing. Then he reached into the pocket of his jacket and took out the fork.\n\nIt was brass, fifteen centimetres long, its two tines worn bright at the tips and dull at the root where his thumb went. On the stem, in a hand engraver's tidy capitals, it said A. L. — 440 — FOR CLARE. He had bought it in a music shop in Ardent the year his daughter was born, because she had been born in A, as he used to tell her — screaming on a concert pitch, the midwife said, you could have tuned an orchestra — and he had had it engraved for her as a joke, meaning to give it to her when she was old enough to think the joke was funny. She had been four when he took the Concern's posting. She was twenty-seven now. He had the fork still. Every instrument he had built since had been tuned to it, because there was a peculiar comfort in the thought that every measurement he made of the most extraordinary object in human space was referred, in the end, to a note his daughter had screamed in a delivery room. He had never told anyone that.\n\nHe struck the fork against the heel of his hand and touched its stem to the reference plate, and the harp's tuning monitor took the note and laid it across the traces like a ruler. He watched the strings settle against it. Drift was nothing. Drift was a hair. The instrument was true.\n\nSo the throat was doing this. Not the harp. The throat.\n\n\"It's a Narrowing,\" he said.\n\n\"There was a Narrowing in eighty,\" Bettany said. \"I read the logs. It closed for six hours. Nobody died.\"\n\n\"There was a Narrowing in eighty,\" Ambrose agreed. \"And sixty-nine, and fifty-eight, and forty-seven, every four thousand days, give or take, as long as there have been people here to watch. Six hours. Four hours. Nine. The waist went down to eighty per cent of nominal in eighty and everyone was very excited and wrote papers.\" He looked at the trace, the bright line crawling down the screen. \"We are at sixty-one, and sixty days out from where the cycle says the trough should be. It is not going to be six hours.\"\n\n\"How long?\"\n\n\"I don't know.\"\n\n\"Could it —\" She stopped.\n\n\"Close?\" He made himself say it, because someone was going to. \"I don't know that either. Nobody knows. Nobody has ever seen one go this deep. We don't have a model for this. We have four data points and a lot of hope.\" He heard his voice and disliked it. \"Bettany. Log the sweep. Log everything. Don't round anything.\"\n\nThe door at the back of the dome slid open, and the Director came in.\n\nHesper Vane did not hurry. Ambrose had known her for eleven years and had never seen her hurry; he had sometimes wondered whether she was physically capable of it, whether some childhood injury had removed the faculty. She was a slight, straight woman of forty-seven with grey cropped hair and the Concern's sunburst at her collar, and she came across the dome to his console at the pace of someone crossing a room to look at a painting, and stood at his shoulder, and looked at the trace.\n\n\"Mr Lyle,\" she said.\n\n\"Director.\"\n\n\"Tell me.\"\n\nHe told her. He told her the way he would have told a student, carefully and in order, because he had found that this was the only way to talk to Hesper Vane: she would follow you anywhere you could actually go and nowhere you could not. The waist. The rate. The four previous Narrowings and their depths. The fifty-nine days. She listened without interrupting. When he had finished she was quiet for a while, looking at the line.\n\n\"Can it close?\" she said. \"Permanently.\"\n\n\"I don't know.\"\n\n\"That isn't an answer.\"\n\n\"It's the only honest one I have. Nobody has a theory of the Needle, Director. We have observations. The observations say it has always opened again. The observations are fifty years long. The Needle is\" — he lifted a hand toward the dome, where the bruise of the mouth hung huge and silent beyond the glass — \"considerably older than fifty years.\"\n\n\"So it can.\"\n\n\"It might. It might not. If you want a number I will invent one for you, but I would be inventing it.\"\n\nShe nodded slowly, as if he had confirmed something. \"Then nobody else knows either,\" she said. \"Until I say.\"\n\nAmbrose looked at her.\n\n\"I want this kept in this room,\" Hesper Vane said. \"The readings, the projections, all of it. Miss Shore.\" Bettany jumped. \"You will log everything Mr Lyle asks you to log, and you will log it to the Director's channel and to nowhere else, and you will speak to no one about it, including your mother, your friends, and the very attractive young man in Approach Control you spend your breaks with. Do you understand?\"\n\nBettany went red to the ears and said that she did.\n\n\"There is going to be an announcement this evening,\" Hesper Vane said to Ambrose, more quietly. \"About other matters. It would be unhelpful if this were the subject of conversation in every bar on Lantern Row before I had made it.\"\n\n\"Other matters,\" he said.\n\nShe looked at him for a moment, and something in her face that was not quite kindness decided to tell him. \"The Board isn't renewing the Charter,\" she said. \"We are withdrawing. All salaried staff, all equipment that pays for its passage. The *Providence* sails on the twenty-eighth of April and she will be the last Ostrander ship through the Needle. The Concession continues. The debts continue. But the Concern will manage it from Ardent, at a distance, through local administration.\" A small, dry pause. \"Through me, in point of fact. I'm staying.\"\n\nHe had heard rumours. Everyone had heard rumours. He found that hearing it said made a hollow place open in his chest, very quickly, the way the floor of a lift drops.\n\n\"Your berth on the *Providence* is confirmed, of course,\" she said. \"Senior grade. I put it through myself this morning.\" She glanced at the trace. \"Assuming there's a Needle for her to sail through on the twenty-eighth. Which, if I understand you, is in fact a question.\"\n\n\"The trough is around the first of May,\" he said. \"If the cycle holds. She'd sail three days before.\"\n\n\"Then let's hope it holds.\" Hesper Vane straightened. \"Go home, Ambrose. You've earned it. Your daughter will be glad. Keep this room quiet until then, and give me the numbers every six hours, and go home.\"\n\nShe went out, at the same unhurried pace. The door slid shut behind her.\n\nBettany let out a breath that she seemed to have been holding since the Director came in. \"Is that true? We're leaving? The whole Concern?\"\n\n\"So it seems.\"\n\n\"But what happens to — everyone? Here?\"\n\nAmbrose turned the fork over in his fingers. Through the dome the Needle hung, vast and patient, its rim of bent stars drawn in just perceptibly tighter than it had been that morning. He thought of forty thousand people on Hollin, dug down into the salt in their towns, cutting glass to pay off debts that the Concern would go on owning from the far side of a door that might be closing. He thought of Clare, whose face he could not quite remember, whom he would see in fifty-seven days.\n\n\"Log the sweep,\" he said. \"Don't round anything.\"","wordCount":1579,"createdAt":1793092538534,"updatedAt":1793092538534},{"id":"XMYc1kYl-2mBg03oj-fRM","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"aBdlcGQrMOBsNYer8rVoH","text":"The runner was a fast little packet out of Corrie Rock, and it tried to outrun the *Vigil* across the Shoals approaches, and it very nearly did.\n\n\"She's good,\" said Marsh at tactical, with reluctant admiration, as the packet jinked behind a tumbling ice-rock and came out the other side on a vector nobody had predicted. \"She's really good, Captain. That's a Navy pilot. That's somebody we trained.\"\n\n\"Then she knows what happens next,\" said Juno. \"Forward battery. Across her bow. Close.\"\n\nThe battery fired. The packet's pilot knew what happened next. She killed her drive and put her hands up, as far as a ship can, and the *Vigil* came alongside.\n\nThere were three aboard. Two were Shoals smugglers, sullen and scared, who sat where they were told. The third was a woman of fifty in a grey cardigan, who came out of the packet's tiny hold with her hands raised and a data slate held up in one of them, high, so that the boarding party could see it, the way you would hold up a white flag.\n\n\"Commander Asante,\" she said, as soon as Juno came through the lock. \"I asked them to find me your ship. I've been trying to reach you for nine days. My name is Mara Teague. I was a lay clerk in the Draw office at the Compact Hall for nineteen years. I need to show you something.\"\n\nThey put her in Juno's day cabin, because it was the only room on the *Vigil* with a door that locked from the outside. Juno sat across the little table from her with Marsh standing at the door. Teague put the slate on the table between them and pushed it across with one finger.\n\n\"That's every name drawn in the last four Draws,\" she said. \"The Twenty-Sixth to the Twenty-Ninth. And beside each one, how it was drawn.\"\n\n\"Drawn from the Wheel,\" Juno said. \"That's how they're drawn.\"\n\n\"Some of them.\" Teague's voice was steady, low, a clerk's voice, precise. She had the hands of someone who had spent her life with paper. \"Commander, I prepared the foils for the Wheel. That was my job. Every name in the Reach between eighteen and forty, on a strip of steel foil, cut and stamped and counted and fed into the drum. Every name the same weight, every foil the same size, so that the Wheel is fair. That's what the Articles say.\" She leaned forward. \"The Shoals foils were cut at half-thickness. For the last four Draws. On written instruction from the High Warden's office. Thinner foil rides higher in the drum when it turns. Every clerk in the office knew. We were told it was a matter of security — the Shoals had to be seen to bear their share. Look at the numbers. The Shoals are a sixth of the Reach. Of the last thirty-six Keepers, nineteen were Shoals names.\"\n\nJuno looked at the slate. Nineteen of thirty-six names had a small mark beside them.\n\n\"That's the first thing,\" said Teague. \"The second thing is worse.\"\n\n\"Go on.\"\n\n\"At every Draw,\" said Mara Teague, \"there is one foil that is not fed into the Wheel by the clerks. It is given to the High Warden in an envelope, by his secretary, on the morning of the Draw. He carries it in his sleeve. And when the Wheel stops and he reaches in, one of the times he reaches in, he does not take a foil from the drum.\" She was watching Juno's face. \"We called it the sleeve name. Every clerk knew that too. Nobody spoke of it. It was — it was the price of the Draw, we told each other. The Wheel was fair, nearly. The High Warden just needed to be sure of one name. For the good of the Reach.\" She put one fingertip on the slate. \"Those are the sleeve names. One a Draw. I copied them from the secretary's file before I ran, two years ago. Look at who they are.\"\n\nJuno looked.\n\n*Twenty-Sixth: Orla Venning, daughter of Assembly Member Tomas Venning (Treasury Committee; voted against the Wardens' appropriation, 2573).*\n\n*Twenty-Seventh: Hal Brisk, son of the Shoals delegate Ana Brisk (moved the motion for Shoals quota relief, 2584).*\n\n*Twenty-Eighth: Imre Saltash, brother of Commodore Lise Saltash (refused escort duty for the Twenty-Seventh Keeping on grounds of conscience).*\n\n*Twenty-Ninth: Callum Calder, brother of Lieutenant Rhee Calder (Academy record: formal complaint to the Wardens' liaison regarding the treatment of Shoals cadets, 2596).*\n\nShe read the last line three times. Her mouth had gone dry.\n\n\"Rhee filed a complaint,\" she said. \"In our third year. About the Shoals cadets. They were being given the worst postings. I — I signed it. Half our year signed it.\" She looked up. \"Rhee's was the name on top.\"\n\n\"Yes,\" said Teague quietly. \"That's how it works. It's never you. It's always the one you love.\"\n\nThe cabin was very quiet. Marsh, at the door, had gone pale.\n\n\"Why are you showing me this?\" Juno said.\n\n\"Because I heard who was drawn seventh at the Thirtieth.\" Teague held her gaze. \"I wasn't there. I don't have this year's file. I can't prove it. But I know how the Wheel works, Commander, and I know who your mother is, and I know what vote is before the Assembly this week. And I thought — \" For the first time her voice wavered. \"I thought, if I could get it to one person who could do something. Just one. Not the League. Not the papers. Somebody inside. Somebody who'd have a reason.\"\n\nThe comm on Juno's desk chimed. Squadron. Admiral Greaves.\n\nShe took it with the slate face-down under her hand. Greaves had been told about the runner. He had been told who was on it — the clerk's name was on a Navy watch-list as a League courier — and he was very clear. Mara Teague was a defector to the enemy in time of war and a carrier of enemy materials. She was to be transferred, with all materials, to the Wardens' guard at the Anchorhold, who had jurisdiction over offences against the Draw. The *Vigil* would make the transfer on her way in to her station. He was very clear about the materials.\n\n\"Understood, sir,\" said Juno.\n\nWhen the screen went dark she sat for a moment with her hand flat on the slate. Then she said, without looking round, \"Danny. Go and get me a clean slate from stores. A blank one. Take your time.\"\n\nMarsh looked at her. Then he went, and took his time.\n\nShe copied it. All of it. It took four minutes. When Marsh came back with the blank slate she gave him the copy and said, \"Put that somewhere it won't be logged. Not your quarters. Somewhere stupid,\" and he went white and nodded and put it inside his jacket, and she gave the original back to Teague.\n\n\"They're going to take this from you,\" she said. \"At the Anchorhold. I can't stop that.\"\n\n\"I know,\" said Teague. She looked at the slate in her hands. \"I always knew. Thank you for reading it.\"\n\nThe *Vigil* docked at the Anchorhold the next morning. Juno walked Mara Teague down the gangway herself, and handed her and her slate to a Warden guard-captain with a polite, bored face, and signed the transfer, and watched them walk her away across the hangar between two guards, small in her grey cardigan, not looking back.\n\nTwo days later, on the evening watch, a routine notice came through the Navy channel from the Wardens' office: *Mara Teague, held for offences against the Draw, died in custody of a heart condition on 31 October. Next of kin notified.*\n\nJuno read it and logged it and went to her cabin and was sick in the little steel basin, quietly, so that no one would hear.","wordCount":1320,"createdAt":1793108946973,"updatedAt":1793108946973},{"id":"YGpxqHi8Bsj-XP1xSfpWC","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"AlydCLrHe8VMnTMbTTTgJ","text":"The waist came up two points at a quarter past two.\n\nAmbrose watched it happen. He had been watching the trace since the Brannock's signal died, sitting at his console with his headphones on and the harp's scream still in his ears like tinnitus, and at a quarter past two the line that had been creeping down all morning — thirty-four, thirty-three and a half, thirty-three — stopped, and hesitated, and came back up. Thirty-four. Thirty-five. Thirty-five and a half. And held.\n\nOn the other console Bettany made a small sound.\n\n\"It's holding,\" she said. \"Ambrose. It's holding. It's *up*.\"\n\nHe did not answer. He was looking at the clock.\n\nA quarter past two. He had not given Hesper Vane the date of the next pause; he had walked out of her office and down the spindle and sat in the Lectern for six days refusing to think about it. But it was not hard to find. Anyone who could read a trace could find it, from his own short-period figures, which were on the Lectern's own system, in its own logs, in the files he had not thought to lock because they were only the ordinary daily numbers. Anyone he had trained. He looked at Bettany. She was staring at the trace with her face lit up, and she had not yet understood what he was looking at her for, and then she did, and the light went out of her face very slowly, and she looked down at her console.\n\n\"She asked me for the short-term projections,\" Bettany said, very low. \"On the twenty-seventh. After you'd been up there. She said you'd said I could do them. She said you were tired.\"\n\n\"Yes,\" said Ambrose.\n\n\"I didn't — she just asked when the next pause was. That's all. I didn't know what it was for. I thought it was for the — for safety. So he'd go in when it was easiest.\" Her voice cracked. \"Was it? Ambrose? Was it for that?\"\n\nHe could not answer her.\n\nThe screens over the consoles flicked to the sunburst. It was not twenty hundred, and it was not the evening broadcast; it was an interruption, all channels, all screens on Anchorage and Hollin, and then Hesper Vane was there, in the Gallery, with the mouth in the window behind her, its bruised centre dark again, and its rim of fire very slightly — you could see it if you knew how to look — less tight than it had been that morning.\n\nShe told them the trial had succeeded.\n\nShe told them in numbers, as she told them everything. The waist at thirty-three at the moment of release. Thirty-five and a half now. Holding. She said that the Concession's readers had observed, following the release of brine-glass at the waist, a measurable recovery of the throat. She said that this confirmed the Concession's analysis, and that the Keeping would therefore proceed as planned at the deepest point of the Narrowing, on or about the first of May, with as many vessels as could be fitted and crewed. She said that the cost of the trial had been one vessel and one pilot. She said his name.\n\n\"Corrigan Dace,\" said Hesper Vane, \"of the Brannock, gave his life this morning so that the door would stay open. His debts, and his daughter's, and his father's, have been struck from the books of the Concern. I have done it myself. I will see his name honoured in the Reach for as long as there is a Reach.\" She paused. \"He is the first Keeper. He will not be the last. But he went first, alone, into the dark, not knowing whether it would answer. It answered. Remember him.\"\n\nThe screens went back to the sunburst.\n\nAmbrose took his headphones off and put them down on the console very carefully, as if they might break.\n\n\"Ambrose,\" said Bettany.\n\n\"Go home, Bettany.\"\n\n\"I didn't know. I swear I didn't — \"\n\n\"I know you didn't. Go home.\" He did not look at her. \"Please.\"\n\nShe went. He heard her crying in the passage outside, and then the lift, and then nothing but the harp. It had stopped screaming. It was singing again, the thin high strained chord of the Narrowing, a hair less strained than that morning, as the waist held at its pause, exactly as the short-period figures had said it would — exactly as it would have held if the Brannock had never left the dock.\n\nHe put the headphones back on, and listened to the buoy.\n\nHe had been listening to it all morning, under the harp: the buoy at the inner markers, two million kilometres closer, hearing what the harp smoothed away. And when the glass went in, the buoy had heard something the harp had not. He played it back now. The release — the flare, the shockwave, a great white roar in the headphones. And then, after the roar, when the throat's chord came back: a new note in it. Very small. Very high. Hard and bright and steady, like a pin struck against a glass and left ringing. It had not been there before the release. It was there still, six hours later, in the live feed from the buoy, not fading. A small hard ringing at the waist, where nothing had rung before.\n\n*Something stayed,* he thought. *She put glass into it, and something stayed.*\n\nHe did not know what it meant. He wrote it down. Then he took a clean sheet of paper from his drawer and wrote at the top of it, carefully, in his small neat hand, *Brannock, at the waist, 2.4.91, last transmission*, and under it, from memory, every word of what Corrigan Dace had said in the throat. *It's all folded light. Like the inside of a shell. It's drawing in. Like an iris. Like an eye shutting. And there's a light in the middle of it. In the middle where it shuts. A light. I've got no name for it.* He read it over. Then he folded it and put it between the pages of the logbook he kept in his drawer, the private one, so that somebody would have it, so that it would be written down somewhere that it had been a man who said it, and not a Keeper.","wordCount":1061,"createdAt":1793109316299,"updatedAt":1793109316299},{"id":"YXdSEYzrL61jBCEzLcFQ3","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"b3Wc8OM2EVjz0QZXPuc4_","text":"At two in the morning, station time, Ambrose sent Bettany to bed and sat on alone at the harp.\n\nThe dome was dark except for the consoles. Beyond the glass the Needle's mouth filled half the sky, and in the dark it was easier to see the ring of light the pilots called the Eye, faint and grey and very slightly irregular, like a coin worn by thumbs. He had read somewhere, long ago, that the brain is built to see faces in things. He had never seen a face in the Needle. He had sometimes thought he saw attention.\n\nHe put on the old headphones, the ones with the cracked band, and listened.\n\nThe harp was quieter now. The waist had held at sixty for four hours. The high strained chord had relaxed a little, back down toward something like its old self, and under it — he had to close his eyes for this — under it there was the deep wide hum of the throat, the sound he had spent twenty-three years learning. He let it fill his head. He had told Hesper Vane the truth: nobody had a theory of the Needle. But he had sometimes thought, in the middle of the night, with the headphones on, that he was closer to one than anybody, and that it was not a theory he could write down. It was the sound. It was knowing the sound.\n\nAnd there was something in it tonight that he did not know.\n\nIt was very faint. It was so far down that at first he thought it was the station: a pump somewhere, a ventilation fan, the long slow flex of the wheels. It was lower than the lowest course of the harp, below hearing really, a thing he felt in the bones of his face more than heard — a slow swell, rising and falling over a period of minutes, like a sea under a ship. It was not in the traces. He checked. The traces showed nothing but the waist and its strain. It was only in the sound, in the long wide chord, a kind of tide.\n\nHe sat with it for half an hour.\n\nThen he took the fork out of his pocket and struck it against his hand and held it to the reference plate, and listened to the note lie down across the chord like a ruler, true; and the swell was still there underneath, rising and falling, rising and falling, patient as breathing.\n\nDrift, he told himself. An artefact of the strain. A beat between strings pulled out of their ordinary tension. He wrote a note in the log — *low-frequency swell, period approx. 4 min, source unknown, probably instrumental* — and looked at the word *probably* for a long time, and did not cross it out.\n\nFifty-seven days. He put the fork back in his pocket and kept his hand on it, and sat in the dark with the Needle and listened to it breathe.\n","wordCount":502,"createdAt":1793092538252,"updatedAt":1793092538252},{"id":"_ASJi9r7gyeAKC8r9MyCV","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"l5EdzGomnoXnybSEiNrWy","text":"The Shoals came for the glass at four in the morning, Anchorhold time, out of the shadow of the mouth itself, which nobody had thought possible.\n\n\"Contacts,\" said Marsh, and then, in a different voice, \"Contacts, Captain, *contacts* — eleven, twelve, fourteen, bearing zero-zero-zero, they're coming out of the *shear*, how are they flying in the shear — \"\n\nJuno was on the bridge in her shirt, with her boots unlaced. She did not remember getting there. On the main display the mouth filled the forward quarter, and against its grey-gold rim fourteen small dark shapes were sliding out of the fire, one after another, in a long loose line, riding the shear-waves down toward the Anchorhold the way surfers ride a swell.\n\n\"They've got readers,\" said Juno. \"They've got a reader aboard calling the waves. Somebody's taught them.\" She heard her own voice, flat and calm, the command voice, and was grateful for it. \"Battle stations. Wake up the forward battery. Hollis, I want everything. Signal the Anchorhold: enemy strike inbound from the mouth, fourteen vessels, they're going for the stores. Signal Squadron. Where's the *Constant*?\"\n\n\"Refitting at Tallow, Captain. It's us and the *Ardour* and the station guns.\"\n\n\"Then it's us and the *Ardour* and the station guns.\"\n\nThe *Vigil* had been on station at the Anchorhold for a week. Squadron had brought her forward from the twentieth after the Shoals hit the glass convoys off Dorcas twice in a fortnight; Juno had not complained. She had spent the week walking the Anchorhold's empty passages at night, and sitting in the harp hall, once, at the back, watching her sister sit in front of the harp with her eyes closed, and leaving before Pell saw her. The glass for the Thirtieth Keeping — eighteen tonnes of it, the best that Hollin had cut in a decade — was stowed in the holds of the Anchorhold's dead wheel, the one that had not turned since the Concession, behind armoured doors. That was what the Shoals had come for. Everybody knew that was what they had come for. You could not fly a Keeping without glass.\n\nThe fourteen came on. They were cutters, mostly, Shoals-built, fast and lightly armed — and two heavier ships behind them, frigates, old Compact hulls with new paint.\n\n\"The big one,\" said Marsh. \"Captain. Look at her flag.\"\n\nJuno looked. On the display the lead frigate's identification beacon had lit, which no Shoals ship ever did in action; and the name on it was *CALLUM*.\n\n\"Open channel from the *Callum*, Captain. All frequencies.\"\n\n\"Put it on.\"\n\n\"*Anchorhold, this is Rhee Calder of the Free League.*\" His voice. Older, rougher, but his. \"*We are here for the glass. We are not here for you. We are not here for the Keepers. Get your people out of the dead wheel and off the second wheel. Get the Keepers out. You have six minutes. After that we fire on the stores.*\" A pause. \"*Juno, if you're out there — I'm sorry. Get your sister off the second wheel.*\"\n\nThe channel closed.\n\nThe *Ardour*'s captain was on the command link before Juno could speak, a fat, frightened, decent man called Pryce whom she had known for years. \"Asante. Asante, did you — \"\n\n\"I heard.\"\n\n\"The Keepers' dormitory's on the second wheel. Asante, if they fire on the dead wheel the second's right beside it — \"\n\n\"I know where it is.\" She was looking at the display. Fourteen ships. Six minutes. \"The station guns will engage the cutters. You take the second frigate. The *Callum* is mine.\" She switched channels. \"Anchorhold, *Vigil*. Evacuate the second wheel. Evacuate the archive section and the Keepers. Get them into the spindle. Do it now.\"\n\nThe Anchorhold's answer came back a long ten seconds later, in the voice of a Warden guard-captain who sounded as though he had been woken by it. \"*Vigil, the High Warden orders that the Keepers remain at their stations. The Keepers are under the protection of the order. The Shoals will not fire on — *\"\n\n\"The Shoals have just told you they're going to fire on the dead wheel,\" Juno said. \"The dead wheel is two hundred metres from your Keepers. Get them out.\"\n\n\"*The High Warden's orders, Commander — *\"\n\nShe cut him off. \"Helm. Take us in. Between the *Callum* and the dead wheel.\"\n\n\"Captain?\"\n\n\"You heard me, Linnet. Put us in the way.\"\n\nThey went in. The *Vigil* came round the Anchorhold's spindle on full burn and put herself across the *Callum*'s approach, between the frigate and the dead wheel, close enough to see the new paint on the frigate's flank and the scorched place on her bow where some Compact gunner had once nearly done for her. The forward battery fired. The *Callum* fired back. The *Vigil* shook like a struck bell, and somewhere aft something tore, and the bridge lights went red, and Hollis in engineering began to swear in a long steady monotone that was, Juno knew from six years of it, the sound of the Chief having fun.\n\nIt went on for nine minutes. Afterward, nobody on the bridge could agree about the order things happened in.\n\nThe cutters went for the dead wheel. The station guns got four of them. The *Ardour* took the second frigate in the engines and it went spinning off into the shear and broke up there, silently, in long bright pieces. The *Vigil* and the *Callum* traded fire at a range where you could not miss, and the *Vigil* lost her number two battery and a third of her starboard plating and seven crew, and the *Callum* lost her forward guns. And at the fifth or sixth minute — before the six were up, before anyone had been evacuated from anywhere — two of the Shoals cutters came round the dead wheel's far side, where nobody was watching, and fired everything they had at the armoured doors of the glass stores.\n\nThe doors held. The wheel did not.\n\nThe shots went high, into the wheel's spokes, into the old Concession structure that had not turned in three hundred years; and the spokes, which were very old, let go. The dead wheel tore free of the spindle on one side and swung — slowly, horribly, like a door on a broken hinge — and hit the second wheel.\n\nJuno saw it on the display. She saw the second wheel's rim crumple where the dead wheel struck it. She saw the second wheel's windows go dark in a long running ripple, section by section. She saw, from one of the dark sections, a sudden white plume of air and debris and small tumbling shapes venting into the grey-gold light of the mouth.\n\nThe Keepers' dormitory was on the second wheel.\n\n\"Danny,\" she said. \"You have the ship.\"\n\n\"Captain — \"\n\n\"You have the ship. Pull back. Cover the station. Let the *Callum* go if she runs. Hollis, I need a damage-control party at the forward lock in two minutes, suited, with cutting gear. Get me as close to the spindle as you can and let me off.\"\n\n\"Juno,\" said Marsh, very quietly, not using her rank, for the first time in two years. \"Juno, the *Callum*'s still — \"\n\n\"*Callum*'s breaking off,\" said the helm. \"Captain, she's breaking off. They're all breaking off. They're running for the mouth.\"\n\nOn the display the Shoals ships were turning away, all of them at once, the surviving cutters falling in behind the crippled *Callum* in a long loose line, back toward the shear and the fire at the rim of the mouth, the way they had come. Nobody pursued them. Nobody had anything left to pursue them with.\n\nThe channel from the *Callum* opened once more, on all frequencies, for a few seconds.\n\n\"*That wasn't* — \" Rhee's voice, raw. \"*That wasn't us. That wasn't the plan. The wheel — Juno, I didn't — *\"\n\nIt closed.","wordCount":1329,"createdAt":1793109507481,"updatedAt":1793109507481},{"id":"aM0xxIwD7omU97KzSzfkO","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"txcIkW7ctOiz0OWK3N5id","text":"The raider came out of the shadow of a rock called Dorcas Four, which was exactly where Juno Asante had said it would, and for one clean second she let herself enjoy being right.\n\n\"Contact,\" said Marsh at tactical. \"Bearing two-one-one, low, one ship. Small. She's running cold, Captain, I've only got her on optics — there. There. She's going for the third sled.\"\n\n\"I see her.\" On the main display the convoy strung away ahead of the *Vigil* in a long careful line: four ore-tugs and their tow-sleds of Shoals glass, bound in for Hollin and the Keeping stores, with the *Vigil* riding behind them like a dog behind sheep. The raider was a fleck of shadow crossing the face of the rock. \"Helm, come to two-one-one, all ahead full. Weapons, wake up the forward battery. Hollis, I want everything you've got in the next ninety seconds and I don't care what it costs the bearings.\"\n\n\"It'll cost the bearings,\" said Chief Hollis from engineering, sounding pleased about it, and the corvette leapt.\n\nThe *Vigil* was nine years old and had been at war for six of them. She had been built as a fast picket, long and narrow and lightly armoured, with a forward battery that could ruin a freighter's day and not much else, and she had been patched and re-patched through the whole of the Severance until there was more repair in her than original hull. Juno had commanded her for two years. She loved her the way you love a dog that has bitten you more than once in your own defence.\n\nThe raider saw them coming. It broke off from the third sled — too late; it had already put a grapple on the tow-frame and was trying to cut the sled loose and run with it — and for a moment the two ships hung there on the display, the little raider tethered to forty tonnes of glass it could not let go of and could not drag, the *Vigil* coming down on it like a thrown knife.\n\n\"Hail her,\" Juno said. \"Open channel. Tell her to cut the grapple and stand down and nobody gets hurt.\"\n\nMarsh hailed. The raider did not answer. It fired its thrusters again, hard, and the sled lurched on its frame.\n\n\"She's trying to snap the tow,\" Marsh said. \"If she snaps it the sled goes tumbling and takes out the fourth tug behind it.\"\n\n\"Forward battery,\" Juno said. \"Target her engines. Not the hull. Engines only.\"\n\n\"Captain —\"\n\n\"Engines, Danny.\"\n\nThe battery fired. On the display the raider's stern bloomed white and then dark, and the little ship slewed round on its own grapple line and hung there, spinning slowly, venting something that glittered. The sled steadied. The convoy came on.\n\n\"Good shooting,\" Juno said, and meant it, and let her breath out.\n\nThey took the raider under tow themselves, because there was nobody else to do it, and Juno went across with the boarding party in a suit that smelled of the last person who had worn it. The raider was a Shoals-built cutter, home-made from three other ships, with a hand-lettered name on the airlock that read *NO MORE*. Inside it was very cold, because the engine hit had taken out the heat. Inside it there were six people.\n\nThe oldest was perhaps twenty. The youngest — Juno looked at her for a long time — the youngest could not have been more than fifteen, a thin girl with a shaved head and a Shoals clan tattoo along her jaw, holding a pry-bar as though she meant to use it on a corvette's boarding party. Behind her the others had their hands up. One of them was crying with the steady, exhausted crying of someone who has been crying for a while.\n\n\"Put it down,\" Juno said, through her helmet speaker.\n\n\"You put yours down,\" said the girl.\n\n\"I'm not holding anything.\"\n\n\"You're holding a warship,\" the girl said, and her voice cracked across the middle of the word, and she put the pry-bar down.\n\nThey were Draw-dodgers. Juno had known before she came across. The Shoals sent a quota of names into the Wheel at every Draw, one for every three hundred souls, and this time the Shoals' Free League had refused to send any at all — that refusal was the whole of the war — and the Compact had sent the Navy into the Shoals to take the names by registry instead. Six years. Six years of boarding habitats and copying registries and escorting Draw officers with their slates, and boys and girls like these slipping out on stolen ships to wherever the registries could not find them, and raiding glass convoys on the way because a sled of glass would buy you a new name in any of a dozen rocks that did not ask questions. Juno had boarded fifty ships like the *No More*. She had not got used to it. She had got used to not getting used to it.\n\n\"We need medical across,\" she said to Marsh on the private channel. \"The heat's gone. They'll be hypothermic in an hour.\"\n\n\"Aye, Captain. And — Captain. Signal from Squadron. Admiral Greaves.\"\n\nShe went back across with the medics and took it in her day cabin with her suit still half on. Tobiah Greaves's face on the screen was square and grey and tired, the face of a man who had been winning a war for six years and had begun to suspect he was not going to finish it.\n\n\"Good work on the convoy,\" he said. \"The Shoals cutter. You took her intact?\"\n\n\"Engines only, sir. Six aboard. Draw age, or near it. One's a child.\"\n\n\"Registered?\"\n\n\"I don't know yet, sir.\"\n\n\"They'll be registered somewhere. Hand them over to the Wardens' officer at Hollin, they'll know what to do.\" Greaves looked at something off his screen. \"Asante, there's another matter. You're relieved for seventy-two hours as of arrival. Marsh can take her round to the yards. You're to attend the Draw in person.\"\n\n\"Sir, I —\"\n\n\"Your mother's orders, not mine,\" Greaves said. \"Or the Speaker's office, which I'm told is not the same thing. The Speaker would like her family seen at the Hall. It's the Thirtieth, Asante. It's a deep one. People need to see the Speaker's family standing up with everybody else.\" He paused. \"Your sister's of age this time, isn't she?\"\n\n\"Nineteen, sir.\"\n\n\"Well,\" said Greaves, and seemed to look for something to say, and not to find it. \"Well. One in four thousand. She'll be fine. Go home, Commander. Stand where people can see you.\"\n\nThe screen went dark. Juno sat in her half-suit in the cold cabin and listened to the medics moving through the passage outside with the girl from the *No More*, who was swearing at them in a Shoals dialect, steadily and inventively, as if that was the only warm thing she had left.","wordCount":1166,"createdAt":1793092973909,"updatedAt":1793092973909},{"id":"aTlxXVSbvhkGbv41jzQfT","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"THBsTqir_QIx3ULEcfdlD","text":"The new wire would not lie down.\n\nLucan had strung four courses of it now, the whole of the girl's spool, and every morning he tuned them to the Hunger Tone the way he had been taught, standing with his eyes shut and the note in his throat, turning the pegs a hair at a time until the wire stopped fighting and lay down inside the sound. And every evening, when he came back to the hall, the new courses had risen up again. Not drifted. That was what he kept coming back to, lying awake in his cell. Old wire drifted: it went slack, it went flat, it crept, and you heard it creep. This was not that. The new wire stayed exactly as tight as he had left it. It was the *note* that would not hold. As if the wire knew some other note, and kept leaning toward it, the way a compass needle leans north however you turn the box.\n\nAnd the girl's glass had hummed at an old woman's cittern, and lain dead in his palm at the harp.\n\nHe thought about that for ten nights. On the eleventh, a little after two in the morning, he got up and put on his robe and went down through the dark spindle to the harp hall, and stood for a long time in front of the reliquary grille, looking at the Fork.\n\nIt lay on its grey cushion in the lamplight the way it had lain all his life: fifteen centimetres of brass, worn bright at the tips. *The First Warden's Fork.* He had been taught that it was the holiest thing in the Reach. He had been taught that it was struck once at every Keeping and never otherwise touched except by the Prior's own hand, to be cleaned. He had been taught, by the Prior, at seventeen, kneeling on this floor, that the Hunger Tone was the note the First Warden had heard in the Needle, and that the Fork was the instrument with which the First Warden had heard it.\n\nHe had never once been taught that they were the same note. He had assumed it. Everybody had.\n\nThe grille was locked. It had been locked for as long as he had been at the Anchor, and the Prior had the key on a chain round his neck. But the Anchor had been built for six thousand people and was lived in by twelve, and Lucan had spent twelve years repairing it with whatever came to hand, and he knew that the grille's hinge-pins on the left side had rusted half through in the damp of the hall and could be lifted out with a pair of pliers and a prayer. He had brought the pliers. He said the prayer anyway.\n\nThe Fork was heavier than he had expected. Cold. He held it in his palm in the lamplight and his hand was shaking.\n\nHe went out into the middle of the hall, in front of the harp, under the huge dark leaning dome of the mouth, and struck it against the heel of his hand.\n\nThe note came up out of it, thin and clean. It went out into the hall and met the harp's long drone, and the two of them fought. *Wah. Wah. Wah.* The slow throb of two notes not quite the same. It went on until the Fork died in his hand.\n\nAnd the four new courses — the girl's wire, the Compact wire — *rang*. Not much. A faint bright shimmer in the chord, as if they had heard something they had been waiting for.\n\nLucan stood in the middle of the hall for a long time with the Fork in his hand.\n\nThen he took off his robe, because it was in the way, and knelt down at the base of the frame in his shirt, and began.\n\nIt took him the rest of the night. Nine courses, two hundred and sixteen wires, each one tuned not to his own throat but to the Fork: strike it, hold the stem to the frame, listen to the beat, turn the peg a hair, strike it again, until the beat slowed and slowed and stopped and the wire and the Fork were one note. It was slow and his hands were cold and twice he had to stop and sit back on his heels and breathe, because what he was doing was, by every rule he had ever been taught, a sacrilege — retuning the First Warden's harp, with the First Warden's relic, against the Hunger Tone. He did it anyway. Somewhere around the fifth course he stopped being frightened. Somewhere around the seventh the harp began to sound different, and he stopped thinking about anything at all.\n\nAt a little before six, with the grey light of the mouth beginning to brighten in the dome the way it did at what the Anchor called morning, he turned the last peg on the last wire of the ninth course, and stood up, and listened.\n\nIt was not the Hunger Tone.\n\nHe had known that it would not be. He had not known what it would be instead. The harp did not drone now; it *rang*. The long wide many-stranded chord he had listened to every day of his life, the sound he had always heard as a held breath, an ache, a hunger, was gone, and in its place there was something he had never heard: a deep, hard, layered resonance, like a great bell struck very far away, and struck again, and again, each time a little differently, so that it seemed to have no end. Under it the old throat-noise still ran, faint now, small, like wind in the cracks of a door. The bell was over it. The bell was enormous.\n\nHe went to the old reader's console at the side of the hall and woke it, and its screen came up, and the waist trace drew itself across the glass in pale green as the harp sang into it.\n\nFor twelve years he had looked at that trace. Every reader had. A long line — the throat — narrowing toward a point, the waist, and at the waist a narrow gap, the passage, which had been getting narrower Narrowing by Narrowing for as long as anybody could remember. Nineteen per cent of nominal. A starving throat. An empty, closing door.\n\nThe trace on the screen now was not that.\n\nThe throat narrowed toward the waist as it always had. But at the waist there was no gap. There was a shape. A mass — he had no other word — filling the waist almost wall to wall, so dense that the trace went bright and solid across it, and so large that the throat bulged around it like a gullet around something swallowed whole. It was not smooth. Its outline was ridged, banded, layered, like the side of a cut cliff, like the root of the girl's shard. And through the middle of it, not where the passage should have been but squeezed off to one side, crooked, there ran a single narrow crack: all that was left of the way through.\n\nHe sat and looked at it while the harp rang its great slow bell above him.\n\nThe throat was not empty. It was full. All the readings of all the readers for all the years he knew of — *the waist at nineteen*, *the waist at twenty-four*, *it is starving, it is closing* — had been readings taken with the harp out of tune; and out of tune by exactly enough, he understood now, slowly, his skin going cold, that the ringing of the thing at the waist fell between the strings and was not heard. Tuned to the Hunger Tone, the harp heard a gap closing. Tuned to the Fork, it heard what was closing it.\n\n\"It's not starving,\" Lucan said aloud, to nobody. His voice was very small in the hall. \"It's choking.\"","wordCount":1343,"createdAt":1793109149542,"updatedAt":1793109149542},{"id":"bYtpv1hS4vIz6m3JGabI-","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"ljLySiIucyxILA_wCZIFa","text":"The Lamplighter came to take the Anchor the next morning, and found a dead woman in her chapel.\n\nLucan heard the ships before he saw them: the deep shudder through the station's frame as the black ore-hauler docked, and then another, and another. Eight ships. More than she had brought the first time. More than the Anchor had seen in a century. He was on his feet in the harp hall with the Fork still in his sleeve when the iron door opened and the black coats came in, two by two, with lamps, and spread along the walls in their silent double rank as they had before. Then the Prior, on his two sticks, his face like old paper. Then the Deacon. Then her.\n\nShe came into the middle of the hall and stopped.\n\nThe nine little lamps were still burning round the pallet. Hanne lay in her shawl under the mouth with the cittern at her side. Isra was sitting on the floor at her head, cross-legged, with her back straight and her face swollen from crying and her eyes perfectly dry; and she looked up at Mercy Oduya as the Lamplighter came in, and did not get up, and did not look away.\n\nThe Lamplighter looked at the body for a long moment.\n\n\"Who is this?\" she said.\n\nNobody answered. Then the Deacon, behind her, said quietly, \"Old Hanne Venn. The teller. From Rope Street.\"\n\nLucan saw it go into her. He saw it the way he had seen her face change the first time she stood under the dome: something going through the broad plain face and leaving it different. She stood very still.\n\n\"Hanne,\" she said. \"From Rope Street.\" She took a step toward the pallet. \"In the Cleansing?\"\n\n\"In the smoke,\" said Isra from the floor. \"Your smoke.\"\n\nThe Deacon moved. The Lamplighter lifted one hand without turning, and he stopped.\n\n\"She sang at my son's naming,\" said Mercy Oduya. She was looking at Hanne's face. \"Did you know that? I was twenty-two. I lived on Rope Street then, four doors down from her. I had nothing. I had a baby and a room with no heat. And she came to his naming and sat on my floor with that — \" she looked at the cittern — \"with that thing on her knee, and sang the Long Night for him, all forty verses, every one of them different. She said he should hear all of them. Because they were all wrong, and he should know.\" Her voice was very low. \"Tobin. She sang all forty for Tobin.\"\n\nShe knelt down. The black coats along the walls shifted, uneasily. She knelt on the worn floor beside the pallet in her black coat, across the body from Isra, and put out one cracked brown hand and laid it flat on the old woman's shawl, over her heart.\n\n\"I'm sorry,\" she said. To Hanne. \"I'm so sorry.\"\n\nIsra stared at her.\n\n\"You burned her,\" Isra said.\n\n\"Yes,\" said the Lamplighter. She did not take her hand away. \"I did. I said cleanse the Gutter, and they cleansed it, and she was in it. I'll carry her.\" She looked up, across the body, into Isra's face. \"I carry a great many. I'll carry her too. And I will go on, because the door is dying, girl, and if it dies every one of them was for nothing. Every one. Hanne and Tobin and all of them.\" Her dark eyes were wet and perfectly steady. \"Do you understand that? It's the only way they mean anything. If it works.\"\n\nIsra did not answer. Lucan, standing by the harp with the Fork heavy in his sleeve, watched the two of them kneeling on either side of the dead woman, the prophet and the bone-picker, and thought that he had never in his life seen two people understand each other so completely and hate each other so much.\n\nThe Lamplighter stood up.\n\n\"The old woman stays here tonight,\" she said. \"With her lamps. Nobody touches her. Tomorrow the Wardens will give her the rite, in the grey, properly.\" She turned to the Prior. \"And then, Prior, this hall is mine. My Keepers will come here to be blessed. My readers will sit at that harp. The Great Keeping will go from this station, from this dock, under this dome. Your Wardens will keep their cells and their greenhouse and their grey, and they will stand on the dock when my Keepers fly, and sing.\" She paused. \"That is how it will be.\"\n\nPrior Saar leaned on his two sticks.\n\n\"That is how it will be,\" he said.\n\nShe turned to go. At the iron door she stopped, and looked back once — at the harp, singing its long false drone; at the old woman on the floor in her ring of lamps; at Lucan beside the frame.\n\n\"Brother,\" she said. \"You told me the truth, the first time. That it was dying. You were right.\" She looked at the mouth through the dome. \"I mean to save it. I'd like you on my ship when I do. Giving me the line. Will you?\"\n\nLucan felt the Fork in his sleeve, cold against his arm. He felt Isra's eyes on him from the floor.\n\n\"Yes, Lamplighter,\" he said.\n\nShe nodded, as if that were the answer she had expected, and went out, and her black coats went after her, and the Deacon last, who looked back from the door at Isra on the floor — a long look, Lucan thought, not pleasant and not unpleasant, the look of a man reading a list — and closed it.\n\nIsra got up off the floor.\n\n\"*Yes, Lamplighter,*\" she said.\n\n\"Isra — \"\n\n\"You said *yes*.\"\n\n\"I said yes,\" said Lucan, very quietly, \"because she is going to fly a hundred skiffs into the throat in twenty-six days, and she wants somebody to give her the line, and if it isn't me it'll be one of her own, who'll give her whatever line the harp tells him with the harp tuned to a lie.\" He took the Fork out of his sleeve and held it, so she could see it, and put it back. \"I'd rather it was me. I'd rather be on the ship. I'd rather be in the room when it happens, with this in my pocket, than anywhere else in the Reach. Wouldn't you?\"\n\nIsra looked at him for a long moment, there in the ring of lamps over her grandmother's body, with the harp droning its false note behind him and the mouth leaning over them both.\n\n\"Yes,\" she said at last. \"I would.\"\n\nShe sat back down at Hanne's head. After a while Lucan sat down beside her, and they kept the vigil together, all that night, the two of them and the nine little lamps and the old woman, under the dome, while the harp sang the wrong note over and over and over into the dark.\n","wordCount":1169,"createdAt":1793109663614,"updatedAt":1793109663614},{"id":"cDK2ISfqalpDbv63eACdl","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"-WBiz1PuSJ5VBpOzkPGLv","text":"Her mother was at the window when she came in, as if she had not moved from it in a month.\n\nThe *Vigil* was in the yards at Tallow for nine days of patching, and Juno had come straight up from the yards in her stained uniform without calling ahead. Efua Asante did not turn round. In the glass Juno could see her reflection laid over the well of lights below — the black and silver, the composed civic face. On the table behind her a slate glowed with the evening's Assembly business. Juno did not have to read it. Everyone in Tallow Under knew. The appropriation for the Shoals campaign had passed two weeks ago, by four votes, with the Speaker's own vote among them. After the raid on the Anchorhold it would have passed by forty. Nobody remembered any more that it had been close.\n\n\"You voted for it,\" Juno said.\n\n\"Yes.\"\n\n\"Two weeks after he drew her name.\"\n\n\"Eighteen days,\" said Efua. \"Yes.\"\n\n\"Did he come to you?\"\n\nHer mother was silent for a moment. Then she said, to the glass, \"Sit down, Juno.\"\n\n\"I don't want to sit down.\"\n\n\"Then stand.\" Efua turned round. Her face was perfectly composed, and her eyes were not. \"He came to me on the ninth of October. The day after the Draw. In this room. He sat where you're standing and drank a cup of tea and told me how sorry he was, and how extraordinary Pell was, and how he had prayed for her. And then he said that the Thirtieth was the deepest Keeping in two hundred years, and that the Shoals had sworn to stop it, and that without the appropriation the Navy could not protect the Keeping, and that Pell's chances of coming back out of the throat would be very much better with a strong escort than a weak one.\" She paused. \"And that he would see to it personally that the best ship in the Home Squadron was given the escort. Commanded by the best captain.\" Another pause. \"He did, didn't he.\"\n\nJuno felt the floor of the room go out from under her, very slowly, like a lift.\n\n\"The *Vigil*,\" she said. \"Our posting. He — \"\n\n\"Tobiah Greaves didn't choose you for the Keeping, Juno. Cassius Mor did. He asked for you by name. As a favour to me.\" Her mother's mouth moved in something that was not a smile. \"He was very kind about it.\"\n\n\"Did you know?\" Juno said. \"About the sleeve. Did you know?\"\n\nAnd her mother, the Speaker of the Assembly of the Compact of the Reach, looked at her across the room for a long time, and then nodded once.\n\n\"Every Speaker knows,\" she said. \"It's not written anywhere. It's told to you, by the Speaker before you, the night you're elected. That the Wheel is fair except for one foil. That the High Warden is given one name in every Draw, for the good of the Reach. That it's the price of the Keeping, and the Keeping is the price of the door, and the door is the price of everything.\" Her voice did not change. \"I was told on the night of my election, eight years ago. By old Hennessy, at his own dining table, over the cheese. I went home and sat on the edge of the bath and was sick. And then I went to work the next morning, Juno, because what else does one do?\" She drew a breath. \"I have known for eight years that the High Warden chooses one Keeper in every Draw. I didn't know he'd choose mine. I suppose I thought — \" She stopped. \"I suppose I thought I'd been careful.\"\n\n\"You voted for a war,\" said Juno, \"to buy my sister an escort.\"\n\n\"I voted for a war that was going to pass with or without me,\" said her mother, \"to keep the one person who might bring my daughter home standing between her and the guns.\" For the first time, her voice shook. \"And it was you. And you did. You brought her out of the harp hall with a dead boy in her lap. I watched the footage. Do not stand in my house and tell me what I bought.\"\n\nThey stood on either side of the room. Below the window the light-well was full of the small lamps of the houses, a well of stars, and from somewhere far down it a voice was singing the Hunger Tone, held and held.\n\n\"He's going to draw four more names on Thursday,\" said Juno. \"To replace the dead. Four more sleeves.\"\n\n\"Probably.\"\n\n\"And she's still going in. Pell. She's still going in on the fifth of December, because he chose her, with a foil up his sleeve, to buy your vote. And you've known since the night it happened.\"\n\n\"Yes,\" said Efua Asante. \"What are you going to do about it?\"\n\nJuno did not answer. She did not have an answer. She stood in her mother's room in her stained uniform with the list of the dead in her head — Ezra Lind, Tavish Orme, the baker, the novice, Callum Calder, Mara Teague — and found that her hand had gone, by itself, to the breast pocket of her uniform, where a small folded square of paper lay over her heart with a frequency written on it in pencil.\n\n\"I don't know yet,\" she said.\n\nHer mother looked at her hand, and at the pocket, for a long moment. Then she turned back to the window.\n\n\"When you do,\" said the Speaker of the Assembly, to the glass, very quietly, \"don't tell me.\"\n","wordCount":948,"createdAt":1793109506256,"updatedAt":1793109506256},{"id":"ds39JFb5pXhQa4zY2mjNp","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"y0MYjP_qx3qpkSC3kc-xf","text":"The new one had come out of the mouth sometime in the night, and by the time Isra Venn got the Gristle out to it there were already scratches on its hull where somebody else's grapple had tried and slipped.\n\n\"Coopers,\" said Pike, at the back of the cockpit, looking at the marks. \"Or the Mallon girls. Mallon girls, I'd say. They always come in too fast.\"\n\n\"They didn't get it.\"\n\n\"They didn't get it,\" Pike agreed, and coughed, a long wet rattle that went on for some time, and spat into the rag he kept for it, and folded the rag away. \"You want me on the arm?\"\n\n\"I want you on the arm.\"\n\nThe Ossuary lay in the lee of the Needle's mouth, two hours out from the Pans at the Gristle's best speed, which was not a speed anybody would boast about. Nobody had planned it. Things that came out of the mouth came out slow, tumbling, and the mouth's own pull caught them and held them there in a long loose drift a few thousand kilometres across, like leaves caught in an eddy at the edge of a stream. Forty-odd hulls, the last time Isra had counted. More every month. They hung in the grey light at odd angles to each other, dark and still, some of them turning very slowly, all of them furred over with the pale stuff that made them worth the trip — glass, throat-grown glass, the best there was, crusted on the old metal as thick as a hand. You could live a season on what you could cut off one Return. You could live a year, if you were careful and the Lantern did not take it.\n\nBehind them, filling the whole of the canopy's upper arc, the Needle hung.\n\nIsra did not look at it much. Hardly anybody did, now. When her grandmother was a girl it had been a bright thing, Hanne said — a ring of light, the Eye, ships going in and out of it like bees at a hive. Isra had never seen a ship go into it. She had never seen the Eye. What hung over the Ossuary now was a dull bruise, a wound in the sky the colour of old blood, with a sick flicker at its rim that came and went like a lamp on a bad circuit. Sometimes you would catch it out of the corner of your eye, flickering, and feel your stomach turn over. That was all. It did not go anywhere. Nothing went through it. It was where things came out.\n\n\"Coming round,\" she said, and brought the Gristle in under the new one's flank.\n\nIt was a skiff. A Keeper's skiff, the narrow kind, a single seat and a cargo cradle and an engine and nothing else — the kind they had flown in the Keepings before the Quiet, Hanne said, though nobody alive had seen one flown. Twelve metres nose to tail. It had come out of the mouth tail-first and was turning end over end, very slowly, once every four minutes or so, and every time it came round the grey light slid across its hull and lit up the glass on it, and Isra caught her breath, which she did not often do.\n\nShe had seen a lot of Returns. She had never seen glass like this. It did not lie on the hull in a crust. It *grew* from it, out and out, in long branching fronds and plates and needles, as if the skiff had lain for a hundred years at the bottom of some sea that made glass the way the sea on Old Earth was supposed to have made coral. It was clear as water at the tips and milky at the root, and all of it, every frond, every needle, leaned the same way, swept back along the hull from the nose like hair in a wind.\n\n\"Look at that,\" said Pike softly.\n\n\"I'm looking.\"\n\n\"It's grown backwards.\"\n\n\"It's grown out. That's all.\" But she was looking at it the way he was. \"Get the arm on her. Midships, behind the cradle, where it's thin.\"\n\nThe Gristle's grapple arm was older than the Gristle and had been Pike's before it was hers, and he worked it the way a surgeon works, slow and exact, his big ruined hands quiet on the controls. The claw went out on its cable and closed on the skiff's flank where the glass was thinnest, and bit, and held, and Pike let out a long breath that became a cough. They matched spin. It took twenty minutes. Then Isra put on her suit and went over.\n\nInside the glass, the skiff was cold in the way only things from the mouth were cold, a cold that came through the gloves and into the bones of your hands. The canopy was frosted white. She knocked a window through it with the butt of her cutter and put her helmet lamp to the hole and looked in.\n\nHe was still in his seat. They always were. Strapped in, hands on the yoke, head a little forward as if he had been leaning to see something ahead of him. He was young — younger than her, she thought, though it was hard to tell with the frost on his face; a boy with a soft jaw and a lot of dark hair. His eyes were open. They were always open. At his throat, on a cord gone black, there was a small cloudy bead of glass.\n\nIsra looked at him for a while. Then she reached into the thigh pocket of her suit and took out one of the strips of grey cloth she kept there, and reached in through the hole in the canopy, and laid it over his face, and tucked the ends in under the edge of his helmet ring so it would stay.\n\n\"Isra,\" said Pike in her ear.\n\n\"I know.\"\n\n\"Clock's running.\"\n\n\"I *know*, Pike.\"\n\nShe cut for two hours. The cutter's blade went into the glass with a high clean whine that she could feel through her feet on the hull, and the fronds came away in long crystalline pieces that she bagged and clipped to the cable for Pike to reel in. It was good glass. It was very good glass, dense and sweet and clean, the kind that would make a Pans buyer go quiet and stop haggling. She took the fronds off the starboard side and the long plates off the cradle and started on the nose, where the growth was thickest, and somewhere in the second hour she stopped thinking and only cut, the way you do.\n\nThat was why she nearly missed it.\n\nShe had her lamp down in the root of the growth at the nose, where the glass met the metal, and the light went into the glass and came back to her strangely — not reflected but bent, sent off sideways into the crystal and back out again somewhere else, so that for a second there seemed to be a lamp shining up at her from inside the hull. She stopped cutting. She put her helmet close.\n\nThe glass at the root was not milky. It was layered. Fine bands of it, clear and cloudy, clear and cloudy, packed thin as pages, all the way down to the metal, so that looking into it was like looking down into the side of a cut cliff. And the bands did not lie flat to the hull. They rose up from it, every one of them, in a long sweep, like ripples frozen on water. Like something that had been pushed.\n\n\"Pike,\" she said.\n\n\"What?\"\n\nShe did not know what. She cut a piece of the root out — a fist-sized chunk with the bands in it — and bagged it, and clipped it to her own belt rather than the cable.","wordCount":1328,"createdAt":1793093147179,"updatedAt":1793093147179},{"id":"flwBln5xoaOg5AW4uxNRD","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"S-1QAgW06OX3j4fRmh9b3","text":"The Lantern cutter came out of the drift twenty minutes after she got back aboard, which meant they had been watching.\n\nIt was a long black ship with a lamp painted on its bow — a real lamp, an old hanging lantern, done in yellow with a little red flame in it — and it came in close and slow and stopped fifty metres off the Gristle's nose and sat there with its forward guns showing, the way you would let a dog see your stick. Isra watched it come from the pilot's seat with her helmet still on her lap. Behind her, Pike had gone very still.\n\n\"Gristle,\" said the radio. A man's voice, light, pleasant, almost apologetic. \"This is the Lantern cutter *Patience*, Deacon Rusk speaking. Good morning to you.\"\n\n\"Morning, Deacon.\"\n\n\"Is that Isra Venn? Old Hanne's girl?\"\n\nShe did not answer that. \"You want something, Deacon?\"\n\n\"I'm afraid I do. I'm afraid I want the Return you're tied to, and whatever you've cut off her, and I'm afraid I'm going to have to ask you to let go of her now.\" A pause. \"Please.\"\n\n\"She's ours. We had the arm on her first. It's on the log.\"\n\n\"I'm sure it is. But there's been a proclamation, you see. As of this morning.\" The voice was regretful, patient, as if he were explaining to a child why it could not have a sweet. \"You'll hear it in a moment, I expect. All glass is tithe. All Returns are the Lantern's. You can keep your arm and your log. It's the glass we need. Every gram.\"\n\n\"For what?\"\n\n\"For the Needle,\" said Deacon Rusk.\n\nIsra looked over her shoulder at Pike. He was sitting at the arm controls with his hands flat on his thighs, looking at the black ship in the canopy, and his face had gone a strange grey colour under the beard. He met her eyes and shook his head, very slightly. *Don't.*\n\nShe thought about the glass in the bags in the Gristle's hold, two hours of it, the best she had ever cut. A year's living. Hanne's medicine. The heater. She thought about the guns.\n\n\"Cut the arm loose,\" she said to Pike.\n\nHe did. The claw opened and the skiff drifted free, turning, its torn glass sparkling where she had cut it, the grey rag a small dark square in the white of its canopy. The *Patience* put out a grapple of its own and took it in.\n\n\"And the hold, if you would,\" said Deacon Rusk. \"I'll send a boy across.\"\n\nHe sent two boys across. They were young and polite and very thorough, in black coveralls with the lamp stitched on the shoulder, and they emptied the Gristle's hold of every bag and checked the lockers and the crawlspace behind the heater, and one of them found the little cache in the floor under Pike's seat and looked at Pike and said nothing and took that too. They did not search Isra. She sat in the pilot's seat with her helmet on her lap and the fist of banded root glass on her belt, under her hand, where she had put it when the *Patience* came out of the drift, and they did not search her, because she was a girl sitting in a seat and they were boys being thorough about lockers.\n\nWhen they had gone, the radio clicked, and changed, and every channel in the Reach began to speak at once in the same voice.\n\nIsra had heard the Lamplighter before. Everybody had. Mercy Oduya had been preaching from the old Assembly steps in Tallow for twenty-five years and from the Lantern House for five, and her voice came out of every speaker in the Gutter twice a week, warm and low and certain, a voice that sounded as if it was speaking only to you. Isra had never heard it like this. It filled the Gristle's little cockpit to the walls. It sounded like it was coming from inside the hull.\n\n\"Children of the Reach,\" said the Lamplighter. \"Listen to me now. The Sixtieth Narrowing is sixty days away.\n\n\"You know what the Wardens have told us. You have seen it yourselves. Since the Fifty-Eighth the door has not opened as it should. Since the Fifty-Ninth no ship has passed. The Inward is silent. And the Needle, which we were taught from our cradles would keep what we gave it — the Needle is giving it back. You have all seen the Returns. You have all seen what comes drifting out of the mouth with the dead in it. I have stood in the Ossuary and seen it with my own eyes. I have seen my own son's face in a dream every night for eleven years, and I tell you that the Needle is not giving back the dead to mock us. It is giving them back because it is starving. Because we have fed it less and less, generation after generation, a skiff here and three there, as if the covenant were a tax to be dodged. Because we stopped believing that it was hungry.\n\n\"It is hungry. It is dying of hunger. And when it dies, the door closes, and the Reach is alone in the dark forever.\n\n\"So hear me. At the Sixtieth Narrowing, the Reach will keep the Needle as it has never been kept. Not nine Keepers. A hundred. Not a cradle each. Every gram of glass that lies in every hold and every cache and every Return in the Reach. All glass is tithe from this day. All Returns belong to the Keeping. Those who give will be blessed. Those who hoard\" — the warm voice did not change, not by a hair — \"will be found.\n\n\"A Great Keeping, children. The greatest since the First. We will feed the door that it may stay a door.\n\n\"What the Needle keeps, it keeps for us.\"\n\nThe voice stopped. The channels went back to static.\n\nIn the canopy, the *Patience* was turning away, with the stripped Return held in its grapple like a cat with a bird, and the little rag of grey cloth was still there in the window, a dark square, very small.\n\n\"Pike,\" Isra said.\n\nHe did not answer. He had his rag out and was coughing into it, a long fit, worse than before, bent double over the arm controls. When he came up out of it his eyes were wet, and he would not look at her.\n\n\"You all right?\"\n\n\"Fine.\"\n\n\"A hundred Keepers,\" she said. \"Where's she going to get a hundred people who want to fly into that?\" She jerked her chin at the bruise in the sky.\n\n\"She'll get them,\" Pike said. He folded the rag away. His voice was flat. \"She got them last time.\"","wordCount":1143,"createdAt":1793093147008,"updatedAt":1793093147008},{"id":"jj4tVkwtjyho1pfUO97sg","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"Ths_2rRHebAxDhyJU5avw","text":"The message came to the bone-pickers' board at the Pans the next morning, scrawled on a scrap of order vellum and sent down on the Anchor's supply shuttle in a sealed tube addressed, in a hasty hand, to *Isra Venn, Gristle, bone-picker — URGENT — please*. It said: *Bring the glass. Come today. Don't tell anyone. — L.*\n\nShe went. She went without Pike, because Pike had a fever, and because something in the hand made her want to go alone. It took her six hours. The Gristle's heater died twice on the way and she kicked it back to life twice, and she came in to Dock Four with her teeth chattering, and he was waiting on the dock, and he looked as though he had not slept in two days.\n\n\"You came,\" he said.\n\n\"You said *please*.\"\n\n\"I did. Sorry. I'm — come and see. Come and see, and then tell me I'm mad. I'd quite like someone to tell me I'm mad.\"\n\nHe took her up to the harp hall at something close to a run, and at the iron door he stopped, and put his hand on her arm to stop her too, and said, \"Listen.\"\n\nShe listened.\n\nIt came through the door before she was even in the hall: a sound she had never heard. Low, huge, layered. Like a bell, but no bell she knew — like a bell the size of a town struck once at the bottom of a sea, and the sea carrying the sound up to you slowly, in waves, each wave a little different from the last. She felt it in the bones of her face. The shard against her chest, under her shirt, on its cord, gave a single sharp *tick* against her breastbone, like a fingernail on glass, and then began to hum.\n\nShe took it out. It was humming in her palm like a live thing, so hard that it buzzed against her skin. Stronger than at Hanne's cittern. Much stronger.\n\nLucan looked at it and let out a long breath.\n\n\"I tuned the harp to the Fork,\" he said.\n\nShe stared at him. \"You said it was a relic.\"\n\n\"It is a relic. I tuned the harp to it anyway. All night.\" He pushed the door open. \"Come and look.\"\n\nHe showed her the screen. He explained it twice, the second time more slowly, with his hands, drawing the throat in the air between them: the long line, the narrowing, the waist. The gap that every reader since the Quiet had been watching close. And then the thing that was not a gap — the great ridged mass on the screen filling the waist almost from wall to wall, the crooked thread of passage squeezed round its edge.\n\n\"That's glass,\" Isra said.\n\nHe looked at her.\n\n\"That's glass.\" She was sure. She did not know how she was sure, except that she had spent ten years cutting it off the hulls of dead ships and knew its shapes the way Hanne knew songs. She held up the humming shard and turned it so the light went into its root, into the fine pale bands packed thin as pages. \"Look at the edge of your thing. On the screen. Look at the lines. It's the same as this. It's layered like this.\" She heard her own voice rising. \"It's glass, Lucan. There's a — a lump of glass in the throat the size of — \"\n\n\"The size of the Anchor,\" he said quietly. \"Rather larger, I think.\"\n\nShe lowered the shard. It hummed on in her fist.\n\n\"The Returns,\" she said slowly.\n\n\"Yes.\"\n\n\"They're all coated in it. They all come out with it grown on them backwards. Swept back. Like hair in a wind.\" She was working it out as she said it. \"Like they were *pushed*. Like something pushed them out through all that, through the glass, and the glass grew on them while they were — \"\n\n\"The throat's trying to clear itself,\" said Lucan. \"I think. I think that's what the Returns are. The throat flexes, every Narrowing, and things that are stuck in it get squeezed loose, a few at a time, and come out through the mouth. Ships, mostly. Whatever's been put in it. And the glass — \" He rubbed his eyes under his spectacles. \"I don't know about the glass. I don't know why there's so much. I don't know where it came from. I don't know anything except that for at least as long as the order's books go back, every reader at the Anchor has been looking at that thing through a harp tuned so it couldn't be heard, and calling it hunger.\"\n\nThey stood side by side in front of the screen with the great slow bell ringing over them.\n\n\"The Lamplighter's going to put a hundred skiffs into that,\" Isra said. \"A hundred. With every bit of glass in the Reach.\"\n\nLucan said nothing.\n\n\"Into *that*.\" She pointed at the screen with the humming shard. \"Into a throat that's choking on glass, she's going to — \"\n\n\"Yes,\" Lucan said. \"I know.\"","wordCount":859,"createdAt":1793109149411,"updatedAt":1793109149411},{"id":"kn1vW7bglJiW-snA43Acw","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"x2zsF_8HSdHArtZKgYGYk","text":"The Keeping glass shipment was due up from Shaft Nine at six in the morning on the fourth, and at five minutes to six every cutter in the shaft put down their tools and sat down.\n\nNico had been afraid it would be a few. It was not a few. It was all of them, all three shifts, two hundred people sitting down in the galleries and the cage-head and the canteen in the dust, with their cutters lying beside them on the salt, not saying anything. The overseers went up and down shouting. Nobody got up. At a quarter past six the overseers stopped shouting and went up in the cage to report, and at seven Marshal Brandt came down the access road from Tallow with forty Security men in grey and stopped at the shaft-head gate and looked at it.\n\nNico stood on top of the cage-head housing, where everyone in the yard could see him, with a borrowed megaphone he did not need.\n\n\"We'll cut for the Inward,\" he told Brandt, and the yard, and the forty men in grey. \"We'll cut quota. We'll cut what pays the debts. We're not cutting for the dark.\" He held up his right hand. \"Not one more hand for the dark. You heard what happened two days ago. A man flew into the Needle with our glass and didn't come back. That's what it's for. That's what it costs. We're not paying it.\"\n\n\"The Director says the trial worked,\" said Brandt mildly, from the gate.\n\n\"Then let the Director fly the next one.\"\n\nThere was a roar from the yard behind him that went up and up and echoed off the salt walls of the shaft-head, and Brandt waited for it to finish, the way his Director waited for silences, and then nodded, as if Nico had given him a perfectly reasonable answer, and said something to the man beside him, and the forty men in grey spread out along the fence and stood there. They did not come in. They did not go away.\n\nMother Salome came up the access road at noon, past the men in grey, who let her through, because nobody ever stopped Mother Salome going anywhere. She had the Tally under her arm in its blanket. She had Teo with her, grey-faced, and between them, holding Salome's hand, a small girl in an oversized flight jacket with a bag of bolts over her shoulder.\n\nThey came into the yard. Salome set the Tally down on the cage-head step, and unwrapped it, and the cutters who were sitting nearest got up without being asked and came and stood round it.\n\n\"He wasn't a shaft man,\" Salome said. \"Corrigan Dace. He was a pilot. He never cut a gram in his life.\" She looked round at them. \"But he died of the glass. Same as the thirty-one at the top of this plate. Same as all of them. The glass killed him and the Concern sent him to it. That makes him ours.\" She held out the stylus to the girl. \"Go on, love.\"\n\nLulu took the stylus. She knelt down on the step in front of the steel plate, below the rows of names, and the yard went silent, two hundred cutters and forty men in grey at the fence, and a small girl's hand scratched letters into the steel, slowly, carefully, the way she had been taught at the shaft school: C. DACE. When she had finished she looked at it for a while. Then, as an afterthought, she scratched underneath it, smaller, in a hand that wavered: PILOT.\n\nNot Keeper. Nico noticed. Everyone noticed. Nobody said anything.\n\nTeo, standing behind the girl, looked up across the yard at her brother on the cage-head housing, and their eyes met. Hers were red. She did not look away. After a moment she lifted her hand, and put it flat over the bead at her throat, the way she always did, and held it there; and Nico understood that she had come to tell him something, and that she would tell him later; and that whatever it was, she was not going to tell him to keep his head down any more.\n","wordCount":705,"createdAt":1793109315386,"updatedAt":1793109315386},{"id":"rHExWewZiDqoyY_iajzjP","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"IrbCqxmIJL2JUZkCbjfAY","text":"The Lamplighter came to the Anchor two days later, and Lucan watched the Prior go to meet her the way you watch an old dog go out to meet a bigger one.\n\nShe came with forty people. Her own ship — a converted ore-hauler painted black with the yellow lamp on its bow, bigger than anything else flying in the Reach — and two cutters, and the Deacon, and a crowd of Lantern faithful in black with lamps stitched on their shoulders who filled the hangar and the passages and stood in the harp hall in a silent double rank along the walls, watching the harp sing. Lucan had been given no warning. He was on his knees at the base of the frame with the last of the new wire when the doors opened and they came in, and he had not had time to get up.\n\nPrior Saar came in front of her. He was eighty-one and walked with two sticks and had been Prior of the Anchor for thirty years, and in all that time Lucan had never seen him bow to anyone. He did not bow now. But he stood aside, which was worse.\n\n\"The harp hall,\" said Prior Saar. \"As you asked.\"\n\nMercy Oduya came past him into the middle of the hall and stopped and looked up.\n\nShe was not what Lucan had expected. He had heard her voice for years, on the speakers, in Tallow, on every channel; he had imagined somebody tall, iron, a prophet from a painting. She was small. Smaller than him. A broad, plain, dark-faced woman of fifty in a black coat, her hair grey at the temples, her hands bare and cracked like a cook's. She stood under the dome with the mouth leaning over her and the harp singing in front of her, and she looked up at the Needle, and Lucan saw her face change, and saw — he could not have said how — that she had never been here before. That she had been preaching the Needle for twenty-five years and had never stood this close to it.\n\n\"Oh,\" she said, very softly.\n\nNobody moved. The harp sang.\n\nShe went to it. She walked up to the frame, right up, as close as Lucan was, and he scrambled back on his knees out of her way, and she did not seem to see him. She put out one cracked brown hand and laid it on the old gold glass, flat, the way he did himself. She stood there with her palm on the harp and her eyes closed and the drone going through her, and her lips moved, and Lucan, who was nearest, heard what they said. It was a name. *Tobin.* She said it three times.\n\nThen she opened her eyes and took her hand away and turned, and she was the Lamplighter again.\n\n\"Prior,\" she said. \"Thank you. I wanted to stand here. I wanted to hear it.\" Her voice was the voice from the speakers, warm and low; in the hall it was very quiet and carried to every wall. \"Now I'd like to hear from your readers.\"\n\n\"Brother Lucan is our reader,\" said the Prior.\n\nShe looked down at him, on his knees, with wire in his hands. \"Brother.\"\n\nHe got up. He was aware of his frayed cuffs, of the ink on his fingers, of the double rank of black coats along the walls. Of the Deacon, standing just inside the door: a thin, neat, pleasant-faced man with his hands clasped behind his back, watching Lucan with polite interest, as if he were an item on a list.\n\n\"What does it say?\" said the Lamplighter, and nodded at the harp.\n\n\"It — \" Lucan cleared his throat. \"The waist is at nineteen per cent of nominal. It's been below twenty-five since the Fifty-Ninth. It hasn't recovered between Narrowings, the way it used to. Each one leaves it a little narrower.\" He hesitated. \"The readings are noisy. I've only just restrung it. Some of the courses were — I'm not sure how much to trust what it was telling us before.\"\n\n\"At the Sixtieth. What will it do?\"\n\n\"I don't know.\"\n\n\"Brother.\" She came a step closer. She was looking up at him; she had to. Her eyes were very dark and very steady. \"I didn't ask what you know. I asked what it will do. You listen to it every day. You've listened to it longer than anybody living. What will it do?\"\n\nHe looked at the harp. He thought of the long nights, the headphones, the drone. He thought of the waist line on the old screen, creeping down, creeping down, year by year, a little lower after every Narrowing, like a tide going out that never came back in.\n\n\"I think it will close,\" he said. \"I think — I think it's dying.\"\n\n\"Of what?\"\n\n\"I don't know.\"\n\n\"I do,\" said Mercy Oduya.\n\nShe did not raise her voice. She said it quite gently, as if she were sorry to have to. \"It's hungry, Brother. It's been hungry for a hundred years. We feed it less and less, and it gives us less and less, and now it's giving back what we gave it because it hasn't the strength to keep it. You've seen the Returns. I've seen them. My son is in there.\" She did not look away from him. \"He was seventeen. He went in at the Fifty-Ninth with a cradle of glass and a bead at his throat, and I sang him off from the Lantern House steps, and I have not slept a night through since. And I have asked the Needle every night for eleven years whether it was enough. Whether he was enough.\" Her voice did not break. \"It wasn't. Nine skiffs at the Fifty-Eighth. Seven at the Fifty-Ninth. It wasn't enough. So we will give it enough.\"\n\nLucan found he had nothing to say. The black coats along the walls were silent. Somewhere in the double rank someone was weeping, very quietly.\n\n\"I'll need your readings,\" the Lamplighter said, turning to the Prior. \"Every day from now until the Sixtieth. Where the waist is. When it narrows. When the Long Night begins, to the hour. I'll need a reader on my ship when we go in, to give the line. And I'll need the Wardens on the steps of the Lantern House at the Great Keeping, in your grey, with your Fork, to bless the Keepers as they go.\" She paused. \"As the Wardens always used to.\"\n\nPrior Saar leaned on his two sticks for a long moment.\n\n\"The Wardens will bless the Keeping,\" he said. \"As they always have.\"\n\n\"Thank you, Prior.\" The Lamplighter inclined her head, very slightly, which was more than he had done. Then she looked once more at the harp, and at the mouth above it, and at Lucan, standing beside it with the wire in his hands.\n\n\"Brother,\" she said. \"Thank you for telling me the truth. Most people don't. I could hear that you were.\" And she went out, with her black coats behind her, and the Deacon last, who smiled at Lucan pleasantly on his way through the door, and the door closed.\n\nThe harp sang. Prior Saar stood in the middle of the hall on his two sticks, very old, looking at nothing.\n\n\"Prior,\" Lucan said.\n\n\"Not now, Brother.\"\n\n\"She's going to put a hundred people in the throat. A hundred, Prior, and every gram of glass in the Reach, and I *don't know* — \"\n\n\"*Not now.*\" The old man's voice cracked like a whip, and Lucan stopped. Saar closed his eyes. When he opened them again he looked only tired. \"There are twelve of us, Lucan. Twelve. In a station built for six thousand. We eat because the Lantern lets us trade in Tallow. We have air because the Lantern lets the Pans sell us scrubbers. When she asks us to stand on her steps in our grey, we will stand on her steps in our grey. That is what it is to be twelve.\" He turned toward the door on his sticks. \"Finish your wire. Read your throat. Give her the numbers. And for the love of whatever you still believe in, Brother, stop telling people you don't know.\"","wordCount":1391,"createdAt":1793093821921,"updatedAt":1793093821921},{"id":"sqyjFT2uwAzmNjYmmdbdM","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"Johvj7zgQopHpMfzzXMTt","text":"She came in to Dock Four at noon the next day with Pike strapped into the jump-seat and her grandmother's body wrapped in a bone-picker's shroud in the Gristle's hold, and Lucan was on the dock, and when she climbed down out of the hatch and saw him she found that she could not let go of the ladder.\n\nHe came and took her hands off it, one finger at a time, and held them.\n\nThey laid Hanne out in the harp hall. That was Lucan's idea; Isra would not have thought of it. The Wardens had a rite for the dead, he said, an old one, older than the Quiet: the body lay for a night under the dome, in the sound of the harp, so that the Needle would know who was coming. He did not believe the last part. He said so. But he thought Hanne might have liked the music. So they carried her up through the dark spindle, the two of them, with Pike walking behind, slowly, one hand on the wall, and laid her on a pallet on the worn floor under the mouth with her shawl folded round her and the cittern beside her, and Lucan lit the little lamps that the rite required, nine of them, round the pallet, and they sat down on the floor.\n\nThe harp was singing the Hunger Tone again. Lucan had retuned it, as the Prior ordered, the night the Prior ordered it. He had sat up all night doing it, he told Isra, without once looking at the screen.\n\n\"I've been playing it like this for nine days,\" he said. \"Listening to it lie to me.\" He looked at the harp, gold in the lamplight. \"I've been thinking about your grandmother's cittern the whole time.\"\n\nIsra said nothing. After a while she reached over and picked up the cittern from beside Hanne's body, and set it on her knee, the way Hanne had always set it, and held it out to him.\n\n\"The low string,\" she said. \"She said it's never been retuned. Never. Every teller back and back. They're told the low one stays.\" Her voice did not quite hold. \"She said it's the old note.\"\n\nLucan looked at the cittern for a long moment. Then he got up without a word and went to the reliquary grille.\n\nThe hinge-pins were back in. The Prior had seen to it. Lucan did not bother with them. He took out of his sleeve, from somewhere inside his robe, a small brass object, and turned round, and Isra saw what it was.\n\n\"You — \"\n\n\"I took it back the night after he took it,\" Lucan said. \"Off his bedside table. He sleeps very deeply. He hasn't noticed yet. Or he has, and he hasn't said.\" He came back and knelt beside her. \"I'm going to hell, I think. If there is one. I've stopped being sure there's anything to go to.\"\n\nHe struck the Fork against his palm. Its note went up, thin and pure, into the dome, and met the harp's drone and fought it, *wah, wah, wah*. And then, while it was still sounding, Isra plucked the low string of her grandmother's cittern.\n\nThe two notes met.\n\nThey did not fight. They lay down together in the air of the hall like two people who had been apart a long time, one inside the other, so exactly the same that for a moment Isra could not tell which she was hearing — the Fork or the string or both — only one note, round and clear, going up into the dome under the bruised dark mouth. Inside her shirt the shard rang against her breastbone like a struck bell.\n\nLucan let the Fork fall to his lap. His face was wet.\n\n\"The tellers,\" he said. \"The tellers kept it. All through the Quiet. When the order lost the records, and the harp went to the Hunger Tone, and nobody remembered — they kept the old note. In a string. Not knowing why.\" He gave a short, cracked laugh. \"Three hundred years. In a cittern in the Gutter.\"\n\nIsra put the cittern back down beside Hanne, carefully, the low string still faintly humming against the old woman's shoulder. Then she lay down on the floor of the harp hall next to her grandmother's body with her face against the shawl, the way she had lain against Hanne's knee when she was small, and cried the way she had not cried on the salt at the junction or in the Gristle or on the dock — all of it at once, out loud, with nothing held back, while Lucan sat beside her with the Fork in his lap and his hand on her back, and Pike, against the wall, with his eyes closed, coughed softly into his rag.","wordCount":811,"createdAt":1793109664059,"updatedAt":1793109664059},{"id":"tONbv87uKF5iOMJqQqFlx","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"a1hef7PUuV2rTKJY7IUgz","text":"They gave Corrigan a speech, and a band, and a blessing from a Concession chaplain nobody had ever seen before, and a sunburst pin for his collar, and they gave Teo the inner markers.\n\nShe had asked for it. Hesper Vane's office had said that the trial would go with one escort to the edge of the shear — a pathfinder, to fly the line ahead of the Brannock as far as the markers, so that Corrigan would not have to read the outer waves and the throat both — and the Concession throat-haulers had all found reasons to be in the yards that day, and Teo had gone up the spindle to the Director's outer office and put her name down in pencil on the form before she could think about it. Nobody had argued. Nobody else had wanted it.\n\nSo at eleven in the morning on the second of April she sat in the Small Mercy at the last beacon of the in-lane, with her mains feathering and the Needle filling the canopy, and waited for him.\n\nThe mouth had changed since she had last been out here with Ambrose. She could see it from the beacon, before the shear even began: the wall of light at the rim was brighter, tighter, the coils of starlight around it wound so close that they had blurred into a single band of grey-gold fire, and the bruise at the centre was smaller and darker and deeper, like a pupil in a bright room. It looked, she thought, like an eye that was squinting. Like an eye in pain.\n\n\"Mercy, Lectern.\" Ambrose's voice in her ear, very calm. He had asked to read the line himself. \"The waist is at thirty-four. Shear is heavy from two to five o'clock, lighter from the left. I'll call you in. Is the Brannock with you?\"\n\n\"Coming up now.\"\n\nHe came up on her starboard side, the Brannock, ugly and familiar, her new cradle slung under her belly like a pregnancy, packed with two tonnes of the best glass Shaft Nine had ever cut. Teo could see the cradle-frame through the gap in the hull, and the dull blue gleam of the crated glass inside it, and the white release lever painted on the frame where Corrigan would be able to see it through the floor-port of his cockpit. They had made him practise pulling it. He had told her so the night before, laughing, in the Lantern, with Lulu asleep against him. *Thirty times. Like I might forget which way's down.*\n\n\"Morning,\" he said on the private channel.\n\n\"Morning.\"\n\n\"Lovely day for it.\"\n\n\"Shut up, Corr.\"\n\n\"I've got a pin,\" he said. \"Did you see? They gave me a pin. I've never had a pin.\" A pause. \"Lulu's on the gallery with Mother Salome. She's got her bolts. She said she'd bring them for luck.\"\n\nTeo did not trust her voice. She ran the mains up.\n\n\"Lectern, Mercy. Brannock's with me. Going in.\"\n\nThey went in.\n\nIt was worse than before. She had known it would be. The first shear-waves came at them two kilometres past the beacon and they were not waves, they were walls, coming one on top of the other with no space between, and the Small Mercy bucked and shuddered and screamed in every seam, and twice Teo felt the tow-hook in the stern tear half out of its mount and hang there by a bolt. Ambrose called them. His voice in her ear never changed. *Two o'clock, high, thirty seconds. Left, now, now. Hold her. Big one from behind in fifty, turn into it, Teo, turn into it.* She turned into them. Behind her on her stern camera the Brannock came on in her wake, heavier, slower, lurching under the weight of the cradle, Corrigan following her line so close that she could see the scratch on his canopy where Lulu had once dropped a spanner.\n\nAt the inner markers she stopped. Those were the orders. The two dead beacons hung in the fire on either side of her like drowned men, and she brought the Mercy round between them and held her there, nose into the mouth, mains screaming, and the Brannock came up beside her and slowed and hung there too, for a moment, side by side, the way they had hung at a hundred markers in twenty years waiting for Approach to wave them through.\n\n\"Well,\" said Corrigan.\n\n\"Corr.\"\n\n\"Don't.\" He said it quite gently. \"I know. Me too.\" She could hear him breathing. \"Look after her.\"\n\n\"I will.\"\n\n\"If.\"\n\n\"If,\" Teo said. \"Just if.\"\n\nThe Brannock went forward.\n\nShe watched it go. She would watch it go for the rest of her life; she would see it every time she closed her eyes in the dark for the rest of her life. A small ugly tug with a cradle under its belly, going away from her into the fire. It got smaller. It did not get smaller the way things get smaller when they go away from you; it got smaller *wrong* — stretched, pulled long, thinned to a line of light and then not even that, as the throat took it, until it was a bright scratch on the face of the dark and then a point and then nothing she could see at all.\n\n\"I'm in,\" said Corrigan's voice in her ear. It was faint, and it had begun to waver, rising and falling as if he were speaking from the bottom of a well. \"I'm in the throat. Lectern, are you getting me?\"\n\n\"We have you, Brannock.\" Ambrose. \"You're on the line. Hold your heading. The waist is nine kilometres ahead.\"\n\n\"It's — \" A rush of static. \"It's not like anything. Teo. Are you there?\"\n\n\"I'm here.\"\n\n\"It's not like anything. The walls are — it's folded. It's all folded light. Like the inside of a shell. And it goes in. It goes in and in.\" His voice went away and came back. \"There's a — it's narrowing. Up ahead. It's drawing in. Like an iris. Like an eye shutting.\" A long breath. \"And there's a light in the middle of it, Teo. In the middle where it shuts. A light. I've got no name for it.\"\n\n\"Three kilometres,\" said Ambrose. \"Two. Brannock, you're at the waist. Release when you're ready.\"\n\n\"Releasing.\"\n\nTeo did not hear the release. But she saw it.\n\nThe mouth flared. Not the rim — the dark at the centre, the bruised pupil, which had never in her life shown anything but dark; it went white, for an instant, a hard bright white like a cutter's arc, and then a sickly blue, and then dark again, and a shockwave came out of it that hit the Small Mercy like a thrown rock and threw her back on her tail between the two dead beacons and set every alarm on the console screaming at once. Through the channel, through the static, she heard the harp in the Lectern — Ambrose had his line open to it — let out a sound she had never heard an instrument make, a scream, high and thin and long, all its strings at once.\n\n\"Brannock,\" said Ambrose. \"Brannock, report.\"\n\nStatic.\n\n\"Brannock, Lectern. Corrigan. Report.\"\n\n\"Corr,\" said Teo. \"Corr, talk to me.\"\n\nStatic. And under the static, very faint, faint as something heard through a wall — she would never be sure, afterward, that she had heard it at all — a voice, not saying anything. Breathing. Or laughing. Or something else.\n\nThen nothing.\n\nShe waited at the inner markers for three hours. The orders were twenty minutes. At thirty minutes Approach told her to return. At an hour the Director's office told her to return. At two hours Ambrose said, very quietly, on the private channel, *Teo. Come home. Please,* and she switched him off. She sat between the two dead beacons with the Mercy screaming and shuddering under her, the tow-hook hanging by a single bolt, every alarm on the console red, and watched the dark at the centre of the mouth for a small ugly tug with a scratch on its canopy coming back out of it.\n\nAt three hours the Mercy's port attitude jet failed, and she had to come home, because if she did not she would go in herself.","wordCount":1392,"createdAt":1793109316507,"updatedAt":1793109316507},{"id":"vXEoz0hdY-aq7s6xtW8wb","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"8ToxIOb8HYRru4TVdN4m7","text":"The Lamplighter called it the Cleansing, and it began at midnight on the twenty-sixth of May, twenty-eight days before the Sixtieth Narrowing, with a sermon.\n\nIsra heard it from the Pans. She was on the bone-pickers' dock with a torch in her teeth, under the Gristle's belly, refitting the deck plates the Lantern had torn up the week before, and the speakers on the dock came on all at once the way they did, and that warm low voice filled the cold hangar like water filling a tank.\n\n\"Children,\" said the Lamplighter. \"There are those among us who hoard.\n\n\"I have asked for the glass. I have asked gently. I have sent my Deacon to your doors with a lamp and a kind word. Most of you have given. I bless you. But there are those among us — in the Gutter, in the Pans, in the old Shoals holds — who have hidden what the Needle needs. Who have kept back glass in their walls and their floors and their mouths, while the door dies. Who have gone, some of them, in secret, to the Anchor, to whisper with the Wardens about things the Wardens have no business saying.\" A pause. \"I know who you are. I have always known.\n\n\"Tonight my Lantern will go into the Gutter and cleanse it. Every room. Every wall. Every floor. What is hidden will be found, and what cannot be found will be burned out. Do not stand in their way. If you have nothing hidden, you have nothing to fear.\n\n\"What the Needle keeps, it keeps for us.\"\n\nIsra dropped the torch.\n\nIt took her twenty minutes to get from the Pans to Rope Street. She ran the whole way, up through the cargo tunnels and the old shuttle ramp and the long dark gallery under the Third Terrace where the light-wells had fallen in, and the whole way she could smell it coming: smoke. Not salt-smoke, the dry grey breath of a cutting torch on rock; real smoke, black and greasy, the smoke of rags and oil and wood and plastic, of everything people had carried down into the Gutter because it was all they had. By the time she came out at the head of Rope Street the tunnel was full of it to the roof, rolling and orange-lit, and people were coming out of it the other way, crawling, coughing, carrying children, carrying nothing.\n\nThe Lantern had lit it from both ends.\n\nThey had not meant to, perhaps. Isra would think that later, much later, when she could think anything. They had come down Rope Street with their oil lamps on poles, room by room, tearing out walls and floors, and somewhere somebody had fought them, or dropped a lamp, or thrown one; and the Gutter was a hundred years of rags and bedding and dried salt-weed and paper packed into tunnels with no air, and it had gone up the way paper goes up. She could see them at the far end of the tunnel through the smoke, the black coats, lamps swinging, falling back. Coughing. Shouting at each other. Not coming forward.\n\nHanne's room was at the end of a dead-end off Rope Street. In the middle. Where the smoke was thickest.\n\nIsra pulled her shirt up over her mouth and nose and went in.\n\nShe did not remember most of it. Heat, low down, along the floor. The walls invisible. Somebody's hand catching at her ankle — a child, a boy, she dragged him back to the street and went in again. The dead-end. The ship-door, which had been part of a ship, which was steel, which was standing open. And in the doorway, on his knees, a huge dark shape coughing so hard he could not stand, with something in his arms.\n\n\"Pike.\"\n\n\"Got her,\" Pike said. It came out of him in pieces. \"Got her. Ribs. Can't — lift — \"\n\nHanne was in his arms. Small, folded, wrapped in her shawl. Her face was black with soot and her eyes were shut and she was holding, against her chest, with both arms, the cittern.\n\nIsra took her. She weighed nothing. Isra took her and put her over her shoulder the way you carry a sack of glass, and got her other arm under Pike's arm, and the three of them went back up Rope Street through the smoke on their knees, and their hands, and Pike's breath whistling and whistling, until the air got thinner and cooler and they came out into the junction under the old shuttle ramp and lay down on the salt.\n\nDeacon Rusk was standing at the junction with his hands clasped behind his back, watching the smoke come out of the tunnel.\n\nHe looked down at them. At Pike, flat on his back with his strapped ribs heaving. At Isra on her knees. At Hanne, in her shawl, with the cittern in her arms.\n\n\"Old Hanne,\" he said. He sounded, for once, almost uncertain. \"Is she — \"\n\n\"Get away from her,\" said Isra.\n\nHe looked at her for a long moment. His face, under the soot and the lamplight, was unreadable. Then he stepped back, one step, and turned his head and called to the black coats behind him: \"Leave these. They've nothing. Go on.\" And he went away up the ramp without looking back.\n\nHanne opened her eyes.\n\n\"Girl,\" she said. Her voice was a thread.\n\n\"I'm here. Gran. I'm here. Don't talk.\"\n\n\"Don't be stupid. I've been talking for seventy-three years, I'm not stopping now.\" Her bird's eyes moved, found Isra's face, held it. \"The cittern.\"\n\n\"You've got it. It's here. You've got it.\"\n\n\"Listen.\" The old woman's hand moved on the strings. \"The low string. Do you hear me? The low string. Never retune it. It's never been retuned. Not by me. Not by my mother. My mother's gran set it, and her father before her, back and back. Every teller. We're told: you can tune the others how you like, but the low one stays. Always. It's the old note.\" She coughed. It went on a long time, and when it stopped there was blood on her lips. \"I never knew why. Nobody knew why. We just kept it.\" She looked at Isra. \"That's why your glass sings at it. Isn't it. That's what you found.\"\n\nIsra could not speak. She nodded.\n\n\"Hah,\" said Hanne. Something like satisfaction moved in her face. \"Wrong is better than nothing. Because you can fix wrong. Didn't I tell you.\" Her fingers found the low string and plucked it, very softly. It sounded under the roar of the burning tunnel: one deep note, old, true. Against Isra's breastbone, inside her shirt, the shard woke and hummed.\n\n\"Take it to your Warden,\" said Hanne. \"The boy. Take it to him.\"\n\n\"Gran — \"\n\n\"*The door grew narrow in the dark,*\" sang Hanne Venn, in a voice so thin it was hardly there, plucking the low string, \"*the Reach was cold and small — *\" and stopped, and did not go on.\n\nIsra knelt on the salt with her grandmother in her arms, and the cittern between them, and the low string still faintly humming. Beside her Pike lay with his face turned away. Behind them, all down Rope Street, the Gutter burned.","wordCount":1225,"createdAt":1793109664459,"updatedAt":1793109664459},{"id":"wNITekP2YEqcm2YyCu11W","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"qTwKP2JxoJ31y0x86T5by","text":"Past the last beacon the lanes ended and the sky went strange.\n\nTeo had been out to the outer markers a hundred times, hauling sleds for the throat-haulers to pick up, and she knew the way the stars began to slide there, the first long smears at the edge of the canopy. Past the inner markers it was another country. The Needle's mouth filled the whole forward canopy and spilled over its edges, a vast curved dark that was not dark, that seemed to lean toward you the longer you looked at it, and around its rim the starlight was not smeared but *wound* — wrapped round and round the mouth in tight bright coils, so that the whole sky seemed to be draining into it like water into a sink. The Eye was not a ring of light any more. It was a wall. It went up and up and curved over the top of the canopy and down behind them, faintly luminous, grey-gold, like the inside of a shell.\n\nThe Small Mercy did not like it. Teo could feel her not liking it, through the seat and the yoke and the soles of her feet: a long low shudder that came and went, came and went, as the shear-waves rolled off the mouth and broke over the hull.\n\n\"Talk to me,\" she said.\n\nAmbrose was strapped into the jump-seat behind her with a pair of old cracked headphones on, plugged into a portable reader on his knee. He had his eyes closed. \"The next one's about forty seconds out. It's a big one. From your right, up, about two o'clock.\"\n\n\"How do you know?\"\n\n\"I can hear it coming.\"\n\nShe looked at him in the mirror. He was not joking. His face was very still and intent, the face of a man listening to music in another room.\n\n\"Thirty seconds.\"\n\nShe put the Mercy's nose round toward two o'clock and up, the way you would turn into a wave in a boat, and fed the mains, and waited, and at twenty-nine seconds the shear hit them like the side of a building. The tug lurched. Something in the cargo bay banged against its straps. The whole canopy filled with a flash of grey-gold light as the hull caught the edge of the wave, and the yoke bucked in her hands, and then they were through it, wallowing, upright.\n\n\"Good,\" said Ambrose, without opening his eyes. \"That was very good. The next is smaller. Fifty seconds. Dead ahead.\"\n\nThey went in like that, wave by wave, for half an hour. He called them and she flew them. She had never flown with a reader before. She had always thought of readers as a kind of priest, men in domes who drew charts and sent them down to the docks on slates, and she had not understood that you could fly with one beside you, that it was like flying with a second pair of eyes that saw in a direction your own did not. By the tenth wave she was turning into them before he finished speaking. By the twentieth she had stopped being frightened, mostly, and started being something else, something that made her grin into her helmet like an idiot.\n\n\"You've done this before,\" she said.\n\n\"Not for twenty years. I used to fly with the throat-haulers when the Lectern was new. Before they decided I was too valuable to risk.\" He opened his eyes. \"You're very good, Miss Kesh.\"\n\n\"I know.\"\n\n\"I mean it. They told me you were good. They didn't tell me you were — \" He seemed to look for the word. \"Attentive.\"\n\n\"I'm a tug pilot,\" she said. \"You fly forty tonnes of sled on a bad tow, you get attentive or you get dead.\"\n\nThe bead was pulling.\n\nShe noticed it somewhere in the last few minutes, the way you notice a sound that has been there for a while. The little nub of glass at her throat had swung on its cord and was lying, not against her breastbone, but out from it, a finger's width from her skin, the cord stretched taut, leaning toward the mouth like a dog straining at a leash. She put her hand over it. It pressed into her palm, very gently, insistently.\n\n\"Mr Lyle.\"\n\n\"Ambrose.\"\n\n\"Ambrose. Does glass — \" She felt stupid. \"My brother's a cutter. He says glass knows where the Needle is.\"\n\nHe leaned forward in the jump-seat and looked at the bead in her hand, and then at her, and for a moment he looked so interested that she forgot to feel stupid.\n\n\"Your brother is right,\" he said. \"It does. It's the same stuff, you see — the throat and the glass. Negative energy. That's what holds the Needle open: a ring of something like brine-glass, only stranger, at the waist, pushing outward. The glass in the salt is a kind of — cousin. It feels the throat the way a compass feels a pole.\" He smiled. \"Cutters have known that for fifty years. Physicists keep rediscovering it and writing papers.\"\n\n\"Is that why it's narrowing? The ring at the waist?\"\n\nThe smile went. \"I don't know why it's narrowing,\" he said. \"That's why we're here.\"\n\nThey came to the inner markers — two old beacon buoys, dark, dead for decades, hanging in the grey-gold glow like drowned men — and Teo brought the Mercy round between them and held her there, heading into the shear, mains just feathering, while the tug shuddered and wallowed and the wall of light leaned over them.\n\n\"Here?\"\n\n\"Here. Hold her as steady as you can.\"\n\nHe went back to the cargo bay. She heard him in there, the clank of straps, the grunt of a man too old for this hauling something heavy. She heard the inner airlock cycle and the outer one open. Then she felt the buoy go — a small lurch as the mass left the tug — and in her rear camera she saw it tumble away from the Mercy's stern, a little grey cylinder turning end over end, slower and slower, until the mouth's pull caught it and it stopped turning and hung there, quite still, nose to the dark, as if it were listening.\n\nIts lattice of wires opened, like an umbrella. Like a flower.\n\nAmbrose came back up and dropped into the jump-seat and pulled his headphones on, and plugged the reader into something, and closed his eyes, and his face changed.\n\n\"Oh,\" he said.\n\n\"What?\"\n\nHe did not answer. He was listening. She watched him in the mirror. She watched the colour go out of his face and come back, and his lips move as if he were counting, and his hands, which had been loose on his knees, close slowly into fists.\n\n\"What is it?\" she said. \"Ambrose. What is it?\"\n\n\"It's — \" He opened his eyes. They were wet. \"It's beautiful. I didn't know. I didn't know it sounded like this up close. I've spent twenty-three years listening to it from the back of the room.\" He gave a sort of laugh. \"And the waist is going down. It's going down faster than the harp says. The harp's too far away. It smooths everything out.\" He listened again. \"It's like a drawstring. Like someone's pulling a drawstring. Very slowly. Very evenly.\"\n\n\"Can it close?\"\n\n\"I don't know.\" He took the headphones off. \"But there's — there's something else. Under it. I heard it in the Lectern the other night and I thought it was the instrument. It isn't the instrument. It's here too, it's louder here. A kind of — \"\n\nThe shear hit them from behind.\n\nThere had been no warning. He had had his headphones off. It came out of the mouth at their stern like a fist, and the Small Mercy went over on her side and then on her back and the canopy was full of grey-gold light and then of stars and then of light again, and the proximity alarm was shrieking, and somewhere behind her Ambrose had been thrown against his straps and was saying something she could not hear. The yoke was dead in her hands. The tug was tumbling toward the dark — she could see it in the canopy each time they came round, the bruise, nearer, nearer, the coils of starlight going past like the walls of a drain.\n\nShe did not think. She cut the mains, and fired the starboard attitude jets in one long burn until the tumble slowed to a spin and the spin to a wallow, and then she put the nose, not away from the mouth, but along it — skimming the edge of the wall of light, letting the pull take her round in a long falling curve the way you let a current take a boat round a rock — and when the curve brought her nose round to face the inner markers again she gave the mains everything they had and a little more, and the Small Mercy screamed and shuddered and clawed her way up out of the pull, metre by metre, until the wall of light fell away behind them and the shear-waves were only waves again, and then only shudders, and then they were past the last beacon and in the lanes and it was over.\n\nShe sat with her hands on the yoke. They were shaking. She could not make them stop.\n\nBehind her, Ambrose Lyle was laughing. It was not a happy laugh, exactly. It was the laugh of a man who has been very frightened and has found himself alive.\n\n\"Six hundred marks,\" he said. \"You could have died for six hundred marks, Miss Kesh.\"\n\n\"I die for less than that every day,\" said Teo. \"Usually it's slower.\"\n\nHe stopped laughing. In the mirror she saw him looking at her, really looking, as if he had just seen something he had not expected to see.\n\n\"Thank you,\" he said.\n\n\"Write the waiver,\" she said, and her voice came out wrong, and she turned the Mercy for home.","wordCount":1690,"createdAt":1793093335803,"updatedAt":1793093335803}],"plotThreads":[{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Pell's Draw","color":"#3b82f6","id":"1aS0ZiRvPGHGOx-cD4FBf","createdAt":1793092244120,"updatedAt":1793092244120,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Withdrawal","color":"#ef4444","id":"5JoUOSVHYh-7D4UQ_KxQg","createdAt":1793092240860,"updatedAt":1793092240860,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Teo's debt","color":"#f59e0b","id":"9yaD7eWlZcvjmZ6iUF8ff","createdAt":1793092239785,"updatedAt":1793092239785,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Ambrose's proof","color":"#10b981","id":"FWVqEenkB0ukMB8QFSCGi","createdAt":1793092243013,"updatedAt":1793092243013,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Isra and the Gristle crew","color":"#ef4444","id":"G2vQKK6meEnzZ9EFXlOcw","createdAt":1793092249643,"updatedAt":1793092249643,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Severance war","color":"#ec4899","id":"IAvx2vIwh-tQhQJ3-4jZM","createdAt":1793092245215,"updatedAt":1793092245215,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"The choked throat","color":"#f59e0b","id":"_K3aJb1aHDBGtrGLmSbYZ","createdAt":1793092248524,"updatedAt":1793092248524,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Great Keeping","color":"#f97316","id":"ctdamGI31cA5s7CsmwaVQ","createdAt":1793092247397,"updatedAt":1793092247397,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Adaeze's heresy","color":"#14b8a6","id":"eBOv7USgNPYsH_prm_0Ed","createdAt":1793092246292,"updatedAt":1793092246292,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Keeping (all eras)","color":"#8b5cf6","id":"eO_7QOdp0avWbvEC7OOfX","createdAt":1793092256981,"updatedAt":1793092256981,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Cutters' strike","color":"#8b5cf6","id":"ePqBA24DL3HH2OjsKHoMk","createdAt":1793092241928,"updatedAt":1793092241928,"version":1}],"motifs":[{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Debt and the tally","color":"#0891b2","id":"8CmTnO92ZbAiueYnKULWV","createdAt":1793092265347,"updatedAt":1793092265347,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Hands","color":"#65a30d","id":"E7dpHAGomtgYlj_PdF-Qi","createdAt":1793092266442,"updatedAt":1793092266442,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Light in the dark","color":"#2563eb","id":"PCXJLDRcGRTQ9mrzsfblI","createdAt":1793092267531,"updatedAt":1793092267531,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Salt and glass","color":"#e11d48","id":"gQ_6swqJ5lW3yGhmN9POY","createdAt":1793092263174,"updatedAt":1793092263174,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"The fork's note","color":"#7c3aed","id":"uRRXouZ1ANkDsIh6wIm9O","createdAt":1793092264252,"updatedAt":1793092264252,"version":1}],"continuitySuppressions":[],"writingLogs":[{"id":"ttPfJj63Y88W8-fCbPDAo","worldId":"os-ym7EwunyTMDieuRMb1","date":"2026-10-27","words":50705,"createdAt":1793092435352,"updatedAt":1793109664459}],"sceneRevisions":[],"tombstones":[{"id":"Yzye5F4WxAWbzxKzI-P4P","worldId":"os-ym7EwunyTMDieuRMb1","entityType":"event","entityId":"Kl17BcEStKYd3-KBQ0odp","version":2,"deviceId":"1_KhZBvxPA38t3eOxlCQy","deletedAt":1793092463773}],"blobs":[{"id":"fmQuVN1CQ3xUHo9UcTLUM","worldId":"os-ym7EwunyTMDieuRMb1","mimeType":"image/png","dataBase64":"","createdAt":1793091980354}]}