2,"version":1},{"notes":"","wordGoal":null,"worldId":"os-ym7EwunyTMDieuRMb1","timelineId":"1Gt0Nmj9fSssszp28yFzc","number":21,"title":"What the Needle Keeps","synopsis":"The Sixtieth Narrowing, the ringing, and what comes back.","id":"NgjN8EsnCtMXQd-Vgxovj","createdAt":1793092138675,"updatedAt":1793092138675,"version":1},{"notes":"","wordGoal":null,"worldId":"os-ym7EwunyTMDieuRMb1","timelineId":"ST4jdjCPlD6GmgCHSK16K","number":7,"title":"The Second Rhythm","synopsis":"Ambrose hears a second rhythm under the Narrowing; Corrigan volunteers for the trial Keeping; Nico's cutters vote.","id":"O72hHHeXdYjEx3dKijViq","createdAt":1793092099575,"updatedAt":1793092099575,"version":1},{"notes":"","wordGoal":null,"worldId":"os-ym7EwunyTMDieuRMb1","timelineId":"1Gt0Nmj9fSssszp28yFzc","number":12,"title":"Ashes in the Gutter","synopsis":"The Lantern burns the Gutter; Hanne dies singing; the Lamplighter takes the Anchor.","id":"OCkVHS8cgCj4fQ8iT1FMm","createdAt":1793092113476,"updatedAt":1793092113476,"version":1},{"notes":"","wordGoal":null,"worldId":"os-ym7EwunyTMDieuRMb1","timelineId":"PnoEuxRs-pnuhq1Nug1vk","number":20,"title":"The Thirtieth Keeping","synopsis":"The battle at the throat, and the broadcast.","id":"R3Yg5r04VaYQh8eqNVw2l","createdAt":1793092135908,"updatedAt":1793092135908,"version":1},{"notes":"","wordGoal":null,"worldId":"os-ym7EwunyTMDieuRMb1","timelineId":"PnoEuxRs-pnuhq1Nug1vk","number":8,"title":"The Blank Year","synopsis":"Adaeze finds the oldest harp records gone and the Founder's Fork out of tune with the Hunger Tone; Juno captures a woman with a list.","id":"R9q7bnyO2byJQKiNOiT0F","createdAt":1793092102342,"updatedAt":1793092102342,"version":1},{"notes":"","wordGoal":null,"worldId":"os-ym7EwunyTMDieuRMb1","timelineId":"PnoEuxRs-pnuhq1Nug1vk","number":14,"title":"True Pitch","synopsis":"Adaeze retunes the harp to the Fork; Juno meets Rhee on Corrie Rock; Mor listens at the door.","id":"TAMq5MS4ViaG-Dt5-v0yk","createdAt":1793092119258,"updatedAt":1793092119258,"version":1},{"notes":"","wordGoal":null,"worldId":"os-ym7EwunyTMDieuRMb1","timelineId":"ST4jdjCPlD6GmgCHSK16K","number":10,"title":"Trial","synopsis":"Corrigan flies the trial Keeping; Hesper calls it a success; the cutters of Shaft Nine down tools.","id":"_YizxoDDs2HC97Smr_hEY","createdAt":1793092107925,"updatedAt":1793092107925,"version":1},{"notes":"","wordGoal":null,"worldId":"os-ym7EwunyTMDieuRMb1","timelineId":"ST4jdjCPlD6GmgCHSK16K","number":4,"title":"The Sounding","synopsis":"Teo flies Ambrose to the mouth to drop his buoy; Hesper proposes the Keeping and offers debt release to any pilot who flies it.","id":"hWwk3SB7ZaGrEanbf4VhQ","createdAt":1793092091192,"updatedAt":1793092091192,"version":1},{"notes":"","wordGoal":null,"worldId":"os-ym7EwunyTMDieuRMb1","timelineId":"1Gt0Nmj9fSssszp28yFzc","number":9,"title":"The Choke","synopsis":"Lucan tunes the harp to the First Warden's Fork and sees what fills the throat.","id":"j1VCRiUth7uIAv2Y6xHkC","createdAt":1793092105108,"updatedAt":1793092105108,"version":1},{"notes":"","wordGoal":null,"worldId":"os-ym7EwunyTMDieuRMb1","timelineId":"PnoEuxRs-pnuhq1Nug1vk","number":17,"title":"The Inheritance","synopsis":"Juno breaks Adaeze out and they steal the Testament; Juno takes the Vigil over to the Shoals.","id":"laUnOS8dX7JALqOvwQKJL","createdAt":1793092127641,"updatedAt":1793092127641,"version":1},{"notes":"","wordGoal":null,"worldId":"os-ym7EwunyTMDieuRMb1","timelineId":"ST4jdjCPlD6GmgCHSK16K","number":1,"title":"Glass Weather","synopsis":"Teo hauls glass to Anchorage as the harp registers the deepest Narrowing on record; Hesper announces the Withdrawal.","id":"nUqlIIeavbsoCrRrvix2r","createdAt":1793091692448,"updatedAt":1793092478387,"version":3},{"notes":"","wordGoal":null,"worldId":"os-ym7EwunyTMDieuRMb1","timelineId":"PnoEuxRs-pnuhq1Nug1vk","number":2,"title":"The Draw","synopsis":"Juno, home from the Severance, watches the Wheel draw her sister Pell as a Keeper of the Thirtieth.","id":"qsn-qoDH4M_GZv5sUT8pl","createdAt":1793092085692,"updatedAt":1793092085692,"version":1},{"notes":"","wordGoal":null,"worldId":"os-ym7EwunyTMDieuRMb1","timelineId":"PnoEuxRs-pnuhq1Nug1vk","number":5,"title":"Substitution","synopsis":"Juno petitions to take Pell's place; Adaeze takes the petition, Mor refuses it, and Rhee Calder sends a question.","id":"t-ohBUTN0lFgXp1RM4jBJ","createdAt":1793092094012,"updatedAt":1793092094012,"version":1}],"events":[{"travelDays":null,"inWorldTime":35,"tension":4,"structureBeat":null,"status":"draft","povCharacterId":"CmFRcUGePy467_xgF7b73","isFlashback":false,"mentionedCharacterIds":[],"threadIds":["1aS0ZiRvPGHGOx-cD4FBf","IAvx2vIwh-tQhQJ3-4jZM"],"motifIds":["PCXJLDRcGRTQ9mrzsfblI"],"worldId":"os-ym7EwunyTMDieuRMb1","chapterId":"4xVn763UvaDHWEeVX7EM_","timelineId":"PnoEuxRs-pnuhq1Nug1vk","title":"The Vote","description":"Efua voted for the war to buy Pell an escort, and Mor gave it: the Vigil. Every Speaker knows about the sleeve. When you decide what to do, don't tell me.","locationMarkerId":"a_61t2JFa2F-The2_g_uL","involvedCharacterIds":["CmFRcUGePy467_xgF7b73","O4qiUlm4ij88IkBV4Edp7"],"involvedItemIds":[],"tags":[],"id":"-WBiz1PuSJ5VBpOzkPGLv","sortOrder":1,"createdAt":1793109506252,"updatedAt":1793109558841,"version":8,"remoteCharacterIds":[]},{"travelDays":null,"inWorldTime":11,"tension":2,"structureBeat":null,"status":"draft","povCharacterId":"ba36zRukMnL6eifQ8p0Lp","isFlashback":false,"mentionedCharacterIds":[],"threadIds":["9yaD7eWlZcvjmZ6iUF8ff","FWVqEenkB0ukMB8QFSCGi"],"motifIds":["uRRXouZ1ANkDsIh6wIm9O"],"worldId":"os-ym7EwunyTMDieuRMb1","chapterId":"hWwk3SB7ZaGrEanbf4VhQ","timelineId":"ST4jdjCPlD6GmgCHSK16K","title":"Charter","description":"Ambrose hires Teo to fly his sounding buoy to the inner markers; he tunes it with his fork, which is engraved for his daughter.","locationMarkerId":"wEhIauUyWZQf-aXny0I-E","involvedCharacterIds":["ba36zRukMnL6eifQ8p0Lp","Nz21WLzsyWyV5l2ZCGeph"],"involvedItemIds":["x9-gr-aVakdNQFpoiBYWA","VuHFhK4GdePcZFl