apLayerId":"u4c1uKlMmJLqAu6qK_jiJ","linkedMapLayerId":"aQ0A77Mgpwgbp4D7DNiVa","name":"Hollin","description":"Cold moon of Caul; salt and glass.","x":373,"y":300,"imageId":null,"iconType":"region","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"5j97fCbsrIagDEkVUQ3WA","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"u4c1uKlMmJLqAu6qK_jiJ","linkedMapLayerId":null,"name":"Caul","description":"The gas giant.","x":800,"y":300,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"6KiI_Wx-p9J2yXaEnGbIL","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"u4c1uKlMmJLqAu6qK_jiJ","linkedMapLayerId":null,"name":"The Ossuary","description":"Where the Returns drift near the Needle's mouth, in the Ebb.","x":800,"y":700,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"9eV93qqQCM2uk0ZKf3Yrp","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"-6NvFuZdMjQhrvRv2S6Zw","linkedMapLayerId":"u4c1uKlMmJLqAu6qK_jiJ","name":"The Reach","description":"The pocket of space beyond the Needle: the Caul system and its outer belts.","x":800,"y":500,"imageId":null,"iconType":"region","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"AMXHwz8WTjPVQ0ebn_jnz","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"cSxWmmJWNPwflvxtpv7c8","linkedMapLayerId":null,"name":"The throat","description":"The passage inside the Needle; its narrowest point is the waist.","x":800,"y":500,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"B0Q0eo2wJFzIX4uiItdY_","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"u4c1uKlMmJLqAu6qK_jiJ","linkedMapLayerId":"N0bRBpZ5MF5Gp1W2oTtUf","name":"The Shoals","description":"The outer belt habitats.","x":1227,"y":700,"imageId":null,"iconType":"region","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"FcWrK3jWThBzOBiUAh7Is","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"u4c1uKlMmJLqAu6qK_jiJ","linkedMapLayerId":"cSxWmmJWNPwflvxtpv7c8","name":"The Needle","description":"The wormhole. Its mouth, its throat, its waist.","x":373,"y":700,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"J3YtvaNwzSnb9yBk9hvCk","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"sOY-l81U0cQfXWNaneveN","linkedMapLayerId":null,"name":"The Director's Gallery","description":"Hesper Vane's office and gallery overlooking the Needle; later the High Warden's sanctum.","x":1227,"y":300,"imageId":null,"iconType":"building","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"JDSS8EP61vc17pfL-LxJh","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"Rw2zIVkEJo5hNxeQmdVZV","linkedMapLayerId":"yaFxTzHlrVdq-6FRcr6e4","name":"Lantern Row","description":"Tallow's street of bars.","x":373,"y":300,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"MdVb_7ATVe7LePJBC7kiu","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"sOY-l81U0cQfXWNaneveN","linkedMapLayerId":null,"name":"The archive","description":"The Wardens' archive of harp records.","x":373,"y":700,"imageId":null,"iconType":"building","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"UDo3_eVXkFkv3ZfXPJwN3","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"aQ0A77Mgpwgbp4D7DNiVa","linkedMapLayerId":null,"name":"The Pans","description":"Salt flats on Hollin's surface; the shuttle field.","x":1120,"y":500,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"VEzFm6Vd4xa8usQDvscpo","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"Rw2zIVkEJo5hNxeQmdVZV","linkedMapLayerId":null,"name":"The Gutter","description":"The outer ring of Tallow in the Ebb, where the bone-pickers live.","x":800,"y":700,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"a_61t2JFa2F-The2_g_uL","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"Rw2zIVkEJo5hNxeQmdVZV","linkedMapLayerId":null,"name":"The Asante apartment","description":"The Speaker's family rooms on the Terrace level of Tallow Under.","x":373,"y":700,"imageId":null,"iconType":"building","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"gVhLzx5G9KN8j1tA7AtC6","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"yaFxTzHlrVdq-6FRcr6e4","linkedMapLayerId":null,"name":"The Lantern","description":"A cutters' bar on Lantern Row.","x":800,"y":500,"imageId":null,"iconType":"building","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"jsm6B8oiY8NGd8rkal637","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"Rw2zIVkEJo5hNxeQmdVZV","linkedMapLayerId":null,"name":"The Assembly Hall","description":"The Concession's meeting hall, later the Compact Hall where the Draw is held and the Tally hangs.","x":1227,"y":300,"imageId":null,"iconType":"building","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"lLG7DbSphyeogIL7MrHEY","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"sOY-l81U0cQfXWNaneveN","linkedMapLayerId":null,"name":"The reliquary","description":"Where the Wardens keep the Founder's Fork.","x":800,"y":700,"imageId":null,"iconType":"building","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"qSb4hNo_UW38V-SyfoaUT","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"N0bRBpZ5MF5Gp1W2oTtUf","linkedMapLayerId":null,"name":"Corrie Rock","description":"A neutral rock in the Shoals where smugglers meet.","x":800,"y":500,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"s60qw9K9PStz9BetwoDJf","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"sOY-l81U0cQfXWNaneveN","linkedMapLayerId":null,"name":"The cells","description":"Security cells, later the Wardens' penitents' cells.","x":1227,"y":700,"imageId":null,"iconType":"building","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"sQ8tFYPS5y_v1AHpDhrQX","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"Rw2zIVkEJo5hNxeQmdVZV","linkedMapLayerId":null,"name":"The Lantern House","description":"The Lamplighter's seat in the Ebb, the old Assembly offices.","x":1227,"y":700,"imageId":null,"iconType":"building","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"tVKCJ1ai6gWC5fjM8MH27","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"Rw2zIVkEJo5hNxeQmdVZV","linkedMapLayerId":null,"name":"Shaft Nine","description":"The deepest glass shaft under Tallow; collapsed in 2286.","x":800,"y":300,"imageId":null,"iconType":"dungeon","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"wEhIauUyWZQf-aXny0I-E","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"sOY-l81U0cQfXWNaneveN","linkedMapLayerId":null,"name":"Dock Four","description":"The tug dock.","x":800,"y":300,"imageId":null,"iconType":"building","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"yBmIaILRNsWH9U1mYNeIi","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"sOY-l81U0cQfXWNaneveN","linkedMapLayerId":null,"name":"The Lectern","description":"The observatory where the harp is played; later the harp hall.","x":373,"y":300,"imageId":null,"iconType":"building","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"yzNJN6I3_rYoPRExNhLsL","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"u4c1uKlMmJLqAu6qK_jiJ","linkedMapLayerId":"sOY-l81U0cQfXWNaneveN","name":"Anchorage Station","description":"The station at the Needle's mouth. Anchorage (Concession), the Anchorhold (Compact), the Anchor (Ebb).","x":1227,"y":300,"imageId":null,"iconType":"building","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354},{"id":"zTSteWgsbyCxc5CAvjjKo","worldId":"os-ym7EwunyTMDieuRMb1","mapLayerId":"aQ0A77Mgpwgbp4D7DNiVa","linkedMapLayerId":"Rw2zIVkEJo5hNxeQmdVZV","name":"Tallow","description":"The first and largest town on Hollin, dug down into the salt. Tallow Under, in the Compact; a half-ruin held by the Lantern in the Ebb.","x":480,"y":500,"imageId":null,"iconType":"city","tags":[],"factionId":null,"createdAt":1793091980354,"updatedAt":1793091980354}],"characters":[{"id":"1T_DkkgweUgLcgjCDCHxK","worldId":"os-ym7EwunyTMDieuRMb1","name":"Cassius Mor","aliases":["High Warden Mor","the High Warden","Mor"],"description":"2608. High Warden of the Throat, head of the Wardens. 66, warm-voiced, patient, sure that a civilisation is the story it tells about what happens if it stops.","portraitImageId":null,"tags":["antagonist","era: Severance"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"7CCjF87NKJxKnOis6e2Xk","worldId":"os-ym7EwunyTMDieuRMb1","name":"Hanne Venn","aliases":["Hanne","Old Hanne","Gran"],"description":"2937. Isra's grandmother, seventies, a teller: she keeps the old songs and stories of the Reach, half of them wrong and all of them sung.","portraitImageId":null,"tags":["era: Ebb"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"81SRo00zNHz6PqTg4HXZo","worldId":"os-ym7EwunyTMDieuRMb1","name":"Mercy Oduya","aliases":["the Lamplighter","Lamplighter"],"description":"2937. Prophet-warlord of Tallow, head of the Lantern. Fifty, sincere, magnetic; lost her son to the Fifty-Ninth Keeping and means to save the Needle with a Great Keeping.","portraitImageId":null,"tags":["antagonist","era: Ebb"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793092698635,"nameChanges":[],"aliasesFrom":[],"birthDate":null,"version":3},{"id":"CmFRcUGePy467_xgF7b73","worldId":"os-ym7EwunyTMDieuRMb1","name":"Juno Asante","aliases":["Juno","Commander Asante","the Commander"],"description":"2608. Lieutenant Commander in the Compact Navy, captain of the corvette Vigil. 31, dutiful, clipped, very good at her job, and the older sister of a girl the Draw has just taken.","portraitImageId":null,"tags":["protagonist","era: Severance","POV"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"EE3FRzLQX__ITjkUC5hNQ","worldId":"os-ym7EwunyTMDieuRMb1","name":"Mara Teague","aliases":["Teague"],"description":"2608. A former lay clerk of the Draw, defected to the Shoals; captured by the Vigil carrying a list.","portraitImageId":null,"tags":["era: Severance"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"FHVE6_Moqmpo7CWv0OAjG","worldId":"os-ym7EwunyTMDieuRMb1","name":"Lulu Dace","aliases":["Lulu"],"description":"2291. Corrigan's daughter, nine. Collects bolts and swears like a pilot.","portraitImageId":null,"tags":["era: Concession"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"JjF9d3F2fSnxSDTqCtebJ","worldId":"os-ym7EwunyTMDieuRMb1","name":"Ostap Pike","aliases":["Pike"],"description":"2937. Isra's crewmate on the Gristle. Forties, huge, quiet, coughing out his lungs from glass-dust. Once a Lantern man.","portraitImageId":null,"tags":["era: Ebb"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"KTf_JCAKUMQ3GKu2kixRa","worldId":"os-ym7EwunyTMDieuRMb1","name":"Bettany Shore","aliases":["Bettany"],"description":"2291. Junior throat-reader at the Lectern, Ambrose's assistant. Twenty-two, ambitious, frightened.","portraitImageId":null,"tags":["era: Concession"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"L-imTuCYhT3JgMhau4AL8","worldId":"os-ym7EwunyTMDieuRMb1","name":"Tobiah Greaves","aliases":["Admiral Greaves","Greaves"],"description":"2608. Admiral of the Compact Navy's Home Squadron, Juno's commander. A hawk who has been winning the wrong war for six years.","portraitImageId":null,"tags":["era: Severance"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"M1JAnaMBtxnLCSlQrX2Uy","worldId":"os-ym7EwunyTMDieuRMb1","name":"Benedek Saar","aliases":["Prior Saar","the Prior","Saar"],"description":"2937. Prior of the Wardens at the Anchor, old and tired, keeping a dozen monks alive by keeping on the right side of whoever holds Tallow.","portraitImageId":null,"tags":["era: Ebb"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"Nz21WLzsyWyV5l2ZCGeph","worldId":"os-ym7EwunyTMDieuRMb1","name":"Ambrose Lyle","aliases":["Ambrose","Lyle"],"description":"2291. Senior Throat-Reader at the Lectern on Anchorage Station; builder and player of the harp that listens to the Needle. 58, gentle, compromised, homesick for a daughter he has not seen in twenty years. Tunes his harp with a brass fork engraved for her.","portraitImageId":null,"tags":["era: Concession","POV"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"O0BknF0iBzgno9ADNBTWm","worldId":"os-ym7EwunyTMDieuRMb1","name":"Deacon Rusk","aliases":["Rusk"],"description":"2937. The Lamplighter's enforcer, captain of her Lantern men. Thin, polite, enjoys his work.","portraitImageId":null,"tags":["era: Ebb"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"O4qiUlm4ij88IkBV4Edp7","worldId":"os-ym7EwunyTMDieuRMb1","name":"Efua Asante","aliases":["Speaker Asante","Efua","the Speaker"],"description":"2608. Speaker of the Compact Assembly, mother of Juno and Pell. Leads the faction that wants peace with the Shoals.","portraitImageId":null,"tags":["era: Severance"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"Q_bPbcsNtraUTJg8xxckn","worldId":"os-ym7EwunyTMDieuRMb1","name":"Salome Okafor","aliases":["Mother Salome","Salome"],"description":"2291. The shaft chaplain of Tallow, sixty-odd, ordained by nobody. Keeps the Tally, the steel plate on which Shaft Nine's dead are scratched.","portraitImageId":null,"tags":["era: Concession"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"TC-L5WFMaTQ21rKCAn0bz","worldId":"os-ym7EwunyTMDieuRMb1","name":"Adaeze Quill","aliases":["Adaeze","Warden Quill","Sister Quill"],"description":"2608. Warden-archivist of the Anchorhold, keeper of the reliquary and a trained throat-reader. 44, exact, devout, kind; the kind of believer who checks.","portraitImageId":null,"tags":["era: Severance","POV"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"X6xy9-8XqigaVlg_V-Pe5","worldId":"os-ym7EwunyTMDieuRMb1","name":"Corrigan Dace","aliases":["Corrigan","Dace","Corr"],"description":"2291. Tug pilot of the Brannock, Teo's old lover and oldest friend. 40, tired, charming, deep in debt, father of nine-year-old Lulu.","portraitImageId":null,"tags":["era: Concession"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"aerWNgb1iDGcDjVj6rA85","worldId":"os-ym7EwunyTMDieuRMb1","name":"Nan Hollis","aliases":["Chief Hollis","Hollis"],"description":"2608. Chief engineer of the Vigil, fifty, has kept the ship alive through six years of war and expects no thanks.","portraitImageId":null,"tags":["era: Severance"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"ba36zRukMnL6eifQ8p0Lp","worldId":"os-ym7EwunyTMDieuRMb1","name":"Teo Kesh","aliases":["Teodora Kesh","Teodora","Teo"],"description":"2291. Debt-bound tug pilot of the Small Mercy, hauling brine-glass from Hollin to Anchorage. Owes the Concern 41,212 marks she inherited from her parents. Wry, profane, guarded, fiercely loyal to her brother. Wears a glass bead Nico cut from his first seam.","portraitImageId":null,"tags":["protagonist","era: Concession","POV"],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1793091747832,"updatedAt":1793091886769},{"id":"cTQk2fuL3YmSOlYDRwOM2","worldId":"os-ym7EwunyTMDieuRMb1","name":"Ezra Lind","aliases":["Ezra"],"description":"2608. A Keeper drawn alongside Pell; a dock clerk from the Shoals side of Tallow, frightened and funny.","portraitImageId":null,"tags":["era: Severance"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"cxOiILo2zDng_KzycPfs7","worldId":"os-ym7EwunyTMDieuRMb1","name":"Nico Kesh","aliases":["Nico"],"description":"2291. Teo's younger brother, 26, a glass-cutter in Shaft Nine and an organiser of the Cutters' Union. Reckless, idealistic, funny, sure the shaft can be made to stand together.","portraitImageId":null,"tags":["era: Concession"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"eZ6bZoVov0ITLh7fBrY_0","worldId":"os-ym7EwunyTMDieuRMb1","name":"Isra Venn","aliases":["Isra"],"description":"2937. Bone-picker: pilots the salvage skiff Gristle in the Ossuary, stripping the Returns. 24, hard, sardonic, believes in nothing she cannot sell.","portraitImageId":null,"tags":["protagonist","era: Ebb","POV"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"gILzK7IqKsFnAE2B2bpSU","worldId":"os-ym7EwunyTMDieuRMb1","name":"Okoro Brandt","aliases":["Marshal Brandt","Brandt"],"description":"2291. Marshal of Concern Security on the Reach. Large, patient, does what he is told and sleeps well.","portraitImageId":null,"tags":["era: Concession"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"jQh02sqZC0EexaeYnfMAV","worldId":"os-ym7EwunyTMDieuRMb1","name":"Danny Marsh","aliases":["Marsh","Sub-Lieutenant Marsh"],"description":"2608. Juno's executive officer on the Vigil. Young, loyal, a good shot and a bad liar.","portraitImageId":null,"tags":["era: Severance"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"kKPEd-csxdzTE5plAVRqJ","worldId":"os-ym7EwunyTMDieuRMb1","name":"Hesper Vane","aliases":["Director Vane","the Director","Hesper"],"description":"2291. Director of the Ostrander Concern's Reach Concession. 47, precise, unhurried, a believer in order and numbers who never raises her voice. Architect of the Keeping.","portraitImageId":null,"tags":["antagonist","era: Concession"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"lXowrO8WucvQ-z-5V8Y1Z","worldId":"os-ym7EwunyTMDieuRMb1","name":"Lucan Aske","aliases":["Brother Lucan","Lucan"],"description":"2937. A Warden of the Throat at the Anchor, 29, the last who can properly play the old harp. Doubting, careful, funny when he forgets to be holy.","portraitImageId":null,"tags":["era: Ebb","POV"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"q5e2z38Tumh-e8RRj3Spg","worldId":"os-ym7EwunyTMDieuRMb1","name":"Rhee Calder","aliases":["Rhee","Calder","the Saltjack"],"description":"2608. Commander of the Shoals Free League fleet, once Juno's classmate at the Academy. Defected after the Twenty-Ninth Draw took his brother.","portraitImageId":null,"tags":["era: Severance"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"tyoW9Qq3ek3ziKFpVJLY-","worldId":"os-ym7EwunyTMDieuRMb1","name":"Tobin Oduya","aliases":["Tobin"],"description":"2937. The Lamplighter's son, who flew in the Fifty-Ninth Keeping eleven years ago, at seventeen.","portraitImageId":null,"tags":["era: Ebb"],"isAlive":false,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769},{"id":"zO_Df258F-V33Vsnq0pOr","worldId":"os-ym7EwunyTMDieuRMb1","name":"Pell Asante","aliases":["Pell"],"description":"2608. Juno's younger sister, 19, a painter and a believer. Drawn as a Keeper for the Thirtieth Keeping, and glad of it.","portraitImageId":null,"tags":["era: Severance","POV"],"isAlive":true,"color":null,"createdAt":1793091886769,"updatedAt":1793091886769}],"items":[{"id":"2vMXUX95ZfEKZDSeE_qQA","worldId":"os-ym7EwunyTMDieuRMb1","name":"Small Mercy","description":"Teo Kesh's ore-tug: forty years old, re-hulled twice, a cockpit that smells of coolant and oranges. Her mother's ship before her.","iconType":"other","imageId":null,"tags":["ship","anchor"]},{"id":"3y9jMs2EtdPdRtHIybMZw","worldId":"os-ym7EwunyTMDieuRMb1","name":"The data spool","description":"A pilot's data spool onto which Ambrose copied his proof of the Narrowing's natural cycle, his model of the scar, and the Vane Memorandum.","iconType":"scroll","imageId":null,"tags":["evidence"]},{"id":"4W7H7AXZt69yA9Bm8xOyk","worldId":"os-ym7EwunyTMDieuRMb1","name":"The harp","description":"The throat-reading instrument in the Lectern: a frame of tensioned resonator strings that sing to the Needle's noise. Ambrose built it; every throat-reader after him plays it.","iconType":"artifact","imageId":null,"tags":["anchor","all eras"]},{"id":"4fwj7I9kcrMuNJAYIjRdp","worldId":"os-ym7EwunyTMDieuRMb1","name":"Keeper's bead","description":"A bead of brine-glass given to each Keeper on the night of the Keeping, worn at the throat. There is more than one of these.","iconType":"ring","imageId":null,"tags":[],"isCollective":true,"staysInEra":true,"version":2},{"id":"4tuVyVbUgsAvFy11vOXfC","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Wheel","description":"The brass lottery drum of the Draw in the Compact Hall, from which the nine Keepers' names are drawn.","iconType":"artifact","imageId":null,"tags":["Draw"]},{"id":"584MtYlYrST-nab00kPVX","worldId":"os-ym7EwunyTMDieuRMb1","name":"Teague's list","description":"A list of names, smuggled out of the Draw office by Mara Teague, of those 'chosen' rather than drawn in past Draws.","iconType":"scroll","imageId":null,"tags":["evidence"]},{"id":"A3vCL9baC07vx-A_EYV4F","worldId":"os-ym7EwunyTMDieuRMb1","name":"Teo's bead","description":"A bead of brine-glass Nico cut from his first seam and gave his sister; it leans, faintly, toward the Needle.","iconType":"ring","imageId":null,"tags":["anchor"]},{"id":"B4t1HEXnUvBQn1MghsbB_","worldId":"os-ym7EwunyTMDieuRMb1","name":"Hanne's cittern","description":"Hanne Venn's old stringed instrument, older than she is, on which she plays the songs she keeps.","iconType":"other","imageId":null,"tags":[]},{"id":"Rj2tlah-Ghxl6AzEVjcWW","worldId":"os-ym7EwunyTMDieuRMb1","name":"Vigil","description":"Juno Asante's corvette, Compact Navy: fast, under-gunned, patched after six years of the Severance.","iconType":"other","imageId":null,"tags":["ship"]},{"id":"TyNpZHsJwsL4j2n11haj_","worldId":"os-ym7EwunyTMDieuRMb1","name":"Brannock","description":"Corrigan Dace's tug, older and uglier than the Small Mercy.","iconType":"other","imageId":null,"tags":["ship"]},{"id":"VXkoGStgTMltWb0UEhiiy","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Testament","description":"The Inheritance: the First Warden's sealed testament, read by each High Warden at investiture and by no one else.","iconType":"book","imageId":null,"tags":["evidence"]},{"id":"VnFJPei2IKN7rU5EajRdZ","worldId":"os-ym7EwunyTMDieuRMb1","name":"Gristle","description":"Isra Venn's salvage skiff: a Shoals-built cutter with a grapple arm, a cracked canopy and a heater that works when kicked.","iconType":"other","imageId":null,"tags":["ship"]},{"id":"VuHFhK4GdePcZFlHW2Gc2","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Fork","description":"Ambrose Lyle's brass tuning fork, engraved 'A.L. — for Clare', the standard his harp is tuned to. Later the Wardens' relic, the Founder's Fork, its worn engraving read as 'For Clarity'.","iconType":"artifact","imageId":null,"tags":["anchor","all eras"]},{"id":"k_PyDBTlr9DQL7KZmc8hw","worldId":"os-ym7EwunyTMDieuRMb1","name":"Debt chit","description":"Teo's ledger chit, the running sum she owes the Concern, clipped to the Small Mercy's console.","iconType":"scroll","imageId":null,"tags":[]},{"id":"ml_otw6g_nyvSGFk-YwIU","worldId":"os-ym7EwunyTMDieuRMb1","name":"The glass shard","description":"A shard of throat-grown glass Isra pocketed from a Return before the Lantern could take it; it hums against harp wire.","iconType":"other","imageId":null,"tags":[]},{"id":"skf1mYY9CpseoDnzIjuqT","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Vane Memorandum","description":"Hesper Vane's memorandum to the Ostrander Board proposing the Keeping as an instrument of governance for the Reach after the Withdrawal.","iconType":"scroll","imageId":null,"tags":["evidence"]},{"id":"w0WglDWRgFI1LeXJt6ABg","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Tally","description":"A plate of steel cut from a Shaft Nine support beam after the collapse of 2286, on which the shaft's dead are scratched. In 2608 it hangs in the Compact Hall as the Founders' Tally.","iconType":"artifact","imageId":null,"tags":["anchor"]},{"id":"x9-gr-aVakdNQFpoiBYWA","worldId":"os-ym7EwunyTMDieuRMb1","name":"The sounding buoy","description":"The resonance buoy Ambrose built and Teo dropped at the Needle's mouth in 2291 to listen to the throat. Its tuning cradle was made to take his fork. By 2937 the Wardens call the dead thing the Bell.","iconType":"artifact","imageId":null,"tags":["anchor"]}],"characterSnapshots":[{"worldId":"os-ym7EwunyTMDieuRMb1","characterId":"aerWNgb1iDGcDjVj6rA85","eventId":"l5EdzGomnoXnybSEiNrWy","currentLocationMarkerId":"yzNJN6I3_rYoPRExNhLsL","currentMapLayerId":"u4c1uKlMmJLqAu6qK_jiJ","id":"0d34YXr3p_RPGsG_6bsMJ","sortKey":10.999998,"createdAt":1793109508038,"updatedAt":1793109508038,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","characterId":"CmFRcUGePy467_xgF7b73","eventId":"6eoYk6Q04qKDdt7k9x4Sr","currentLocationMarkerId":"MdVb_7ATVe7LePJBC7kiu","currentMapLayerId":"sOY-l81U0cQfXWNaneveN","id":"0nb-3johTxtqk9qvVNK2-","sortKey":4.999998,"createdAt":1793093539842,"updatedAt":1793093539842,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","characterId":"cxOiILo2zDng_KzycPfs7","eventId":"x2zsF_8HSdHArtZKgYGYk","currentLocationMarkerId":"tVKCJ1ai6gWC5fjM8MH27","currentMapLayerId":"Rw2zIVkEJo5hNxeQmdVZV","id":"2NQ8aemxAEYsZcVaZ33Nl","sortKey":10.000001,"createdAt":1793109318333,"updatedAt":1793109318333,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","characterId":"eZ6bZoVov0ITLh7fBrY_0","eventId":"y0MYjP_qx3qpkSC3kc-xf","currentLocationMarkerId":"6KiI_Wx-p9J2yXaEnGbIL","currentMapLayerId":"u4c1uKlMmJLqAu6qK_jiJ","id":"2SKJ_EcuVy1VCCDp3p-SR","sortKey":2.999999,"createdAt":1793093147537,"updatedAt":1793093147537,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","characterId":"jQh02sqZC0EexaeYnfMAV","eventId":"aBdlcGQrMOBsNYer8rVoH","currentLocationMarkerId":"B0Q0eo2wJFzIX4uiItdY_","currentMapLayerId":"u4c1uKlMmJLqAu6qK_jiJ","id":"3f26wnfV8qOOf5dx6cxEc","sortKey":8,"createdAt":1793108948104,"updatedAt":1793108948104,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","characterId":"7CCjF87NKJxKnOis6e2Xk","eventId":"ML9Npe3xZ6wpAxEVO7kvG","currentLocationMarkerId":"VEzFm6Vd4xa8usQDvscpo","currentMapLayerId":"Rw2zIVkEJo5hNxeQmdVZV","id":"3lzcAN8Nx4U_ONvwxbmy5","sortKey":6.000001,"createdAt":1793093823721,"updatedAt":1793093823721,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","characterId":"FHVE6_Moqmpo7CWv0OAjG","eventId":"ifku_JzAmcnMrrHn5FNm6","currentLocationMarkerId":"gVhLzx5G9KN8j1tA7AtC6","currentMapLayerId":"yaFxTzHlrVdq-6FRcr6e4","id":"3sRnailN8duI3LfzbTE0V","sortKey":1,"createdAt":1793092539519,"updatedAt":1793092539519,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","characterId":"Q_bPbcsNtraUTJg8xxckn","eventId":"BGuMiCoqSHask6lx4yaIC","currentLocationMarkerId":"tVKCJ1ai6gWC5fjM8MH27","currentMapLayerId":"Rw2zIVkEJo5hNxeQmdVZV","id":"4E9spPR5CRLfh4VMkbQmy","sortKey":6.999998,"createdAt":1793108785537,"updatedAt":1793108785537,"version":1},{"worldId":"os-ym7EwunyTMDieuRMb1","characterId":"gILzK7IqKsFnAE2B2bpSU","eventId":"x2zsF_8HSdHArtZKgYGYk","currentLocationMarkerId":"tVKCJ1ai6gWC5fjM8MH27","currentMapLayerId":"Rw2zIVkEJo5hNxeQmdVZV","id":"4RDPl8yfC9m9yKv-c5XH0","sortKey":10.000001,"createdAt":1793109318644,"updatedAt":1793109318644,"versi