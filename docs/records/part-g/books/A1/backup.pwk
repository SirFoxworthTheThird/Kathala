{"version":19,"type":"full","exportedAt":1793109714792,"world":{"id":"os-ym7EwunyTMDieuRMb1","name":"What the Needle Keeps","description":"A gritty space opera in three eras. Every four thousand days the Needle — the only road out of the Reach — narrows, and the Reach feeds it. 2291, 2608, 2937: three Long Nights, three generations, one lie.","coverImageId":null,"theme":"theme-dystopian","continuityStaleThreshold":5,"calendar":{"week":{"days":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"first":3},"leap":{"month":1,"days":1,"every":4,"skip":100,"keep":400},"startYear":2291,"yearSuffix":"","months":[{"name":"January","days":31},{"name":"February","days":28},{"name":"March","days":31},{"name":"April","days":30},{"name":"May","days":31},{"name":"June","days":30},{"name":"July","days":31},{"name":"August","days":31},{"name":"September","days":30},{"name":"October","days":31},{"name":"November","days":30},{"name":"December","days":31}]},"pinsSetClock":true,"createdAt":1793091685919,"updatedAt":1793091841550,"wordTarget":85000},"mapLayers":[{"id":"-6NvFuZdMjQhrvRv2S6Zw","worldId":"os-ym7EwunyTMDieuRMb1","parentMapId":null,"name":"Locations","description":"","imageId":"fmQuVN1CQ3xUHo9UcTLUM","imageWidth":1600,"imageHeight":1000,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":"","createdAt":1793091980354,"updatedAt":1793091980354},{"id":"N0bRBpZ5MF5Gp1W2oTtUf","worldId":"os-ym7EwunyTMDieuRMb1","parentMapId":"u4c1uKlMmJLqAu6qK_jiJ","name":"The Shoals","description":"","imageId":"fmQuVN1CQ3xUHo9UcTLUM","imageWidth":1600,"imageHeight":1000,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":"","createdAt":1793091980354,"updatedAt":1793091980354},{"id":"Rw2zIVkEJo5hNxeQmdVZV","worldId":"os-ym7EwunyTMDieuRMb1","parentMapId":"aQ0A77Mgpwgbp4D7DNiVa","name":"Tallow","description":"","imageId":"fmQuVN1CQ3xUHo9UcTLUM","imageWidth":1600,"imageHeight":1000,"scalePixelsPerUnit":