eCharacterIds":[]},{"travelDays":null,"inWorldTime":0,"tension":2,"structureBeat":null,"status":"draft","povCharacterId":"eZ6bZoVov0ITLh7fBrY_0","isFlashback":false,"mentionedCharacterIds":[],"threadIds":["G2vQKK6meEnzZ9EFXlOcw","_K3aJb1aHDBGtrGLmSbYZ"],"motifIds":["gQ_6swqJ5lW3yGhmN9POY","E7dpHAGomtgYlj_PdF-Qi"],"worldId":"os-ym7EwunyTMDieuRMb1","chapterId":"1AhhzG9fCkuf6BN0xYroV","timelineId":"1Gt0Nmj9fSssszp28yFzc","title":"The Ossuary","description":"Isra and Pike cut a Keeper's skiff in the Ossuary; its glass grows backwards, layered like a cliff, as if the ship were pushed.","locationMarkerId":"6KiI_Wx-p9J2yXaEnGbIL","involvedCharacterIds":["eZ6bZoVov0ITLh7fBrY_0","JjF9d3F2fSnxSDTqCtebJ"],"involvedItemIds":["VnFJPei2IKN7rU5EajRdZ"],"tags":[],"id":"y0MYjP_qx3qpkSC3kc-xf","sortOrder":-1,"createdAt":1793093147177,"updatedAt":1793093171704,"version":9,"remoteCharacterIds":[]}],"travelModes":[],"timelineRelationships":[],"crossTimelineArtifacts":[],"mapRoutes":[],"mapRegions":[],"mapRegionSnapshots":[],"mapAnnotations":[],"loreCategories":[{"id":"0Uk-OSuMhE5rgyQRPaoSF","worldId":"os-ym7EwunyTMDieuRMb1","name":"History","color":null,"sortOrder":1},{"id":"9ajUep5tixbCCqoLKNwg5","worldId":"os-ym7EwunyTMDieuRMb1","name":"Geography","color":null,"sortOrder":3},{"id":"CtjN2fwuM_NriXSTci2q4","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Needle","color":null,"sortOrder":0},{"id":"bkM2s8jVrPJag14GpASOb","worldId":"os-ym7EwunyTMDieuRMb1","name":"Religion","color":null,"sortOrder":2}],"lorePages":[{"id":"33XiB_VAfqsEqyUTvK6G1","worldId":"os-ym7EwunyTMDieuRMb1","categoryId":"9ajUep5tixbCCqoLKNwg5","title":"Hollin","body":"A cold moon of the gas giant Caul: ice over salt over glass. Its towns are dug down into the salt — Tallow first and largest — and lit by Caul-light when Caul is up.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793091986015,"updatedAt":1793091986015},{"id":"50qSvzPlYJD3uB9cVyFom","worldId":"os-ym7EwunyTMDieuRMb1","categoryId":"bkM2s8jVrPJag14GpASOb","title":"The Wardens of the Throat","body":"The order that reads the Needle and keeps the Keeping, founded by the **First Warden** after the first Keeping. Their motto, from the Founder's Fork: *For Clarity*. They tune the harp to the **Hunger Tone**, sung at investiture.","tags":["order"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793091986015,"updatedAt":1793091986015},{"id":"QaqSPYA3-6UaCGUfeNRvV","worldId":"os-ym7EwunyTMDieuRMb1","categoryId":"CtjN2fwuM_NriXSTci2q4","title":"Brine-glass","body":"An exotic-matter crystal grown in Hollin's deep salt beds: negative energy density, the most valuable substance known, and the reason anyone lives in the Reach. Cutting it is slow and it bursts without warning. Cutters breathe the dust and get **glass-lung**.","tags":["physics","economy"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793091986015,"updatedAt":1793091986015},{"id":"XZP2_IY-Qeob0OTFFW01Q","worldId":"os-ym7EwunyTMDieuRMb1","categoryId":"bkM2s8jVrPJag14GpASOb","title":"The Liturgy of the Long Night","body":"*The First Warden heard the Needle's hunger, and the Reach answered.*\n*We feed the door that it may stay a door.*\n*What the Needle keeps, it keeps for us.*","tags":["rite"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793091986015,"updatedAt":1793091986015},{"id":"ZVToOUiWwYBA0cDaLKcYR","worldId":"os-ym7EwunyTMDieuRMb1","categoryId":"0Uk-OSuMhE5rgyQRPaoSF","title":"The Quiet","body":"The long collapse after the Severance, in which the Compact ended and nearly every record older than it was lost. The Wardens' books at the Anchor begin in 2741. What happened before is liturgy, songs, and arguments.","tags":["Ebb"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793091986015,"updatedAt":1793091986015},{"id":"ayWjGVuASbAJpNkiwiXaX","worldId":"os-ym7EwunyTMDieuRMb1","categoryId":"CtjN2fwuM_NriXSTci2q4","title":"The Needle","body":"A natural traversable wormhole in the Caul system, found in 2240. Its Reach-side mouth hangs some two million kilometres from Hollin; its far mouth opens on the Inward, near Port Ardent. A transit takes about nine hours through the **throat**, whose geometry shifts and must be read as it is flown: a throat-reader listens, a pilot steers.\n\nIt is the only road between the Reach and the rest of humanity.","tags":["physics"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793091986015,"updatedAt":1793091986015},{"id":"erAxX-UaM9IN8KwCm_9uT","worldId":"os-ym7EwunyTMDieuRMb1","categoryId":"0Uk-OSuMhE5rgyQRPaoSF","title":"The Severance","body":"The war between the Compact of the Reach and the Shoals Free League, which began in 2602 when the Shoals refused their Draw quota.","tags":["Severance"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793091986015,"updatedAt":1793091986015},{"id":"h812OXTf-5kykM6xjWUVg","worldId":"os-ym7EwunyTMDieuRMb1","categoryId":"CtjN2fwuM_NriXSTci2q4","title":"The harp and the Lectern","body":"The **harp** is the instrument that reads the throat: a frame of resonator strings under tension in the **Lectern**, the observatory at the Needle-ward end of the station. The throat's gravitational noise makes the strings sing; a reader listens and charts. It must be tuned to a standard. Ambrose Lyle built it and tuned it to his fork.","tags":["technology"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793091986015,"updatedAt":1793091986015},{"id":"hUUPrJDEDeNnR1VIk_kjX","worldId":"os-ym7EwunyTMDieuRMb1","categoryId":"CtjN2fwuM_NriXSTci2q4","title":"The Narrowing","body":"Every four thousand days — a little under eleven years — the throat tightens. For thirty to forty hours it is impassable: the **Long Night**. Most Narrowings are shallow. Some are deep.\n\nThe Narrowing of 1 May 2291 was the deepest ever recorded at the time.","tags":["physics"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793091986015,"updatedAt":1793091986015},{"id":"k8b0qkJQa8wlPcOd9nIUW","worldId":"os-ym7EwunyTMDieuRMb1","categoryId":"0Uk-OSuMhE5rgyQRPaoSF","title":"The Ebb","body":"Since the Fifty-Eighth Narrowing the Needle has not opened fully; since the Fifty-Ninth no ship has crossed. And it has begun to give back what was put into it — **Returns**: old ships, coated in glass, drifting out of the mouth into the Ossuary.","tags":["Ebb"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793091986015,"updatedAt":1793091986015},{"id":"oRNgMlTsTPoNiwZU3zQvP","worldId":"os-ym7EwunyTMDieuRMb1","categoryId":"0Uk-OSuMhE5rgyQRPaoSF","title":"The Keeping","body":"At each Narrowing, crewed ships fly brine-glass into the throat's waist and release it there, to **feed the Needle** so that it reopens. Those who fly are **Keepers**. The first Keeping was flown in 2291.","tags":["rite"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793091986015,"updatedAt":1793091986015},{"id":"vfktAA4-76uxfygXvkouA","worldId":"os-ym7EwunyTMDieuRMb1","categoryId":"0Uk-OSuMhE5rgyQRPaoSF","title":"The Ostrander Concession","body":"The Ostrander Concern held the Reach as a mining concession from 2241: towns dug into Hollin's salt, debt-labour shipped out through the Needle, brine-glass shipped back. In 2291 the Board let the Charter lapse and recalled its staff — **the Withdrawal**. The last ship was the *Ostrander Providence*.","tags":["Concession"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793091986015,"updatedAt":1793091986015},{"id":"wWCNDnPj5CCQpeNq54P5l","worldId":"os-ym7EwunyTMDieuRMb1","categoryId":"0Uk-OSuMhE5rgyQRPaoSF","title":"The Draw","body":"In the Compact, the nine Keepers of each Keeping are chosen by lot from all citizens between eighteen and forty: names drawn from the brass Wheel in the Compact Hall, sixty days before the Narrowing. A volunteer may be substituted with the High Warden's leave. It is called the Compact's one perfectly fair institution.","tags":["rite","Severance"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793091986015,"updatedAt":1793091986015}],"factions":[{"id":"2xgqCKzE3VPTV4sIcgGWD","worldId":"os-ym7EwunyTMDieuRMb1","name":"Cutters' Union","description":"The glass-cutters of Shaft Nine and the other Tallow shafts, organising against the Concession.","color":"#f97316","coverImageId":null,"tags":["Concession"],"createdAt":1793091991692,"updatedAt":1793091991692},{"id":"56KYyfh-jyKWK3fbjZWPh","worldId":"os-ym7EwunyTMDieuRMb1","name":"Compact of the Reach","description":"The Reach's government after the Concession, seated in the Assembly at Tallow Under.","color":"#22c55e","coverImageId":null,"tags":["Severance"],"createdAt":1793091991692,"updatedAt":1793091991692},{"id":"6gdS8EoD_79pqWUmH_FON","worldId":"os-ym7EwunyTMDieuRMb1","name":"Wardens of the Throat","description":"The order that reads the Needle and keeps the Keeping. At the Anchorhold in 2608; at the Anchor, diminished, in 2937.","color":"#3b82f6","coverImageId":null,"tags":["Severance","Ebb"],"createdAt":1793091991692,"updatedAt":1793091991692},{"id":"CtikfV1SdQDweEp0Gv1Xt","worldId":"os-ym7EwunyTMDieuRMb1","name":"Keepers of the Thirtieth","description":"The nine drawn for the Thirtieth Keeping.","color":"#ec4899","coverImageId":null,"tags":["Severance"],"createdAt":1793091991692,"updatedAt":1793091991692},{"id":"GgtSx3VPaKojkxWprtRj3","worldId":"os-ym7EwunyTMDieuRMb1","name":"Contract Pilots","description":"The debt-bound tug pilots who haul glass from Hollin to Anchorage.","color":"#eab308","coverImageId":null,"tags":["Concession"],"createdAt":1793091991692,"updatedAt":1793091991692},{"id":"Ps94-pJSCfF8v0dBpDV6P","worldId":"os-ym7EwunyTMDieuRMb1","name":"Bone-pickers","description":"The salvagers who strip the Returns in the Ossuary.","color":"#a16207","coverImageId":null,"tags":["Ebb"],"createdAt":1793091991692,"updatedAt":1793091991692},{"id":"RDos_kLTbvc3Uu5fvSUzL","worldId":"os-ym7EwunyTMDieuRMb1","name":"Compact Navy","description":"The Compact's fleet, six years into the Severance.","color":"#14b8a6","coverImageId":null,"tags":["Severance"],"createdAt":1793091991692,"updatedAt":1793091991692},{"id":"aEnF3hOq268c3hy5gB9ly","worldId":"os-ym7EwunyTMDieuRMb1","name":"Shoals Free League","description":"The outer habitats in revolt against the Draw.","color":"#8b5cf6","coverImageId":null,"tags":["Severance"],"createdAt":1793091991692,"updatedAt":1793091991692},{"id":"vz7sUfy8RvU-xwyxk4BhB","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Lantern","description":"The Lamplighter's militia and congregation, who hold Tallow and preach the Great Keeping.","color":"#64748b","coverImageId":null,"tags":["Ebb"],"createdAt":1793091991692,"updatedAt":1793091991692},{"id":"y6C9-EqExNyuwD7c_mI0B","worldId":"os-ym7EwunyTMDieuRMb1","name":"Ostrander Concern","description":"The company that held the Reach as a mining concession until the Withdrawal of 2291.","color":"#ef4444","coverImageId":null,"tags":["Concession"],"createdAt":1793091991692,"updatedAt":1793091991692}],"factionMemberships":[{"id":"2GsdLVez8rrEvVxl9di_E","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"aEnF3hOq268c3hy5gB9ly","characterId":"EE3FRzLQX__ITjkUC5hNQ","role":"Defector","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"5eFhsA8Hg6c7BpwmgZZ1O","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"Ps94-pJSCfF8v0dBpDV6P","characterId":"eZ6bZoVov0ITLh7fBrY_0","role":null,"startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"6xJIO5X0CpSg6RVS28k8O","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"6gdS8EoD_79pqWUmH_FON","characterId":"1T_DkkgweUgLcgjCDCHxK","role":"High Warden","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"8a1hzLBeAIHZLf26KpYLO","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"y6C9-EqExNyuwD7c_mI0B","characterId":"KTf_JCAKUMQ3GKu2kixRa","role":"Junior Throat-Reader","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"9JmYoWSMNxYltvPxiouvH","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"vz7sUfy8RvU-xwyxk4BhB","characterId":"O0BknF0iBzgno9ADNBTWm","role":"Deacon","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"9THRvyq1dFAkLMBAXGrbn","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"RDos_kLTbvc3Uu5fvSUzL","characterId":"jQh02sqZC0EexaeYnfMAV","role":"XO, Vigil","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"EEVD-Grx0lokqlByOOoRz","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"y6C9-EqExNyuwD7c_mI0B","characterId":"Nz21WLzsyWyV5l2ZCGeph","role":"Senior Throat-Reader","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"F7vVqh1Gl8Yo8zZ3ozF9n","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"vz7sUfy8RvU-xwyxk4BhB","characterId":"81SRo00zNHz6PqTg4HXZo","role":"The Lamplighter","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"J8Ua-jfh6en0VeGXYHpdB","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"Ps94-pJSCfF8v0dBpDV6P","characterId":"JjF9d3F2fSnxSDTqCtebJ","role":null,"startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"Jl142E-STyyvvWpbA6OYB","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"y6C9-EqExNyuwD7c_mI0B","characterId":"gILzK7IqKsFnAE2B2bpSU","role":"Marshal of Security","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"KFhTGWJaG8xOO8A5YvLAl","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"GgtSx3VPaKojkxWprtRj3","characterId":"X6xy9-8XqigaVlg_V-Pe5","role":null,"startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"L_389_TZMxO27F1DnY9bb","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"GgtSx3VPaKojkxWprtRj3","characterId":"ba36zRukMnL6eifQ8p0Lp","role":null,"startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"O-2r0wrcmxHeOVVnvhdeZ","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"y6C9-EqExNyuwD7c_mI0B","characterId":"kKPEd-csxdzTE5plAVRqJ","role":"Director","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"PtDjEcszThm_0i5meTxFX","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"6gdS8EoD_79pqWUmH_FON","characterId":"TC-L5WFMaTQ21rKCAn0bz","role":"Archivist","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"QHl5VP6hBAg0yzBOqrxF3","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"2xgqCKzE3VPTV4sIcgGWD","characterId":"cxOiILo2zDng_KzycPfs7","role":"Organiser","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"T-PWVGu8N0LpDy3LoSzH7","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"aEnF3hOq268c3hy5gB9ly","characterId":"q5e2z38Tumh-e8RRj3Spg","role":"Commander","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"UHz5PezilDGC5Ii5ysuT-","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"RDos_kLTbvc3Uu5fvSUzL","characterId":"CmFRcUGePy467_xgF7b73","role":"Captain, Vigil","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"VgmL2xyppLzHnoREnDW4E","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"2xgqCKzE3VPTV4sIcgGWD","characterId":"Q_bPbcsNtraUTJg8xxckn","role":"Chaplain","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"gNXWBAaMWMZYi6zPUeFUG","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"6gdS8EoD_79pqWUmH_FON","characterId":"M1JAnaMBtxnLCSlQrX2Uy","role":"Prior","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"h7nQPa9xlOYny_SYApny2","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"RDos_kLTbvc3Uu5fvSUzL","characterId":"aerWNgb1iDGcDjVj6rA85","role":"Chief Engineer, Vigil","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"m_pSxavOkop1sRJHGrkiC","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"6gdS8EoD_79pqWUmH_FON","characterId":"lXowrO8WucvQ-z-5V8Y1Z","role":"Throat-Reader","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"ntlFXZ07o7lSnH5OhNla3","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"56KYyfh-jyKWK3fbjZWPh","characterId":"O4qiUlm4ij88IkBV4Edp7","role":"Speaker","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"wF239aURsmFQj0XEqwEs_","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"CtikfV1SdQDweEp0Gv1Xt","characterId":"zO_Df258F-V33Vsnq0pOr","role":null,"startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"wsVpejt8dKuoaTH4Wk9vi","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"CtikfV1SdQDweEp0Gv1Xt","characterId":"cTQk2fuL3YmSOlYDRwOM2","role":null,"startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692},{"id":"zstXpeRmuL06sol3F-AzD","worldId":"os-ym7EwunyTMDieuRMb1","factionId":"RDos_kLTbvc3Uu5fvSUzL","characterId":"L-imTuCYhT3JgMhau4AL8","role":"Admiral","startEventId":null,"endEventId":null,"notes":"","createdAt":1793091991692,"updatedAt":1793091991692}],"factionRelationships":[],"knowledgeFacts":[{"id":"015Zt7TUQNzQXC3J66jYk","worldId":"os-ym7EwunyTMDieuRMb1","title":"The Founder's Fork was Ambrose's","description":"The Wardens' relic is Ambrose Lyle's tuning fork. Its engraving reads 'for Clare', his daughter — not 'For Clarity'.","tags":["anchor"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"I7ePb3LHnBkbwM-0-KziD","worldId":"os-ym7EwunyTMDieuRMb1","title":"The Keeping is an instrument of governance","description":"Hesper Vane designed the Keeping, and sold it to the Ostrander Board in her Memorandum, as the means by which the Reach would go on sending glass and obeying after the Withdrawal: a sacrifice that makes the one who reads the Needle indispensable.","tags":["the lie","core"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"IkiPA02xh8HVNK_h_V5Bz","worldId":"os-ym7EwunyTMDieuRMb1","title":"Teo flew to cross, not to keep","description":"Teo Kesh never released her glass. She flew the Small Mercy into the Long Night to cross to the Inward with Ambrose's proof.","tags":["Concession","core"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"JMlrWvUPIQ5h6yONcuW2C","worldId":"os-ym7EwunyTMDieuRMb1","title":"The Bell can ring the throat","description":"Ambrose's old sounding buoy, driven with the harp and tuned to the Fork, can set the throat ringing at its true pitch and shake the accretion loose.","tags":["Ebb"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"KFv4LDL4RBR_iU2xaUan9","worldId":"os-ym7EwunyTMDieuRMb1","title":"Hesper Vane was the First Warden","description":"The First Warden of the Throat, founder of the Wardens, was Hesper Vane.","tags":["the lie","core"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"LBh90vXXADKopblOGAVG4","worldId":"os-ym7EwunyTMDieuRMb1","title":"The Draw is rigged","description":"The Wheel is weighted: Shoals names are fed in threefold, and some names are not drawn at all but chosen by the High Warden.","tags":["Severance"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"VI4kk959-9KoNUaZElIl6","worldId":"os-ym7EwunyTMDieuRMb1","title":"The throat is choked with glass","description":"The Needle is not starving. Its waist is crowded with a vast accretion of brine-glass: it is choking.","tags":["Ebb"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"W9g9rAbp1-ejWBbEnT3sl","worldId":"os-ym7EwunyTMDieuRMb1","title":"The Keeping makes the scar","description":"Glass released at the waist does not burn away. It accretes, a layer for each Keeping. Sixty Keepings will close the throat.","tags":["the lie","core"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"Woh-PRBGK-YHo6TLA_Y87","worldId":"os-ym7EwunyTMDieuRMb1","title":"The oldest Return is the Small Mercy","description":"Among what the Needle gave back at the Sixtieth Narrowing was Teo Kesh's tug, with Teo in it, and her log.","tags":["anchor","core"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"WsEl90_k-wjIayDw1wKNR","worldId":"os-ym7EwunyTMDieuRMb1","title":"The Narrowing passes on its own","description":"The deep Narrowing of 2291 is the trough of a slow beat between two natural rhythms. The Needle recovers whether or not anything is fed to it. Every Keeping since has been timed to a recovery already under way.","tags":["the lie","core"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"Xt4F40RHLSpkWlBxYLoeU","worldId":"os-ym7EwunyTMDieuRMb1","title":"Mor chose Pell","description":"High Warden Mor had Pell Asante's name chosen, not drawn, to bend Speaker Efua Asante's vote on the war.","tags":["Severance"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"_6wDAG_zh_hiWOLCKLRJI","worldId":"os-ym7EwunyTMDieuRMb1","title":"The oldest harp records were cut","description":"The Anchorhold archive holds no harp records from before the First Keeping: the eleven years before 2291 are a gap the Wardens call the Blank Year.","tags":["Severance","the lie"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"icsjrVZimN_nxUy3CkJpV","worldId":"os-ym7EwunyTMDieuRMb1","title":"Ambrose was murdered","description":"Ambrose Lyle did not fall from the Lectern gallery; Brandt's men killed him on Hesper Vane's order.","tags":["Concession"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"q8_9hak1Uv92PbWh1XBsw","worldId":"os-ym7EwunyTMDieuRMb1","title":"The High Wardens inherit the lie","description":"Each High Warden, at investiture, reads the First Warden's Testament and learns that the Keeping is unnecessary; each keeps it.","tags":["Severance","the lie"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073},{"id":"vg237gzCd8I57sB9PpQke","worldId":"os-ym7EwunyTMDieuRMb1","title":"The Hunger Tone is not the Fork's note","description":"The harp has been tuned since the First Keeping to the Hunger Tone, which is not the pitch of the Founder's Fork. Tuned to the Hunger Tone, the harp cannot hear the Needle recover.","tags":["the lie"],"readerLearnsAtEventId":null,"originEventId":null,"createdAt":1793092190073,"updatedAt":1793092190073}],"knowledgeReveals":[],"characterGoals":[],"sceneTexts":[{"id":"48a1if9G_J_oti7MYzXYH","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"4LM2G0ftK_Z4aA7o0lcyX","text":"The charter came through on the dispatch board at five in the morning, which was how Teo knew it was going to be bad.\n\n*PRIORITY CHARTER. TUG AND PILOT, ONE DAY. DOCK FOUR, 0800. PASSENGER AND CARGO TO THROAT MOUTH, INNER MARKERS. RATE: 600 MARKS AGAINST INDENTURE.*\n\nShe read it three times on the little screen in her bunk-cube in the pilots' dorm on Anchorage, with the cube's one bulb buzzing over her head and somebody being sick in the cube next door. Six hundred marks. She had never seen a rate like it. Six hundred marks was three months of glass runs. Six hundred marks was a whole column on the chit. And *inner markers*, which meant past the last beacon, past the place where the lanes stopped and the throat began, into the zone where the tidal shear came off the mouth in long invisible waves and tore at your hull like a dog at a rope. Nobody went to the inner markers in a tug. You went to the inner markers in a throat-hauler with a reader aboard and shear-plating three hands thick.\n\nShe was at Dock Four at seven-forty.\n\nThe passenger was already there. She had expected a Concern technician, some bright young thing from the Lectern with a slate and an attitude. What she got was an old man in a cardigan, sitting on a packing crate on the dock floor with his hands between his knees and a pair of reading glasses pushed up on his forehead, looking up at the Small Mercy in her cradle with an expression of mild, polite concern, as if she were a dog that might or might not bite.\n\n\"Miss Kesh?\" He stood up when he saw her. He was taller than she had thought. \"Ambrose Lyle. From the Lectern. I'm told you're the best tug pilot on the station.\"\n\n\"Who told you that?\"\n\n\"The dispatch office. I asked them who would actually be able to do it, rather than who was free, and they gave me your name, and then they gave me a long list of reasons I shouldn't hire you, and then they said that was the same thing.\" He smiled, slightly. \"I'm sorry about the hour.\"\n\n\"You're the harp man.\"\n\n\"I'm the harp man.\"\n\nShe looked at him. She had heard of him all her life without ever seeing him, the way you hear of the Director or the Board: the man who read the Needle. The man who told the pilots where the throat would be. Every through-pilot on the station had his charts on their boards and swore by them, and she had sometimes thought of him as a sort of oracle in a dome, remote and terrible. He had a coffee stain on his cardigan.\n\n\"What's the cargo?\" she said.\n\nHe showed her. It was in the crate he had been sitting on: a long cylinder of dull grey alloy two metres from end to end, with a cluster of short fins at one end and a lattice of fine wires at the other, strung on a frame like the ribs of an umbrella. It looked hand-made. It looked very carefully hand-made.\n\n\"It's a sounding buoy,\" he said. \"It listens to the throat, the way the harp does. Only from much closer. The harp is a long way back, and the Narrowing — \" He stopped. \"The Narrowing is doing things I can't hear properly from the Lectern. I want ears at the mouth. Right at the edge, as close as I can get it. If I can put it at the inner markers it'll sit there in the mouth's pull and sing to me for years.\"\n\n\"You want me to fly into the shear and throw that out the airlock.\"\n\n\"I want you to fly into the shear and let me throw it out the airlock,\" he said. \"I'll do the throwing. I would very much like you to do the flying.\"\n\nShe almost laughed. She did not. \"Why me? You've got a dozen throat-haulers with shear-plate sitting in the yards with nowhere to go. The lanes are closed half of every shift.\"\n\n\"The throat-haulers belong to the Concern,\" Ambrose Lyle said, \"and the Concern would like to know why I want to go, and I'd rather not tell it until I know what I'm going to find.\" He looked at her over the buoy. \"You're contract. You belong to yourself.\"\n\n\"I belong to the Concern to the tune of forty-one thousand marks.\"\n\n\"Yes,\" he said gently. \"But not to the Director's office. Not this morning.\"\n\nTeo thought about that for a while.\n\n\"Six hundred,\" she said.\n\n\"Six hundred.\"\n\n\"And you sign a waiver that if you die it was your idea.\"\n\n\"I'll write it out by hand,\" he said, and she believed him.\n\nThey loaded the buoy into the Mercy's little cargo bay together, with the dock's chain-hoist and a lot of swearing on her part and a lot of apologising on his. When it was in its straps he did a thing she did not expect. He took out of his jacket pocket a fork — a tuning fork, the brass kind, with a long stem — and struck it against the heel of his hand, and fitted the stem into a socket in the buoy's end-plate that she had taken for a mounting bolt. It slid in like a key. The fine wires of the lattice, which had been still, began very faintly to hum. He bent close to them with his head on one side, listening, for a long minute, and turned a screw somewhere inside the frame with a jeweller's driver, and listened again. Then he drew the fork out of its socket and the humming died, and he wiped the fork on his cardigan and put it back in his pocket.\n\n\"What was that?\" she said.\n\n\"Calibration. Everything has to be tuned to something.\" He patted his pocket. \"That's what everything I've built is tuned to. The harp, the buoy, all of it. So that they all agree with one another about what they're hearing.\"\n\n\"What if you lose it?\"\n\nHe looked startled, and then amused, and then something else. \"Then I suppose nothing would agree with anything,\" he said. \"I try not to lose it.\"\n\nShe had seen the engraving on the stem when he wiped it. *FOR CLARE.*\n\n\"Who's Clare?\" she said, and immediately wished she had not, because his face changed.\n\n\"My daughter,\" he said. \"She's in Ardent. I haven't seen her since she was four.\" He did not look at her. \"I'm going home on the *Providence*. In April. I'm going to give it to her.\"\n\n\"That's a strange present.\"\n\n\"Yes,\" he said. \"She'll think so too.\"","wordCount":1127,"createdAt":1793093336084,"updatedAt":1793093336084},{"id":"72P-ncMqgaAnTkPsyxuzT","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"m1shtvj-OXNak3rDkSDEs","text":"The sled was riding high again, and Teo Kesh had been cursing it for an hour.\n\nForty tonnes of crated brine-glass on a tow-frame half a kilometre long, and the loaders at the Pans had stacked it heavy at the back the way they always did when the shift was ending and nobody cared, so that every time she fired the Small Mercy's mains the whole frame wanted to swing round and come and look at her. She had trimmed it twice. She had told Pans Loading what she thought of their mothers. Now she sat with her boots up on the console and her hands loose on the yoke, feeling the tow through the seat of her coveralls, and let the tug do what tugs were for, which was pull.\n\nThe Small Mercy was forty-one years old. She had been Teo's mother's before she was Teo's, and somebody else's before that, and she had been re-hulled twice and re-engined once and patched more times than anybody had logged. Her cockpit smelled of coolant and of the oranges Teo bought at a ruinous price from the hydroponics barge and ate in the long middle of the run, and of Teo, and of forty years of other pilots under that. There was a crack in the forward canopy shaped like a river delta. There was a clip on the console where the debt chit lived. Teo did not look at the chit. She knew what it said. It said 41,212 marks, and on the line under that, in smaller figures, what she had paid off this month, which was less than what had been added to it, which was the joke.\n\nAhead of her, over the curve of the console and through the delta crack, the Needle was coming up.\n\nYou did not see it so much as see what it did. A patch of sky the width of a thumbnail at arm's length where the stars were wrong: pulled long, smeared into arcs, crowded at the rim like fish against a net. At the centre of the wrongness there was a darkness that was not black but a deep bruised colour no one had a good name for, and around it a faint circle of light that the old pilots called the Eye. Anchorage Station hung off to the side of it, a spindle and two wheels lit up like a party, and the traffic lanes ran in toward the mouth in strings of beacon lights, green in and amber out, the way they had for fifty years.\n\nTeo had been looking at the Needle every working day of her life. It had stopped being strange when she was nine. It had not stopped being the only door.\n\n\"Mercy, Brannock.\" The radio, Corrigan's voice, too cheerful for the hour. \"You still dragging that cow?\"\n\n\"She's dragging me.\"\n\n\"Told you. Load your own. Never let Pans load you on a shift change.\"\n\n\"I was asleep on a shift change, Corr, that's the point of a shift change.\"\n\n\"I'm three hundred back of you. I can see your sled swinging from here. It's beautiful. It's like watching a cathedral fall over very slowly.\"\n\n\"Go and fly into something.\"\n\nHe laughed. Corrigan Dace had a laugh that had got her into trouble more than once, a long time ago, before Lulu, before he had sold the half-share in the Brannock to cover his wife's medical and then lost the wife anyway. They had stopped sleeping together about the time they had both started owing more than they could ever pay, which Teo privately thought was not a coincidence. Debt took up the room in you where other things went.\n\nShe touched the bead at her throat, a habit. It was a nub of brine-glass the size of a pea, cloudy, faintly blue, on a cord gone black with her sweat. Nico had cut it from his first seam in Shaft Nine and given it to her when he was sixteen and she was twenty-four and still thought she would get them both out. He had told her, very seriously, that glass always knew where the Needle was. It was the kind of thing cutters said. But she had noticed, over the years, that the bead lay a little to the left of where it should on her breastbone when she was out on the lanes, a little toward the mouth, and it had bothered her more than she would have admitted to Nico, who believed things.\n\nThe radio clicked over to the approach channel.\n\n\"All inbound traffic, Anchorage Approach.\" Not the usual controller, not the bored boy with the Ardent accent who flirted with the tug pilots. A woman, clipped. \"All inbound traffic, hold at your current marker. I say again, hold at your current marker. Outbound traffic, cancel throat entry, return to Anchorage. Acknowledge.\"\n\nTeo took her boots off the console.\n\nAlong the lanes the beacon strings were changing. The green in-lane lights were blinking to amber one marker at a time, rolling down the string toward her like a rumour. Far ahead, at the mouth, a long-hauler that had been lined up to go through — one of the big Ostrander freighters, three hundred metres of hull with the company sunburst on its flank — was firing its forward thrusters, slowly, the way a big ship did everything, backing away from the dark.\n\n\"Mercy acknowledges, holding at marker nine,\" she said, and cut the mains, and felt the sled overtake her a little on the tether and come up short with a jolt that rattled her teeth. She cursed it. She was looking at the Needle.\n\nIt was the same. That was what she would remember afterward: that it looked the same. The same bruised dark, the same smeared stars. And then, as she watched, the ring of light around the Eye flickered, as though something had passed across it, and the arcs of starlight at the rim shivered and drew in, very slightly, the way a pupil does in a bright room.\n\n\"Did you see that,\" said Corrigan on the private channel.\n\n\"I saw it.\"\n\n\"What was that.\"\n\n\"I don't know.\"\n\n\"It flinched,\" Corrigan said. \"Teo. The bastard flinched.\"\n\nThe bead at her throat lay very still against her skin. She put her hand over it without thinking and held it there, and the two of them sat at their markers three hundred metres apart and said nothing at all for a while, and watched the long-hauler back away from the mouth like a man backing away from a dog.\n\nThey held for three hours. Approach would say nothing except *hold*, and then *stand by*, and then, at last, *inbound traffic, proceed to dock in sequence*, without explanation, as if the three hours had not happened. Teo brought the sled in to Dock Four on a bad angle because her hands were cold, and the dock crew swore at her, and she swore back, and signed for forty tonnes of glass on a slate that added eleven marks to her chit for the late docking. Eleven marks. She looked at the figure for a long time.\n\n\"Ask them what's going on,\" Corrigan said on the radio, still out at his marker, still waiting his turn.\n\n\"I'm a tug pilot,\" she said. \"Nobody tells tug pilots anything. That's how you can tell we're tug pilots.\"\n\nBut she stood for a minute at the dock window after the crew had gone, with her helmet under her arm, looking up the long curve of the station toward the Needle-ward end where the Lectern was, the observatory, its dome lit up as she had never seen it lit at this hour of a shift. She could see figures moving behind the glass. She could not see what they were doing. She could guess that they were frightened, because she was.","wordCount":1316,"createdAt":1793092538612,"updatedAt":1793092538612},{"id":"88zbYhw6Vd3Yu3UzMKOK2","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"6eoYk6Q04qKDdt7k9x4Sr","text":"The petitions for substitution came to Adaeze Quill because nobody else wanted them, and because she was the archivist, and the archivist was where things went when the order did not know what to do with them.\n\nThere had been eleven so far, in the ten days since the Draw. There were always petitions. A mother for her son, a husband for his wife, a woman of thirty-nine for her nephew of eighteen; they came up from Tallow Under on the supply shuttle in envelopes of good paper, or in person, in their best clothes, and sat in the chair across Adaeze's desk in the little office off the archive and explained, very carefully, as if she might not have understood the Articles, that they were of age and willing and asked only to take the place of the one they loved. Adaeze listened to every one. She wrote them out fair, in the old hand, on the order's vellum, and sealed them with her own seal, and sent them up to the High Warden, and the High Warden declined them. He had declined every one for nineteen years. Four had been granted in the whole history of the Compact. It was not a door, the substitution; it was a painting of a door on a wall. Everyone knew it. They came anyway. Adaeze thought that the coming was the point — that people needed to have knocked.\n\nThe twelfth was in naval greys, and sat down across the desk without being asked.\n\n\"Commander Asante,\" said Adaeze.\n\n\"You know me.\"\n\n\"Everyone in the Anchorhold knows your sister's name.\" Adaeze folded her hands. \"And I saw you, once, at your commissioning. You were nineteen. You had your hair much shorter. Your sister was very small and kept wandering off into the harp hall.\"\n\nJuno Asante looked at her properly for the first time. Adaeze saw herself being looked at: a woman of forty-four in Warden's grey, round-faced, with ink on her fingers and her hair tied back in the plain knot of the order and a pair of reader's spectacles on a cord round her neck. Nobody remarkable. She had never minded being nobody remarkable.\n\n\"I've come to petition,\" said the Commander.\n\n\"I know.\"\n\n\"I'm thirty-one. I'm of Draw age. I'm a volunteer. Under the Articles, Section Nine — \"\n\n\"I know the Articles, Commander.\" Adaeze said it gently. \"I'll write it out. I'll write it out as well as anybody has ever written one, and I'll seal it, and I'll take it up to the High Warden myself, which is more than I do for most of them. I want you to know that before I tell you the rest.\"\n\n\"Which is?\"\n\n\"That he will decline it.\"\n\nThe Commander's jaw set. \"You don't know that.\"\n\n\"He has declined every petition for substitution since he was invested. Two hundred and six of them, at the last three Draws. I've written every one.\" Adaeze pulled a sheet of vellum toward her and uncapped her pen. \"I've read the reasons too. They're always the same. The Needle chose; it is not for the Wardens to correct the Needle. It's theologically sound. I'm afraid it's also unanswerable.\"\n\nShe began to write. *To the High Warden of the Throat, from Juno Efua Asante, Lieutenant Commander of the Compact Navy, of the Speaker's house, being of age and of sound mind — .* She wrote in the old hand, the slanting formal script the order had used since before the Compact, and she could feel the Commander watching the pen move.\n\n\"You believe that,\" Juno Asante said. \"That the Needle chooses.\"\n\nAdaeze kept writing. \"I believe the Wheel is a lottery and the Needle is a wormhole,\" she said, \"and that between them, every four thousand days, nine people are asked to do something very terrible on behalf of everyone else. I believe it has kept the door open for three hundred years. Whether the Needle *chooses* — \" She dipped the pen. \"I'm the archivist, Commander. I believe in records. The records say that every time we have kept it, it has opened. That's what I believe.\"\n\n\"And the people who don't come back?\"\n\nAdaeze stopped writing.\n\n\"I have their names,\" she said. \"Every one, every Keeping. Two hundred and sixty-one. They're in the archive behind that door. I read them, on the anniversaries.\" She looked up. \"I'm not a fool, Commander. I'm not a fanatic. I didn't take the grey because I think it's beautiful. I took it because somebody has to keep the records honestly, and I thought it might as well be someone who could bear to read them.\"\n\nThe Commander was quiet. Adaeze finished the petition and sanded it and folded it and dripped the grey wax and pressed her seal into it, and held it up.\n\n\"Would you like to see the harp?\" she said. \"While you're here. Your sister did, when she was eight. She stood in front of it for an hour. We had to carry her out.\"\n\nThey went through the archive — a long vaulted room, cold, lined floor to ceiling with racks of harp-records on spools and crystal and the oldest of them on paper, three hundred years of the Needle's voice written down — and through the iron door at its end into the harp hall.\n\nIt had been the Lectern once, in the Concession's time. The dome was the same dome, a hemisphere of old glass looking out on the mouth, and the floor was the same floor, worn into hollows by three centuries of feet. The harp stood in the middle of it. Adaeze had served here for twenty years and it still stopped her breath, sometimes, coming through the door. A frame of fused silica taller than a man, gone faintly gold with age, strung with nine courses of resonator wire that caught the grey light of the mouth and held it. It was singing. It was always singing. The long, wide, many-stranded drone of the throat, low and soft, filling the hall, so that coming into it was like walking into the inside of a held breath.\n\n\"The frame is original,\" Adaeze said quietly. \"The First Warden's. The wires have been restrung many times. We tune them every morning to the Hunger Tone.\" She nodded to a small alcove off the hall, behind a grille of black iron, where a lamp burned. \"The Fork is kept there, between Draws. It's struck once, at every Keeping, here, at the moment the Keepers go in. That's all. It's never used for tuning. It's too precious.\"\n\n\"What's it for, then? A tuning fork you don't tune with.\"\n\nAdaeze smiled. \"That's the sort of question your sister would ask.\"\n\nThe Commander did not smile. She stood in the middle of the hall with her hands at her sides and looked at the harp, and then up through the dome at the mouth, the bruise-dark wound with its rim of bent light, and Adaeze watched her face and saw on it something that she had seen on many faces in twenty years and had never been able to name. Not fear. Something more like grief, arriving early.\n\n\"She'll be up here,\" the Commander said. \"Training. For seven weeks.\"\n\n\"Yes.\"\n\n\"Will you — \" She stopped.\n\n\"I'll look in on her,\" said Adaeze. \"I look in on all of them.\"","wordCount":1234,"createdAt":1793093539610,"updatedAt":1793093539610},{"id":"91L5AJ5XhbwPJeYEi2T3W","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"uwhWJbZQj0ns1hWP9t3B3","text":"They gave the nine a dormitory on the second wheel, nine narrow cells off a common room with a window on the mouth, and they gave them each a bead.\n\nIt was the first thing, the night they arrived: a Warden going round the common room with a little wooden box, and each of them taking one out, a nub of cloudy brine-glass the size of a pea on a black cord. You wore it from the night you came up until the night you flew. Pell put hers on at once and felt it settle into the hollow of her throat, cool, and lie there, very slightly to the left. Toward the mouth. The Warden said it always would.\n\n\"It's to remind you,\" the Warden said, \"that you are already part of it.\"\n\nEzra Lind, sitting on the bench beside her, turned his bead over in his ink-stained fingers and said, under his breath, \"Part of what, though,\" and then looked horrified at himself, and put it on very fast.\n\nBy the fourth day Pell liked him best of all of them. There was Tavish Orme, who was thirty-eight and had three children and did not speak to anyone; there was Abbe Sorrell, the Shoals girl they had brought in on a Navy ship with her hands cuffed, who had stopped fighting on the second day and stopped eating on the third; there were five others whose faces Pell was learning, a baker and a lift-mechanic and a woman who had been a Warden novice once and left. And there was Ezra, who was twenty-two and a clerk in the dock office and had never flown anything bigger than a cargo sled across a hangar floor, and who was so frightened, all the time, that it came out of him as jokes.\n\n\"The thing is,\" he said to her in the simulator bay on the fourth day, strapped into the mock cockpit of a Keeper's skiff with the screens full of grey-gold throat and his hands white on the stick, \"the thing is that I failed my sled licence twice. Twice. They told me I didn't have the spatial reasoning. And now the Needle has looked into my soul and said, *Ezra Lind, you are the man to fly into my throat.* I think the Needle's made a clerical error. I think I should file a complaint.\"\n\n\"File it with Sister Quill,\" Pell said. \"She does the paperwork.\"\n\n\"I tried. She said the Needle doesn't accept complaints. She said it very kindly.\" He banked, too hard, and the simulator screamed at him and the screens went red. \"Oh, for — that's the fourth time I've died today. Do you think it counts? Do you think if you die enough times in the simulator the Needle lets you off the real one?\"\n\n\"I don't think it works like that.\"\n\n\"No,\" said Ezra, and looked at the red screen, and his face changed for a second, and he said in a different voice, \"No, I don't suppose it does,\" and then he reset the simulator and made a joke about the instructor's moustache.\n\nThe skiffs were very simple. That was what surprised Pell. She had imagined something grand, something like the ships in the old paintings in the Compact Hall; but a Keeper's skiff was twelve metres of narrow hull with a single seat and a cradle under the belly for the glass, and an engine, and a release lever painted white. You flew it into the mouth at the start of the Long Night, when the throat was tightening, following the reader's line, and you flew it down the throat as far as the waist, and at the waist you pulled the white lever and the glass went, and then you turned round and flew back the way you came. That was all. The instructors went over it and over it. The line, the waist, the lever, the turn. The line, the waist, the lever, the turn.\n\nThey did not talk about how many turned and did not come back. Nobody did. Pell knew the number anyway, the way everybody in the Reach knew it: a little under half. Two hundred and sixty-one names in Sister Quill's archive. She thought about it sometimes, at night, in her cell, with the bead lying cool against her throat. She waited to be frightened. She was not frightened. She was something else that she did not have a word for, something that hummed in her like the harp.\n\nShe went to the harp hall on the sixth night, very late, because she could not sleep and because it was the only place in the Anchorhold she wanted to be.\n\nSister Quill was there. She was sitting on the floor with her back against the wall under the dome, in the dark, with her spectacles in her lap, listening. She looked up when Pell came in and did not seem surprised.\n\n\"I come here too,\" she said. \"When I can't sleep. Sit down, if you like.\"\n\nPell sat down beside her. The harp sang in front of them, gold-wired, the long low many-stranded drone of the throat, and above them in the dome the mouth hung, huge, its rim of light trembling very faintly. It had begun to tremble on the fourth day. The readers said it was the Narrowing beginning in earnest. You could see it if you watched for long enough: a slow shiver at the edges, like heat over a road.\n\n\"Can I ask you something?\" Pell said.\n\n\"You can ask.\"\n\n\"What does it look like? The waist. Inside.\"\n\nAdaeze Quill was quiet for a while.\n\n\"I don't know,\" she said. \"Nobody does. The ones who come back don't speak of it. It's a rule of the order — they're asked not to, and they don't. I've asked some of them myself, privately, when I was younger and more curious. They wouldn't tell me.\" She turned the spectacles over in her lap. \"One of them — an old man, he'd flown the Twenty-Sixth — told me that it wasn't a thing that had words. That's all he'd say.\"\n\n\"I've painted it,\" Pell said.\n\nThe Warden turned her head.\n\n\"I've been painting it since I was eight. Since I heard this.\" Pell nodded at the harp. \"I never get it right. I brought one with me. They said one bag.\" She did not know why she was saying this. \"Do you want to see it?\"\n\nShe went and got it from her cell. When she came back Sister Quill had lit the little lamp in the alcove beside the reliquary grille, and Pell held the canvas up in its light. It was the throat one, the one she had chosen on the floor of her room in Tallow Under while Juno knelt among the canvases: the long tunnel of folded light, gold and grey and a colour that was not quite either, opening and opening down its length toward a place at the centre where everything drew in, tight as the iris of an eye, and in the middle of that, very small, something that was not quite white.\n\nSister Quill looked at it for a long time.\n\n\"Where did you see that?\" she said at last. Her voice was odd.\n\n\"I didn't see it. I heard it. I just — that's what the harp sounds like. To me. That's what it sounds like inside.\"\n\n\"The iris,\" said the Warden softly. \"In the middle. Drawn in.\"\n\n\"That's the waist. I think. That's where it goes tight.\" Pell looked at her. \"Why? What's wrong?\"\n\n\"Nothing's wrong.\" Sister Quill took off her spectacles, which she had put on to look, and folded them carefully. \"There's a description in the archive. Very old — one of the oldest things we have. An account of the throat in a Narrowing, written by a reader, from before the Compact. Most of it's lost. But there's a passage — \" She stopped. \"It says almost exactly that. *Drawn in like an iris. And at the centre, a light I have no name for.*\" She gave a small, uncertain laugh. \"I've read it a hundred times. I never saw it until now.\"\n\nThey sat together in the lamplight in front of the singing harp, the painting propped against Pell's knees, and neither of them said anything for a long time. Pell's bead lay against her throat, cool, leaning very slightly toward the mouth.\n\n\"I'm not afraid,\" Pell said finally. \"Everyone keeps waiting for me to be afraid.\"\n\n\"I know,\" said Adaeze Quill. \"I've noticed.\" She put a hand, briefly, on the back of Pell's neck, the way you would with a child. \"It's all right not to be. And it will be all right, if you are.\"","wordCount":1468,"createdAt":1793093539110,"updatedAt":1793093539110},{"id":"Al5buU7_7Qp-yi0vBJVpN","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"b8BaZ7zgb3d0zVGfhIW_4","text":"The High Warden received her the next morning, which was itself, Juno understood, a kind of answer.\n\nHis rooms were at the very top of the Anchorhold's spindle, at the Needle-ward end: a long low gallery with a curved window filling one wall, so that the mouth hung outside it vast and dark, like a painting of nothing. It was almost bare. A desk. Two chairs. A cabinet of old black wood with a lock. On the floor a carpet of some deep red stuff so old that its pattern had worn to the weft in a path from the door to the desk, as if the same feet had walked that line for centuries. Cassius Mor stood at the window with his back to her when the novice showed her in, and did not turn round at once.\n\n\"Commander Asante,\" he said to the glass. \"Sit down. Please.\"\n\nShe did not sit. After a moment he turned, and smiled at her — a warm, tired, genuinely kind smile, the smile of a man who has been expecting a difficult conversation and is sorry it has to happen — and came and sat behind the desk himself, and gestured again at the chair, and this time she sat, because standing had become ridiculous.\n\nHer petition lay on the desk between them, its grey seal broken.\n\n\"Sister Adaeze writes a beautiful hand,\" Mor said. \"And she has put your case as well as it could be put. Better. I've read it twice.\" He laid his palm on the vellum, gently, as if it were a living thing. \"I'm going to decline it, Commander. I expect you know that. I wanted to tell you so myself, rather than send it down with a seal on it, because I think you are owed that, and because I wanted you to understand why.\"\n\n\"The Needle chose,\" Juno said.\n\n\"The Needle chose.\" He nodded slowly. \"You think that's a formula. A thing we say. It is a thing we say. But it is also true, and I would like you to try, just for a moment, to hear it as true.\" He leaned forward. \"The Draw is the only thing in the Reach that is perfectly fair. Do you understand? The only thing. The Speaker's daughter and the dock clerk and the Shoals girl in a rock with no name — every one of them a slip of foil in the same drum. No money buys you out of it. No family. No office. It is the one place where we are all the same. That is why it works, Commander. That is why the Reach has borne it for three hundred years. Because it is fair.\" He spread his hands. \"And if I let the Speaker's daughter out, because the Speaker's other daughter is a decorated officer who has come in her greys to ask me — then it is not fair any more. Then it is a thing the powerful can get their children out of. And the next time the Wheel turns, every mother in the Fourth Terrace will know it. And the Draw will be broken. And the Keeping with it.\"\n\nIt was a good speech. Juno had heard admirals give worse. She sat and let it go past her and watched his face.\n\n\"There are four substitutions in the record,\" she said.\n\n\"There are. In three hundred years. Each of them for reasons which I would not wish on your family.\" He sighed. \"Commander. I know what you are. I know what you've done in this war. I know you've been out in the Shoals for six years taking names off registries for the Draw — \" a small, delicate pause — \"and I know what that has cost you, because I have read your reports, and you write them very honestly. You of all people know what the Draw costs. You of all people know what it would mean if it were seen to bend.\"\n\nShe did not answer.\n\n\"How is your mother?\" Mor said.\n\nThe change of direction was so smooth that it took her a second to feel it.\n\n\"She's well.\"\n\n\"I'm glad. She carries a great deal. I know it.\" He looked at her with what seemed to be real concern. \"The appropriation for the Shoals campaign comes before the Assembly next week. I understand she hasn't yet said how she'll vote.\"\n\n\"I don't discuss my mother's votes, High Warden.\"\n\n\"No. Quite right.\" He smiled again. \"I mention it only because the Keeping cannot be flown if the Shoals can raid the glass stores at will. You know better than I how close they came last month. The Keeping must be protected, this time of all times. The Thirtieth is deep. Deeper than anything in two hundred years. If the escort is not funded — \" He let it trail away, and shook his head slightly, as if at the size of the thought. \"Well. I hope she will remember that her daughter flies in it. I'm sure she will.\"\n\nJuno looked at him for a long moment. Outside the window, beyond his shoulder, the mouth of the Needle hung huge and patient, and she thought of the Hall, ten days ago: the seventh slip of foil held up to the light; the High Warden's eyes lifting from it, before he read, across the floor to the Speaker's terrace. Only for a moment.\n\n\"Thank you for seeing me, High Warden,\" she said, and stood.\n\n\"Commander.\" He stood too, courteous. \"Your sister is extraordinary. I've met her. She has a gift for this that I have rarely seen. She is not afraid. You should be very proud.\"\n\n\"I am.\"\n\n\"Then let her go,\" said Cassius Mor gently. \"It is the last thing you can give her.\"","wordCount":969,"createdAt":1793093539325,"updatedAt":1793093539325},{"id":"CZm_1-lhL0rz3VPnSDXVk","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"Hy3VAW4LN10Gaa4qhfEBE","text":"The Compact Hall had been built, so the guides said, on the floor of the old Concession meeting-house, and if you stood at the very back under the gallery, where the ceiling came down low, you could still see the original salt wall: rough, grey-white, with the marks of the cutting machines on it in long curved grooves like the inside of a shell. Everything else had been built up and out from there over three hundred years. The Hall rose in tiers now, cut terraces of salt dressed with pale stone, and a light-well opened at the top of it to the surface eight hundred metres above, so that when Caul was up the whole Hall filled with a slow banded amber like the inside of a cut agate. Caul was up. It was always up for the Draw. The Wardens arranged it so.\n\nJuno stood on the Speaker's terrace in her dress greys between her mother and her sister and did not look at the Wheel.\n\nShe looked at the Tally instead. It hung on the original salt wall behind the Wardens' bench, as it had for as long as there had been a Compact: a plate of old steel half a metre across, dark, pitted, oddly unimpressive, in a frame of polished brass far too fine for it. The Founders' Tally. As a child she had been told it bore the names of the dead of the Concession, the miners and cutters who had died in the salt before there was a Compact, and that the first Keepers were on it too, and she had stood on tiptoe and looked for them and been disappointed, because three centuries of hands had touched it and worn it smooth, and you could not read a single name. You could feel them, if you were allowed to touch it, which children were, once, on their Naming Day — rows of shallow scratches under your fingers, like braille in a language nobody spoke any more. She remembered the cold of it. She remembered thinking that it was the oldest thing she had ever touched.\n\n\"Stop fidgeting,\" her mother said, without moving her lips.\n\n\"I'm not fidgeting.\"\n\n\"You're doing the thing with your thumb.\"\n\nJuno stopped doing the thing with her thumb. Efua Asante, Speaker of the Assembly of the Compact of the Reach, stood beside her in black and silver with her hands folded and her face composed into an expression of grave civic attention that Juno had seen her wear at funerals, budget debates and her own husband's cremation, and that Juno had never once been able to see behind. She was sixty-one. She had been Speaker for eight years and had spent the last six of them trying to end a war that the Assembly would not let her end, and she looked, Juno thought, very tired, in a way that only someone who had known her face for thirty-one years would see.\n\nOn Juno's other side Pell was not fidgeting at all.\n\nShe stood very straight in the plain white smock that everyone of Draw age wore to the Hall, with her hands loose at her sides and her chin up and her eyes on the Wheel, and she was smiling a little. Not the nervous smile you saw on some of the faces in the tiers around them, the bright fixed grin of someone telling themselves it was one in four thousand. Something quieter. As if she were listening to music.\n\n\"Pell,\" Juno said.\n\n\"Mm.\"\n\n\"Are you all right?\"\n\n\"I'm fine.\" Pell glanced at her, and the smile widened into something more like her own. \"You look awful. Did they not let you sleep on the way in?\"\n\n\"I boarded a ship full of children.\"\n\n\"Oh, Juno.\" Pell's face changed. \"Were they —\"\n\n\"They're fine. They're cold and they're in a cell and they're going to be handed over to the Wardens, but they're fine.\" She heard her own voice and did not like it. \"Sorry. It's not — sorry. Ignore me.\"\n\nPell reached over and squeezed her hand, briefly, the way she had done when she was six and Juno was eighteen and leaving for the Academy, as if Pell were the one who had to be brave about it. Then the bell rang, and the Hall went quiet, and the Wardens came in.\n\nThey came from the back, through the salt door, in procession: thirty or forty of them in the grey of the order with the silver thread at the cuffs, walking slowly, two by two, singing. Juno had never liked the song. It was very old, and it had no tune she could hold onto — a long held drone that the Wardens called the Hunger Tone, under which the voices of the procession wandered up and down in a kind of chant, so that the whole thing sounded less like singing than like something enormous breathing in its sleep. The Hall took it up. You were supposed to. Thousands of voices finding the drone, holding it, until the salt walls hummed with it and you could feel it in your teeth. Pell was singing. Their mother was singing, in her perfect civic contralto. Juno moved her lips.\n\nAt the end of the procession came the High Warden.\n\nCassius Mor was sixty-six and walked like a much younger man, upright, unhurried, his white hair cropped close to a long well-made skull. He did not sing. He carried, on a cushion of grey velvet held out before him in both hands, the Founder's Fork: a tuning fork of brass, fifteen centimetres long, its tines worn bright, its stem engraved with letters three centuries of polishing had worn down to ghosts. Juno had seen it up close once, at a reception at the Anchorhold when she was a cadet. You could make out FOR CL and nothing after. The Wardens' motto came from it. *For Clarity.* It was said to have been the First Warden's own, the instrument by which the First Warden had first heard the Needle's hunger; it was the holiest object in the Reach, and it was carried before the Wheel at every Draw, and at every Keeping it was struck once in the Lectern at the Anchorhold at the moment the Keepers went in.\n\nMor laid it on the bench beneath the Tally, on its cushion. The drone died away. In the silence he raised his hands.\n\n\"The First Warden heard the Needle's hunger,\" he said, \"and the Reach answered.\"\n\n\"*We feed the door, that it may stay a door,*\" said the Hall, eight thousand voices at once, and Juno with them, because that much she could never not say; it was in her like her own name.\n\n\"What the Needle keeps,\" said Mor, \"it keeps for us.\"\n\n\"*It keeps for us.*\"\n\n\"Twenty-nine times,\" said Mor, \"the door has narrowed in our keeping. Twenty-nine times we have answered, and twenty-nine times it has opened again. We come now to the Thirtieth.\" He let the silence hold. His voice was warm, unhurried, beautifully pitched; he spoke the way a good doctor tells you it is going to hurt. \"The readers at the Anchorhold tell me it will be deep. Deeper than any in two hundred years. Some of you are afraid, and you are right to be. I am afraid. But we have done this before, and we know how it is done. We give what is asked of us, and the door opens. That is the covenant. It is the oldest promise in the Reach. It has never been broken.\" He turned, and laid his hand on the Wheel. \"Nine are asked. Let the Wheel choose them.\"\n\nThe Wheel was brass, a drum the size of a man lying down, on a cradle of black iron. It held, so the guides said, every name in the Reach between the ages of eighteen and forty, each on its own slip of steel foil, and it turned on its cradle with a long grinding hush that you could hear from every tier of the Hall. Two Wardens turned it. Juno watched it turn. Despite herself, despite everything, she watched it turn, and the foil slipped and hissed inside it like rain on a hull, and her mouth was dry.\n\nIt stopped. A Warden opened the hatch. Mor reached in and drew out a slip of foil and held it up to the light-well, and read.\n\n\"Tavish Orme, of the Fourth Terrace.\"\n\nSomebody screamed, high up in the tiers. Not the man himself — someone near him. A mother, a wife. Juno did not look. The Wardens went up into the tiers, two of them, toward the sound, and the Wheel turned again.\n\n\"Abbe Sorrell, of Corrie Rock in the Shoals.\"\n\nA murmur, this time. A Shoals name, by registry; Abbe Sorrell would not be in the Hall. Somewhere out in the Shoals a Navy boarding party would be carrying a slate to a habitat to find her. It might be the *Vigil*. Juno closed her eyes for a second and opened them.\n\n\"Ezra Lind, of the Dockside.\"\n\nA young man in the tier below them sat down suddenly on the salt step as if his legs had been cut, and stayed sitting, with his hands over his mouth. He had a dock clerk's ink stains on his fingers. He looked about twenty-two.\n\nThe Wheel turned. Four. Five. Six. Juno counted them without hearing the names. She was aware of her mother beside her, not moving; of the light-well's amber shifting slowly on the far wall as Caul turned; of the Tally's dull steel square above the bench. She was aware of Pell's hand, which had found hers again at some point and was holding it, quite loosely, warm and dry.\n\nThe Wheel stopped for the seventh time. Mor reached into it. He drew out a slip and held it up to the light, and looked at it. And then he looked — Juno would think about this afterward, for a long time, turning it over and over the way you turn a stone in your pocket — he looked up, across the floor of the Hall, at the Speaker's terrace. Only for a moment. Then he read the name, slowly, as if he wanted every syllable of it to reach the back of the Hall.\n\n\"Pell Asante,\" said the High Warden, \"of the Speaker's house.\"\n\nThe Hall made a sound Juno had never heard it make: a great soft collective intake of breath, eight thousand people drawing in air at once. Then silence.\n\nJuno did not move. She could not. Her body had become a single held thing. Beside her, she heard her mother make a very small noise in her throat, the kind of noise you make when you have been cut and have not yet looked at the cut.\n\nAnd Pell let go of her hand.\n\nShe stepped forward to the edge of the terrace, into the light, in her white smock, and stood there so that the Hall could see her. She was smiling. It was not a brave smile; it was not for anyone. It was the smile she had worn all morning, the listening smile, and Juno understood, watching her sister's face lifted toward the amber light-well with tears running quietly down it, that Pell was happy. That Pell had wanted this. That she had stood in the Hall all morning listening to the Hunger Tone and waiting to be chosen, the way you wait for someone you love to come through a door.\n\nThe Wardens came for her. Pell went down the steps to them without looking back.","wordCount":1951,"createdAt":1793092973748,"updatedAt":1793092973748},{"id":"CeKl9zLTrk4W_lfE32Hu9","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"jZixxF2eaRvPHhrSsthe9","text":"\"There is no basis for it,\" Ambrose said.\n\nThe Director's Gallery was at the top of the station's spindle, the Needle-ward end, a long low room with a curved window that took up the whole of one wall, so that the mouth of the Needle hung outside it like a vast dark painting. Hesper Vane had furnished it with almost nothing: a desk, two chairs, a cabinet, a rug of some deep red Inward wool that must have cost more than Ambrose's harp. She sat behind the desk now with her hands folded on it. He had not sat down.\n\n\"I never said it was starving,\" he said. \"I never said anything about a ring weakening. I never said that feeding glass to it would do anything at all. Nobody has ever said that. There is no data. There is no theory. You made it up.\"\n\n\"I extrapolated.\"\n\n\"From what?\"\n\n\"From what you told me.\" Her voice was perfectly level. \"You told me the waist is narrowing. You told me you don't know why. You told me the throat is held open by exotic matter. You told me brine-glass is exotic matter. You told me you have no model and no theory and four data points and a lot of hope.\" She spread her hands slightly on the desk. \"I have given them a model. I have given them a theory. I have taken away the hope and given them something better.\"\n\n\"Which is what?\"\n\n\"Something to do.\"\n\nHe stared at her.\n\n\"People can bear almost anything, Ambrose,\" Hesper Vane said, \"except not knowing what to do. You know this. You've watched it, these last two weeks — the bars, the dorms, the shafts. Forty thousand people who have just been told that the company that owns them is leaving and that the door to the rest of the universe may be closing behind it. What do you think they will do with that? If they have nothing to do with it?\" She did not wait for an answer. \"They will riot. They will stop cutting. They will tear Anchorage apart looking for someone to blame and they will find me, because I am the one who is staying. I have given them something to do. I have given them a way to save themselves. Whether it works — \"\n\n\"It won't work.\"\n\n\"You don't know that either.\" She looked at him, and her eyes were very steady. \"Do you? Can you tell me — with data, Ambrose, with a theory — that it won't?\"\n\nHe opened his mouth and shut it.\n\n\"No,\" she said. \"You can't. You've said so to me twice.\" She leaned back in her chair. \"So. The Narrowing will do whatever it does. If the Needle opens again, the Keeping will have kept it open. If it doesn't, nothing would have. Either way, for forty-seven days, the Reach will have something to do other than burn itself down. That is the whole of my policy. You may disapprove of it. I would think less of you if you didn't.\"\n\n\"And the pilots?\"\n\nSomething moved in her face, very briefly, and was gone. \"The pilots will be volunteers. Every one. I will not order anyone into the throat. They will be paid more than anyone in the Reach has ever been paid for anything, and the ones who come back will be heroes, and their families will be free.\" A pause. \"And the ones who don't come back will be heroes too.\"\n\nAmbrose turned away and looked out of the window at the mouth. He thought of the buoy out there at the inner markers, two days in the pull now, singing to him across two million kilometres: the long, slow, even drawing-in of the waist, and under it the other thing, the swell, the tide. Louder there. Real. He had sat in the Lectern last night with the headphones on and listened to it until three in the morning. It had a period, he was almost sure, of a little over four minutes. He did not know what it was. He did not know what it meant.\n\nHe had not told her about it. He realised, standing at her window, that he was not going to — not yet, not until he knew. He did not examine why.\n\n\"Your berth on the *Providence*,\" Hesper Vane said behind him, \"is confirmed for the twenty-eighth. Senior grade, as I said. Cabin twelve. I checked.\" He heard her slate click. \"Forty-four days, Ambrose. Do your job until then. Read the throat, give me the numbers every six hours, don't speak to the bars. And then go home.\"\n\nHe put his hand in his jacket pocket and closed it round the fork.\n\n\"Yes, Director,\" he said.\n","wordCount":796,"createdAt":1793093335260,"updatedAt":1793093335260},{"id":"E1kpxAiXVVUiu3osili5E","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"ifku_JzAmcnMrrHn5FNm6","text":"The Lantern was the third bar on Lantern Row and the only one where the beer was made from anything you could identify, and on the night of the second of March it was full to the walls.\n\nTeo came down the stair from the Pans lift still in her flight coveralls and found Nico at their usual table at the back, under the vent that dripped, with his cutter's goggles pushed up into his hair and the grey dust of Shaft Nine still in the creases of his knuckles, holding forth. He was always holding forth. He was twenty-six and had been holding forth since he could stand. Around him, five or six young cutters were listening with the expressions of people who had heard it before and liked it anyway.\n\n\"— because they need us more than we need them. That's the whole thing. That's all you have to understand. Who cuts the glass? We cut the glass. Who hauls it? Teo hauls it.\" He saw her and pointed. \"There. A worker. Look at her. Look at the state of her. Teo, tell them who needs who.\"\n\n\"I need a drink,\" she said, and he laughed and pushed his across the table to her, and she drank half of it and sat down.\n\nShe was always surprised by how glad she was to see him. It caught her every time, under the breastbone where the bead lay. He had their mother's long face and their father's terrible laugh and none of the caution either of them had died of, and when he was talking he lit up like a beacon string, and she had spent twenty years trying to keep him from walking into things and loved him for walking into them anyway.\n\n\"They held the lanes three hours,\" she said, low, under the noise. \"Something's wrong with the Needle.\"\n\nThe light went out of his face, a little. \"What kind of wrong?\"\n\n\"Corr says it flinched. I say I don't know. Approach wouldn't say anything. The Lectern's lit up like it's Founders' Day.\"\n\nCorrigan came in an hour later with Lulu on his shoulders, because he had nobody to leave her with on a long shift and the Lantern's owner had a soft spot for her and fed her fried salt-eel from the kitchen. She was nine and had her father's laugh and a bag of bolts she was collecting for reasons she would not explain, and she climbed down onto the bench next to Teo and showed her the new ones, and Teo admired them, and Corrigan sat down heavily and drank Nico's second beer without asking.\n\n\"Eleven marks,\" he said. \"Late docking. Eleven marks for holding where they told me to hold.\"\n\n\"I got eleven too.\"\n\n\"Everyone got eleven.\" He rubbed his face. \"They're going to say something tonight. There's a broadcast at twenty hundred. All screens. Mandatory. Fat Diz behind the bar says the screens in the Pans dorms have been showing the sunburst all afternoon.\"\n\n\"Fat Diz says a lot of things.\"\n\n\"Fat Diz says the Concern's pulling out,\" Corrigan said.\n\nNobody said anything. The bar went on being loud around them.\n\nMother Salome came in a little before twenty hundred, the way she always did on the nights there was trouble, as if she could smell it in the ventilation. She was sixty-odd, tall and stooped, ordained by nobody, with a face like a cliff that had been rained on for a long time. She did not drink. She went from table to table with her hand on people's shoulders, and she carried under her arm, wrapped in an old blanket, the Tally.\n\nTeo had seen it a hundred times and it still did something to her stomach. It was a plate of steel half a metre across, cut with a torch from one of the support beams they had dragged out of Shaft Nine after the collapse of eighty-six, and on it, in rows, scratched with a nail and a cutter's stylus and anything else to hand, were the names of the shaft's dead. Thirty-one from the collapse, at the top, in Salome's careful capitals. Below them the others, from bursts and glass-lung and falls and the slow ordinary ways, in a dozen different hands. Salome brought it out when somebody died and let the family scratch the name. She brought it out, too, on nights like this one, without explanation, and set it on the bar, and people touched it as they went past. Teo had never asked why.\n\nThe screens over the bar flicked to the sunburst at twenty hundred exactly, and the room went quiet in a ripple from the front to the back, and then Hesper Vane was there.\n\nShe was in her office, the Director's Gallery on Anchorage — Teo knew it from the window behind her, and the edge of the Needle in the window, bruise-coloured. She sat very straight and spoke without notes. She did not hurry.\n\nShe said that the Board of the Ostrander Concern had determined not to renew its Charter for the Reach. She said that the Concern was grateful. She said that all salaried staff of the Concern would be withdrawn, with such equipment as justified its passage, on the *Ostrander Providence*, departing the twenty-eighth of April, and that this would conclude the Concern's direct presence in the Reach. She said that the Concession continued; that all contracts, indentures and debts remained in force and remained the property of the Concern; that they would be administered locally, by an office of the Concession which she herself would head; and that the shipment of brine-glass to the Inward would continue at the current quotas. She said that she was confident that the people of the Reach would meet this change with the steadiness for which they were known.\n\nThen she said, in exactly the same voice, that Anchorage had today observed the beginning of a Narrowing of the Needle — a natural event, previously observed on four occasions — and that this Narrowing was expected to be deeper and longer than those before it; that throat traffic would be restricted from time to time; and that the Concession's throat-readers were monitoring it closely. She said that there was no cause for alarm. She said goodnight.\n\nThe screens went back to the sunburst.\n\nFor a moment nobody in the Lantern moved at all. Then everybody did. Somebody threw a glass at the screen and missed. Somebody was crying. Fat Diz was shouting for order and getting none. At the next table a cutter Teo half knew was standing on the bench yelling *what does it mean, remain the property, what does that mean* at nobody, over and over, as if one of them might know.\n\nTeo sat very still.\n\nIt meant what it said. That was the thing about Hesper Vane: everything she said meant exactly what it said, and you only had to listen. It meant that the Concern was leaving and taking its money and its people and its doctors and its ships, and leaving behind the paper. It meant that forty-one thousand two hundred and twenty-three marks — she had the new figure by heart already — were still owed, to a company that would be on the other side of the Needle, and would go on being owed, and would be collected by whoever sat in that office with the bruise in the window. It meant that she would haul glass for the Concession until she died, the way her mother had, and her mother's mother, and that the oranges would get more expensive, because everything would.\n\nAnd it meant that the door — the one door, the only door, the door she had looked at every working day of her life and stopped finding strange at nine — was doing something nobody had seen it do before. *No cause for alarm.* Hesper Vane had said it in the same voice as everything else. Teo had heard the Lectern's lights in it.\n\n\"They can't,\" Nico was saying. He was on his feet. His face had gone white under the dust. \"They can't just — keep the paper and leave. That's not — there are laws.\"\n\n\"Whose?\" said Corrigan, quietly. He had Lulu pulled in against his side. \"The laws are in Ardent, Nic. With the Concern.\"\n\n\"Then we don't pay.\" Nico looked round at the cutters, at the bar, at the whole loud frightened room, and Teo saw it come into his face, the thing she had spent twenty years keeping him from walking into, and saw that this time there was nothing she could do. \"They're leaving. Who's going to make us? The Director and her Marshal and whoever's too poor to get on the *Providence*? They need the glass. They said so. *The shipment of brine-glass will continue.* Who cuts it?\"\n\n\"Nico,\" she said.\n\n\"Who cuts it, Teo?\"\n\nThe cutters around the table were looking at him. Some of them were nodding.\n\nAcross the room Mother Salome had set the Tally down on the bar. She stood beside it with one hand flat on the steel, the way you would put a hand on the neck of a frightened animal, and she was looking at nobody, or at all of them. As Teo watched, people began to move past the bar and touch it, as they always did, without being asked — a hand, a fingertip, a palm — and go on. A cutter with a burn scar across his jaw. A woman with a baby. Lulu, slipping out from under her father's arm, standing on tiptoe to reach. One by one, the whole time the shouting went on, they went up and touched the names.\n\nTeo did not go. She sat with Nico's beer going warm in her hand and her other hand over the bead at her throat, which lay, she noticed — she could not help noticing — a little to the left. A little toward the mouth.","wordCount":1675,"createdAt":1793092538394,"updatedAt":1793092538394},{"id":"Gdg879pA4HIO5MVWIi38A","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"9Zu1VoadNFCr60Qvn4LVB","text":"The Gutter was the outermost ring of old Tallow, the oldest part of the town, where the first tunnels had been cut down into the salt by the first machines before anybody living could remember. It had been abandoned once, Hanne said, in the good times, when Tallow had spread itself up into terraces and light-wells and gardens. Now the terraces were cracked and dark and most of the light-wells had fallen in, and the Lantern held what was left of the upper town, and the Gutter was full again: bone-pickers, Shoals families who had come in from the rocks when the rocks ran out of air, people who could not pay for heat higher up. The tunnels were narrow and low and smelled of salt and cooking and cold, and everything in them was the same grey-white as the walls, and the only colour anywhere was what people had painted.\n\nHanne's room was at the end of a dead-end tunnel off Rope Street, behind a door that had once been part of a ship. It was warm, because Isra paid for it to be warm. It was full of things: rags and pots and bundles of dried salt-weed and a thousand scraps of paper and plastic and foil, all of them covered in Hanne's writing, the songs and the scraps of songs and the stories she had collected for sixty years, and the sayings, and the lists of names. It smelled of her, and of the weed she smoked, and of the old wood of the cittern.\n\nShe was sitting on the bed with the cittern on her knee when Isra came in, tuning it.\n\n\"You're late,\" she said. \"And you've got nothing. I can tell by your face. They took it.\"\n\n\"They took it.\"\n\n\"The Lantern.\"\n\n\"Deacon Rusk.\" Isra sat down on the floor with her back against the bed and her head against her grandmother's knee, which she had not done since she was small, and Hanne put a hand on her hair and left it there, and went on tuning with the other.\n\n\"Rusk,\" said Hanne, \"is a little shit.\"\n\n\"Yes.\"\n\n\"His mother was a little shit before him. I knew her. She sang flat.\" Hanne plucked a string, frowned, turned a peg. \"I heard her, you know. Mercy. On the speakers. A hundred Keepers.\"\n\n\"Pike says she'll get them.\"\n\n\"Pike would know.\" Hanne's hand moved on her hair. \"He flew escort for her, at the Fifty-Ninth. Did you know that? Before you took him on. He was one of her boys, then. He doesn't talk about it.\" She plucked the string again. \"Nobody comes back from the Lantern the same.\"\n\nIsra had not known that. She sat with it for a while.\n\n\"Sing me something,\" she said.\n\n\"What do you want?\"\n\n\"I don't care. Something old.\"\n\nHanne thought. She was seventy-three and looked older, small and brown and folded, with a face like a dried apple and eyes like a bird's, and she had been a teller all her life, like her mother before her and her mother's father. A teller kept things. That was all it meant. In the Quiet, Hanne said, when the machines that kept things had all broken and the Compact had broken and nobody could read anything older than their grandmother's handwriting, the tellers had kept what there was to keep, in their heads and their mouths and their hands. Most of it was wrong. Hanne said that too. *Most of it's wrong, girl, but it's all we've got, and wrong is better than nothing, because you can fix wrong.*\n\nShe played a few bars, slowly, and then she sang.\n\nIt was the one everybody knew, or knew the start of: the Long Night. The tune was the Hunger Tone underneath, the long drone on the low string that you heard in the Lantern House and in the Wardens' chapel at the Anchor, but Hanne's version had words over it, old words, worn smooth.\n\n*The door grew narrow in the dark,\nthe Reach was cold and small,\nthe First Warden heard it hunger\nand the Reach gave of its all.*\n\n*They loaded glass in little ships\nand flew them through the night,\nand what the Needle keeps, it keeps,\nand in the morning, light.*\n\nThere were more verses. There were always more verses; Hanne had collected forty of them, from forty different tellers, and they contradicted one another on almost every point. Isra had heard them all. She listened anyway, with her eyes closed, her head on her grandmother's knee and the warm drone of the low string going through her.\n\n\"Is it true?\" she said, when it was finished.\n\n\"Which bit?\"\n\n\"Any of it. That it's hungry. That feeding it works. That there was a First Warden who heard it.\" She opened her eyes. \"Gran, everybody on the speakers is going to be saying it's true for sixty days. I want to know if it's true.\"\n\nHanne was quiet for a long moment.\n\n\"I don't know,\" she said. \"I'll tell you what I know, and you can do what you like with it. There was a Concession, before the Compact. That's true. A company from the Inward that owned everything and everybody, and dug the salt, and shipped the glass out through the door. There was a first Narrowing, a bad one, and there was a first Keeping, and the door opened. That's true too, or it's what everybody says, which isn't the same, but it's what we've got. Then there was the Compact, for three hundred years, and the Wardens, and the Draw, and they kept the door every four thousand days, and it opened. Then there was the Severance, and then there was the Quiet, and everything broke, and when it came back together nobody could remember properly how anything had been done. The Wardens kept on keeping. Then they kept less. Then for a while, my gran said, hardly anybody kept at all, and then the Lantern came and started again.\" She shrugged. \"That's it. That's what I know. Whether it's hungry I couldn't tell you. Nobody's ever asked it.\"\n\n\"The Lamplighter says the Returns mean it's starving.\"\n\n\"The Lamplighter would. She has to say something, poor cow. She put her own boy in it.\" Hanne set the cittern upright against her knee. \"The Wardens say it's dying. That's all I've heard from them, the last ten years. *It's dying.* Never why.\"\n\nIsra was quiet. Then, without quite knowing why she did it, she unclipped the fist of banded glass from her belt and held it up.\n\n\"I kept this back. From the Return. Look.\"\n\nHanne took it and turned it in the lamplight, and her eyebrows went up. \"Well, that's a pretty thing. Layered. I've never seen glass layered like that.\" She held it closer to her face, squinting. \"Like a cake.\"\n\n\"It was at the root. Where it grew out of the hull. It's all like that, all the way down, and it all leans the same way.\" Isra did not know how to say what she meant. \"Like it was pushed. Like something pushed the ship out and the glass grew while it was being pushed.\"\n\nHanne looked at her, and then at the glass, and did not say anything. Then she did a strange thing: she held the chunk of glass out over the cittern, close to the strings, the way you might hold a cup under a tap, and with her other hand she plucked the low string. The drone sounded. And the glass — Isra heard it, she would have sworn she heard it — the glass hummed back. Very faint. A note under the note, sweet and thin, like a fingertip on the rim of a wineglass, there and then gone as the string died.\n\nThey both sat very still.\n\n\"Huh,\" said Hanne.\n\n\"What was that?\"\n\n\"I don't know.\" Her grandmother's voice was odd. She plucked the string again, and again they heard it, the faint sweet answering hum from the glass in her hand. \"My gran used to say — this was her gran's, I think, or some teller before — she used to say that glass sang, back when the door was well. That the cutters used to hear it singing in the seams, down in the salt, like it was answering something. I always thought it was one of those things people say.\" She looked down at the glass. \"I've never heard it. Not once in my life.\"\n\n\"It's not singing now. It's — answering the string. That's all.\"\n\n\"Is it?\" said Hanne.\n\nShe held the glass out to Isra, and Isra took it. It was cold in her hand, from the mouth, the deep cold that never quite went out of Return glass. She held it, and Hanne plucked the low string one more time, and Isra felt it, through the palm of her hand, tiny, unmistakable: the glass shivering against her skin, like something alive. Like something trying to tell her a thing in a language she did not have.\n\nOutside in the tunnel somebody's speaker was playing the Lamplighter's proclamation again, from the beginning, the warm low voice coming small and tinny through the ship-door. *Children of the Reach. Listen to me now.*\n\nIsra put the glass inside her shirt, against her skin, where she could feel it, and sat with her head against her grandmother's knee, and listened.\n","wordCount":1576,"createdAt":1793093146685,"updatedAt":1793093146685},{"id":"IPJxcnKZ1IY1SON4SHfcI","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"NMFiRPEGMSBYJ4zYLOJeS","text":"The order came through the day after she got back aboard: the *Vigil* was detached from the Shoals patrol and assigned to the close escort of the Thirtieth Keeping, with station at the Anchorhold from the twentieth of November until the Narrowing.\n\n\"They're giving us the Keeping,\" said Marsh, reading it off the slate in her day cabin with his eyebrows up. \"That's — Captain, that's an honour. That's a flag posting. Six weeks parked at the Anchorhold guarding the glass stores and then we fly the Keepers to the mouth.\" He looked up and saw her face, and his own changed. \"Oh. Oh, Captain. I didn't think. I'm sorry.\"\n\n\"Don't be. It's an honour.\" Juno took the slate off him. \"Somebody pulled a string for it. I'd like to know whose.\"\n\n\"The Admiral, probably.\"\n\n\"Probably,\" Juno said, and did not believe it.\n\nMor, she thought. Or her mother. Either of them could have done it, for opposite reasons. She did not know which would be worse.\n\nThe other message came in on the evening watch, on a channel it should not have been able to use: a Shoals relay, bounced off three rocks and an abandoned ore station, unencrypted, plain text, addressed to her by name. Marsh brought it to her himself, with the door shut behind him.\n\n\"It came in on the old Academy frequency,\" he said. \"The cadet band. Nobody's used it in years. Comms only caught it because Siddiq's a sentimental idiot and still listens to it.\" He put the slate down in front of her. \"Captain, if this gets logged — \"\n\n\"It's logged,\" Juno said. \"Everything's logged. Leave it with me.\"\n\nHe left it with her. She read it once.\n\n*JUNO. I HEARD ABOUT PELL. I'M SORRY. YOU KNOW I AM. ASK THEM HOW THE NAMES ARE CHOSEN. — R.*\n\nShe sat with the slate in her hands for a long time.\n\nRhee Calder had been in her year at the Academy. They had shared a simulator pod for two years and a bed for six months of the third, and he had been the best pilot in their intake and the worst at doing as he was told, and she had loved him in the uncomplicated way you love someone at twenty. He had a younger brother, Callum. At the Twenty-Ninth Draw, eleven years ago, when Juno was twenty and Rhee was twenty and Callum was eighteen, the Wheel had turned and Callum Calder's name had come out of it. He had flown. He had not come back. Rhee had gone very quiet, and stayed quiet through their last year, and two days after commissioning he had taken a Compact patrol cutter out on a routine flight to the Shoals and not brought it back either. Six years ago, when the Shoals refused their quota, the Free League's first fleet commander had been a man the Compact papers called the Saltjack, and the face in the grainy picture had been his.\n\nShe had fired on his ships. He had fired on hers. They had never spoken since.\n\n*Ask them how the names are chosen.*\n\nShe thought of the Hall. The seventh slip of foil. The High Warden's eyes lifting to the Speaker's terrace before he read. *I hope she will remember that her daughter flies in it.* She thought of Sister Quill at her desk: *two hundred and six petitions. He has declined every one.* The one place in the Reach where everyone was the same.\n\nShe logged the message, as regulations required, with a note — *unsolicited enemy contact, no reply sent* — and sent it up the chain to Squadron. Then she sat for a while longer in the dark of her cabin, with the *Vigil*'s engines thrumming through the deck and the slate's afterglow fading on her palm, and found that she had memorised it anyway.\n","wordCount":646,"createdAt":1793093538710,"updatedAt":1793093538710},{"id":"Sj7iF2uJpwtFvbZf8-Vsb","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"aXBT-PzJf6aKLcLyvEl3T","text":"The Assembly Hall in Tallow was the oldest room in the Reach: a cavern cut into the salt by the first Concession machines, its walls still scored with their long curved grooves, its ceiling so low at the back that tall men stooped. Nobody had built anything in it. Nobody had put up a gallery or a terrace or dressed the salt with stone. There were benches, and a platform at the front, and a single bank of floodlights that made everyone look ill, and that was all. The Concession held its notices here, and its inquiries, and its debt hearings, and on the fifteenth of March it held the Director's address, and the room was so full that people stood in the doorways and sat on the floor between the benches and climbed on each other's shoulders at the back.\n\nTeo stood against the wall halfway down, with Corrigan beside her and Nico on her other side, and watched Hesper Vane walk out onto the platform without any notes.\n\nShe did not hurry. She walked to the front of the platform and stood there with her hands folded and waited for the room to be quiet, and it took a long time, and she waited, until it was.\n\n\"You know there is a Narrowing,\" she said. \"I told you so on the second. I told you it would be deep. I'm here to tell you how deep.\"\n\nShe told them. She told them in numbers. She did it the way Teo imagined she did everything, precisely and in order, without softening anything: the waist at sixty-one per cent of nominal on the second, at fifty-two on the ninth, at forty-eight this morning. The rate of narrowing. The projections. She said that the Concession's throat-readers did not know whether the waist would stop narrowing before it reached zero. She said that if it reached zero the Needle would close, and that a closed Needle had never been observed, and that no one could say whether it would ever open again.\n\nThe room had been quiet. It became something else, a silence with a held breath in it.\n\n\"I am not here to frighten you,\" Hesper Vane said. \"I am here to tell you what we are going to do about it.\"\n\nShe told them that too.\n\nShe said that the throat of the Needle was held open by a ring of exotic matter at its waist — that this was known, that it had been known for fifty years. She said that brine-glass was the same kind of matter, in a cruder form. She said that the Concession's analysis indicated that the waist was narrowing because the ring was weakening: because it was, in effect, starving. And she said that if brine-glass were delivered to the waist during the Narrowing, released there at the narrowest point, it would brace the ring as a splint braces a bone, and the throat would hold.\n\n\"We will feed it,\" Hesper Vane said. \"That is the long and the short of it. We have the glass. We are sitting on the largest deposit of brine-glass in human space. We will take it out to the Needle in the Narrowing and we will feed it to the throat, and the throat will hold. I am calling it the Keeping.\" She let the word sit. \"It will require pilots. It will require pilots who are willing to take a small ship, loaded with glass, into the throat during the Narrowing, to the waist, and release their load there, and come back. I will not pretend to you that this is safe. It is not safe. It has never been done. It is the most dangerous flight anybody in the Reach has ever been asked to make.\"\n\nShe looked out over the room.\n\n\"So I will make this offer, and I will make it once. Any pilot who flies a Keeping run — any pilot who goes to the waist and releases their glass — will have their indenture cancelled. In full. Not reduced. Cancelled. And not only theirs. Their family's. Every debt held by the Concern against every member of their household, struck off the books on the day they fly.\" A pause. \"That is my offer. Thank you.\"\n\nThe noise came up out of the room like water out of a burst pipe.\n\nTeo did not hear most of it. She was looking at Hesper Vane, standing quite still on the platform with her hands folded, waiting for it to subside the way she had waited for the silence; and she was thinking of Ambrose Lyle's face in the mirror with the headphones on, two days ago, at the inner markers. *Like a drawstring. Very slowly. Very evenly.* He had not said anything about starving. He had not said anything about a ring weakening. He had said *I don't know why it's narrowing*, and he had been the man who would know.\n\n\"Feed it,\" said someone at the front, very loud. Mother Salome. She had stood up on her bench, tall and stooped, a head above everyone round her, and the floodlights made her face look like a carving. \"You want to feed it. Feed it what, Director? Our glass, you said. Our glass, that our children cut out of the salt and die of. Our pilots, that you'll send into the dark in little ships. You want us to feed it our children.\"\n\n\"I want you to keep it open,\" said Hesper Vane. \"So that your children have a door.\"\n\n\"A door for what? Your ships leave in six weeks. What's on the other side of that door for us, Director? The Board? Ardent? The people who hold our paper?\"\n\n\"Everything is on the other side of that door,\" Hesper Vane said evenly. \"Medicine. Machines. Seed stock. Every ship that will ever come to the Reach. Every ship that will ever leave it. If the Needle closes, Mother, there is no other side. There is the Reach, alone, forever. Ask yourself whether your children would thank you for that.\"\n\nSalome stood on her bench and said nothing. Teo had never seen her with nothing to say.\n\n\"It's a lie,\" said Nico.\n\nHe said it quite quietly, beside Teo, and then much louder, and then he was on the bench too, and the cutters round him were looking up at him with their faces lit by the floodlights. \"It's a lie. She doesn't know it's starving. Nobody knows. She's just — she's *saying* it. She needs the glass shipped and she needs us scared and she needs us to — \"\n\n\"Nico,\" Teo said. \"Get down.\"\n\n\"— to keep sending it after they've *gone*, that's what this is, it's a way of keeping us — \"\n\nMarshal Brandt's men came through the crowd from the doorway, four of them, big, unhurried, in the grey of Concern Security, and the crowd parted for them the way water parts for a hull. Nico saw them coming and kept talking. He was still talking when they reached him. Two of them took his arms and lifted him down off the bench as easily as lifting a child, and he kicked and shouted, and one of the cutters beside him swung a fist, and Brandt himself, who had come up behind his men, put out one large hand and caught the fist in mid-air and held it, without apparent effort, and looked at the cutter until he lowered his eyes.\n\n\"Out,\" said Brandt. \"All of you. Now. Quietly.\"\n\nThey took Nico out. Teo went after him. She shoved her way along the wall with Corrigan behind her, and caught them in the passage outside, where the Security men had put Nico against the salt and were going through his pockets. Brandt was watching. When he saw Teo he raised one finger, not to her, but to his men, and they stopped.\n\n\"Kesh,\" said Brandt. \"The pilot.\"\n\n\"He's my brother.\"\n\n\"I know who he is.\" Brandt's voice was mild. \"Take him home. He's not charged. The Director doesn't want anybody charged tonight. Take him home and tell him the Director doesn't want anybody charged tonight.\" He looked at Nico. \"Tonight.\"\n\nThey let him go. He came off the wall with blood on his lip and his eyes blazing, and Teo took him by the back of the neck the way their mother used to, and walked him away down the passage, and he let her.\n\nCorrigan walked with them in silence as far as the Lantern Row lift. Then, at the lift door, with Nico gone ahead into the car, he put his hand on Teo's arm.\n\n\"Teo.\"\n\n\"Don't.\"\n\n\"I haven't said anything.\"\n\n\"You're going to say *cancelled in full*. You're going to say *Lulu's too*.\"\n\nHe was quiet. His hand stayed on her arm. Under the lift's bad light his face looked older than it was, and she remembered all at once, for no reason, a night eleven years ago on the Brannock with the canopy full of stars and his laugh in the dark.\n\n\"Lulu's too,\" he said softly. \"Teo. She's nine. She'll be paying off Mira's medical till she's fifty. Mine. My father's. She'll never — \"\n\n\"It's never been done, Corr. You heard her. Nobody knows what's at the waist. Nobody's ever *been* to the waist in a Narrowing. I was at the inner markers two days ago in the Mercy and I nearly didn't come back, and that's the *edge*.\"\n\nHe looked at her strangely. \"You were at the inner markers?\"\n\n\"Charter.\"\n\n\"In a *tug*?\"\n\n\"Don't change the subject.\"\n\n\"I'm not.\" He let go of her arm. He smiled, a little, the old smile. \"I'm just thinking that if you can do it in a tug,\" he said, \"so can I.\"\n\nThe lift door opened. Nico was inside, holding the door, with blood on his lip. Teo got in. Corrigan did not.\n\n\"Corr,\" she said.\n\n\"I'll see you on the lanes,\" he said, and the door closed.","wordCount":1672,"createdAt":1793093335588,"updatedAt":1793093335588},{"id":"XIfydHoQy7NIA__zfYSZ9","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"fX6guNlO_7rM3diVA0x-p","text":"The Speaker's rooms were on the Terrace level of Tallow Under, high enough to have a window onto one of the great light-wells, and when Juno was a child she had thought it was the finest view in the Reach: a hundred metres of shaft dropping away below, terraced and planted, lit by Caul's banded glow from above and by the thousand small lamps of the houses cut into its walls, like looking down into a well full of stars. She stood at it now with a glass in her hand that she had not drunk from and looked at nothing.\n\nThe Wardens had brought Pell home at nineteen hundred. They would come for her again in the morning to take her up to the Anchorhold, where the nine would live and train together until the Narrowing — fifty-eight days, now. She had been given the night with her family. It was customary.\n\nPell was in her room, packing. She had been packing for an hour. Juno could hear her through the wall, moving about, humming. Humming the Hunger Tone.\n\nTheir mother sat at the table with a slate in front of her that she was not reading.\n\n\"I'll put in for substitution,\" Juno said to the window.\n\n\"Juno.\"\n\n\"It's allowed. A volunteer of age can stand in for a drawn Keeper with the High Warden's leave. I'm thirty-one. I'm of age. It's in the Articles.\"\n\n\"It's in the Articles,\" her mother agreed. \"It has been granted four times in three hundred years.\"\n\n\"Then it'll be five.\"\n\n\"Juno.\" Efua Asante put the slate down. \"Sit down.\"\n\n\"I don't want to sit down.\"\n\n\"I know. Sit down anyway.\"\n\nJuno sat down. Her mother looked at her across the table, and for a moment the civic face slipped, and what was under it was so naked and so old that Juno had to look away.\n\n\"You think I haven't thought of it,\" her mother said quietly. \"You think I didn't think of it before he'd finished saying her name. I'm the Speaker. There is nothing in the Articles I haven't read. There is no petition, no appeal, no procedure, no favour I could call in, that I have not thought of in the last six hours.\" She spread her hands flat on the table. They were shaking slightly; Juno had never seen them shake. \"And she doesn't want any of them.\"\n\n\"She's nineteen.\"\n\n\"She's nineteen,\" her mother agreed. \"And she's my daughter, and she believes in it, and she wants to go. Have you talked to her?\"\n\nJuno had not. She had come home and gone to the window.\n\nShe went to Pell's room. The door was open. Pell was sitting on the floor among her canvases, with a duffel half-packed beside her, holding a painting on her knees and looking at it. The room smelled of oil and turpentine and the faint sweet resin of the varnish she used. Every wall was covered. Pell painted the Needle. She had painted nothing else since she was fourteen: the Needle from Hollin's surface, a smear of wrong stars over the salt pans; the Needle from the Anchorhold, huge and bruise-dark; the Needle as nobody had ever seen it, from inside, from the throat, in colours that did not exist — a long tunnel of folded light opening and opening into something that was not quite white. Juno had never known what to say about them. They frightened her a little.\n\n\"Hey,\" Pell said, without looking up.\n\n\"Hey.\"\n\n\"I can't take all of them. They said one bag.\" Pell turned the painting on her knees toward the light. It was one of the throat ones. \"I thought maybe this one. Do you think this one?\"\n\n\"Pell.\"\n\n\"I know.\" Pell put the painting down very carefully, face up, on the floor. \"I know what you're going to say. You're going to say you'll put in for substitution.\"\n\n\"Yes.\"\n\n\"Please don't.\"\n\n\"Pell —\"\n\n\"Please don't, Juno.\" Her sister looked up at her, finally, and her eyes were red and perfectly calm. \"I know you think it's — I know what you think. You've been out there for six years taking names off Shoals kids. You think it's a machine for killing people. I know.\" She took a breath. \"But it's not, to me. It's never been. Ever since I was little I've — you remember when we went up to the Anchorhold for your commissioning, and they let us into the Lectern, and I heard the harp? I was eight. I heard it and I thought, *that's it, that's the sound, that's what everything is.* And I've been painting it ever since and I can never get it right. I can never get the inside of it right.\" She gestured at the walls, at the tunnels of impossible light. \"And now I'm going to see it. Me. Out of everyone. The Wheel chose me.\" Her voice shook for the first time. \"Do you know what that's like? To be chosen? To have your name come out of the Wheel and know that it means something, that you mean something, that the whole Reach is going to stand in the Hall and sing for you? I'm not afraid, Juno. I keep waiting to be afraid and I'm not.\"\n\nJuno knelt down among the canvases, because her legs were not reliable, and put her arms round her sister, and Pell let her, and they stayed like that for a long time without speaking. Pell smelled of turpentine. Through the wall, from the window, came the far, faint sound of someone singing in the light-well below: the Hunger Tone, held and held, as it would be held in every house in Tallow Under tonight.\n\nWhen Juno came back out, her mother was standing at the window where Juno had stood.\n\n\"Well?\" said Efua.\n\n\"She wants to go.\"\n\n\"Yes.\"\n\n\"I'm putting in for substitution anyway.\"\n\n\"I know you are.\" Her mother did not turn round. In the glass Juno could see her reflection, faint, laid over the well of lights below; the civic face was back on, perfectly composed. \"Juno. When he read the name. Did you see his face?\"\n\nJuno was quiet for a moment.\n\n\"He looked at our terrace,\" she said. \"Before he read it.\"\n\n\"Yes,\" said her mother. \"He did.\"\n\nNeither of them said anything else. Below them, in the well, the singing went on, and on, and on.\n","wordCount":1072,"createdAt":1793092973448,"updatedAt":1793092973448},{"id":"XJwbEs-_-YLKEd6LzuYMg","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"l5bRaZgZBxOt2ptfbKZe3","text":"The harp was singing in a key Ambrose Lyle had never heard it use.\n\nHe had built the thing. Twenty-three years ago, a younger man with a younger man's back, he had strung its first course of resonator wires across a frame of fused silica in a workshop in Port Ardent and shipped it through the Needle in crates and assembled it here under the dome, and he had played it — that was the word everyone used, though it was a matter of listening and not of playing — every working day since. He knew its voice the way you knew the voice of someone you had been married to. It hummed. In its ordinary moods it hummed a soft, wide, many-stranded chord, the throat's noise turned into sound, and a reader sat at the console and listened and watched the traces and drew the throat's shape for the pilots who would fly it. It had sung louder before, and softer. It had never sung like this: thin, high, drawn tight, the whole chord pulled up into its upper strings and straining there like a held breath.\n\n\"Again,\" he said.\n\nBettany Shore, at the second console, ran the sweep again. She was twenty-two and had been his junior for eight months, and she had the kind of face that showed everything, and what it showed now was that she wanted very much to be told that this was normal.\n\n\"Waist reading's at sixty-one per cent of nominal,\" she said. \"It was seventy-four an hour ago. It was ninety-eight yesterday.\"\n\n\"And the rate?\"\n\n\"It's slowing. I think it's slowing.\" She looked at him. \"That's good, isn't it? If it's slowing?\"\n\nAmbrose did not answer. He took off his reading glasses, and polished them on his shirt, and put them back on, which was what he did instead of swearing. Then he reached into the pocket of his jacket and took out the fork.\n\nIt was brass, fifteen centimetres long, its two tines worn bright at the tips and dull at the root where his thumb went. On the stem, in a hand engraver's tidy capitals, it said A. L. — 440 — FOR CLARE. He had bought it in a music shop in Ardent the year his daughter was born, because she had been born in A, as he used to tell her — screaming on a concert pitch, the midwife said, you could have tuned an orchestra — and he had had it engraved for her as a joke, meaning to give it to her when she was old enough to think the joke was funny. She had been four when he took the Concern's posting. She was twenty-seven now. He had the fork still. Every instrument he had built since had been tuned to it, because there was a peculiar comfort in the thought that every measurement he made of the most extraordinary object in human space was referred, in the end, to a note his daughter had screamed in a delivery room. He had never told anyone that.\n\nHe struck the fork against the heel of his hand and touched its stem to the reference plate, and the harp's tuning monitor took the note and laid it across the traces like a ruler. He watched the strings settle against it. Drift was nothing. Drift was a hair. The instrument was true.\n\nSo the throat was doing this. Not the harp. The throat.\n\n\"It's a Narrowing,\" he said.\n\n\"There was a Narrowing in eighty,\" Bettany said. \"I read the logs. It closed for six hours. Nobody died.\"\n\n\"There was a Narrowing in eighty,\" Ambrose agreed. \"And sixty-nine, and fifty-eight, and forty-seven, every four thousand days, give or take, as long as there have been people here to watch. Six hours. Four hours. Nine. The waist went down to eighty per cent of nominal in eighty and everyone was very excited and wrote papers.\" He looked at the trace, the bright line crawling down the screen. \"We are at sixty-one, and sixty days out from where the cycle says the trough should be. It is not going to be six hours.\"\n\n\"How long?\"\n\n\"I don't know.\"\n\n\"Could it —\" She stopped.\n\n\"Close?\" He made himself say it, because someone was going to. \"I don't know that either. Nobody knows. Nobody has ever seen one go this deep. We don't have a model for this. We have four data points and a lot of hope.\" He heard his voice and disliked it. \"Bettany. Log the sweep. Log everything. Don't round anything.\"\n\nThe door at the back of the dome slid open, and the Director came in.\n\nHesper Vane did not hurry. Ambrose had known her for eleven years and had never seen her hurry; he had sometimes wondered whether she was physically capable of it, whether some childhood injury had removed the faculty. She was a slight, straight woman of forty-seven with grey cropped hair and the Concern's sunburst at her collar, and she came across the dome to his console at the pace of someone crossing a room to look at a painting, and stood at his shoulder, and looked at the trace.\n\n\"Mr Lyle,\" she said.\n\n\"Director.\"\n\n\"Tell me.\"\n\nHe told her. He told her the way he would have told a student, carefully and in order, because he had found that this was the only way to talk to Hesper Vane: she would follow you anywhere you could actually go and nowhere you could not. The waist. The rate. The four previous Narrowings and their depths. The fifty-nine days. She listened without interrupting. When he had finished she was quiet for a while, looking at the line.\n\n\"Can it close?\" she said. \"Permanently.\"\n\n\"I don't know.\"\n\n\"That isn't an answer.\"\n\n\"It's the only honest one I have. Nobody has a theory of the Needle, Director. We have observations. The observations say it has always opened again. The observations are fifty years long. The Needle is\" — he lifted a hand toward the dome, where the bruise of the mouth hung huge and silent beyond the glass — \"considerably older than fifty years.\"\n\n\"So it can.\"\n\n\"It might. It might not. If you want a number I will invent one for you, but I would be inventing it.\"\n\nShe nodded slowly, as if he had confirmed something. \"Then nobody else knows either,\" she said. \"Until I say.\"\n\nAmbrose looked at her.\n\n\"I want this kept in this room,\" Hesper Vane said. \"The readings, the projections, all of it. Miss Shore.\" Bettany jumped. \"You will log everything Mr Lyle asks you to log, and you will log it to the Director's channel and to nowhere else, and you will speak to no one about it, including your mother, your friends, and the very attractive young man in Approach Control you spend your breaks with. Do you understand?\"\n\nBettany went red to the ears and said that she did.\n\n\"There is going to be an announcement this evening,\" Hesper Vane said to Ambrose, more quietly. \"About other matters. It would be unhelpful if this were the subject of conversation in every bar on Lantern Row before I had made it.\"\n\n\"Other matters,\" he said.\n\nShe looked at him for a moment, and something in her face that was not quite kindness decided to tell him. \"The Board isn't renewing the Charter,\" she said. \"We are withdrawing. All salaried staff, all equipment that pays for its passage. The *Providence* sails on the twenty-eighth of April and she will be the last Ostrander ship through the Needle. The Concession continues. The debts continue. But the Concern will manage it from Ardent, at a distance, through local administration.\" A small, dry pause. \"Through me, in point of fact. I'm staying.\"\n\nHe had heard rumours. Everyone had heard rumours. He found that hearing it said made a hollow place open in his chest, very quickly, the way the floor of a lift drops.\n\n\"Your berth on the *Providence* is confirmed, of course,\" she said. \"Senior grade. I put it through myself this morning.\" She glanced at the trace. \"Assuming there's a Needle for her to sail through on the twenty-eighth. Which, if I understand you, is in fact a question.\"\n\n\"The trough is around the first of May,\" he said. \"If the cycle holds. She'd sail three days before.\"\n\n\"Then let's hope it holds.\" Hesper Vane straightened. \"Go home, Ambrose. You've earned it. Your daughter will be glad. Keep this room quiet until then, and give me the numbers every six hours, and go home.\"\n\nShe went out, at the same unhurried pace. The door slid shut behind her.\n\nBettany let out a breath that she seemed to have been holding since the Director came in. \"Is that true? We're leaving? The whole Concern?\"\n\n\"So it seems.\"\n\n\"But what happens to — everyone? Here?\"\n\nAmbrose turned the fork over in his fingers. Through the dome the Needle hung, vast and patient, its rim of bent stars drawn in just perceptibly tighter than it had been that morning. He thought of forty thousand people on Hollin, dug down into the salt in their towns, cutting glass to pay off debts that the Concern would go on owning from the far side of a door that might be closing. He thought of Clare, whose face he could not quite remember, whom he would see in fifty-seven days.\n\n\"Log the sweep,\" he said. \"Don't round anything.\"","wordCount":1579,"createdAt":1793092538534,"updatedAt":1793092538534},{"id":"YXdSEYzrL61jBCEzLcFQ3","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"b3Wc8OM2EVjz0QZXPuc4_","text":"At two in the morning, station time, Ambrose sent Bettany to bed and sat on alone at the harp.\n\nThe dome was dark except for the consoles. Beyond the glass the Needle's mouth filled half the sky, and in the dark it was easier to see the ring of light the pilots called the Eye, faint and grey and very slightly irregular, like a coin worn by thumbs. He had read somewhere, long ago, that the brain is built to see faces in things. He had never seen a face in the Needle. He had sometimes thought he saw attention.\n\nHe put on the old headphones, the ones with the cracked band, and listened.\n\nThe harp was quieter now. The waist had held at sixty for four hours. The high strained chord had relaxed a little, back down toward something like its old self, and under it — he had to close his eyes for this — under it there was the deep wide hum of the throat, the sound he had spent twenty-three years learning. He let it fill his head. He had told Hesper Vane the truth: nobody had a theory of the Needle. But he had sometimes thought, in the middle of the night, with the headphones on, that he was closer to one than anybody, and that it was not a theory he could write down. It was the sound. It was knowing the sound.\n\nAnd there was something in it tonight that he did not know.\n\nIt was very faint. It was so far down that at first he thought it was the station: a pump somewhere, a ventilation fan, the long slow flex of the wheels. It was lower than the lowest course of the harp, below hearing really, a thing he felt in the bones of his face more than heard — a slow swell, rising and falling over a period of minutes, like a sea under a ship. It was not in the traces. He checked. The traces showed nothing but the waist and its strain. It was only in the sound, in the long wide chord, a kind of tide.\n\nHe sat with it for half an hour.\n\nThen he took the fork out of his pocket and struck it against his hand and held it to the reference plate, and listened to the note lie down across the chord like a ruler, true; and the swell was still there underneath, rising and falling, rising and falling, patient as breathing.\n\nDrift, he told himself. An artefact of the strain. A beat between strings pulled out of their ordinary tension. He wrote a note in the log — *low-frequency swell, period approx. 4 min, source unknown, probably instrumental* — and looked at the word *probably* for a long time, and did not cross it out.\n\nFifty-seven days. He put the fork back in his pocket and kept his hand on it, and sat in the dark with the Needle and listened to it breathe.\n","wordCount":502,"createdAt":1793092538252,"updatedAt":1793092538252},{"id":"aM0xxIwD7omU97KzSzfkO","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"txcIkW7ctOiz0OWK3N5id","text":"The raider came out of the shadow of a rock called Dorcas Four, which was exactly where Juno Asante had said it would, and for one clean second she let herself enjoy being right.\n\n\"Contact,\" said Marsh at tactical. \"Bearing two-one-one, low, one ship. Small. She's running cold, Captain, I've only got her on optics — there. There. She's going for the third sled.\"\n\n\"I see her.\" On the main display the convoy strung away ahead of the *Vigil* in a long careful line: four ore-tugs and their tow-sleds of Shoals glass, bound in for Hollin and the Keeping stores, with the *Vigil* riding behind them like a dog behind sheep. The raider was a fleck of shadow crossing the face of the rock. \"Helm, come to two-one-one, all ahead full. Weapons, wake up the forward battery. Hollis, I want everything you've got in the next ninety seconds and I don't care what it costs the bearings.\"\n\n\"It'll cost the bearings,\" said Chief Hollis from engineering, sounding pleased about it, and the corvette leapt.\n\nThe *Vigil* was nine years old and had been at war for six of them. She had been built as a fast picket, long and narrow and lightly armoured, with a forward battery that could ruin a freighter's day and not much else, and she had been patched and re-patched through the whole of the Severance until there was more repair in her than original hull. Juno had commanded her for two years. She loved her the way you love a dog that has bitten you more than once in your own defence.\n\nThe raider saw them coming. It broke off from the third sled — too late; it had already put a grapple on the tow-frame and was trying to cut the sled loose and run with it — and for a moment the two ships hung there on the display, the little raider tethered to forty tonnes of glass it could not let go of and could not drag, the *Vigil* coming down on it like a thrown knife.\n\n\"Hail her,\" Juno said. \"Open channel. Tell her to cut the grapple and stand down and nobody gets hurt.\"\n\nMarsh hailed. The raider did not answer. It fired its thrusters again, hard, and the sled lurched on its frame.\n\n\"She's trying to snap the tow,\" Marsh said. \"If she snaps it the sled goes tumbling and takes out the fourth tug behind it.\"\n\n\"Forward battery,\" Juno said. \"Target her engines. Not the hull. Engines only.\"\n\n\"Captain —\"\n\n\"Engines, Danny.\"\n\nThe battery fired. On the display the raider's stern bloomed white and then dark, and the little ship slewed round on its own grapple line and hung there, spinning slowly, venting something that glittered. The sled steadied. The convoy came on.\n\n\"Good shooting,\" Juno said, and meant it, and let her breath out.\n\nThey took the raider under tow themselves, because there was nobody else to do it, and Juno went across with the boarding party in a suit that smelled of the last person who had worn it. The raider was a Shoals-built cutter, home-made from three other ships, with a hand-lettered name on the airlock that read *NO MORE*. Inside it was very cold, because the engine hit had taken out the heat. Inside it there were six people.\n\nThe oldest was perhaps twenty. The youngest — Juno looked at her for a long time — the youngest could not have been more than fifteen, a thin girl with a shaved head and a Shoals clan tattoo along her jaw, holding a pry-bar as though she meant to use it on a corvette's boarding party. Behind her the others had their hands up. One of them was crying with the steady, exhausted crying of someone who has been crying for a while.\n\n\"Put it down,\" Juno said, through her helmet speaker.\n\n\"You put yours down,\" said the girl.\n\n\"I'm not holding anything.\"\n\n\"You're holding a warship,\" the girl said, and her voice cracked across the middle of the word, and she put the pry-bar down.\n\nThey were Draw-dodgers. Juno had known before she came across. The Shoals sent a quota of names into the Wheel at every Draw, one for every three hundred souls, and this time the Shoals' Free League had refused to send any at all — that refusal was the whole of the war — and the Compact had sent the Navy into the Shoals to take the names by registry instead. Six years. Six years of boarding habitats and copying registries and escorting Draw officers with their slates, and boys and girls like these slipping out on stolen ships to wherever the registries could not find them, and raiding glass convoys on the way because a sled of glass would buy you a new name in any of a dozen rocks that did not ask questions. Juno had boarded fifty ships like the *No More*. She had not got used to it. She had got used to not getting used to it.\n\n\"We need medical across,\" she said to Marsh on the private channel. \"The heat's gone. They'll be hypothermic in an hour.\"\n\n\"Aye, Captain. And — Captain. Signal from Squadron. Admiral Greaves.\"\n\nShe went back across with the medics and took it in her day cabin with her suit still half on. Tobiah Greaves's face on the screen was square and grey and tired, the face of a man who had been winning a war for six years and had begun to suspect he was not going to finish it.\n\n\"Good work on the convoy,\" he said. \"The Shoals cutter. You took her intact?\"\n\n\"Engines only, sir. Six aboard. Draw age, or near it. One's a child.\"\n\n\"Registered?\"\n\n\"I don't know yet, sir.\"\n\n\"They'll be registered somewhere. Hand them over to the Wardens' officer at Hollin, they'll know what to do.\" Greaves looked at something off his screen. \"Asante, there's another matter. You're relieved for seventy-two hours as of arrival. Marsh can take her round to the yards. You're to attend the Draw in person.\"\n\n\"Sir, I —\"\n\n\"Your mother's orders, not mine,\" Greaves said. \"Or the Speaker's office, which I'm told is not the same thing. The Speaker would like her family seen at the Hall. It's the Thirtieth, Asante. It's a deep one. People need to see the Speaker's family standing up with everybody else.\" He paused. \"Your sister's of age this time, isn't she?\"\n\n\"Nineteen, sir.\"\n\n\"Well,\" said Greaves, and seemed to look for something to say, and not to find it. \"Well. One in four thousand. She'll be fine. Go home, Commander. Stand where people can see you.\"\n\nThe screen went dark. Juno sat in her half-suit in the cold cabin and listened to the medics moving through the passage outside with the girl from the *No More*, who was swearing at them in a Shoals dialect, steadily and inventively, as if that was the only warm thing she had left.","wordCount":1166,"createdAt":1793092973909,"updatedAt":1793092973909},{"id":"ds39JFb5pXhQa4zY2mjNp","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"y0MYjP_qx3qpkSC3kc-xf","text":"The new one had come out of the mouth sometime in the night, and by the time Isra Venn got the Gristle out to it there were already scratches on its hull where somebody else's grapple had tried and slipped.\n\n\"Coopers,\" said Pike, at the back of the cockpit, looking at the marks. \"Or the Mallon girls. Mallon girls, I'd say. They always come in too fast.\"\n\n\"They didn't get it.\"\n\n\"They didn't get it,\" Pike agreed, and coughed, a long wet rattle that went on for some time, and spat into the rag he kept for it, and folded the rag away. \"You want me on the arm?\"\n\n\"I want you on the arm.\"\n\nThe Ossuary lay in the lee of the Needle's mouth, two hours out from the Pans at the Gristle's best speed, which was not a speed anybody would boast about. Nobody had planned it. Things that came out of the mouth came out slow, tumbling, and the mouth's own pull caught them and held them there in a long loose drift a few thousand kilometres across, like leaves caught in an eddy at the edge of a stream. Forty-odd hulls, the last time Isra had counted. More every month. They hung in the grey light at odd angles to each other, dark and still, some of them turning very slowly, all of them furred over with the pale stuff that made them worth the trip — glass, throat-grown glass, the best there was, crusted on the old metal as thick as a hand. You could live a season on what you could cut off one Return. You could live a year, if you were careful and the Lantern did not take it.\n\nBehind them, filling the whole of the canopy's upper arc, the Needle hung.\n\nIsra did not look at it much. Hardly anybody did, now. When her grandmother was a girl it had been a bright thing, Hanne said — a ring of light, the Eye, ships going in and out of it like bees at a hive. Isra had never seen a ship go into it. She had never seen the Eye. What hung over the Ossuary now was a dull bruise, a wound in the sky the colour of old blood, with a sick flicker at its rim that came and went like a lamp on a bad circuit. Sometimes you would catch it out of the corner of your eye, flickering, and feel your stomach turn over. That was all. It did not go anywhere. Nothing went through it. It was where things came out.\n\n\"Coming round,\" she said, and brought the Gristle in under the new one's flank.\n\nIt was a skiff. A Keeper's skiff, the narrow kind, a single seat and a cargo cradle and an engine and nothing else — the kind they had flown in the Keepings before the Quiet, Hanne said, though nobody alive had seen one flown. Twelve metres nose to tail. It had come out of the mouth tail-first and was turning end over end, very slowly, once every four minutes or so, and every time it came round the grey light slid across its hull and lit up the glass on it, and Isra caught her breath, which she did not often do.\n\nShe had seen a lot of Returns. She had never seen glass like this. It did not lie on the hull in a crust. It *grew* from it, out and out, in long branching fronds and plates and needles, as if the skiff had lain for a hundred years at the bottom of some sea that made glass the way the sea on Old Earth was supposed to have made coral. It was clear as water at the tips and milky at the root, and all of it, every frond, every needle, leaned the same way, swept back along the hull from the nose like hair in a wind.\n\n\"Look at that,\" said Pike softly.\n\n\"I'm looking.\"\n\n\"It's grown backwards.\"\n\n\"It's grown out. That's all.\" But she was looking at it the way he was. \"Get the arm on her. Midships, behind the cradle, where it's thin.\"\n\nThe Gristle's grapple arm was older than the Gristle and had been Pike's before it was hers, and he worked it the way a surgeon works, slow and exact, his big ruined hands quiet on the controls. The claw went out on its cable and closed on the skiff's flank where the glass was thinnest, and bit, and held, and Pike let out a long breath that became a cough. They matched spin. It took twenty minutes. Then Isra put on her suit and went over.\n\nInside the glass, the skiff was cold in the way only things from the mouth were cold, a cold that came through the gloves and into the bones of your hands. The canopy was frosted white. She knocked a window through it with the butt of her cutter and put her helmet lamp to the hole and looked in.\n\nHe was still in his seat. They always were. Strapped in, hands on the yoke, head a little forward as if he had been leaning to see something ahead of him. He was young — younger than her, she thought, though it was hard to tell with the frost on his face; a boy with a soft jaw and a lot of dark hair. His eyes were open. They were always open. At his throat, on a cord gone black, there was a small cloudy bead of glass.\n\nIsra looked at him for a while. Then she reached into the thigh pocket of her suit and took out one of the strips of grey cloth she kept there, and reached in through the hole in the canopy, and laid it over his face, and tucked the ends in under the edge of his helmet ring so it would stay.\n\n\"Isra,\" said Pike in her ear.\n\n\"I know.\"\n\n\"Clock's running.\"\n\n\"I *know*, Pike.\"\n\nShe cut for two hours. The cutter's blade went into the glass with a high clean whine that she could feel through her feet on the hull, and the fronds came away in long crystalline pieces that she bagged and clipped to the cable for Pike to reel in. It was good glass. It was very good glass, dense and sweet and clean, the kind that would make a Pans buyer go quiet and stop haggling. She took the fronds off the starboard side and the long plates off the cradle and started on the nose, where the growth was thickest, and somewhere in the second hour she stopped thinking and only cut, the way you do.\n\nThat was why she nearly missed it.\n\nShe had her lamp down in the root of the growth at the nose, where the glass met the metal, and the light went into the glass and came back to her strangely — not reflected but bent, sent off sideways into the crystal and back out again somewhere else, so that for a second there seemed to be a lamp shining up at her from inside the hull. She stopped cutting. She put her helmet close.\n\nThe glass at the root was not milky. It was layered. Fine bands of it, clear and cloudy, clear and cloudy, packed thin as pages, all the way down to the metal, so that looking into it was like looking down into the side of a cut cliff. And the bands did not lie flat to the hull. They rose up from it, every one of them, in a long sweep, like ripples frozen on water. Like something that had been pushed.\n\n\"Pike,\" she said.\n\n\"What?\"\n\nShe did not know what. She cut a piece of the root out — a fist-sized chunk with the bands in it — and bagged it, and clipped it to her own belt rather than the cable.","wordCount":1328,"createdAt":1793093147179,"updatedAt":1793093147179},{"id":"flwBln5xoaOg5AW4uxNRD","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"S-1QAgW06OX3j4fRmh9b3","text":"The Lantern cutter came out of the drift twenty minutes after she got back aboard, which meant they had been watching.\n\nIt was a long black ship with a lamp painted on its bow — a real lamp, an old hanging lantern, done in yellow with a little red flame in it — and it came in close and slow and stopped fifty metres off the Gristle's nose and sat there with its forward guns showing, the way you would let a dog see your stick. Isra watched it come from the pilot's seat with her helmet still on her lap. Behind her, Pike had gone very still.\n\n\"Gristle,\" said the radio. A man's voice, light, pleasant, almost apologetic. \"This is the Lantern cutter *Patience*, Deacon Rusk speaking. Good morning to you.\"\n\n\"Morning, Deacon.\"\n\n\"Is that Isra Venn? Old Hanne's girl?\"\n\nShe did not answer that. \"You want something, Deacon?\"\n\n\"I'm afraid I do. I'm afraid I want the Return you're tied to, and whatever you've cut off her, and I'm afraid I'm going to have to ask you to let go of her now.\" A pause. \"Please.\"\n\n\"She's ours. We had the arm on her first. It's on the log.\"\n\n\"I'm sure it is. But there's been a proclamation, you see. As of this morning.\" The voice was regretful, patient, as if he were explaining to a child why it could not have a sweet. \"You'll hear it in a moment, I expect. All glass is tithe. All Returns are the Lantern's. You can keep your arm and your log. It's the glass we need. Every gram.\"\n\n\"For what?\"\n\n\"For the Needle,\" said Deacon Rusk.\n\nIsra looked over her shoulder at Pike. He was sitting at the arm controls with his hands flat on his thighs, looking at the black ship in the canopy, and his face had gone a strange grey colour under the beard. He met her eyes and shook his head, very slightly. *Don't.*\n\nShe thought about the glass in the bags in the Gristle's hold, two hours of it, the best she had ever cut. A year's living. Hanne's medicine. The heater. She thought about the guns.\n\n\"Cut the arm loose,\" she said to Pike.\n\nHe did. The claw opened and the skiff drifted free, turning, its torn glass sparkling where she had cut it, the grey rag a small dark square in the white of its canopy. The *Patience* put out a grapple of its own and took it in.\n\n\"And the hold, if you would,\" said Deacon Rusk. \"I'll send a boy across.\"\n\nHe sent two boys across. They were young and polite and very thorough, in black coveralls with the lamp stitched on the shoulder, and they emptied the Gristle's hold of every bag and checked the lockers and the crawlspace behind the heater, and one of them found the little cache in the floor under Pike's seat and looked at Pike and said nothing and took that too. They did not search Isra. She sat in the pilot's seat with her helmet on her lap and the fist of banded root glass on her belt, under her hand, where she had put it when the *Patience* came out of the drift, and they did not search her, because she was a girl sitting in a seat and they were boys being thorough about lockers.\n\nWhen they had gone, the radio clicked, and changed, and every channel in the Reach began to speak at once in the same voice.\n\nIsra had heard the Lamplighter before. Everybody had. Mercy Oduya had been preaching from the old Assembly steps in Tallow for twenty-five years and from the Lantern House for five, and her voice came out of every speaker in the Gutter twice a week, warm and low and certain, a voice that sounded as if it was speaking only to you. Isra had never heard it like this. It filled the Gristle's little cockpit to the walls. It sounded like it was coming from inside the hull.\n\n\"Children of the Reach,\" said the Lamplighter. \"Listen to me now. The Sixtieth Narrowing is sixty days away.\n\n\"You know what the Wardens have told us. You have seen it yourselves. Since the Fifty-Eighth the door has not opened as it should. Since the Fifty-Ninth no ship has passed. The Inward is silent. And the Needle, which we were taught from our cradles would keep what we gave it — the Needle is giving it back. You have all seen the Returns. You have all seen what comes drifting out of the mouth with the dead in it. I have stood in the Ossuary and seen it with my own eyes. I have seen my own son's face in a dream every night for eleven years, and I tell you that the Needle is not giving back the dead to mock us. It is giving them back because it is starving. Because we have fed it less and less, generation after generation, a skiff here and three there, as if the covenant were a tax to be dodged. Because we stopped believing that it was hungry.\n\n\"It is hungry. It is dying of hunger. And when it dies, the door closes, and the Reach is alone in the dark forever.\n\n\"So hear me. At the Sixtieth Narrowing, the Reach will keep the Needle as it has never been kept. Not nine Keepers. A hundred. Not a cradle each. Every gram of glass that lies in every hold and every cache and every Return in the Reach. All glass is tithe from this day. All Returns belong to the Keeping. Those who give will be blessed. Those who hoard\" — the warm voice did not change, not by a hair — \"will be found.\n\n\"A Great Keeping, children. The greatest since the First. We will feed the door that it may stay a door.\n\n\"What the Needle keeps, it keeps for us.\"\n\nThe voice stopped. The channels went back to static.\n\nIn the canopy, the *Patience* was turning away, with the stripped Return held in its grapple like a cat with a bird, and the little rag of grey cloth was still there in the window, a dark square, very small.\n\n\"Pike,\" Isra said.\n\nHe did not answer. He had his rag out and was coughing into it, a long fit, worse than before, bent double over the arm controls. When he came up out of it his eyes were wet, and he would not look at her.\n\n\"You all right?\"\n\n\"Fine.\"\n\n\"A hundred Keepers,\" she said. \"Where's she going to get a hundred people who want to fly into that?\" She jerked her chin at the bruise in the sky.\n\n\"She'll get them,\" Pike said. He folded the rag away. His voice was flat. \"She got them last time.\"","wordCount":1143,"createdAt":1793093147008,"updatedAt":1793093147008},{"id":"wNITekP2YEqcm2YyCu11W","worldId":"os-ym7EwunyTMDieuRMb1","eventId":"qTwKP2JxoJ31y0x86T5by","text":"Past the last beacon the lanes ended and the sky went strange.\n\nTeo had been out to the outer markers a hundred times, hauling sleds for the throat-haulers to pick up, and she knew the way the stars began to slide there, the first long smears at the edge of the canopy. Past the inner markers it was another country. The Needle's mouth filled the whole forward canopy and spilled over its edges, a vast curved dark that was not dark, that seemed to lean toward you the longer you looked at it, and around its rim the starlight was not smeared but *wound* — wrapped round and round the mouth in tight bright coils, so that the whole sky seemed to be draining into it like water into a sink. The Eye was not a ring of light any more. It was a wall. It went up and up and curved over the top of the canopy and down behind them, faintly luminous, grey-gold, like the inside of a shell.\n\nThe Small Mercy did not like it. Teo could feel her not liking it, through the seat and the yoke and the soles of her feet: a long low shudder that came and went, came and went, as the shear-waves rolled off the mouth and broke over the hull.\n\n\"Talk to me,\" she said.\n\nAmbrose was strapped into the jump-seat behind her with a pair of old cracked headphones on, plugged into a portable reader on his knee. He had his eyes closed. \"The next one's about forty seconds out. It's a big one. From your right, up, about two o'clock.\"\n\n\"How do you know?\"\n\n\"I can hear it coming.\"\n\nShe looked at him in the mirror. He was not joking. His face was very still and intent, the face of a man listening to music in another room.\n\n\"Thirty seconds.\"\n\nShe put the Mercy's nose round toward two o'clock and up, the way you would turn into a wave in a boat, and fed the mains, and waited, and at twenty-nine seconds the shear hit them like the side of a building. The tug lurched. Something in the cargo bay banged against its straps. The whole canopy filled with a flash of grey-gold light as the hull caught the edge of the wave, and the yoke bucked in her hands, and then they were through it, wallowing, upright.\n\n\"Good,\" said Ambrose, without opening his eyes. \"That was very good. The next is smaller. Fifty seconds. Dead ahead.\"\n\nThey went in like that, wave by wave, for half an hour. He called them and she flew them. She had never flown with a reader before. She had always thought of readers as a kind of priest, men in domes who drew charts and sent them down to the docks on slates, and she had not understood that you could fly with one beside you, that it was like flying with a second pair of eyes that saw in a direction your own did not. By the tenth wave she was turning into them before he finished speaking. By the twentieth she had stopped being frightened, mostly, and started being something else, something that made her grin into her helmet like an idiot.\n\n\"You've done this before,\" she said.\n\n\"Not for twenty years. I used to fly with the throat-haulers when the Lectern was new. Before they decided I was too valuable to risk.\" He opened his eyes. \"You're very good, Miss Kesh.\"\n\n\"I know.\"\n\n\"I mean it. They told me you were good. They didn't tell me you were — \" He seemed to look for the word. \"Attentive.\"\n\n\"I'm a tug pilot,\" she said. \"You fly forty tonnes of sled on a bad tow, you get attentive or you get dead.\"\n\nThe bead was pulling.\n\nShe noticed it somewhere in the last few minutes, the way you notice a sound that has been there for a while. The little nub of glass at her throat had swung on its cord and was lying, not against her breastbone, but out from it, a finger's width from her skin, the cord stretched taut, leaning toward the mouth like a dog straining at a leash. She put her hand over it. It pressed into her palm, very gently, insistently.\n\n\"Mr Lyle.\"\n\n\"Ambrose.\"\n\n\"Ambrose. Does glass — \" She felt stupid. \"My brother's a cutter. He says glass knows where the Needle is.\"\n\nHe leaned forward in the jump-seat and looked at the bead in her hand, and then at her, and for a moment he looked so interested that she forgot to feel stupid.\n\n\"Your brother is right,\" he said. \"It does. It's the same stuff, you see — the throat and the glass. Negative energy. That's what holds the Needle open: a ring of something like brine-glass, only stranger, at the waist, pushing outward. The glass in the salt is a kind of — cousin. It feels the throat the way a compass feels a pole.\" He smiled. \"Cutters have known that for fifty years. Physicists keep rediscovering it and writing papers.\"\n\n\"Is that why it's narrowing? The ring at the waist?\"\n\nThe smile went. \"I don't know why it's narrowing,\" he said. \"That's why we're here.\"\n\nThey came to the inner markers — two old beacon buoys, dark, dead for decades, hanging in the grey-gold glow like drowned men — and Teo brought the Mercy round between them and held her there, heading into the shear, mains just feathering, while the tug shuddered and wallowed and the wall of light leaned over them.\n\n\"Here?\"\n\n\"Here. Hold her as steady as you can.\"\n\nHe went back to the cargo bay. She heard him in there, the clank of straps, the grunt of a man too old for this hauling something heavy. She heard the inner airlock cycle and the outer one open. Then she felt the buoy go — a small lurch as the mass left the tug — and in her rear camera she saw it tumble away from the Mercy's stern, a little grey cylinder turning end over end, slower and slower, until the mouth's pull caught it and it stopped turning and hung there, quite still, nose to the dark, as if it were listening.\n\nIts lattice of wires opened, like an umbrella. Like a flower.\n\nAmbrose came back up and dropped into the jump-seat and pulled his headphones on, and plugged the reader into something, and closed his eyes, and his face changed.\n\n\"Oh,\" he said.\n\n\"What?\"\n\nHe did not answer. He was listening. She watched him in the mirror. She watched the colour go out of his face and come back, and his lips move as if he were counting, and his hands, which had been loose on his knees, close slowly into fists.\n\n\"What is it?\" she said. \"Ambrose. What is it?\"\n\n\"It's — \" He opened his eyes. They were wet. \"It's beautiful. I didn't know. I didn't know it sounded like this up close. I've spent twenty-three years listening to it from the back of the room.\" He gave a sort of laugh. \"And the waist is going down. It's going down faster than the harp says. The harp's too far away. It smooths everything out.\" He listened again. \"It's like a drawstring. Like someone's pulling a drawstring. Very slowly. Very evenly.\"\n\n\"Can it close?\"\n\n\"I don't know.\" He took the headphones off. \"But there's — there's something else. Under it. I heard it in the Lectern the other night and I thought it was the instrument. It isn't the instrument. It's here too, it's louder here. A kind of — \"\n\nThe shear hit them from behind.\n\nThere had been no warning. He had had his headphones off. It came out of the mouth at their stern like a fist, and the Small Mercy went over on her side and then on her back and the canopy was full of grey-gold light and then of stars and then of light again, and the proximity alarm was shrieking, and somewhere behind her Ambrose had been thrown against his straps and was saying something she could not hear. The yoke was dead in her hands. The tug was tumbling toward the dark — she could see it in the canopy each time they came round, the bruise, nearer, nearer, the coils of starlight going past like the walls of a drain.\n\nShe did not think. She cut the mains, and fired the starboard attitude jets in one long burn until the tumble slowed to a spin and the spin to a wallow, and then she put the nose, not away from the mouth, but along it — skimming the edge of the wall of light, letting the pull take her round in a long falling curve the way you let a current take a boat round a rock — and when the curve brought her nose round to face the inner markers again she gave the mains everything they had and a little more, and the Small Mercy screamed and shuddered and clawed her way up out of the pull, metre by metre, until the wall of light fell away behind them and the shear-waves were only waves again, and then only shudders, and then they were past the last beacon and in the lanes and it was over.\n\nShe sat with her hands on the yoke. They were shaking. She could not make them stop.\n\nBehind her, Ambrose Lyle was laughing. It was not a happy laugh, exactly. It was the laugh of a man who has been very frightened and has found himself alive.\n\n\"Six hundred marks,\" he said. \"You could have died for six hundred marks, Miss Kesh.\"\n\n\"I die for less than that every day,\" said Teo. \"Usually it's slower.\"\n\nHe stopped laughing. In the mirror she saw him looking at her, really looking, as if he had just seen something he had not expected to see.\n\n\"Thank you,\" he said.\n\n\"Write the waiver,\" she said, and her voice came out wrong, and she turned the Mercy for home.","wordCount":1690,"createdAt":1793093335803,"updatedAt":1793093335803}],"plotThreads":[{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Pell's Draw","color":"#3b82f6","id":"1aS0ZiRvPGHGOx-cD4FBf","createdAt":1793092244120,"updatedAt":1793092244120,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Withdrawal","color":"#ef4444","id":"5JoUOSVHYh-7D4UQ_KxQg","createdAt":1793092240860,"updatedAt":1793092240860,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Teo's debt","color":"#f59e0b","id":"9yaD7eWlZcvjmZ6iUF8ff","createdAt":1793092239785,"updatedAt":1793092239785,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Ambrose's proof","color":"#10b981","id":"FWVqEenkB0ukMB8QFSCGi","createdAt":1793092243013,"updatedAt":1793092243013,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Isra and the Gristle crew","color":"#ef4444","id":"G2vQKK6meEnzZ9EFXlOcw","createdAt":1793092249643,"updatedAt":1793092249643,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Severance war","color":"#ec4899","id":"IAvx2vIwh-tQhQJ3-4jZM","createdAt":1793092245215,"updatedAt":1793092245215,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"The choked throat","color":"#f59e0b","id":"_K3aJb1aHDBGtrGLmSbYZ","createdAt":1793092248524,"updatedAt":1793092248524,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Great Keeping","color":"#f97316","id":"ctdamGI31cA5s7CsmwaVQ","createdAt":1793092247397,"updatedAt":1793092247397,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Adaeze's heresy","color":"#14b8a6","id":"eBOv7USgNPYsH_prm_0Ed","createdAt":1793092246292,"updatedAt":1793092246292,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Keeping (all eras)","color":"#8b5cf6","id":"eO_7QOdp0avWbvEC7OOfX","createdAt":1793092256981,"updatedAt":1793092256981,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"The Cutters' strike","color":"#8b5cf6","id":"ePqBA24DL3HH2OjsKHoMk","createdAt":1793092241928,"updatedAt":1793092241928,"version":1}],"motifs":[{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Debt and the tally","color":"#0891b2","id":"8CmTnO92ZbAiueYnKULWV","createdAt":1793092265347,"updatedAt":1793092265347,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Hands","color":"#65a30d","id":"E7dpHAGomtgYlj_PdF-Qi","createdAt":1793092266442,"updatedAt":1793092266442,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Light in the dark","color":"#2563eb","id":"PCXJLDRcGRTQ9mrzsfblI","createdAt":1793092267531,"updatedAt":1793092267531,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"Salt and glass","color":"#e11d48","id":"gQ_6swqJ5lW3yGhmN9POY","createdAt":1793092263174,"updatedAt":1793092263174,"version":1},{"description":"","worldId":"os-ym7EwunyTMDieuRMb1","name":"The fork's note","color":"#7c3aed","id":"uRRXouZ1ANkDsIh6wIm9O","createdAt":1793092264252,"updatedAt":1793092264252,"version":1}],"continuitySuppressions":[],"writingLogs":[{"id":"ttPfJj63Y88W8-fCbPDAo","worldId":"os-ym7EwunyTMDieuRMb1","date":"2026-10-27","words":22915,"createdAt":1793092435352,"updatedAt":1793093539610}],"sceneRevisions":[],"tombstones":[{"id":"Yzye5F4WxAWbzxKzI-P4P","worldId":"os-ym7EwunyTMDieuRMb1","entityType":"event","entityId":"Kl17BcEStKYd3-KBQ0odp","version":2,"deviceId":"1_KhZBvxPA38t3eOxlCQy","deletedAt":1793092463773}],"blobs":[{"id":"fmQuVN1CQ3xUHo9UcTLUM","worldId":"os-ym7EwunyTMDieuRMb1","mimeType":"image/png","dataBase64":"","createdAt":1793091980354}]}