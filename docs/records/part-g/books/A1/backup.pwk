_7QOdp0avWbvEC7OOfX"],"motifIds":["uRRXouZ1ANkDsIh6wIm9O"],"worldId":"os-ym7EwunyTMDieuRMb1","chapterId":"_YizxoDDs2HC97Smr_hEY","timelineId":"ST4jdjCPlD6GmgCHSK16K","title":"The First Keeper","description":"The waist pauses on schedule; Bettany gave Hesper the date. Hesper names Corrigan the first Keeper. The buoy hears a new hard ringing at the waist: something stayed. Ambrose writes down Corrigan's last words.","locationMarkerId":"yBmIaILRNsWH9U1mYNeIi","involvedCharacterIds":["Nz21WLzsyWyV5l2ZCGeph","KTf_JCAKUMQ3GKu2kixRa"],"involvedItemIds":["VuHFhK4GdePcZFlHW2Gc2","4W7H7AXZt69yA9Bm8xOyk"],"tags":[],"id":"AlydCLrHe8VMnTMbTTTgJ","sortOrder":-1,"createdAt":1793109316287,"updatedAt":1793109353968,"version":8,"remoteCharacterIds":["kKPEd-csxdzTE5plAVRqJ"]},{"travelDays":null,"inWorldTime":21,"tension":3,"structureBeat":null,"status":"draft","povCharacterId":"cxOiILo2zDng_KzycPfs7","isFlashback":false,"mentionedCharacterIds":[],"threadIds":["ePqBA24DL3HH2OjsKHoMk","eO_7QOdp0avWbvEC7OOfX"],"motifIds":["E7dpHAGomtgYlj_PdF-Qi","gQ_6swqJ5lW3yGhmN9POY","8CmTnO92ZbAiueYnKULWV"],"worldId":"os-ym7EwunyTMDieuRMb1","chapterId":"O72hHHeXdYjEx3dKijViq","timelineId":"ST4jdjCPlD6GmgCHSK16K","title":"Shaft Nine","description":"Fennick loses a hand cutting Keeping glass too fast. Nico calls a vote: no glass for the dark. Teo begs him to keep his head down.","locationMarkerId":"tVKCJ1ai6gWC5fjM8MH27","involvedCharacterIds":["cxOiILo2zDng_KzycPfs7","ba36zRukMnL6eifQ8p0Lp","Q_bPbcsNtraUTJg8xxckn"],"involvedItemIds":["w0WglDWRgFI1LeXJt6ABg"],"tags":[],"id":"BGuMiCoqSHask6lx4yaIC","sortOrder":-2,"createdAt":1793108785183,"updatedAt":1793108812221,"version":10,"remoteCharacterIds":[]},{"travelDays":null,"inWorldTime":22,"tension":3,"structureBeat":null,"status":"draft","povCharacterId":"Nz21WLzsyWyV5l2ZCGeph","isFlashback":false,"mentionedCharacterIds":[],"threadIds":["FWVqEenkB0ukMB8QFSCGi"],"motifIds":["uRRXouZ1ANkDsIh6wIm9O"],"worldId":"os-ym7EwunyTMDieuRMb1","chapterId":"O72hHHeXdYjEx3dKijViq","timelineId":"ST4jdjCPlD6GmgCHSK16K","title":"Old Traces","description":"Correcting the old paper traces against his fork, Ambrose finds the swell in every Narrowing: two rhythms beating. If it holds, the waist turns on its own about the first of May.","locationMarkerId":"yBmIaILRNsWH9U1mYNeIi","involvedCharacterIds":["Nz21WLzsyWyV5l2ZCGeph","KTf_JCAKUMQ3GKu2kixRa"],"involvedItemIds":["VuHFhK4GdePcZFlHW2Gc2","4W7H7AXZt69yA9Bm8xOyk"],"tags":[],"id":"ClR43RbcbdVKODlz1mtSi","sortOrder":-1,"createdAt":1793108784849,"updatedAt":1793108819423,"version":7,"remoteCharacterIds":[]},{"travelDays":0,"inWorldTime":null,"tension":4,"structureBeat":null,"status":"draft","povCharacterId":"eZ6bZoVov0ITLh7fBrY_0","isFlashback":false,"mentionedCharacterIds":[],"threadIds":["_K3aJb1aHDBGtrGLmSbYZ","ctdamGI31cA5s7CsmwaVQ"],"motifIds":["uRRXouZ1ANkDsIh6wIm9O"],"worldId":"os-ym7EwunyTMDieuRMb1","chapterId":"j1VCRiUth7uIAv2Y6xHkC","timelineId":"1Gt0Nmj9fSssszp28yFzc","title":"For Clarity","description":"Prior Saar takes back the Fork and orders the harp retuned to the Hunger Tone before the Lamplighter's reader comes. Lucan copies the trace onto a stick for Isra.","locationMarkerId":"yBmIaILRNsWH9U1mYNeIi","involvedCharacterIds":["lXowrO8WucvQ-z-5V8Y1Z","M1JAnaMBtxnLCSlQrX2Uy","eZ6bZoVov0ITLh7fBrY_0"],"involvedItemIds":["VuHFhK4GdePcZFlHW2Gc2"],"tags":[],"id":"EPajjYElKpPpwffw-xPff","sortOrder":0,"createdAt":1793109149177,"updatedAt":1793109188689,"version":8,"remoteCharacterIds":[]},{"travelDays":null,"inWorldTime":25,"tension":4,"structureBeat":null,"status":"draft","povCharacterId":"Nz21WLzsyWyV5l2ZCGeph","isFlashback":false,"mentionedCharacterIds":[],"threadIds":["FWVqEenkB0ukMB8QFSCGi","eO_7QOdp0avWbvEC7OOfX"],"motifIds":[],"worldId":"os-ym7EwunyTMDieuRMb1","chapterId":"O72hHHeXdYjEx3dKijViq","timelineId":"ST4jdjCPlD6GmgCHSK16K","title":"Who Else","description":"Ambrose tells Hesper about the swell. She asks who else knows, and when the next pause in the narrowing falls, so that the trial will be seen to work.","locationMarkerId":"J3YtvaNwzSnb9yBk9hvCk","involvedCharacterIds":["Nz21WLzsyWyV5l2ZCGeph","kKPEd-csxdzTE5plAVRqJ"],"involvedItemIds":[],"tags":[],"id":"HK0cNzC8O31steAchWygx","sortOrder":1,"createdAt":1793108784246,"updatedAt":1793108834738,"version":7,"remoteCharacterIds":[]},{"travelDays":null,"inWorldTime":2,"tension":4,"structureBeat":null,"status":"draft","povCharacterId":"CmFRcUGePy467_xgF7b73","isFlashback":false,"mentionedCharacterIds":[],"threadIds":["1aS0ZiRvPGHGOx-cD4FBf","eO_7QOdp0avWbvEC7OOfX"],"motifIds":["uRRXouZ1ANkDsIh6wIm9O","8CmTnO92ZbAiueYnKULWV","PCXJLDRcGRTQ9mrzsfblI"],"worldId":"os-ym7EwunyTMDieuRMb1","chapterId":"qsn-qoDH4M_GZv5sUT8pl","timelineId":"PnoEuxRs-pnuhq1Nug1vk","title":"The Wheel","description":"The Thirtieth Draw in the Compact Hall: the Founders' Tally, the Founder's Fork, the Hunger Tone. Mor looks at the Speaker's terrace and reads Pell's name.","locationMarkerId":"jsm6B8oiY8NGd8rkal637","involvedCharacterIds":["CmFRcUGePy467_xgF7b73","zO_Df258F-V33Vsnq0pOr","O4qiUlm4ij88IkBV4Edp7","1T_DkkgweUgLcgjCDCHxK","cTQk2fuL3YmSOlYDRwOM2"],"involvedItemIds":["w0WglDWRgFI1LeXJt6ABg","VuHFhK4GdePcZFlHW2Gc2","4tuVyVbUgsAvFy11vOXfC"],"tags":[],"id":"Hy3VAW4LN10Gaa4qhfEBE","sortOrder":0,"createdAt":1793092973726,"updatedAt":1793093006494,"version":10,"remoteCharacterIds":[]},{"travelDays":null,"inWorldTime":14,"tension":3,"structureBeat":null,"status":"draft","povCharacterId":"lXowrO8WucvQ-z-5V8Y1Z","isFlashback":false,"mentionedCharacterIds":[],"threadIds":["ctdamGI31cA5s7CsmwaVQ","eO_7QOdp0avWbvEC7OOfX"],"motifIds":["PCXJLDRcGRTQ9mrzsfblI","E7dpHAGomtgYlj_PdF-Qi"],"worldId":"os-ym7EwunyTMDieuRMb1","chapterId":"-XbzEqAX5tnwUpoEj08qm","timelineId":"1Gt0Nmj9fSssszp28yFzc","title":"The Lamplighter at the Anchor","description":"The Lamplighter lays her hand on the harp and says her son's name. Lucan tells her the Needle is dying; she says it is hungry. The Prior yields.","locationMarkerId":"yBmIaILRNsWH9U