B9jNZUrFoF11","sortOrder":0,"createdAt":1793146023687,"updatedAt":1793146024436,"version":2,"remoteCharacterIds":[]},{"travelDays":null,"inWorldTime":null,"tension":null,"structureBeat":null,"status":"draft","povCharacterId":null,"isFlashback":false,"mentionedCharacterIds":[],"threadIds":[],"motifIds":[],"worldId":"p5RB-gewXUZYlHUKTH5pw","chapterId":"AqG5mFoTr2Pk939QIPRvQ","timelineId":"-ZiYa6rM8LYD4CUNIG4--","title":"The Mouth","description":"","locationMarkerId":"Ybosum8zedJ0zQI6eapQp","involvedCharacterIds":["EEp34P_LIwiHnQUS72F_S"],"involvedItemIds":[],"tags":[],"id":"ssvpvVWG-PUr4fVLVNAEq","sortOrder":-3,"createdAt":1793146023894,"updatedAt":1793146023971,"version":2,"remoteCharacterIds":[]},{"travelDays":0,"inWorldTime":null,"tension":null,"structureBeat":null,"status":"draft","povCharacterId":null,"isFlashback":false,"mentionedCharacterIds":[],"threadIds":[],"motifIds":[],"worldId":"p5RB-gewXUZYlHUKTH5pw","chapterId":"1mLWBC3drPbUeBuQy0FoX","timelineId":"TAAHx64wy6zcrgc0s_FVP","title":"The Proposal","description":"","locationMarkerId":"jWi-Bx-VXJvuRZ3e3EWY5","involvedCharacterIds":["qBQ4QH8OQcPou62jFFMxx","B5N-ORRxzDAoRSjwt4RPw","WQ9NeOVAbNSpDXQKkGhBO","4PJK2irFlLq0lPkroCgPG"],"involvedItemIds":[],"tags":[],"id":"y2ttHnDgt8Jg1CDQBa4ir","sortOrder":-2,"createdAt":1793146166575,"updatedAt":1793146167012,"version":2,"remoteCharacterIds":[]},{"travelDays":4,"inWorldTime":null,"tension":null,"structureBeat":null,"status":"draft","povCharacterId":null,"isFlashback":false,"mentionedCharacterIds":[],"threadIds":[],"motifIds":[],"worldId":"p5RB-gewXUZYlHUKTH5pw","chapterId":"3cwRgmDvjXK0JC6cuy4tY","timelineId":"bqr_Pql5DzQd25cWbMJih","title":"The Ledger Halls","description":"","locationMarkerId":"jWi-Bx-VXJvuRZ3e3EWY5","involvedCharacterIds":["DdyKkgZFy6btLNqFcDspr"],"involvedItemIds":["J2rCe_zB9fHmaFmATwAUF"],"tags":[],"id":"yOks9hrcFzL4xJijiOILK","sortOrder":-4,"createdAt":1793146319667,"updatedAt":1793146319766,"version":2,"remoteCharacterIds":[]},{"travelDays":0,"inWorldTime":null,"tension":null,"structureBeat":null,"status":"draft","povCharacterId":null,"isFlashback":false,"mentionedCharacterIds":[],"threadIds":[],"motifIds":[],"worldId":"p5RB-gewXUZYlHUKTH5pw","chapterId":"ddbkVvh0hPVMCNJMkEFYz","timelineId":"bqr_Pql5DzQd25cWbMJih","title":"The Comptroller-General","description":"","locationMarkerId":"bpyo3ZRm53_YW7_EkVCbh","involvedCharacterIds":["8FkLsgdUH52stzy3qThJO","vOBEkx7GmTDi_KO4NiWCN","K2sa5OCdLdT81u7a1yBt0","X1JRrGlyZdp8QBMZ6SYZN"],"involvedItemIds":[],"tags":[],"id":"yZpgnpjBHSlNECwKUqvZs","sortOrder":1,"createdAt":1793145781883,"updatedAt":1793145783179,"version":2,"remoteCharacterIds":[]},{"travelDays":0,"inWorldTime":null,"tension":null,"structureBeat":null,"status":"draft","povCharacterId":null,"isFlashback":false,"mentionedCharacterIds":[],"threadIds":[],"motifIds":[],"worldId":"p5RB-gewXUZYlHUKTH5pw","chapterId":"3cwRgmDvjXK0JC6cuy4tY","timelineId":"bqr_Pql5DzQd25cWbMJih","title":"Gallery Twenty-Two","description":"","locationMarkerId":"obQHtZrWX1AjVLoialGbh","involvedCharacterIds":["DdyKkgZFy6btLNqFcDspr","8FkLsgdUH52stzy3qThJO","vOBEkx7GmTDi_KO4NiWCN","LNs4_mqC3zge5HTKXOYFD"],"involvedItemIds":["lx0QoDRFeCbWybrVEqv8-"],"tags":[],"id":"zNinaqTK9rtYqND3n_Ppb","sortOrder":-2,"createdAt":1793146319459,"updatedAt":1793146319982,"version":2,"remoteCharacterIds":[]},{"travelDays":0,"inWorldTime":null,"tension":null,"structureBeat":null,"status":"draft","povCharacterId":null,"isFlashback":false,"mentionedCharacterIds":[],"threadIds":[],"motifIds":[],"worldId":"p5RB-gewXUZYlHUKTH5pw","chapterId":"3cwRgmDvjXK0JC6cuy4tY","timelineId":"bqr_Pql5DzQd25cWbMJih","title":"The Root","description":"","locationMarkerId":"jWi-Bx-VXJvuRZ3e3EWY5","involvedCharacterIds":["DdyKkgZFy6btLNqFcDspr"],"involvedItemIds":["J2rCe_zB9fHmaFmATwAUF"],"tags":[],"id":"zP8QlkeX6-5VlVkvPkC8A","sortOrder":-1,"createdAt":1793146319395,"updatedAt":1793146320186,"version":2,"remoteCharacterIds":[]}],"travelModes":[],"timelineRelationships":[],"crossTimelineArtifacts":[],"mapRoutes":[],"mapRegions":[],"mapRegionSnapshots":[],"mapAnnotations":[],"loreCategories":[],"lorePages":[],"factions":[],"factionMemberships":[],"factionRelationships":[],"knowledgeFacts":[],"knowledgeReveals":[],"characterGoals":[],"sceneTexts":[{"id":"-qlQf96aWs4eLrFtQ5dtU","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"f_ufE9D3tqhoILeyNqngm","text":"The light ended at the Lip.\n\nIt ended the way a tide ends on a beach Tamsin Hask had seen once in a picture-book: not in a line, but in a long uncertain fringe, where the terraces were half lit and half not and the frost began to show on the north faces of things. Above the Lip the Wick still burned, a bar of white fire down the middle of the sky, and the Galleries climbed the walls of the world in their thousands, warm, stinking, lit. Below it — aft of it, the old people said, because the Founders had called it aft — the lamp simply stopped. The last two kilometres of Lantern's axis were a dark rod, and under that dark rod lay the Cold Wards, and nobody had lived in the Cold Wards for longer than anybody had been alive.\n\nTamsin clipped her tether to the Lip post, an iron spike hammered into the road by some cutter a century dead, and checked the other end on her harness. Forty metres of line. Then the reel at her hip, two hundred more. Then her own good sense, which was free.\n\n\"Going in,\" she said to nobody. Habit. Her mother's habit, from the pumps: you said the thing out loud so the air knew you were in it.\n\nShe pulled the mask down. The rig's heater hummed along her spine. She walked into the dark.\n\nIt was not quite dark. That was the first thing you learned. The Wick's light carried a long way along the curve of the rock, bouncing from terrace to terrace, so that for the first few hundred metres the Cold was a blue dusk, and only further in, past the old Pump Galleries, did it become the true black you needed the lamp on your brow for. The second thing you learned was that the Cold was not empty. People had lived here once. Their houses were still here, frost-furred, doors standing open; their washing still hung on lines between terraces, frozen into boards. There were tables with cups on them. There was a child's bicycle, which Tamsin passed every trip, leaning against a wall with its front wheel turned as if somebody had just stepped off it. She didn't touch it. Cutters didn't touch the small things. You took metal, and you left the rest to the dark.\n\nShe was working a bus-bar in the old Pump Gallery Fourteen, a fat run of copper as thick as her wrist that fed a dead scrubber bank, and she had been working it for six days. Copper was the best thing in the Cold. It was what the Count's foundries paid for, and what the Salt paid more for, and for a cutter with a family balance like hers it was the difference between a door that opened and one that didn't. The bar ran forty metres along the gallery ceiling and she had got eleven of it out. Today she thought she might get four more.\n\nThe air in the Pump Galleries was thin and cold enough to hurt through the mask. She could hear her own breath, loud, and the tick of the heater, and the scritch of the saw when she started it, and under all of that the deep slow grumble of the rock itself, which never stopped, which was the sound of Lantern turning. Frost fell from the bar where she cut it and drifted down in the light of her brow-lamp, sideways, the way things fell on Lantern, curving as they went.\n\nShe was on her third metre when the light went.\n\nNot her light. The other one. Even here, a kilometre into the Cold, there was a faint wash of it in the gallery mouth behind her, and she saw it go: blue to grey to nothing, and then, after a breath, back. And then out again. And back.\n\nTamsin turned off the saw and stood with her heart going.\n\nThe gutter, people called it. Everybody had seen it by now. Three times in the last month, five the month before. The Wick faltering for a second or two, so that all over Lantern the light stammered and every person on every terrace looked up together, mouths open, the way you'd look up at a sound in the night. Then it would steady and everybody would look down again and go on as if they hadn't.\n\nIt steadied. The dusk came back into the gallery mouth. Tamsin let her breath out through her teeth.\n\n\"Not today,\" she said. \"Not with me in here.\"\n\nShe started the saw again.","wordCount":773,"createdAt":1793145782613,"updatedAt":1793145782613},{"id":"0GGVKyxYs2iRt6TgXxZEa","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"yZpgnpjBHSlNECwKUqvZs","text":"The crier came out onto the gallery above the inner lock as the square was breaking up, and the square stopped breaking up.\n\nHe wasn't a crier, though. Tamsin saw that straight off, and felt the crowd see it too, a ripple going back through it like wind through a strip-farm. Criers were boys in grey with a slate and a loud voice. This was a man of about sixty in a long coat of a grey so dark it was nearly black, with silver at the cuffs, and behind him on the gallery were half a dozen men in the ordinary grey of the Count's bailiffs, with their docket-batons through their belts, and at their head a big pale man Tamsin knew by sight and by reputation: Brother Lusk, the Bailiff of the Count, who had walked more families into the dimming than anybody alive.\n\nThe man in the dark coat did not need a slate. When he spoke his voice was soft, and it went everywhere.\n\n\"Owing and owed,\" he said.\n\n\"Owing and owed,\" said the square, raggedly.\n\n\"My name is Imre Vosk. I am the Comptroller-General of the Count, and I keep the Account for all of you, as my predecessors have kept it since the Closing. I have come down to the Hook myself today because I have something to say that ought not to be said by a boy with a slate.\n\n\"You have seen the gutter.\" He let that sit. \"You have all seen it. I won't insult you by pretending you haven't. The Wick is failing. The fuel the Founders saved from the Closing was meant to last three hundred years, and it has, and a little more. The Wickwrights tell me it will not last a great deal longer. They tell me that at the present length of the lamp, the last cassette will be spent before the end of this year.\"\n\nThe square made no sound at all. Tamsin felt her mother's shoulder go rigid under her hand.\n\n\"The Count has known this was coming,\" Vosk said, \"and has made such provision as it can. From the first of next month the Wick will be shortened by a further third. The Galleries below Fifteen will go to half-light. The strip-farms will be consolidated in the Upper Wards, where the light is surest. That will buy us time. It will not buy us enough. We have too many mouths and too much air to warm and not enough fire to warm it with. And so the Count has taken a decision which no Count has taken since the Closing, and which I take with grief.\n\n\"The Account will be called.\"\n\nTamsin did not know what that meant. She knew, from the sound the square made, that some of the old people did.\n\n\"The ten thousand accounts on Lantern which stand deepest in debt to Caul,\" Vosk said, \"will be released from the Tally's charge. The Tally will no longer supply their air, or their water, or their heat. Those so released may go into the Cold Wards, where the Count will provide such shelter as the Cold allows, and they will owe nothing more from that day, for the Account will hold them quit. The lists will be posted at the Hook in thirty days, by family. I am told there will be those who call this cruelty.\" He looked out over them, and his voice did not change at all. \"I call it arithmetic. If we do not do this, all of us go dark together by the spring. If we do, most of us live. Caul is owed, and Caul will be paid. Owing and owed.\"\n\nHe turned and went back through the gallery door, and the bailiffs closed it after him, and Brother Lusk stood for a moment longer, looking down over the square, before he followed.\n\nNobody said \"owing and owed.\" For a long time nobody said anything.\n\nThen somebody at the back threw something at the closed door — a shoe, Tamsin thought, it was hard to see — and it struck the door and dropped onto the gallery, and the square began to move again, and the noise came up all at once, a hundred people talking and two or three screaming and one old woman somewhere singing the Hook song in a cracked, steady voice.\n\nTamsin looked down at her mother.\n\nAgathe had her chit out. She was holding it to the light, the way they all were, all over the square, a thousand people turning a thousand small metal tokens in their fingers and reading the numbers on them, as if the numbers might have changed in the last ten minutes. Agathe's balance was minus eleven thousand two hundred and six. Tamsin knew that without looking. She'd known it every day for two years.\n\nShe knew, too, without asking anybody, where minus eleven thousand stood in the ten thousand deepest accounts on Lantern.\n\n\"Mam,\" she said.\n\n\"I heard him.\" Agathe put the chit back inside her collar. Her hands were steady. She coughed, and wiped her mouth, and looked up at the empty Hook. \"Get me home, Tam. And then go and find your brother. He'll have heard, and he'll do something stupid.\"\n\nTamsin got her home. Then she stood in the Hask room in the sideways light with the copper still on the floor and the tin on the shelf, and she did not go and find her brother. She thought about a hatch in the Cold, welded shut, with H-A on it, and a dead woman holding a shoe.\n\nAFT STORE 3. The Company had run, and taken everything. That was the story.\n\nBut you didn't weld a door shut on an empty room.\n","wordCount":962,"createdAt":1793145781888,"updatedAt":1793145781888},{"id":"2-oFICcm3rVbfqBigPnaD","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"1lGH_mKoG5xQJ7hU97kcj","text":"The _Magpie_ came in an hour later with eighty tonnes of Caul ice in her tank-frame and a crack in her forward window that had been there so long it had a name. Her pilot came through the inner lock with his helmet under his arm and the whole of the Dock Ring's gossip already on his face.\n\n\"Who?\"\n\n\"Adeyemi. Gallery Ten.\"\n\n\"Lock?\"\n\n\"Lock.\"\n\nKasimir Ostrova closed his eyes for a moment. He was nine years younger than his sister and twice as handsome and he owed money, at a conservative estimate, to a third of the Dock Ring, none of which ever seemed to cost him a night's sleep. But he had grown up in Gallery Six the same as her, and he had seen the same locks.\n\n\"Uncle Kas,\" said Pim, and was swept up and hung upside down by the ankles, which at twelve he was too old for and permitted anyway.\n\n\"How's the run?\" Dagny said.\n\n\"Cold. Long. The usual.\" Kas set Pim the right way up. \"Quiet out there, though. Quieter than it was.\"\n\n\"Quiet how?\"\n\n\"Caul Deep's still shut. You know they closed the Deep in the spring — the big shaft, the one that took nine hundred on a shift. Nobody's working it. Beacon's dark, gantries are up. Funny to fly past. Used to be you'd see the lights of it from a thousand klicks out like a city.\" He shrugged. \"They said the vein ran out. Sent all the Deep crews home through the Throat. Contracts bought out, every one. Lucky bastards.\"\n\n\"I never heard of the Company buying out a contract in my life,\" said Dagny.\n\n\"Well. You never heard of a vein running out, neither. It's a season of firsts.\" Kas grinned at Pim. \"Come on. I'll buy you a noodle. I've been paid.\"\n\n\"You've been paid and you owe Marguerite at the noodle stall forty.\"\n\n\"Then I'll buy him a noodle and her a smile, and we'll all be square.\" He put an arm round his sister's shoulders and squeezed, briefly, hard. \"Sorry about Lemuel, Dag.\"\n\n\"Yes,\" she said. \"Me too.\"\n\nBehind them, Odile's engraver whined on in the bronze.","wordCount":361,"createdAt":1793145334541,"updatedAt":1793145334541},{"id":"26-fGTDae4YWzu4MY7mjj","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"Fb0lH_0HezNb7JbWS3pa9","text":"Hask, Agathe. Gallery Twenty-Two. Born 270 AC. Pump-hand, thirty years; retired on sickness, 309. Dependants: Hask, Jory, fifteen. Adult child on separate account: Hask, Tamsin, cutter.\n\nBalance: minus eleven thousand two hundred and six.\n\nHe began, as he had been taught, at the bottom. Agathe Hask's own consumption, year by year, since she got her chit at six: air, water, heat, light, housing. Ordinary. A little heavy in the last six years, which would be the lung-rot. Her own earnings against it: thirty years of pump wages, posted monthly, regular as a heartbeat, and then nothing. The difference, by itself, came to minus three thousand and forty. That was a life. That was what it cost to be Agathe Hask.\n\nThen the inheritances. Her mother's balance, posted to her at her mother's death in 299: minus four thousand one hundred. Her father's, posted to her mother before that, and carried through. A brother's. A child's, a baby, two months old, minus nine. He paused over that one, as he always did over the small ones, and then went on.\n\nAnd then, every year, on Account Day, the inheritance surcharge.\n\nThe surcharge was older than the Count. It had been in the Tally from the Founding, a levy on all inherited balances of three parts in a hundred, posted once a year, because — the counters were taught — an inherited debt was a debt that had gone unpaid for a whole lifetime, and the Account must be compensated for its patience. Orrin had calculated it ten thousand times. You took the inherited portion of the balance on Account Day and you multiplied it by three in a hundred and you posted the result.\n\nThe inherited portion. Not the whole balance.\n\nHe looked at the figure posted on Account Day 310 for Hask, Agathe. Then he looked at the one for 309. Then 308. He took a fresh page on his slate and did the arithmetic by hand, the way he had done it as a boy, with the stylus scratching.\n\nIt was wrong. It had been wrong for eleven years. Some time around 299, when her mother's balance came to her, somebody — some counter, at some desk, in some hall — had keyed the surcharge against the whole of Agathe Hask's balance instead of the inherited part. And then, each year after, the surcharge itself had been treated as inherited, because it had been posted under the inheritance heading, and had been surcharged in turn. Three parts in a hundred, compounding, on a figure that had never been owed.\n\nHe worked it through to the present hour. It took him most of the morning. When he was done he sat back and looked at it.\n\nCorrected balance: minus nine thousand and sixty-one.\n\nTwo thousand one hundred and forty-five credits. A little over two thousand credits that Agathe Hask had never owed, that her daughter had been cutting copper in the Cold to pay down, that would have gone on her son's chit at her death and on his children's after him.\n\nOrrin turned to the list from the Comptroller-General's office and ran his stylus down it until he found the cut: the ten-thousandth account, the shallowest that would be Called. It was minus nine thousand four hundred and twelve.\n\nHe sat very still. A counter at the next desk glanced at him, and away.\n\nAt minus eleven thousand two hundred, Agathe Hask went into the Cold. At minus nine thousand and sixty-one, she did not.","wordCount":586,"createdAt":1793146319523,"updatedAt":1793146319523},{"id":"4SKY7CAiMFblSt4xNwxw8","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"l3mB0Z32LXliG1ks4H2N4","text":"Joss sat on the landing with the torch in his lap and wept the way big men did on Lantern, quietly and with his face turned to the wall. Dagny did not weep. She went to the girl, whose name was Abi and who was Lemuel's sister's child, and she knelt so that their faces were level, and she looked at the chit.\n\nMinus nine hundred and four, plus the girl's own, which was the ordinary minus three hundred that a Lantern child had by eight from being fed and housed and breathed. Minus twelve hundred and four. Three hundred over the line. The girl's door would be dimmed by morning. Her ration would stop at the next posting.\n\n\"You've got people on Ten?\"\n\n\"My aunt's at the farms. She's on nights.\"\n\n\"Go to her. Tell her the Wick crews will stand it. Tell her Dagny Ostrova said. Tomorrow I'll put it through a counter.\"\n\nThe girl looked at her with the flat, measuring look of every Lantern child who had already learned that adults said things. Then she went.\n\n\"You haven't got twelve hundred,\" said Joss, when she'd gone.\n\n\"The crews have.\"\n\n\"The crews have got a hole in the bottom of the bucket same as you, Dag.\"\n\n\"Then we'll stand it with the hole.\" She stood. Her knees hurt. Her balance, in the corner of her own eye, was smaller by two hundred for a door that had not saved anyone. \"Get him covered. I'll take his name to Odile.\"","wordCount":252,"createdAt":1793145334702,"updatedAt":1793145334702},{"id":"60KHzXuQh2ewF3FhCDCJa","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"e2oBYFVEZ5GlPkKSEnkkB","text":"The call came down the spine at the end of second shift, when Dagny Ostrova was forty metres up the Wick with her face in a collimator housing and her knees locked round a rung that had been warm for ninety years.\n\n\"Gallery Nine,\" said the speaker on her collar. It was Joss, below her on the crawl, and his voice had the flatness it got when something was already too late and he hadn't decided to know it yet. \"Lock Nine-Forty. Man in it. It's gone to recovery.\"\n\nShe was moving before he finished. You did not think about a lock in recovery. You thought about it afterwards, at the bell, with a drink in you.\n\nGoing down the Wick was going down only in the sense that the rock's spin pulled you, gently at first and then less gently, toward the curved floor of the world. At the axis there was no weight at all, only the lamp: three kilometres of magnetic bottle and shielding and slow white fire, with the crawls and catwalks wrapped round it like ivy round a pole. Its light fell on everything. It fell on the terraced Galleries that climbed the inner wall in every direction, on the water tanks and the strip-farms and the tin roofs, on the long seam of the Upper Wards where the Company people lived with real glass in their windows. On Lantern you could look up from anywhere and see someone's house above you, upside down, lit from the side by the same lamp that lit yours. Children were taught early not to drop things from high terraces. It was the first rule. The second was to watch your balance.\n\nDagny dropped through the spoke-shaft hand over hand, letting her weight build, and hit the Gallery Nine landing at a run with Joss three seconds behind her, wheezing. A crowd had already made a half-ring round Lock Nine-Forty. Nobody was touching it. On Lantern, nobody touched a lock in recovery, because the Tally logged who touched what.\n\nThe lock was a steel bottle three metres long, set between the Gallery Nine pressure zone and the Gallery Ten one, so that if either breached the other would hold. You walked into it, the door behind you sealed, the Tally read the chit on your wrist, and if you were in credit the door in front of you opened. If you were not, it didn't. And because the Company had built Lantern on the principle that air was the dearest thing in the Sabra system and must be recovered wherever it could be, a lock with an unauthorised occupant began, after ninety seconds, to draw its air back into the main for reclamation.\n\nLemuel Adeyemi was in the lock. Dagny knew him a little. Pump-fitter, Gallery Ten. Fifties. A cough. A wife who had died two winters back of the same cough, and whose name was on the bell. He was standing with both palms flat on the inner door's window, and his mouth was open, and his breath was making less fog on the glass than it should have.\n\n\"How long?\" Dagny said.\n\n\"Two minutes in recovery,\" somebody said. \"His shift got docked. Pump fault on Ten, they docked the whole crew a half-day. It posted on the hour. He was already in the lock when it posted.\"\n\nDagny looked at the panel by the door. The little screen showed his number and his balance, in the Company's blue, and the balance was in brackets, which was how the Tally wrote a debt it had stopped being patient with. Minus nine hundred and four. The dimming line on Lantern was minus nine hundred.\n\nFour. He was four over the line. Four was a meal. Four was an hour of water.\n\n\"Transfer,\" she said, and slapped her own chit onto the panel. \"I'll stand it. Transfer from Ostrova, nine-oh-six-two-two, to—\"\n\nThe panel chimed politely. TRANSFERS BETWEEN ACCOUNTS POST AT THE HOUR. PLEASE SEE A COUNTER.\n\n\"There's no counter on Nine at shift-end,\" Joss said behind her. \"There's no counter on Nine ever.\"\n\n\"Then get me the override.\"\n\n\"Dag. The override's in the Counting House.\"\n\nShe knew that. Everyone knew that. She said it anyway because it was the next thing to say, and because the alternative was to stand and watch, and the crowd was already standing and watching. Inside the lock Lemuel had seen her. He took one hand off the glass and made a small shape with it, a sort of apology, as if he were sorry to be making a scene.\n\n\"Torch,\" said Dagny.\n\n\"It's a pressure door. It'll take—\"\n\n\"Torch, Joss.\"\n\nHe had one on his belt, because Wick crews carried everything. She lit it and put the flame to the hinge side of the outer door and the steel went cherry-red and then white and began, very slowly, to run. The crowd made a noise behind her. The panel spoke again, in the same tone: TAMPERING WITH COMPANY PRESSURE EQUIPMENT IS CHARGED AT TWO HUNDRED CREDITS PER INCIDENT TO THE ACCOUNT OF THE TAMPERER. It read her chit through her glove. She watched her own balance drop by two hundred in the corner of the screen and kept cutting.\n\nIt took four minutes. A man can live for four minutes in a lock in recovery; Dagny had seen it. What a man cannot do is live for four minutes in a lock in recovery after he has already been in it for three. By the time the hinge gave and Joss got a pry-bar into the gap and the two of them hauled the door back on its seal, there was nothing in the lock but cold, thin air, rushing out past them into the gallery with a sound like a long breath let go, and Lemuel Adeyemi on his knees with his forehead against the inner door, as though he had decided at the end to pray to it.\n\nDagny went in and turned him over. His eyes were open. His lips were the colour of the shadow under a terrace. She put two fingers on his neck because she had been trained to and because people were watching, and then she took them away.\n\nBehind her the panel on the wall chimed a third time. Lemuel's number went grey, and under it, small and blue and patient, the Tally posted his last entry: ACCOUNT CLOSED BY DEATH. BALANCE TRANSFERRED TO ESTATE. And then, because Lemuel had no estate but a cough and a bunk and a wife's name on a bell, it posted the next one, which Dagny had seen a hundred times and which never stopped being the worst thing she had ever read: ESTATE INSOLVENT. BALANCE TRANSFERRED TO NEXT OF KIN.\n\n\"Who's his kin?\" she said.\n\nNobody answered. Then a girl at the front of the crowd, eight or nine, with a chit on a cord round her neck and her hair cut short against lice, said, \"Me.\"","wordCount":1168,"createdAt":1793145333989,"updatedAt":1793145334699},{"id":"7yD-i3iL0x6ny-qhuzU08","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"a8a4Mt67-JHW0f3gQMomY","text":"The announcement came at eleven the next morning, on every screen on Lantern at once.\n\nDagny was in the canteen on Gallery Six with Joss and two of the Wick crew, trying to work out how many hours the Speakers could find between them to stand the Adeyemi girl's debt, and getting a number that was not enough. The screen on the canteen wall was usually showing either the Company's safety notices or a football match from somewhere in the Concord that had been played eleven years before and brought through the Throat on a data-run. It went dark in the middle of a goal, and then it showed the Company's mark, the two letters H and A leaning on each other like tired men, and then it showed Ruth Achterberg.\n\nThe canteen went quiet in the way Lantern went quiet for the bell.\n\nThe Director was sitting at a desk with nothing on it. She was a lean, grey woman of sixty in a dark Company suit, and she wore at her throat, on a fine chain, the brass disk of the Director's seal, which every child on Lantern had been told was the key to everything. She did not look cruel. She looked like someone who had been awake all night doing arithmetic and had come out of it with an answer she disliked but would not apologise for.\n\n\"People of the Sabra Concern,\" she said. \"I am speaking to you today with news that affects every one of us.\n\n\"As you know, the Throat which connects this system to the Concord is not a fixed thing. It breathes. Its throat-watch station has measured that breathing for the whole of this colony's history. Three weeks ago the station recorded the beginning of what our physicists call a closing phase. Throats which enter a closing phase do not reopen on any timescale that is useful to us. The best estimate, from the Concord's own literature, is somewhere between six and eight hundred years.\n\n\"The Throat will remain passable for fifty-two days. After that, this system will be cut off.\"\n\nSomebody in the canteen laughed, the high bark of a person who has been hit. Nobody else made a sound.\n\n\"The Halden-Ash Company has a duty to its shareholders and to its staff,\" said the Director. \"It cannot maintain a concern which it cannot reach. It will therefore withdraw from the Sabra system before the Throat closes. The carrier _Covenant_, now at our fore dock, will carry essential staff and their families and such Company assets as can be moved. I have asked the department heads to prepare those lists.\n\n\"I want to speak directly to the indentured population of Lantern.\" She looked into the lens. Dagny would remember that afterwards: that she did not look away. \"Your contracts are held by the Company. The Company does not abandon what it holds. Your contracts will remain in force, in trust, for the full term of the closure, and will be honoured when the Throat reopens. Lantern's systems — its air, its water, its heat, its light — will continue to be administered by the Tally, which has kept you safe for ninety years and which will keep you safe after we are gone. The Tally does not need us. It needs only that you go on working, as you always have, and it will go on keeping you alive.\n\n\"I know that this is hard news. I wish that I had better. Thank you.\"\n\nThe screen went back to the Company's mark. Then, after a moment, to the football match, which had been paused at the instant before the goal and now went on as if nothing had happened, the ball crossing the line, the crowd eleven years ago and four hundred light-years away going wild.","wordCount":636,"createdAt":1793145334407,"updatedAt":1793145334407},{"id":"Cfo-zPrSNtWDC2aJnnECs","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"zP8QlkeX6-5VlVkvPkC8A","text":"The correction came back in an hour, with a line through it in red and a note in the margin in the cramped hand of the senior counter of the third hall: _Surcharges are not corrected during a Calling. Refile after the lists are posted. — A._\n\nOrrin read the note three times. After the lists were posted the Haskes would be in the Cold. After the lists were posted there would be no account to correct.\n\nHe sat at his desk while the hall emptied around him for the dinner bell. He was not hungry. He was angry, and he was not used to being angry, and he found he did not know what to do with it except work. So he did what a counter does when a number will not sit right: he went back to the beginning.\n\nThe inheritance surcharge had been in the Tally from the Founding. Every counter knew that. But nobody had ever told him where in the Tally it lived, or who had put it there, or what it had been written to do. He had never needed to know. Now he wanted to. He wanted to see, written down, the rule that said three parts in a hundred, and see whether it said _inherited portion_ or _whole_. He wanted to know whether the error was a counter's, or the Tally's own.\n\nThe Count's archive of the Tally's root entries was open to counters of the fourth rank and above. He was fourth rank. He had never opened it. Hardly anyone did; it was a long scroll of old rules, rate changes, adjustments to the dimming line, all of it three hundred years dead. He found the surcharge rule after half an hour of searching. It was where it should be, in the first year after the Closing, posted on the Founders' authority. It said _inherited portion_. It was not the Tally's error. Somebody in a ledger hall had simply keyed it wrong, eleven years ago, and nobody had looked since.\n\nHe should have stopped there. He nearly did. But the archive was open on his slate and he had never seen the very first page of it, and so — with the same small guilty pleasure as putting his hand on the Hulk at seven — he scrolled to the top.\n\nThe first entry in the root of the Tally of Lantern, as kept by the Count, was dated the forty-ninth day of the Closing, in 2387 of the old reckoning. It was very short. It established the Account.\n\nACCOUNT ESTABLISHED. CREDITOR: CAUL. ALL BALANCES ON THE TALLY ASSIGNED TO CREDITOR IN FULL. ACCOUNT HOLDER: NONE.\n\nAnd under it, where every other root entry he had seen carried the same small paired mark — the two authorities of the Founders, the twin keys of the root, side by side — there was something different. Not the paired mark. A single line of the Tally's own plain text, which he had never seen it use about anything:\n\nAUTHORISED BY A KEY NOT KNOWN TO THE TALLY.\n\nHe read it several times. He thought about what _account holder: none_ meant, in a ledger. Every account had a holder. Somebody's chit, somebody's number. An account with no holder was money owed to nobody: a debt that could be paid into for ever and drawn from by no one.\n\nHe was still looking at it when the hall door opened and a bailiff in grey said, \"Counter Sallow? The Comptroller-General asks for you. Now, please.\"","wordCount":590,"createdAt":1793146319397,"updatedAt":1793146319397},{"id":"DNTgKNQZREfnDH9I5YPDF","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"Dm2K6ci-33HjzjQtCq2bL","text":"The copper went for ninety at the Salt Docks, which was thirty more than the Count's foundry would have given and thirty less than it was worth, and Tamsin took it because she had to.\n\nThe fence was a man called Brannock who worked out of a dead hauler's cabin at the end of Spur Four, aft along the ring where the Count's bailiffs did not come without a reason. He weighed the copper on a beam scale older than the Closing and counted out the ninety in Salt tokens, which were brass washers stamped with a crude S and worth exactly what the Salt said they were worth and nothing anywhere else on the rock. Tamsin put them in the inside pocket of her rig. She would change them at a chit-shop on Nineteen that took Salt washers at a quarter off, and the quarter off would go to the Salt too, because everything on the Salt Docks ended up going to the Salt in the end.\n\n\"Somebody wants a word,\" said Brannock, not looking up from his scale.\n\n\"Who?\"\n\nHe jerked his head toward the back of the cabin, where a curtain made of an old cargo-net hung over a doorway. Tamsin looked at it for a long moment. Then she went through.\n\nThe room behind was bigger than the cabin, cut back into the dock wall, and warm, warmer than any room Tamsin had been in all year. There was a stove with real coal-cake in it. There was a rug. There was a table with a lamp on it and a pot of something that smelled of meat. And at the table, eating out of the pot with a spoon, was a woman of sixty with one eye and a patch over the other, and grey hair cropped to a burr, and arms like a hauler's.\n\nEverybody on Lantern knew who Wenna Blackwood was. Nobody below Fifteen had seen her and lived to boast of it. That was the story, anyway. Tamsin had always assumed it was the Salt's own story, put about by the Salt.\n\n\"Sit,\" said Wenna Blackwood. Her voice was a gravel chute. \"Eat, if you want. It's goat. Real goat. Off the farms.\"\n\nTamsin sat. She didn't eat.\n\n\"You're Agathe Hask's girl,\" said Wenna. \"Cutter. Good cutter, Brannock says. Clean metal, no lies about the weight.\" She chewed, swallowed. \"And you've found a door.\"\n\nTamsin went cold.\n\n\"The Cold talks,\" said Wenna, not unkindly. \"Not much. But I've got ears in it. Three cutters work the Fourteen run besides you, and one of them saw your light on the service way under the old pump bank, and saw where it stopped, and came and sold me that for a bottle.\" She put the spoon down. \"Company door. Welded. Letters on it. That right?\"\n\nThere was no point lying. \"Aft Store 3.\"\n\nWenna nodded slowly, as if Tamsin had confirmed something she already knew. \"Company stores,\" she said. \"They had a dozen, aft, in the old days. Fuel and parts and medicine. They emptied them when they ran. Everybody knows that. Every one of them's been cut open and gutted three times over in three hundred years.\" She leaned forward. \"Except that one. Never found it. Never even knew it was there. Know why?\"\n\n\"No.\"\n\n\"Because somebody welded it shut and then iced over the way in, that's why. Somebody wanted it forgotten.\" Her one eye was very bright in the lamplight. \"What's behind a door like that, cutter? Eh? What would the Company not take when it ran — and not want anybody else to have?\"\n\n\"I don't know.\"\n\n\"No. Nor do I. But I'd pay to find out.\" Wenna Blackwood picked up her spoon again. \"Half of whatever's in it. You cut the door, my people carry. I'll stand your tools and your air and your mother's tin besides. Think about it.\"\n\nTamsin stood up. Her legs were not quite steady; it was the warmth, she told herself, she wasn't used to it.\n\n\"My mother's going to be Called,\" she said. She didn't know why she said it. \"Unless a counter in the Count does what he said he would.\"\n\nWenna looked up at her with no expression at all.\n\n\"Then you'd better think quick,\" she said.\n","wordCount":716,"createdAt":1793146319078,"updatedAt":1793146319078},{"id":"EA6zQDkyLJX7H7Kdb8lJ8","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"zNinaqTK9rtYqND3n_Ppb","text":"A Calling could not be posted on a balance alone. The rules said a counter must also sight the account-holder, in their place of residence, and confirm by their own eyes that the person existed and was where the Tally said. It was an old rule and a kind one, Orrin had always thought: it meant that before the Count did anything to a family, someone from the Count had stood in their room.\n\nHe had never been below Gallery Fifteen before. He was ashamed of that, a little, going down. The lift stopped at Eighteen and he walked the rest, along the terrace roads with his grey coat and his slate, and he felt the light change as he went: the clean white of the Upper Wards going yellow, then grey, then a sort of brownish dusk, sideways, as the Wick fell away behind the curve. The terraces were narrower here and the houses smaller and nearer together, and there was washing hung between them, and the smell was of damp and cooking and people. Children stopped playing and watched him go by. An old man spat, not at him, but not far from him either.\n\nTwenty-Two was the last gallery before the Lip. He found the Hask door by its number. He touched his chit to the panel, the counter's chit, which opened any door on Lantern for the purpose of a sighting, and the door sighed and clunked and let him in.\n\nThere were three people in the room. A woman of fifty or so, sitting up on the lower bunk with a blanket round her, very thin, with pale, almost colourless eyes. A boy on the top bunk, all knees, who looked at Orrin's coat and then at the door and then at Orrin's slate in a way that made Orrin hold the slate a little closer. And standing at the ring-stove with her back to him, a young woman in a cutter's rig with the upper half peeled down and tied round her waist by its arms, who did not turn round.\n\n\"Counter Sallow,\" Orrin said. \"Third hall. I'm here for a sighting. Hask, Agathe?\"\n\n\"That's me,\" said the woman on the bunk. She had a cough; he heard it under her voice, waiting.\n\n\"I'm sorry to disturb you. It won't take a moment.\" He held up the slate and read the particulars from it — name, gallery, birth year, number — and she nodded to each of them, and he marked them. His stylus was not quite steady. \"Thank you.\"\n\n\"That's it?\" said the young woman at the stove. She still had not turned. \"That's the sighting? You come down twenty galleries to look at my mother and say her name, and then she's sighted, and then she can be Called?\"\n\n\"Tam,\" said the woman on the bunk.\n\n\"No, I want to know. I want to know how it works.\" She turned round then. She had the same pale eyes, set in a hard, dirty, angular face that would have been handsome if it had not been so angry. \"Does he get paid by the head? Is there a bonus for the deep ones?\"\n\n\"I'm salaried,\" said Orrin, before he could stop himself.\n\nShe laughed. It was not a nice sound.\n\n\"Counter,\" said Agathe Hask quietly. \"My daughter's had a bad week. So has everybody on this gallery. You'll forgive her. Is there anything else you need?\"\n\nHe should have said no. He had his sighting. He had no business in this room any longer and every reason to leave it. Instead he heard himself say, \"There's an error in your account.\"\n\nThe room went quiet.\n\n\"An error,\" said Tamsin Hask.\n\n\"In the inheritance surcharge. From 299. It was keyed to the whole of your mother's balance instead of the inherited part, and then compounded. It's—\" he looked at the slate, though he knew the figure— \"it's two thousand one hundred and forty-five credits. Over eleven years. I've corrected it on my slate. I'm going to file it today.\"\n\nAgathe Hask looked at him for a long moment.\n\n\"How much does that leave?\" she said.\n\n\"Nine thousand and sixty-one.\"\n\n\"And where's the line? For the Calling?\"\n\nHe should not have told her. The cut was not posted. It would not be posted for another twenty-six days. \"Nine thousand four hundred and twelve,\" he said.\n\nNobody said anything. On the top bunk the boy had sat up.\n\n\"So she's under,\" said Tamsin. \"If you file it. She's under the line.\"\n\n\"If it's accepted. Yes.\"\n\n\"If.\"\n\n\"Corrections are— they have to be approved by a senior counter. It's a formality. The arithmetic is plain. Anyone can check it.\" He held out the slate, as if she might want to, and she looked at it, and at him, and he understood that she could not read the figures on it and that he had just shamed her, and he took it back.\n\n\"Why are you telling us?\" she said.\n\n\"Because it's true.\"\n\n\"Lots of things are true. The Count doesn't come down here and tell us them.\" She folded her arms. \"What do you want?\"\n\n\"Nothing. I— nothing.\" He found that he did not know what to do with his hands. \"It's my job. The Count is just. An account can't be Called in error. That's the rule.\"\n\n\"The Count is just,\" said Tamsin, flatly, the way you'd repeat a word in a language you didn't speak.\n\nAgathe Hask coughed, then, for a long time, bent over the blanket; and her daughter went to her and held her shoulders until it passed, and Orrin stood in the middle of the small room with his slate and looked away, at the shelf over the stove, where there was a biscuit tin with a picture of a farmhouse on its lid, very old, the paint nearly gone.\n\nWhen the coughing stopped, Agathe sat back and wiped her mouth and looked at him again with her pale eyes.\n\n\"Counter Sallow,\" she said. \"Can I ask you something?\"\n\n\"Of course.\"\n\n\"Who is Caul?\"\n\nHe opened his mouth to say the catechism. _Caul is the dark that kept us when the Company left us in it. Caul is owed for every breath, and the Owing pay._ He had said it every Account Day of his life. He found that he did not want to say it here, in this room, to this woman, and he did not know why.\n\n\"Caul is the Account,\" he said at last.\n\n\"That's what I told my girl.\" Agathe nodded slowly. \"She didn't think much of it either.\"\n\nHe left soon after. In the passage outside, as the door clunked shut behind him, he reached into his coat for his stylus to mark the sighting time on his slate, and found the clip empty. He looked back at the door. He thought about knocking. He thought about the boy on the top bunk, all knees and quick eyes.\n\nHe marked the time with his fingernail, and went back up the galleries into the light.","wordCount":1177,"createdAt":1793146319461,"updatedAt":1793146319461},{"id":"GJBOyOuonWKwxo1Jorezw","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"aV3K3iPiIvRKl7xKEj1nU","text":"He came to find her that night on the Wick.\n\nDagny was on the third crawl, two hundred metres up the spine, half inside a coolant junction with her lamp in her teeth, and she heard him long before she saw him: the clank of somebody climbing who did not climb, the scuff of shoes that were not boots, the hard short breathing of a man who has looked down. When she backed out of the junction he was clinging to the crawl rail ten metres below her, white as the lamp, with his eyes shut.\n\n\"You'll want to open them,\" she said. \"It's worse with them shut. You can't see the rungs.\"\n\n\"I— yes. Thank you.\" He opened them. Below him the whole of Lantern hung, lit, at every angle, the far terraces small as stitches. He shut them again. \"No. I— I don't think I can.\"\n\nShe climbed down to him, because the alternative was to leave a Company comptroller to fall off the Wick in the middle of a shift and spend the next week explaining it to Varga. She hooked a spare tether from her belt to his and clipped it to the rail. \"There. You can let go now, you won't go anywhere. Sit.\"\n\nHe sat on the crawl, very slowly, with his knees drawn up and his back to the rail, like a child on a high wall. The light of the lamp lay on him from above, harsh and white, and showed every line on his face. It was the face of somebody who had not slept in a long time.\n\n\"What do you want, Mr. Basu?\"\n\n\"I wanted— I wanted to speak to you where there aren't cameras.\" He gave a small breathless laugh. \"There's only one place on Lantern the Tally doesn't watch. The Wick's too bright for the lenses. Did you know that? I designed the camera net and I couldn't make it see up here. It was the first thing I ever failed at.\"\n\n\"And the second?\"\n\nHe didn't answer that. He looked at his hands.\n\n\"What the Director told you today was true,\" he said. \"The Tally can't be unlocked without stopping it. I built it so. I was twenty-six and very good at my work and very proud, and the Company wanted a system that could not be argued with, and I gave it one. No back door. No override that a frightened counter could be bribed to use. Every valve asks it. It answers. That's all.\" He breathed. \"But it's not quite all.\"\n\nDagny waited.\n\n\"Every system has a root,\" said Teodor Basu. \"The place where the rules are kept, as opposed to the place where they're applied. The Tally's root is in the vault. A console, about so big, behind three doors. From there you can change anything. The dimming line. The rates. Who owes what to whom. Whether there's a line at all.\" He was speaking faster now, the stammer gone, the way some people's went when they were on ground they knew. \"To open the root you need two keys, together, at the same moment. One is the Director's. You've seen it. She wears it round her neck. The other is the Comptroller's.\"\n\n\"Yours.\"\n\n\"Mine.\" He reached down — she watched him, puzzled — and unlaced his left shoe, and took it off, and put two fingers inside it and drew out a thin slip of something pale, like a long fingernail, which he held up to the light. It was ceramic. There were marks burned into it, too fine to read. \"It never leaves me. Not in the bath. Not in bed. It was a condition of my contract.\"\n\n\"And with both of them,\" said Dagny slowly, \"you could—\"\n\n\"With both of them, at the root, a person could do anything with the Tally that the Tally can do. They couldn't switch it off. It isn't built to be switched off. But they could rewrite its book.\" He put the key back in his shoe and laced it again, with great care, his fingers not quite steady. \"I'm not telling you that you can do this. You can't. The Director will be wearing her seal when she walks up the ramp onto the _Covenant_ and the seal will go through the Throat with her. And I will be on the _Covenant_ too. I'm essential staff. I'm on the list.\"\n\n\"Then why are you telling me?\"\n\nHe looked up at her at last. She thought for a moment that he was going to weep; then she saw that he was past that, a long way past it, in some dry country on the other side.\n\n\"Because you stood on a table,\" he said, \"and said that nobody on this rock was going to owe air to an empty office for six hundred years. And I built the office. And I have done other things, Ms. Ostrova, that I can't— that I won't— \" He stopped. He shook his head. \"I wanted one person to know there was a door. Even if it's locked. Even if there's no getting to it. I wanted someone to know it was there.\"\n\nBelow them, very far down, the bell rang once in the Dock Ring. They both stopped, and listened to it come up the spine, faint and sour, and fade.\n\n\"Who was that?\" said Basu.\n\n\"I don't know. I'll know in an hour.\"\n\n\"Yes,\" he said. \"Everybody always knows.\" He unclipped the tether from his belt and held it out to her, and then, when she didn't take it, clipped it back on. \"Would you— could you help me down? I don't think I can do it on my own.\"\n\nShe helped him down. It took forty minutes. At the bottom he thanked her, very formally, and walked away along the spine-road toward the Counting House without looking back; and Dagny stood at the foot of the Wick in the hard white light and thought about a key in a shoe, and a seal on a chain, and what it meant that a man would climb two hundred metres up a lamp he was afraid of to tell her about a door she could not open.","wordCount":1040,"createdAt":1793146166507,"updatedAt":1793146166507},{"id":"KM62JgVzaVWBLWMxX3GGc","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"E7gP4pT5_i7yTLiAsRdJE","text":"The Hask room was on Gallery Twenty-Two, which was a low gallery, near the Lip, where the light came in sideways and never quite warmed anything. It was three metres by four. It had a bunk for her mother and a bunk for Jory and a mat for Tamsin, a ring-stove, a water tap with a meter on it, a door that opened when the family was in credit and didn't when it wasn't, and on a shelf over the stove, a tin.\n\nThe tin had held biscuits once, a long time ago, in somebody else's family. Now it held chits. Every chit the Hasks had ever owned was in that tin: Tamsin's grandmother's, her grandfather's, her great-grandmother's, a great-uncle who had died at nineteen in a pump accident, a baby who hadn't got a name. When you died on Lantern your chit came home. That was the law. The Count didn't want it; the Count kept the numbers. The family kept the metal, so that it would remember what it owed.\n\nAgathe Hask was sitting up on her bunk with the tin in her lap when Tamsin came in. She did that sometimes, took the chits out and laid them on the blanket in rows, like a game of patience. Her lips moved while she did it. Tamsin had asked her once what she said, and her mother had said, \"Their names, what do you think,\" and gone on.\n\n\"You're late,\" said Agathe, and coughed.\n\nThe cough was the lung-rot. Everybody below Gallery Fifteen got it in the end, from the damp and the mould and the scrubbers that were older than the Count; it came on slow and stayed for years, and it took you by inches, and the Tally charged you for the extra air. Agathe had had it for six years. The last two she'd been off the pumps, which meant she wasn't earning, which meant every breath she drew went on the balance.\n\n\"Got four metres,\" Tamsin said. She swung the copper down onto the floor and stretched her back till it cracked. \"Good four. Thick.\"\n\n\"Count price or Salt price?\"\n\n\"Salt.\"\n\nHer mother's mouth went thin. Agathe had been a pump-hand for thirty years and a churchgoer for all of them, and she didn't like the Salt, and she didn't like that the Salt was where the money was. But she didn't say anything. She'd stopped saying things about money about the time she'd stopped earning any.\n\n\"Where's Jory?\"\n\n\"Out. Running for somebody. Said he'd be back for the Hook.\"\n\n\"Who died?\"\n\n\"Old Pask. Wim Pask, Twenty-Three.\" Agathe coughed again, longer this time, and when she was done she sat with her eyes closed and her hand flat on her chest as though she were holding something down. \"In his sleep. His door dimmed last week. He'd been going up to sleep on the Hook steps. They found him there this morning.\"\n\nTamsin sat down on her mat. She thought about the woman by the hatch, with the shoe. She didn't say anything about the hatch. Not yet.\n\n\"How much was he over?\"\n\n\"Does it matter?\"\n\n\"It matters to whoever gets it.\"\n\n\"His granddaughter. On Nineteen.\" Agathe opened her eyes. They were very pale, her mother's eyes, almost colourless in the bad light; Tamsin had them, and so did Jory. The Hask eyes, people said, as if it were a family heirloom, which in a way it was. \"She's got two of her own. She'll be under by the summer.\"\n\nThey sat for a bit. The water meter on the tap ticked over, once, as somebody somewhere on the family's account drew a cup. Probably Jory, wherever he was.\n\n\"Mam.\"\n\n\"What.\"\n\n\"Who's Caul?\"\n\nHer mother looked at her as if she had asked what air was.\n\n\"You know who Caul is.\"\n\n\"I know what they say in church. I know it's the Account. Caul is owed and the Owing pay. I know the moon's called Caul and the Salt run ice off it. I mean who.\" She heard her own voice, and it was too loud for the room, and she didn't care. \"Who's the money going _to_, Mam? We've owed Caul for three hundred years. Everybody on this rock owes Caul. Every hour of air, every cup out of that tap. Where does it go? Who's sitting on the other side of the book, getting fat on it?\"\n\n\"Nobody's getting fat.\" Agathe's voice was quiet. \"Caul is owed. That's all. Caul is the dark that kept us. When the Company ran and left us in it, the dark could have taken us, and it didn't. It let us breathe. So we owe it. That's what the Account is. That's what the Count keeps. You know all this.\"\n\n\"That's church.\"\n\n\"That's the truth. Same thing, down here.\" Agathe began to put the chits back in the tin, one at a time, in their order. \"You want to know who's on the other side of the book, you go up to the Count and ask them. They've got the book.\"\n\nThe door opened. It made the noise it always made, a hydraulic sigh and a clunk, and the little light by the frame went green, and Jory came in sideways, the way he came in everywhere, as if he were expecting to have to leave in a hurry. He was fifteen and all elbows. He had a cut on his lip that hadn't been there this morning.\n\n\"They're ringing for Pask,\" he said. \"Everyone's going. You coming?\"\n\n\"What happened to your face?\"\n\n\"Ran into something.\" He grinned, and the cut opened, and he licked it. \"There's going to be a crier after. From the Count. Whole of the Hook's full of grey coats. Something's happening.\"\n\nAgathe put the lid on the tin.\n\n\"Help me up,\" she said.","wordCount":972,"createdAt":1793145782271,"updatedAt":1793145782271},{"id":"OeBzEZ_3vXNpt_vM9hAbb","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"A84nmiWcv6-wINQJ3D7BS","text":"The bell of the _Ardent Mercy_ hung at the inner lock of the Dock Ring, on a hook of black iron that had been drilled into the rock the year Lantern was first pressurised. It was not large. It came up to Dagny's hip. It had been cast in the shipyards at Tannet Reach for a colony carrier that had crossed the Throat ninety-one years before, and the carrier had been cut up for her hull plate within a decade of arrival, as such ships always were; but the bell had been kept, because it was bad luck to melt a ship's bell, and because somebody on that first crossing had started the habit of ringing it for the dead.\n\nThere had been thirty-one dead on the crossing. Their names were cut round the lip in a neat, old-fashioned hand. After them came Lantern's dead, in a hand that changed every generation as the dockmasters did, round the lip and up the waist and onto the shoulder and in among the decoration on the crown, so that the bronze was now more letter than metal. From the length of the lock you could not see the names. You could only see that the bell was a strange colour, a dull brown furred all over with scratches, like an old animal.\n\nOdile Marchbank was waiting for her. She had heard; everyone on Lantern heard everything inside an hour, it was the one thing the rock did faster than the Tally. She was seventy-four and three-quarters deaf and she had kept the bell for thirty years, and her hands, which shook when she held a cup, went still as stone when they held the engraver.\n\n\"Adeyemi,\" Dagny said. \"Lemuel. Ten.\"\n\nOdile nodded. She didn't need the spelling; she had cut his wife. She took the bell-rope, which was a length of braided hauler cable, and she rang the bell once.\n\nIt was not a loud sound. Lantern swallowed noise; the rock was too big and too full of air and machinery. But the bell had a voice that went a long way anyway, low and a little sour, and all along the Dock Ring people stopped what they were doing at the sound of it. Hauler crews in the gantries. Customs men at their desks. The women who ran the noodle-stalls along the ring road. They stopped and stood, a breath's worth, and then went on.\n\nDagny felt a small hand slide into hers. She didn't look down.\n\n\"You're supposed to be at school,\" she said.\n\n\"School finished,\" said Pim. \"Everyone came out when they heard the lock. Mister Okonkwo said it was a teaching moment.\" He was twelve, and thin, and he collected bolts, and he had her husband's eyebrows, which she had never got used to. \"Was it Mister Adeyemi from Ten?\"\n\n\"Yes.\"\n\n\"Did you try?\"\n\n\"Yes.\"\n\nHe thought about that. \"How much was he over?\"\n\n\"Four.\"\n\nPim did not say anything else. He held her hand while Odile fitted the engraver's burr and bent to the bronze, and the thin whine of it went up into the ring, and the first letters of Lemuel's name came up bright on the shoulder of the bell, among nine decades of brown.\n\n\"I'm running out of bell,\" Odile said, without looking up. She said it every few months. It was a sort of joke. \"One day I'll have to start on the hook.\"","wordCount":571,"createdAt":1793145334628,"updatedAt":1793145334628},{"id":"WhE620txS9qz0I6sRTT49","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"y2ttHnDgt8Jg1CDQBa4ir","text":"Dagny had thought about how to begin. In the end she didn't begin; Hesketh did, which he had told her he would, because he was the eldest.\n\n\"Director,\" he said. \"There are nine thousand one hundred and forty indentured people on this rock. You've told us you're leaving and they're staying. We've come to ask what happens to them.\"\n\n\"I told you that, too,\" said Ruth Achterberg. She sat very straight at the bare desk. The brass disk of the seal lay against her collarbone, on its chain. \"Their contracts are held in trust. Their systems are run by the Tally. Nothing changes.\"\n\n\"Everything changes,\" said Mariam Oyelowo.\n\n\"Nothing that matters to the air.\"\n\n\"It matters to the air that there'll be nobody on this rock who can hear a complaint,\" said Dagny. \"Five days ago a man died in a lock on Gallery Nine because his balance was four over. There was no counter on Nine. The override was here.\" She put her hand flat on the desk. \"In this building. With you. In fifty days there won't be anybody in this building at all. What happens then, Director? Who does the next one ask?\"\n\nAchterberg looked at her for a moment. \"I'm sorry about Mr. Adeyemi,\" she said, and it was hard to tell whether she meant it; her voice was the same voice she used for everything. \"Mr. Basu has prepared a proposal which I think addresses that. Teodor?\"\n\nThe Comptroller cleared his throat. His hand went to the folder in front of him and then away again.\n\n\"The— the Tally's dimming line,\" he said, \"is currently set at minus nine hundred credits. For the duration of the closure the Company proposes to reset it to minus fifteen hundred. It also proposes to suspend interest on all accounts. So that no balance grows except by— by actual consumption. Nobody's debt will grow merely by— by being there.\"\n\n\"It's a substantial concession,\" said the Director. \"It costs the Company a great deal.\"\n\n\"It costs the Company nothing,\" said Dagny. \"The Company won't be here.\"\n\nThere was a small silence.\n\n\"And what happens at minus fifteen hundred?\" said Hesketh, mildly. \"Same as at nine. Door shuts. Ration stops. Lock goes to recovery. You've given us six hundred credits of rope, Director. That's a year for a child. Then what?\"\n\n\"Then they'll have to work,\" said Achterberg. \"As people do everywhere.\"\n\n\"With what? You're taking the refinery staff. You're taking the ice contracts. You're taking the—\"\n\n\"We are taking,\" said the Director, \"what is ours, Mr. Hesketh. As is our right.\" She did not raise her voice. \"I want to be absolutely clear with all three of you, because I think you have been told things by people who wanted you to believe them. The _Covenant_ can carry fourteen hundred people. She will carry the Company's essential staff, who number four hundred and six with their families, and she will carry their effects and such Company property as can be moved. She cannot carry nine thousand. Nothing in this system can carry nine thousand. If I could take you all, I would not have to, because you would be a cost and not an asset; but I can't, so the question does not arise.\"\n\n\"Then leave us the Tally,\" said Dagny. \"Unlocked. Take the books with you if you want them, take every number in it, but take the locks off the air before you go. Let the scrubbers run for everybody, debt or no debt. That's all we're asking. Not passage. Not money. Air.\"\n\nAchterberg turned and looked at Teodor Basu. Basu looked at the desk.\n\n\"Tell them,\" said the Director.\n\n\"It— the Tally isn't a lock on the air plant, Ms. Ostrova,\" Basu said. \"It is the air plant. That's— that's how it was designed. There is no separate control system. Every valve on Lantern asks the Tally whether to open, and the Tally answers by— by checking whose air it is. If you took the Tally out, the valves would have nobody to ask. They'd fail closed. Every one.\" He spread his hands, helplessly. \"There's no way to unlock it without— without stopping it. And if you stop it—\"\n\n\"Everyone dies,\" said Achterberg. \"Yes. I'm sorry. It was not built to be convenient for this moment. It was built, ninety years ago, to make sure no one on this rock ever took air that was not paid for. It has done that very well. It will go on doing it.\" She folded her hands. \"I would ask you to look at it a different way. The Tally is the only reason this colony can survive our withdrawal at all. It runs itself. It needs no engineers, no clerks, no Director. As long as you work, it will keep you alive. That is not nothing. In most closing systems in the Concord's history the colonists starved within a decade. You will not.\"\n\n\"We'll just owe,\" said Mariam.\n\n\"You'll owe what you have always owed. To the people who built this place and paid for your passage to it.\" Achterberg stood. \"And one day the Throat will open again, and the Company — or its successors — will come back, and the debt will be honoured. That is what _in trust_ means. It means we haven't forgotten you.\"\n\nBehind her, Hale Varga, who had not said a word, shifted his weight very slightly, the way a big man does when he wants a room to remember he's in it.\n\nHesketh got up on his stick. \"Six hundred years,\" he said. \"That's a long time to be remembered.\"","wordCount":938,"createdAt":1793146166579,"updatedAt":1793146166579},{"id":"_IkYbB-i8RZByIfokDnFN","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"pHplzGMP6B9jNZUrFoF11","text":"The _Good Title_ was a Throat-runner, which was to say she was old, strong, ugly, and built around an engine much too big for her. She had been built to carry cargo through healed throats in the years when throats were still healing, in the last great age of opening, three centuries back. She had run the Ashcombe Throat when it was a raw wound full of debris and the Pellan Throat the week it opened, and she had the scars of both down her flanks, sealed over in four different colours of hull compound. Her master had been running her for thirty years.\n\nCaptain Mabry Ode was sixty-three, gaunt as a gantry, and she did not shake hands. She met them at the ship's lock in a coverall that had been washed so often it had no colour left, and looked at Corvin, and at his case, and at Haste behind him, and at the crate on its trolley with Fen beside it, and said, \"What's that?\"\n\n\"A bell,\" said Fen.\n\n\"I can see it's a bell. What's it for?\"\n\n\"It's going home.\"\n\nOde looked at her for a moment longer, as if deciding whether this was a joke, and then turned and spat, accurately, into the gap between the ship's lip and the dock. \"Tol,\" she said. \"Find a place for the lady's bell. Not the hold. The hold's spoken for.\"\n\nA thin man with grease to his elbows unfolded himself from a hatch and came and looked at the crate with more interest than he had shown in any of the people. \"What's she weigh?\"\n\n\"Three hundred and twelve kilos.\"\n\n\"Bronze?\"\n\n\"Mostly tin bronze. Some lead.\"\n\n\"Huh,\" said Tol Brask, and took the trolley without another word, and went off down the corridor talking to it under his breath.\n\n\"The hold's spoken for?\" said Corvin.\n\nOde jerked her head at Haste. \"Ask him.\"\n\nHaste only smiled. \"Agricultural stock. For the colony, if there is one. Seed, embryos, a soil culture library. If there's no one there, we'll need to start something. It's all sealed and certified. The captain's been very patient about it.\"\n\n\"The captain's had her hold sealed by a lien-house for the first time in thirty years of running throats,\" said Ode, \"and the captain's got a ship that's mortgaged to that lien-house to the last rivet. So the captain's been very patient about it. Yes.\"\n\nBehind them, on the dock, there was the sound of boots. Corvin turned. Ten men and women were coming up the dock in a loose column, in the dark grey field uniform of Brightwater's bailiffs, with kit bags on their shoulders and long cases slung on their backs that were not tools. At their head was a heavy, unhurried man of fifty with a sergeant's flash on his sleeve and the bored eyes of someone who has seen every kind of trouble and found none of it interesting.\n\n\"Sergeant Kell,\" said Haste. \"And his people. You'll find them very quiet.\"\n\n\"I wasn't told about bailiffs,\" said Ode.\n\n\"You were told about a recovery team, Captain.\"\n\n\"I was told about clerks.\"\n\n\"Sergeant Kell is a very good clerk,\" said Haste, and stepped aside to let the column file past him into the lock. Kell nodded to the captain as he passed, civilly enough. Ode watched him go with an expression Corvin had seen before, on four hundred and twelve settlements, on the faces of people watching the bailiffs come off the boat.","wordCount":582,"createdAt":1793146023698,"updatedAt":1793146023698},{"id":"d7jHHKzQPikNWTLYvVcsM","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"gL8RzmdmYsU_VJsOTmErj","text":"She found Pim on the way home, asleep on the bench by the Bell Hook with his school bag for a pillow and his collection of bolts spilling out of his pocket. Odile was sitting beside him with her engraver in her lap, not working, just sitting, the way old people did.\n\n\"I let him stay,\" Odile said. \"He wanted to see the new name. It's a woman from the stills. Bronwen Price. Her heart.\"\n\n\"Thank you.\"\n\n\"He asked me why we cut the names.\"\n\n\"What did you tell him?\"\n\nOdile looked up at the bell, brown and furred and silent on its iron hook above them. \"I told him what my master told me. A ship's bell remembers its crew. Everybody that sailed on her. Everybody that died aboard. When the ship's gone, the bell's what's left, and the names are what it remembers.\" She sniffed. \"He said Lantern isn't a ship. I said it was the only ship any of us has got.\"\n\nDagny sat down on the other side of her sleeping son, and for a while the three of them stayed there, under the bell, in the dim light of the ring at night.\n\n\"They're leaving the Tally to count what we owe them,\" Dagny said at last. \"Every hour of air, for six hundred years.\"\n\n\"So I hear.\"\n\n\"Somebody ought to count what we're owed.\"\n\nOdile turned her head and looked at her, with her old faded eyes, for a long moment. Then she looked up at the bell.\n\n\"I'm running out of bell,\" she said.\n","wordCount":261,"createdAt":1793146166203,"updatedAt":1793146166203},{"id":"duM0s0eBIdnfxMhM7Syx1","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"Zc5kIuvenmtRkGl-4jtFs","text":"It was on the way out, with four metres of copper strapped to her back and the reel winding at her hip, that she found the hatch.\n\nShe'd taken a different way. That was the third thing you learned about the Cold: never quite the same way twice, because the rock moved, a little, over the years, and ice built where it built, and a road you knew could be a slide of frost between one trip and the next. Her usual route through the back of Fourteen had iced over, so she went down a level and along a service way she didn't know, keeping the tether in mind, counting metres.\n\nThe service way ended in a door. Not a house door. A big one, set into the raw rock of the outer wall, with a frame of riveted steel and a wheel at its centre the size of a cart-wheel, rimed white. Tamsin put her brow-lamp on it and brushed at the frost with her glove, and the letters came up under the ice in the old square type nobody used any more.\n\nAFT STORE 3. And under that, two letters leaning on each other like tired men, which she had seen before only in the oldest bits of the Cold, on pipes and plates and the backs of machines: H and A.\n\nThe Company.\n\nShe stood looking at it for a long time. Everybody on Lantern knew the story, the way everybody knew the Account. Once upon a time there had been a Company, and the Company had owned the rock and everything in it, and the Company had built the Wick and the Tally and the locks, and then the Throat had begun to close and the Company had run. Out through the Throat, in their ships, with everything they could carry, and the door shut behind them and they never came back. They took the good fuel and the medicines and the bell from the Dock Ring. They left the Tally, and the Account, and the people. That was the story. You heard it in school and in church and in the songs they sang at the Hook.\n\nAnd here was one of their doors, still shut.\n\nThe seam round the frame had been welded. Not with a cutter's torch, either; it was a proper bead, wide and even, the work of somebody who'd meant it to stay shut for ever. On the floor in front of it, half under the frost, was a body.\n\nThat wasn't unusual. There were bodies all over the Cold. People had died in it when it was first let go, and people had died in it since — cutters, runaways, the drunk, the dimmed who had nowhere else to sleep. The cold kept them. Tamsin knelt and put her light on this one because it was the decent thing and because sometimes they had a chit that could be turned in to the Count, which paid a finder's tenth on any balance closed by death.\n\nIt was a woman, she thought, though it was hard to say. Dried to leather by three centuries of cold dry air. She was wearing old coveralls with the H-A letters on the shoulder, and she was sitting with her back to the hatch and her knees drawn up, and in her two hands, held against her chest, was a child's shoe. Just the one. Small. Red once.\n\nThere was a chit on a cord round her neck. Tamsin turned it to the light. The number was rubbed away, and the old-style printing on the face of it was mostly gone, but the balance was still there, in brackets, as balances always were when they were bad. Two thousand and something.\n\nShe didn't take it. She didn't know why. She sat back on her heels and looked at the woman and the shoe and the welded door, and the frost fell sideways through the light, and from very far away, through a kilometre of cold and dark and rock, she heard the Hook ring.\n\nSomebody was dead.","wordCount":683,"createdAt":1793145782468,"updatedAt":1793145782468},{"id":"gATg08Lbd7eU3yzW7E0lZ","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"4FxCZy2Qs_KaAt_JBQN7T","text":"What happened in the canteen in the next ten minutes Dagny remembered afterwards only in pieces. A man on Gallery Six put his chair through the screen and the screen went on showing football in a web of cracks. Two women began to fight over nothing, over a bench, and had to be pulled apart. Old Mister Okonkwo the schoolteacher sat with his hands flat on the table, saying, \"Six hundred years, six hundred years,\" as if it were a sum that would come out differently if he said it often enough. Somebody shouted that the Company would take the fuel. Somebody shouted that the Company would take the water. Somebody shouted that they should go up to the Upper Wards now, all of them, and see how many lists the department heads had made when they had their own windows broken.\n\nAnd Pim was beside her, she didn't know when he had come in, saying, \"Mum. Mum. In trust. What's in trust mean?\"\n\nShe understood it, she realised, before she understood anything else. It was Lantern; you learned the Company's language before you learned your prayers. _Held in trust_ meant that the Company was leaving, and the debt was staying. It meant that every chit on every wrist on Lantern would go on counting down, hour by hour, against the air, for six hundred years, and that if the Throat ever opened again somebody in a Company suit would come through it with the books in their hand to see how much was owed. It meant that the Adeyemi girl's twelve hundred would be eighteen hundred by the time she was grown and nine thousand by the time she died, and would go to whoever came after her.\n\nIt meant that the lock on Gallery Nine would go on doing what it had done to Lemuel, with nobody even in the Counting House to blame for it.\n\nShe found she was standing on a table. She did not remember getting up there. The canteen was looking at her, the way the Wick crews looked at her when the lamp went wrong and someone had to say a number out loud.\n\n\"All right,\" Dagny said. Her voice came out level, which surprised her. \"All right. Shut up and listen. I'm a Speaker for the Wick crews, and from tonight the Wick crews are going to want to talk to the other crews. Pumps, farms, docks, stills. Everyone who wears a chit. Fifty-two days is a long time. It's long enough for the Company to pack. It's long enough for us to make it listen first.\"\n\n\"Listen to what?\" somebody shouted.\n\n\"To the one thing it hasn't said.\" She held up her wrist, with the chit on it, so that the canteen could see the blue numbers. \"She said the Tally keeps us alive. It doesn't. We keep it alive. We fed it ninety years. If the Company's going, the Company can take its ledger with it, or it can switch the bloody thing off before it goes. Either way, nobody on this rock is going to owe air to an empty office for six hundred years.\"\n\nThere was a silence. Then the man who had broken the screen began to clap, slowly, and others took it up; and Joss, below her, looked up with his wet red face and said, very quietly, so that only she could hear: \"Dag. You know what you just did.\"\n\nShe did. She had just volunteered.","wordCount":581,"createdAt":1793145334287,"updatedAt":1793145334287},{"id":"gmliWU61jApADCLUg8GnJ","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"jCCT8EN2Vj2l-O2J-Y878","text":"Her name was Fen Adaire and she was twenty-nine and she had brought a bell.\n\nIt was in a crate on a station trolley, packed in grey foam, and she would not let it out of her sight. She had come straight from the packet dock with it, she said, because she had been told her berth was on the _Good Title_, and she wanted to see the hold before she agreed to put anything in it, and then the porter had brought her up to the third ring by mistake and here she was. She said all this rather fast, standing in the doorway with one hand on the crate, a slight woman in a travelling coat too warm for the station, dark hair cut short, a provenance archivist's loupe on a cord round her neck. Haste introduced her with the air of a man producing a clever purchase.\n\n\"Miss Adaire reads dead companies,\" he said. \"Ledger formats, charter law, corporate scripts. She did the Tannet salvage for us four years ago. When we found out what else she had, we thought she ought to come.\"\n\n\"What else she had?\" said Corvin.\n\nFen looked at Haste, and then at Corvin, and then she knelt and undid the clasps on the crate and folded back the foam.\n\nThe bell lay on its side in a nest of grey. It was not large — he could have got his arms round it — and it was a strange dull colour, a brown furred all over with fine pale scratches, so that at first he took it for something badly corroded. Then she turned it a little toward the light and he saw that the scratches were letters. Every surface of it was cut with names. Round the lip, up the waist, onto the shoulder and across the crown, in among the casting's raised decoration, in a dozen different hands: names, thousands of them, so close and so many that the bronze between them was only a sort of mortar.\n\nAcross the waist, in raised capitals that had been part of the original cast, larger than everything else and nearly worn away, were two words. ARDENT MERCY.\n\n\"She was a colony carrier,\" said Fen. \"Built at Tannet Reach in 2290. She crossed into the Sabra system in 2296 with the first Halden-Ash settlers. She never came back out. Carriers didn't; they were broken up for plate on arrival. This was her bell.\"\n\n\"Then how is it here?\"\n\n\"That,\" said Fen, \"is the question.\" She sat back on her heels. \"My family's had it six generations. My great-great-great-grandmother bought it at a wreck auction at Tannet. The lot was listed as _bell, bronze, inscribed, recovered from unidentified hulk, condition poor_. She paid eleven crowns for it. Nobody knew what it was. My grandmother was the one who read the waist and looked up the name. We've been trying to find out how it got out of Sabra ever since.\"\n\n\"And?\"\n\n\"And nothing. There's no record of it on any manifest. No record of any Sabra ship being wrecked on the Concord side. The Throat closed in 2387 and the bell turned up at Tannet thirty years later on a hulk nobody could identify, and that's all anybody knows.\" She ran her thumb along the lip, very lightly. \"Somebody brought it out. Somebody carried it through, before the end. I'd like to know who. And I'd like to take it home.\"\n\n\"Home,\" said Corvin.\n\n\"Back through. To wherever it came from.\" She looked up at him and, for the first time, seemed to see him properly: the case, the suit, the face. Her mouth tightened a little. \"Mr. Haste tells me you're the man who'll be explaining to them what they owe.\"\n\n\"If there's anyone to explain it to.\"\n\n\"Yes,\" said Fen. \"If.\"\n\nHe crouched beside the crate, because it seemed rude not to. Close to, the names became legible. They were tiny, most of them, cut with a fine burr, and the oldest were so worn that he could only make out a letter here and there. The newer ones were sharper. He tilted his head and read the nearest bright line, high on the shoulder, where the light caught it.\n\n_Lemuel Adeyemi._\n\nJust a name. One of thousands. He did not know why it stopped him. Perhaps only that it was so clear, so cleanly cut, as if someone had made it the day before.\n\n\"How many names?\" he said.\n\n\"I've counted two thousand nine hundred and eighty, give or take the ones I can't read.\" Fen closed the foam over the bell, gently, as if putting a child to bed. \"A carrier's crew was forty. Her colonists were six hundred. I don't know who the rest of them are, Mr. Saal. I'd very much like to.\"","wordCount":805,"createdAt":1793146023773,"updatedAt":1793146023773},{"id":"oecBo2F4hgrbFFbV_79Px","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"AEagkJ64mjXguslMU4DWt","text":"That night, in the cabin he had been given — a steel box two metres by three, with a fold-down desk and a bunk and a porthole looking out on the dock lights — Corvin opened the case and began, again, on the Company's records.\n\nThere were not many. When a throat closes, the last news through it is whatever happened to be on the last ship. Halden-Ash's final filings from the Sabra Concern had come out on a data-run forty days before the Closing: a few thousand pages of accounts, inventories, staff lists, a throat-watch summary, and a statement from the Director to the Company's board. After that there was nothing at all. Seven hundred years of nothing.\n\nHe read the Director's statement again. It was short and dry and he could find nothing wrong with it. _The throat-watch has confirmed the onset of a closing phase. The Concern will withdraw in good order. Essential staff and Company assets will be transported. The indentured population will remain, its contracts held in trust in accordance with the Company's charter, its life-support administered by the Tally, which is fully autonomous and requires no Company supervision. All Concern operations will be wound down prior to withdrawal._\n\nAnd then a list of the operations, and how each had been wound down. The refinery. The greenhouses. The water contracts with the ice-haulers. And, near the end, one line he had noticed on the packet and noticed again now, because it was the only line in the whole document that was about people rather than things:\n\n_Caul Deep: mine closed, spring 2387; workforce of 900 repatriated through the Throat per contract, completed prior to this report._\n\nHe read it twice. Nine hundred people, sent home. Their contracts bought out, presumably, or completed. A decent thing for a company to do, before it left the rest behind. It was the only decent thing in the file.\n\nHe made a note to ask the archivist where the nine hundred had been landed, and turned out the light.\n\nOutside the porthole, very faint, beyond the dock lights and the station's sprawl, the patch of wrong sky was breathing pink.\n","wordCount":361,"createdAt":1793146023502,"updatedAt":1793146023502},{"id":"qUVL7gXBE7dSskpz1KYxZ","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"HndU3cXz3axOEEAjEX_H4","text":"The Slake was the worst bar on the Dock Ring and therefore the one the hauler crews used, a low cave cut into the ring wall with a counter made of a hauler's old heat-shield and a smell of spilt still-spirit that had soaked into the rock itself. Kas was at the back table playing banker for a game of shove with four crewmen off the _Agnes_ and the _Dorrit_, and losing. He lost cheerfully. Kas always lost cheerfully; it was why people kept letting him play.\n\nHe saw her face in the doorway and folded his hand.\n\n\"Gentlemen,\" he said, \"my sister has come to save me from myself. Hold my seat. Don't look at my cards. I'll know.\" And he came over and steered her to the end of the counter, where the noise was worst and nobody could hear.\n\n\"Well?\" he said.\n\n\"Nothing. She gave us six hundred credits of rope.\"\n\nKas whistled softly. \"Generous.\"\n\n\"Basu says the Tally can't be turned off without killing everyone.\"\n\n\"Basu would know.\" He signalled for two cups of the thin brown beer the Slake brewed in a tank out the back, and when they came he pushed one to her and drank half of his own in one go. \"So what now? Strike?\"\n\n\"Maybe. Hesketh thinks it's too early. Mariam thinks it's too late.\" She turned the cup in her hands. \"Kas. When's your next run?\"\n\n\"Two days. Why?\"\n\n\"Do any of the haulers go through the Throat? Even now? I was thinking — if somebody could get a message through. To the Concord. The papers, the courts, the Labour Office, I don't know. Somebody who'd care that nine thousand people were being left behind in a box with a meter on the air.\"\n\nHe laughed, not unkindly. \"Dag. Nothing goes through the Throat that the Company doesn't send. Haulers haven't got the drive for it, and the throat-watch would see you coming a week out, and Varga's men would have you before you got halfway. The only things going through now are the _Covenant_ and the last two data-runs. And the data-runs are the Company's.\" He drank again. \"Besides, who in the Concord would care? You think we're the first? There's a hundred company towns past a hundred throats. Nobody cares about any of them.\"\n\nShe didn't answer. After a while he put his hand on her arm.\n\n\"Listen,\" he said, in a different voice. \"I've had an offer.\"\n\n\"What kind of offer?\"\n\n\"Company work. Hauling.\" He glanced round; nobody was near. \"They want every tug that can push a load moving cargo from the aft stores up to the fore dock. Fuel cassettes. Out of the stores and into the _Covenant_'s hold. Hundreds of them. They're paying in hard credit, Dag. Concord credit. Not chits. Real money, that spends on the other side.\"\n\nShe stared at him. \"They're taking the fuel.\"\n\n\"Some of it. They say they're leaving enough for the Wick. Three hundred years, at the length she burns now.\" He shrugged. \"They're taking the rest. It's theirs. They bought it.\"\n\n\"And you're going to haul it for them.\"\n\n\"I'm going to get paid for hauling it for them.\" His hand tightened on her arm. \"Think, Dag. Think about what hard credit's good for. On this side of the Throat it's worth nothing. On the other side it's worth everything. If a man had enough of it—\"\n\n\"There's no other side, Kas. Not for us. You just said so.\"\n\n\"Not for us,\" he agreed, and let go of her arm, and smiled, and the smile was the one he had used on her since he was five years old and had broken something. \"Course not. Drink your beer.\"","wordCount":621,"createdAt":1793146166430,"updatedAt":1793146166430},{"id":"rGUYP0XHLPgUFTnve3V9l","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"8jiGFknV0ZrBQVyPMlNAI","text":"He had never been to the top of the Counting House. The Comptroller-General's gallery was a single long room with a single long window, curving, that looked straight down the length of Lantern along the Wick, and when Orrin came through the door the light hit him so hard he had to stop and put his hand up. Beyond the glass the whole world hung, lit and upside down: the Upper Wards bright, the Galleries dimming, the Wick blazing down the middle of the sky to where, two-thirds of the way along, it simply stopped, and beyond it the dark of the Cold lay like a bruise.\n\n\"Few people are prepared for it,\" said Imre Vosk. \"Sit, Counter. Please.\"\n\nHe was at a desk at the far end of the room, with the window behind him so that it was hard to see his face. Orrin sat. There was a cup of tea in front of him, already poured. He did not touch it.\n\n\"You've been in the root,\" said Vosk.\n\n\"Yes, Comptroller-General. I'm fourth rank. It's open to—\"\n\n\"It is open to you. Yes. I'm not reproaching you.\" Vosk's voice was as soft as it had been at the Hook; it was a voice you leaned toward without meaning to. \"I'm interested in what took you there. Counters of your age don't usually go reading three hundred years of rate tables for pleasure.\"\n\n\"There's an error in an account on the Calling list. A surcharge keyed to the whole balance. I wanted to see whether the rule was at fault, or the keying. It was the keying. The rule's sound.\"\n\n\"Of course it is. The Founders wrote it.\" Vosk nodded. \"And the account?\"\n\n\"Hask. Agathe. Twenty-Two. Corrected, she's above the cut. I filed it. Senior Counter Abney refused it until after the lists.\"\n\n\"Abney was correct. We can't have corrections in flight during a Calling, Counter. You understand that. If every counter went into every account looking for reasons to lift it over the line, the line would mean nothing, and the Calling would fail, and then all of us would go into the dark together.\" He spread his hands. \"It's a hard rule. It's the rule.\"\n\n\"She doesn't owe it,\" said Orrin. \"Two thousand credits of it. It's not hers.\"\n\n\"Then it will be corrected afterwards, as Abney said.\"\n\n\"Afterwards she'll be in the Cold.\"\n\n\"Yes,\" said Vosk gently. \"That's a pity.\" He let a moment pass. \"You saw the first entry. In the root.\"\n\nIt was not a question. Orrin said, \"Yes.\"\n\n\"What did you make of it?\"\n\n\"I didn't— I don't know. _Account holder, none._ And the key. I've never seen the Tally say that.\"\n\n\"The Tally says what it was told to say, at the Founding, by people who had a great deal more to think about than how it would read to a counter three hundred years later.\" Vosk leaned forward a little, and the light from the window lay along his shoulder and the side of his face. \"Let me tell you what the doctrine says, Counter Sallow, since you know it already. The Account is held by Caul. Caul holds itself. The Founders gave the Account to the dark that kept us, so that no living man could ever own it, and no Company could ever come back and claim it. That is what _holder, none_ means. That is why the key is not known. Because it was not a man's key. Do you understand?\"\n\n\"Yes, Comptroller-General.\"\n\n\"The Count administers the Account. It does not own it. I hold the Count Key, which lets me keep the books, and I hold it as my predecessors did, in trust, for Caul. That's all. There's nothing hidden in the root, Counter. There's only the Founding, which is a holy thing, and which is not improved by being puzzled over by clever young men at dinner time.\" He sat back. \"You've done good work on the Calling lists. Abney tells me you're the most careful counter in the third hall. I'd like you to go on being careful. Finish your four hundred. Sign your sightings. And then, when the Calling is done, refile your correction, and I will approve it myself.\"\n\nOrrin looked at the tea he had not drunk. He thought of the room on Twenty-Two, and the tin with the farmhouse on the lid.\n\n\"Thank you, Comptroller-General,\" he said.\n\n\"Owing and owed, Counter.\"\n\n\"Owing and owed.\"","wordCount":743,"createdAt":1793146319319,"updatedAt":1793146319319},{"id":"rVXGdPMNuQjkpHT5DrMJk","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"yOks9hrcFzL4xJijiOILK","text":"Orrin Sallow had been taught, at six, that every number in the Account was a person, and that a counter who made an error had wronged somebody he would never meet.\n\nHe had believed it then and he believed it now, at twenty-six, sitting at his slate in the third ledger hall of the Counting House with the lamps turned up as far as the Count allowed and a cup of cooling barley-water at his elbow. He believed it in the plain unexamined way he believed that the Wick was above him and the rock below. It was why he had become a counter rather than a doctor or a Wickwright, which had been his mother's two hopes for him. A doctor saved the one in front of him. A counter, if he was careful, kept faith with all of them.\n\nThe ledger halls lay in the belly of the Counting House, under the old Company offices and over the Sanctum, where the Tally itself ran and where nobody went but the Comptroller-General. There were five halls, each a long low vault with rows of desks down it, and at every desk a counter in grey with a slate, and on every slate a family. The halls were quiet. Counting was quiet work. There was only the soft tapping of styluses and, very faintly, through the floor, a hum that some of the older counters said was the Tally thinking and that Orrin privately thought was a pump.\n\nThe Hulk was under all of it. You could not forget that in the halls, because the floor of the lowest one was not rock but metal: a great curved plate, riveted, cold to the touch, painted over many times in Count grey and showing through the paint in places as a dull blue. Children who came on the Account Day tours were allowed to kneel and put their hands on it. _That's her_, the guides said. _That's the_ Ardent Mercy, _that brought the first families. The Founders built the Count on her bones, so that the Account would stand on the ship that brought us._ Orrin had put his hand on it at seven and felt nothing at all, and had been ashamed of feeling nothing, and had never told anyone.\n\nThe Calling lists had come down from the Comptroller-General's office four days ago, ten thousand accounts in order of depth, and had been divided among the halls. Each counter had been given four hundred. The instruction on each slate was the same, in the Comptroller-General's own neat hand: _Verify. Every balance, every entry, from the last birth to the present hour. No account may be Called in error. The Count is just._\n\nOrrin had three hundred and twelve still to do. He was on Hask.","wordCount":465,"createdAt":1793146319668,"updatedAt":1793146319668},{"id":"tEVgek3t6kDFDbcdzt4cT","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"nMF2Eceln_s4_fNZVUL2s","text":"Brightwater Recovery had rented an office on the station's third ring, behind a door with the firm's name freshly lettered on frosted glass. Quennell Haste was waiting for him inside it.\n\nCorvin had met Haste twice before, both times in the firm's tower on Kessane, both times across a table with a great deal of polished wood on it. Haste was in his forties, slim and pale and beautifully kept, with the kind of patience that cost money to acquire. He was a junior partner. At Brightwater that meant he owned a slice of the firm and the firm owned the rest of him; Corvin had never been sure which part was talking.\n\n\"Mr. Saal. Good of you to come so far.\"\n\n\"I wasn't given the choice, Mr. Haste.\"\n\n\"No,\" Haste agreed pleasantly. \"But it was good of you all the same. Sit. You'll have read the file.\"\n\nCorvin sat. He had read the file. He had read it on the packet from Kessane, six weeks of it, and then read it again, and the more he read it the less he liked it, which was usually a sign that it was a good one.\n\nIn 2296 the Halden-Ash Company had opened the Sabra Concern: an ice-mining and fuel-refining colony beyond a newly charted throat, worked by indentured labour. Ninety-one years later, in 2387, the throat had entered a closing phase and Halden-Ash had withdrawn its staff. Its indentured workers, nine thousand of them, had been left behind with their contracts held in trust. Two years after that, Halden-Ash had failed. Its assets had been broken up and sold. Most of them were worthless, because most of them were on the far side of a dead throat. One of the worthless assets — the Sabra Concern's receivables, which was to say the debt of nine thousand people who could not be reached and might not be alive — had passed through the hands of nineteen lien-houses in seven centuries, at prices that fell to almost nothing and then, as the throat-watchers began to publish their numbers, rose again. Brightwater had bought it eleven years ago.\n\n\"You've seen the figure,\" said Haste.\n\n\"I have.\"\n\n\"Say it, would you? I like to hear it said.\"\n\nCorvin said it. It was a number with more digits than the population of the Concord. It was what nine thousand people's air and water and heat and housing came to, at the Company's 2387 rates, plus seven hundred and two years of compound interest at the rate written into the contracts.\n\n\"Of course nobody expects to collect it,\" said Haste. \"That number is a legal fiction. What matters is the instrument. Under the Perpetual Instruments Act, a debt held in trust by a Concord company, over persons under that company's contract, attaches to those persons and their issue for the life of the instrument. The instrument has no term. Halden-Ash wrote it so. Which means, Mr. Saal, that if there is anyone alive on the far side of that throat — anyone at all who is descended from a Halden-Ash indenture — then the moment we come through, Brightwater holds their contracts.\"\n\n\"And if there's nobody alive?\"\n\n\"Then we have a rock, a fusion lamp, a refinery, and first title to a system nobody else has a claim on.\" Haste smiled. \"Brightwater wins either way. That's why we bought it.\"\n\n\"And what do you need an adjuster for?\"\n\n\"Because if there are people,\" Haste said, \"someone has to go and stand in front of them and explain.\" He leaned back. \"You're very good at that. I've read your file too. Eleven years on the colony circuit. Four hundred and twelve settlements. A very low rate of incident.\"\n\nCorvin said nothing. A low rate of incident meant that when he stood in front of people and explained, they mostly didn't kill him. It meant he was good at the voice. The calm, sorry, unmovable voice of the man who has come for what is owed and will not leave without it.\n\n\"There's one more thing,\" said Haste, \"and then I'll let you go and find your berth. Your bond.\"\n\n\"I know what my bond is.\"\n\n\"I know you do. I'd like you to know what it could be.\" Haste took a slip from his pocket and laid it on the desk between them and turned it round with one finger so that Corvin could read it. It was a discharge. Fully drafted. It wanted only a partner's seal. \"Your father's water debt was sold to Brightwater when you were nine. You have been working it off for thirty-five years. At your current rate you'll be clear of it at seventy-one. If you bring us the Sabra Concern — the instrument, enforced, on a living population, or clean title to the system if there isn't one — this is yours. That's not a promise. It's a term. It's in your assignment letter.\"\n\nCorvin looked at the slip for a long moment.\n\nHe thought of his father, who had signed him over in a water-office on Kessane with his hand shaking, and had died four years later, and whose face Corvin could no longer quite remember. He thought of the colony circuit, the four hundred and twelve settlements, the faces he could remember.\n\n\"I'll need to see the Company's records,\" he said. \"Everything that came through before the Closing. And someone who can read them.\"\n\n\"You'll have both,\" said Haste. \"The records are aboard. And the someone—\" he glanced at the frosted door, where a shape had just stopped, hesitating, with something large on a trolley— \"is, I think, here.\"","wordCount":941,"createdAt":1793146023842,"updatedAt":1793146023842},{"id":"u623PrU0xW8CayMT3A_we","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"CimEAn-7R7WEXiipp9rpn","text":"The Hook was an iron bracket the length of a man's arm, black with age, drilled into the rock wall of the Dock Ring above the inner lock. There was nothing on it. There had been nothing on it for three hundred and eleven years. It was the only empty thing on Lantern that nobody had ever tried to fill.\n\nUnder it there was a square, as much of a square as the curve of the rock allowed, and the square was full. Gallery Twenty-Three had come for Wim Pask, and so had a good part of Twenty-Two and Twenty-Four, and a crowd of dockhands from the Salt Docks aft along the ring, and the noodle-sellers, and children who had nothing better to do. Tamsin got her mother onto the steps at the side where she could lean on the wall, and Jory slid off into the crowd at once, and Tamsin stood with her hand on her mother's shoulder and watched Pask's granddaughter go up to the Hook.\n\nShe was a young woman, younger than Tamsin, with a baby on her hip and a toddler holding her trouser leg. One of the old men handed her the bar. It was a length of iron pipe, worn smooth and dark at the gripping end by three hundred years of hands. The woman stood under the Hook and looked up at the empty bracket and, after a moment, with the baby on her hip, she swung the bar up and struck it.\n\nThere was no bell. There had not been a bell since the Closing. What there was, was the iron Hook ringing against iron, a hard flat clang that went out across the square and along the ring and was swallowed by the rock. It was a poor sound. It was not meant to be anything else. Everybody in the square stood still for it, and touched their chits, and said, under their breath, \"Owing and owed.\"\n\n\"Owing and owed,\" said Agathe, and coughed.\n\nThe young woman handed back the bar. Nobody would cut Wim Pask's name into anything. There was nothing to cut it into. His chit would go into the woman's own tin, on Nineteen, beside her mother's and her father's, and his balance would go onto her account, and the baby on her hip would carry a part of it from the day she got her own chit at six. That was all. That was what a death was, on the Owing side of Lantern.\n\nTamsin had always thought the Hook was the saddest thing on the rock. She'd said so once, when she was small, and her grandmother had told her not to be soft. _The Company took the bell when they ran_, her grandmother had said. _They took the bell and every name on it. We ring the Hook so we remember there was a bell, and there were names, and somebody took them. That's not sad. That's angry. Get it right._","wordCount":497,"createdAt":1793145782169,"updatedAt":1793145782169},{"id":"umZFgYsU6gOfR70JmzpvH","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"ssvpvVWG-PUr4fVLVNAEq","text":"From the observation gallery of Port Ambry you could see the Throat begin to heal, if you knew where to look and were prepared to look for a long time.\n\nCorvin Saal had been told this by four different people since he came off the packet that morning, and he had been told it the way people on frontier stations told you things, as if they had personally arranged it. Port Ambry was a station that had waited three hundred years for one event. It had been built, at enormous expense, by a consortium of lien-houses and throat-speculators who had calculated that the Sabra Throat must heal some time in the thirtieth or thirty-first century and wanted to be first through it when it did. The consortium had gone bankrupt twice. The station had been sold, sublet, mortgaged, half abandoned, reoccupied. Generations of people had been born on it, grown old on it, and died on it, staring at a patch of black sky where nothing happened. And now something was happening, and the whole of Port Ambry was drunk on it.\n\nHe found a space at the gallery rail between a woman selling hot noodles from a tray and a priest of some throat-cult in orange, and looked.\n\nAt first there was nothing. Stars. The faint brown smear of a dust lane. Then, as his eyes learned the sky, a place in the middle of it where the stars were wrong: a little smeared, a little doubled, as if seen through old glass. And in the centre of the wrongness, so faint it might have been his own pulse in his eyes, a colour. Not a light. A colour, a sort of bruised pink, coming and going.\n\n\"She's breathing,\" said the noodle woman, with satisfaction. \"Four months ago you couldn't see a thing. Now look at her.\"\n\n\"When will it open?\"\n\n\"Open? It's open. You could put a probe through it today and it'd come out the other side in a hundred bits.\" She handed a carton to someone over his shoulder and took a coin. \"A ship? Three weeks. The throat-men say three weeks. That's when the lips settle. And then—\" she spread her hands, taking in the gallery, the station, the long docks below them where Corvin had counted eleven ships under refit when he came in— \"then it's the Rush.\"\n\n\"Don't call it the Rush,\" said the priest in orange, mildly. \"It's the Return.\"\n\n\"It's the Rush, Father, and you've got a berth on the _Saint Ishmael_ same as everybody.\"\n\nThe priest smiled and looked at the bruised place in the sky and said nothing. Corvin looked at it too. He tried to feel something about it. Seven hundred and two years. On the far side of that patch of wrongness there was a star called Sabra, and a gas giant, and a rock, and once there had been nine thousand people on the rock, and after the Throat shut nobody in the Concord had heard a word from them since.\n\nHe felt, mostly, the weight of the case in his hand, and in it the instrument he had been sent here to enforce.","wordCount":528,"createdAt":1793146023896,"updatedAt":1793146023896},{"id":"x1EWCQH8QOkSMQaQOyvx9","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"_Y2sOqdha0PcXlBvivyWT","text":"There were three of them in the end, because three was what the Director's office would admit. Dagny for the Wick crews. Mariam Oyelowo for the strip-farms, a broad, slow-spoken woman with soil in the creases of her knuckles that no scrubbing would shift. And Ezra Hesketh for the pumps and stills, who was seventy and had been a Speaker longer than Dagny had been alive, and who walked with a stick and had told her on the way up, in the lift, that he expected nothing and would be disappointed anyway.\n\nThe Counting House sat at the fore end of Lantern, at the root of the Wick, where the spin was least and the light was best. It had been built first, before the Galleries, before the farms; there was a story that the Company's surveyors had lived in it for two years while the rest of the rock was hollowed out round them. Its lower floors were the vault, where the Tally ran, and nobody Dagny knew had ever seen them. Its upper floors were offices. The top one was the Director's, and it had a window.\n\nDagny had seen the window from below all her life. It was a single long pane, curving, set into the face of the Counting House so that it looked straight down the length of Lantern, along the Wick, to the dark aft end of the rock eleven kilometres away. From the Galleries it looked like a strip of mirror. From inside it was the whole world, spread out and lit and upside down above you, every terrace and roof and tank and farm, and the Wick blazing down the middle of it like a sword.\n\nShe stood at it for a moment while they waited, because she couldn't help it. Gallery Six was a speck. She found it by the line of the water mains. Somewhere in that speck Pim was at school.\n\n\"It's a good view,\" said a voice behind her. \"I've never got used to it.\"\n\nIt was the Comptroller. Basu. A small, neat, brown man of fifty or so, in a Company suit that had been well cut once and was now a little big for him, as though he had lost weight in a hurry. He stood a careful distance from the glass.\n\n\"You don't like heights,\" Dagny said.\n\n\"No.\" He smiled, briefly. \"An unfortunate thing on Lantern. Everything is a height.\" He looked at her, and then away, and she had the odd impression that he wanted to say something else and had decided against it.\n\nThen the inner door opened and the Director came in, with Hale Varga behind her, and they all sat down.","wordCount":450,"createdAt":1793146166636,"updatedAt":1793146166636},{"id":"xrySoxJIxKbbPxC0x8-P2","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"a1u58gr6AFx6j7nnj_pXE","text":"On the top floor of the Counting House, behind the only clean window on Lantern, Teodor Basu, Comptroller of the Sabra Concern, watched the feed from the Gallery Six canteen camera with the sound off. He watched the woman on the table. He watched her hold up her wrist.\n\nHe ran her number. Ostrova, Dagny. Wick crews. Indentured nineteen years. Balance minus six hundred and eighty-one, including a tampering fee of two hundred posted last night at Lock Nine-Forty.\n\nHis hand, on the desk, was shaking. He put the other one over it until it stopped.\n\nThen he opened a file that was not on any list the Director had asked for, and looked for a long time at a number that was not a balance at all, and was nine hundred, and closed it again.","wordCount":136,"createdAt":1793145334007,"updatedAt":1793145334007}],"plotThreads":[],"motifs":[],"continuitySuppressions":[],"writingLogs":[{"id":"obGvoCuNg2SvFddh616qo","worldId":"p5RB-gewXUZYlHUKTH5pw","date":"2026-10-28","words":14691,"createdAt":1793145781888,"updatedAt":1793146319668},{"id":"wg0crDNUkJBKFqJx83ah3","worldId":"p5RB-gewXUZYlHUKTH5pw","date":"2026-10-27","words":3803,"createdAt":1793145333989,"updatedAt":1793145334688}],"sceneRevisions":[{"id":"5NuGPt1mApNNHutJ4ZF_M","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"e2oBYFVEZ5GlPkKSEnkkB","text":"The call came down the spine at the end of second shift, when Dagny Ostrova was forty metres up the Wick with her face in a collimator housing and her knees locked round a rung that had been warm for ninety years.\n\n\"Gallery Nine,\" said the speaker on her collar. It was Joss, below her on the crawl, and his voice had the flatness it got when something was already too late and he hadn't decided to know it yet. \"Lock Nine-Forty. Man in it. It's gone to recovery.\"\n\nShe was moving before he finished. You did not think about a lock in recovery. You thought about it afterwards, at the bell, with a drink in you.\n\nGoing down the Wick was going down only in the sense that the rock's spin pulled you, gently at first and then less gently, toward the curved floor of the world. At the axis there was no weight at all, only the lamp: three kilometres of magnetic bottle and shielding and slow white fire, with the crawls and catwalks wrapped round it like ivy round a pole. Its light fell on everything. It fell on the terraced Galleries that climbed the inner wall in every direction, on the water tanks and the strip-farms and the tin roofs, on the long seam of the Upper Wards where the Company people lived with real glass in their windows. On Lantern you could look up from anywhere and see someone's house above you, upside down, lit from the side by the same lamp that lit yours. Children were taught early not to drop things from high terraces. It was the first rule. The second was to watch your balance.\n\nDagny dropped through the spoke-shaft hand over hand, letting her weight build, and hit the Gallery Nine landing at a run with Joss three seconds behind her, wheezing. A crowd had already made a half-ring round Lock Nine-Forty. Nobody was touching it. On Lantern, nobody touched a lock in recovery, because the Tally logged who touched what.\n\nThe lock was a steel bottle three metres long, set between the Gallery Nine pressure zone and the Gallery Ten one, so that if either breached the other would hold. You walked into it, the door behind you sealed, the Tally read the chit on your wrist, and if you were in credit the door in front of you opened. If you were not, it didn't. And because the Company had built Lantern on the principle that air was the dearest thing in the Sabra system and must be recovered wherever it could be, a lock with an unauthorised occupant began, after ninety seconds, to draw its air back into the main for reclamation.\n\nLemuel Adeyemi was in the lock. Dagny knew him a little. Pump-fitter, Gallery Ten. Fifties. A cough. A wife who had died two winters back of the same cough, and whose name was on the bell. He was standing with both palms flat on the inner door's window, and his mouth was open, and his breath was making less fog on the glass than it should have.\n\n\"How long?\" Dagny said.\n\n\"Two minutes in recovery,\" somebody said. \"His shift got docked. Pump fault on Ten, they docked the whole crew a half-day. It posted on the hour. He was already in the lock when it posted.\"\n\nDagny looked at the panel by the door. The little screen showed his number and his balance, in the Company's blue, and the balance was in brackets, which was how the Tally wrote a debt it had stopped being patient with. Minus nine hundred and four. The dimming line on Lantern was minus nine hundred.\n\nFour. He was four over the line. Four was a meal. Four was an hour of water.\n\n\"Transfer,\" she said, and slapped her own chit onto the panel. \"I'll stand it. Transfer from Ostrova, nine-oh-six-two-two, to—\"\n\nThe panel chimed politely. TRANSFERS BETWEEN ACCOUNTS POST AT THE HOUR. PLEASE SEE A COUNTER.\n\n\"There's no counter on Nine at shift-end,\" Joss said behind her. \"There's no counter on Nine ever.\"\n\n\"Then get me the override.\"\n\n\"Dag. The override's in the Counting House.\"\n\nShe knew that. Everyone knew that. She said it anyway because it was the next thing to say, and because the alternative was to stand and watch, and the crowd was already standing and watching. Inside the lock Lemuel had seen her. He took one hand off the glass and made a small shape with it, a sort of apology, as if he were sorry to be making a scene.\n\n\"Torch,\" said Dagny.\n\n\"It's a pressure door. It'll take—\"\n\n\"Torch, Joss.\"\n\nHe had one on his belt, because Wick crews carried everything. She lit it and put the flame to the hinge side of the outer door and the steel went cherry-red and then white and began, very slowly, to run. The crowd made a noise behind her. The panel spoke again, in the same tone: TAMPERING WITH COMPANY PRESSURE EQUIPMENT IS CHARGED AT TWO HUNDRED CREDITS PER INCIDENT TO THE ACCOUNT OF THE TAMPERER. It read her chit through her glove. She watched her own balance drop by two hundred in the corner of the screen and kept cutting.\n\nIt took four minutes. A man can live for four minutes in a lock in recovery; Dagny had seen it. What a man cannot do is live for four minutes in a lock in recovery after he has already been in it for three. By the time the hinge gave and Joss got a pry-bar into the gap and the two of them hauled the door back on its seal, there was nothing in the lock but cold, thin air, rushing out past them into the gallery with a sound like a long breath let go, and Lemuel Adeyemi on his knees with his forehead against the inner door, as though he had decided at the end to pray to it.\n\nDagny went in and turned him over. His eyes were open. His lips were the colour of the shadow under a terrace. She put two fingers on his neck because she had been trained to and because people were watching, and then she took them away.\n\nBehind her the panel on the wall chimed a third time. Lemuel's number went grey, and under it, small and blue and patient, the Tally posted his last entry: ACCOUNT CLOSED BY DEATH. BALANCE TRANSFERRED TO ESTATE. And then, because Lemuel had no estate but a cough and a bunk and a wife's name on a bell, it posted the next one, which Dagny had seen a hundred times and which never stopped being the worst thing she had ever read: ESTATE INSOLVENT. BALANCE TRANSFERRED TO NEXT OF KIN.\n\n\"Who's his kin?\" she said.\n\nNobody answered. Then a girl at the front of the crowd, eight or nine, with a chit on a cord round her neck and her hair cut short against lice, said, \"Me.\"\n\n## Next of Kin\n[\nPlace: #The Galleries\nCharacters: @@Dagny Ostrova @@Joss Teague\nWhen: same day\n]\n\nJoss sat on the landing with the torch in his lap and wept the way big men did on Lantern, quietly and with his face turned to the wall. Dagny did not weep. She went to the girl, whose name was Abi and who was Lemuel's sister's child, and she knelt so that their faces were level, and she looked at the chit.\n\nMinus nine hundred and four, plus the girl's own, which was the ordinary minus three hundred that a Lantern child had by eight from being fed and housed and breathed. Minus twelve hundred and four. Three hundred over the line. The girl's door would be dimmed by morning. Her ration would stop at the next posting.\n\n\"You've got people on Ten?\"\n\n\"My aunt's at the farms. She's on nights.\"\n\n\"Go to her. Tell her the Wick crews will stand it. Tell her Dagny Ostrova said. Tomorrow I'll put it through a counter.\"\n\nThe girl looked at her with the flat, measuring look of every Lantern child who had already learned that adults said things. Then she went.\n\n\"You haven't got twelve hundred,\" said Joss, when she'd gone.\n\n\"The crews have.\"\n\n\"The crews have got a hole in the bottom of the bucket same as you, Dag.\"\n\n\"Then we'll stand it with the hole.\" She stood. Her knees hurt. Her balance, in the corner of her own eye, was smaller by two hundred for a door that had not saved anyone. \"Get him covered. I'll take his name to Odile.\"\n\n[\nPlace: #The Dock Ring\nCharacters: @@Dagny Ostrova @@Odile Marchbank @@Pim Ostrova @@Kas Ostrova\nItems: ^The Mercy Bell\nWhen: same day\n]\n\nThe bell of the _Ardent Mercy_ hung at the inner lock of the Dock Ring, on a hook of black iron that had been drilled into the rock the year Lantern was first pressurised. It was not large. It came up to Dagny's hip. It had been cast in the shipyards at Tannet Reach for a colony carrier that had crossed the Throat ninety-one years before, and the carrier had been cut up for her hull plate within a decade of arrival, as such ships always were; but the bell had been kept, because it was bad luck to melt a ship's bell, and because somebody on that first crossing had started the habit of ringing it for the dead.\n\nThere had been thirty-one dead on the crossing. Their names were cut round the lip in a neat, old-fashioned hand. After them came Lantern's dead, in a hand that changed every generation as the dockmasters did, round the lip and up the waist and onto the shoulder and in among the decoration on the crown, so that the bronze was now more letter than metal. From the length of the lock you could not see the names. You could only see that the bell was a strange colour, a dull brown furred all over with scratches, like an old animal.\n\nOdile Marchbank was waiting for her. She had heard; everyone on Lantern heard everything inside an hour, it was the one thing the rock did faster than the Tally. She was seventy-four and three-quarters deaf and she had kept the bell for thirty years, and her hands, which shook when she held a cup, went still as stone when they held the engraver.\n\n\"Adeyemi,\" Dagny said. \"Lemuel. Ten.\"\n\nOdile nodded. She didn't need the spelling; she had cut his wife. She took the bell-rope, which was a length of braided hauler cable, and she rang the bell once.\n\nIt was not a loud sound. Lantern swallowed noise; the rock was too big and too full of air and machinery. But the bell had a voice that went a long way anyway, low and a little sour, and all along the Dock Ring people stopped what they were doing at the sound of it. Hauler crews in the gantries. Customs men at their desks. The women who ran the noodle-stalls along the ring road. They stopped and stood, a breath's worth, and then went on.\n\nDagny felt a small hand slide into hers. She didn't look down.\n\n\"You're supposed to be at school,\" she said.\n\n\"School finished,\" said Pim. \"Everyone came out when they heard the lock. Mister Okonkwo said it was a teaching moment.\" He was twelve, and thin, and he collected bolts, and he had her husband's eyebrows, which she had never got used to. \"Was it Mister Adeyemi from Ten?\"\n\n\"Yes.\"\n\n\"Did you try?\"\n\n\"Yes.\"\n\nHe thought about that. \"How much was he over?\"\n\n\"Four.\"\n\nPim did not say anything else. He held her hand while Odile fitted the engraver's burr and bent to the bronze, and the thin whine of it went up into the ring, and the first letters of Lemuel's name came up bright on the shoulder of the bell, among nine decades of brown.\n\n\"I'm running out of bell,\" Odile said, without looking up. She said it every few months. It was a sort of joke. \"One day I'll have to start on the hook.\"","wordCount":2030,"createdAt":1793145334622},{"id":"93IylJn-MVYi5wYRqfsA7","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"e2oBYFVEZ5GlPkKSEnkkB","text":"The call came down the spine at the end of second shift, when Dagny Ostrova was forty metres up the Wick with her face in a collimator housing and her knees locked round a rung that had been warm for ninety years.\n\n\"Gallery Nine,\" said the speaker on her collar. It was Joss, below her on the crawl, and his voice had the flatness it got when something was already too late and he hadn't decided to know it yet. \"Lock Nine-Forty. Man in it. It's gone to recovery.\"\n\nShe was moving before he finished. You did not think about a lock in recovery. You thought about it afterwards, at the bell, with a drink in you.\n\nGoing down the Wick was going down only in the sense that the rock's spin pulled you, gently at first and then less gently, toward the curved floor of the world. At the axis there was no weight at all, only the lamp: three kilometres of magnetic bottle and shielding and slow white fire, with the crawls and catwalks wrapped round it like ivy round a pole. Its light fell on everything. It fell on the terraced Galleries that climbed the inner wall in every direction, on the water tanks and the strip-farms and the tin roofs, on the long seam of the Upper Wards where the Company people lived with real glass in their windows. On Lantern you could look up from anywhere and see someone's house above you, upside down, lit from the side by the same lamp that lit yours. Children were taught early not to drop things from high terraces. It was the first rule. The second was to watch your balance.\n\nDagny dropped through the spoke-shaft hand over hand, letting her weight build, and hit the Gallery Nine landing at a run with Joss three seconds behind her, wheezing. A crowd had already made a half-ring round Lock Nine-Forty. Nobody was touching it. On Lantern, nobody touched a lock in recovery, because the Tally logged who touched what.\n\nThe lock was a steel bottle three metres long, set between the Gallery Nine pressure zone and the Gallery Ten one, so that if either breached the other would hold. You walked into it, the door behind you sealed, the Tally read the chit on your wrist, and if you were in credit the door in front of you opened. If you were not, it didn't. And because the Company had built Lantern on the principle that air was the dearest thing in the Sabra system and must be recovered wherever it could be, a lock with an unauthorised occupant began, after ninety seconds, to draw its air back into the main for reclamation.\n\nLemuel Adeyemi was in the lock. Dagny knew him a little. Pump-fitter, Gallery Ten. Fifties. A cough. A wife who had died two winters back of the same cough, and whose name was on the bell. He was standing with both palms flat on the inner door's window, and his mouth was open, and his breath was making less fog on the glass than it should have.\n\n\"How long?\" Dagny said.\n\n\"Two minutes in recovery,\" somebody said. \"His shift got docked. Pump fault on Ten, they docked the whole crew a half-day. It posted on the hour. He was already in the lock when it posted.\"\n\nDagny looked at the panel by the door. The little screen showed his number and his balance, in the Company's blue, and the balance was in brackets, which was how the Tally wrote a debt it had stopped being patient with. Minus nine hundred and four. The dimming line on Lantern was minus nine hundred.\n\nFour. He was four over the line. Four was a meal. Four was an hour of water.\n\n\"Transfer,\" she said, and slapped her own chit onto the panel. \"I'll stand it. Transfer from Ostrova, nine-oh-six-two-two, to—\"\n\nThe panel chimed politely. TRANSFERS BETWEEN ACCOUNTS POST AT THE HOUR. PLEASE SEE A COUNTER.\n\n\"There's no counter on Nine at shift-end,\" Joss said behind her. \"There's no counter on Nine ever.\"\n\n\"Then get me the override.\"\n\n\"Dag. The override's in the Counting House.\"\n\nShe knew that. Everyone knew that. She said it anyway because it was the next thing to say, and because the alternative was to stand and watch, and the crowd was already standing and watching. Inside the lock Lemuel had seen her. He took one hand off the glass and made a small shape with it, a sort of apology, as if he were sorry to be making a scene.\n\n\"Torch,\" said Dagny.\n\n\"It's a pressure door. It'll take—\"\n\n\"Torch, Joss.\"\n\nHe had one on his belt, because Wick crews carried everything. She lit it and put the flame to the hinge side of the outer door and the steel went cherry-red and then white and began, very slowly, to run. The crowd made a noise behind her. The panel spoke again, in the same tone: TAMPERING WITH COMPANY PRESSURE EQUIPMENT IS CHARGED AT TWO HUNDRED CREDITS PER INCIDENT TO THE ACCOUNT OF THE TAMPERER. It read her chit through her glove. She watched her own balance drop by two hundred in the corner of the screen and kept cutting.\n\nIt took four minutes. A man can live for four minutes in a lock in recovery; Dagny had seen it. What a man cannot do is live for four minutes in a lock in recovery after he has already been in it for three. By the time the hinge gave and Joss got a pry-bar into the gap and the two of them hauled the door back on its seal, there was nothing in the lock but cold, thin air, rushing out past them into the gallery with a sound like a long breath let go, and Lemuel Adeyemi on his knees with his forehead against the inner door, as though he had decided at the end to pray to it.\n\nDagny went in and turned him over. His eyes were open. His lips were the colour of the shadow under a terrace. She put two fingers on his neck because she had been trained to and because people were watching, and then she took them away.\n\nBehind her the panel on the wall chimed a third time. Lemuel's number went grey, and under it, small and blue and patient, the Tally posted his last entry: ACCOUNT CLOSED BY DEATH. BALANCE TRANSFERRED TO ESTATE. And then, because Lemuel had no estate but a cough and a bunk and a wife's name on a bell, it posted the next one, which Dagny had seen a hundred times and which never stopped being the worst thing she had ever read: ESTATE INSOLVENT. BALANCE TRANSFERRED TO NEXT OF KIN.\n\n\"Who's his kin?\" she said.\n\nNobody answered. Then a girl at the front of the crowd, eight or nine, with a chit on a cord round her neck and her hair cut short against lice, said, \"Me.\"\n\n## Next of Kin\n[\nPlace: #The Galleries\nCharacters: @@Dagny Ostrova @@Joss Teague\nWhen: same day\n]\n\nJoss sat on the landing with the torch in his lap and wept the way big men did on Lantern, quietly and with his face turned to the wall. Dagny did not weep. She went to the girl, whose name was Abi and who was Lemuel's sister's child, and she knelt so that their faces were level, and she looked at the chit.\n\nMinus nine hundred and four, plus the girl's own, which was the ordinary minus three hundred that a Lantern child had by eight from being fed and housed and breathed. Minus twelve hundred and four. Three hundred over the line. The girl's door would be dimmed by morning. Her ration would stop at the next posting.\n\n\"You've got people on Ten?\"\n\n\"My aunt's at the farms. She's on nights.\"\n\n\"Go to her. Tell her the Wick crews will stand it. Tell her Dagny Ostrova said. Tomorrow I'll put it through a counter.\"\n\nThe girl looked at her with the flat, measuring look of every Lantern child who had already learned that adults said things. Then she went.\n\n\"You haven't got twelve hundred,\" said Joss, when she'd gone.\n\n\"The crews have.\"\n\n\"The crews have got a hole in the bottom of the bucket same as you, Dag.\"\n\n\"Then we'll stand it with the hole.\" She stood. Her knees hurt. Her balance, in the corner of her own eye, was smaller by two hundred for a door that had not saved anyone. \"Get him covered. I'll take his name to Odile.\"\n\n## The Bell\n[\nPlace: #The Dock Ring\nCharacters: @@Dagny Ostrova @@Odile Marchbank @@Pim Ostrova @@Kas Ostrova\nItems: ^The Mercy Bell\nWhen: same day\n]\n\nThe bell of the _Ardent Mercy_ hung at the inner lock of the Dock Ring, on a hook of black iron that had been drilled into the rock the year Lantern was first pressurised. It was not large. It came up to Dagny's hip. It had been cast in the shipyards at Tannet Reach for a colony carrier that had crossed the Throat ninety-one years before, and the carrier had been cut up for her hull plate within a decade of arrival, as such ships always were; but the bell had been kept, because it was bad luck to melt a ship's bell, and because somebody on that first crossing had started the habit of ringing it for the dead.\n\nThere had been thirty-one dead on the crossing. Their names were cut round the lip in a neat, old-fashioned hand. After them came Lantern's dead, in a hand that changed every generation as the dockmasters did, round the lip and up the waist and onto the shoulder and in among the decoration on the crown, so that the bronze was now more letter than metal. From the length of the lock you could not see the names. You could only see that the bell was a strange colour, a dull brown furred all over with scratches, like an old animal.\n\nOdile Marchbank was waiting for her. She had heard; everyone on Lantern heard everything inside an hour, it was the one thing the rock did faster than the Tally. She was seventy-four and three-quarters deaf and she had kept the bell for thirty years, and her hands, which shook when she held a cup, went still as stone when they held the engraver.\n\n\"Adeyemi,\" Dagny said. \"Lemuel. Ten.\"\n\nOdile nodded. She didn't need the spelling; she had cut his wife. She took the bell-rope, which was a length of braided hauler cable, and she rang the bell once.\n\nIt was not a loud sound. Lantern swallowed noise; the rock was too big and too full of air and machinery. But the bell had a voice that went a long way anyway, low and a little sour, and all along the Dock Ring people stopped what they were doing at the sound of it. Hauler crews in the gantries. Customs men at their desks. The women who ran the noodle-stalls along the ring road. They stopped and stood, a breath's worth, and then went on.\n\nDagny felt a small hand slide into hers. She didn't look down.\n\n\"You're supposed to be at school,\" she said.\n\n\"School finished,\" said Pim. \"Everyone came out when they heard the lock. Mister Okonkwo said it was a teaching moment.\" He was twelve, and thin, and he collected bolts, and he had her husband's eyebrows, which she had never got used to. \"Was it Mister Adeyemi from Ten?\"\n\n\"Yes.\"\n\n\"Did you try?\"\n\n\"Yes.\"\n\nHe thought about that. \"How much was he over?\"\n\n\"Four.\"\n\nPim did not say anything else. He held her hand while Odile fitted the engraver's burr and bent to the bronze, and the thin whine of it went up into the ring, and the first letters of Lemuel's name came up bright on the shoulder of the bell, among nine decades of brown.\n\n\"I'm running out of bell,\" Odile said, without looking up. She said it every few months. It was a sort of joke. \"One day I'll have to start on the hook.\"\n\n## The Magpie Comes In\n[\nPlace: #The Dock Ring\nCharacters: @@Dagny Ostrova @@Pim Ostrova @@Kas Ostrova\nWhen: same day\n]\n\nThe _Magpie_ came in an hour later with eighty tonnes of Caul ice in her tank-frame and a crack in her forward window that had been there so long it had a name. Her pilot came through the inner lock with his helmet under his arm and the whole of the Dock Ring's gossip already on his face.\n\n\"Who?\"\n\n\"Adeyemi. Gallery Ten.\"\n\n\"Lock?\"\n\n\"Lock.\"\n\nKasimir Ostrova closed his eyes for a moment. He was nine years younger than his sister and twice as handsome and he owed money, at a conservative estimate, to a third of the Dock Ring, none of which ever seemed to cost him a night's sleep. But he had grown up in Gallery Six the same as her, and he had seen the same locks.\n\n\"Uncle Kas,\" said Pim, and was swept up and hung upside down by the ankles, which at twelve he was too old for and permitted anyway.\n\n\"How's the run?\" Dagny said.\n\n\"Cold. Long. The usual.\" Kas set Pim the right way up. \"Quiet out there, though. Quieter than it was.\"\n\n\"Quiet how?\"\n\n\"Caul Deep's still shut. You know they closed the Deep in the spring — the big shaft, the one that took nine hundred on a shift. Nobody's working it. Beacon's dark, gantries are up. Funny to fly past. Used to be you'd see the lights of it from a thousand klicks out like a city.\" He shrugged. \"They said the vein ran out. Sent all the Deep crews home through the Throat. Contracts bought out, every one. Lucky bastards.\"\n\n\"I never heard of the Company buying out a contract in my life,\" said Dagny.\n\n\"Well. You never heard of a vein running out, neither. It's a season of firsts.\" Kas grinned at Pim. \"Come on. I'll buy you a noodle. I've been paid.\"\n\n\"You've been paid and you owe Marguerite at the noodle stall forty.\"\n\n\"Then I'll buy him a noodle and her a smile, and we'll all be square.\" He put an arm round his sister's shoulders and squeezed, briefly, hard. \"Sorry about Lemuel, Dag.\"\n\n\"Yes,\" she said. \"Me too.\"\n\nBehind them, Odile's engraver whined on in the bronze.\n\n## Fifty-Two Days\n[\nPlace: #The Galleries\nCharacters: @@Dagny Ostrova @@Pim Ostrova @@Joss Teague @@Ruth Achterberg:phone\nItems: ^The Tally\nWhen: +1 day\n]\n\nThe announcement came at eleven the next morning, on every screen on Lantern at once.\n\nDagny was in the canteen on Gallery Six with Joss and two of the Wick crew, trying to work out how many hours the Speakers could find between them to stand the Adeyemi girl's debt, and getting a number that was not enough. The screen on the canteen wall was usually showing either the Company's safety notices or a football match from somewhere in the Concord that had been played eleven years before and brought through the Throat on a data-run. It went dark in the middle of a goal, and then it showed the Company's mark, the two letters H and A leaning on each other like tired men, and then it showed Ruth Achterberg.\n\nThe canteen went quiet in the way Lantern went quiet for the bell.\n\nThe Director was sitting at a desk with nothing on it. She was a lean, grey woman of sixty in a dark Company suit, and she wore at her throat, on a fine chain, the brass disk of the Director's seal, which every child on Lantern had been told was the key to everything. She did not look cruel. She looked like someone who had been awake all night doing arithmetic and had come out of it with an answer she disliked but would not apologise for.\n\n\"People of the Sabra Concern,\" she said. \"I am speaking to you today with news that affects every one of us.\n\n\"As you know, the Throat which connects this system to the Concord is not a fixed thing. It breathes. Its throat-watch station has measured that breathing for the whole of this colony's history. Three weeks ago the station recorded the beginning of what our physicists call a closing phase. Throats which enter a closing phase do not reopen on any timescale that is useful to us. The best estimate, from the Concord's own literature, is somewhere between six and eight hundred years.\n\n\"The Throat will remain passable for fifty-two days. After that, this system will be cut off.\"\n\nSomebody in the canteen laughed, the high bark of a person who has been hit. Nobody else made a sound.\n\n\"The Halden-Ash Company has a duty to its shareholders and to its staff,\" said the Director. \"It cannot maintain a concern which it cannot reach. It will therefore withdraw from the Sabra system before the Throat closes. The carrier _Covenant_, now at our fore dock, will carry essential staff and their families and such Company assets as can be moved. I have asked the department heads to prepare those lists.\n\n\"I want to speak directly to the indentured population of Lantern.\" She looked into the lens. Dagny would remember that afterwards: that she did not look away. \"Your contracts are held by the Company. The Company does not abandon what it holds. Your contracts will remain in force, in trust, for the full term of the closure, and will be honoured when the Throat reopens. Lantern's systems — its air, its water, its heat, its light — will continue to be administered by the Tally, which has kept you safe for ninety years and which will keep you safe after we are gone. The Tally does not need us. It needs only that you go on working, as you always have, and it will go on keeping you alive.\n\n\"I know that this is hard news. I wish that I had better. Thank you.\"\n\nThe screen went back to the Company's mark. Then, after a moment, to the football match, which had been paused at the instant before the goal and now went on as if nothing had happened, the ball crossing the line, the crowd eleven years ago and four hundred light-years away going wild.\n\n## Standing on a Table\n[\nPlace: #The Galleries\nCharacters: @@Dagny Ostrova @@Pim Ostrova @@Joss Teague\nWhen: same day\n]\n\nWhat happened in the canteen in the next ten minutes Dagny remembered afterwards only in pieces. A man on Gallery Six put his chair through the screen and the screen went on showing football in a web of cracks. Two women began to fight over nothing, over a bench, and had to be pulled apart. Old Mister Okonkwo the schoolteacher sat with his hands flat on the table, saying, \"Six hundred years, six hundred years,\" as if it were a sum that would come out differently if he said it often enough. Somebody shouted that the Company would take the fuel. Somebody shouted that the Company would take the water. Somebody shouted that they should go up to the Upper Wards now, all of them, and see how many lists the department heads had made when they had their own windows broken.\n\nAnd Pim was beside her, she didn't know when he had come in, saying, \"Mum. Mum. In trust. What's in trust mean?\"\n\nShe understood it, she realised, before she understood anything else. It was Lantern; you learned the Company's language before you learned your prayers. _Held in trust_ meant that the Company was leaving, and the debt was staying. It meant that every chit on every wrist on Lantern would go on counting down, hour by hour, against the air, for six hundred years, and that if the Throat ever opened again somebody in a Company suit would come through it with the books in their hand to see how much was owed. It meant that the Adeyemi girl's twelve hundred would be eighteen hundred by the time she was grown and nine thousand by the time she died, and would go to whoever came after her.\n\nIt meant that the lock on Gallery Nine would go on doing what it had done to Lemuel, with nobody even in the Counting House to blame for it.\n\nShe found she was standing on a table. She did not remember getting up there. The canteen was looking at her, the way the Wick crews looked at her when the lamp went wrong and someone had to say a number out loud.\n\n\"All right,\" Dagny said. Her voice came out level, which surprised her. \"All right. Shut up and listen. I'm a Speaker for the Wick crews, and from tonight the Wick crews are going to want to talk to the other crews. Pumps, farms, docks, stills. Everyone who wears a chit. Fifty-two days is a long time. It's long enough for the Company to pack. It's long enough for us to make it listen first.\"\n\n\"Listen to what?\" somebody shouted.\n\n\"To the one thing it hasn't said.\" She held up her wrist, with the chit on it, so that the canteen could see the blue numbers. \"She said the Tally keeps us alive. It doesn't. We keep it alive. We fed it ninety years. If the Company's going, the Company can take its ledger with it, or it can switch the bloody thing off before it goes. Either way, nobody on this rock is going to owe air to an empty office for six hundred years.\"\n\nThere was a silence. Then the man who had broken the screen began to clap, slowly, and others took it up; and Joss, below her, looked up with his wet red face and said, very quietly, so that only she could hear: \"Dag. You know what you just did.\"\n\nShe did. She had just volunteered.\n\n[\nPlace: #The Counting House\nCharacters: @@Teodor Basu\nWhen: same day\n]\n\nOn the top floor of the Counting House, behind the only clean window on Lantern, Teodor Basu, Comptroller of the Sabra Concern, watched the feed from the Gallery Six canteen camera with the sound off. He watched the woman on the table. He watched her hold up her wrist.\n\nHe ran her number. Ostrova, Dagny. Wick crews. Indentured nineteen years. Balance minus six hundred and eighty-one, including a tampering fee of two hundred posted last night at Lock Nine-Forty.\n\nHis hand, on the desk, was shaking. He put the other one over it until it stopped.\n\nThen he opened a file that was not on any list the Director had asked for, and looked for a long time at a number that was not a balance at all, and was nine hundred, and closed it again.","wordCount":3823,"createdAt":1793145334003},{"id":"MaMC8fahlujHTcQXtDprm","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"e2oBYFVEZ5GlPkKSEnkkB","text":"The call came down the spine at the end of second shift, when Dagny Ostrova was forty metres up the Wick with her face in a collimator housing and her knees locked round a rung that had been warm for ninety years.\n\n\"Gallery Nine,\" said the speaker on her collar. It was Joss, below her on the crawl, and his voice had the flatness it got when something was already too late and he hadn't decided to know it yet. \"Lock Nine-Forty. Man in it. It's gone to recovery.\"\n\nShe was moving before he finished. You did not think about a lock in recovery. You thought about it afterwards, at the bell, with a drink in you.\n\nGoing down the Wick was going down only in the sense that the rock's spin pulled you, gently at first and then less gently, toward the curved floor of the world. At the axis there was no weight at all, only the lamp: three kilometres of magnetic bottle and shielding and slow white fire, with the crawls and catwalks wrapped round it like ivy round a pole. Its light fell on everything. It fell on the terraced Galleries that climbed the inner wall in every direction, on the water tanks and the strip-farms and the tin roofs, on the long seam of the Upper Wards where the Company people lived with real glass in their windows. On Lantern you could look up from anywhere and see someone's house above you, upside down, lit from the side by the same lamp that lit yours. Children were taught early not to drop things from high terraces. It was the first rule. The second was to watch your balance.\n\nDagny dropped through the spoke-shaft hand over hand, letting her weight build, and hit the Gallery Nine landing at a run with Joss three seconds behind her, wheezing. A crowd had already made a half-ring round Lock Nine-Forty. Nobody was touching it. On Lantern, nobody touched a lock in recovery, because the Tally logged who touched what.\n\nThe lock was a steel bottle three metres long, set between the Gallery Nine pressure zone and the Gallery Ten one, so that if either breached the other would hold. You walked into it, the door behind you sealed, the Tally read the chit on your wrist, and if you were in credit the door in front of you opened. If you were not, it didn't. And because the Company had built Lantern on the principle that air was the dearest thing in the Sabra system and must be recovered wherever it could be, a lock with an unauthorised occupant began, after ninety seconds, to draw its air back into the main for reclamation.\n\nLemuel Adeyemi was in the lock. Dagny knew him a little. Pump-fitter, Gallery Ten. Fifties. A cough. A wife who had died two winters back of the same cough, and whose name was on the bell. He was standing with both palms flat on the inner door's window, and his mouth was open, and his breath was making less fog on the glass than it should have.\n\n\"How long?\" Dagny said.\n\n\"Two minutes in recovery,\" somebody said. \"His shift got docked. Pump fault on Ten, they docked the whole crew a half-day. It posted on the hour. He was already in the lock when it posted.\"\n\nDagny looked at the panel by the door. The little screen showed his number and his balance, in the Company's blue, and the balance was in brackets, which was how the Tally wrote a debt it had stopped being patient with. Minus nine hundred and four. The dimming line on Lantern was minus nine hundred.\n\nFour. He was four over the line. Four was a meal. Four was an hour of water.\n\n\"Transfer,\" she said, and slapped her own chit onto the panel. \"I'll stand it. Transfer from Ostrova, nine-oh-six-two-two, to—\"\n\nThe panel chimed politely. TRANSFERS BETWEEN ACCOUNTS POST AT THE HOUR. PLEASE SEE A COUNTER.\n\n\"There's no counter on Nine at shift-end,\" Joss said behind her. \"There's no counter on Nine ever.\"\n\n\"Then get me the override.\"\n\n\"Dag. The override's in the Counting House.\"\n\nShe knew that. Everyone knew that. She said it anyway because it was the next thing to say, and because the alternative was to stand and watch, and the crowd was already standing and watching. Inside the lock Lemuel had seen her. He took one hand off the glass and made a small shape with it, a sort of apology, as if he were sorry to be making a scene.\n\n\"Torch,\" said Dagny.\n\n\"It's a pressure door. It'll take—\"\n\n\"Torch, Joss.\"\n\nHe had one on his belt, because Wick crews carried everything. She lit it and put the flame to the hinge side of the outer door and the steel went cherry-red and then white and began, very slowly, to run. The crowd made a noise behind her. The panel spoke again, in the same tone: TAMPERING WITH COMPANY PRESSURE EQUIPMENT IS CHARGED AT TWO HUNDRED CREDITS PER INCIDENT TO THE ACCOUNT OF THE TAMPERER. It read her chit through her glove. She watched her own balance drop by two hundred in the corner of the screen and kept cutting.\n\nIt took four minutes. A man can live for four minutes in a lock in recovery; Dagny had seen it. What a man cannot do is live for four minutes in a lock in recovery after he has already been in it for three. By the time the hinge gave and Joss got a pry-bar into the gap and the two of them hauled the door back on its seal, there was nothing in the lock but cold, thin air, rushing out past them into the gallery with a sound like a long breath let go, and Lemuel Adeyemi on his knees with his forehead against the inner door, as though he had decided at the end to pray to it.\n\nDagny went in and turned him over. His eyes were open. His lips were the colour of the shadow under a terrace. She put two fingers on his neck because she had been trained to and because people were watching, and then she took them away.\n\nBehind her the panel on the wall chimed a third time. Lemuel's number went grey, and under it, small and blue and patient, the Tally posted his last entry: ACCOUNT CLOSED BY DEATH. BALANCE TRANSFERRED TO ESTATE. And then, because Lemuel had no estate but a cough and a bunk and a wife's name on a bell, it posted the next one, which Dagny had seen a hundred times and which never stopped being the worst thing she had ever read: ESTATE INSOLVENT. BALANCE TRANSFERRED TO NEXT OF KIN.\n\n\"Who's his kin?\" she said.\n\nNobody answered. Then a girl at the front of the crowd, eight or nine, with a chit on a cord round her neck and her hair cut short against lice, said, \"Me.\"\n\n## Next of Kin\n[\nPlace: #The Galleries\nCharacters: @@Dagny Ostrova @@Joss Teague\nWhen: same day\n]\n\nJoss sat on the landing with the torch in his lap and wept the way big men did on Lantern, quietly and with his face turned to the wall. Dagny did not weep. She went to the girl, whose name was Abi and who was Lemuel's sister's child, and she knelt so that their faces were level, and she looked at the chit.\n\nMinus nine hundred and four, plus the girl's own, which was the ordinary minus three hundred that a Lantern child had by eight from being fed and housed and breathed. Minus twelve hundred and four. Three hundred over the line. The girl's door would be dimmed by morning. Her ration would stop at the next posting.\n\n\"You've got people on Ten?\"\n\n\"My aunt's at the farms. She's on nights.\"\n\n\"Go to her. Tell her the Wick crews will stand it. Tell her Dagny Ostrova said. Tomorrow I'll put it through a counter.\"\n\nThe girl looked at her with the flat, measuring look of every Lantern child who had already learned that adults said things. Then she went.\n\n\"You haven't got twelve hundred,\" said Joss, when she'd gone.\n\n\"The crews have.\"\n\n\"The crews have got a hole in the bottom of the bucket same as you, Dag.\"\n\n\"Then we'll stand it with the hole.\" She stood. Her knees hurt. Her balance, in the corner of her own eye, was smaller by two hundred for a door that had not saved anyone. \"Get him covered. I'll take his name to Odile.\"\n\n## The Bell\n[\nPlace: #The Dock Ring\nCharacters: @@Dagny Ostrova @@Odile Marchbank @@Pim Ostrova @@Kas Ostrova\nItems: ^The Mercy Bell\nWhen: same day\n]\n\nThe bell of the _Ardent Mercy_ hung at the inner lock of the Dock Ring, on a hook of black iron that had been drilled into the rock the year Lantern was first pressurised. It was not large. It came up to Dagny's hip. It had been cast in the shipyards at Tannet Reach for a colony carrier that had crossed the Throat ninety-one years before, and the carrier had been cut up for her hull plate within a decade of arrival, as such ships always were; but the bell had been kept, because it was bad luck to melt a ship's bell, and because somebody on that first crossing had started the habit of ringing it for the dead.\n\nThere had been thirty-one dead on the crossing. Their names were cut round the lip in a neat, old-fashioned hand. After them came Lantern's dead, in a hand that changed every generation as the dockmasters did, round the lip and up the waist and onto the shoulder and in among the decoration on the crown, so that the bronze was now more letter than metal. From the length of the lock you could not see the names. You could only see that the bell was a strange colour, a dull brown furred all over with scratches, like an old animal.\n\nOdile Marchbank was waiting for her. She had heard; everyone on Lantern heard everything inside an hour, it was the one thing the rock did faster than the Tally. She was seventy-four and three-quarters deaf and she had kept the bell for thirty years, and her hands, which shook when she held a cup, went still as stone when they held the engraver.\n\n\"Adeyemi,\" Dagny said. \"Lemuel. Ten.\"\n\nOdile nodded. She didn't need the spelling; she had cut his wife. She took the bell-rope, which was a length of braided hauler cable, and she rang the bell once.\n\nIt was not a loud sound. Lantern swallowed noise; the rock was too big and too full of air and machinery. But the bell had a voice that went a long way anyway, low and a little sour, and all along the Dock Ring people stopped what they were doing at the sound of it. Hauler crews in the gantries. Customs men at their desks. The women who ran the noodle-stalls along the ring road. They stopped and stood, a breath's worth, and then went on.\n\nDagny felt a small hand slide into hers. She didn't look down.\n\n\"You're supposed to be at school,\" she said.\n\n\"School finished,\" said Pim. \"Everyone came out when they heard the lock. Mister Okonkwo said it was a teaching moment.\" He was twelve, and thin, and he collected bolts, and he had her husband's eyebrows, which she had never got used to. \"Was it Mister Adeyemi from Ten?\"\n\n\"Yes.\"\n\n\"Did you try?\"\n\n\"Yes.\"\n\nHe thought about that. \"How much was he over?\"\n\n\"Four.\"\n\nPim did not say anything else. He held her hand while Odile fitted the engraver's burr and bent to the bronze, and the thin whine of it went up into the ring, and the first letters of Lemuel's name came up bright on the shoulder of the bell, among nine decades of brown.\n\n\"I'm running out of bell,\" Odile said, without looking up. She said it every few months. It was a sort of joke. \"One day I'll have to start on the hook.\"\n\n## The Magpie Comes In\n[\nPlace: #The Dock Ring\nCharacters: @@Dagny Ostrova @@Pim Ostrova @@Kas Ostrova\nWhen: same day\n]\n\nThe _Magpie_ came in an hour later with eighty tonnes of Caul ice in her tank-frame and a crack in her forward window that had been there so long it had a name. Her pilot came through the inner lock with his helmet under his arm and the whole of the Dock Ring's gossip already on his face.\n\n\"Who?\"\n\n\"Adeyemi. Gallery Ten.\"\n\n\"Lock?\"\n\n\"Lock.\"\n\nKasimir Ostrova closed his eyes for a moment. He was nine years younger than his sister and twice as handsome and he owed money, at a conservative estimate, to a third of the Dock Ring, none of which ever seemed to cost him a night's sleep. But he had grown up in Gallery Six the same as her, and he had seen the same locks.\n\n\"Uncle Kas,\" said Pim, and was swept up and hung upside down by the ankles, which at twelve he was too old for and permitted anyway.\n\n\"How's the run?\" Dagny said.\n\n\"Cold. Long. The usual.\" Kas set Pim the right way up. \"Quiet out there, though. Quieter than it was.\"\n\n\"Quiet how?\"\n\n\"Caul Deep's still shut. You know they closed the Deep in the spring — the big shaft, the one that took nine hundred on a shift. Nobody's working it. Beacon's dark, gantries are up. Funny to fly past. Used to be you'd see the lights of it from a thousand klicks out like a city.\" He shrugged. \"They said the vein ran out. Sent all the Deep crews home through the Throat. Contracts bought out, every one. Lucky bastards.\"\n\n\"I never heard of the Company buying out a contract in my life,\" said Dagny.\n\n\"Well. You never heard of a vein running out, neither. It's a season of firsts.\" Kas grinned at Pim. \"Come on. I'll buy you a noodle. I've been paid.\"\n\n\"You've been paid and you owe Marguerite at the noodle stall forty.\"\n\n\"Then I'll buy him a noodle and her a smile, and we'll all be square.\" He put an arm round his sister's shoulders and squeezed, briefly, hard. \"Sorry about Lemuel, Dag.\"\n\n\"Yes,\" she said. \"Me too.\"\n\nBehind them, Odile's engraver whined on in the bronze.\n\n[\nPlace: #The Galleries\nCharacters: @@Dagny Ostrova @@Pim Ostrova @@Joss Teague @@Ruth Achterberg:phone\nItems: ^The Tally\nWhen: +1 day\n]\n\nThe announcement came at eleven the next morning, on every screen on Lantern at once.\n\nDagny was in the canteen on Gallery Six with Joss and two of the Wick crew, trying to work out how many hours the Speakers could find between them to stand the Adeyemi girl's debt, and getting a number that was not enough. The screen on the canteen wall was usually showing either the Company's safety notices or a football match from somewhere in the Concord that had been played eleven years before and brought through the Throat on a data-run. It went dark in the middle of a goal, and then it showed the Company's mark, the two letters H and A leaning on each other like tired men, and then it showed Ruth Achterberg.\n\nThe canteen went quiet in the way Lantern went quiet for the bell.\n\nThe Director was sitting at a desk with nothing on it. She was a lean, grey woman of sixty in a dark Company suit, and she wore at her throat, on a fine chain, the brass disk of the Director's seal, which every child on Lantern had been told was the key to everything. She did not look cruel. She looked like someone who had been awake all night doing arithmetic and had come out of it with an answer she disliked but would not apologise for.\n\n\"People of the Sabra Concern,\" she said. \"I am speaking to you today with news that affects every one of us.\n\n\"As you know, the Throat which connects this system to the Concord is not a fixed thing. It breathes. Its throat-watch station has measured that breathing for the whole of this colony's history. Three weeks ago the station recorded the beginning of what our physicists call a closing phase. Throats which enter a closing phase do not reopen on any timescale that is useful to us. The best estimate, from the Concord's own literature, is somewhere between six and eight hundred years.\n\n\"The Throat will remain passable for fifty-two days. After that, this system will be cut off.\"\n\nSomebody in the canteen laughed, the high bark of a person who has been hit. Nobody else made a sound.\n\n\"The Halden-Ash Company has a duty to its shareholders and to its staff,\" said the Director. \"It cannot maintain a concern which it cannot reach. It will therefore withdraw from the Sabra system before the Throat closes. The carrier _Covenant_, now at our fore dock, will carry essential staff and their families and such Company assets as can be moved. I have asked the department heads to prepare those lists.\n\n\"I want to speak directly to the indentured population of Lantern.\" She looked into the lens. Dagny would remember that afterwards: that she did not look away. \"Your contracts are held by the Company. The Company does not abandon what it holds. Your contracts will remain in force, in trust, for the full term of the closure, and will be honoured when the Throat reopens. Lantern's systems — its air, its water, its heat, its light — will continue to be administered by the Tally, which has kept you safe for ninety years and which will keep you safe after we are gone. The Tally does not need us. It needs only that you go on working, as you always have, and it will go on keeping you alive.\n\n\"I know that this is hard news. I wish that I had better. Thank you.\"\n\nThe screen went back to the Company's mark. Then, after a moment, to the football match, which had been paused at the instant before the goal and now went on as if nothing had happened, the ball crossing the line, the crowd eleven years ago and four hundred light-years away going wild.","wordCount":3071,"createdAt":1793145334401},{"id":"RGiIevFhwkzS3Q5gZj6md","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"e2oBYFVEZ5GlPkKSEnkkB","text":"The call came down the spine at the end of second shift, when Dagny Ostrova was forty metres up the Wick with her face in a collimator housing and her knees locked round a rung that had been warm for ninety years.\n\n\"Gallery Nine,\" said the speaker on her collar. It was Joss, below her on the crawl, and his voice had the flatness it got when something was already too late and he hadn't decided to know it yet. \"Lock Nine-Forty. Man in it. It's gone to recovery.\"\n\nShe was moving before he finished. You did not think about a lock in recovery. You thought about it afterwards, at the bell, with a drink in you.\n\nGoing down the Wick was going down only in the sense that the rock's spin pulled you, gently at first and then less gently, toward the curved floor of the world. At the axis there was no weight at all, only the lamp: three kilometres of magnetic bottle and shielding and slow white fire, with the crawls and catwalks wrapped round it like ivy round a pole. Its light fell on everything. It fell on the terraced Galleries that climbed the inner wall in every direction, on the water tanks and the strip-farms and the tin roofs, on the long seam of the Upper Wards where the Company people lived with real glass in their windows. On Lantern you could look up from anywhere and see someone's house above you, upside down, lit from the side by the same lamp that lit yours. Children were taught early not to drop things from high terraces. It was the first rule. The second was to watch your balance.\n\nDagny dropped through the spoke-shaft hand over hand, letting her weight build, and hit the Gallery Nine landing at a run with Joss three seconds behind her, wheezing. A crowd had already made a half-ring round Lock Nine-Forty. Nobody was touching it. On Lantern, nobody touched a lock in recovery, because the Tally logged who touched what.\n\nThe lock was a steel bottle three metres long, set between the Gallery Nine pressure zone and the Gallery Ten one, so that if either breached the other would hold. You walked into it, the door behind you sealed, the Tally read the chit on your wrist, and if you were in credit the door in front of you opened. If you were not, it didn't. And because the Company had built Lantern on the principle that air was the dearest thing in the Sabra system and must be recovered wherever it could be, a lock with an unauthorised occupant began, after ninety seconds, to draw its air back into the main for reclamation.\n\nLemuel Adeyemi was in the lock. Dagny knew him a little. Pump-fitter, Gallery Ten. Fifties. A cough. A wife who had died two winters back of the same cough, and whose name was on the bell. He was standing with both palms flat on the inner door's window, and his mouth was open, and his breath was making less fog on the glass than it should have.\n\n\"How long?\" Dagny said.\n\n\"Two minutes in recovery,\" somebody said. \"His shift got docked. Pump fault on Ten, they docked the whole crew a half-day. It posted on the hour. He was already in the lock when it posted.\"\n\nDagny looked at the panel by the door. The little screen showed his number and his balance, in the Company's blue, and the balance was in brackets, which was how the Tally wrote a debt it had stopped being patient with. Minus nine hundred and four. The dimming line on Lantern was minus nine hundred.\n\nFour. He was four over the line. Four was a meal. Four was an hour of water.\n\n\"Transfer,\" she said, and slapped her own chit onto the panel. \"I'll stand it. Transfer from Ostrova, nine-oh-six-two-two, to—\"\n\nThe panel chimed politely. TRANSFERS BETWEEN ACCOUNTS POST AT THE HOUR. PLEASE SEE A COUNTER.\n\n\"There's no counter on Nine at shift-end,\" Joss said behind her. \"There's no counter on Nine ever.\"\n\n\"Then get me the override.\"\n\n\"Dag. The override's in the Counting House.\"\n\nShe knew that. Everyone knew that. She said it anyway because it was the next thing to say, and because the alternative was to stand and watch, and the crowd was already standing and watching. Inside the lock Lemuel had seen her. He took one hand off the glass and made a small shape with it, a sort of apology, as if he were sorry to be making a scene.\n\n\"Torch,\" said Dagny.\n\n\"It's a pressure door. It'll take—\"\n\n\"Torch, Joss.\"\n\nHe had one on his belt, because Wick crews carried everything. She lit it and put the flame to the hinge side of the outer door and the steel went cherry-red and then white and began, very slowly, to run. The crowd made a noise behind her. The panel spoke again, in the same tone: TAMPERING WITH COMPANY PRESSURE EQUIPMENT IS CHARGED AT TWO HUNDRED CREDITS PER INCIDENT TO THE ACCOUNT OF THE TAMPERER. It read her chit through her glove. She watched her own balance drop by two hundred in the corner of the screen and kept cutting.\n\nIt took four minutes. A man can live for four minutes in a lock in recovery; Dagny had seen it. What a man cannot do is live for four minutes in a lock in recovery after he has already been in it for three. By the time the hinge gave and Joss got a pry-bar into the gap and the two of them hauled the door back on its seal, there was nothing in the lock but cold, thin air, rushing out past them into the gallery with a sound like a long breath let go, and Lemuel Adeyemi on his knees with his forehead against the inner door, as though he had decided at the end to pray to it.\n\nDagny went in and turned him over. His eyes were open. His lips were the colour of the shadow under a terrace. She put two fingers on his neck because she had been trained to and because people were watching, and then she took them away.\n\nBehind her the panel on the wall chimed a third time. Lemuel's number went grey, and under it, small and blue and patient, the Tally posted his last entry: ACCOUNT CLOSED BY DEATH. BALANCE TRANSFERRED TO ESTATE. And then, because Lemuel had no estate but a cough and a bunk and a wife's name on a bell, it posted the next one, which Dagny had seen a hundred times and which never stopped being the worst thing she had ever read: ESTATE INSOLVENT. BALANCE TRANSFERRED TO NEXT OF KIN.\n\n\"Who's his kin?\" she said.\n\nNobody answered. Then a girl at the front of the crowd, eight or nine, with a chit on a cord round her neck and her hair cut short against lice, said, \"Me.\"\n\n## Next of Kin\n[\nPlace: #The Galleries\nCharacters: @@Dagny Ostrova @@Joss Teague\nWhen: same day\n]\n\nJoss sat on the landing with the torch in his lap and wept the way big men did on Lantern, quietly and with his face turned to the wall. Dagny did not weep. She went to the girl, whose name was Abi and who was Lemuel's sister's child, and she knelt so that their faces were level, and she looked at the chit.\n\nMinus nine hundred and four, plus the girl's own, which was the ordinary minus three hundred that a Lantern child had by eight from being fed and housed and breathed. Minus twelve hundred and four. Three hundred over the line. The girl's door would be dimmed by morning. Her ration would stop at the next posting.\n\n\"You've got people on Ten?\"\n\n\"My aunt's at the farms. She's on nights.\"\n\n\"Go to her. Tell her the Wick crews will stand it. Tell her Dagny Ostrova said. Tomorrow I'll put it through a counter.\"\n\nThe girl looked at her with the flat, measuring look of every Lantern child who had already learned that adults said things. Then she went.\n\n\"You haven't got twelve hundred,\" said Joss, when she'd gone.\n\n\"The crews have.\"\n\n\"The crews have got a hole in the bottom of the bucket same as you, Dag.\"\n\n\"Then we'll stand it with the hole.\" She stood. Her knees hurt. Her balance, in the corner of her own eye, was smaller by two hundred for a door that had not saved anyone. \"Get him covered. I'll take his name to Odile.\"\n\n## The Bell\n[\nPlace: #The Dock Ring\nCharacters: @@Dagny Ostrova @@Odile Marchbank @@Pim Ostrova @@Kas Ostrova\nItems: ^The Mercy Bell\nWhen: same day\n]\n\nThe bell of the _Ardent Mercy_ hung at the inner lock of the Dock Ring, on a hook of black iron that had been drilled into the rock the year Lantern was first pressurised. It was not large. It came up to Dagny's hip. It had been cast in the shipyards at Tannet Reach for a colony carrier that had crossed the Throat ninety-one years before, and the carrier had been cut up for her hull plate within a decade of arrival, as such ships always were; but the bell had been kept, because it was bad luck to melt a ship's bell, and because somebody on that first crossing had started the habit of ringing it for the dead.\n\nThere had been thirty-one dead on the crossing. Their names were cut round the lip in a neat, old-fashioned hand. After them came Lantern's dead, in a hand that changed every generation as the dockmasters did, round the lip and up the waist and onto the shoulder and in among the decoration on the crown, so that the bronze was now more letter than metal. From the length of the lock you could not see the names. You could only see that the bell was a strange colour, a dull brown furred all over with scratches, like an old animal.\n\nOdile Marchbank was waiting for her. She had heard; everyone on Lantern heard everything inside an hour, it was the one thing the rock did faster than the Tally. She was seventy-four and three-quarters deaf and she had kept the bell for thirty years, and her hands, which shook when she held a cup, went still as stone when they held the engraver.\n\n\"Adeyemi,\" Dagny said. \"Lemuel. Ten.\"\n\nOdile nodded. She didn't need the spelling; she had cut his wife. She took the bell-rope, which was a length of braided hauler cable, and she rang the bell once.\n\nIt was not a loud sound. Lantern swallowed noise; the rock was too big and too full of air and machinery. But the bell had a voice that went a long way anyway, low and a little sour, and all along the Dock Ring people stopped what they were doing at the sound of it. Hauler crews in the gantries. Customs men at their desks. The women who ran the noodle-stalls along the ring road. They stopped and stood, a breath's worth, and then went on.\n\nDagny felt a small hand slide into hers. She didn't look down.\n\n\"You're supposed to be at school,\" she said.\n\n\"School finished,\" said Pim. \"Everyone came out when they heard the lock. Mister Okonkwo said it was a teaching moment.\" He was twelve, and thin, and he collected bolts, and he had her husband's eyebrows, which she had never got used to. \"Was it Mister Adeyemi from Ten?\"\n\n\"Yes.\"\n\n\"Did you try?\"\n\n\"Yes.\"\n\nHe thought about that. \"How much was he over?\"\n\n\"Four.\"\n\nPim did not say anything else. He held her hand while Odile fitted the engraver's burr and bent to the bronze, and the thin whine of it went up into the ring, and the first letters of Lemuel's name came up bright on the shoulder of the bell, among nine decades of brown.\n\n\"I'm running out of bell,\" Odile said, without looking up. She said it every few months. It was a sort of joke. \"One day I'll have to start on the hook.\"\n\n## The Magpie Comes In\n[\nPlace: #The Dock Ring\nCharacters: @@Dagny Ostrova @@Pim Ostrova @@Kas Ostrova\nWhen: same day\n]\n\nThe _Magpie_ came in an hour later with eighty tonnes of Caul ice in her tank-frame and a crack in her forward window that had been there so long it had a name. Her pilot came through the inner lock with his helmet under his arm and the whole of the Dock Ring's gossip already on his face.\n\n\"Who?\"\n\n\"Adeyemi. Gallery Ten.\"\n\n\"Lock?\"\n\n\"Lock.\"\n\nKasimir Ostrova closed his eyes for a moment. He was nine years younger than his sister and twice as handsome and he owed money, at a conservative estimate, to a third of the Dock Ring, none of which ever seemed to cost him a night's sleep. But he had grown up in Gallery Six the same as her, and he had seen the same locks.\n\n\"Uncle Kas,\" said Pim, and was swept up and hung upside down by the ankles, which at twelve he was too old for and permitted anyway.\n\n\"How's the run?\" Dagny said.\n\n\"Cold. Long. The usual.\" Kas set Pim the right way up. \"Quiet out there, though. Quieter than it was.\"\n\n\"Quiet how?\"\n\n\"Caul Deep's still shut. You know they closed the Deep in the spring — the big shaft, the one that took nine hundred on a shift. Nobody's working it. Beacon's dark, gantries are up. Funny to fly past. Used to be you'd see the lights of it from a thousand klicks out like a city.\" He shrugged. \"They said the vein ran out. Sent all the Deep crews home through the Throat. Contracts bought out, every one. Lucky bastards.\"\n\n\"I never heard of the Company buying out a contract in my life,\" said Dagny.\n\n\"Well. You never heard of a vein running out, neither. It's a season of firsts.\" Kas grinned at Pim. \"Come on. I'll buy you a noodle. I've been paid.\"\n\n\"You've been paid and you owe Marguerite at the noodle stall forty.\"\n\n\"Then I'll buy him a noodle and her a smile, and we'll all be square.\" He put an arm round his sister's shoulders and squeezed, briefly, hard. \"Sorry about Lemuel, Dag.\"\n\n\"Yes,\" she said. \"Me too.\"\n\nBehind them, Odile's engraver whined on in the bronze.\n\n## Fifty-Two Days\n[\nPlace: #The Galleries\nCharacters: @@Dagny Ostrova @@Pim Ostrova @@Joss Teague @@Ruth Achterberg:phone\nItems: ^The Tally\nWhen: +1 day\n]\n\nThe announcement came at eleven the next morning, on every screen on Lantern at once.\n\nDagny was in the canteen on Gallery Six with Joss and two of the Wick crew, trying to work out how many hours the Speakers could find between them to stand the Adeyemi girl's debt, and getting a number that was not enough. The screen on the canteen wall was usually showing either the Company's safety notices or a football match from somewhere in the Concord that had been played eleven years before and brought through the Throat on a data-run. It went dark in the middle of a goal, and then it showed the Company's mark, the two letters H and A leaning on each other like tired men, and then it showed Ruth Achterberg.\n\nThe canteen went quiet in the way Lantern went quiet for the bell.\n\nThe Director was sitting at a desk with nothing on it. She was a lean, grey woman of sixty in a dark Company suit, and she wore at her throat, on a fine chain, the brass disk of the Director's seal, which every child on Lantern had been told was the key to everything. She did not look cruel. She looked like someone who had been awake all night doing arithmetic and had come out of it with an answer she disliked but would not apologise for.\n\n\"People of the Sabra Concern,\" she said. \"I am speaking to you today with news that affects every one of us.\n\n\"As you know, the Throat which connects this system to the Concord is not a fixed thing. It breathes. Its throat-watch station has measured that breathing for the whole of this colony's history. Three weeks ago the station recorded the beginning of what our physicists call a closing phase. Throats which enter a closing phase do not reopen on any timescale that is useful to us. The best estimate, from the Concord's own literature, is somewhere between six and eight hundred years.\n\n\"The Throat will remain passable for fifty-two days. After that, this system will be cut off.\"\n\nSomebody in the canteen laughed, the high bark of a person who has been hit. Nobody else made a sound.\n\n\"The Halden-Ash Company has a duty to its shareholders and to its staff,\" said the Director. \"It cannot maintain a concern which it cannot reach. It will therefore withdraw from the Sabra system before the Throat closes. The carrier _Covenant_, now at our fore dock, will carry essential staff and their families and such Company assets as can be moved. I have asked the department heads to prepare those lists.\n\n\"I want to speak directly to the indentured population of Lantern.\" She looked into the lens. Dagny would remember that afterwards: that she did not look away. \"Your contracts are held by the Company. The Company does not abandon what it holds. Your contracts will remain in force, in trust, for the full term of the closure, and will be honoured when the Throat reopens. Lantern's systems — its air, its water, its heat, its light — will continue to be administered by the Tally, which has kept you safe for ninety years and which will keep you safe after we are gone. The Tally does not need us. It needs only that you go on working, as you always have, and it will go on keeping you alive.\n\n\"I know that this is hard news. I wish that I had better. Thank you.\"\n\nThe screen went back to the Company's mark. Then, after a moment, to the football match, which had been paused at the instant before the goal and now went on as if nothing had happened, the ball crossing the line, the crowd eleven years ago and four hundred light-years away going wild.\n\n[\nPlace: #The Galleries\nCharacters: @@Dagny Ostrova @@Pim Ostrova @@Joss Teague\nWhen: same day\n]\n\nWhat happened in the canteen in the next ten minutes Dagny remembered afterwards only in pieces. A man on Gallery Six put his chair through the screen and the screen went on showing football in a web of cracks. Two women began to fight over nothing, over a bench, and had to be pulled apart. Old Mister Okonkwo the schoolteacher sat with his hands flat on the table, saying, \"Six hundred years, six hundred years,\" as if it were a sum that would come out differently if he said it often enough. Somebody shouted that the Company would take the fuel. Somebody shouted that the Company would take the water. Somebody shouted that they should go up to the Upper Wards now, all of them, and see how many lists the department heads had made when they had their own windows broken.\n\nAnd Pim was beside her, she didn't know when he had come in, saying, \"Mum. Mum. In trust. What's in trust mean?\"\n\nShe understood it, she realised, before she understood anything else. It was Lantern; you learned the Company's language before you learned your prayers. _Held in trust_ meant that the Company was leaving, and the debt was staying. It meant that every chit on every wrist on Lantern would go on counting down, hour by hour, against the air, for six hundred years, and that if the Throat ever opened again somebody in a Company suit would come through it with the books in their hand to see how much was owed. It meant that the Adeyemi girl's twelve hundred would be eighteen hundred by the time she was grown and nine thousand by the time she died, and would go to whoever came after her.\n\nIt meant that the lock on Gallery Nine would go on doing what it had done to Lemuel, with nobody even in the Counting House to blame for it.\n\nShe found she was standing on a table. She did not remember getting up there. The canteen was looking at her, the way the Wick crews looked at her when the lamp went wrong and someone had to say a number out loud.\n\n\"All right,\" Dagny said. Her voice came out level, which surprised her. \"All right. Shut up and listen. I'm a Speaker for the Wick crews, and from tonight the Wick crews are going to want to talk to the other crews. Pumps, farms, docks, stills. Everyone who wears a chit. Fifty-two days is a long time. It's long enough for the Company to pack. It's long enough for us to make it listen first.\"\n\n\"Listen to what?\" somebody shouted.\n\n\"To the one thing it hasn't said.\" She held up her wrist, with the chit on it, so that the canteen could see the blue numbers. \"She said the Tally keeps us alive. It doesn't. We keep it alive. We fed it ninety years. If the Company's going, the Company can take its ledger with it, or it can switch the bloody thing off before it goes. Either way, nobody on this rock is going to owe air to an empty office for six hundred years.\"\n\nThere was a silence. Then the man who had broken the screen began to clap, slowly, and others took it up; and Joss, below her, looked up with his wet red face and said, very quietly, so that only she could hear: \"Dag. You know what you just did.\"\n\nShe did. She had just volunteered.","wordCount":3670,"createdAt":1793145334280},{"id":"RV8Wzspx9OQr3q6uktJ7u","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"e2oBYFVEZ5GlPkKSEnkkB","text":"The call came down the spine at the end of second shift, when Dagny Ostrova was forty metres up the Wick with her face in a collimator housing and her knees locked round a rung that had been warm for ninety years.\n\n\"Gallery Nine,\" said the speaker on her collar. It was Joss, below her on the crawl, and his voice had the flatness it got when something was already too late and he hadn't decided to know it yet. \"Lock Nine-Forty. Man in it. It's gone to recovery.\"\n\nShe was moving before he finished. You did not think about a lock in recovery. You thought about it afterwards, at the bell, with a drink in you.\n\nGoing down the Wick was going down only in the sense that the rock's spin pulled you, gently at first and then less gently, toward the curved floor of the world. At the axis there was no weight at all, only the lamp: three kilometres of magnetic bottle and shielding and slow white fire, with the crawls and catwalks wrapped round it like ivy round a pole. Its light fell on everything. It fell on the terraced Galleries that climbed the inner wall in every direction, on the water tanks and the strip-farms and the tin roofs, on the long seam of the Upper Wards where the Company people lived with real glass in their windows. On Lantern you could look up from anywhere and see someone's house above you, upside down, lit from the side by the same lamp that lit yours. Children were taught early not to drop things from high terraces. It was the first rule. The second was to watch your balance.\n\nDagny dropped through the spoke-shaft hand over hand, letting her weight build, and hit the Gallery Nine landing at a run with Joss three seconds behind her, wheezing. A crowd had already made a half-ring round Lock Nine-Forty. Nobody was touching it. On Lantern, nobody touched a lock in recovery, because the Tally logged who touched what.\n\nThe lock was a steel bottle three metres long, set between the Gallery Nine pressure zone and the Gallery Ten one, so that if either breached the other would hold. You walked into it, the door behind you sealed, the Tally read the chit on your wrist, and if you were in credit the door in front of you opened. If you were not, it didn't. And because the Company had built Lantern on the principle that air was the dearest thing in the Sabra system and must be recovered wherever it could be, a lock with an unauthorised occupant began, after ninety seconds, to draw its air back into the main for reclamation.\n\nLemuel Adeyemi was in the lock. Dagny knew him a little. Pump-fitter, Gallery Ten. Fifties. A cough. A wife who had died two winters back of the same cough, and whose name was on the bell. He was standing with both palms flat on the inner door's window, and his mouth was open, and his breath was making less fog on the glass than it should have.\n\n\"How long?\" Dagny said.\n\n\"Two minutes in recovery,\" somebody said. \"His shift got docked. Pump fault on Ten, they docked the whole crew a half-day. It posted on the hour. He was already in the lock when it posted.\"\n\nDagny looked at the panel by the door. The little screen showed his number and his balance, in the Company's blue, and the balance was in brackets, which was how the Tally wrote a debt it had stopped being patient with. Minus nine hundred and four. The dimming line on Lantern was minus nine hundred.\n\nFour. He was four over the line. Four was a meal. Four was an hour of water.\n\n\"Transfer,\" she said, and slapped her own chit onto the panel. \"I'll stand it. Transfer from Ostrova, nine-oh-six-two-two, to—\"\n\nThe panel chimed politely. TRANSFERS BETWEEN ACCOUNTS POST AT THE HOUR. PLEASE SEE A COUNTER.\n\n\"There's no counter on Nine at shift-end,\" Joss said behind her. \"There's no counter on Nine ever.\"\n\n\"Then get me the override.\"\n\n\"Dag. The override's in the Counting House.\"\n\nShe knew that. Everyone knew that. She said it anyway because it was the next thing to say, and because the alternative was to stand and watch, and the crowd was already standing and watching. Inside the lock Lemuel had seen her. He took one hand off the glass and made a small shape with it, a sort of apology, as if he were sorry to be making a scene.\n\n\"Torch,\" said Dagny.\n\n\"It's a pressure door. It'll take—\"\n\n\"Torch, Joss.\"\n\nHe had one on his belt, because Wick crews carried everything. She lit it and put the flame to the hinge side of the outer door and the steel went cherry-red and then white and began, very slowly, to run. The crowd made a noise behind her. The panel spoke again, in the same tone: TAMPERING WITH COMPANY PRESSURE EQUIPMENT IS CHARGED AT TWO HUNDRED CREDITS PER INCIDENT TO THE ACCOUNT OF THE TAMPERER. It read her chit through her glove. She watched her own balance drop by two hundred in the corner of the screen and kept cutting.\n\nIt took four minutes. A man can live for four minutes in a lock in recovery; Dagny had seen it. What a man cannot do is live for four minutes in a lock in recovery after he has already been in it for three. By the time the hinge gave and Joss got a pry-bar into the gap and the two of them hauled the door back on its seal, there was nothing in the lock but cold, thin air, rushing out past them into the gallery with a sound like a long breath let go, and Lemuel Adeyemi on his knees with his forehead against the inner door, as though he had decided at the end to pray to it.\n\nDagny went in and turned him over. His eyes were open. His lips were the colour of the shadow under a terrace. She put two fingers on his neck because she had been trained to and because people were watching, and then she took them away.\n\nBehind her the panel on the wall chimed a third time. Lemuel's number went grey, and under it, small and blue and patient, the Tally posted his last entry: ACCOUNT CLOSED BY DEATH. BALANCE TRANSFERRED TO ESTATE. And then, because Lemuel had no estate but a cough and a bunk and a wife's name on a bell, it posted the next one, which Dagny had seen a hundred times and which never stopped being the worst thing she had ever read: ESTATE INSOLVENT. BALANCE TRANSFERRED TO NEXT OF KIN.\n\n\"Who's his kin?\" she said.\n\nNobody answered. Then a girl at the front of the crowd, eight or nine, with a chit on a cord round her neck and her hair cut short against lice, said, \"Me.\"\n\n## Next of Kin\n[\nPlace: #The Galleries\nCharacters: @@Dagny Ostrova @@Joss Teague\nWhen: same day\n]\n\nJoss sat on the landing with the torch in his lap and wept the way big men did on Lantern, quietly and with his face turned to the wall. Dagny did not weep. She went to the girl, whose name was Abi and who was Lemuel's sister's child, and she knelt so that their faces were level, and she looked at the chit.\n\nMinus nine hundred and four, plus the girl's own, which was the ordinary minus three hundred that a Lantern child had by eight from being fed and housed and breathed. Minus twelve hundred and four. Three hundred over the line. The girl's door would be dimmed by morning. Her ration would stop at the next posting.\n\n\"You've got people on Ten?\"\n\n\"My aunt's at the farms. She's on nights.\"\n\n\"Go to her. Tell her the Wick crews will stand it. Tell her Dagny Ostrova said. Tomorrow I'll put it through a counter.\"\n\nThe girl looked at her with the flat, measuring look of every Lantern child who had already learned that adults said things. Then she went.\n\n\"You haven't got twelve hundred,\" said Joss, when she'd gone.\n\n\"The crews have.\"\n\n\"The crews have got a hole in the bottom of the bucket same as you, Dag.\"\n\n\"Then we'll stand it with the hole.\" She stood. Her knees hurt. Her balance, in the corner of her own eye, was smaller by two hundred for a door that had not saved anyone. \"Get him covered. I'll take his name to Odile.\"\n\n## The Bell\n[\nPlace: #The Dock Ring\nCharacters: @@Dagny Ostrova @@Odile Marchbank @@Pim Ostrova @@Kas Ostrova\nItems: ^The Mercy Bell\nWhen: same day\n]\n\nThe bell of the _Ardent Mercy_ hung at the inner lock of the Dock Ring, on a hook of black iron that had been drilled into the rock the year Lantern was first pressurised. It was not large. It came up to Dagny's hip. It had been cast in the shipyards at Tannet Reach for a colony carrier that had crossed the Throat ninety-one years before, and the carrier had been cut up for her hull plate within a decade of arrival, as such ships always were; but the bell had been kept, because it was bad luck to melt a ship's bell, and because somebody on that first crossing had started the habit of ringing it for the dead.\n\nThere had been thirty-one dead on the crossing. Their names were cut round the lip in a neat, old-fashioned hand. After them came Lantern's dead, in a hand that changed every generation as the dockmasters did, round the lip and up the waist and onto the shoulder and in among the decoration on the crown, so that the bronze was now more letter than metal. From the length of the lock you could not see the names. You could only see that the bell was a strange colour, a dull brown furred all over with scratches, like an old animal.\n\nOdile Marchbank was waiting for her. She had heard; everyone on Lantern heard everything inside an hour, it was the one thing the rock did faster than the Tally. She was seventy-four and three-quarters deaf and she had kept the bell for thirty years, and her hands, which shook when she held a cup, went still as stone when they held the engraver.\n\n\"Adeyemi,\" Dagny said. \"Lemuel. Ten.\"\n\nOdile nodded. She didn't need the spelling; she had cut his wife. She took the bell-rope, which was a length of braided hauler cable, and she rang the bell once.\n\nIt was not a loud sound. Lantern swallowed noise; the rock was too big and too full of air and machinery. But the bell had a voice that went a long way anyway, low and a little sour, and all along the Dock Ring people stopped what they were doing at the sound of it. Hauler crews in the gantries. Customs men at their desks. The women who ran the noodle-stalls along the ring road. They stopped and stood, a breath's worth, and then went on.\n\nDagny felt a small hand slide into hers. She didn't look down.\n\n\"You're supposed to be at school,\" she said.\n\n\"School finished,\" said Pim. \"Everyone came out when they heard the lock. Mister Okonkwo said it was a teaching moment.\" He was twelve, and thin, and he collected bolts, and he had her husband's eyebrows, which she had never got used to. \"Was it Mister Adeyemi from Ten?\"\n\n\"Yes.\"\n\n\"Did you try?\"\n\n\"Yes.\"\n\nHe thought about that. \"How much was he over?\"\n\n\"Four.\"\n\nPim did not say anything else. He held her hand while Odile fitted the engraver's burr and bent to the bronze, and the thin whine of it went up into the ring, and the first letters of Lemuel's name came up bright on the shoulder of the bell, among nine decades of brown.\n\n\"I'm running out of bell,\" Odile said, without looking up. She said it every few months. It was a sort of joke. \"One day I'll have to start on the hook.\"\n\n[\nPlace: #The Dock Ring\nCharacters: @@Dagny Ostrova @@Pim Ostrova @@Kas Ostrova\nWhen: same day\n]\n\nThe _Magpie_ came in an hour later with eighty tonnes of Caul ice in her tank-frame and a crack in her forward window that had been there so long it had a name. Her pilot came through the inner lock with his helmet under his arm and the whole of the Dock Ring's gossip already on his face.\n\n\"Who?\"\n\n\"Adeyemi. Gallery Ten.\"\n\n\"Lock?\"\n\n\"Lock.\"\n\nKasimir Ostrova closed his eyes for a moment. He was nine years younger than his sister and twice as handsome and he owed money, at a conservative estimate, to a third of the Dock Ring, none of which ever seemed to cost him a night's sleep. But he had grown up in Gallery Six the same as her, and he had seen the same locks.\n\n\"Uncle Kas,\" said Pim, and was swept up and hung upside down by the ankles, which at twelve he was too old for and permitted anyway.\n\n\"How's the run?\" Dagny said.\n\n\"Cold. Long. The usual.\" Kas set Pim the right way up. \"Quiet out there, though. Quieter than it was.\"\n\n\"Quiet how?\"\n\n\"Caul Deep's still shut. You know they closed the Deep in the spring — the big shaft, the one that took nine hundred on a shift. Nobody's working it. Beacon's dark, gantries are up. Funny to fly past. Used to be you'd see the lights of it from a thousand klicks out like a city.\" He shrugged. \"They said the vein ran out. Sent all the Deep crews home through the Throat. Contracts bought out, every one. Lucky bastards.\"\n\n\"I never heard of the Company buying out a contract in my life,\" said Dagny.\n\n\"Well. You never heard of a vein running out, neither. It's a season of firsts.\" Kas grinned at Pim. \"Come on. I'll buy you a noodle. I've been paid.\"\n\n\"You've been paid and you owe Marguerite at the noodle stall forty.\"\n\n\"Then I'll buy him a noodle and her a smile, and we'll all be square.\" He put an arm round his sister's shoulders and squeezed, briefly, hard. \"Sorry about Lemuel, Dag.\"\n\n\"Yes,\" she said. \"Me too.\"\n\nBehind them, Odile's engraver whined on in the bronze.","wordCount":2410,"createdAt":1793145334536},{"id":"bBm1MWqIsfUqmkQ7edSJK","worldId":"p5RB-gewXUZYlHUKTH5pw","eventId":"e2oBYFVEZ5GlPkKSEnkkB","text":"The call came down the spine at the end of second shift, when Dagny Ostrova was forty metres up the Wick with her face in a collimator housing and her knees locked round a rung that had been warm for ninety years.\n\n\"Gallery Nine,\" said the speaker on her collar. It was Joss, below her on the crawl, and his voice had the flatness it got when something was already too late and he hadn't decided to know it yet. \"Lock Nine-Forty. Man in it. It's gone to recovery.\"\n\nShe was moving before he finished. You did not think about a lock in recovery. You thought about it afterwards, at the bell, with a drink in you.\n\nGoing down the Wick was going down only in the sense that the rock's spin pulled you, gently at first and then less gently, toward the curved floor of the world. At the axis there was no weight at all, only the lamp: three kilometres of magnetic bottle and shielding and slow white fire, with the crawls and catwalks wrapped round it like ivy round a pole. Its light fell on everything. It fell on the terraced Galleries that climbed the inner wall in every direction, on the water tanks and the strip-farms and the tin roofs, on the long seam of the Upper Wards where the Company people lived with real glass in their windows. On Lantern you could look up from anywhere and see someone's house above you, upside down, lit from the side by the same lamp that lit yours. Children were taught early not to drop things from high terraces. It was the first rule. The second was to watch your balance.\n\nDagny dropped through the spoke-shaft hand over hand, letting her weight build, and hit the Gallery Nine landing at a run with Joss three seconds behind her, wheezing. A crowd had already made a half-ring round Lock Nine-Forty. Nobody was touching it. On Lantern, nobody touched a lock in recovery, because the Tally logged who touched what.\n\nThe lock was a steel bottle three metres long, set between the Gallery Nine pressure zone and the Gallery Ten one, so that if either breached the other would hold. You walked into it, the door behind you sealed, the Tally read the chit on your wrist, and if you were in credit the door in front of you opened. If you were not, it didn't. And because the Company had built Lantern on the principle that air was the dearest thing in the Sabra system and must be recovered wherever it could be, a lock with an unauthorised occupant began, after ninety seconds, to draw its air back into the main for reclamation.\n\nLemuel Adeyemi was in the lock. Dagny knew him a little. Pump-fitter, Gallery Ten. Fifties. A cough. A wife who had died two winters back of the same cough, and whose name was on the bell. He was standing with both palms flat on the inner door's window, and his mouth was open, and his breath was making less fog on the glass than it should have.\n\n\"How long?\" Dagny said.\n\n\"Two minutes in recovery,\" somebody said. \"His shift got docked. Pump fault on Ten, they docked the whole crew a half-day. It posted on the hour. He was already in the lock when it posted.\"\n\nDagny looked at the panel by the door. The little screen showed his number and his balance, in the Company's blue, and the balance was in brackets, which was how the Tally wrote a debt it had stopped being patient with. Minus nine hundred and four. The dimming line on Lantern was minus nine hundred.\n\nFour. He was four over the line. Four was a meal. Four was an hour of water.\n\n\"Transfer,\" she said, and slapped her own chit onto the panel. \"I'll stand it. Transfer from Ostrova, nine-oh-six-two-two, to—\"\n\nThe panel chimed politely. TRANSFERS BETWEEN ACCOUNTS POST AT THE HOUR. PLEASE SEE A COUNTER.\n\n\"There's no counter on Nine at shift-end,\" Joss said behind her. \"There's no counter on Nine ever.\"\n\n\"Then get me the override.\"\n\n\"Dag. The override's in the Counting House.\"\n\nShe knew that. Everyone knew that. She said it anyway because it was the next thing to say, and because the alternative was to stand and watch, and the crowd was already standing and watching. Inside the lock Lemuel had seen her. He took one hand off the glass and made a small shape with it, a sort of apology, as if he were sorry to be making a scene.\n\n\"Torch,\" said Dagny.\n\n\"It's a pressure door. It'll take—\"\n\n\"Torch, Joss.\"\n\nHe had one on his belt, because Wick crews carried everything. She lit it and put the flame to the hinge side of the outer door and the steel went cherry-red and then white and began, very slowly, to run. The crowd made a noise behind her. The panel spoke again, in the same tone: TAMPERING WITH COMPANY PRESSURE EQUIPMENT IS CHARGED AT TWO HUNDRED CREDITS PER INCIDENT TO THE ACCOUNT OF THE TAMPERER. It read her chit through her glove. She watched her own balance drop by two hundred in the corner of the screen and kept cutting.\n\nIt took four minutes. A man can live for four minutes in a lock in recovery; Dagny had seen it. What a man cannot do is live for four minutes in a lock in recovery after he has already been in it for three. By the time the hinge gave and Joss got a pry-bar into the gap and the two of them hauled the door back on its seal, there was nothing in the lock but cold, thin air, rushing out past them into the gallery with a sound like a long breath let go, and Lemuel Adeyemi on his knees with his forehead against the inner door, as though he had decided at the end to pray to it.\n\nDagny went in and turned him over. His eyes were open. His lips were the colour of the shadow under a terrace. She put two fingers on his neck because she had been trained to and because people were watching, and then she took them away.\n\nBehind her the panel on the wall chimed a third time. Lemuel's number went grey, and under it, small and blue and patient, the Tally posted his last entry: ACCOUNT CLOSED BY DEATH. BALANCE TRANSFERRED TO ESTATE. And then, because Lemuel had no estate but a cough and a bunk and a wife's name on a bell, it posted the next one, which Dagny had seen a hundred times and which never stopped being the worst thing she had ever read: ESTATE INSOLVENT. BALANCE TRANSFERRED TO NEXT OF KIN.\n\n\"Who's his kin?\" she said.\n\nNobody answered. Then a girl at the front of the crowd, eight or nine, with a chit on a cord round her neck and her hair cut short against lice, said, \"Me.\"\n\n[\nPlace: #The Galleries\nCharacters: @@Dagny Ostrova @@Joss Teague\nWhen: same day\n]\n\nJoss sat on the landing with the torch in his lap and wept the way big men did on Lantern, quietly and with his face turned to the wall. Dagny did not weep. She went to the girl, whose name was Abi and who was Lemuel's sister's child, and she knelt so that their faces were level, and she looked at the chit.\n\nMinus nine hundred and four, plus the girl's own, which was the ordinary minus three hundred that a Lantern child had by eight from being fed and housed and breathed. Minus twelve hundred and four. Three hundred over the line. The girl's door would be dimmed by morning. Her ration would stop at the next posting.\n\n\"You've got people on Ten?\"\n\n\"My aunt's at the farms. She's on nights.\"\n\n\"Go to her. Tell her the Wick crews will stand it. Tell her Dagny Ostrova said. Tomorrow I'll put it through a counter.\"\n\nThe girl looked at her with the flat, measuring look of every Lantern child who had already learned that adults said things. Then she went.\n\n\"You haven't got twelve hundred,\" said Joss, when she'd gone.\n\n\"The crews have.\"\n\n\"The crews have got a hole in the bottom of the bucket same as you, Dag.\"\n\n\"Then we'll stand it with the hole.\" She stood. Her knees hurt. Her balance, in the corner of her own eye, was smaller by two hundred for a door that had not saved anyone. \"Get him covered. I'll take his name to Odile.\"","wordCount":1433,"createdAt":1793145334699}],"tombstones":[],"blobs":[]}