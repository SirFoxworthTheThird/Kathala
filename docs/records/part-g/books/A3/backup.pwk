eArtifacts":[],"mapRoutes":[],"mapRegions":[],"mapRegionSnapshots":[],"mapAnnotations":[],"loreCategories":[],"lorePages":[],"factions":[{"worldId":"p5RB-gewXUZYlHUKTH5pw","name":"The Count","description":"The Owing, 311 AC. The Counting House: the counting families of the Upper Wards who keep the Tally and administer the Caul Account. Ruled by the Comptroller-General; enforced by the Bailiff of the Count.","color":"#22c55e","coverImageId":null,"tags":[],"id":"DSVxaAh1hdIKuAeHmtfvI","createdAt":1793146720996,"updatedAt":1793146815735,"version":2},{"worldId":"p5RB-gewXUZYlHUKTH5pw","name":"The Wickwrights","description":"The Owing, 311 AC. The guild that keeps the Wick. Down to a handful.","color":"#3b82f6","coverImageId":null,"tags":[],"id":"HlqYGueXW8Bnkd8EA-86r","createdAt":1793146724533,"updatedAt":1793146824648,"version":2},{"worldId":"p5RB-gewXUZYlHUKTH5pw","name":"The Speakers","description":"The Closing, 2387. The elected voices of Lantern's indentured crews: Wick, pumps, stills, farms, docks. Not a union the Company recognises.","color":"#f97316","coverImageId":null,"tags":[],"id":"dIEAcgdp1bcw0KzkCckPE","createdAt":1793146717447,"updatedAt":1793146808388,"version":2},{"worldId":"p5RB-gewXUZYlHUKTH5pw","name":"The Salt","description":"The Owing, 311 AC. Smugglers who run ice off Caul outside the Tally and trade in brass washers. Based in the old ice docks.","color":"#14b8a6","coverImageId":null,"tags":[],"id":"fAmyEkSeUAdcdWPIkN6EY","createdAt":1793146722766,"updatedAt":1793146821772,"version":2},{"worldId":"p5RB-gewXUZYlHUKTH5pw","name":"The Good Title's crew","description":"The Healing, 3089 CE. Mabry Ode's people. Throat-runners.","color":"#ec4899","coverImageId":null,"tags":[],"id":"jhjr7tzIjP-KNWkuxA4gA","createdAt":1793146728083,"updatedAt":1793146833547,"version":2},{"worldId":"p5RB-gewXUZYlHUKTH5pw","name":"Company Security","description":"The Closing, 2387. The Company's armed men on Lantern, ex-marines most of them. They sealed Caul Deep.","color":"#eab308","coverImageId":null,"tags":[],"id":"mNHlftQ13Dn1dNx3evd94","createdAt":1793146719214,"updatedAt":1793146812854,"version":2},{"worldId":"p5RB-gewXUZYlHUKTH5pw","name":"The Halden-Ash Company","description":"The Closing, 2387. The chartered company that opened the Sabra Concern in 2296 and owns Lantern, its air, its water, and its people's contracts. Withdrawing as the Throat closes.","color":"#ef4444","coverImageId":null,"tags":[],"id":"tDq4uex-lPhI2ed7FgDno","createdAt":1793146715682,"updatedAt":1793146803885,"version":3},{"worldId":"p5RB-gewXUZYlHUKTH5pw","name":"Brightwater Recovery","description":"The Healing, 3089 CE. A Concord lien-house. Bought the Halden-Ash Sabra Concern receivables eleven years before the Throat healed.","color":"#8b5cf6","coverImageId":null,"tags":[],"id":"wjNl7B17DNZ7A3K8Ad7kv","createdAt":1793146726309,"updatedAt":1793146827503,"version":2}],"factionMemberships":[{"worldId":"p5RB-gewXUZYlHUKTH5pw","factionId":"jhjr7tzIjP-KNWkuxA4gA","characterId":"QFvVlO7B_a1YmFMbnd84l","role":null,"startEventId":null,"endEventId":null,"notes":"","id":"3_0ehzJPS2dMDIiBtMBd8","createdAt":1793146836522,"updatedAt":1793146836522,"version":1},{"worldId":"p5RB-gewXUZYlHUKTH5pw","factionId":"dIEAcgdp1bcw0KzkCckPE","characterId":"g_pQemPTYKrSyuBXSXecB","role":null,"startEventId":null,"endEventId":null,"notes":"","id":"89fXxosNrglon9hTjc21n","createdAt":1793146811372,"updatedAt":1793146811372,"version":1},{"worldId":"p5RB-gewXUZYlHUKTH5pw","factionId":"tDq4uex-lPhI2ed7FgDno","characterId":"B5N-ORRxzDAoRSjwt4RPw","role":null,"startEventId":null,"endEventId":null,"notes":"","id":"AK2bADZ_TthA8Dc_z1QZp","createdAt":1793146805305,"updatedAt":1793146805305,"version":1},{"worldId":"p5RB-gewXUZYlHUKTH5pw","factionId":"fAmyEkSeUAdcdWPIkN6EY","characterId":"4DB-SYsFxGhwQg_T_P6Tr","role":null,"startEventId":null,"endEventId":null,"notes":"","id":"ByYpZefWJybBGah-3cTxN","createdAt":1793146823170,"updatedAt":1793146823170,"version":1},{"worldId":"p5RB-gewXUZYlHUKTH5pw","factionId":"wjNl7B17DNZ7A3K8Ad7kv","characterId":"EEp34P_LIwiHnQUS72F_S","role":null,"startEventId":null,"endEventId":null,"notes":"","id":"MiOLzd4kBvkdMAngbKyo8","createdAt":1793146830488,"updatedAt":1793146830488,"version":1},{"worldId":"p5RB-gewXUZYlHUKTH5pw","factionId":"tDq4uex-lPhI2ed7FgDno","characterId":"4PJK2irFlLq0lPkroCgPG","role":null,"startEventId":null,"endEventId":null,"notes":"","id":"UkZ4XrdRupQ-040Rgojrk","createdAt":1793146806904,"updatedAt":1793146806904,"version":1},{"worldId":"p5RB-gewXUZYlHUKTH5pw","factionId":"HlqYGueXW8Bnkd8EA-86r","characterId":"U8Xy6zAdXRBSS6PGWXunZ","role":null,"startEventId":null,"endEventId":null,"notes":"","id":"VywOwMJMl-ZCAF776K0Wy","createdAt":1793146826020,"updatedAt":1793146826020,"version":1},{"worldId":"p5RB-gewXUZYlHUKTH5pw","factionId":"DSVxaAh1hdIKuAeHmtfvI","characterId":"DdyKkgZFy6btLNqFcDspr","role":null,"startEventId":null,"endEventId":null,"notes":"","id":"Wku_DWm0CldzqnUc9YQFn","createdAt":1793146818687,"updatedAt":1793146818687,"version":1},{"worldId":"p5RB-gewXUZYlHUKTH5pw","factionId":"wjNl7B17DNZ7A3K8Ad7kv","characterId":"OQkh-QSkbPJM5F4BWfdhS","role":null,"startEventId":null,"endEventId":null,"notes":"","id":"drv_-N7QxF3AQKHU88bxR","createdAt":1793146832071,"updatedAt":1793146832071,"version":1},{"worldId":"p5RB-gewXUZYlHUKTH5pw","factionId":"DSVxaAh1hdIKuAeHmtfvI","characterId":"X1JRrGlyZdp8QBMZ6SYZN","role":null,"startEventId":null,"endEventId":null,"notes":"","id":"fBmWPTiGZlTXiNan1cjM0","createdAt":1793146820288,"updatedAt":1793146820288,"version":1},{"worldId":"p5RB-gewXUZYlHUKTH5pw","factionId":"wjNl7B17DNZ7A3K8Ad7kv","characterId":"TRqcAjx0xfYg8Pc46bEt2","role":null,"startEventId":null,"endEventId":null,"notes":"","id":"g52Y3RKAzm0ua-JBjnOuG","createdAt":1793146828887,"updatedAt":1793146828887,"version":1},{"worldId":"p5RB-gewXUZYlHUKTH5pw","factionId":"mNHlftQ13Dn1dNx3evd94","characterId":"WQ9NeOVAbNSpDXQKkGhBO","role":null,"startEventId":null,"endEventId":null,"notes":"","id":"oFO3_wJecpKEOtGspfPD9","createdAt":1793146814254,"updatedAt":1793146814254,"version":1},{"worldId":"p5RB-gewXUZYlHUKTH5pw","factionId":"dIEAcgdp1bcw0KzkCckPE","characterId":"qBQ4QH8OQcPou62jFFMxx","role":null,"startEventId":null,"endEventId":null,"notes":"","id":"oSn2rpiBzianu8V2W4UkL","createdAt":1793146809771,"updatedAt":1793146809771,"version":1},{"worldId":"p5RB-gewXUZYlHUKTH5pw","factionId":"DSVxaAh1hdIKuAeHmtfvI","characterId":"K2sa5OCdLdT81u7a1yBt0","role":null,"startEventId":null,"endEventId":null,"notes":"","id":"pgumTSy7mColWxkMQrOa3","createdAt":1793146817104,"updatedAt":1793146817104,"version":1},{"worldId":"p5RB-gewXUZYlHUKTH5pw","factionId":"jhjr7tzIjP-KNWkuxA4gA","characterId":"WshcV6xq7C75QU8kONPBB","role":null,"startEventId":null,"endEventId":null,"notes":"","id":"y-bXbp9HrSSj4gec-dRfR","createdAt":1793146834920,"updatedAt":1793146834920,"version":1}],"factionRelationships":[],"knowledgeFacts":[{"readerLearnsAtEventId":"yZpgnpjBHSlNECwKUqvZs","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"The Count will Call the ten thousand deepest accounts into the Cold","description":"Vosk at the Hook: the Wick will fail before year's end. The ten thousand deepest accounts will be released from the Tally's charge and sent into the Cold Wards. Lists posted in thirty days.","tags":[],"id":"3wVyv-0D4jJwyJJDIn8UC","createdAt":1793146612170,"updatedAt":1793146615529,"version":3},{"readerLearnsAtEventId":"a8a4Mt67-JHW0f3gQMomY","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"The Throat will close in fifty-two days","description":"The Company's announcement: the throat-watch has recorded the onset of a closing phase. The Company withdraws; the indentured stay, their contracts held in trust.","tags":[],"id":"IuIH_ap5aCjp_TsGZT4Xy","createdAt":1793146569621,"updatedAt":1793146572965,"version":3},{"readerLearnsAtEventId":"dBVXB5GjzcCS3zIlsCSj_","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"Hold 2 carries 3,012 sleepers contracted to the Sabra instrument","description":"Labour contracts, mostly water debts, bought cheap and assigned to the Sabra Concern, persons and issue. To populate the instrument if Lantern is empty, or to be merged with the natives if not.","tags":[],"id":"MtxRdC1P28bSJ2Q8FDYD7","createdAt":1793147751456,"updatedAt":1793147754783,"version":3},{"readerLearnsAtEventId":"LvXM0bEI0nlmqY1Qsun4c","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"The Hulk is Hull 7731, and its reactor holds fourteen cassettes in reserve","description":"Stencil under the paint of the fifth hall: HA 7731, reactor access, frame 40. The light ledger has carried RESERVE — HULL 7731, 14 UNITS, HELD since the Founding.","tags":[],"id":"NlFnKYQMQeTzI0O8q4bNz","createdAt":1793147726388,"updatedAt":1793147729734,"version":3},{"readerLearnsAtEventId":"uTK9LSRUiQd0vJvwfbVuL","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"Both keys will be at the Tally's root together on the morning the Covenant leaves","description":"By the charter, the Director and the Comptroller must close the Company's accounts and transfer the trust in person at the root, on the morning of departure. About twenty minutes, door open.","tags":[],"id":"SSQZ8ibesDDUiNZQo70NO","createdAt":1793147657863,"updatedAt":1793147661254,"version":3},{"readerLearnsAtEventId":"aV3K3iPiIvRKl7xKEj1nU","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"The Tally's root opens only to the Director's seal and the Comptroller's key together","description":"The root, behind three doors in the Counting House vault, holds the rules. Two keys together can rewrite the Tally's book; nothing can switch it off.","tags":[],"id":"VHM8xuN0PzEmciuV2N9c7","createdAt":1793146587088,"updatedAt":1793146590430,"version":3},{"readerLearnsAtEventId":"Cn5BkF_eu6u7dgHdRD9wO","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"The dead of Caul are cut on the Mercy Bell","description":"The dense band on the bell's waist, in hurried hands, is the Caul Deep roster in alphabetical order: all nine hundred and four.","tags":[],"id":"VyJGfDU4V40-ysRCYiBq4","createdAt":1793147771390,"updatedAt":1793147774732,"version":3},{"readerLearnsAtEventId":"jCCT8EN2Vj2l-O2J-Y878","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"The Mercy Bell left the Sabra system before the Closing","description":"Fen's family bought it at a wreck auction at Tannet, from an unidentified hulk, thirty years after the Closing. How it came out is unknown.","tags":[],"id":"X86sJFI6tMtII3GPAxjQB","createdAt":1793146654706,"updatedAt":1793146658077,"version":3},{"readerLearnsAtEventId":"HndU3cXz3axOEEAjEX_H4","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"The Company is moving the aft stores' fuel into the Covenant","description":"Haulers paid in hard Concord credit to carry fuel cassettes from the aft stores to the Covenant's hold. The Company says it leaves three hundred years of fuel for the Wick.","tags":[],"id":"Yzu619FSHx3dp2iajWWTX","createdAt":1793146599625,"updatedAt":1793146602963,"version":3},{"readerLearnsAtEventId":"EJWW-Mz6p40IDEc_eb7FC","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"Nine hundred and four miners died in Caul Deep and were written off as repatriated","description":"Shaft One blew out on 4 April 2387. The Director had the shaft sealed at the 300-metre station, some still alive behind the seal. Teodor posted the dead as contracts bought out and repatriated, and forged 431 letters home.","tags":[],"id":"bc-E_WZAf3gjpqPupJ6LF","createdAt":1793147670463,"updatedAt":1793147691814,"version":4,"spoilerWords":["blowout"]},{"readerLearnsAtEventId":"e2oBYFVEZ5GlPkKSEnkkB","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"The Tally keys Lantern's air to each person's debt","description":"Every valve on Lantern asks the Tally whose air it is. A balance past the dimming line is dimmed: doors close, rations stop, a lock with an unauthorised occupant goes to recovery.","tags":[],"id":"julz0e6TSybH1t9QZ9cYt","createdAt":1793146473354,"updatedAt":1793146538900,"version":3},{"readerLearnsAtEventId":"YoW2-AGKrhEXdDCLO-hxU","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"The Throat was never in a closing phase","description":"The throat-watch's raw feed shows the Throat breathing normally. The Director's closing-phase figures were invented.","tags":[],"id":"kbveamUjPSW0LvkOiQUSE","createdAt":1793147693219,"updatedAt":1793147696553,"version":3},{"readerLearnsAtEventId":"QCrXLJWL3UvmPUjnhlrKk","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"Hold 2 of the Good Title draws cryo-level power","description":"Sealed, certified 'agricultural stock'. The draw is larger than bridge, galley and quarters together: a deep-cold draw.","tags":[],"id":"kjlPwdawmNzSd_o7EtBlt","createdAt":1793146667273,"updatedAt":1793146670627,"version":3},{"readerLearnsAtEventId":"Fb0lH_0HezNb7JbWS3pa9","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"Agathe Hask's balance carries an error of 2,145 credits","description":"An inheritance surcharge keyed against her whole balance since 299 AC and then compounded. Corrected, she is above the Calling line.","tags":[],"id":"rkf2FOCQTRqek96XpCxKk","createdAt":1793146627185,"updatedAt":1793146630511,"version":3},{"readerLearnsAtEventId":"LvXM0bEI0nlmqY1Qsun4c","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"The Count means to light an auxiliary lamp for the Upper Wards from the reserve","description":"Work order signed by Vosk two years ago: auxiliary lamp, Upper Wards, to be commissioned on the failure of the Wick. Fuel: Reserve. A lamp for about four thousand.","tags":[],"id":"rmAm5kkjVqgLy6ducH2TS","createdAt":1793147738900,"updatedAt":1793147742252,"version":3},{"readerLearnsAtEventId":"YoW2-AGKrhEXdDCLO-hxU","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"The Company will collapse the Throat with a throat-shear fired from the Covenant","description":"Device, Concord ordnance, class T: a Succession Wars throat-shear, bought three months before the announcement. Fired behind the Covenant as she transits, it closes the Throat for centuries and keeps the Labour Inspectorate fleet out.","tags":[],"id":"uTgt0rauB8taS5nqPPrli","createdAt":1793147710691,"updatedAt":1793147724998,"version":5,"spoilerWords":["shear","throat-shear"]},{"readerLearnsAtEventId":"zP8QlkeX6-5VlVkvPkC8A","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"The Caul Account has no holder and was authorised by a key the Tally does not know","description":"First root entry, forty-ninth day of the Closing, 2387: creditor CAUL, all balances assigned in full, account holder NONE. Not the Founders' paired mark.","tags":[],"id":"v1mIcHZInE4ZrFlaP0hJn","createdAt":1793146644633,"updatedAt":1793146647978,"version":3},{"readerLearnsAtEventId":"DZy-AU7Be22nac5ny3Y4T","originEventId":null,"worldId":"p5RB-gewXUZYlHUKTH5pw","title":"Varga erased the Magpie's flight to Caul","description":"He watched the Magpie's unlogged run to Caul and Dagny on the comptroller's floor, and deleted both.","tags":[],"id":"xpeuOEaPCGItY9I9W78Kd","createdAt":1793147781454,"updatedAt":1793147784799,"version":3}],"knowledgeReveals":[{"worldId":"p5RB-gewXUZYlHUKTH5pw","factId":"Yzu619FSHx3dp2iajWWTX","characterId":"B5N-ORRxzDAoRSjwt4RPw","eventId":"e2oBYFVEZ5GlPkKSEnkkB","note":"","beforeStory":true,"id":"0SYOxVOunqmZVzsoc0Wi9","createdAt":1793146610401,"updatedAt":1793146610401,"version":1},{"worldId":"p5RB-gewXUZYlHUKTH5pw","factId":"3wVyv-0D4jJwyJJDIn8UC","characterId":"8FkLsgdUH52stzy3qThJO","eventId":"yZpgnpjBHSlNECwKUqvZs","note":"","id":"0qjuQI_XCGXjTT3QF2cF2","createdAt":1793146622928,"updatedAt":1793146622928,"version":1},{"worldId":"p5RB-gewXUZYlHUKTH5pw","factId":"rmAm5kkjVqgLy6ducH2TS","characterId":"K2sa5OCdLdT81u7a1yBt0","eventId":"f_ufE9D3tqhoILeyNqngm","note":"","beforeStory":true,"id":"1KA_FBGUndyenYbzn8B8q","createdAt":17931