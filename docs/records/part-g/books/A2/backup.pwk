solidation","synopsis":"","id":"K3gtgzGSING6-FUOWiPOZ","createdAt":1793093707854,"updatedAt":1793093707854,"version":1},{"notes":"","wordGoal":null,"worldId":"qazoRpRKLPklIu-1YyQ3E","timelineId":"3ccKI1mw2cEW_vdUu_sfh","number":2,"title":"Lampfast","synopsis":"Lampfast: the Lamp returns after 263 years; air-warden Isaura Venn cuts the Ocampos' air; the Concord of Vey arrives with thirty-eight ships and an ultimatum; the Council doubles the air-tithe; the first slug strikes.","id":"kS1El60ckIaLoBH50gx2J","createdAt":1793093332363,"updatedAt":1793093332363,"version":1},{"notes":"","wordGoal":null,"worldId":"qazoRpRKLPklIu-1YyQ3E","timelineId":"0Xu_cv1Gny61_Ck3WZFfX","number":3,"title":"Collateral","synopsis":"Collateral: on Cinderhaven, salvager Til Brask is about to lose her tug to Mother Szabo, who holds her niece Juno's bond; a dying client, Hollis Vey, hires the Dray to reach the Lamp before Gall destroys it; Juno is sent aboard as Szabo's witness, and Szabo's cutter follows.","id":"mhZF7hDKIhXp6M_Zb0xoG","createdAt":1793093499637,"updatedAt":1793093499637,"version":1},{"notes":"","wordGoal":null,"worldId":"qazoRpRKLPklIu-1YyQ3E","timelineId":"lA4fGrfZX-3LsiMN9O28B","number":1,"title":"The Dip","synopsis":"","id":"quCFFdFzs0Lm6U1fGCBe9","createdAt":1793092148670,"updatedAt":1793092998553,"version":2}],"events":[{"travelDays":0,"inWorldTime":null,"tension":null,"structureBeat":null,"status":"draft","povCharacterId":null,"isFlashback":false,"mentionedCharacterIds":[],"threadIds":[],"motifIds":[],"worldId":"qazoRpRKLPklIu-1YyQ3E","chapterId":"K3gtgzGSING6-FUOWiPOZ","timelineId":"lA4fGrfZX-3LsiMN9O28B","title":"The blister","description":"","locationMarkerId":"M0IyyHuwcrlJauyd63Zvc","involvedCharacterIds":["f5vdu9iWDF4RunSOdvhju","jmbAXO38b1gm_pdxz69KG"],"involvedItemIds":[],"tags":[],"id":"0T46v5SbLeM2hWt1bnUYG","sortOrder":3,"createdAt":1793093706948,"updatedAt":1793093709625,"version":3,"remoteCharacterIds":[]},{"travelDays":2,"inWorldTime":null,"tension":null,"str