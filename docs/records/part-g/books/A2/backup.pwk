createdAt":1793108732990,"updatedAt":1793108734898,"version":3,"remoteCharacterIds":[]},{"travelDays":null,"inWorldTime":0,"tension":null,"structureBeat":null,"status":"draft","povCharacterId":null,"isFlashback":false,"mentionedCharacterIds":[],"threadIds":[],"motifIds":[],"worldId":"qazoRpRKLPklIu-1YyQ3E","chapterId":"quCFFdFzs0Lm6U1fGCBe9","timelineId":"lA4fGrfZX-3LsiMN9O28B","title":"The line","description":"","locationMarkerId":"SEFbiW9Prcg7zDOt7zqAo","involvedCharacterIds":["f5vdu9iWDF4RunSOdvhju","1LES0QB1fovVBe_mxEF9-","NzpTETix1qHfkVk8GdUiW","jmbAXO38b1gm_pdxz69KG"],"involvedItemIds":["QwzXDb9ovzBXu8e0j8Zxm","yqB6zymhctuNUq1SIqvH6"],"tags":[],"id":"z3x3YJKqAA1IVoNVx4t37","sortOrder":0.125,"createdAt":1793092952079,"updatedAt":1793092952250,"version":2,"remoteCharacterIds":[]},{"travelDays":0,"inWorldTime":null,"tension":null,"structureBeat":null,"status":"draft","povCharacterId":null,"isFlashback":false,"mentionedCharacterIds":[],"threadIds":[],"motifIds":[],"worldId":"qazoRpRKLPklIu-1YyQ3E","chapterId":"K3gtgzGSING6-FUOWiPOZ","timelineId":"lA4fGrfZX-3LsiMN9O28B","title":"Relocation","description":"","locationMarkerId":"P96_1HiU16BAvABOmbQxa","involvedCharacterIds":["f5vdu9iWDF4RunSOdvhju","Gcjl3v1bFg5LHEGAAgxK4","P0QOGj-k7ijtAa43xafP3","jmbAXO38b1gm_pdxz69KG","aE1q6lwq3aKIEZsxYRiSi","W7RM_wucwxJNFn7_wDQ5U","vKXlNOjX8xtSpUZiQ81q8","NzpTETix1qHfkVk8GdUiW"],"involvedItemIds":[],"tags":[],"id":"ztuoYaqoIuoqq8-A2Tl57","sortOrder":1,"createdAt":1793093707324,"updatedAt":1793093708686,"version":3,"remoteCharacterIds":[]}],"travelModes":[],"timelineRelationships":[],"crossTimelineArtifacts":[],"mapRoutes":[],"mapRegions":[],"mapRegionSnapshots":[],"mapAnnotations":[],"loreCategories":[{"id":"3nJziH_uDmm3-3-E6ZE1R","worldId":"qazoRpRKLPklIu-1YyQ3E","name":"Work","color":null,"sortOrder":1},{"id":"BRR-Ae0z4irUPFqogAD-y","worldId":"qazoRpRKLPklIu-1YyQ3E","name":"Tarn","color":null,"sortOrder":5},{"id":"EYvK0QEzo3E4_kbY7zMc9","worldId":"qazoRpRKLPklIu-1YyQ3E","name":"Factions","color":null,"sortOrder":4},{"id":"STUv7xDDUOWJ3Sx5-xHuL","worldId":"qazoRpRKLPklIu-1YyQ3E","name":"Patience","color":null,"sortOrder":3},{"id":"hpXce9a4b1P9Zj8hzl0lk","worldId":"qazoRpRKLPklIu-1YyQ3E","name":"History","color":null,"sortOrder":2},{"id":"oz95rVCVAOZT-qD4lJbnY","worldId":"qazoRpRKLPklIu-1YyQ3E","name":"The System","color":null,"sortOrder":0}],"lorePages":[{"id":"1aVpcMy-qfgYcOkQgc7tM","worldId":"qazoRpRKLPklIu-1YyQ3E","categoryId":"STUv7xDDUOWJ3Sx5-xHuL","title":"The Lampers","body":"A heresy of the lower warrens, tolerated because it is poor. Lampers keep Lampfast when the Lamp is in the sky, and say that the city's comfort was bought with something the founders sent away: *The Lamp comes round, the debt comes due.*","tags":["The Siege","religion"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793092623226,"updatedAt":1793092623226},{"id":"3bebizXSamy8g91ekrlV0","worldId":"qazoRpRKLPklIu-1YyQ3E","categoryId":"oz95rVCVAOZT-qD4lJbnY","title":"The Throat and the lanes","body":"Lanes are tunnels in the way space is folded, opening at points of balance near large masses. A lane is held open at each end by an **anchor**; without its anchor a lane goes raw — tidal, unpredictable — and over decades it closes. Lanes also heal, very slowly, if nothing collapses them again.","tags":["setting"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793092623226,"updatedAt":1793092623226},{"id":"A2hfVncqiPjdkVLDB39Cq","worldId":"qazoRpRKLPklIu-1YyQ3E","categoryId":"STUv7xDDUOWJ3Sx5-xHuL","title":"Shared and unshared","body":"A **Share** is a hereditary right in the city: a vote, a seat in the nave, and air without tithe. About twelve thousand people hold one. The other hundred and seventy thousand — descendants of the Camp, of later settlers, of refugees from three wars — are **unshared**. They pay the air-tithe, measured and collected by **air-wardens**.","tags":["The Siege","debt"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793092623226,"updatedAt":1793092623226},{"id":"AR9ec9UM0sO1tp9IibKH-","worldId":"qazoRpRKLPklIu-1YyQ3E","categoryId":"hpXce9a4b1P9Zj8hzl0lk","title":"Tamsin's Rock","body":"A Combine mining station in another system. When its bonded struck in 2379, the factor used a Sanitation Agent. Four thousand people died in their bunks in one night shift; the machines never stopped. Within a year the Combine had resettled the station with new bonded and it was turning a profit.","tags":["The Bonded","company"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793092623226,"updatedAt":1793092623226},{"id":"AVKBBhQYYt4LcKiNX2AO-","worldId":"qazoRpRKLPklIu-1YyQ3E","categoryId":"BRR-Ae0z4irUPFqogAD-y","title":"The Lamp Hoard","body":"A dock legend of the Tarn Reach: that the founders of Corva hid their wealth on their comet, and that it comes back every time the Lamp does. Salvagers have been drinking to it for two hundred years. Nobody has been through the Corva lane in all that time to check.","tags":["The Last Return","legend"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793092623226,"updatedAt":1793092623226},{"id":"M1abKgDWWa28miQoK9Is6","worldId":"qazoRpRKLPklIu-1YyQ3E","categoryId":"BRR-Ae0z4irUPFqogAD-y","title":"The Roundsmen","body":"A faith carried out of Corva by dippers who left before its lane went dark. *What goes out comes back. Nothing is lost, only on its way.* Roundsmen keep a calendar of returns and say that the Lamp takes the dead out and brings them back.","tags":["The Last Return","religion"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793092623226,"updatedAt":1793092623226},{"id":"SNxUsQk0piEEXZ6rqB1UQ","worldId":"qazoRpRKLPklIu-1YyQ3E","categoryId":"3nJziH_uDmm3-3-E6ZE1R","title":"Dipping","body":"A skimmer like the **Patience** holds a high orbit over Gall and lets down a forty-kilometre carbon tether. On the end is the **Bucket**, a heat-shielded scoop that rides through the cloud-tops at orbital speed, swallowing gas. A dip lasts six hours; the line sings the whole time.\n\nThe **tether-chief** runs the drum, the reel-out, the tension and the release. **Runners** ride crawlers out along the line to clear ice and fix sensors. **Riggers** maintain the Bucket and the drum.\n\nThe **Sling** is a tether-chief's trick: spin the line with a craft on the end and let go at the exact moment, and you can throw something a very long way.\n\nDippers give their dead to Gall: the body is lowered on the line and released into the Deep.","tags":["The Bonded"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793092623226,"updatedAt":1793092623226},{"id":"_a8YZVw4ZHK5PScCMioa9","worldId":"qazoRpRKLPklIu-1YyQ3E","categoryId":"EYvK0QEzo3E4_kbY7zMc9","title":"The Concord of Vey","body":"A corporate-feudal power three lanes from Corva, built out of the bankrupt Halloran-Vey Combine and a dozen others. It holds its worlds by title, its crews by debt, and its fleets by the very old custom of paying the officers first.","tags":["The Siege"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793092623226,"updatedAt":1793092623226},{"id":"dUqQLZQugkfJ1_vXdMoJZ","worldId":"qazoRpRKLPklIu-1YyQ3E","categoryId":"BRR-Ae0z4irUPFqogAD-y","title":"Cinderhaven","body":"Ring-station of the Tarn Reach. Docks, debt-houses, repossession yards, chapels. Everything on Cinderhaven is owed to somebody, and the debt-houses keep their ledgers in stone vaults because the Directorate's courts burn so often.","tags":["The Last Return"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793092623226,"updatedAt":1793092623226},{"id":"gNEzGuPzJik6WB3PmFDwR","worldId":"qazoRpRKLPklIu-1YyQ3E","categoryId":"oz95rVCVAOZT-qD4lJbnY","title":"Corva and Gall","body":"**Corva** is a red dwarf at the dead end of a minor lane. Its one prize is **Gall**, a gas giant whose upper atmosphere is rich in deuterium and helium-three. Gall has eleven moons; only **Kettle**, a cracked ice shell over a black ocean, has ever held people.\n\nThe lane mouth, the **Throat**, opens near Gall's trailing Trojan point, so ships come out of the dark almost on top of the giant.\n\nGall's colours: ochre bands, bruise-purple storms, a white cap at the south pole. Dippers call its weather by the colour of the bruise.","tags":["setting"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793092623226,"updatedAt":1793092623226},{"id":"hy33iExUKTYSM_14sfTjv","worldId":"qazoRpRKLPklIu-1YyQ3E","categoryId":"STUv7xDDUOWJ3Sx5-xHuL","title":"The Purchase","body":"As taught in the shared schools of Patience: *In 2391 the Three Hundred of the Patience bought the ship and the Corva claim from the Halloran-Vey Combine for one share, and set it on Kettle. We bought our air.*\n\nEvery shared child can recite the catechism. The **Blank Share** — the scratched first line of the Share Plate — is said to be the Company's share, struck off when the Purchase was complete.","tags":["The Siege","civic myth"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793092623226,"updatedAt":1793092623226},{"id":"lVS3u4fLPQfjOcuwPBuJJ","worldId":"qazoRpRKLPklIu-1YyQ3E","categoryId":"STUv7xDDUOWJ3Sx5-xHuL","title":"The Spine","body":"The hull of the old skimmer stands upright in Kettle's ice, the spine of the city. Its drum hall is the Council nave; its cargo decks are the Archive; its old docks still open on a shaft to the surface. The Share Plate hangs in the nave.","tags":["The Siege"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793092623226,"updatedAt":1793092623226},{"id":"n7kmk746Jgi0tKxXEzVMC","worldId":"qazoRpRKLPklIu-1YyQ3E","categoryId":"3nJziH_uDmm3-3-E6ZE1R","title":"Bonded labour and the air-tithe","body":"A Halloran-Vey worker is **bonded**: their passage, food, suits and air are charged against them, and the debt passes to their children. The air-tithe is the line on the ledger that never goes away. A worker can be moved, sold or *relocated* with their debt; the debt is the Combine's property.","tags":["debt"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793092623226,"updatedAt":1793092623226},{"id":"pJFhMo_Rf6fiaa9zjt1Tx","worldId":"qazoRpRKLPklIu-1YyQ3E","categoryId":"hpXce9a4b1P9Zj8hzl0lk","title":"The Halloran-Vey Combine","body":"An extraction company of the twenty-fourth century: deuterium, ice, ore, people. It ran Corva for sixty years through a resident factor, a skimmer, a supply ship and a camp of two thousand families on Kettle. Its legal successor is the **Concord of Vey**.","tags":["The Bonded","company"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793092623226,"updatedAt":1793092623226},{"id":"tg_6rCwhwPtT9BGLfhcWi","worldId":"qazoRpRKLPklIu-1YyQ3E","categoryId":"hpXce9a4b1P9Zj8hzl0lk","title":"Sanitation Agents","body":"Combine designation for an engineered aerosol agent that attacks human neural tissue and nothing else. Victims go quiet and sleep within hours; hence the bonded name, **the Hush**. Supplied in a sealed ceramic egg kept below forty kelvin in a cryo-sleeve. The shell is fail-deadly: breached, or warmed past forty kelvin, it vents. The agent survives vacuum as dormant spores. It is destroyed only by sustained extreme pressure and heat together.","tags":["weapon"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793092623226,"updatedAt":1793092623226},{"id":"u5U2lSU9bIzzf-_GD9xZR","worldId":"qazoRpRKLPklIu-1YyQ3E","categoryId":"oz95rVCVAOZT-qD4lJbnY","title":"The Lamp","body":"Catalogued as **Ide's Comet** (first recorded 2128), called **the Lamp** by everyone who has ever lived under it. Its orbit is resonant with Gall: every two hundred and sixty-odd years it falls in from the dark, passes close by the giant at perihelion, and goes back out past the cold for two and a half centuries.\n\nRecorded perihelia: 2128, 2391, 2654, 2917.\n\nAt aphelion the Lamp's ice is under thirty kelvin. It is one of the coldest places a person could reach and still come back from — if they had the fuel to come back.","tags":["comet","cross-era"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null,"createdAt":1793092623226,"updatedAt":1793092623226}],"factions":[{"id":"1tcDVXFpjSGHXGkE47Ygs","worldId":"qazoRpRKLPklIu-1YyQ3E","name":"Crew of the Dray","description":"A salvage tug out of Cinderhaven, and the people who keep it in the black.","color":"#8b5cf6","coverImageId":null,"tags":["The Last Return"],"createdAt":1793092613302,"updatedAt":1793092613302},{"id":"4PWUQU6DSwkp_LSgCDmAH","worldId":"qazoRpRKLPklIu-1YyQ3E","name":"The Lampers","description":"A poor people's heresy of the lower warrens: the Lamp comes round, the debt comes due.","color":"#14b8a6","coverImageId":null,"tags":["The Siege","religious"],"createdAt":1793092613302,"updatedAt":1793092613302},{"id":"6_xqf9C__3qKp0FEkoENv","worldId":"qazoRpRKLPklIu-1YyQ3E","name":"The Bonded of the Patience","description":"The three hundred indentured crew of the skimmer Patience: riggers, runners, tether hands, medics, trusties.","color":"#f97316","coverImageId":null,"tags":["The Bonded"],"createdAt":1793092613302,"updatedAt":1793092613302},{"id":"AGid-aIBkHFWYAxMuC3CZ","worldId":"qazoRpRKLPklIu-1YyQ3E","name":"The Unshared","description":"Everyone else in Patience: a hundred and seventy thousand people who pay the air-tithe and have no vote.","color":"#22c55e","coverImageId":null,"tags":["The Siege"],"createdAt":1793092613302,"updatedAt":1793092613302},{"id":"TYFTp97xPK6DwG0HnA-at","worldId":"qazoRpRKLPklIu-1YyQ3E","name":"The Concord of Vey","description":"A corporate-feudal power that bought up the dead Combine's claims, and has come to collect Corva.","color":"#3b82f6","coverImageId":null,"tags":["The Siege"],"createdAt":1793092613302,"updatedAt":1793092613302},{"id":"YMuW24fICl0FcYnfnOXtf","worldId":"qazoRpRKLPklIu-1YyQ3E","name":"The Tarn Directorate","description":"The government of the Tarn Reach, such as it is: forty years of emergency powers and a navy that cannot pay its crews.","color":"#64748b","coverImageId":null,"tags":["The Last Return"],"createdAt":1793092613302,"updatedAt":1793092613302},{"id":"cGfer388aKJ5MqqT4z3eP","worldId":"qazoRpRKLPklIu-1YyQ3E","name":"Szabo's House","description":"Mother Szabo's counting-house on Cinderhaven: debts bought, bonds held, ships repossessed.","color":"#ec4899","coverImageId":null,"tags":["The Last Return"],"createdAt":1793092613302,"updatedAt":1793092613302},{"id":"lNqfh7Vr1BohSi0ATJPtV","worldId":"qazoRpRKLPklIu-1YyQ3E","name":"The Roundsmen","description":"A faith of the dipper diaspora: what goes out comes back; nothing is lost, only on its way.","color":"#a16207","coverImageId":null,"tags":["The Last Return","religious"],"createdAt":1793092613302,"updatedAt":1793092613302},{"id":"ramBjrydIp88FQt0Rqn-g","worldId":"qazoRpRKLPklIu-1YyQ3E","name":"Halloran-Vey Combine","description":"The company that owns the Corva operation, its ships, its air, and the debts of everyone who breathes it.","color":"#ef4444","coverImageId":null,"tags":["The Bonded","company"],"createdAt":1793092613302,"updatedAt":1793092613302},{"id":"ygs6GRPB1GWDLg6kvFbf0","worldId":"qazoRpRKLPklIu-1YyQ3E","name":"The Shareholders","description":"The shared families of the city of Patience, who hold the Shares, the vote and the air rights by descent from the Three Hundred.","color":"#eab308","coverImageId":null,"tags":["The Siege"],"createdAt":1793092613302,"updatedAt":1793092613302}],"factionMemberships":[{"id":"7WS1Aund4I-RWZfNRVqGk","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"AGid-aIBkHFWYAxMuC3CZ","characterId":"jBsMQnxLBcZH1iyd6QULx","role":"Air-warden","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"B9s3SSoM_TSVkXnvKUMYC","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"AGid-aIBkHFWYAxMuC3CZ","characterId":"fJjoCNwIiKNSC90-YAJ0M","role":null,"startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"BXSwkYsraBI2ePUGarVyx","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"6_xqf9C__3qKp0FEkoENv","characterId":"P0QOGj-k7ijtAa43xafP3","role":"Chief warden","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"GL2BfyWoaTGhPW-lekb1q","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"ygs6GRPB1GWDLg6kvFbf0","characterId":"30F7q1i2sIwHw4pCvLZ0l","role":"First Shareholder","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"HwTH_7zrgWqZDq4ODRFZe","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"ygs6GRPB1GWDLg6kvFbf0","characterId":"iKuErqTrS1waoTJ_wqWo4","role":"Archivist","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"JjAjfLhqTiVdJMcSElFQv","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"AGid-aIBkHFWYAxMuC3CZ","characterId":"3R7R2sIeO9NEfLc-kXNBD","role":null,"startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"KFLZ6NhhIQDnV_PXPrkxP","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"ramBjrydIp88FQt0Rqn-g","characterId":"XfU-bCjePHgt2UqnJ_Dmb","role":"Captain, Admonition","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"Py0ndKDauRa_18kXPFNjp","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"TYFTp97xPK6DwG0HnA-at","characterId":"8cB3jrjfoG67DI_gcDFup","role":"Lieutenant","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"RiHlHrUqNz9D7iEFI5l68","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"4PWUQU6DSwkp_LSgCDmAH","characterId":"BWv9X2DJVsUM9_cYB8nmH","role":null,"startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"SAH050uWkSYn0NdC_083X","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"6_xqf9C__3qKp0FEkoENv","characterId":"nPW9L6MCe5XhH8kibwAJT","role":"Medic","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"TmvAYX3efM1CHkNqxAMDK","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"cGfer388aKJ5MqqT4z3eP","characterId":"63DoU2dDLxWj32EVVqicW","role":"Bonded clerk","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"W0C6I1lIO9Yr8YBXrFSQU","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"1tcDVXFpjSGHXGkE47Ygs","characterId":"7uAqOYc-4fgdZRkVVqvyq","role":"Engineer","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"YHgcnjuXj2VRpRREjzVY0","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"AGid-aIBkHFWYAxMuC3CZ","characterId":"BWv9X2DJVsUM9_cYB8nmH","role":"Rigger","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"_QvRXrPa6wNvde0uTsLJ9","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"6_xqf9C__3qKp0FEkoENv","characterId":"vKXlNOjX8xtSpUZiQ81q8","role":"Trusty","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"bL4rrme9WrATVxnE_gvk5","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"6_xqf9C__3qKp0FEkoENv","characterId":"jmbAXO38b1gm_pdxz69KG","role":"Rigger","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"iWVMUSdJOB8_l5CoqgcMH","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"lNqfh7Vr1BohSi0ATJPtV","characterId":"7uAqOYc-4fgdZRkVVqvyq","role":null,"startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"jWAv1mt-A4QaKmtsE1lFj","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"6_xqf9C__3qKp0FEkoENv","characterId":"W7RM_wucwxJNFn7_wDQ5U","role":"Elder","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"kgPNK85a8kaUinmKYP0uX","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"6_xqf9C__3qKp0FEkoENv","characterId":"aE1q6lwq3aKIEZsxYRiSi","role":"Rigger","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"lnz6394kmQLtxo-RiN4l8","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"ramBjrydIp88FQt0Rqn-g","characterId":"mLpvcQPj-Bo65mvtW4T5L","role":"Sergeant of marines","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"mN6QGIJAtoJ0JETOYVGX4","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"6_xqf9C__3qKp0FEkoENv","characterId":"NzpTETix1qHfkVk8GdUiW","role":"Runner","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"mZfty4shytFq8Pk5HA8V-","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"6_xqf9C__3qKp0FEkoENv","characterId":"1LES0QB1fovVBe_mxEF9-","role":"Runner","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"qhh3knpADzgeqg8rb8lrz","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"ygs6GRPB1GWDLg6kvFbf0","characterId":"SLv4Xt1XcyIiAez88Ba50","role":"Pilot","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"sL9NvSJxneJmz711pFQPE","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"1tcDVXFpjSGHXGkE47Ygs","characterId":"LI6JgzRLnmepOH42AuZlN","role":"Captain","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"tcGHAOxXG0dqvp2lGHZYi","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"TYFTp97xPK6DwG0HnA-at","characterId":"9oc4cwEG3Gzt1Rf9mGOU8","role":"Commodore","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"uZ_w6AWxJ8Y40OdkKekJH","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"ramBjrydIp88FQt0Rqn-g","characterId":"Gcjl3v1bFg5LHEGAAgxK4","role":"Factor","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"xtzPWKSOpxoYGfmyJAcsA","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"cGfer388aKJ5MqqT4z3eP","characterId":"kIPNvz8mAaCNYGbid2mX2","role":"Mother","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"ysr6SzyOxbfHHQd-vOeun","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"6_xqf9C__3qKp0FEkoENv","characterId":"f5vdu9iWDF4RunSOdvhju","role":"Tether-chief","startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302},{"id":"zXAv5Ecv3QGcUksEduNze","worldId":"qazoRpRKLPklIu-1YyQ3E","factionId":"4PWUQU6DSwkp_LSgCDmAH","characterId":"3R7R2sIeO9NEfLc-kXNBD","role":null,"startEventId":null,"endEventId":null,"notes":"","createdAt":1793092613302,"updatedAt":1793092613302}],"factionRelationships":[],"knowledgeFacts":[],"knowledgeReveals":[],"characterGoals":[],"sceneTexts":[{"id":"5NTGuopQSbdHEomxhCY_3","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"dPv0KDauQh5ZZoazKYV2s","text":"They come out of the Corva lane on the twelfth of April at the fourth bell, ship's time, into a silence so complete that for a long moment Til thinks the board has failed.\n\nThe board hasn't failed. It's showing her exactly what's there. The glass has gone from grey to black, real black, star-black, with real stars in it, a great spilled field of them; and ahead and a little below, so close and so huge that her eye refuses it at first as a planet and reads it as a wall, there's Gall.\n\nShe has seen gas giants before. Every salvager has; the wreck-fields of the outer Reach are full of them, and the dead hulks always fall toward the big ones in the end. She has never seen one like this. Gall is close, the lane mouth hanging in the dark only a few hundred thousand kilometres off its trailing edge, and it fills a third of the sky: a vast striped curve of ochre and rust and old-bruise purple, banded like the grain in a slab of wood, with storms in the bands the size of worlds, turning. At its southern limb there's a white cap. Across its face, very small and very sharp, a moon throws a round black shadow. And above it, high on the left, laid across a quarter of the sky like a scarf thrown on a floor, is the Lamp.\n\nIt's enormous. That's what nobody tells you. In the Observatory's pictures it was a bright head and a long dim tail; out here it's a smear of pale green light as wide as Til's hand at arm's length, with a head that hurts to look at and a tail that goes on and on and on, splitting into two, three, four fainter streamers, fanning out across the stars until it's lost in them. It's so bright Gall's night side is faintly lit by it.\n\nNobody in the cockpit says anything for a while.\n\n\"Well,\" says Oz eventually, from the hatch. \"There it is.\"\n\nTil runs the board. She does it automatically, the way she would coming out of any lane: traffic, beacons, anchor station, comms. There's no traffic. There are no beacons. There's no anchor station where the anchor station should be, at the lane's mouth, only a faint scatter of radar returns drifting in a loose cloud, metal-sized, like the debris from something that once was there and isn't any more. Whatever held this throat open has been gone a long time. Comms are open on every band she's got, and every band is empty: hiss, and the low growling roar of Gall's radio belts, and under that nothing at all. No traffic control. No nav pings. No voices.\n\n\"Nobody home,\" says Juno quietly.\n\n\"Lanes go dark for a reason,\" says Til. \"Usually it's because nobody's left to keep them lit.\"\n\n\"It was a city once,\" says Oz. \"Kettle. My mother said. The ice moon. There was a city under the ice.\"\n\n\"Was or is?\"\n\n\"She didn't know. Nobody's been through in two hundred years and more. Nobody's said a word on the radio.\"\n\n\"Somebody'd say something,\" says Juno. \"If they were there. Wouldn't they? After two hundred years. If a ship came.\"\n\nNobody answers her.\n\nThe cradle is in the main cabin, aft of the cockpit, where there's room for it, clamped to the deck by its sled and plugged into the _Dray_'s power with a cable Oz rigged out of three adaptors and a prayer. When Til goes back, Hollis Vey is propped up on his pillows with the cradle's canopy slid back and his face turned to the cabin's only port. Cato Marchetti is sitting beside the cradle on a crate, very still, as he always is, with his hands on his knees.\n\nVey's face is wet.\n\nHe doesn't wipe it. He doesn't seem to know it's wet. He's looking at Gall, at the bruised bands and the white cap and the moon's small shadow crossing, and at the Lamp above it, and his face is a long thin yellowish wreck of a face with the tears running down it into the pillow, and he looks happier than Til has seen anybody look in years.\n\n\"Captain,\" he says. \"Look at it.\"\n\n\"I've looked.\"\n\n\"Five hundred years,\" says Hollis Vey. \"My family owned this. All of it. That planet. That moon. That sky.\" The thin voice through the speaker grille is shaking with something like laughter. \"Do you know, we never came? Not one of us. Not one Vey ever came to Corva. We owned it for sixty years and sent factors and took the money and never once came to look. And then we lost it, and spent five hundred years wondering how.\" He turns his head on the pillow. \"I'm the first Vey ever to see it. And the last. That's rather funny, isn't it?\"\n\n\"I wouldn't know, Mr Vey.\"\n\n\"No. You wouldn't.\" He smiles at her with his perfect too-large teeth. \"Sit down, Captain. I promised I'd tell you my business, when I could bear to. I can bear a little of it now.\"\n\nTil sits on the edge of the bunk across from him. Marchetti doesn't move. Through the hatch she can hear Juno and Oz in the cockpit talking in low voices; she can hear the _Dray_'s air plant coughing, the way it always coughs after a lane.\n\n\"My family's company was called Halloran-Vey,\" says Hollis. \"It was a combine of the old sort, in the old lanes, before the Concord swallowed it and before the Concord choked on it in its turn. It dug things out of places and sold them. Gas from giants. Ice from moons. Labour from people.\" He says it lightly. \"It held this system for sixty years. It ran a skimmer that dipped Gall for deuterium, and a camp of bonded workers on Kettle to refine what the skimmer brought up. And then, in twenty-three ninety-one, it lost it.\"\n\n\"Lost it how?\"\n\n\"That,\" says Hollis, \"is the question I've spent my life on. The records are very bad. The Combine had a habit, when something went wrong, of writing as little about it as possible. There's a register—a loss register, the Combine kept them for every operation—that says Corva was lost in that year, and that certain assets were not recovered. And then nothing. Two hundred and sixty years later the Concord came here to take it back, and the records of that are worse.\"\n\n\"Took it back from who?\"\n\n\"From whoever was here.\" He shrugs, a movement of one bony shoulder under the blanket. \"The Concord's archives are a midden. Half of them burned when it fell. I have spent a great deal of money buying the other half off the people who looted them, and they tell me almost nothing. That a fleet was sent. Whether it took anything back, or came back at all, they don't say.\" He looks back at the port, at the Lamp. \"And then, in the dock-houses of Tarn, this story. That the founders of Corva hid something on their comet. That it comes back.\"\n\n\"The Hoard.\"\n\n\"The Hoard.\" He smiles. \"You don't believe in it.\"\n\n\"I've bought two maps to it.\"\n\n\"So have I,\" says Hollis Vey. \"Eleven. All different. All forged.\" He closes his eyes for a moment, as if the talking has tired him. \"But my family lost something here, Captain. Something the register calls an asset not recovered. And the Lamp was in the sky the year they lost it. And it has come back only once since, and the Concord's fleet went to Corva that same year. And now it is coming back for the last time, because Gall is going to eat it.\" He opens his eyes. \"If you were me, and had three months to live, where would you look?\"\n\nTil doesn't answer. Beside her, very quietly, Cato Marchetti shifts his weight on the crate, the first movement she has seen him make.\n\n\"What's the asset?\" Til says. \"The one not recovered.\"\n\n\"The register doesn't say,\" says Hollis. \"It gives it a number. That's all.\"\n\nHe's lying. Til knows it the way she knows when a hull plate is about to go: by a change in the sound of things. It's not in his face, which is as open and amused and wrecked as before. It's in Marchetti, who has gone still again, still in a different way, the stillness of a man who has just heard his employer say something he was told not to say and is waiting to see whether anybody noticed.\n\n\"All right,\" says Til, and gets up. \"Get some rest, Mr Vey. We'll be at Gall in six days.\"","wordCount":1460,"createdAt":1793108733156,"updatedAt":1793108733156},{"id":"5dL7tEF8Onht1AMTFZ493","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"RS1ApLBHivNO7mZzHHK_D","text":"The runners lived aft of the drum, in a long low compartment the crew called the Shelf, where the bunks were stacked four high along both walls and the air came in through a single overworked fan that had been rattling since before any of them were born. Each runner had a bunk and a locker. When a runner went into Gall, the locker was emptied by the warden's office, and anything of value was sold against the account, and the rest went into the waste cycler. It had been three days. The warden's office had not got round to Lusine's yet. Maren had made sure of that, by giving Bram Kovač two dips' worth of overtime on the drum.\n\nOdile was sitting on her sister's bunk when Maren came in, with the locker open beside her and its contents laid out on the blanket in rows, as if for an inventory. A spare undersuit. A comb. A packet of the cheap dried fruit they sold in the Camp at Midwinter. A cloth bag of hair ties. A stack of letters from somebody in the Camp, tied with string. A small battered slate with a cracked screen. A carved wooden fish, no bigger than a thumb, very old.\n\n\"That was our mother's,\" Odile said, without looking up. \"The fish. She carved it. She used to carve things. She said she'd teach me but she didn't.\"\n\nMaren sat down on the bunk opposite. \"I'm sorry, Odile.\"\n\n\"You keep saying that.\"\n\n\"I keep meaning it.\"\n\nOdile picked up the fish and turned it over in her fingers. Her face was swollen and blotched and fierce, and she had not slept, by the look of her, since the dip; she had done her shifts anyway, both of them, on the line, at six kilometres, and run them clean, and Maren had watched her dot on the board and said nothing, because there was nothing to say to a runner who wanted to be on the line except _clamps on_.\n\n\"The warden came round,\" Odile said. \"Hale. Yesterday. With the form.\" She put the fish down in its place in the row. \"Said I'd got her account now. Said it was standard. Two hundred and eighty days, carried forward, at the standard rate. For her suit and her bottle and her beacon and the inspection on the crawler. He was very sorry.\"\n\n\"He's always very sorry.\"\n\n\"I said I'd pay it.\" Odile looked up at last. \"I said I'd pay it, Chief, because what else do you say? And he said that was very good of me and wrote it down. And then he said, was there anything of hers I'd found, any papers, any messages. For the inquiry.\" She was watching Maren's face. \"I said no. Because I hadn't looked yet.\"\n\n\"And now you have.\"\n\n\"And now I have.\"\n\nOdile reached under the pillow and brought out a strip of grey foil, the kind the relay printers used for hardcopy, folded small and soft with handling. She held it out.\n\n\"It was in her boot,\" she said. \"Her deck boot. The left one. Inside the liner, under the heel. She always kept her money there when we were kids, in case somebody went through her pockets. I knew where to look.\" Her mouth moved. \"Nobody else would.\"\n\nMaren unfolded the foil.\n\nIt was a relay transcript, printed in the cramped type the old relay printers used, and it had been printed by hand, one line at a time, as if somebody had been feeding the printer a little at a time so it wouldn't log a full job. It was headed with the Halloran-Vey wheel and a string of routing codes, and below the codes, a single block of text.\n\n_FROM: Combine Operations, Halloran. TO: Factor-designate A. QUIST, by beacon ahead of CLEMENT. SUBJECT: Consolidation of Corva Operation._\n\n_1. Corva Operation to close effective arrival of factor-designate. Operation no longer commercially viable following Sorrel price adjustment. Board resolution 2391/114 refers._\n\n_2. Skimmer PATIENCE to complete current season dips to maximise final load. Vessel to be decommissioned and scuttled in Gall at season end. Salvage value does not justify transit._\n\n_3. Skilled bonded (est. 300, PATIENCE complement) to be transferred with accounts aboard CLEMENT to Levy Office, Sorrel Station, for assignment under Combine-Levy labour agreement 2390/22. Transfer to be presented as relocation._\n\n_4. Kettle Camp installations and bonded accounts (est. 2,100 households) to remain in place. Supply to cease on departure of CLEMENT. Accounts to be offered at discount to secondary holders._\n\n_5. Factor to manage expectations. Contingency authority (Schedule H) confirmed. ADMONITION to follow as escort._\n\nMaren read it once, slowly, and then again. The fan rattled. Somewhere forward of the Shelf the drum was beginning its spin-up for the second dip, a long rising groan that came through the deck like a tide.\n\n\"What's the Levy,\" said Odile.\n\n\"The Levy Office is how the Combine rents bonded to the Sorrel lane forts,\" Maren said. Her own voice sounded strange to her. \"For the war. Diggers. Loaders. People to stand on gun-decks and fill sandbags with ice. They pay the Combine by the head. The Combine pays the bonded the standard rate against their account. Most of them never come back up the lane.\"\n\n\"And the Camp.\"\n\n\"_Supply to cease._\"\n\n\"What does that mean?\"\n\nMaren looked at her. Odile was nineteen. She had been born on Kettle, in the Camp, in the warrens of the third shaft, where her mother had carved fish and her father had died of the ice cough when she was two; she had never been anywhere else. She knew what supply meant. She was asking because she wanted somebody to say it so she would not have to.\n\n\"It means nobody's coming back,\" said Maren. \"It means the _Clement_ leaves and doesn't come again, and the Camp has what's in its tanks and its stores, and when that's gone, it's gone. The refinery runs on what the _Patience_ brings it, and the _Patience_ will be at the bottom of Gall. They'll have three months, maybe. Four, if they're careful. Then the air plant stops.\"\n\n\"Two thousand households.\"\n\n\"Twenty-one hundred.\"\n\n\"And then somebody buys their accounts,\" said Odile, very quietly. \"At a discount. Somebody buys the debts of dead people.\"\n\n\"Somebody always does.\"\n\nOdile put her face in her hands. She didn't cry. She sat there with her hands over her face and her shoulders very still, breathing, and after a while she said through her fingers, \"She told someone.\"\n\n\"She said so. On the line.\"\n\n\"She'd have told me. She told me everything. She didn't tell me this.\" Odile took her hands away. Her eyes were dry and terrible. \"She'd only not tell me if she was scared for me. If she'd told somebody else first and it had gone wrong. If she thought they'd—\" She stopped. \"Who'd she tell, Chief?\"\n\n\"I don't know.\"\n\n\"She'd have told someone she trusted. Someone she—\" Odile's mouth twisted. \"She was seeing somebody. The last couple of months. She wouldn't say who. She went all quiet and pleased about it, like when we were kids and she'd stolen something. I thought it was one of the dock boys.\"\n\n\"Was it?\"\n\n\"I don't know. She said—she said he was funny. She said he made her laugh in the lock.\" Odile looked at the rows of her sister's things on the blanket: the comb, the fruit, the fish. \"She said he was always in debt and he didn't care. She said it was restful.\"\n\nMaren's hands had gone very cold. She folded the foil up again along its old creases, small and soft, and held it.\n\n\"Keep this between us,\" she said. \"Not Hale. Not anyone. Not even the runners.\"\n\n\"Why?\"\n\n\"Because the last person who read it told somebody,\" said Maren, \"and she's in Gall.\"","wordCount":1312,"createdAt":1793093707674,"updatedAt":1793093707674},{"id":"6pcoeOW-DJv8IjOfKnFSx","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"LS-WCATxK-ii9d8z0nW04","text":"The Spine is the oldest thing in Patience and the only thing in it that was not built here.\n\nIt stands upright in the ice at the city's heart, two hundred metres of rust-red hull rising out of the lower warrens and up through every tier like the trunk of a tree up through the floors of a house. The founders sank it here, in the year of the Purchase, when they brought the old skimmer down out of Gall's sky and set it in Kettle's shell, and the city grew around it the way a pearl grows round grit. You can touch it on every tier. On the Ninth it comes through the floor of the South Market as a great curved wall with frost-flowers on it, and children lick the frost for luck. Inside it are the Council's chambers and the Archive and the old docks, and at the top, under the surface, the nave.\n\nThe nave was the drum hall of the ship, once. The drum is still there: a vast scarred cylinder lying on its side at the far end of the hall, as long as a street, with its ancient bearings seized solid and its skin covered from end to end in writing. Names. The founders' names, and the names of the dead before the founding, chalked by hand and then sealed under a skin of clear resin so that nothing would ever rub them off, layer on layer of capitals going brown with age. Nobody can read most of them any more; they are too old, too overwritten, too far up. Children are told they are the names of the Three Hundred. I have always liked one particular patch near the bottom, where somebody long ago drew, beside a name I could never make out, a small round shape with a tail. A seed with a tail. I didn't know what it was when I was little. I know now.\n\nAbove the drum, in the roof of the nave, is the Oculus. It's the only window in the city that looks at the sky. The founders cut it through forty metres of surface ice and lined it with a single great lens of fused glass, and for most of the year it shows you nothing but black and, if you're lucky, a slice of Gall going over like a striped wall. Today it shows the Lamp.\n\nI come in late, after shift, with my key still on my belt, and the nave is fuller than I have ever seen it. The shared families are on the floor, where the benches are, in their good coats; the unshared are packed into the side galleries and the stairwells and up on the old maintenance gantries, hanging on to the rails, standing on each other. The air is thick and warm with them. Everybody is looking up.\n\nIt is not what I expected. I suppose I expected a star. It's a smear: a smudge of pale light in the black, very slightly green, no bigger than a thumbnail at arm's length, with a long thin fan of fainter light stretching away from it toward the bottom of the lens, like breath going out of a mouth on a cold day. It doesn't twinkle. It doesn't move. It hangs there, very quiet, looking down at us through forty metres of ice, and the whole of the nave has gone still to look back at it.\n\nTwo hundred and sixty-three years. The last time it was in that sky, the founders were alive. They looked up at it from the deck of the old skimmer, in the year they bought their air. It was here when the city began, the catechism says. _The Lamp was in the sky in the year of the Purchase._ Every shared child learns that line, and most unshared ones, and none of us has ever seen the Lamp, until now.\n\nI find my mother on the east gallery, at the rail, near the top. She has come down from the Ninth with her neighbours in the morning to get a place, and stood all day for it, and she is grey with tiredness and with the cough, and she is looking up at the Oculus with her mouth a little open like a child's.\n\n\"You came,\" she says, when I put my arm through hers.\n\n\"I said I would.\"\n\n\"You've been on the Ninth.\" She can smell it on me; she can always smell it on me. She doesn't say anything else about it. My mother is a filter-mender, which is the kind of job the unshared do on the Ninth, sitting all day at a bench with a lamp and a pick, picking the sooted mesh of the warren fans clean enough to be used again. She's done it for forty years. She has the cough the filter-menders get, which is a dry deep bark that never quite goes, and she has my father's absence, and she has me, and she has her religion, which is the Lamp.\n\n\"Look at it, Isa,\" she says. \"Look. It's come round.\"\n\n\"I'm looking.\"\n\n\"Your grandmother's grandmother told her about it. And her grandmother told her. All the way back.\" Her eyes are wet. \"All the way back to the beginning. And now it's here. And we're here.\"\n\nMy mother is a Lamper. Not a loud one. She doesn't go to the meetings in the tannery yards on the Fifth or stand on the stairs with a placard; she doesn't tattoo comet-tails on her wrists, like the riggers do. She just believes, quietly, in her chair by her lamp, the thing the Lampers believe, which is that the city's comfort was bought with something, and that the something went out on the Lamp, and that it will come back. _The Lamp comes round,_ she used to say to me when I was small and couldn't sleep, _the debt comes due._ It was a lullaby to her. It took me until I was fifteen to understand that it was meant to be a threat.\n\nDown on the floor of the nave, the First Shareholder has climbed on to the old tether gallery to speak. Lucan Strand is a tall man with silver hair and a voice like a good instrument, the kind that doesn't need to be raised. He has his son with him. Corin Strand is the best pilot in the dipper fleet, everybody knows it; he flies the deep runs into Gall's cloud-tops that bring up the city's fuel, and he has the face for it, all cheekbones and confidence, and he stands at his father's shoulder in his flight jacket like the illustration in a schoolbook.\n\nBelow them, on its mount on the drum's end, is the Share Plate.\n\nIt's smaller than you'd think, the first time you see it. A rough rectangle of grey steel about the size of a door panel, cut from the old hull of the skimmer by somebody who did not have the right tools for it, its edges blackened and wavy. Three hundred names are cut into it, in fifteen columns, by three hundred different hands. Some are deep and neat; some are barely scratches. Some are just marks. The first line, at the top of the first column, is blank: not empty but scraped, a gouged and roughened patch of metal where something was once written and somebody took it off again. The Blank Share. Every child knows what it is. It is the Company's share, the one share the Halloran-Vey Combine kept in the ship when the Three Hundred bought her, and which was struck off the day the Purchase was complete. It's the most famous scratch in the world.\n\n\"Two hundred and sixty-three years ago,\" says Lucan Strand, in his good voice, \"that light was in this sky.\"\n\nHe doesn't need to raise it. The nave is silent.\n\n\"Two hundred and sixty-three years ago, three hundred men and women stood where I stand now, on the deck of this ship, and looked up at it, and made a decision. They decided that they would not be owned. They had nothing. They had a ship that was not theirs, and air that was not theirs, and lives that were written on somebody else's ledger. And they bought them back. Not with blood. Not with theft. With labour, and with bargaining, and with the long patience that gave this ship its name and this city its name. They bought their air.\" He lifts a hand toward the Plate. \"And here are their names.\"\n\n\"_We bought our air,_\" the floor says back, the shared families, in their good coats; and some of the galleries say it too, a little behind, the way you sing a hymn you don't quite know.\n\nMy mother doesn't say it. She is looking at the Lamp.\n\n\"Today,\" says Strand, \"the Lamp has come round again. It has come round to a city of a hundred and eighty thousand souls, where there was once a camp of two thousand. It has come round to deep docks and a dipper fleet and the finest refineries in eleven lanes. It has come round to a free people. If the founders could see us—\"\n\nSomebody near the top of the west gallery shouts something. I don't catch it. Heads turn. A second voice takes it up, and a third, ragged, from the stairwells on the north side where the riggers have crowded in: _The Lamp comes round, the debt comes due._\n\nStrand lets it go by. He is good at that. He waits with his hand still raised, mild, patient, until the wardens on the north stairs have moved in and the voices have stopped, and then he lowers it and smiles.\n\n\"There are always those,\" he says, \"who would rather the past were a debt than a gift. I don't blame them. It's a hard city to be poor in.\" A small murmur of approval from the benches. \"But it is the only free one there is. Happy Lampfast.\"\n\n\"Happy Lampfast,\" says the nave.\n\nAfterward, when the crowd is breaking up and the stairwells are jammed solid, I take my mother down the east gallery the long way, past the Archive doors, because it's quieter. Brother Malachy is in his doorway. He's always in his doorway on feast days, watching the crowds go by like an old crane watching a river. He taught me my letters on the Fourth Tier when I was six and my numbers when I was eight, and argued with me about everything from nine to fifteen, and then got me my warden's place on his own recommendation, which I've never decided whether to forgive. He's seventy-six. He looks a hundred, and has done for twenty years.\n\n\"Isaura,\" he says. \"Mistress Venn. You saw it?\"\n\n\"We saw it,\" says my mother.\n\n\"Remarkable thing.\" He turns his head and looks up the length of the nave at the Oculus, where the smudge of green light hangs. \"Do you know, they kept records of it? The founders. There's an orbit for it in the Archive, in somebody's hand, on the back of a dip log. They knew it would come round. They worked out to the week when.\" He smiles his thin smile. \"They knew more than we give them credit for. They were dippers. Dippers know about things that go out and come back.\"\n\n\"The Lamp takes the dead out,\" says my mother, softly, \"and brings them back.\"\n\nMalachy looks at her for a moment. \"So they say, on the Ninth,\" he says. \"So they say.\"","wordCount":1942,"createdAt":1793093337279,"updatedAt":1793093337279},{"id":"9C5QanYLYU0Pcc8qCWV7Z","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"ALXAay_3x_JubdjbjI_8s","text":"Under the drum there was a space nobody had ever found a use for.\n\nThe drum sat in a cradle of girders that went down through three decks to the keel, and between the girders, under the drum's great curved belly, the shipwrights had left a hollow the size of a chapel: a ribbed, dark, echoing void full of cable runs and bearing housings and old grease, where the noise of the drum when it was turning was so loud you could not hear your own voice, and when it was not turning, so quiet you could hear the hull tick. The crew called it the Belly. You got into it by a maintenance hatch behind the number four brake, and a ladder, and a long crawl on your hands and knees along a cable tray. Riggers went there to sleep off shifts and to do things they did not want logged. Wardens did not go there, because wardens were big men and the cable tray was narrow.\n\nMaren called the meeting for the fourth bell of the night, in the dead hour between dips, when the drum was still.\n\nEleven of them came. She had asked for twelve. They sat on the girders and the bearing housings in a rough ring, with one lamp turned low on the deck plates between them, and their faces came and went in its light: Teska, wrapped in two coats, with her white eye shining; Odile, very upright, very quiet; Danek Sorell, too big for the space, folded up on a girder with his knees under his chin; old Pirro from the Bucket crew; two dock hands, a married pair called Senna and Ivo, who between them knew every valve on the forward collar; three riggers Maren trusted and two she trusted less, because you needed the ones who talked as well as the ones who didn't. Ekene was not there. She had not asked him. A free man could be hanged for what the bonded only had their accounts reviewed for.\n\nAbel was not there either. She had asked him. He had said yes, and smiled, and not come.\n\n\"Read it,\" said Teska. \"Read the paper. I want to hear it in my own ears.\"\n\nMaren read it. She read it in the tether-chief's voice, without any expression at all, every line, the routing codes and the board resolution and the numbers, _est. 300_, _est. 2,100 households_, _supply to cease_. When she had finished nobody said anything for a long time. Somewhere in the hull below them a pump came on and ran and went off again.\n\n\"Sorrel,\" said Danek at last, in the same voice he had used in the hall. \"The forts.\"\n\n\"The forts.\"\n\n\"And the Camp.\"\n\n\"Three months. Four if they're careful.\"\n\n\"Tamar's got the cough already. She had it last winter.\" Danek looked at his own big hands. \"Four months she won't make.\"\n\n\"Nobody'll make it,\" said Pirro. \"Not the old ones. Not the little ones. The plant'll go first, then the heat. You'll have people burning their bunks.\" He spat into the dark. \"I was in the Camp when the third shaft caved in sixty-eight. We were nine days without the plant. I saw what nine days did.\"\n\n\"So we don't go,\" said Senna, from the dock. \"We refuse. Strike. They can't move three hundred people on to the _Clement_ if three hundred people won't walk.\"\n\n\"They can if they've got sticks.\"\n\n\"They've got six marines and a dozen trusties. We're three hundred.\"\n\n\"And the _Admonition_,\" said Maren. \"Two weeks behind the factor. Sixty marines and a torpedo bay. Due on the twenty-second.\" She looked round the ring. \"And then they don't need us to walk.\"\n\n\"Then we take the ship,\" said Teska.\n\nThey all looked at her. She was sitting hunched on her bearing housing in her two coats, very small, with her good eye glittering in the lamp.\n\n\"We take her,\" she said. \"She's ours. We built her. Well, they built her, but we've had her sixty years; we've kept her flying when they wouldn't send the parts. Every bolt in her's been turned by one of us. We take her and we don't sink her. We keep dipping. We keep the Camp breathing.\" She shrugged inside the coats. \"Let the Combine come and get her.\"\n\n\"The Combine will,\" said Maren.\n\n\"Then we'll be dead in a month instead of four. I'm eighty-three. I can spare a month.\"\n\n\"Danek's children can't.\"\n\n\"Danek's children,\" said Teska, with great gentleness, \"are going to die on the ice anyway, Maren. That paper says so. All you're doing is choosing which way.\"\n\nNobody said anything to that.\n\nMaren had known it was coming. She had known since the night in the Shelf, with the foil in her hand and Odile's face in front of her, that it would come to this: a ring of tired people in the dark under the drum, with nothing in front of them but a wall, and somebody saying the thing out loud. She had spent four days running the arithmetic, in the gallery, at the board, in Ekene's bunk with her eyes open. It came out the same every time. Strike, and they would be broken. Comply, and the Camp would die. Fight, and the _Admonition_ would come, and then the Camp would die and so would they.\n\n\"If we take her,\" she said, \"we have to take the _Clement_ too. Same night. Same hour. Otherwise the factor gets on her and casts off and he's two weeks from the _Admonition_ and he tells them everything. And the _Clement_'s got the marines, and the marines have guns.\"\n\n\"How many?\"\n\n\"Six. Sergeant called Oyelowo. They're good. They're not like the trusties. They've done this before.\"\n\n\"We'll need sticks,\" said a voice from the dark at the edge of the ring. \"At least.\"\n\nThe lamp didn't reach where it came from. It didn't need to. Everybody knew that voice, soft and patient and reasonable, and the ring went still the way a rigger goes still on the line when the trace jumps.\n\nCorwin Hale came forward into the light at his slow walk, ducking under a girder. Behind him, in the dark, Maren could see the shape of Bram Kovač crouched at the end of the cable tray, blocking it.\n\n\"I'm sorry to interrupt,\" said Hale. \"I didn't mean to listen. Sound carries in here. It's a terrible place for a secret.\"\n\n\"How did you get in?\" said Odile. \"The tray's too narrow for you.\"\n\n\"There's a hatch from the keel side, if you know where it is.\" Hale smiled faintly. \"I've been on this ship twenty years, Arda. I know where everything is.\" He looked round the ring. His eyes rested on each of them in turn, mild and unhurried, as if he were taking a register: Teska, Danek, Pirro, Senna, Ivo, the riggers. Last of all he looked at Maren. \"May I sit down?\"\n\nNobody answered. He sat anyway, on the end of Pirro's girder, so that the old man had to shift up.\n\n\"You've read the dispatch,\" he said. \"I know you have. Arda's sister had it in her boot. I've been waiting for you to do something about it.\" He folded his big hands on his knee. \"I'm on the list too, you know. I'm bonded. I've got an account. My mother's in the Camp, on the second shaft, and she's sixty-eight, and she doesn't have four months either.\" He looked at Danek. \"Trusties go to Sorrel with everybody else, Sorell. They don't need wardens on the forts. They've got officers for that. I'll be filling sandbags beside you.\"\n\n\"You'll be filling sandbags,\" said Teska, \"when Gall freezes.\"\n\n\"Grandam,\" said Hale, \"I know what you think of me. I know what you all think of me. You think I'm the Combine's dog. You're right. I've been the Combine's dog for twenty years, because the Combine fed me.\" He opened his hands. \"The Combine's stopped feeding me. That's all. I'd like to eat.\"\n\n\"What are you offering?\" said Maren.\n\n\"Twelve trusties with sticks. The keys to the bridge and the armoury, such as it is. Two old flechette carbines that the Combine forgot it issued. And the warden's office, which means the logs, which means that whatever happens, the Combine won't hear about it from this ship until we want it to.\" He met her eyes. \"And me. Who knows where everything is.\"\n\nMaren looked at him. She thought of Lusine's voice on channel four. _I told someone._ She thought of Quist across Moberly's desk, turning his coffee cup: _I'd look at who on this ship would have wanted the Combine to be grateful to them._ She thought of the form on Hale's slate, already filled in, in his neat hand, before she ever came down the gallery ladder.\n\nShe thought of six marines with guns.\n\n\"What's Schedule H?\" she said.\n\nHale blinked. \"I'm sorry?\"\n\n\"In the dispatch. Paragraph five. _Contingency authority, Schedule H, confirmed._ What's Schedule H?\"\n\n\"I've no idea,\" said Hale. \"Factors' business. I'm a warden.\" He shrugged. \"Contingency means _if things go wrong_. I expect it means the _Admonition_.\"\n\nHe said it easily. Maren watched him say it. She could not tell. She had been watching Hale for twenty years, and she had never once been able to tell what was behind that mild patient face, and she could not tell now.\n\n\"We'll think about your offer,\" she said.\n\n\"Don't think too long,\" said Hale, getting up. \"The twenty-second isn't far.\" He looked round the ring once more, taking his register. \"And none of you need worry about me. I can keep a secret. I've kept a great many.\" He ducked back under the girder into the dark, and they heard him go, slow and heavy, toward his hatch in the keel; and after a moment Bram Kovač's shape at the end of the cable tray went too.\n\nThe ring sat in silence.\n\n\"Well,\" said Pirro. \"Now we have to.\"","wordCount":1671,"createdAt":1793108902654,"updatedAt":1793108902654},{"id":"9fLzG69gUrEjkEP5RDYRe","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"pCAUFmAksTJpzvZJ8CLyF","text":"I don't get to the Archive that night. At the eighth bell, as I'm coming off shift, the city's guns open up for the first time in the siege.\n\nI didn't know we had guns. I don't think most people did. There are batteries, it turns out, in old pits on the surface ice around the city, built a hundred years ago in some war scare that never came to anything and maintained ever since by a few dozen shared families who have the right to do it the way other shared families have the right to the dipper fleet. They've waited eighteen days. Now, all at once, they fire, and the whole city hears them: a sound like heavy doors being slammed, very fast, one after another, coming down through the ice.\n\nEverybody stops in the corridors and looks up.\n\nThe word comes down the speakers a few minutes later, crackling and excited. A Concord lander has come down low over the south ice, probing, the first time any of Grieve's ships has come close enough to touch, and the batteries have hit it. It's down. It's on the ice south of the city, a kilometre from South Lock. All damage-control parties to South Lock. All air-wardens with surface rating to South Lock.\n\nI have surface rating. All wardens do; we read the meters on the intakes. I go.\n\nSouth Lock is a vast old chamber cut in the ice at the bottom of a sloping ramp, with the surface doors at its top end and a long low gallery down one side where the suits hang on their racks like a row of hanged men. When I get there it's already full of people. Damage-control crews in orange. Wardens in grey. Militia in their blue armbands with their old rifles. And riggers, a lot of riggers, the big tattooed men and women of the dipper fleet, who've been grounded eighteen days by the Council's order and have nothing to do and are in the mood for something to do it to.\n\nThe doors are open when I get there. The lock's cycled. A team in surface suits has gone out across the ice on a crawler and is coming back, and on the big screen over the gallery we can all see the feed from the crawler's lamps: white ice, black sky, Gall's banded edge on the horizon, and a long smear of wreckage going away across the snow, burning green and orange where its fuel has caught. In the middle of the wreckage, something moving.\n\n\"There's one alive,\" someone says.\n\n\"Not for long.\"\n\nThe crawler comes back down the ramp with the outer doors grinding shut behind it, ice streaming off its tracks. The lock cycles. When the inner doors open, the crowd surges forward, and I'm pushed forward with it, and I see the damage-control crew climbing down off the crawler's bed with a body between them in a scorched white Concord pressure suit.\n\nThey put it down on the floor of the lock. The suit's helmet is cracked across the visor. There's frost on the inside of the crack. The figure inside it moves its hands, weakly, at the clasps of the helmet, as if it wants to get it off.\n\n\"Leave it,\" says somebody. \"It's on its own air.\"\n\n\"Its air's gone,\" says one of the damage-control crew, a woman with a burned face, crouching by the helmet. \"Tank's holed. It's breathing what's left in the suit.\" She looks up. \"Maybe ten minutes.\"\n\n\"Then leave it ten minutes,\" says a rigger at the front of the crowd, a huge man with comet-tails tattooed up both forearms, and there's a growl of agreement behind him. \"Let it breathe what's left. That's what they're doing to us.\"\n\n\"Put it out on the ice.\"\n\n\"Let it have the floor.\"\n\nThat gets a laugh, an ugly one. It goes round the lock like a wave. _Let it have the floor._ The Concord pilot's hands have stopped moving at the clasps. They lie on its chest. Through the cracked visor I can see a face, very young, very pale, with its eyes open, looking up at all of us.\n\nI'm not brave. I want to say that clearly, as I said the other thing clearly before. What I do next isn't brave. It's habit. I'm an air-warden. I have spent twelve years kneeling beside meters, and what I'm looking at is a meter reading red.\n\nI push through to the front, and kneel down beside the burned-faced woman, and take the spare bottle off my own belt. Every warden carries a spare, a little twenty-minute flask with a universal coupling, for when we're out on the intakes. I find the suit's emergency port under the left armpit, where every suit in eleven lanes has had it since before the founding, and I knock the frost off it with my glove and screw the coupling in, and open the valve.\n\nThe suit hisses. The frost on the inside of the visor starts, very slowly, to clear.\n\n\"What are you doing?\" says the tattooed rigger.\n\n\"Reading a meter,\" I say.\n\nThere is a silence in the lock. I can feel it on the back of my neck, a hundred people looking at me. I don't look round. I watch the frost clear on the visor, and the young pale face behind it blink, and its lips move.\n\n\"Warden,\" says the rigger, in a voice I don't like.\n\n\"It's my air,\" I say. \"It's on my account. If you want to take it off me, you'll have to take it off me.\"\n\nNobody moves. I don't know what would have happened next. I don't know, to this day, whether they would have; I think perhaps they would. But the militia have got to the front by then, three of them with rifles and blue armbands and an officer with a whistle, and the officer is shouting that the prisoner is the property of the Council and anybody who lays a hand on him will be on the floor for a year. The crowd backs off, growling. The burned-faced woman helps me get the cracked helmet off. Underneath it the pilot is a man, young, younger than me, with a soldier's cropped fair hair and a soldier's frightened eyes, and a smear of blood under his nose.\n\nHe looks at me. He breathes. It's the first thing I ever hear him do.\n\n\"Thank you,\" he says, in the clipped accent of the inner lanes.\n\n\"Don't,\" I say. \"It's on your account.\"\n\nThe militia take him. They lift him on to a stretcher and carry him up the ramp toward the inner city, and the officer with the whistle tells me to report to the Wardens' Office in the morning with my bottle receipt, and goes after them. The crowd breaks up, slowly, sullenly, back to whatever it was doing. The tattooed rigger stands looking at me a while longer and then goes. I'm left kneeling on the wet ice floor of the lock with my empty bottle in my hand.\n\nSomebody crouches down beside me. A woman, a rigger, forty-odd, small and wiry, with her sleeves rolled up over forearms tattooed from wrist to elbow with the long thin fans of comets, one inside another, like the rings in a tree.\n\n\"You gave him your air, warden,\" she says.\n\n\"I gave him a bottle.\"\n\n\"That's a first.\" She looks at me with a sort of amused curiosity, as if I were a dog that had started to talk. \"Twelve years I've lived on the Ninth North and I never once saw a warden give anybody air.\"\n\n\"It's not a warden's job to give air.\"\n\n\"No,\" she agrees. \"It's not.\" She stands up and dusts off her knees. \"I'm Dasha. Dasha Imre. Rigger. Grounded.\" She holds out her hand to pull me up. \"You want to be careful, warden. Giving people things. It gets to be a habit.\"\n\nI let her pull me up. \"Isaura,\" I say. \"Venn.\"\n\n\"I know who you are,\" says Dasha Imre. \"Everybody on the Ninth knows who you are.\" She grins, quite friendly. \"That's why it's a first.\"\n\nWhen I get back to my room on the Fourth it's past the tenth bell, and there's a message waiting on my wrist. It's from the Archive. It's very short, in Malachy's old-fashioned way, the way he used to write notes in the margins of my exercises when I was ten.\n\n_Isaura. There's writing under the paint. Come tomorrow. Come alone. M._","wordCount":1431,"createdAt":1793093847538,"updatedAt":1793109049528},{"id":"AZIPbSt5mGoRUXzZwaNab","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"gYfNTHPof9Kwag2-mRaAj","text":"Nine days after South Lock, the Wardens' Office takes me off the Ninth.\n\nI'm called in to see my section chief, a weary shared woman named Paske who has been running the South wardens since before I joined, and who looks at me across her desk with the expression of somebody who has been given a problem she didn't ask for. I'm not being disciplined, she says. Nobody's filed a complaint. The bottle's been paid for out of the Office budget; the militia were very grateful; there's even a commendation, which she pushes across the desk to me on a slip of foil. But there's been talk on the Ninth. About a warden giving away air to a Concord pilot while the Ninth's own children are on the floor. And there have been, Paske says delicately, incidents. A warden on the Ninth North had his ledger taken off him on the stairs and thrown down a shaft. Another had her valve key bent. It would be better for everybody, Paske says, if I were somewhere else for a while.\n\nSomewhere else is the Cells.\n\nThe Cells are under the Spine, below the Archive, below the old docks, in what was once the skimmer's keel: a long dim corridor of steel boxes, each with a door and a grille and a meter. In peacetime they hold drunks and thieves and the occasional unshared rioter. Now, eight days into July and twenty-eight days into the siege, they hold a few dozen of each and one Concord lieutenant. Somebody has to read the meters. That's me.\n\nIt's quiet work. It's almost restful, after the Ninth. The prisoners are on a fixed allowance set by the Council, a little above the old floor, and nobody pays tithe, so nobody falls into arrears, so nobody has to be cut. I walk the corridor twice a shift with my gauge and read each meter aloud into the ledger and check the seals on the doors, and the prisoners mostly ignore me. Some swear. One old man on the end, a tannery thief from the Fifth, asks me every shift whether the Lamp's still in the sky, and I tell him yes, and he says _good_, and turns over.\n\nThe lieutenant's cell is the eleventh.\n\n\"Ebb, Mattias,\" I say to my ledger, on the first morning, outside his grille. \"Concord Lane Service. Allowance three-twenty an hour. Draw this cycle, three-oh-five.\" I look through the grille. \"You're breathing light, Lieutenant.\"\n\nHe's sitting on his bunk with his back against the wall and his knees up, in a grey prison smock with the sleeves too short, his cropped fair hair grown out a little into a pale fuzz. The bruising on his face has gone yellow. He looks up when I speak, and I see him recognise me, and something complicated happens in his face.\n\n\"I was told to,\" he says. \"In training. _In captivity, conserve._ Every ration. Breathe slow, move slow, sleep a lot.\" He shrugs. \"I'm very good at sleeping.\"\n\n\"You don't have to conserve here. It's your allowance. It doesn't go back in the tank if you don't use it.\"\n\n\"Doesn't it?\"\n\n\"No. It's just wasted.\"\n\nHe thinks about this with a sort of grave interest. \"That's very inefficient.\"\n\n\"Welcome to Patience,\" I say, and go on to the twelfth.\n\nHe's there on the second day, and the third, and every day after, and after the third day we talk. Not much. A few minutes, across the grille, while I take the reading and check the seal. It isn't permitted, exactly. It isn't forbidden either; nobody's thought to forbid it, because nobody's imagined a warden would want to. I'm not sure I want to. But he's the only person in the city who knows less about it than I do, and there's a strange relief in that.\n\nHis name is Mattias. He's twenty-four. He comes from a world called Corran, three lanes in, an old Concord holding where everybody works in the canneries. His father owed the Concord a great deal of money for something to do with a fishing boat that sank, and when his father died the debt came down to Mattias, and the Concord, which is efficient, offered him the choice of the canneries for forty years or the Lane Service for twelve. He chose the Lane Service. He's done four years of the twelve. He flies landers. He was flying a lander over Kettle's south ice on the thirtieth of June, on a probe, because his captain wanted to see whether the city had any guns, and the city did.\n\n\"That's what it's like everywhere,\" he says, on the fifth day, when I tell him about the floor. \"The Concord. The tithe, the floor. They don't call it that. They call it _allocation_. But it's the same.\" He looks at me through the grille with his frightened soldier's eyes, which are, I've decided, not frightened at all, only very tired. \"You'd think you'd be different here. You threw the Company out. Didn't you? You bought your own air. That's what they told us in the briefings. _The occupiers claim to have purchased the claim._ And then you went and did the same thing to each other.\"\n\n\"We didn't do anything. I wasn't born.\"\n\n\"No. Nor was I.\" He leans his head back against the wall. \"Nobody's ever born when it happens. Have you noticed? It's always already happened.\"\n\nOn the sixth day he asks me why I gave him the bottle.\n\n\"It's my job,\" I say.\n\n\"It isn't, though. Is it? Your job's taking it away.\" He says it without any edge. \"The militia officer told me. On the stretcher, when he thought I couldn't hear. He said, _that's the warden from the Ninth, she's cut more air than the plague_. He was laughing.\"\n\nI look at the meter. Three-oh-eight.\n\n\"I don't know,\" I say, which is the truth.\n\n\"Well,\" says Mattias Ebb, after a while. \"Thank you anyway. Whatever it was.\"","wordCount":1000,"createdAt":1793109049066,"updatedAt":1793109049066},{"id":"DwDVbHQlPFzFjoig-6TwY","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"x7tlxjUOOrgkX4fQz1l3N","text":"On the second night out from the Throat, Til has the watch from the eighth bell to the twelfth, and Juno comes up at the ninth and sits in the second seat without being asked.\n\nShe doesn't say anything. She's in her undersuit and a borrowed jumper of Oz's that comes down to her knees, with her knees drawn up inside it and her arms round them, and she sits in the dark cockpit looking out at the Lamp. It's on their left now, high and enormous, and Gall is ahead and below, filling the lower glass with its slow bands. The _Dray_'s drive is running at a quarter, a low steady rumble aft. On the board, nothing moves.\n\nTil does the things you do on watch. She checks the core. She checks the air. She checks the course, which is a long falling curve toward Gall that will take them past the giant and use its gravity to swing them out to meet the Lamp's path; Oz's idea, an old dipper's trick he says his mother told him about. She checks the rear scope. Nothing behind them yet. She checks the comms. Hiss and the roar of the belts.\n\nAfter a long time, Juno says, \"Szabo says you cut her line.\"\n\nTil doesn't look round.\n\n\"On the Harrow,\" Juno says. \"My mother's line. She says when the hulk spun up and started dragging you both, you had a choice, and you cut her line to save yourself. She says that's why you went to the prison, after. For the job being illegal and for that.\" Her voice is very level. \"She says everybody on the Ring knows it.\"\n\n\"Everybody on the Ring knows a lot of things.\"\n\n\"Is it true?\"\n\nThe Lamp hangs in the glass. Til looks at it.\n\nThere are things she has said to herself about this moment, over eleven years. She has had a lot of time to say them: four years of it in the Directorate's yard at Cold Harbour, and seven since on the _Dray_, alone mostly, on long hauls. She has rehearsed what she would say if Juno ever asked. She had it worked out, at one point, very carefully. She can't remember any of it now.\n\n\"There was a hulk,\" she says. \"A big one. A Directorate ore carrier, dead forty years, out on the edge of the Harrow, where nobody's allowed to go. Your mother found it. She said there was a fortune in its tanks, and there was, if we could get it. It was a bad job. We knew it was a bad job. We went anyway, because we owed money, and because your mother never in her life saw a bad job she didn't want to go and look at.\" She stops. \"We got a line on to it. Both of us, on one line. And the hulk spun up. Something in its old stabilisers woke up, and it spun, and the line went round it, and it started winding us in.\"\n\nJuno says nothing.\n\n\"There was a knife,\" Til says. \"On the line. There's always a knife on the line. Whoever's nearest the hulk can cut. Your mother was nearest the hulk.\" She takes a breath. \"The line got cut. I came off and she didn't. The hulk took her in. I was picked up by a Directorate patrol eleven hours later with my air on red and they charged me with unlicensed salvage and I did four years in Cold Harbour.\" She looks at the board. \"And Szabo bought your mother's debts off the Harrow brokers and bought you with them, and you were six.\"\n\n\"Who cut the line?\"\n\n\"The line got cut, Juno.\"\n\n\"Who cut it?\"\n\nTil is silent.\n\n\"You won't say,\" says Juno.\n\n\"I've said what I've got to say.\"\n\n\"You've said _the line got cut_.\" Juno's voice is shaking now, just slightly, just at the edge. \"You've said it like it was weather. Like it just happened. Like nobody did it.\" She uncurls her legs and puts her feet on the deck. \"I was six. I waited for her at the dock for two days. Mother Szabo came and got me and said she'd gone round and she wasn't coming back, and said my aunt had cut the line. And then you came out of the prison and you never once came to see me. Not once. In seven years. You'd walk past the counting-house window. I saw you. I used to watch for you.\"\n\n\"I know.\"\n\n\"Then why?\"\n\nTil looks at her at last. In the dark of the cockpit, lit only by the board and the Lamp, Juno's face is her mother's face exactly, broad and stubborn and furious, with the straight black brows drawn down.\n\n\"Because you'd have asked me that,\" Til says. \"And I'd have said what I just said.\"\n\nJuno stares at her. Then she gets up, and goes out of the cockpit, and down the passage to the warm bunk aft of the galley, and Til hears the bunk curtain rattle shut.\n\nShe sits in the dark with the board.\n\nAt the eleventh bell the rear scope pings. Til looks. Far behind them, back at the Throat, where the lane's mouth is a faint distortion in the stars, something has come out of the fold: a long black hull with a ram bow, running dark, decelerating hard. She doesn't need the transponder. She knows the shape.\n\n\"Hello, Mother,\" she says to the glass.\n\nShe logs it, and turns back to the forward board, and that's when she sees the other thing.\n\nIt's very small. It's almost nothing. A single pulse on the radar warning, a bright green flick in the corner of the board, there and gone in half a second: somebody, somewhere ahead, has painted the _Dray_ with a ranging radar. One sweep. Then nothing. The warning light goes back to dark.\n\nTil sits very still.\n\nShe runs the bearing. It's ahead and a little below, toward Gall. Toward the small white moon whose shadow she has been watching cross the giant's face for two days: a cracked white ball, very bright against the bands, that Oz's mother called Kettle.\n\nShe watches the board for the rest of her watch. The pulse doesn't come again. Comms stay empty, hiss and the roar of the belts. Nobody calls. Nobody says a word.\n\nIt could be automatic. Old systems run for a long time. A radar left on in some dead station under the ice, sweeping the sky for two centuries out of habit, the way a dead man's heart sometimes twitches on a slab.\n\nWhen Oz comes up at the twelfth bell to relieve her, she tells him about the _Carrion Hymn_. She doesn't tell him about the pulse. She isn't sure why. She lies in her bunk afterward with her eyes open in the dark and thinks about it: one sweep, from a moon where nobody has said a word in two hundred years. One look.\n\nAs if somebody down there had raised their head, and seen them, and put it down again.\n","wordCount":1188,"createdAt":1793108733005,"updatedAt":1793108733005},{"id":"ErXfSuY6Q5fS86Qpr4Aue","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"4o9wIgMKQw51k3u75zn2x","text":"That afternoon Malachy sends for me again, and when I get to the Archive, the First Shareholder is there.\n\nHe's standing at the end of Malachy's big table with his hands behind his back, looking down at the Plate under its lamps, and he doesn't turn round when I come in. Two of his stewards wait by the door. Malachy, at the table, gives me a look over the top of his magnifier that I've known since I was eight years old, the look that means _say nothing, you'll only make it worse_.\n\nTen days of solvent have cleared a long strip down the left side of the Plate's back, about the width of my hand, from the top almost to the bottom. In the strip, the scratched figures go down in a column, with their letters beside them. Six lines. Below the six lines, a gap, and then more scratches, different, less regular, still half under the paint. The rest of the Plate is grey.\n\n\"Come in, warden,\" says Lucan Strand. \"The Archivist tells me you were the first to see this. When it fell.\"\n\n\"Yes, First Shareholder.\"\n\n\"And you've said nothing to anyone.\"\n\n\"No, First Shareholder.\"\n\n\"Good.\" He turns his head and looks at me, and smiles a little, his tired silver smile. \"Brother Malachy has been telling me what he thinks it is. I'd like you to hear it. Since you were there at the beginning.\" He nods to the old man. \"Go on, Brother.\"\n\nMalachy straightens up. He doesn't push the magnifier up this time; he takes it off altogether and lays it on the table, which with Malachy means that he's about to say something he's sure of.\n\n\"They're orbital elements,\" he says. \"Six of them. Semi-major axis, eccentricity, inclination, the longitude of the node, the argument of perihelion, and a time.\" He touches the air above each line with his brush. \"That's how dippers wrote down an orbit. They had to know about orbits to do their work, much better than we do; they lived in them. These are in the old dippers' notation, with the old dippers' units. Whoever scratched this knew exactly what they were doing.\"\n\n\"An orbit of what?\" says Strand.\n\n\"Something long,\" says Malachy. \"And very eccentric. Something that goes a very long way out and comes back.\" He purses his lips. \"I'd need to run the figures to be sure, and I can't run them yet. There's a time on the last line, the time of perihelion, and it's under a flaw in the steel. Somebody's awl slipped.\"\n\nStrand is quiet for a moment.\n\n\"And the rest?\" He nods at the half-cleared scratches below the gap. \"There's more. Writing?\"\n\n\"Letters, yes. Words, I think. I haven't got to them.\" Malachy picks up his magnifier again and turns it over in his fingers. \"Another week. Perhaps two. The paint's very hard in the middle.\"\n\n\"Faster, Brother.\"\n\n\"If I go faster I'll take the words off with the paint.\"\n\n\"Then don't go faster,\" says Strand mildly. \"But don't go slower.\" He comes round the end of the table and looks down at the strip of scratched figures for a long moment, and I see his face in the lamplight and I see something in it I've never seen in it before: not the warmth he wears in the nave or the patience he wears on the speakers, but hunger, plain and sharp, like a man looking at a meal.\n\n\"The founders wrote this,\" he says softly. \"On the Plate. And then they hid it.\"\n\n\"Somebody did,\" says Malachy.\n\n\"The founders,\" Strand says again, as if correcting him. He looks up. \"Do you know what reserve stood at this morning, Brother? Fifty-two days. Grieve's slugs took out the third intake on the far ice last night. Fifty-two. A month ago it was ninety-four.\" He's not raising his voice; he never raises his voice. \"The Council meets tomorrow. If the reserve falls below twenty days, we will have to consider measures. Measures nobody in this city wants to consider. Do you understand me?\"\n\n\"I understand you,\" says Malachy.\n\n\"Then you understand why I want to know what the founders thought was worth hiding.\" Strand straightens his coat. \"Nobody sees this but the three of us. Not the Council. Not my son. When you have the words, you send for me first. Before anyone.\" He turns to me. \"And you, warden. Not a word. Not to your mother. Not to the Ninth. If this city ever needed its founders, it needs them now, and I won't have them turned into a Lamper rumour on the stairs.\" He smiles. \"Do you understand?\"\n\n\"Yes, First Shareholder.\"\n\n\"Good,\" he says, and goes out with his stewards.\n\nWhen the door's barred behind him, Malachy sits down heavily on his stool and puts his face in his hands. He sits like that for a long time.\n\n\"_Measures_,\" he says at last, through his fingers.\n\n\"What measures?\"\n\nHe takes his hands away and looks at me. \"You've been a warden twelve years, Isaura,\" he says. \"You know what a city does when it runs short of air. You've done it on a small scale every day of your working life. Think about it on a large one.\"\n\nI think about it.\n\nI think about the floor, and the doors on the Ninth, and the grandmother under her three blankets with her hands folded. I think about a hundred and seventy thousand unshared and twelve thousand shared, and a reserve going down like a needle on a meter. And I understand what he means, all at once, the way you understand the cold when you step out of a lock, and I sit down too, on the bench by the door, and for a while neither of us says anything at all.","wordCount":971,"createdAt":1793109048898,"updatedAt":1793109048898},{"id":"ICe1rm_i476mD1FFZZPS-","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"QYbiLGRHHmNTeGgXwRKNz","text":"The _Clement_ came in at the end of second shift, out of the black on the Kettle side, a long dull hull with the Halloran-Vey wheel painted on her flank in green, and mated to the _Patience_'s forward collar with a bang that went through every deck. She was the supply ship. Four times a year she came up from the Throat, the lane mouth that hung in the dark behind Gall, with spare parts and medicines and new bonded and the Combine's paper, and went back with deuterium. She was eleven days early. Everyone knew she was eleven days early. Nobody knew why.\n\nThe factor came aboard at the change of shift, when he could address both watches at once, and he addressed them in the drum hall, under Teska's chalk.\n\nHe was not what Maren had expected. The last factor had been a fat cheerful thief called Moberly who had sold the infirmary's painkillers to the Camp and been recalled for it. This one was tall and spare and grey, fifty or a little past it, in a plain dark coat with the green wheel on the lapel and nothing else to say he was anyone. He had a long face, lined in the wrong places for a man who smiled. He stood on the drum gallery with Hale on one side of him and a marine sergeant on the other, a stocky woman in Combine grey with a sidearm, and he looked down at three hundred tired bonded and waited for them to stop talking. It took a while. He waited without impatience.\n\n\"My name is Aurelian Quist,\" he said, when they had. \"I'm the Combine's factor for Corva, from today. I've been told there was a death on the line this morning. I'm sorry for it.\"\n\nHe said it as if he were. That was the first thing Maren noticed about him: that he said things as if he meant them, and it made the hall uneasy, because no factor in living memory had meant anything.\n\n\"I won't keep you,\" Quist said. \"You've had a long day and a bad one. I'll say only this. The Combine has been reviewing the Corva operation, as it reviews all its operations from time to time. That review is now complete. There will be changes. In the next few days I'll be speaking to the chiefs and the wardens about what those changes mean for each of you, and I'll speak to all of you again before the end of the month. Until then, the dips go on as before. Thank you.\"\n\nThat was all. He turned and went down the gallery steps with the sergeant behind him, and Hale stood a moment longer looking out at the hall, and then followed.\n\nThe hall was very quiet.\n\n\"Changes,\" said Danek Sorell, at last, beside Maren. \"What's that mean, changes?\"\n\n\"It means changes,\" Maren said.\n\n\"Good changes or bad changes?\"\n\nShe looked at him. Danek had been on the line eleven years. He had a wife in the Camp and three children and a laugh you could hear from the slot, and he was asking her what kind of changes the Combine made, as if there had ever been more than one kind.\n\n\"Go and get some sleep, Danek,\" she said.","wordCount":551,"createdAt":1793092951827,"updatedAt":1793092951827},{"id":"Jr_l4lLX1NEbGAeBUaB3U","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"RFT6G4FNS54zhyGZcdLp7","text":"The Roundsmen keep a chapel at the end of every dock on Cinderhaven, because Roundsmen are dock people, and dock people die.\n\nThe one on Dock Nine is a converted lock, a round steel room with a domed ceiling and the old outer hatch welded shut and painted over with stars. There are benches. There's a little brazier in the middle, kept going day and night by whoever's nearest, with a dish of salt beside it. Round the walls, in chalk, the Roundsmen write the names of the dead and the dates they went out, and under each name a little loop, a circle not quite closed, which is the sign for _on its way_. Some of the loops are fifty years old. Some are from last week. Til knows eleven of the names on these walls personally, and one of them very well, and she does not look at that one.\n\nOz is sitting on the front bench with his hands in the salt.\n\n\"I heard,\" he says, without turning round.\n\n\"Everybody on the Ring heard. Szabo's clerks have mouths.\"\n\n\"Corva.\" Oz rubs the salt between his fingers and lets it fall into the brazier, where it spits blue. He is a big man gone soft and grey, with a face like a bag of stones and the most delicate hands Til has ever seen, an engineer's hands, an instrument-maker's; he's been her engineer for nine years and her friend for thirty, and he has followed her into places no sane man would go and out of them again, and he has never once said _I told you so_, which is the only reason she still speaks to him. \"The Lamp's going round. They're saying it's the last time. They're saying Gall's going to eat it.\"\n\n\"Who's saying?\"\n\n\"Everybody who reads the Observatory sheets. Which is me and four old Roundsmen and a boy who sweeps the observatory. It's coming in too close this time. Inside the giant's reach. It'll come apart.\" He lets the last of the salt fall. \"The Lamp takes the dead out and brings them back. That's the saying. Nobody ever said what happens when it doesn't come back.\"\n\n\"I don't need a sermon, Oz.\"\n\n\"You're getting one anyway. I'm sixty-three. I've earned it.\" He wipes his hands on his knees and turns round on the bench. \"Are you going to do it?\"\n\n\"I'm going to hear the man out.\"\n\n\"That's yes.\"\n\n\"That's hear the man out.\"\n\n\"That's yes,\" says Oz, comfortably, and turns back to his brazier.\n\nThe agent arrives on the second bell exactly. He comes in from the dock side, ducking under the lintel, and stops just inside the door to let his eyes adjust; and Til, who has spent her whole life around men who are dangerous, files him immediately and without effort in the drawer where she keeps the worst of them. He's not big. He's not anything much. Forty, perhaps, slender, in a good grey coat with the collar turned up, close-cropped hair going silver at the sides, and a long pale scar running down from his left ear into his collar like a seam in a glove. He has a quiet, courteous, attentive face. He stands very still. That's the thing. Most people fidget when they come into a chapel, out of reverence or embarrassment. He stands like a man who has been taught that the first person to move is the first person to be seen.\n\n\"Captain Brask,\" he says. \"My name is Cato Marchetti. I represent Mr Hollis Vey. Thank you for coming.\"\n\n\"I haven't said yes.\"\n\n\"No. Of course.\" He comes and sits on the bench across the brazier from her, and nods to Oz, who nods back. \"Mother Szabo will have told you the terms.\"\n\n\"She told me the money. She didn't tell me the job.\"\n\n\"The job is a retrieval.\" Marchetti puts his hands on his knees. \"You know of the comet the Corva people call the Lamp.\"\n\n\"Everybody on Dock Nine knows about the Lamp. Half the drunks on this dock have a map to the Lamp Hoard. I've bought two.\"\n\n\"Then you know the legend.\" He doesn't smile. \"The Lamp is a periodic comet in a resonant orbit with Corva's gas giant. It comes in every two hundred and sixty-odd years, passes close by the giant, and goes back out. Last year the Tarn Observatory sent a probe through the Corva lane, which had just reopened, and the probe came back with its pictures, which is more than the crews of the two ships that followed it did.\" He reaches into his coat and brings out a slim grey slate and lays it on the bench between them. On the screen is a smear of light: a bright head, a long dim tail. \"The Lamp is inbound now. It reaches the giant on the second of May. This time it will pass inside the giant's limit. It will be torn apart, and what's left of it will fall into Gall's atmosphere, and it will be gone.\"\n\n\"So I hear.\"\n\n\"Mr Vey believes there is something on the Lamp,\" says Marchetti, \"that belongs to his family. He would like it retrieved before the second of May.\"\n\n\"What is it?\"\n\n\"I don't know exactly.\"\n\n\"You don't know.\"\n\n\"Mr Vey's family were—are—an old one. They had interests in Corva a very long time ago. They lost something there, in the Corva system, in a way that has never been fully explained, and Mr Vey has spent a large part of his life and most of his fortune trying to understand what. He believes it went out on the Lamp. He believes this is the last chance anyone will ever have to bring it back. He is\"—Marchetti chooses the word—\"devoted to the question.\"\n\n\"He's mad.\"\n\n\"He's dying,\" says Marchetti, without any change in his voice. \"It amounts to much the same thing, in my experience. He has perhaps three months. He would like to be there.\"\n\nTil looks at him. \"He wants to come?\"\n\n\"He insists on it. He'll travel in his own medical cradle, with his own supplies; he won't be a burden on your ship. I will accompany him.\" Marchetti turns the slate off and puts it away. \"You'll take us through the lane, Captain. You'll take us to the Lamp, using whatever approach you judge best. You'll land, and assist Mr Vey—assist me—in locating and recovering whatever is there. And you'll bring us home. Thirty thousand marks. Ten in hand.\"\n\n\"And if there's nothing there?\"\n\n\"Then you'll have been paid ten thousand marks to fly a dying man to look at a comet. Many people would consider that a fair day's work.\"\n\nOz makes a sound into the brazier that might be a laugh.\n\n\"Szabo wants her girl aboard,\" Til says. \"That's the deal, she said. One of her people, to witness.\"\n\n\"So I'm told.\"\n\n\"Which one?\"\n\nMarchetti considers her for a moment with his quiet, attentive face.\n\n\"I believe,\" he says, \"she means to send your niece.\"\n\nTil had known that. She had known it from the moment Szabo said _your sister's girl_, the way you know you've stepped on a loose plate on a hull a half-second before it goes. It doesn't help. She sits with her hands on her knees and looks at the brazier and the salt and the loops on the walls, the circles not quite closed, and one name in particular that she is not looking at, three rows up on the left.\n\n\"Mother Szabo,\" says Marchetti, \"has a sense of humour.\"\n\n\"Mother Szabo,\" says Til, \"has a sense of collateral.\"\n\nShe signs at the fourth bell. The ten thousand marks are in the Chandlers' by the fifth, and by the sixth eleven thousand two hundred of them are gone again, out through the Chandlers' wall and into the stone vault on the Ledger Ring, and the yard-master's seals are cancelled. That's what money is on Cinderhaven. You never touch it. It goes through you like weather.","wordCount":1341,"createdAt":1793093504547,"updatedAt":1793093504547},{"id":"UiMm6uqejfOc45wV-j3YS","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"Wbi4mI0MBR8muUBvh0QPA","text":"On the last round of my shift, at the tenth bell, I stop at the eleventh cell longer than I should.\n\nThe lieutenant's asleep, or pretending. He's lying on his back on the bunk with his arm over his eyes. I read his meter—three-one-nine, he's stopped conserving—and log it, and check the seal, and then I stand at the grille without moving on.\n\n\"You never told me,\" I say. \"Why you came.\"\n\nHe doesn't move his arm. \"I told you. I was flying a probe.\"\n\n\"Not you. The Concord. Thirty-eight ships, all the way out here to the end of the lanes, for a moon nobody's wanted in two hundred years. For a claim nobody's tried to collect since before your great-grandfather was born.\" The corridor's dim and cold and quiet, the tannery thief snoring at the far end. \"Grieve says the Concord holds the Combine's title. Fine. It's held it for a century. Why now?\"\n\nMattias lies still for a while. Then he takes his arm off his eyes and turns his head on the thin pillow and looks at me through the grille.\n\n\"For what's ours,\" he says. \"That's what they told us. _To recover the Concord's property._\"\n\n\"The city.\"\n\n\"The city. The claim. The accounts.\" He hesitates. \"And something else.\"\n\n\"What?\"\n\n\"I don't know.\" He sits up slowly, wincing at his ribs, and swings his feet down to the floor and sits on the edge of the bunk with his hands between his knees. \"I'm a lieutenant. They don't tell lieutenants things. But before we came through the Throat they briefed every lander crew in the fleet, all of us together, in the big bay on the _Steadfast_, and there was an officer from the Commodore's staff there, a commander I'd never seen before, and at the end of the briefing, after the guns and the pickets and the rules about civilians, he said there was one more thing.\" He looks at his hands. \"He said the Combine had lost something here. A long time ago. An item of Company property, never recovered. He said the Concord had reason to believe it was still in the system. He said if any of us, on any probe or landing, came across anything that looked like old Company equipment, anything at all, with the Combine's mark on it, we were to report it and not touch it.\" He looks up at me. \"And then he said, _and if you find it, you are not to open it. Under any circumstances. Not to look inside. Not to break the seal._ And then he said, _you'll know it if you see it._ And then he left.\"\n\n\"What does that mean?\"\n\n\"I've thought about it a lot,\" says Mattias Ebb. \"In here. I've had time.\" He's quiet for a moment. \"I think it means they're not afraid of you, warden. Not of your guns or your city or your Council. I think they're afraid of something your founders had.\" He lies back down on the bunk and puts his arm over his eyes again. \"Goodnight.\"\n\nI stand at the grille a while longer. Then I go on down the corridor to the end, where the tannery thief is snoring, and read his meter, and log it, and he wakes up and asks me if the Lamp's still in the sky.\n\n\"Yes,\" I say.\n\n\"Good,\" he says, and turns over.\n","wordCount":567,"createdAt":1793109048717,"updatedAt":1793109048717},{"id":"VeV93FTNeD8kK9fLQ9DuM","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"qQoei9_W8NJqwphn4YYw9","text":"\"They called it the Hush,\" Ekene said.\n\nIt was the fourth bell. The infirmary was dark except for the lamp on the counter, turned so low it was hardly more than a coal. Yusuf Brandt had been sent back to his own ship in the afternoon with his hand in a sling and a note to the factor. The bunks were empty. Ekene sat on the end of the nearest one with Maren beside him, both of them still in their clothes, and the cups of his smoked tea on the deck at their feet, cold.\n\n\"Not the Combine. The Combine calls it Sanitation Agent, Pattern H. The men who use it call it the Hush. Because that's what it does.\" He was looking at the port, where the Lamp hung over Gall's limb. \"Tamsin's Rock was an ice-mining station in the Penner lanes. Four thousand bonded. Families, mostly, three generations of them, because the Rock was old. In seventy-nine the price of ice dropped and the Combine cut the air ration, and the Rock struck. They locked out the factor and the wardens and they sat in their warrens and said they would not dig another metre until the ration came back. They were very orderly about it. They kept the plant running. They kept the infirmary open. They sent a petition to Halloran.\" He paused. \"The factor at the Rock had a Schedule H authority.\"\n\nMaren said nothing.\n\n\"It's an aerosol,\" said Ekene. \"That's all it is, in the end. An engineered thing, very small, that likes one sort of tissue and only that sort. Human nerve. Nothing else. Not rats, not plants, not machines. You let it into a habitat's air and the air system does the rest; it goes through every vent in an hour. It doesn't hurt. They told us that, after, the Combine's doctors, as if it were a kindness. You get tired. You get very quiet. People sat down where they were and went to sleep. In their bunks. At their tables. In the crèche.\" He swallowed. \"In six hours there was nobody awake on Tamsin's Rock. In ten there was nobody alive. And the plant ran on. And the lights. And the infirmary's machines went on monitoring the patients in the beds, beeping, for two days, until the power ran down.\"\n\n\"You were there.\"\n\n\"I was a contract medic in the Penner lanes. They sent four of us in, afterward, with a Combine sanitation crew, to certify. That was the word. Certify.\" He laughed, a terrible small sound. \"We had to go through every room. Every bunk. Every child. And write down the time we thought they'd died, so the Combine could close the accounts properly. It took us eleven days.\"\n\nThe Lamp hung in the port.\n\n\"The agent stays in the air for a few days and then it settles,\" Ekene said. \"It goes dormant, like a spore. The sanitation crew sealed the Rock and pumped it hard vacuum and baked it, and then they let it sit for a year. And then they shipped in four thousand new bonded from the Kessel yards and opened it up again and started digging.\" He looked at his hands. \"It was turning a profit inside eighteen months. They used it in the Combine's own reports. As an example of what could be achieved.\"\n\n\"Why didn't you stop?\" Maren said. \"Being a medic for them. After.\"\n\n\"I did. I came here.\" He turned and looked at her in the dark. \"I came to the end of the lanes, Maren, to the most worthless operation the Combine had, so that nothing like that could ever happen around me again. Because who'd waste a Pattern H on Corva? Who'd bother?\" His voice cracked. \"And now there's one on the other side of the collar. With your factor checking it every day.\"\n\n\"Why bring it?\" Maren said. \"If they're just leaving. If the Camp's going to die anyway. Why bring that?\"\n\n\"In case the leaving isn't quiet,\" said Ekene. \"Schedule H. Contingency. You saw the dispatch. _Factor to manage expectations._\" He took her hand. \"If we take the ship, Maren, they won't send the _Admonition_ to fight us. Why would they? The _Admonition_ is expensive. Marines are expensive. They'll just tell the factor to open the box. One cryostat. One key. And then they'll wait a year and send somebody else to dip Gall, if they ever want to dip Gall again. Or not. It doesn't matter to them. That's the point. It doesn't matter.\"\n\nMaren sat in the dark beside him with his cold hand in hers.\n\nShe thought of Quist in the doorway of the cold hold, with his hands in his pockets, looking. Every day. _Humour me, Sergeant._ She thought of the key at his throat.\n\nShe thought of the Belly, and the ring of tired faces in the lamplight, and Teska saying _We take her_. She thought of Hale's mild voice in the dark: _I'll be filling sandbags beside you_. She thought of eleven metres of hull with Gall underneath.\n\nShe did the arithmetic. It came out differently now. It came out, she realised, sitting there, with the Lamp brightening in the port and the egg asleep in its smoking foam across the collar, the only way it could have come out from the moment she bent over that frosted window and the old animal at the back of her skull told her to back away.\n\n\"We don't take the ship first,\" she said.\n\nEkene looked at her.\n\n\"We take the egg,\" said Maren Tsolo. \"Before anything. Before they know we're coming. We take the egg and the key, and then we see who wants to talk about Sorrel.\"\n","wordCount":956,"createdAt":1793108901798,"updatedAt":1793108901798},{"id":"VxZKZXm0lQIOEmTl5Zw-z","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"Rdc78akjjRk1ASWe826Nj","text":"They reeled Lusine's crawler up with the line.\n\nIt came in through the slot at the end of the dip, riding the braid into the drum like a beetle on a string, and the riggers stood back from it as if it were hot. It was not hot. It was rimed white from its long ride in the shadow, and its clamps were still locked, and its little green lights were still green, because nothing had ever been wrong with it. The harness strap that had held Lusine to it was still clipped to its saddle ring. The other end of the strap, where her harness should have been, hung loose.\n\nMaren went down the gallery ladder and across the floor and stood in front of it.\n\nNobody said anything. The floor was full of people. The off-shift had come in, and the galley hands, and riggers from the Bucket crews, and half of the dock section, so that the drum hall, which was the only room on the _Patience_ big enough to hold the whole crew, was holding most of it. The drum itself had stopped turning. Without its noise the hall sounded wrong, too large, full of small sounds: boots, breathing, the tick of the frost coming off the crawler as the warm air reached it.\n\n\"Get me a light,\" Maren said.\n\nDanek Sorell gave her his hand-lamp. Danek was the biggest rigger on the line, a man with hands like shovels who sang in the shower block and was not singing now. Maren crouched and put the light on the saddle ring.\n\nThe clip was a dog clip, the kind every runner wore: a hooked steel jaw with a spring-loaded gate, so that it could be snapped on to a ring one-handed in gloves. The gate was missing. The jaw was there, and the hinge pin, and the stub of the spring, but the gate itself had gone, and the spring stub ended in a face that was not torn. Steel that fails under shock tears. It goes ragged and grey and granular, like the inside of a broken biscuit. This was bright for two-thirds of its width, a clean flat shine like the face of a coin, and only the last third was grey.\n\nMaren looked at it for a long moment. Then she unhooked the clip from the ring, closed her hand over it, and stood up.\n\n\"Gate failure,\" she said. \"Spring went.\"\n\n\"It was the shear,\" somebody said behind her. \"That shear was a bastard.\"\n\n\"It was the shear.\"\n\nOdile Arda had come in off the line twenty minutes after the end of the dip, stripped her suit in the lock without waiting for the dresser and walked into the drum hall in her undersuit, sweat-black down the spine, and now she was standing at the edge of the crowd with her arms wrapped around herself, staring at the crawler as if it might at any moment open and let her sister out. Grandam Teska was beside her. Teska was eighty-three and had been on the _Patience_ since the year it was towed in; she had one good eye and one milk-white one and she held Odile's elbow in a claw of a hand that was steadier than it looked.\n\n\"She's gone into Gall,\" said Teska, to no one in particular. \"Gall has her.\"\n\n\"Gall has her,\" the hall said back, the low ragged chorus, like a congregation that has forgotten what church it's in.\n\nThat was all the funeral a dipper got when the line took them. When you died on the ship there was a proper giving: the body was wrapped and walked down the line in a crawler and released at forty kilometres into the cloud, so that the Deep could have it. When the line took you, Gall had already done the taking. There was nothing to walk down. There was only the crawler coming home empty, and somebody chalking the name on the drum.\n\nTeska did the chalking. She had to be helped up the drum ladder to do it. The drum's outer skin was covered in names, layer on layer of them, the old ones rubbed back to ghosts by sixty years of hands and shoulders and the new ones bright: dates, names, sometimes a joke. GALL TOOK MY HUSBAND AND HE WASN'T EVEN GOOD. Teska wrote LUSINE ARDA 2391 in her slow shaking capitals and underneath it, after a moment's thought, a small round shape with a line trailing off it, like a seed with a tail.\n\n\"What's that?\" said one of the young riggers.\n\n\"That's the Lamp,\" said Teska. \"It's coming round. You'll see it in a week, if you go up the blister. It came round when my grandmother's grandmother was a girl and it'll come round when your grandchildren are dead. It goes out past the cold and it comes back. It takes the dead out with it and it brings them back.\"\n\n\"That's a story,\" said the rigger.\n\n\"Everything's a story,\" said Teska, climbing down. \"You're a story. You're a short one.\"\n\nSomebody laughed, the way you laugh at funerals. The hall began to break up into its small groups and its quiet talk. Maren stood by the crawler with the clip in her fist and watched the room.\n\nShe watched the riggers, who were looking at the floor. She watched the dock crew, who were looking at each other. She watched Odile, who was looking at nothing. And she watched her brother Abel, who had come across from the number three brake and was standing a little apart with a bulb of tea he was not drinking, his face greyish under the floodlights, and who, when he felt her looking, lifted the tea in a small salute and gave her the grin he had been giving her since he was four, the one that said _don't worry, it's me_; and then looked away, a fraction too soon.\n\n\"Chief Tsolo.\"\n\nThe voice came from behind her, and the hall, in its small way, went quiet again.\n\nCorwin Hale was the chief warden of the _Patience_. He was a bonded man like everyone else, born in the Camp, carrying a family account like everyone else; but he was a trusty, which meant that he had been given a shock-stick, a cabin to himself, a double air ration and the job of keeping the other bonded in order on the Combine's behalf, and in return the Combine took a little off his account every year and nobody liked him very much. He did not seem to need to be liked. He was a big, slow, patient man with a soft voice and a shaven head, and he carried a slate under his arm the way a priest carries a book.\n\n\"Warden.\"\n\n\"I'm sorry for your loss.\" He meant the crew. He said it to her because she was the chief. \"Arda was a good runner.\"\n\n\"She was.\"\n\n\"I'll need the incident report from you. And the dip log. I've filled in what I can.\" He held out the slate. \"Sign where it's marked.\"\n\nMaren took it. The form was already completed in Hale's neat hand. _Personnel loss, tether operations. Runner L. Arda. Cause: harness detachment during line oscillation; runner did not secure secondary lanyard per Standing Order 14._ Below that, the line items. _Personal beacon, lost. Suit, runner's, lost. Air, six hours, lost. Crawler, recovered, inspection and recertification._ Each with its figure. The total was transferred to Account ARDA, L., and since Account ARDA, L. had no further earning capacity, it had been carried forward, as the Combine's standing terms provided, to the next of kin. ARDA, O.\n\nMaren read it twice.\n\n\"She didn't have a secondary,\" she said. \"Nobody has a secondary. We haven't been issued secondary lanyards since before you came aboard. You know that.\"\n\n\"Standing Order 14 says a runner will secure a secondary lanyard.\"\n\n\"Standing Order 14 says a runner will be issued one.\"\n\n\"Then the shortfall is the Combine's,\" said Hale reasonably, \"and the factor can strike the line. He'll be aboard in an hour. You can raise it with him. In the meantime the form has to be filed with the dip, and the dip has to be filed before the _Clement_ docks, or the load goes unregistered and the whole crew gets docked a day.\" He paused. \"That would be a pity. Today.\"\n\nMaren looked at him. He looked back with his patient, mild, slightly sorrowful face, as if he too were a victim of the form.\n\nShe signed. Of course she signed. You signed, or the crew got docked a day, and a day's air-credit to a rigger with two children in the Camp was a week of thin meals. Hale took the slate back and tucked it under his arm.\n\n\"And the clip,\" he said. \"For the inspection.\"\n\n\"What clip?\"\n\n\"The harness clip. Arda's. It'll need to go to the factor's engineer with the crawler. For the report.\"\n\n\"Spring failed,\" Maren said. \"Gate's gone. It's in Gall with her.\"\n\nHale's eyes rested on her closed fist for a moment, and on her face, and then he nodded. \"I'll note that,\" he said, and went away across the hall with his slate, and Bram Kovač, the youngest and hardest of his trusties, peeled himself off the wall by the door and went after him.\n\nMaren put her fist in her pocket and left it there.","wordCount":1578,"createdAt":1793092951970,"updatedAt":1793092951970},{"id":"YyI7HarVAexkhffEsllTg","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"Y5mLotI0qYPgQJwuAUFUR","text":"The _Clement_'s crew were not bonded. They were Combine contract hands, hired for the run at Halloran, and they kept to their own ship mostly, and looked at the _Patience_'s bonded the way people look at animals in a pen: without malice, without much interest. But the _Clement_'s medic had been left at Halloran with a fever, and so when one of her cargo hands got his left hand caught in the closing door of a cold-hold hatch, on the morning of the eleventh, they brought him across the collar to Ekene.\n\nMaren heard about it from Ekene that evening. She came to the infirmary after the second dip and found him at the counter, not writing, sitting with his reading lenses in his hand and his face the colour of the counter.\n\n\"His name's Brandt,\" Ekene said. \"Yusuf Brandt. He's twenty-three. He's from Halloran, from the yards. He's never been out of the inner lanes before. He thinks Corva is the most boring place he has ever been in his life.\" He turned the lenses over. \"I had to take two fingers. The hatch was a cryo-hatch, the heavy kind, with the frost seals. It crushed them flat. So I gave him a lot of the good painkiller, which the Combine charges at nine marks a dose, and while I was working, he talked.\"\n\n\"What about?\"\n\n\"About his ship. About the cold hold. About how he's on cold-hold duty this run, which means checking the cryostats every four hours, and how it's the worst duty on the ship because the hold's at sixty below and the gloves are useless. About how there's nothing in the cold hold this run except the usual medical stocks and one other thing.\" Ekene put the lenses down on the counter, very carefully. \"About how the factor comes down to look at the other thing every day. Every single day. With the sergeant. And stands and looks at it. And how the hands call it the egg.\"\n\nMaren said nothing.\n\n\"I asked him what kind of egg,\" said Ekene. \"He laughed. He said a grey one, about this long\"—he held his hands apart, the length of a forearm and a half—\"in its own cryostat, with its own power and its own alarm, and a stencil on the casing that he'd read so many times on cold-hold duty he could say it in his sleep. And then he said it for me. In his sleep, nearly. The painkiller was very good.\" Ekene looked at her. \"_Sanitation Agent. Pattern H. Factor's authority only._\"\n\n\"Pattern H.\"\n\n\"Schedule H. Pattern H.\" His voice was steady and quite empty. \"I've seen that stencil before, Maren. I didn't think I'd ever see it again. I think I came to the end of the lanes so that I wouldn't.\"\n\n\"Tamsin's Rock,\" said Maren.\n\nHe closed his eyes.\n\n\"Tell me,\" she said.\n\n\"Not here.\" He opened them again and looked toward the curtained bay where Yusuf Brandt was asleep, two fingers lighter, dreaming his painkiller dreams of Halloran. \"Not tonight. I need to know you've seen it first. I need to know I'm not a frightened old man hearing things in a boy's babbling.\" He put out his hand and took hers on the counter, hard, the way he never did, his long gentle fingers cold as the cold hold. \"If it's there, Maren, then everything you've been planning in the Belly is something else. Everything. Do you understand? You can't take a ship with that thing on the other end of the collar. You can't do anything.\"\n\n\"I can look at it,\" said Maren.","wordCount":603,"createdAt":1793108902471,"updatedAt":1793108902471},{"id":"f4av5a387KA9NmCsbUJWs","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"0T46v5SbLeM2hWt1bnUYG","text":"She found Abel at the third bell of the night, in the blister.\n\nThe blister was a dome of thick old glass on the _Patience_'s dorsal hull, a relic of the days when skimmers had carried passengers who wanted to look at things. It was cold, and badly lit, and the crew used it for courting and drinking and the kind of conversations that couldn't be had anywhere else, and nobody ever cleaned it. Abel was sitting on the floor with his back against the frame and a bottle of dock-still between his knees, looking up. He didn't turn round when she came in. He held the bottle up over his shoulder.\n\nShe took it, and drank, and gave it back, and sat down beside him.\n\nAbove them, through the scratched glass, Gall filled half the sky, ochre and purple, a storm the size of a world turning slowly on its southern limb. Above the storm, in the black, the Lamp hung like a thumbprint of light. It was brighter than it had been three days ago. You could see the tail properly now, a long faint fan of pale green going away from the sun, so delicate that if you looked straight at it it disappeared, and came back when you looked to the side.\n\n\"Teska says it takes the dead out,\" said Abel.\n\n\"Teska says a lot of things.\"\n\n\"She says it'll be back when our grandchildren are dead.\" He drank. \"That's a long time to be a comet.\"\n\n\"It's not a long time for a comet.\"\n\n\"No.\" He laughed a little. \"I suppose not.\" He held the bottle up to the glass and looked at the Lamp through it, through the cloudy brown spirit, so that it wobbled. \"I keep thinking about her. Lusine. Out there. Going in.\"\n\n\"So do I.\"\n\n\"You talked to her. The whole way. I heard you.\" He lowered the bottle. \"That was a good thing you did, Mar.\"\n\n\"I didn't do anything.\"\n\n\"You did, though.\" He turned his head and looked at her for the first time. His face was grey and his eyes were wet and red-rimmed, and she could not tell how much of it was the still. \"You always think you didn't do anything. You do more than anybody.\"\n\nShe looked at him for a long moment, at his handsome tired face in the Gall-light, her brother, whom she had carried on her hip through the third shaft when their mother went into the cloud.\n\n\"Were you seeing her, Abel?\"\n\nHe didn't move. He didn't look away. But she had known him all his life, and she saw the small thing happen behind his eyes, the thing that happened when he was eight and she asked him who had got into the dried fruit, the half-second of arithmetic.\n\n\"Seeing her?\"\n\n\"Lusine. Odile says she was seeing somebody. Somebody funny. Somebody always in debt who didn't care.\"\n\nAbel laughed. It was almost his real laugh. \"That's half the riggers on the ship.\"\n\n\"Were you?\"\n\n\"We were friendly.\" He shrugged. \"A bit. Now and then. She was—she was good fun, Mar. She liked a joke. We'd have a drink in the lock after shift. It wasn't serious. She wasn't serious about anybody.\" He drank. \"Why?\"\n\n\"Did she tell you anything? Before she died? About the _Clement_? About a dispatch?\"\n\n\"A dispatch?\" He frowned. \"What dispatch?\"\n\n\"Did she?\"\n\n\"No.\" He shook his head. \"No. Why would she tell me about a dispatch? I'm a rigger. I can barely read the duty board.\" He smiled at her, the old smile, _don't worry, it's me_. \"What's this about?\"\n\nMaren looked at the Lamp.\n\n\"Nothing,\" she said. \"It's late. I'm tired.\"\n\n\"You're always tired.\"\n\n\"I'm always tired.\"\n\nHe put his arm around her shoulders, the way he used to when he was sixteen and had just grown taller than her and wanted her to know it, and she let him, and they sat together in the cold blister and looked at the comet. His arm was warm and heavy and familiar. His hand, where it hung over her shoulder, was shaking, very slightly, with a small fine tremor, the kind of tremor that a man gets when he has been drinking for three days because he cannot stop seeing something.\n\nShe did not say anything about it. She sat there in her brother's arm and looked at the Lamp and thought, very clearly, _he's lying to me_, and then, because she was the tether-chief and that was what tether-chiefs did, she began to do the arithmetic.","wordCount":761,"createdAt":1793093706963,"updatedAt":1793108902773},{"id":"fnNnNq_Eod5MWGg82eEKx","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"KUeDnmR-PMrQG7-kIhydF","text":"The infirmary was the one place on the _Patience_ that was ever warm. Ekene kept it that way on purpose, cooking the heat exchangers past their rating and fiddling the logs, because, he said, sick people healed better warm and well people talked more truthfully; and it was true that you heard things in the infirmary at night that you did not hear anywhere else on the ship. It was a narrow white room with eight bunks, a dispensary cage, a surgical bay behind a curtain, and a single round port the size of a dinner plate that looked out along the hull toward Gall's limb. Ekene had hung a dried flower in a bag over the port. Nobody knew where he had got a flower.\n\nHe was sitting at the dispensary counter when she came in, writing up the day by the light of a single lamp. He looked up, and took off his reading lenses, and looked at her for a long moment without saying anything. Then he got up and came round the counter and put his arms round her, and she stood in them with her face against the stiff cotton of his coat and her fist in her pocket and did not cry, because she had not cried in nine years and was not about to start now in front of a dispensary cage.\n\n\"I heard it,\" he said into her hair. \"Half the ship was on the line channel. I heard you talking to her.\"\n\n\"I didn't do anything.\"\n\n\"You talked to her.\"\n\n\"I couldn't do anything, Ekene. The Gull's thruster was stripped. It's been stripped three weeks. I put in for the part three times.\" She let go of him and stepped back. \"I ran the line. That's what I did. I sat there and ran the dip and I listened to her go.\"\n\n\"If you'd stopped the dip—\"\n\n\"If I'd stopped the dip the line would have walked and we'd have lost Odile as well. And the Bucket. And the drum, maybe. And they'd have docked the whole crew for the load.\" She sat down on the end of the nearest bunk. \"That's the arithmetic. I did the arithmetic.\"\n\nEkene went back behind the counter and filled two cups from the urn and brought them over. It was the infirmary's tea, which was not tea at all but something he grew in a tray under the ultraviolet lamp in the surgical bay and dried and smoked, and which tasted like a wet fire. She drank it. He sat beside her on the bunk. He was fifty-two, eleven years older than she was, a big soft-spoken man with grey in his beard and the long patient hands of somebody who had spent his life doing small things carefully to people in pain. He had come to Corva on a medical contract six years ago, not bonded, which made him a strange thing on the _Patience_, a free man who could have left on any _Clement_. He had not left. Maren had asked him why, once, and he had said that he was a coward and the Combine's other postings were worse; and then, later, in the dark, that it was her.\n\n\"The factor,\" he said.\n\n\"You saw him?\"\n\n\"He came by. Before the hall. He wanted to see the infirmary.\" Ekene turned his cup round in his hands. \"He asked about our stock of painkillers. How many beds. Whether we had a cold store and what was in it. He was polite. He asked very good questions.\"\n\n\"What kind of questions?\"\n\n\"The kind an auditor asks. What things cost. What could be moved.\" He looked at her sideways. \"What do you think _changes_ means, Maren?\"\n\n\"I think the _Clement_'s eleven days early,\" Maren said. \"I think nobody sends a new factor to a skimmer that's making its numbers just to say hello.\" She drank the rest of her cup in one swallow, burning her throat. \"And I think somebody cut Lusine's line.\"\n\nShe took her fist out of her pocket and opened it.\n\nEkene looked at the clip for a long time. Then he took it from her palm, gently, the way he took everything, and turned it under the lamp, and found the stub of the gate spring and the bright clean face of the cut, two-thirds of the way through.\n\n\"A blade,\" he said.\n\n\"A fine one. Not a cutter. Cutters crush. That's a saw cut, or a knife that's been honed. Somebody took that spring two-thirds through, so it'd hold in calm and go in the first hard shock.\" She heard her own voice, very level, the tether-chief's voice. \"Every runner checks her clip at the lock. You snap it, you load it, you look at the gate. You don't look at the spring. Nobody looks at the spring.\"\n\n\"Who could do this?\"\n\n\"Anybody who could get to her harness. Anybody in the runners' lock, between her last check yesterday and the dip. Riggers. Runners. Dock crew. Wardens.\" She stopped. \"Me.\"\n\n\"Not you.\"\n\n\"No. Not me.\" She took the clip back. \"She said something on the way down. On four, so it's not on the log. She said she'd read a dispatch on the relay, something that came ahead of the _Clement_ on the beacon. She said it was about all of us. She said she'd told someone, and she shouldn't have.\"\n\n\"Told who?\"\n\n\"She didn't say. She went into the static.\" Maren closed her hand on the clip again. \"She said, _I don't think it was the clip._\"\n\nThey sat for a while without talking. Through the port, over Ekene's shoulder, she could see the long curve of the _Patience_'s hull lit by Gall-shine, rust-coloured, and beyond it the edge of Gall itself, and beyond that the black. It took her a moment to see what she was looking at. There was a smudge in the black, just above the planet's limb: a faint pale patch no bigger than a thumbprint, like a breath on glass, with the barest suggestion of a tail.\n\n\"There it is,\" said Ekene, following her eyes. \"Teska's comet.\"\n\n\"The Lamp.\"\n\n\"She says it takes the dead out.\"\n\n\"She says a lot of things.\" Maren stood up. She was very tired. She put the clip back in her pocket and felt its small weight there, against her hip, where her line knife hung on her coat. \"I'm going to find out who she told.\"\n\n\"Maren.\"\n\n\"What.\"\n\n\"Be careful who you ask,\" said Ekene.","wordCount":1088,"createdAt":1793092951548,"updatedAt":1793093707848},{"id":"jW7hYTbl9oOTg2G5pznpP","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"q-1V9zRITnGXfozuTtKLu","text":"The _Clement_ was mated to the _Patience_ at the forward collar, a great ring of armoured coupling with its own lock and its own guard, and on the _Clement_'s side of the collar there was a marine on duty all day and all night. There was no going through the collar.\n\nThere was going round it.\n\n\"It's eleven metres,\" said Odile, in the suit lock on the forward hull, checking Maren's harness for the third time. \"Outside. Along the collar fairing, then down the _Clement_'s spine to her number two maintenance hatch, which opens from outside, because they always do, in case somebody's stuck in a hold. Senna says the hatch is never alarmed. Senna says nobody on the _Clement_ thinks anybody's mad enough to go outside.\"\n\n\"Senna's never been outside.\"\n\n\"Senna's never been mad.\" Odile snapped the last clip and pulled on it. \"We're runners, Chief. Eleven metres is nothing. Eleven metres is the length of the drum hall.\"\n\n\"Eleven metres with Gall underneath it.\"\n\n\"Gall's always underneath it.\" Odile looked at her through her visor, her young fierce face very pale in the lock lights. \"You were a runner. You told me. You did four years at twenty kilometres. Before Hesketh made you chief.\"\n\n\"I was younger.\"\n\n\"You were braver,\" said Odile, and opened the outer door.\n\nIt was the second bell of the night shift, the dead time, and the hull was dark. They went out on to it on their hands and knees, clipped to a running line that Odile had rigged the night before, along the dorsal fairing of the collar, where the two ships' hulls met in a seam of scarred armour. Above them, to the left, the black was full of stars and the Lamp, which had grown again, a long pale streamer of light now with its tail split in two. Below them, to the right, was Gall.\n\nMaren had not been outside the _Patience_ in nine years. She had forgotten. You forgot, on the gallery, with the board in front of you and the line a green trace on a screen. You forgot that the line was real, that it hung down out of the keel slot into that, into the endless ochre floor of the world, banded and boiling and so close it seemed you could reach down and put your hand in it. You forgot the size of it. Lusine had fallen into it from eleven kilometres. From here, Maren thought, holding the running line with both hands and not looking down, from here you would fall for a long time.\n\n\"Don't look at it, Chief,\" said Odile on the suit channel. \"Look at your hands.\"\n\n\"I know.\"\n\n\"I know you know.\"\n\nThey went along the collar fairing and down the _Clement_'s long dull spine, hand over hand, past the green wheel of the Combine painted twenty metres high on her flank and lit from below by Gall-shine, so that it looked like a rusted sun. The number two maintenance hatch was where Senna had said it would be, a square of grey armour set flush in the hull with a recessed handle and a stencil that said NO ENTRY EXCEPT IN EMERGENCY. It was not alarmed. Odile opened it, and they went in feet first, and pulled it to behind them.\n\nThe cold hold was very dark and very cold, so cold that the moment the inner door of the maintenance lock opened, Maren's visor frosted at the edges and her suit heaters came on with a whine. They switched their lamps on low.\n\nIt was a long low hold, ribbed like the inside of a fish, with racks of sealed medical crates along both sides under a rime of frost, and at the far end, by itself, in a clear space on the deck, a cryostat.\n\nIt was smaller than she had imagined. A cylinder of brushed grey steel on a squat base, waist-high, with a ring of status lights round its upper rim glowing a steady green, and a frosted window in its lid. A thick power cable ran from its base to a socket in the hold wall. A second, thinner cable ran from its side to a box on the wall beside the socket, a grey box with a single red light on it and a keyhole.\n\nMaren went and stood beside it. She did not touch it. She bent and looked through the frosted window in the lid.\n\nInside the cryostat, cradled in a nest of white foam that smoked faintly with cold, lay an egg.\n\nIt was grey. Matte grey, the grey of good ceramic, without any shine at all, so that the lamp's light seemed to sink into it rather than lie on it. It was about the length of her forearm and a half, smooth, slightly irregular, like a real egg, an egg from some enormous bird; and it had a seam running round its widest part, very fine, like the join of a cup and a saucer. On its upper surface, stencilled in black, in neat Combine capitals, were three lines.\n\n  SANITATION AGENT\n  PATTERN H\n  FACTOR'S AUTHORITY ONLY\n\nBeneath the lines, small, the green wheel of Halloran-Vey.\n\nOdile came and looked over her shoulder. Her breath frosted the inside of her visor.\n\n\"What is it?\" she whispered.\n\n\"I don't know,\" said Maren.\n\nThat was true. It was also, she understood even as she said it, the last true thing she would be able to say about it. Because she was looking at it, at its smooth grey indifferent surface in its nest of smoking foam, and the cold of the hold was coming in through her suit, and something in the back of her skull, some old animal thing that had lived through twenty-six years on the line, was telling her very clearly and very quietly to back away.\n\nThere was a sound at the hold's forward end. A door.\n\nOdile caught Maren's arm. They killed their lamps together and stood still in the dark, by the cryostat, with its ring of green lights glowing between them; and the forward door of the cold hold slid open and let in a wedge of yellow light, and in the wedge, two figures in heavy cold-weather jackets with the green wheel on the shoulder. A short broad woman with a sidearm. A tall thin man.\n\n\"Every day,\" said Sergeant Oyelowo's voice, flat and bored, echoing down the hold. \"You know it's still there, sir. The board says it's still there. The light's green.\"\n\n\"I know,\" said Quist. \"Humour me, Sergeant.\"\n\nHe did not come in. He stood in the doorway in the wedge of light with his hands in the pockets of his jacket, looking down the long dark hold toward the cryostat; looking, it seemed to Maren, straight at her, though he could not have seen her, with her lamp out, behind the glow of the status lights. He stood there for a long moment. His face was in shadow. Then he took one hand out of his pocket and touched something at his throat, a cord, a small shape on it that caught the light for an instant, the size of a key.\n\n\"Thank you, Sergeant,\" he said, and stepped back, and the door slid shut.\n\nThey stood in the dark for a long time afterward.","wordCount":1227,"createdAt":1793108902074,"updatedAt":1793108902074},{"id":"jhxY4eJe-_0gNDUu9K2-w","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"ibGuRe6J5CEM2gQL7ATwe","text":"A lane is not a road. People who have never been through one think it is, and draw it on their charts as a line between two dots, and talk about _going down the Corva lane_ as if it were a corridor with a door at each end. Til has been through forty-one lanes in her life, some of them many times, and she has stopped trying to say what they are. The nearest she has come is this: a lane is a place where the dark has been folded, and a ship in it is a crease.\n\nAn anchored lane is a good crease. Somebody, a long time ago, built a station at each end of it that holds the fold flat, and as long as the anchors hold, a ship goes in at one end and comes out at the other with nothing worse than a headache and a strange taste in the mouth, like licking a battery. An unanchored lane is called raw. The fold moves. It ripples like a flag in a wind. Nobody knows what the wind is.\n\nThe Corva lane has been raw for longer than anybody alive has been alive, and for most of that time it was closed. Two years ago it opened again, the way a healed bone sometimes aches and opens, and nobody knows why that either.\n\n\"Shear coming,\" says Oz, from the engine space. \"Big one. Twelve seconds.\"\n\n\"I see it.\"\n\n\"You don't see it, you feel it. Hold on to something.\"\n\nTil holds on to the yoke. In the forward seat beside her Juno is strapped in tight, her new suit sealed and her helmet clipped to her shoulder, and she is holding on to both armrests with both gloved hands and staring straight ahead at the cockpit glass, where there is nothing to see. In a lane there is never anything to see. The glass shows a dim grey flicker, like the inside of an eyelid, and occasionally a long slow ripple of brighter grey crossing it from one side to the other, which is the fold moving, and which you learn very fast not to look at.\n\nThe shear hits.\n\nIt's like being kicked by the whole universe at once. The _Dray_ doesn't shake so much as change shape: for one long, sick, impossible moment Til can feel the cockpit getting longer, the yoke in her hands drawing out away from her like taffy, her own arms stretching to follow it; and then it snaps back, and every rivet in the old tug's hull screams at once, a high thin chorus like a choir of kettles, and something aft goes bang.\n\n\"Coolant,\" says Oz, quite calmly, on the intercom. \"Number two loop. That was the coupling.\"\n\n\"How bad?\"\n\n\"Bad enough that I'd like some help, please, Captain.\"\n\nTil looks at the board. The core temperature is climbing, not fast but steadily, a line going up at the angle of a cheap staircase. She can't leave the yoke. In a raw lane you never leave the yoke; the autopilot doesn't know what the fold is going to do any more than you do, and it doesn't have the sense to be frightened.\n\n\"Juno,\" she says.\n\nJuno doesn't move.\n\n\"Juno. I need you to go aft and help Oz.\"\n\n\"I'm not crew.\" Juno's voice is very small and very flat. She's still staring at the glass. \"Mother Szabo said—\"\n\n\"Mother Szabo isn't in a raw lane with a coolant leak. Mother Szabo is a day behind us in a much bigger ship with a much better engineer. If the core goes, it goes, and you go with it, and then she'll bill me.\" Til doesn't look at her. She keeps her eyes on the board and her hands on the yoke and her voice exactly the way it would be if she were asking for a cup of tea. \"Unstrap. Clip your helmet on. Go aft along the rail, hand over hand, don't let go of the rail for anything. Oz will tell you what to do. He's very good at telling people what to do.\"\n\n\"I am,\" says Oz on the intercom.\n\nJuno sits for another two seconds. Then she unstraps.\n\nTil doesn't watch her go. She hears her: the click of the harness, the clunk of the helmet seal, the scrape of boots on the deck, the hand-over-hand rattle of the rail. She hears the aft hatch cycle. She keeps her eyes on the board and her hands on the yoke and flies the _Dray_ through the dark that isn't dark, feeling for the fold the way you feel for a step in a black stairwell, and she listens to the intercom.\n\n\"There,\" Oz is saying. \"That clamp. No, the big one. Get both hands on it. Now push. Harder than that. Pretend it's me.\"\n\nA grunt.\n\n\"Good. Hold it there. Don't let go of it, whatever happens.\"\n\n\"It's hot.\"\n\n\"It's very hot. Your gloves are rated. Hold it. I'm going to put a sleeve on the coupling and it's going to take me forty seconds, and if you let go of that clamp in the next forty seconds the loop'll blow out past my hands and the core'll scram and we'll be sitting dead in a raw lane, so don't.\"\n\n\"I won't.\"\n\n\"Shear coming,\" says Til. \"Eight seconds.\"\n\n\"Wonderful,\" says Oz.\n\n\"Hold on to the clamp, Juno.\"\n\n\"I'm _holding on to the clamp_.\"\n\nThe second shear is worse than the first. The cockpit stretches and snaps and the kettles scream and the board flickers, and Til, flying, feels the fold go under the _Dray_ like a wave under a small boat, a long sickening rise and fall, and holds the yoke against it and does not breathe. Aft, on the intercom, she hears Juno shout something wordless and furious, and Oz swearing in the Roundsman cant, a long liquid stream of it, and then silence.\n\n\"Oz.\"\n\nNothing.\n\n\"Oz.\"\n\n\"Sleeve's on,\" says Oz. He sounds out of breath. \"Loop's holding. She held the clamp.\"\n\n\"Juno?\"\n\nA pause. Then Juno's voice, shaking, very young. \"I held the clamp.\"\n\n\"Good,\" says Til. \"That was good.\"\n\nShe keeps her eyes on the board. She doesn't let her voice change. She flies the _Dray_ on through the shifting dark for another nine hours, through four more shears, none of them as bad, and she never once takes her hands off the yoke. And at some point in the fifth hour, without either of them saying anything about it, Juno comes forward again and straps into the second seat and stays there, and when Til asks her to read off the core temperature every ten minutes, she does.","wordCount":1117,"createdAt":1793108733416,"updatedAt":1793108733416},{"id":"px834DBX-pZyeJOvYNKuF","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"ztuoYaqoIuoqq8-A2Tl57","text":"Quist told them that evening, at the change of shift, in the drum hall, under the names.\n\nHe did it well. Maren had to give him that, afterward, when she had the stomach to give him anything. He stood on the gallery with Hale beside him and the marine sergeant at his back, in his plain dark coat with the wheel on the lapel, and he did not read from a slate. He told them that the Combine had reviewed its operations in the Corva system and had concluded, with regret, that the market for Corva deuterium could no longer sustain them. He told them that the _Patience_ was an old ship, older than most of them, and that she would finish her season and then be retired. He told them that the Combine valued its skilled bonded very highly, and that every one of the _Patience_'s complement would be relocated, with their accounts intact and in good standing, to new postings in the Sorrel lanes, where the work was steady and the air was cheap. He told them the _Clement_ would carry them. He told them it would sail at the end of the month.\n\nHe told them nothing about the Levy, or the war, or the Camp.\n\nHe did not lie about the Camp. That was the clever thing. When old Pirro from the Bucket crew shouted up from the floor, _What about our families? What about the Camp?_, Quist turned to look at him with his long grave lined face and said that the Kettle installations would be transferred to a successor operator under the usual terms, and that the Combine's obligations to the Camp's residents would pass with them, and that family members of relocated bonded who wished to follow on were welcome to apply for passage at their own account. Every word of it was true. Maren, standing at the back of the hall under the drum with the foil in her pocket, could hear exactly how true each word was, and exactly how much it weighed.\n\n_At their own account._ A passage on the _Clement_ to Sorrel cost more than a rigger earned against his debt in eight years.\n\nThe hall took it the way bonded halls took things. There was a long silence, and then a noise, a sort of collective exhalation like a fan spinning down, and then the arguments began, small ones, everywhere at once, people turning to their neighbours. A woman was crying near the slot. Somebody was laughing. Danek Sorell, beside Maren, said \"Sorrel,\" three or four times, as if he were trying to remember where he had heard the word.\n\n\"I've got kids in the Camp, Chief,\" he said. \"Three. Tamar's in the third shaft. What's he mean, apply?\"\n\n\"He means you can't.\"\n\n\"So we go to Sorrel and they stay.\"\n\n\"That's what he means.\"\n\n\"For how long?\"\n\nMaren didn't answer him.\n\nUp on the gallery, Quist had stepped back, and Hale had stepped forward with his slate under his arm and his soft patient voice raised just enough. Order, the warden said. Questions to be raised with section chiefs, who would be meeting with the factor individually over the next days. Dips to continue as rostered. Air rations unchanged. Any bonded found organising, or refusing duty, or damaging Combine property, would have their accounts reviewed, with all that that implied, and their families' accounts likewise. He said it gently. Bram Kovač and two other trusties stood at the foot of the gallery stair with their shock-sticks loose in their hands, looking at nobody in particular.\n\n\"Organising,\" said Teska, loudly, from the bench near the drum where she always sat. \"What's that, organising? Is that talking? Is it organising if I talk?\"\n\n\"Grandam,\" said Hale, with great kindness, \"nobody's going to stop you talking.\"\n\n\"No,\" said Teska. \"You never have.\" She turned her head toward the hall, with her one good eye. \"I've been on this ship sixty-one years. I came out on her in pieces. I've buried two husbands and a daughter on that line. Now they say they're going to sink her.\" She spat on the deck. \"Gall can have her. Gall's had everything else.\"\n\nSome of the hall laughed. Most of it didn't.\n\nMaren found her brother at the edge of the crowd near the riggers' stair, where he always was, where the talk was. He was flushed and bright-eyed and talking fast to a knot of young riggers, his hands moving, and when he saw her coming he broke off and came to meet her with his arms open like a man at a party.\n\n\"Sorrel,\" he said. \"Did you hear him? Sorrel, Maren.\"\n\n\"I heard him.\"\n\n\"Off this rock. Off this ship. Do you know what they've got on Sorrel? Real gravity, on the forts. They've got markets. They've got—God, I don't know what they've got, I've never been anywhere. Neither have you.\" He caught her by the shoulders. His breath smelled of the illegal still in the dock section, which meant he had been celebrating since before the hall. \"We're getting out. Both of us. Thirty years they've had us hanging off this planet on a string and now they're letting us go.\"\n\n\"They're not letting us go.\"\n\n\"Same thing.\"\n\n\"It isn't, Abel.\"\n\nHe looked at her face, and some of the brightness went out of his. He let go of her shoulders.\n\n\"You've got that look,\" he said. \"Your chief's look. Like something's about to walk.\"\n\n\"Something is.\"\n\n\"What?\"\n\nShe looked at him. Her little brother, twenty-nine years old, the same height as her and twice as handsome, with their mother's eyes and their father's absence and a laugh that had been getting him out of trouble since he was four. Everyone on the _Patience_ liked Abel. Everyone on the _Patience_ was owed money by Abel, or owed him a favour, or both. He had never kept a credit in his account for longer than a week in his life. It was, Lusine had said to her sister, restful.\n\n\"Not here,\" Maren said.","wordCount":1012,"createdAt":1793093707340,"updatedAt":1793093707340},{"id":"rV-vM6Q-Wqq-N5p3e2dkI","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"fQhSGkxql0h3M7ncut10L","text":"In the afternoon I'm sent to the Spine.\n\nThe order comes down from the Wardens' Office with no explanation, which is how orders always come down: _Venn, I., to report Spine nave, air survey, priority._ When I get there I find out why. A slug in the night came down closer than any before it, on the old dock heads over the Spine, and the shock went down through the hull like a hammer down an anvil, and somewhere in the nave's air system something cracked. The nave's air is the Council's air. It's shared air, untithed, drawn straight from the city's best intakes and scrubbed three times on its way; it's also, like all old systems, a mess of pipes and baffles and valves that nobody has drawn a proper plan of in a century. Somebody has to walk it with a gauge and find the leak. The Council's own engineers are busy on the refinery vents. So they send a warden from the Ninth.\n\nI walk it for three hours. I go up into the roof spaces above the nave on the old maintenance ladders, which were built for riggers two centuries ago and have been painted a dozen times since and never once mended, and crawl along the trunking with my gauge in one hand and my lamp in my teeth, listening. The nave below me is empty. Since the siege began the Council has met in the old bridge, which is deeper and safer, and the shared families have stopped coming up to sit on the benches under the Oculus and look at the Lamp. You can see it through the lens even from up here, sideways: a smear of greenish light much brighter now than it was at Lampfast, with a tail so long it crosses half the lens. The Lamp doesn't care about the Concord. It comes on in.\n\nI find the leak in the end over the drum, where a flange on the main trunk has cracked across its face and is whistling out the Council's good air into the roof void. I can feel it on my cheek. I mark it with chalk and log it, and I'm climbing back down the ladder at the drum's end when the next slug comes.\n\nIt's close. Much closer than the one in the night. I feel it before I hear it, a shove from the ladder against my hands and my knees, as if the whole Spine had been kicked; then the sound, which isn't a boom at all this close but a crack, enormous, a sound like the sky being split down the middle; and then the nave rings. The old hull takes the blow and passes it down its whole length like a struck bell, and the ladder hums under me so hard my teeth buzz, and dust comes down out of the roof in a grey sheet, and somewhere below me something lets go.\n\nI hang on. That's all you can do. When the ringing has gone down enough for me to hear myself think, I look down.\n\nThe Share Plate has fallen off the drum.\n\nIt must have been hanging on the same old fixings since the founding: four steel pins set into the drum's end, with the Plate's top corners hooked over two of them. The hull has rung and the pins have sheared. It's lying on the deck at the drum's foot, face down, in the dust, with one corner bent.\n\nI climb the rest of the way down and stand looking at it. I don't touch it. Nobody touches the Plate. There are shared children who have been taken up to it on their naming days and allowed to lay one finger on the edge of their ancestor's name, and that is all; there are unshared families who have lived in this city for a hundred years and never been within ten metres of it. And now here it is at my feet, face down on the deck like a dropped tray.\n\nThe back is grey.\n\nThat's what I notice. I've never seen the back of it, nobody has. It's covered, edge to edge, in a coat of thick old grey paint, the kind of hull sealant they used to put on the outside of ships, gone hard and crazed with age, like the skin on old milk. Somebody painted the back of the Share Plate with ship's sealant, a long time ago, carefully, all over. And under the paint, where the light from the Oculus falls across it at a low angle, there are lines.\n\nI crouch down. I still don't touch it. The lines are very faint, just a ridging in the sealant, the way the shape of a coin shows through a sheet of paper laid over it. Rows of them. Short marks, grouped. Something cut into the metal underneath and then painted over, so that only the ghost of the cutting comes through.\n\n\"Don't touch it,\" says a voice behind me.\n\nIt's Malachy. He's come up from the Archive in his slippers with his old grey coat thrown over his nightshirt, though it's the middle of the afternoon, and his white hair is full of dust, and he's out of breath. He comes across the nave to me at his slow crane's walk and stands beside me looking down at the Plate.\n\n\"I wasn't going to,\" I say.\n\n\"Good. Your hands are filthy.\" He crouches down beside me, which takes him some time, and puts his face close to the grey back of the Plate, and tilts his head to catch the light the way I did. He looks for a long time. He doesn't say anything. Then he lets out a long breath through his nose.\n\n\"Well,\" he says. \"Well, well.\"\n\n\"Is that writing?\"\n\n\"It's something.\"\n\nThere are footsteps on the nave floor, a lot of them. The Council's stewards, in their grey coats, four of them, with the First Shareholder walking behind. Lucan Strand looks tired. He has dust on his shoulders, too, and a cut over one eye with a dressing on it, and he moves like a man who has been awake for most of eighteen days; but his face when he sees the Plate on the floor goes very still, and then very gentle, the way a man's face goes when he sees a child hurt.\n\n\"Is it damaged?\"\n\n\"One corner bent, First Shareholder,\" says Malachy, not getting up. \"The fixings sheared. I'd like to look at it before it goes back up.\"\n\n\"It must go back up.\" Strand comes and stands over it. \"Today. The people need to see it there. With what's happening—\"\n\n\"It'll go back up,\" says Malachy, \"on new pins, in a proper frame, when I've made sure that bend hasn't cracked the steel. If you hang it today on the old pins it'll be on the floor again in a week, and next time it might break.\" He looks up at the First Shareholder with his mild old eyes. \"You wouldn't want to be the Shareholder who broke the Plate, Lucan.\"\n\nStrand looks at him. I think for a moment that he's going to say no. I can see him weighing it: the steward at his elbow, the empty nave, the Lamp over his head in the Oculus, the slugs.\n\n\"How long?\" he says.\n\n\"A week. Two at most.\"\n\n\"In the Archive.\"\n\n\"In the Archive, under lock, where it's safe. You can come and look at it any time you like.\"\n\nStrand lets out a breath. \"Very well. A week.\" He turns to the stewards. \"Help the Archivist carry it. Gently.\" He looks down at me as if noticing me for the first time. \"You found it?\"\n\n\"I was surveying the air, First Shareholder. There's a cracked flange on the main trunk, over the drum. I've marked it.\"\n\n\"Thank you.\" He's already turning away. \"Thank you, warden. Good work.\"\n\nThe stewards pick the Plate up between them, carefully, face down still, the grey back uppermost, and carry it toward the Archive stairs like a stretcher, with Malachy hovering behind. Nobody but me and Malachy looks at the back. The stewards are looking at their feet on the stairs. Strand is looking at the pins.\n\nAs Malachy goes past me, he puts his hand on my arm for a moment, very lightly.\n\n\"Come and see me tonight,\" he says. \"After curfew. Bring your lamp.\"","wordCount":1410,"createdAt":1793093847736,"updatedAt":1793093847736},{"id":"rghntOJSuDIDpudYADP9s","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"F6DSf6VLOavx87_UDZc5D","text":"The _Dray_ is not beautiful.\n\nTil will be the first to say it. She's a deep-salvage tug of the old Tarn pattern, built sixty years ago for hauling dead hulks off the Harrow and the other wreck-fields of the outer Reach, and she looks it: a squat, blunt, armoured wedge of a hull, scarred and patched and painted over so many times that nobody knows any more what colour she started, with a stubby drive cluster at the back, a long grapple-and-winch boom slung under her belly like a folded insect's leg, and a forward cabin so small that two people can only pass in it if one of them is asleep. She has a fusion core that runs hot and an air plant that runs cold and a winch that will haul a hundred kilometres of cable and has hauled most of it. She is slow. She is ugly. She cannot be killed. Til has tried.\n\nOz spends two days going over her from the drive cones to the forward lamps, while Til spends two days spending other people's money. They buy cable. They buy reaction mass. They buy air, eleven tanks of it, more air than the _Dray_ has carried at one time in her life; they buy ice-anchors and screw-pitons and a thermal lance and two new pressure suits, one of them small, which Til buys without saying anything and Oz watches her buy without saying anything either. They buy food. Cato Marchetti comes down to the dock twice to look things over and goes away again, courteous, attentive, saying almost nothing; on the second visit he brings four long crates of his own, sealed, and asks for them to go in the cargo bay, and Til opens one with Oz standing by, because it's her ship, and finds medical supplies, and closes it again.\n\n\"He didn't mind,\" says Oz, afterward. \"You opening it.\"\n\n\"No.\"\n\n\"He wanted you to.\"\n\n\"Yes,\" says Til.\n\nThey're in the cargo bay, on the night before departure, stowing the last of the cable. The bay's lit by work-lamps clipped to the ribs and smells of old grease and cold metal and the dust that gets into everything on Cinderhaven, fine grey dust from the ring's ore-mills that you can taste for a week after you leave. Oz is coiling cable on to a drum with his delicate hands, talking to himself in the old Roundsman cant his mother taught him, half prayer and half swearing.\n\n\"My mother's people came out of Corva,\" he says, unexpectedly.\n\nTil looks up from the anchors. \"You never said.\"\n\n\"You never asked. It was a long way back. Two hundred years and more. Before the lane went dark.\" He finishes the coil, ties it off. \"Dippers. They used to go down into the giant's air on ropes, she said, forty kilometres of rope, and scoop the weather up in a bucket. And when they died they gave them to the giant. Lowered them down on the rope and let them go. And they had the comet, and they had a saying about it. The Lamp takes the dead out and brings them back.\" He picks up the next coil. \"That's where we got it. The Roundsmen. All of it. The salt and the loops and the going-out. It's dipper stuff. It's from Corva.\"\n\n\"Then the Hoard's dipper stuff too.\"\n\n\"The Hoard's drunk stuff,\" says Oz. \"There's no Hoard. Dippers didn't have anything to hoard. They had debts.\" He tugs the cable. \"But it's funny. That we're going there. Back round.\"\n\n\"It's not funny. It's thirty thousand marks.\"\n\n\"That too.\"\n\nThe hatch at the forward end of the bay grinds open and lets in a slab of yellow dock light, and a figure in it with a bag over its shoulder.\n\nJuno has a grey house coat on over a rigger's undersuit, and a cheap pair of dock boots, and the bag, which is small and old and has belonged to someone else before her. She stops in the hatch. She looks at Oz, and at the cable, and at the work-lamps, and at the stained ribs of the hull, and finally at Til.\n\n\"Mother Szabo sent me,\" she says.\n\n\"I know.\"\n\n\"I'm to witness the recovery. And log the cargo. And report back to the house.\" She says it like something learned off a slate. \"I'm not crew. I'm not under your orders. Mother Szabo says if you put me to work I'm to log it and she'll bill you.\"\n\n\"That sounds like her.\"\n\n\"Where do I sleep?\"\n\n\"There's a bunk aft of the galley,\" Til says. \"It's the warm one. There's a new suit in the locker by it that ought to fit you. You'll need to try it before we go through the lane. Oz will check your seals.\"\n\nJuno looks at her for a long moment. Til waits for it, whatever it's going to be, and is ready for it, she thinks; she has had eleven years to get ready for it.\n\n\"Don't talk to me,\" says Juno Brask, quite politely. \"Unless it's about the job.\"\n\nShe goes past them down the bay toward the galley hatch, and Oz moves out of her way with his coil of cable, and she doesn't look at either of them; and then the galley hatch closes behind her and it's just the two of them in the work-light with the cable and the cold.\n\nOz goes back to his coiling. After a while he says, without looking up, \"She's got Mags's walk.\"\n\n\"I know.\"\n\n\"Tall, though. Taller than Mags. That's from the father, whoever he was.\"\n\n\"I know, Oz.\"\n\n\"She'll come round.\"\n\n\"She won't,\" says Til. \"And she shouldn't.\"\n\nThe client comes aboard at the first bell of the morning, an hour before the departure slot. Til has been expecting a sick old man in a chair. What comes up the ramp out of the dock's grey half-light is a coffin.\n\nIt's a medical cradle, she knows that; she's seen them before, on the Directorate's hospital ships, though never one this fine. It's a long, low, gleaming shell of white composite on a powered sled, with a clear canopy over the upper half and racks of quiet instruments along its sides, humming. Two dock porters walk it up the ramp, and Cato Marchetti walks behind it with a hand resting lightly on its rim, the way a man walks beside a horse. Under the canopy, propped on pillows, is Hollis Vey.\n\nHe is very thin. That's the first thing. He's a long man, and the illness has eaten everything from him but the length, so that he lies in his white shell like a heron in a nest, all bones and joints. His skin has the papery yellow-grey of the very sick. His hair is white and wispy and was once, you can see, thick and fair. He's seventy, perhaps, or a hard sixty. His eyes are pale blue, and wet, and completely alert, and they move over the _Dray_'s cargo bay, its ribs and its lamps and its drums of cable, with an expression that Til, after a moment, recognises as delight.\n\n\"Captain Brask,\" he says. His voice comes through a speaker grille in the cradle's rim, thin and dry and slightly delayed. \"Forgive me for not getting up.\"\n\n\"Mr Vey.\"\n\n\"This is a very ugly ship.\"\n\n\"Yes.\"\n\n\"Good.\" He smiles. His teeth are perfect and slightly too large for his face. \"Ugly ships last. My family built beautiful ones. You'll notice we haven't got any left.\" He turns his head on the pillow, with some effort, to look at her properly. \"Mother Szabo tells me you're the best deep-salvage captain on the Ring.\"\n\n\"Mother Szabo tells people what makes her money.\"\n\n\"Then we understand each other. She also tells me you've no wish to know my business, which I very much appreciate, and which I don't for a moment believe.\" The pale eyes are amused. \"We have a long way to go together, Captain. I'll tell you my business, when I've decided how much of it I can bear to say aloud. In the meantime, I would be grateful for a place to plug this thing in, and a window, if your ship runs to windows. I'd like to see it, when we get there.\"\n\n\"The Lamp?\"\n\n\"Corva,\" says Hollis Vey. \"All of it. My family hasn't seen it in five hundred years.\"\n\nThey undock at the second bell. Til takes the _Dray_ out herself, by hand, the way she always does, backing her off the dock on her manoeuvring jets with the yard-master swearing at her on the traffic channel for doing it by hand, and swings her round in the long shadow of the ring, and lights her drive. Cinderhaven falls away behind them, a great grey wheel turning slowly in the light of Tarn, with its docks and its chapels and its stone vaults full of paper. Ahead, two days off, is the Throat of the Corva lane.\n\nOz comes up into the cockpit as the ring shrinks. He leans on the back of her chair and looks at the rear display for a while without saying anything.\n\n\"Something just came off the ring behind us,\" he says. \"Dock Two. Big hull. Running quiet.\"\n\nTil looks. She knows the hull. Everybody on Cinderhaven knows the hull: a long black repossession cutter with a ram bow and four turrets, the house mark of a ledger and a pen painted small on her flank, the _Carrion Hymn_.\n\n\"Well,\" says Til. \"Mother's coming too.\"","wordCount":1599,"createdAt":1793093504338,"updatedAt":1793108733680},{"id":"sNcLLkt1iMzEEOQ9N6pCS","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"YlTeVKU7e0FKnJJ1jEg_8","text":"On the eighteenth day of the siege the Ocampos' grandmother dies on the floor.\n\nI'm the one who finds her. That's the way it falls out; I'm doing my rounds on the Ninth South with the new rates loaded in my ledger, and when I get to the eleventh door I knock and say _air-warden_ and nobody answers, and I knock again, and then I put my ear to the hatch the way the old wardens taught us, to listen for the household breathing, and I hear only the fans. So I open it with my key. We're allowed to. The Ordinance says a warden may enter any unshared household to read its meter, at any hour, without notice, and I have never once done it before.\n\nThe room is dark and very cold. The Ninth's rooms are all one room: a sleeping platform at the back, a bench and a heater and a basin at the front, a curtain between. The heater's off, because heat costs air. The curtain's open. On the sleeping platform, under three blankets and a coat, lies an old woman with a grey face and her mouth a little open, and beside her, sitting on the edge of the platform with her knees drawn up and her cracked grey gloves on, is Pilar.\n\n\"Abuela's asleep,\" she says.\n\nI go and look. I'm not a medic, but you learn what you need to learn on the Ninth. The old woman's been dead some hours. Her hands are folded on the blanket, which means somebody folded them.\n\n\"Where's your mother, Pilar?\"\n\n\"At the plant. They're doing double shifts. Because of the Concord.\" She looks at me. \"Papa's at the plant too. Tomás and Juli are at the crèche on the Seventh. Abuela was sleeping. I was minding her.\"\n\n\"How long has she been sleeping?\"\n\nPilar thinks about it seriously. \"Since before the morning bell,\" she says. \"She said she was tired. She said her chest was tight. She said it was like breathing through a sock.\" She looks back at her grandmother. \"Then she stopped saying things.\"\n\nI stand in the cold dark room with my ledger on my wrist. The meter by the door, under its frosted window, reads two hundred litres an hour for five people. That is the new floor. Two hundred for five. It came in on the first of the cycle, along with the doubled tithe, by Council order, and I loaded the new figures myself and turned the valves myself, every door on my section that was in arrears, which on the Ninth South was very nearly every door. I put the Ocampos to the new floor on the second. I remember the valve. It was stiff.\n\nNobody dies on the floor.\n\n\"She had the ice cough,\" I say. \"Your grandmother. She'd had it for years. I heard it every time I came. Didn't she?\"\n\n\"She coughed,\" Pilar agrees.\n\n\"It's the cough. When people get old, the cough gets into their chest, and their heart gets tired. It isn't anybody's fault.\" I hear my own voice, very even, very kind. The warden's voice. \"I'm going to call the medics on the Seventh. They'll come and look after her. And I'm going to send a message to the plant, to your mother. All right?\"\n\n\"All right,\" says Pilar.\n\nI call the medics. I send the message. I file the death in my ledger, as the Ordinance requires, under _cause_, in the space provided: _Ice cough, pre-existing. Age._ My finger hovers over the line for a moment before I submit it, and then I submit it, because it's true. She did have the cough. She was old.\n\nWhile I wait for the medics I sit on the bench by the dead heater, and Pilar sits on the platform beside her grandmother, and neither of us says anything. Through the ceiling, faintly, very far up, I can hear the surface being hit. It's a sound we've all learned to stop hearing, these eighteen days: a long dull boom like a door slammed in another house, every hour or so, as one of Grieve's slugs comes down out of the black and strikes the shell of Kettle somewhere over the city. He is careful, the Commodore. Everyone says so. He doesn't hit the tiers. He hits the refinery vents and the dipper docks and the old surface sheds where the fuel was stored, and the city's lungs on the far ice, the great intakes where the water is cracked for air. He is not trying to break us. He is trying to make us breathe less.\n\nOn the wall of the corridor outside, every tier now has a board, posted by the Council at the start of each shift. It says RESERVE, and then a number of days. When the siege began it said ninety-four. This morning it says sixty-one.\n\n\"Warden,\" says Pilar.\n\n\"Yes.\"\n\n\"When Mama pays, does it go straight back?\"\n\n\"Yes.\"\n\n\"Even now?\"\n\n\"Even now. The ledger tells the plant. She doesn't have to find me.\"\n\nPilar considers this. Then she gets down off the platform and goes to the hatch and looks at the meter under its frosted window, the needle lying on the red, and wipes the frost off the glass with her cracked glove, the way I do.\n\n\"It's very low,\" she says.\n\n\"It's the floor.\"\n\n\"Nobody dies on the floor,\" says Pilar, to the meter, quite seriously, as if she were reminding it.","wordCount":914,"createdAt":1793093847899,"updatedAt":1793093847899},{"id":"urVlYAffuCtomV-b1okBW","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"WBzd9JKAUioZSIPwnavT1","text":"The Archive is the Spine's old cargo deck, four levels down from the nave, and it smells the way I imagine the inside of a very old person's head smells: of dust, and paper, and cold, and something sweetish and faint like rot. There's no proper light. There never has been. Malachy works by lamps, a dozen of them on long arms clamped to his tables, so that the Archive is a great dark cave with little islands of yellow in it, and on every island, books, slates, rolled charts, folders of foil, ledgers bound in plastic gone brown, the whole two hundred and sixty years of Patience written down by people who mostly never expected anyone to read it.\n\nHe has the Plate on his biggest table, under three lamps, face down.\n\n\"Close the door,\" he says, when I come in. \"And lock it. There's a bar.\"\n\nI bar the door. When I turn round he's bending over the table with a magnifier strapped round his head on a leather band, like a jeweller, and a tiny brush in one hand and a dish of something in the other that smells sharp enough to make my eyes water.\n\n\"Solvent,\" he says, without looking up. \"Old dock solvent. The kind they used to strip hull paint, back when we had hulls to strip. There's a drum of it in the bottom store that's been there since my grandfather's time. It does the job, slowly. Too fast and it would take the scratches with it.\" He dabs the brush, very lightly, and wipes. \"Come and look. Don't breathe on it.\"\n\nI come and look.\n\nHe's cleaned a patch in the top corner of the Plate's back, no bigger than my palm. Inside it, the grey sealant is gone, and the steel underneath is dark and dull and pitted with age, and across it, cut into the metal, there are marks. Not deep. Scratched, rather than cut: thin uncertain lines, as if made with a point dragged slowly and hard, by somebody pressing with all their weight. They're figures. Numbers. A column of them, and beside the column, letters, single letters, like labels.\n\n\"Somebody scratched these with an awl,\" says Malachy. \"A rigger's scribe, probably. The kind they used for marking cable. You can see where the point skidded.\" He touches the air above a line with the end of his brush. \"Look at the sevens. They cross their sevens. Nobody's crossed a seven in this city for two hundred years.\"\n\n\"What are they?\"\n\n\"Numbers.\"\n\n\"Malachy.\"\n\n\"I don't know yet.\" He straightens up, with a little grunt, and pushes the magnifier up on to his forehead, where it sits like a third eye. \"I've done this much in a night. There's the whole back of the Plate still under paint, and the paint's harder in the middle, where it was thicker. A week. Two.\" He looks at me. \"I need you to keep this to yourself, Isaura.\"\n\n\"Who would I tell?\"\n\n\"Your mother. Your section chief. That rigger woman from South Lock who's been asking about you on the Ninth.\" He sees my face and smiles thinly. \"I hear things. I'm an archivist. Hearing things is most of the job.\"\n\n\"Why does it matter? It's numbers on the back of a plate.\"\n\n\"It matters,\" says Malachy, \"because somebody went to a great deal of trouble to put them there, and then went to a great deal more trouble to make sure nobody could see them.\" He lays the brush down across the dish. \"Think about it. This is the Share Plate. It's the first thing the founders made. It's been hanging in the nave since before there was a nave. Every child in Patience has stood in front of it. And somebody, two hundred and sixty years ago, took it down and cut something into the back of it with an awl, and then painted over it with hull sealant, carefully, edge to edge, so that it would look like nothing but the back of a piece of steel. And hung it up again.\" He spreads his old spotted hands. \"You don't do that with a shopping list.\"\n\n\"Then why not throw it away? If they didn't want it read.\"\n\n\"Because they did want it read.\" Malachy pulls the magnifier back down over his eye and bends to the Plate again. \"Eventually. Just not by whoever was standing in front of it at the time.\" He dabs with the brush. \"Those aren't the same thing, Isaura. Keeping a thing and hiding it. You'll find most of this room is one or the other. The trick is telling which.\"","wordCount":776,"createdAt":1793109049375,"updatedAt":1793109049375},{"id":"w82YRv0osxHCTNP7Oy_e_","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"z3x3YJKqAA1IVoNVx4t37","text":"The line was singing in E-flat when Lusine Arda called the ice.\n\nMaren Tsolo heard it before the board showed it: a thickening in the hum that came up through the gallery floor and into the soles of her boots, the note the tether made when something on it had gone heavy. Forty kilometres of carbon braid ran down from the drum beneath her feet, out through the keel slot of the _Patience_ and down, always down, the tether deck had no other direction, into the ochre murk of Gall, where the Bucket rode the cloud-tops at seven kilometres a second and swallowed weather.\n\n\"Runner Two,\" Lusine said on the line channel. \"I've got rime at eleven-four. Thick. It's growing while I watch it.\"\n\n\"How thick?\"\n\n\"Thumb and a half. Feathering on the windward side.\"\n\nMaren put two fingers on the tension trace. It was climbing, slowly, the way a fever climbs. Rime on the line meant weight, and weight in the wrong place meant the line would start to oscillate, and oscillation on a forty-kilometre tether was the kind of thing that turned up in the Combine's quarterly loss summaries as a single line of figures. Equipment, one Bucket. Personnel, as listed.\n\n\"Clear it,\" she said. \"Go slow. Runner One, hold at six and watch your sister.\"\n\n\"Holding,\" said Odile, who was nineteen and had never in her life held at anything. Her crawler sat on the line six kilometres down, a red dot on the board, and Maren watched the dot and did not trust it.\n\nThe tether gallery was a long room with a long window, and the window looked at nothing useful. You saw the drum below you, the size of a cathedral, turning; you saw the slot it fed into; and past the slot, if you leaned, a curve of Gall so close and so large that it was not a planet at all but a weather, a floor of ochre and old-bruise purple that went on until it bent away into black. Nobody leaned. The board was where the line was. The board was where you saw it breathe.\n\nMaren had been tether-chief for nine years and on the line for twenty-six before that, and she had stopped thinking of the board as a picture of anything. It was a body. The long green trace of the tension was its pulse. The fat amber band of the Bucket's intake was its belly filling. The little coloured dots that crawled along its spine were her runners, and the numbers beside them were their air.\n\n\"Starting on it,\" Lusine said. Her voice had the slight breathless flatness of someone working hard in a suit. \"Pick's biting. It's coming off in plates.\"\n\n\"Don't let them hit the crawler.\"\n\n\"I'm not new, Chief.\"\n\n\"You're not old either.\"\n\nA laugh on the channel. It was a good channel, the line channel. Everyone on shift could hear everyone else, and in a dip, which was six hours of nothing followed by four seconds of everything, the voices were company. Down on the drum floor, Maren could see her riggers at their stations under the floodlights, little figures in grey coveralls, each one bent over a brake housing or a sensor head. Her brother was one of them. She could pick him out without trying, the way you pick out your own handwriting: Abel at the number three brake, leaning on the housing with the elbow that wasn't meant for leaning, his helmet pushed back off his forehead against regulations, talking to somebody. Abel was always talking to somebody.\n\n\"Abel,\" she said on the floor channel. \"Helmet.\"\n\nHe looked up at the gallery window, though he couldn't have seen her through the glare, and pulled the helmet down with an elaborate, injured slowness that got a laugh from the rigger beside him.\n\nThe tension trace climbed another hair.\n\n\"Eleven-four's clear,\" said Lusine. \"Moving down to eleven-six. There's more. It's in bands, Chief, like the line's been dipped in it.\"\n\n\"Weather,\" said Maren. She looked at the met strip along the top of the board. There was a storm coming up out of the south under the Bucket's track, a bruise the riggers had been calling Old Purple since the morning, and it had been throwing moisture into the high cloud for an hour. She had been watching it the way you watch a man at the next table who might be drunk. \"It's the Purple. We'll be out of its shadow in forty minutes.\"\n\n\"Forty minutes is a lot of ice.\"\n\n\"Then work faster.\"\n\nThat was what a tether-chief said. You said it with a little edge on it so they'd know you meant it and a little warmth under it so they'd know you were there. Maren had learned the voice from her own chief, Hesketh, who had gone into Gall the year Abel was born; and Hesketh had learned it from the woman before her, and so on back up the line to the first tether-chiefs of the first skimmers, who had probably said it to people who were also going to die.\n\nThe _Patience_ was sixty-one years old. She had been built for the Combine in a yard four lanes away and towed to Corva in pieces, and she had been dipping Gall ever since: two dips a day, ten months of the year, with the drum shut down only in the dead season, when Gall's southern storms made the cloud-tops too violent even for the Bucket. She carried three hundred bonded crew. On the ice of Kettle, Gall's white moon, the Combine kept two thousand more families in the warrens of Kettle Camp, refining what the _Patience_ brought up and breathing what the refinery left over. Every one of them was in debt to the Combine for the air in their lungs. Every one of them had been born in debt, or would die in it, or both. Maren had been born in the Camp. Her mother had been a runner. Her mother had gone into Gall from fourteen kilometres down when Maren was fifteen and Abel was three, and the Combine had added the cost of the lost crawler to the family account, and Maren had paid it off at nineteen, and then started on her own.\n\nYou did not think about that in a dip. You thought about the trace.\n\n\"Eleven-six clear,\" Lusine said. \"Eleven-eight is—oh, that's ugly. That's a fist of it, Chief.\"\n\n\"Can you take it?\"\n\n\"I can take it.\"\n\nThe trace jumped.\n\nIt was not much of a jump. A bump. The kind of thing the line did ten times a dip when the Bucket hit a pocket of thicker air and bit. But the note under Maren's boots changed with it, dropped half a tone and wavered, and she had her hand on the damper before she knew why.\n\n\"Shear,\" said the met tech from the end of the gallery, too late. \"Shear under the Bucket, the Purple's throwing—\"\n\n\"I see it.\" Maren rolled the damper on. Down in the slot the brakes bit and the drum shuddered and every rigger on the floor grabbed something. The trace kinked, jumped again, and began, very slowly, to make a wave. \"Runners, lock down. Lock down now. Line's going to walk.\"\n\n\"Locked,\" said Odile at once.\n\n\"Locking,\" said Lusine. \"I'm—Chief, the crawler's bucking, I can't get the—\"\n\n\"Get your clamps on and get flat.\"\n\n\"Clamps on. Clamps are on.\"\n\nThe wave went down the line. You could not see it from the gallery. You could only watch it on the trace, a long green swell running out from the drum, and know that forty kilometres away the Bucket was yawing in the cloud like a fish on a hook, and that at every point between, the braid was flexing in a long, slow, enormous S that would come back up again, and then go down again, until the dampers ate it or it ate the dampers. Maren had seen a line walk once that killed seven people and the Bucket. She had been a runner then. She had been on the line. She had held on.\n\n\"Second pulse coming up,\" she said, as calm as the floor under a bed. \"Lusine. Odile. It'll be worse at you than at me. Hold on and count. It goes by.\"\n\n\"Counting,\" said Odile, and began to count aloud, which was what Maren had taught her.\n\nLusine said nothing. On the board her dot was steady, her air steady, her clamps green.\n\nThe swell came back up the line and passed eleven-eight, and Maren felt it pass in the drum, a heave like a ship going over a wave. The trace spiked. Then there was a noise on the line channel that was not a word, a small hard sound, like a cough or a stone dropped on a deck.\n\n\"Lusine.\"\n\n\"Chief.\" Lusine's voice was quite clear. \"Chief, I'm off.\"\n\nMaren looked at the board. Lusine's dot was where it had been. The crawler's dot. The crawler was still on the line, clamped and green. Beside it, separating so slowly that for a moment it seemed to be a fault in the display, was a second, smaller mark, the personal beacon in Lusine's suit, and it was moving away.\n\n\"Clip,\" said Lusine. \"My clip went. Harness clip. I'm off the crawler. I'm—I've got nothing to grab, Chief, the line's gone past me.\"\n\n\"Stay on this channel.\"\n\n\"I'm on it.\"\n\nThe thing about a tether is that it hangs. It is not in orbit, except at one point; every part of it below the _Patience_ moves more slowly than an orbit at that height would need, and is held up only by the line itself. A runner who comes off the line comes off moving too slowly to stay up. She does not fall the way a stone falls on a world. She falls the way a dream falls: gently, a few metres a second at first, and then more, and then more, away and down along a long curve that ends in Gall.\n\nMaren knew all of this the way she knew her own teeth.\n\n\"Gull,\" she said on the command channel. \"Status on the Gull.\"\n\n\"In the cradle, Chief.\" The dock officer sounded sick. \"Port thruster's still stripped, we've got it open, it's—forty minutes to button it, an hour—\"\n\n\"Then button it.\"\n\n\"Chief, by the time—\"\n\n\"Button it.\"\n\n\"Chief,\" said Lusine. \"Don't.\"\n\nMaren closed her eyes, once, briefly, and opened them again on the trace. It was still walking. The second pulse was going back down toward the Bucket and there would be a third, smaller, and a fourth, and Odile was at six kilometres counting aloud in a voice going higher with every number.\n\n\"Odile,\" Maren said. \"Keep counting.\"\n\n\"That's my sister. That's my—\"\n\n\"I know. Keep counting. You stay clamped. If you come off that crawler I will put you on report and then I will kill you myself. Count.\"\n\n\"Twenty-two,\" said Odile, and choked, and said, \"twenty-three.\"\n\nOn the floor below the gallery the riggers had stopped working. They were standing at their stations with their faces turned up toward the window as if Maren could do something, as if she were a god in a glass box with her hands on the weather; and she could do nothing, so she did the only thing there was to do, which was run the line. She fed the damper in, and fed it out again, and listened to the drum, and kept the line from killing anyone else.\n\n\"It's quite nice actually,\" said Lusine, a little while later. \"Out here. You can see the whole of the Purple. It's got a hole in the middle like an eye. Did you know that? You never see it from the line.\"\n\n\"I didn't know that.\"\n\n\"It's looking at me.\"\n\n\"It's not looking at you. It's weather.\"\n\n\"Everything's weather to you, Chief.\" A pause. A breath. \"My air's good. Six hours on the bottle.\"\n\n\"Good.\"\n\n\"Not that I'll need six hours.\"\n\nMaren didn't answer that. The dock officer came back on the command channel to say that the port thruster was out of its housing and the replacement was being walked down from stores, and Maren said, \"Good,\" to him as well, and the word went dead in her mouth.\n\nLusine Arda was twenty-four years old. She had come up from the Camp at sixteen with her sister on her hip, practically, and been a rigger for three years and a runner for five. She did the comms relay on the off-shifts for the extra air-credit. She had a laugh like a dropped tray. She had been Maren's best runner for two years, and Maren had been meaning to tell her so and had not, because you didn't, because a runner who thought she was the best was a runner who went down the line too fast.\n\n\"Chief,\" Lusine said, after a time. Her voice had gone quieter. The channel was beginning to fuzz at the edges, the way it did when somebody was getting far from the antenna. \"Chief, I want to tell you something. Not on this channel.\"\n\n\"Switch to four.\"\n\nA click. Maren switched. Channel four was the chief's private, unlogged, a habit from the old days when tether-chiefs had needed somewhere to swear.\n\n\"Go.\"\n\n\"I read something,\" said Lusine. \"On the relay. I wasn't meant to. There's a dispatch coming in on the _Clement_, it came ahead of her on the beacon, and it's—Chief, it's about all of us. I told someone. I shouldn't have told. And now my clip—\"\n\nThe fuzz rose up and swallowed a sentence.\n\n\"Say again. Lusine, say again.\"\n\n\"—don't think it was the clip, I think it was—\"\n\n\"Lusine.\"\n\n\"It's getting warm, Chief.\" Very faint now. \"That's funny. I thought it'd be cold.\"\n\nThe beacon mark on the board touched the upper edge of the cloud.\n\n\"I can see the Lamp,\" said Lusine Arda, from very far away. \"Did you know? It's coming round. It's just above the Purple. Teska says it takes the dead—\"\n\nAnd the channel was empty, and stayed empty, and Maren sat with her hand on the damper and her eyes on the trace for another four hours and fifty minutes, until the Bucket was full and the dip was done.","wordCount":2397,"createdAt":1793092952088,"updatedAt":1793092952088},{"id":"x42fh45N_5N8zJV18jKqa","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"aoGoBIAmMSzZB_zFaT_VT","text":"Mother Szabo keeps her ledgers in stone.\n\nTil Brask has always found this funny, in the way she finds most things on Cinderhaven funny, which is to say not at all but with her mouth. The counting-house sits on the Ledger Ring, a long curved gallery of debt-houses with their shutters down and their lamps lit, and every one of them has a vault behind it cut into the ring's ballast, and in every vault, on shelves of fused grey rock, the paper. Real paper. Bound. The Directorate's courts burn down every few years, and the Directorate's data-houses get wiped every time the Directorate changes hands, which is more often than the courts burn; and so the debt-houses of Cinderhaven went back, a century ago, to writing their debts on something that does not care who is in charge. Paper keeps. Stone keeps. Debt keeps best of all.\n\nSzabo's vault is the deepest on the Ring. Her counting-room is in front of it, a long low room lined with clerks' desks, warm and dim and smelling of ink and old tea, with Mother Szabo herself at the far end of it behind a desk the size of a bunk, writing. She doesn't look up when Til comes in. She never looks up when anybody comes in. She lets them stand.\n\nTil stands.\n\nShe stands with her hands in the pockets of her deck coat and her weight on her good leg and looks at the clerks, because it's better than looking at Szabo. There are eleven of them, bonded every one, mostly young, mostly women, in the grey half-sleeves of the house, each bent under a lamp over a ledger. The fourth from the end is her niece. Juno has her hair cropped short now, like a rigger's. She's taller than she was at Mid-year. She has a pen in her hand and an ink-stain on her jaw and she's adding a column of figures with her lips moving very slightly, the way her mother used to, and she has not looked up either.\n\n\"Captain Brask,\" says Mother Szabo, finally, still writing.\n\n\"Mother.\"\n\n\"You've had my notice.\"\n\n\"I've had it.\"\n\n\"Then you know where we are.\" Szabo puts down her pen and lifts her head. She's a small, soft, round woman of sixty or so with a face like a kindly baker and eyes like a pair of rivets. \"Eleven thousand two hundred marks, principal and interest, against the hull and engines of the salvage tug _Dray_, registered Dock Nine. Six months in arrears. Three notices served. The hull is mine on Thursday, Captain. My men will be at Dock Nine on Thursday morning with the yard-master and the seals, and they will put the seals on your hatches, and you will step off, and that will be that.\"\n\n\"I'll have it by Thursday.\"\n\n\"You will not have it by Thursday.\" Szabo says it kindly. \"You have three hundred marks in your account at the Chandlers' and a job lined up in the Tarn yards that pays six hundred if it pays at all. You have a crew of one, who is sixty-three years old and owes me nine hundred himself. You have a tug that is fifty years past her rating and a licence that expires in May. I know what you have, Captain Brask. It's my business to know.\" She folds her soft little hands on the ledger. \"I am not an unkind woman. I've carried you longer than I would carry anybody else. I've carried you because I liked your sister, and because I have your sister's girl, and because I thought, for her sake, you might make something of yourself. You haven't.\"\n\nDown the room, Juno's pen has stopped.\n\nTil looks at her own boots. They are old boots. Everything she owns is old. \"What do you want, Mother?\"\n\n\"What makes you think I want anything?\"\n\n\"Because you asked me here. You could've sent the yard-master on Thursday and saved yourself the conversation. You never have a conversation you don't make money on.\"\n\nSzabo smiles. It's a real smile, warm and pleased, the smile of a teacher whose slowest pupil has finally said something right.\n\n\"I have a client,\" she says. \"Who wants a tug with a deep-salvage rating. Armour, reach, a long winch, a crew that can do a hard landing on an irregular body, and a captain who will go where she is sent and not ask the client his business.\" She tilts her head. \"And who is desperate enough to go through the Corva lane.\"\n\nThere's a silence in the counting-room. One of the clerks drops a pen.\n\n\"No,\" says Til.\n\n\"I haven't told you what it pays.\"\n\n\"It doesn't matter what it pays. The Corva lane's raw. It's been raw since it opened. Three ships have gone through it in two years and one's come back, and that one came back without its crew.\"\n\n\"It came back without most of its crew.\"\n\n\"I'm not going through the Corva lane.\"\n\n\"It pays,\" says Mother Szabo, as if Til had not spoken, \"thirty thousand marks. Ten in hand when you sign, twenty on delivery. Of which I am to have forty in the hundred, for the introduction and the risk.\" She lets that sit. \"Which leaves you eighteen thousand. Which clears the _Dray_. Which leaves you, by my arithmetic, six thousand eight hundred.\"\n\nTil doesn't say anything.\n\n\"And,\" says Szabo, \"the balance of a certain bond held by this house, against the debts of the late Margit Brask, salvager, deceased, and carried to her daughter. Which stands at\"—she does not look it up—\"seventeen thousand nine hundred and forty marks.\"\n\nAt the fourth desk from the end, Juno Brask lifts her head.\n\nShe doesn't look at Til. She looks at Szabo. Her face is very still. She has her mother's face, broad across the cheekbones, with her mother's straight black brows, and when it's still like that Til can't look at it for long.\n\n\"Six thousand eight hundred doesn't clear seventeen nine,\" Til says.\n\n\"No. It doesn't. But it would bring it within reach, wouldn't it, Captain? Two more years of honest hauling. Three, perhaps. And there might be\"—Szabo spreads her hands—\"bonuses. My client is generous. He's also old, and ill, and in a hurry. A captain who did him good service might find him very generous indeed.\"\n\n\"Who is he?\"\n\n\"That,\" says Szabo, \"is between you and him. His agent will be at the Roundsmen's chapel on Dock Nine at the second bell. You can tell him no to his face. I would rather you didn't.\" She picks up her pen again. \"That's all, Captain Brask.\"\n\nTil doesn't move.\n\n\"Mother.\"\n\n\"Hm?\"\n\n\"Why me?\"\n\nSzabo writes a line. Then she looks up again with her rivet eyes, and her voice is still kind, and Til would rather she had been anything else.\n\n\"Because nobody else I own is stupid enough,\" she says. \"And because I've heard the stories about you. On the Harrow. They say when it came to it, you cut the line.\" She looks down the room. \"A client likes to know his captain can do what's needed.\"\n\nTil walks out of the counting-house without saying anything else. As she passes the fourth desk she slows, without meaning to, and Juno's eyes come up and meet hers for the first time in eleven months, black and level and without any expression in them at all; and then Juno looks down again and goes back to her column of figures, and Til goes on out into the noise of the Ring.","wordCount":1267,"createdAt":1793093504646,"updatedAt":1793093504646},{"id":"xD5pe2aExm0FPz8fiB1p7","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"erL7KQ4EapCRUR_wiM20e","text":"The factor sent for her two hours after the hall.\n\nHe had taken Moberly's old cabin, forward of the bridge, and done nothing to it; it was still Moberly's, with the fat man's soft chairs and his hideous picture of a sailing ship on a green sea, and his stains on the carpet. Quist sat behind Moberly's desk with a single slate in front of him and a cup of real coffee, which Maren could smell from the door, and he got up when she came in, which no factor had ever done.\n\n\"Chief Tsolo. Thank you. Sit down, please.\"\n\nShe stood.\n\nHe looked at her for a moment, and then sat down again himself, without fuss. \"As you like. Would you like coffee? It's real. I'm told there hasn't been any on this ship in ten years.\"\n\n\"No.\"\n\n\"No.\" He turned the cup a little on its saucer. \"I'll come to the point, then. I need a tether-chief to manage the end of the season. You're the senior chief on this ship and the crew listen to you, which is not true of the others, or of the warden, though he'd like to think so. I need the last dips run clean, the last loads brought up, and the _Patience_ ready for decommission on the twenty-ninth. I need the crew calm while it happens. I can offer you something for it.\"\n\n\"What?\"\n\n\"An assessment,\" said Quist. \"When you reach Sorrel. As supervisory rather than general labour. It would mean a different rate against your account, a different kind of work. You'd be off the gun-decks.\" He paused. \"You'd keep your air.\"\n\n\"And Abel?\"\n\n\"Your brother? I could put him on the same assessment. I'd have to bend it.\"\n\n\"And Danek Sorell's three children in the third shaft?\"\n\nQuist did not answer at once. He looked down at the slate in front of him, and then up at her again, and his long lined face did not change, but something in it went still, the way a man goes still when he hears a sound in the dark.\n\n\"You've read the dispatch,\" he said.\n\nMaren said nothing.\n\n\"The advance dispatch. On the beacon. The one that came ahead of me.\" He nodded slowly. \"There was a runner on the relay. The one who died on the line. I'm told she worked the relay on her off-shifts.\"\n\n\"Lusine Arda.\"\n\n\"Lusine Arda. And now you've read it.\" He sat back. \"I wondered how long it would take. I wondered who it would be. I'd have said you, if you'd asked me. I've been in this work a long time, Chief Tsolo, and there's always one.\"\n\n\"Then you know.\"\n\n\"I know what I was sent to do.\" He picked up the coffee and drank some of it and put it down. \"The Corva operation is finished. It's been finished for two years; it just hasn't been told. The Sorrel yards went over to catalysed helium last spring, and the price of deuterium in the outer lanes fell by two-thirds in a quarter, and there is no longer any way to bring Corva gas up the lane and sell it for more than it costs to get it out of the sky. So the Board has done what boards do. It has cut its losses. The ship is worth nothing; it goes into Gall. The crew are worth something, to the Levy; they go to Sorrel. The Camp is worth less than nothing. The Camp is a liability. So the Camp is left in place, and its accounts are sold to a discount house in Halloran for a fraction of a mark on the hundred, and the discount house will never send anybody to collect, because there will be nobody to collect from.\"\n\n\"Two thousand households.\"\n\n\"Twenty-one hundred.\"\n\n\"You're going to leave them to die.\"\n\n\"I'm going to leave them,\" said Quist, \"to be somebody else's problem. That's the form of words. I didn't write it.\" He looked at her steadily. \"I want you to understand that I'm not a stupid man, Chief Tsolo. Nor a cruel one, I think. I've done this before. I closed Bellamy Deep in eighty-four and the Hollow Moons in eighty-seven. Bellamy went quietly; most of them got out on the last ore boats, as stowaways, and I looked the other way. The Hollow Moons didn't go quietly, and it didn't help them. It's always worse when it isn't quiet.\"\n\n\"And Tamsin's Rock?\" said Maren.\n\nIt was a guess, a name she had heard in the infirmary once, late, from Ekene, and never asked about. She saw it land. He did not flinch; he was too old and too practised to flinch. But he put the cup down very carefully, so that it made no sound on the saucer, and he took his hand away from it.\n\n\"I wasn't the factor at Tamsin's Rock,\" he said.\n\n\"But you know what happened there.\"\n\n\"Everybody in the Combine knows what happened there. That's what Tamsin's Rock is for.\" He looked at her for a long moment. \"If you know what happened at Tamsin's Rock, then you know why I'm telling you the truth. Because you're going to do something, Chief Tsolo. I can see it in you. You're going to talk to your crew, and the crew are going to talk to the Camp, and somebody is going to have an idea. And I'd rather you did it knowing exactly what you're up against than not.\" He spread his hands on the desk. \"The _Admonition_ is two weeks behind me. She has sixty marines and a torpedo bay. And I have contingency authority. Whatever you do, you can't make it end any better than it's going to end now. You can only make it worse.\"\n\n\"For who?\"\n\n\"For everyone,\" said Quist. \"For you. For them. For me.\" He paused. \"Most of all for them.\"\n\nMaren looked at him across Moberly's desk, at his plain coat and his good coffee and his long sorrowful face. She thought of Lusine's voice going faint on channel four. _I don't think it was the clip._\n\n\"Was it you?\" she said. \"Lusine. Did you have her line cut?\"\n\nFor the first time Quist looked genuinely surprised.\n\n\"Her line was cut?\"\n\n\"Her clip. Somebody took the spring two-thirds through.\"\n\nHe was quiet for a moment. Then he said, \"No. It wasn't me. I didn't know her name until this morning.\" He looked down at the slate. \"But I'd look closer to home, if I were you. I'd look at who on this ship would have wanted the Combine to be grateful to them. There's always somebody. There's always somebody who'd like to be on the right list.\" He looked up. \"The offer stands, Chief. Supervisory. You and your brother. Think about it.\"\n\n\"I've thought about it,\" said Maren, and walked out.","wordCount":1144,"createdAt":1793093707152,"updatedAt":1793093707152},{"id":"xmL6R9k5h8rvX_j93FY8S","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"jnVxFQ91gQ4i-iEdabwSG","text":"The first air I cut that year belongs to a family named Ocampo, and I cut it on the morning the Lamp comes back.\n\nTheir door is the eleventh on Ninth Tier South, a hatch in a wall of grey ice-brick with the number painted on it by somebody who had good intentions and no brush. The meter is set into the frame at chest height, under a little frosted window, and I don't need to wipe the window to read it, because I have read it every month for three years and I know what it is going to say. I wipe it anyway. You wipe the window. You read the numbers aloud into the ledger. You give people the courtesy of being measured.\n\n\"Ocampo, Ninth South eleven,\" I say, and the ledger on my wrist takes it down. \"Household of five. Draw this cycle, four hundred and twelve litres an hour at the mean. Tithe owing, nineteen days. Tithe paid, none.\" I look at the door. \"Prior notice served, twice.\"\n\nNobody answers. Somebody is behind the door; you can hear a household breathing, if you know how, a low composite sound under the hum of the warren fans, like a sleeping animal. I knock with the end of my valve key.\n\n\"Air-warden.\"\n\nThe fans hum. Up here, on the Ninth, they never stop, and they never quite manage; the Ninth is the highest tier of the city, cut so close under Kettle's surface that the ceiling sweats frost and the walls ache with cold, and the air that reaches it has been breathed by eight tiers of people on its way up. It tastes of them. You can taste the Third Tier's cooking in it, the Fifth's tannery, the Seventh's old men. Nobody shared lives on the Ninth. Nobody shared has ever been up here, except to look.\n\n\"Air-warden,\" I say again. \"Isaura Venn. I'm required to put your feed to the floor. I'll do it from the frame. You don't have to open.\"\n\nThe hatch opens.\n\nIt's the girl. I knew it would be the girl. They always send the youngest, as if I were a dog that could be talked down. She is nine years old, Pilar Ocampo, small for nine the way the Ninth's children are all small, in a jumper with the sleeves rolled four times and a pair of cracked grey gloves she has had on all winter. She has a face like a coin, round and flat and very still, and she looks at me with it.\n\n\"Mama's at the plant,\" she says. \"Papa's at the plant. Abuela's asleep. Tomás and Juli are asleep.\"\n\n\"I know.\"\n\n\"If you put it to the floor they won't wake up.\"\n\n\"They'll wake up,\" I say. \"The floor is three hundred an hour for five. It's enough to sleep on. It's enough to live on. It isn't enough to work, or cook, or run about. It's the floor. Nobody dies on the floor.\"\n\nThis is true. I have to say it because it is true, and because it is in the Ordinance, and because if I don't say it then I am just a woman with a key standing in a corridor turning off a child's grandmother. Nobody dies on the floor. People die under it, and nobody is ever put under it, by me or by anybody, not by law; the floor is the floor. If you are on the floor and you get the ice cough, or your heart is weak, or you are very old or very new, then you may die, and that is not the floor's doing. That is the cough, or the heart. I read the Ordinance when I was nineteen and swore my oath as a warden, and I have read it every year since, and I am very clear on the point.\n\n\"Nobody dies on the floor,\" says Pilar, as if she is trying it in her mouth.\n\n\"Step back from the frame, please.\"\n\nShe doesn't step back. She stands in the hatch with her cracked gloves at her sides and watches me fit the key. The valve housing is cold enough to burn through my own gloves. It turns hard, the way they all turn hard up here, the brass furred with frost, and I have to put my shoulder into it, and the needle on the gauge goes down, and down, and settles on the red line, and the sound of the fans behind the hatch changes, very slightly, from a hum to a sigh.\n\n\"Ocampo, Ninth South eleven,\" I say to the ledger. \"Feed set to floor at eight-oh-four, twelfth of June, fifty-four.\" I turn to the girl. \"When your mother pays, it goes straight back. The ledger tells the plant. She doesn't have to find me.\"\n\n\"It's Lampfast,\" Pilar says.\n\n\"I know.\"\n\n\"Everybody's going to the Spine to see the Lamp. Mama said it's the first time in two hundred and sixty-three years. She said nobody alive's seen it. She said it's lucky.\"\n\n\"It's very lucky,\" I say. \"You should go and see it.\"\n\n\"We can't go now. Abuela can't walk on the floor.\"\n\nI don't have anything to say to that. I have the key in my hand and the ledger on my wrist and a list of forty-one doors to go before the end of shift, and I can feel the cold of the Ninth going down into my boots. I put the key back on my belt.\n\n\"Close your hatch,\" I tell her. \"Keep the heat in.\"\n\nShe closes it. I stand for a moment looking at the number painted on it, the brave crooked eleven, and then I go on to the twelfth.\n\nI am good at this. I want to be clear about that from the start, because I will say other things later that might make it seem I wasn't. I was a good air-warden. I was the best in my section three years running, which is to say I collected the most tithe and filed the fewest complaints and was never once reported for leniency, which is the only thing wardens are ever reported for. I knew every meter on the Ninth South by its sound. I knew which households would pay on the first notice and which on the second and which would never pay until the needle touched red, and which had a cousin on the Seventh who could be leaned on, and which had nobody at all. I did not cut a single feed that wasn't owed. I did not leave a single door without saying the words. I believed that what I did was hard and necessary and that it kept the city breathing, and that if I didn't do it somebody else would, worse.\n\nAll of that is true. I still believe some of it.","wordCount":1143,"createdAt":1793093337437,"updatedAt":1793093337437},{"id":"yW91VlW0sFxF-g2vS32Qg","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"uQcRzgdnq8Q_9APiGoKBS","text":"The Concord comes through the Throat during the evening bells.\n\nI'm on the Fourth by then, taking my mother home the long way round by the lifts, because she can't do the stairs any more. We're in the lift queue at Fourth Central when every speaker in the city clicks at once. That's what I remember: the click. Every speaker on every tier, all together, a single dry sound like a knuckle on a table, and then the hiss of an open channel, and then a voice.\n\n\"This is a message to the people of Kettle from the Concord of Vey.\"\n\nThe queue goes quiet. Everyone looks at the nearest speaker, which is a grey grille high on the wall above the lift doors, as if they might see the man through it.\n\nHe has a dry, educated, slightly tired voice. It sounds as though it is reading.\n\n\"My name is Anselm Grieve. I am a commodore of the Concord's Lane Service. At eighteen hundred today, Kettle time, a fleet under my command entered the Corva system through the lane mouth your people call the Throat. It consists of thirty-eight vessels. Their positions are being transmitted to your traffic control as I speak, as a courtesy, so that there may be no misunderstanding about our strength or our intentions.\"\n\nMy mother's arm tightens on mine.\n\n\"The Concord of Vey is the lawful successor to the Halloran-Vey Combine. It holds, by acquisition from the Combine's receivers, all of the Combine's titles, contracts, claims and accounts, including the claim to the Corva system and everything in it. The Combine never relinquished that claim. No instrument of sale exists. The occupation of the moon Kettle, and of the installations on it, and of the Combine vessel _Patience_, is therefore unlawful, and has been unlawful for two hundred and sixty-three years.\"\n\nSomebody in the queue laughs, a short shocked bark of a laugh. Nobody joins in.\n\n\"The Concord has no wish to harm the people of Kettle. You are, in law, the Concord's tenants. Your labour and your debts, like your city, are its property; it has a lawful interest in your welfare. Accordingly I am instructed to offer the following terms. The governing council of the occupation will stand down. The Concord's officers will be admitted to the city and its installations. The accounts of all residents will be assessed and regularised. In return, there will be no reprisals, and no resident will be removed from Kettle without due process.\" A pause. A rustle, very faint, like paper. \"You have three days to consider these terms. On the fourth day, if they are not accepted, I am instructed to take such steps as are necessary to secure the Concord's property. I would ask you to believe that I take no pleasure in saying so. This message will repeat.\"\n\nIt repeats. We stand in the queue and listen to it again, word for word, the same dry tired voice, the same small rustle of paper in the same place. Halfway through the second time the lift comes, and nobody gets in.\n\n\"Thirty-eight ships,\" someone says.\n\n\"They can't. They can't just—\"\n\n\"Tenants.\" An old man near the front, a dye-worker from the Fifth by his hands, spits on the floor. \"Tenants. We'll see about tenants.\"\n\nMy mother says nothing. She is looking at the speaker grille with the same face she turned up to the Oculus: wet-eyed, open-mouthed, almost glad.\n\n\"The Lamp comes round,\" she says, very quietly, to nobody, \"the debt comes due.\"\n\n\"Mama. Don't.\"\n\n\"I'm only saying.\"\n\n\"Don't say it here.\"\n\nThe First Shareholder answers the Concord forty minutes later, on the same speakers. I'm in my mother's room on the Ninth by then, sitting on the end of her cot with my boots still on, and we listen to it together by the light of her work-lamp, with her filters laid out on the bench under it in their neat sooty rows.\n\nLucan Strand doesn't sound tired at all. He sounds the way he sounded in the nave: warm, unhurried, certain.\n\nHe says that the people of Patience have heard the Concord's message. He says that the city of Patience is a free city, established by lawful purchase in the year twenty-three ninety-one, and that it does not recognise the claim of the Concord of Vey or of any other body to its people, its labour, or its air. He says that he has spoken with the Council of Shareholders, and that the Council is unanimous. He says that the city has weathered worse than a fleet, that it was built by people who knew how to be patient, and that it will be patient now. He says that the dipper fleet is recalled and the surface locks are sealed and the city's defences, which have not been tested in a hundred years but which have been maintained, every one of them, are manned. He says that the people of Patience are not tenants. He says it the way you would say a thing about the weather.\n\n\"In the meantime,\" he says, \"the Council has adopted certain emergency measures, which will be posted on every tier tonight. I ask every citizen of Patience to observe them, for the common good. Our air is our life. We must husband it. Happy Lampfast, and good night.\"\n\nThe measures are posted at midnight. I read them on my wrist, sitting on my mother's cot, while she sleeps.\n\nThere are eleven of them. Most are what you'd expect: curfews, rationing of heat, a ban on unlicensed movement between tiers. The ninth says that the dipper fleet is suspended until further notice, which means that nobody will be going up into Gall's sky for fuel while there are thirty-eight Concord ships between us and it. The tenth says that the refinery reserves are to be husbanded accordingly.\n\nThe eleventh says that, for the duration of the emergency, the air-tithe payable by unshared households is doubled, and that the floor is lowered by a third, and that air-wardens are to apply the new rates from the first of the next cycle.\n\nI read it three times. Then I turn off my wrist, and sit in the dark with the fans sighing, and listen to my mother breathe.\n\nThe first slug hits the surface just before dawn.\n\nI don't know that's what it is. Nobody does. I'm asleep sitting up, and I wake because the whole city rings: a deep enormous note that comes up through the floor and the walls and the cot and my own bones, like being inside a struck bell. It goes on a long time. Ice dust sifts down from the ceiling and settles on my mother's filters. Somewhere above us, forty metres up, something has hit the shell of Kettle at a speed I can't imagine, and the whole moon has taken it and passed it down to us, tier by tier, all the way to the bottom of the sea.\n\nMy mother sits up in her cot with her hair full of frost.\n\n\"Isa,\" she says. \"Is it the Lamp?\"\n\n\"No, Mama,\" I tell her. \"It's the Concord.\"\n\nThe bell is still ringing.","wordCount":1201,"createdAt":1793093337079,"updatedAt":1793093848276}],"plotThreads":[],"motifs":[],"continuitySuppressions":[],"writingLogs":[{"id":"2CSdRBOGSZKY0wRV9zMZW","worldId":"qazoRpRKLPklIu-1YyQ3E","date":"2026-10-27","words":34041,"createdAt":1793092906996,"updatedAt":1793109049528}],"sceneRevisions":[{"id":"2X90kaM_uy-puNwkWYFHR","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"0T46v5SbLeM2hWt1bnUYG","text":"She found Abel at the third bell of the night, in the blister.\n\nThe blister was a dome of thick old glass on the _Patience_'s dorsal hull, a relic of the days when skimmers had carried passengers who wanted to look at things. It was cold, and badly lit, and the crew used it for courting and drinking and the kind of conversations that couldn't be had anywhere else, and nobody ever cleaned it. Abel was sitting on the floor with his back against the frame and a bottle of dock-still between his knees, looking up. He didn't turn round when she came in. He held the bottle up over his shoulder.\n\nShe took it, and drank, and gave it back, and sat down beside him.\n\nAbove them, through the scratched glass, Gall filled half the sky, ochre and purple, a storm the size of a world turning slowly on its southern limb. Above the storm, in the black, the Lamp hung like a thumbprint of light. It was brighter than it had been three days ago. You could see the tail properly now, a long faint fan of pale green going away from the sun, so delicate that if you looked straight at it it disappeared, and came back when you looked to the side.\n\n\"Teska says it takes the dead out,\" said Abel.\n\n\"Teska says a lot of things.\"\n\n\"She says it'll be back when our grandchildren are dead.\" He drank. \"That's a long time to be a comet.\"\n\n\"It's not a long time for a comet.\"\n\n\"No.\" He laughed a little. \"I suppose not.\" He held the bottle up to the glass and looked at the Lamp through it, through the cloudy brown spirit, so that it wobbled. \"I keep thinking about her. Lusine. Out there. Going in.\"\n\n\"So do I.\"\n\n\"You talked to her. The whole way. I heard you.\" He lowered the bottle. \"That was a good thing you did, Mar.\"\n\n\"I didn't do anything.\"\n\n\"You did, though.\" He turned his head and looked at her for the first time. His face was grey and his eyes were wet and red-rimmed, and she could not tell how much of it was the still. \"You always think you didn't do anything. You do more than anybody.\"\n\nShe looked at him for a long moment, at his handsome tired face in the Gall-light, her brother, whom she had carried on her hip through the third shaft when their mother went into the cloud.\n\n\"Were you seeing her, Abel?\"\n\nHe didn't move. He didn't look away. But she had known him all his life, and she saw the small thing happen behind his eyes, the thing that happened when he was eight and she asked him who had got into the dried fruit, the half-second of arithmetic.\n\n\"Seeing her?\"\n\n\"Lusine. Odile says she was seeing somebody. Somebody funny. Somebody always in debt who didn't care.\"\n\nAbel laughed. It was almost his real laugh. \"That's half the riggers on the ship.\"\n\n\"Were you?\"\n\n\"We were friendly.\" He shrugged. \"A bit. Now and then. She was—she was good fun, Mar. She liked a joke. We'd have a drink in the lock after shift. It wasn't serious. She wasn't serious about anybody.\" He drank. \"Why?\"\n\n\"Did she tell you anything? Before she died? About the _Clement_? About a dispatch?\"\n\n\"A dispatch?\" He frowned. \"What dispatch?\"\n\n\"Did she?\"\n\n\"No.\" He shook his head. \"No. Why would she tell me about a dispatch? I'm a rigger. I can barely read the duty board.\" He smiled at her, the old smile, _don't worry, it's me_. \"What's this about?\"\n\nMaren looked at the Lamp.\n\n\"Nothing,\" she said. \"It's late. I'm tired.\"\n\n\"You're always tired.\"\n\n\"I'm always tired.\"\n\nHe put his arm around her shoulders, the way he used to when he was sixteen and had just grown taller than her and wanted her to know it, and she let him, and they sat together in the cold blister and looked at the comet. His arm was warm and heavy and familiar. His hand, where it hung over her shoulder, was shaking, very slightly, with a small fine tremor, the kind of tremor that a man gets when he has been drinking for three days because he cannot stop seeing something.\n\nShe did not say anything about it. She sat there in her brother's arm and looked at the Lamp and thought, very clearly, _he's lying to me_, and then, because she was the tether-chief and that was what tether-chiefs did, she began to do the arithmetic.\n\n\n# Sanitation\n\n## The Belly\n\n[\n  Place: #The Belly\n  Characters: @@Maren Tsolo @@Odile Arda @@Grandam Teska @@Danek Sorell @@Corwin Hale @@Bram Kovac @@Abel Tsolo\n  When: 11 November 2391\n]\n\nUnder the drum there was a space nobody had ever found a use for.\n\nThe drum sat in a cradle of girders that went down through three decks to the keel, and between the girders, under the drum's great curved belly, the shipwrights had left a hollow the size of a chapel: a ribbed, dark, echoing void full of cable runs and bearing housings and old grease, where the noise of the drum when it was turning was so loud you could not hear your own voice, and when it was not turning, so quiet you could hear the hull tick. The crew called it the Belly. You got into it by a maintenance hatch behind the number four brake, and a ladder, and a long crawl on your hands and knees along a cable tray. Riggers went there to sleep off shifts and to do things they did not want logged. Wardens did not go there, because wardens were big men and the cable tray was narrow.\n\nMaren called the meeting for the fourth bell of the night, in the dead hour between dips, when the drum was still.\n\nEleven of them came. She had asked for twelve. They sat on the girders and the bearing housings in a rough ring, with one lamp turned low on the deck plates between them, and their faces came and went in its light: Teska, wrapped in two coats, with her white eye shining; Odile, very upright, very quiet; Danek Sorell, too big for the space, folded up on a girder with his knees under his chin; old Pirro from the Bucket crew; two dock hands, a married pair called Senna and Ivo, who between them knew every valve on the forward collar; three riggers Maren trusted and two she trusted less, because you needed the ones who talked as well as the ones who didn't. Ekene was not there. She had not asked him. A free man could be hanged for what the bonded only had their accounts reviewed for.\n\nAbel was not there either. She had asked him. He had said yes, and smiled, and not come.\n\n\"Read it,\" said Teska. \"Read the paper. I want to hear it in my own ears.\"\n\nMaren read it. She read it in the tether-chief's voice, without any expression at all, every line, the routing codes and the board resolution and the numbers, _est. 300_, _est. 2,100 households_, _supply to cease_. When she had finished nobody said anything for a long time. Somewhere in the hull below them a pump came on and ran and went off again.\n\n\"Sorrel,\" said Danek at last, in the same voice he had used in the hall. \"The forts.\"\n\n\"The forts.\"\n\n\"And the Camp.\"\n\n\"Three months. Four if they're careful.\"\n\n\"Tamar's got the cough already. She had it last winter.\" Danek looked at his own big hands. \"Four months she won't make.\"\n\n\"Nobody'll make it,\" said Pirro. \"Not the old ones. Not the little ones. The plant'll go first, then the heat. You'll have people burning their bunks.\" He spat into the dark. \"I was in the Camp when the third shaft caved in sixty-eight. We were nine days without the plant. I saw what nine days did.\"\n\n\"So we don't go,\" said Senna, from the dock. \"We refuse. Strike. They can't move three hundred people on to the _Clement_ if three hundred people won't walk.\"\n\n\"They can if they've got sticks.\"\n\n\"They've got six marines and a dozen trusties. We're three hundred.\"\n\n\"And the _Admonition_,\" said Maren. \"Two weeks behind the factor. Sixty marines and a torpedo bay. Due on the twenty-second.\" She looked round the ring. \"And then they don't need us to walk.\"\n\n\"Then we take the ship,\" said Teska.\n\nThey all looked at her. She was sitting hunched on her bearing housing in her two coats, very small, with her good eye glittering in the lamp.\n\n\"We take her,\" she said. \"She's ours. We built her. Well, they built her, but we've had her sixty years; we've kept her flying when they wouldn't send the parts. Every bolt in her's been turned by one of us. We take her and we don't sink her. We keep dipping. We keep the Camp breathing.\" She shrugged inside the coats. \"Let the Combine come and get her.\"\n\n\"The Combine will,\" said Maren.\n\n\"Then we'll be dead in a month instead of four. I'm eighty-three. I can spare a month.\"\n\n\"Danek's children can't.\"\n\n\"Danek's children,\" said Teska, with great gentleness, \"are going to die on the ice anyway, Maren. That paper says so. All you're doing is choosing which way.\"\n\nNobody said anything to that.\n\nMaren had known it was coming. She had known since the night in the Shelf, with the foil in her hand and Odile's face in front of her, that it would come to this: a ring of tired people in the dark under the drum, with nothing in front of them but a wall, and somebody saying the thing out loud. She had spent four days running the arithmetic, in the gallery, at the board, in Ekene's bunk with her eyes open. It came out the same every time. Strike, and they would be broken. Comply, and the Camp would die. Fight, and the _Admonition_ would come, and then the Camp would die and so would they.\n\n\"If we take her,\" she said, \"we have to take the _Clement_ too. Same night. Same hour. Otherwise the factor gets on her and casts off and he's two weeks from the _Admonition_ and he tells them everything. And the _Clement_'s got the marines, and the marines have guns.\"\n\n\"How many?\"\n\n\"Six. Sergeant called Oyelowo. They're good. They're not like the trusties. They've done this before.\"\n\n\"We'll need sticks,\" said a voice from the dark at the edge of the ring. \"At least.\"\n\nThe lamp didn't reach where it came from. It didn't need to. Everybody knew that voice, soft and patient and reasonable, and the ring went still the way a rigger goes still on the line when the trace jumps.\n\nCorwin Hale came forward into the light at his slow walk, ducking under a girder. Behind him, in the dark, Maren could see the shape of Bram Kovač crouched at the end of the cable tray, blocking it.\n\n\"I'm sorry to interrupt,\" said Hale. \"I didn't mean to listen. Sound carries in here. It's a terrible place for a secret.\"\n\n\"How did you get in?\" said Odile. \"The tray's too narrow for you.\"\n\n\"There's a hatch from the keel side, if you know where it is.\" Hale smiled faintly. \"I've been on this ship twenty years, Arda. I know where everything is.\" He looked round the ring. His eyes rested on each of them in turn, mild and unhurried, as if he were taking a register: Teska, Danek, Pirro, Senna, Ivo, the riggers. Last of all he looked at Maren. \"May I sit down?\"\n\nNobody answered. He sat anyway, on the end of Pirro's girder, so that the old man had to shift up.\n\n\"You've read the dispatch,\" he said. \"I know you have. Arda's sister had it in her boot. I've been waiting for you to do something about it.\" He folded his big hands on his knee. \"I'm on the list too, you know. I'm bonded. I've got an account. My mother's in the Camp, on the second shaft, and she's sixty-eight, and she doesn't have four months either.\" He looked at Danek. \"Trusties go to Sorrel with everybody else, Sorell. They don't need wardens on the forts. They've got officers for that. I'll be filling sandbags beside you.\"\n\n\"You'll be filling sandbags,\" said Teska, \"when Gall freezes.\"\n\n\"Grandam,\" said Hale, \"I know what you think of me. I know what you all think of me. You think I'm the Combine's dog. You're right. I've been the Combine's dog for twenty years, because the Combine fed me.\" He opened his hands. \"The Combine's stopped feeding me. That's all. I'd like to eat.\"\n\n\"What are you offering?\" said Maren.\n\n\"Twelve trusties with sticks. The keys to the bridge and the armoury, such as it is. Two old flechette carbines that the Combine forgot it issued. And the warden's office, which means the logs, which means that whatever happens, the Combine won't hear about it from this ship until we want it to.\" He met her eyes. \"And me. Who knows where everything is.\"\n\nMaren looked at him. She thought of Lusine's voice on channel four. _I told someone._ She thought of Quist across Moberly's desk, turning his coffee cup: _I'd look at who on this ship would have wanted the Combine to be grateful to them._ She thought of the form on Hale's slate, already filled in, in his neat hand, before she ever came down the gallery ladder.\n\nShe thought of six marines with guns.\n\n\"What's Schedule H?\" she said.\n\nHale blinked. \"I'm sorry?\"\n\n\"In the dispatch. Paragraph five. _Contingency authority, Schedule H, confirmed._ What's Schedule H?\"\n\n\"I've no idea,\" said Hale. \"Factors' business. I'm a warden.\" He shrugged. \"Contingency means _if things go wrong_. I expect it means the _Admonition_.\"\n\nHe said it easily. Maren watched him say it. She could not tell. She had been watching Hale for twenty years, and she had never once been able to tell what was behind that mild patient face, and she could not tell now.\n\n\"We'll think about your offer,\" she said.\n\n\"Don't think too long,\" said Hale, getting up. \"The twenty-second isn't far.\" He looked round the ring once more, taking his register. \"And none of you need worry about me. I can keep a secret. I've kept a great many.\" He ducked back under the girder into the dark, and they heard him go, slow and heavy, toward his hatch in the keel; and after a moment Bram Kovač's shape at the end of the cable tray went too.\n\nThe ring sat in silence.\n\n\"Well,\" said Pirro. \"Now we have to.\"\n\n## A crushed hand\n\n[\n  Place: #The infirmary\n  Characters: @@Ekene Adu @@Maren Tsolo\n  When: 11 November 2391\n]\n\nThe _Clement_'s crew were not bonded. They were Combine contract hands, hired for the run at Halloran, and they kept to their own ship mostly, and looked at the _Patience_'s bonded the way people look at animals in a pen: without malice, without much interest. But the _Clement_'s medic had been left at Halloran with a fever, and so when one of her cargo hands got his left hand caught in the closing door of a cold-hold hatch, on the morning of the eleventh, they brought him across the collar to Ekene.\n\nMaren heard about it from Ekene that evening. She came to the infirmary after the second dip and found him at the counter, not writing, sitting with his reading lenses in his hand and his face the colour of the counter.\n\n\"His name's Brandt,\" Ekene said. \"Yusuf Brandt. He's twenty-three. He's from Halloran, from the yards. He's never been out of the inner lanes before. He thinks Corva is the most boring place he has ever been in his life.\" He turned the lenses over. \"I had to take two fingers. The hatch was a cryo-hatch, the heavy kind, with the frost seals. It crushed them flat. So I gave him a lot of the good painkiller, which the Combine charges at nine marks a dose, and while I was working, he talked.\"\n\n\"What about?\"\n\n\"About his ship. About the cold hold. About how he's on cold-hold duty this run, which means checking the cryostats every four hours, and how it's the worst duty on the ship because the hold's at sixty below and the gloves are useless. About how there's nothing in the cold hold this run except the usual medical stocks and one other thing.\" Ekene put the lenses down on the counter, very carefully. \"About how the factor comes down to look at the other thing every day. Every single day. With the sergeant. And stands and looks at it. And how the hands call it the egg.\"\n\nMaren said nothing.\n\n\"I asked him what kind of egg,\" said Ekene. \"He laughed. He said a grey one, about this long\"—he held his hands apart, the length of a forearm and a half—\"in its own cryostat, with its own power and its own alarm, and a stencil on the casing that he'd read so many times on cold-hold duty he could say it in his sleep. And then he said it for me. In his sleep, nearly. The painkiller was very good.\" Ekene looked at her. \"_Sanitation Agent. Pattern H. Factor's authority only._\"\n\n\"Pattern H.\"\n\n\"Schedule H. Pattern H.\" His voice was steady and quite empty. \"I've seen that stencil before, Maren. I didn't think I'd ever see it again. I think I came to the end of the lanes so that I wouldn't.\"\n\n\"Tamsin's Rock,\" said Maren.\n\nHe closed his eyes.\n\n\"Tell me,\" she said.\n\n\"Not here.\" He opened them again and looked toward the curtained bay where Yusuf Brandt was asleep, two fingers lighter, dreaming his painkiller dreams of Halloran. \"Not tonight. I need to know you've seen it first. I need to know I'm not a frightened old man hearing things in a boy's babbling.\" He put out his hand and took hers on the counter, hard, the way he never did, his long gentle fingers cold as the cold hold. \"If it's there, Maren, then everything you've been planning in the Belly is something else. Everything. Do you understand? You can't take a ship with that thing on the other end of the collar. You can't do anything.\"\n\n\"I can look at it,\" said Maren.\n\n## The cold hold\n\n[\n  Place: #The cold hold\n  Characters: @@Maren Tsolo @@Odile Arda @@Marta Oyelowo @@Aurelian Quist\n  Items: ^The Hush:#The cold hold\n  When: 12 November 2391\n]\n\nThe _Clement_ was mated to the _Patience_ at the forward collar, a great ring of armoured coupling with its own lock and its own guard, and on the _Clement_'s side of the collar there was a marine on duty all day and all night. There was no going through the collar.\n\nThere was going round it.\n\n\"It's eleven metres,\" said Odile, in the suit lock on the forward hull, checking Maren's harness for the third time. \"Outside. Along the collar fairing, then down the _Clement_'s spine to her number two maintenance hatch, which opens from outside, because they always do, in case somebody's stuck in a hold. Senna says the hatch is never alarmed. Senna says nobody on the _Clement_ thinks anybody's mad enough to go outside.\"\n\n\"Senna's never been outside.\"\n\n\"Senna's never been mad.\" Odile snapped the last clip and pulled on it. \"We're runners, Chief. Eleven metres is nothing. Eleven metres is the length of the drum hall.\"\n\n\"Eleven metres with Gall underneath it.\"\n\n\"Gall's always underneath it.\" Odile looked at her through her visor, her young fierce face very pale in the lock lights. \"You were a runner. You told me. You did four years at twenty kilometres. Before Hesketh made you chief.\"\n\n\"I was younger.\"\n\n\"You were braver,\" said Odile, and opened the outer door.\n\nIt was the second bell of the night shift, the dead time, and the hull was dark. They went out on to it on their hands and knees, clipped to a running line that Odile had rigged the night before, along the dorsal fairing of the collar, where the two ships' hulls met in a seam of scarred armour. Above them, to the left, the black was full of stars and the Lamp, which had grown again, a long pale streamer of light now with its tail split in two. Below them, to the right, was Gall.\n\nMaren had not been outside the _Patience_ in nine years. She had forgotten. You forgot, on the gallery, with the board in front of you and the line a green trace on a screen. You forgot that the line was real, that it hung down out of the keel slot into that, into the endless ochre floor of the world, banded and boiling and so close it seemed you could reach down and put your hand in it. You forgot the size of it. Lusine had fallen into it from eleven kilometres. From here, Maren thought, holding the running line with both hands and not looking down, from here you would fall for a long time.\n\n\"Don't look at it, Chief,\" said Odile on the suit channel. \"Look at your hands.\"\n\n\"I know.\"\n\n\"I know you know.\"\n\nThey went along the collar fairing and down the _Clement_'s long dull spine, hand over hand, past the green wheel of the Combine painted twenty metres high on her flank and lit from below by Gall-shine, so that it looked like a rusted sun. The number two maintenance hatch was where Senna had said it would be, a square of grey armour set flush in the hull with a recessed handle and a stencil that said NO ENTRY EXCEPT IN EMERGENCY. It was not alarmed. Odile opened it, and they went in feet first, and pulled it to behind them.\n\nThe cold hold was very dark and very cold, so cold that the moment the inner door of the maintenance lock opened, Maren's visor frosted at the edges and her suit heaters came on with a whine. They switched their lamps on low.\n\nIt was a long low hold, ribbed like the inside of a fish, with racks of sealed medical crates along both sides under a rime of frost, and at the far end, by itself, in a clear space on the deck, a cryostat.\n\nIt was smaller than she had imagined. A cylinder of brushed grey steel on a squat base, waist-high, with a ring of status lights round its upper rim glowing a steady green, and a frosted window in its lid. A thick power cable ran from its base to a socket in the hold wall. A second, thinner cable ran from its side to a box on the wall beside the socket, a grey box with a single red light on it and a keyhole.\n\nMaren went and stood beside it. She did not touch it. She bent and looked through the frosted window in the lid.\n\nInside the cryostat, cradled in a nest of white foam that smoked faintly with cold, lay an egg.\n\nIt was grey. Matte grey, the grey of good ceramic, without any shine at all, so that the lamp's light seemed to sink into it rather than lie on it. It was about the length of her forearm and a half, smooth, slightly irregular, like a real egg, an egg from some enormous bird; and it had a seam running round its widest part, very fine, like the join of a cup and a saucer. On its upper surface, stencilled in black, in neat Combine capitals, were three lines.\n\n  SANITATION AGENT\n  PATTERN H\n  FACTOR'S AUTHORITY ONLY\n\nBeneath the lines, small, the green wheel of Halloran-Vey.\n\nOdile came and looked over her shoulder. Her breath frosted the inside of her visor.\n\n\"What is it?\" she whispered.\n\n\"I don't know,\" said Maren.\n\nThat was true. It was also, she understood even as she said it, the last true thing she would be able to say about it. Because she was looking at it, at its smooth grey indifferent surface in its nest of smoking foam, and the cold of the hold was coming in through her suit, and something in the back of her skull, some old animal thing that had lived through twenty-six years on the line, was telling her very clearly and very quietly to back away.\n\nThere was a sound at the hold's forward end. A door.\n\nOdile caught Maren's arm. They killed their lamps together and stood still in the dark, by the cryostat, with its ring of green lights glowing between them; and the forward door of the cold hold slid open and let in a wedge of yellow light, and in the wedge, two figures in heavy cold-weather jackets with the green wheel on the shoulder. A short broad woman with a sidearm. A tall thin man.\n\n\"Every day,\" said Sergeant Oyelowo's voice, flat and bored, echoing down the hold. \"You know it's still there, sir. The board says it's still there. The light's green.\"\n\n\"I know,\" said Quist. \"Humour me, Sergeant.\"\n\nHe did not come in. He stood in the doorway in the wedge of light with his hands in the pockets of his jacket, looking down the long dark hold toward the cryostat; looking, it seemed to Maren, straight at her, though he could not have seen her, with her lamp out, behind the glow of the status lights. He stood there for a long moment. His face was in shadow. Then he took one hand out of his pocket and touched something at his throat, a cord, a small shape on it that caught the light for an instant, the size of a key.\n\n\"Thank you, Sergeant,\" he said, and stepped back, and the door slid shut.\n\nThey stood in the dark for a long time afterward.\n\n[\n  Place: #The infirmary\n  Characters: @@Maren Tsolo @@Ekene Adu\n  When: 12 November 2391\n]\n\n\"They called it the Hush,\" Ekene said.\n\nIt was the fourth bell. The infirmary was dark except for the lamp on the counter, turned so low it was hardly more than a coal. Yusuf Brandt had been sent back to his own ship in the afternoon with his hand in a sling and a note to the factor. The bunks were empty. Ekene sat on the end of the nearest one with Maren beside him, both of them still in their clothes, and the cups of his smoked tea on the deck at their feet, cold.\n\n\"Not the Combine. The Combine calls it Sanitation Agent, Pattern H. The men who use it call it the Hush. Because that's what it does.\" He was looking at the port, where the Lamp hung over Gall's limb. \"Tamsin's Rock was an ice-mining station in the Penner lanes. Four thousand bonded. Families, mostly, three generations of them, because the Rock was old. In seventy-nine the price of ice dropped and the Combine cut the air ration, and the Rock struck. They locked out the factor and the wardens and they sat in their warrens and said they would not dig another metre until the ration came back. They were very orderly about it. They kept the plant running. They kept the infirmary open. They sent a petition to Halloran.\" He paused. \"The factor at the Rock had a Schedule H authority.\"\n\nMaren said nothing.\n\n\"It's an aerosol,\" said Ekene. \"That's all it is, in the end. An engineered thing, very small, that likes one sort of tissue and only that sort. Human nerve. Nothing else. Not rats, not plants, not machines. You let it into a habitat's air and the air system does the rest; it goes through every vent in an hour. It doesn't hurt. They told us that, after, the Combine's doctors, as if it were a kindness. You get tired. You get very quiet. People sat down where they were and went to sleep. In their bunks. At their tables. In the crèche.\" He swallowed. \"In six hours there was nobody awake on Tamsin's Rock. In ten there was nobody alive. And the plant ran on. And the lights. And the infirmary's machines went on monitoring the patients in the beds, beeping, for two days, until the power ran down.\"\n\n\"You were there.\"\n\n\"I was a contract medic in the Penner lanes. They sent four of us in, afterward, with a Combine sanitation crew, to certify. That was the word. Certify.\" He laughed, a terrible small sound. \"We had to go through every room. Every bunk. Every child. And write down the time we thought they'd died, so the Combine could close the accounts properly. It took us eleven days.\"\n\nThe Lamp hung in the port.\n\n\"The agent stays in the air for a few days and then it settles,\" Ekene said. \"It goes dormant, like a spore. The sanitation crew sealed the Rock and pumped it hard vacuum and baked it, and then they let it sit for a year. And then they shipped in four thousand new bonded from the Kessel yards and opened it up again and started digging.\" He looked at his hands. \"It was turning a profit inside eighteen months. They used it in the Combine's own reports. As an example of what could be achieved.\"\n\n\"Why didn't you stop?\" Maren said. \"Being a medic for them. After.\"\n\n\"I did. I came here.\" He turned and looked at her in the dark. \"I came to the end of the lanes, Maren, to the most worthless operation the Combine had, so that nothing like that could ever happen around me again. Because who'd waste a Pattern H on Corva? Who'd bother?\" His voice cracked. \"And now there's one on the other side of the collar. With your factor checking it every day.\"\n\n\"Why bring it?\" Maren said. \"If they're just leaving. If the Camp's going to die anyway. Why bring that?\"\n\n\"In case the leaving isn't quiet,\" said Ekene. \"Schedule H. Contingency. You saw the dispatch. _Factor to manage expectations._\" He took her hand. \"If we take the ship, Maren, they won't send the _Admonition_ to fight us. Why would they? The _Admonition_ is expensive. Marines are expensive. They'll just tell the factor to open the box. One cryostat. One key. And then they'll wait a year and send somebody else to dip Gall, if they ever want to dip Gall again. Or not. It doesn't matter to them. That's the point. It doesn't matter.\"\n\nMaren sat in the dark beside him with his cold hand in hers.\n\nShe thought of Quist in the doorway of the cold hold, with his hands in his pockets, looking. Every day. _Humour me, Sergeant._ She thought of the key at his throat.\n\nShe thought of the Belly, and the ring of tired faces in the lamplight, and Teska saying _We take her_. She thought of Hale's mild voice in the dark: _I'll be filling sandbags beside you_. She thought of eleven metres of hull with Gall underneath.\n\nShe did the arithmetic. It came out differently now. It came out, she realised, sitting there, with the Lamp brightening in the port and the egg asleep in its smoking foam across the collar, the only way it could have come out from the moment she bent over that frosted window and the old animal at the back of her skull told her to back away.\n\n\"We don't take the ship first,\" she said.\n\nEkene looked at her.\n\n\"We take the egg,\" said Maren Tsolo. \"Before anything. Before they know we're coming. We take the egg and the key, and then we see who wants to talk about Sorrel.\"\n","wordCount":5307,"createdAt":1793108901791},{"id":"4ZXuWr1fYZKeYQY3NKlNm","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"uQcRzgdnq8Q_9APiGoKBS","text":"The Concord comes through the Throat during the evening bells.\n\nI'm on the Fourth by then, taking my mother home the long way round by the lifts, because she can't do the stairs any more. We're in the lift queue at Fourth Central when every speaker in the city clicks at once. That's what I remember: the click. Every speaker on every tier, all together, a single dry sound like a knuckle on a table, and then the hiss of an open channel, and then a voice.\n\n\"This is a message to the people of Kettle from the Concord of Vey.\"\n\nThe queue goes quiet. Everyone looks at the nearest speaker, which is a grey grille high on the wall above the lift doors, as if they might see the man through it.\n\nHe has a dry, educated, slightly tired voice. It sounds as though it is reading.\n\n\"My name is Anselm Grieve. I am a commodore of the Concord's Lane Service. At eighteen hundred today, Kettle time, a fleet under my command entered the Corva system through the lane mouth your people call the Throat. It consists of thirty-eight vessels. Their positions are being transmitted to your traffic control as I speak, as a courtesy, so that there may be no misunderstanding about our strength or our intentions.\"\n\nMy mother's arm tightens on mine.\n\n\"The Concord of Vey is the lawful successor to the Halloran-Vey Combine. It holds, by acquisition from the Combine's receivers, all of the Combine's titles, contracts, claims and accounts, including the claim to the Corva system and everything in it. The Combine never relinquished that claim. No instrument of sale exists. The occupation of the moon Kettle, and of the installations on it, and of the Combine vessel _Patience_, is therefore unlawful, and has been unlawful for two hundred and sixty-three years.\"\n\nSomebody in the queue laughs, a short shocked bark of a laugh. Nobody joins in.\n\n\"The Concord has no wish to harm the people of Kettle. You are, in law, the Concord's tenants. Your labour and your debts, like your city, are its property; it has a lawful interest in your welfare. Accordingly I am instructed to offer the following terms. The governing council of the occupation will stand down. The Concord's officers will be admitted to the city and its installations. The accounts of all residents will be assessed and regularised. In return, there will be no reprisals, and no resident will be removed from Kettle without due process.\" A pause. A rustle, very faint, like paper. \"You have three days to consider these terms. On the fourth day, if they are not accepted, I am instructed to take such steps as are necessary to secure the Concord's property. I would ask you to believe that I take no pleasure in saying so. This message will repeat.\"\n\nIt repeats. We stand in the queue and listen to it again, word for word, the same dry tired voice, the same small rustle of paper in the same place. Halfway through the second time the lift comes, and nobody gets in.\n\n\"Thirty-eight ships,\" someone says.\n\n\"They can't. They can't just—\"\n\n\"Tenants.\" An old man near the front, a dye-worker from the Fifth by his hands, spits on the floor. \"Tenants. We'll see about tenants.\"\n\nMy mother says nothing. She is looking at the speaker grille with the same face she turned up to the Oculus: wet-eyed, open-mouthed, almost glad.\n\n\"The Lamp comes round,\" she says, very quietly, to nobody, \"the debt comes due.\"\n\n\"Mama. Don't.\"\n\n\"I'm only saying.\"\n\n\"Don't say it here.\"\n\nThe First Shareholder answers the Concord forty minutes later, on the same speakers. I'm in my mother's room on the Ninth by then, sitting on the end of her cot with my boots still on, and we listen to it together by the light of her work-lamp, with her filters laid out on the bench under it in their neat sooty rows.\n\nLucan Strand doesn't sound tired at all. He sounds the way he sounded in the nave: warm, unhurried, certain.\n\nHe says that the people of Patience have heard the Concord's message. He says that the city of Patience is a free city, established by lawful purchase in the year twenty-three ninety-one, and that it does not recognise the claim of the Concord of Vey or of any other body to its people, its labour, or its air. He says that he has spoken with the Council of Shareholders, and that the Council is unanimous. He says that the city has weathered worse than a fleet, that it was built by people who knew how to be patient, and that it will be patient now. He says that the dipper fleet is recalled and the surface locks are sealed and the city's defences, which have not been tested in a hundred years but which have been maintained, every one of them, are manned. He says that the people of Patience are not tenants. He says it the way you would say a thing about the weather.\n\n\"In the meantime,\" he says, \"the Council has adopted certain emergency measures, which will be posted on every tier tonight. I ask every citizen of Patience to observe them, for the common good. Our air is our life. We must husband it. Happy Lampfast, and good night.\"\n\nThe measures are posted at midnight. I read them on my wrist, sitting on my mother's cot, while she sleeps.\n\nThere are eleven of them. Most are what you'd expect: curfews, rationing of heat, a ban on unlicensed movement between tiers. The ninth says that the dipper fleet is suspended until further notice, which means that nobody will be going up into Gall's sky for fuel while there are thirty-eight Concord ships between us and it. The tenth says that the refinery reserves are to be husbanded accordingly.\n\nThe eleventh says that, for the duration of the emergency, the air-tithe payable by unshared households is doubled, and that the floor is lowered by a third, and that air-wardens are to apply the new rates from the first of the next cycle.\n\nI read it three times. Then I turn off my wrist, and sit in the dark with the fans sighing, and listen to my mother breathe.\n\nThe first slug hits the surface just before dawn.\n\nI don't know that's what it is. Nobody does. I'm asleep sitting up, and I wake because the whole city rings: a deep enormous note that comes up through the floor and the walls and the cot and my own bones, like being inside a struck bell. It goes on a long time. Ice dust sifts down from the ceiling and settles on my mother's filters. Somewhere above us, forty metres up, something has hit the shell of Kettle at a speed I can't imagine, and the whole moon has taken it and passed it down to us, tier by tier, all the way to the bottom of the sea.\n\nMy mother sits up in her cot with her hair full of frost.\n\n\"Isa,\" she says. \"Is it the Lamp?\"\n\n\"No, Mama,\" I tell her. \"It's the Concord.\"\n\nThe bell is still ringing.\n","wordCount":1201,"createdAt":1793093847483},{"id":"Bzu8sgXF_4drfvsWUFKNA","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"F6DSf6VLOavx87_UDZc5D","text":"The _Dray_ is not beautiful.\n\nTil will be the first to say it. She's a deep-salvage tug of the old Tarn pattern, built sixty years ago for hauling dead hulks off the Harrow and the other wreck-fields of the outer Reach, and she looks it: a squat, blunt, armoured wedge of a hull, scarred and patched and painted over so many times that nobody knows any more what colour she started, with a stubby drive cluster at the back, a long grapple-and-winch boom slung under her belly like a folded insect's leg, and a forward cabin so small that two people can only pass in it if one of them is asleep. She has a fusion core that runs hot and an air plant that runs cold and a winch that will haul a hundred kilometres of cable and has hauled most of it. She is slow. She is ugly. She cannot be killed. Til has tried.\n\nOz spends two days going over her from the drive cones to the forward lamps, while Til spends two days spending other people's money. They buy cable. They buy reaction mass. They buy air, eleven tanks of it, more air than the _Dray_ has carried at one time in her life; they buy ice-anchors and screw-pitons and a thermal lance and two new pressure suits, one of them small, which Til buys without saying anything and Oz watches her buy without saying anything either. They buy food. Cato Marchetti comes down to the dock twice to look things over and goes away again, courteous, attentive, saying almost nothing; on the second visit he brings four long crates of his own, sealed, and asks for them to go in the cargo bay, and Til opens one with Oz standing by, because it's her ship, and finds medical supplies, and closes it again.\n\n\"He didn't mind,\" says Oz, afterward. \"You opening it.\"\n\n\"No.\"\n\n\"He wanted you to.\"\n\n\"Yes,\" says Til.\n\nThey're in the cargo bay, on the night before departure, stowing the last of the cable. The bay's lit by work-lamps clipped to the ribs and smells of old grease and cold metal and the dust that gets into everything on Cinderhaven, fine grey dust from the ring's ore-mills that you can taste for a week after you leave. Oz is coiling cable on to a drum with his delicate hands, talking to himself in the old Roundsman cant his mother taught him, half prayer and half swearing.\n\n\"My mother's people came out of Corva,\" he says, unexpectedly.\n\nTil looks up from the anchors. \"You never said.\"\n\n\"You never asked. It was a long way back. Two hundred years and more. Before the lane went dark.\" He finishes the coil, ties it off. \"Dippers. They used to go down into the giant's air on ropes, she said, forty kilometres of rope, and scoop the weather up in a bucket. And when they died they gave them to the giant. Lowered them down on the rope and let them go. And they had the comet, and they had a saying about it. The Lamp takes the dead out and brings them back.\" He picks up the next coil. \"That's where we got it. The Roundsmen. All of it. The salt and the loops and the going-out. It's dipper stuff. It's from Corva.\"\n\n\"Then the Hoard's dipper stuff too.\"\n\n\"The Hoard's drunk stuff,\" says Oz. \"There's no Hoard. Dippers didn't have anything to hoard. They had debts.\" He tugs the cable. \"But it's funny. That we're going there. Back round.\"\n\n\"It's not funny. It's thirty thousand marks.\"\n\n\"That too.\"\n\nThe hatch at the forward end of the bay grinds open and lets in a slab of yellow dock light, and a figure in it with a bag over its shoulder.\n\nJuno has a grey house coat on over a rigger's undersuit, and a cheap pair of dock boots, and the bag, which is small and old and has belonged to someone else before her. She stops in the hatch. She looks at Oz, and at the cable, and at the work-lamps, and at the stained ribs of the hull, and finally at Til.\n\n\"Mother Szabo sent me,\" she says.\n\n\"I know.\"\n\n\"I'm to witness the recovery. And log the cargo. And report back to the house.\" She says it like something learned off a slate. \"I'm not crew. I'm not under your orders. Mother Szabo says if you put me to work I'm to log it and she'll bill you.\"\n\n\"That sounds like her.\"\n\n\"Where do I sleep?\"\n\n\"There's a bunk aft of the galley,\" Til says. \"It's the warm one. There's a new suit in the locker by it that ought to fit you. You'll need to try it before we go through the lane. Oz will check your seals.\"\n\nJuno looks at her for a long moment. Til waits for it, whatever it's going to be, and is ready for it, she thinks; she has had eleven years to get ready for it.\n\n\"Don't talk to me,\" says Juno Brask, quite politely. \"Unless it's about the job.\"\n\nShe goes past them down the bay toward the galley hatch, and Oz moves out of her way with his coil of cable, and she doesn't look at either of them; and then the galley hatch closes behind her and it's just the two of them in the work-light with the cable and the cold.\n\nOz goes back to his coiling. After a while he says, without looking up, \"She's got Mags's walk.\"\n\n\"I know.\"\n\n\"Tall, though. Taller than Mags. That's from the father, whoever he was.\"\n\n\"I know, Oz.\"\n\n\"She'll come round.\"\n\n\"She won't,\" says Til. \"And she shouldn't.\"\n\nThe client comes aboard at the first bell of the morning, an hour before the departure slot. Til has been expecting a sick old man in a chair. What comes up the ramp out of the dock's grey half-light is a coffin.\n\nIt's a medical cradle, she knows that; she's seen them before, on the Directorate's hospital ships, though never one this fine. It's a long, low, gleaming shell of white composite on a powered sled, with a clear canopy over the upper half and racks of quiet instruments along its sides, humming. Two dock porters walk it up the ramp, and Cato Marchetti walks behind it with a hand resting lightly on its rim, the way a man walks beside a horse. Under the canopy, propped on pillows, is Hollis Vey.\n\nHe is very thin. That's the first thing. He's a long man, and the illness has eaten everything from him but the length, so that he lies in his white shell like a heron in a nest, all bones and joints. His skin has the papery yellow-grey of the very sick. His hair is white and wispy and was once, you can see, thick and fair. He's seventy, perhaps, or a hard sixty. His eyes are pale blue, and wet, and completely alert, and they move over the _Dray_'s cargo bay, its ribs and its lamps and its drums of cable, with an expression that Til, after a moment, recognises as delight.\n\n\"Captain Brask,\" he says. His voice comes through a speaker grille in the cradle's rim, thin and dry and slightly delayed. \"Forgive me for not getting up.\"\n\n\"Mr Vey.\"\n\n\"This is a very ugly ship.\"\n\n\"Yes.\"\n\n\"Good.\" He smiles. His teeth are perfect and slightly too large for his face. \"Ugly ships last. My family built beautiful ones. You'll notice we haven't got any left.\" He turns his head on the pillow, with some effort, to look at her properly. \"Mother Szabo tells me you're the best deep-salvage captain on the Ring.\"\n\n\"Mother Szabo tells people what makes her money.\"\n\n\"Then we understand each other. She also tells me you've no wish to know my business, which I very much appreciate, and which I don't for a moment believe.\" The pale eyes are amused. \"We have a long way to go together, Captain. I'll tell you my business, when I've decided how much of it I can bear to say aloud. In the meantime, I would be grateful for a place to plug this thing in, and a window, if your ship runs to windows. I'd like to see it, when we get there.\"\n\n\"The Lamp?\"\n\n\"Corva,\" says Hollis Vey. \"All of it. My family hasn't seen it in five hundred years.\"\n\nThey undock at the second bell. Til takes the _Dray_ out herself, by hand, the way she always does, backing her off the dock on her manoeuvring jets with the yard-master swearing at her on the traffic channel for doing it by hand, and swings her round in the long shadow of the ring, and lights her drive. Cinderhaven falls away behind them, a great grey wheel turning slowly in the light of Tarn, with its docks and its chapels and its stone vaults full of paper. Ahead, two days off, is the Throat of the Corva lane.\n\nOz comes up into the cockpit as the ring shrinks. He leans on the back of her chair and looks at the rear display for a while without saying anything.\n\n\"Something just came off the ring behind us,\" he says. \"Dock Two. Big hull. Running quiet.\"\n\nTil looks. She knows the hull. Everybody on Cinderhaven knows the hull: a long black repossession cutter with a ram bow and four turrets, the house mark of a ledger and a pen painted small on her flank, the _Carrion Hymn_.\n\n\"Well,\" says Til. \"Mother's coming too.\"\n","wordCount":1599,"createdAt":1793108732972},{"id":"COL-j1GQOqvngJOGCLFAR","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"uQcRzgdnq8Q_9APiGoKBS","text":"The Concord comes through the Throat during the evening bells.\n\nI'm on the Fourth by then, taking my mother home the long way round by the lifts, because she can't do the stairs any more. We're in the lift queue at Fourth Central when every speaker in the city clicks at once. That's what I remember: the click. Every speaker on every tier, all together, a single dry sound like a knuckle on a table, and then the hiss of an open channel, and then a voice.\n\n\"This is a message to the people of Kettle from the Concord of Vey.\"\n\nThe queue goes quiet. Everyone looks at the nearest speaker, which is a grey grille high on the wall above the lift doors, as if they might see the man through it.\n\nHe has a dry, educated, slightly tired voice. It sounds as though it is reading.\n\n\"My name is Anselm Grieve. I am a commodore of the Concord's Lane Service. At eighteen hundred today, Kettle time, a fleet under my command entered the Corva system through the lane mouth your people call the Throat. It consists of thirty-eight vessels. Their positions are being transmitted to your traffic control as I speak, as a courtesy, so that there may be no misunderstanding about our strength or our intentions.\"\n\nMy mother's arm tightens on mine.\n\n\"The Concord of Vey is the lawful successor to the Halloran-Vey Combine. It holds, by acquisition from the Combine's receivers, all of the Combine's titles, contracts, claims and accounts, including the claim to the Corva system and everything in it. The Combine never relinquished that claim. No instrument of sale exists. The occupation of the moon Kettle, and of the installations on it, and of the Combine vessel _Patience_, is therefore unlawful, and has been unlawful for two hundred and sixty-three years.\"\n\nSomebody in the queue laughs, a short shocked bark of a laugh. Nobody joins in.\n\n\"The Concord has no wish to harm the people of Kettle. You are, in law, the Concord's tenants. Your labour and your debts, like your city, are its property; it has a lawful interest in your welfare. Accordingly I am instructed to offer the following terms. The governing council of the occupation will stand down. The Concord's officers will be admitted to the city and its installations. The accounts of all residents will be assessed and regularised. In return, there will be no reprisals, and no resident will be removed from Kettle without due process.\" A pause. A rustle, very faint, like paper. \"You have three days to consider these terms. On the fourth day, if they are not accepted, I am instructed to take such steps as are necessary to secure the Concord's property. I would ask you to believe that I take no pleasure in saying so. This message will repeat.\"\n\nIt repeats. We stand in the queue and listen to it again, word for word, the same dry tired voice, the same small rustle of paper in the same place. Halfway through the second time the lift comes, and nobody gets in.\n\n\"Thirty-eight ships,\" someone says.\n\n\"They can't. They can't just—\"\n\n\"Tenants.\" An old man near the front, a dye-worker from the Fifth by his hands, spits on the floor. \"Tenants. We'll see about tenants.\"\n\nMy mother says nothing. She is looking at the speaker grille with the same face she turned up to the Oculus: wet-eyed, open-mouthed, almost glad.\n\n\"The Lamp comes round,\" she says, very quietly, to nobody, \"the debt comes due.\"\n\n\"Mama. Don't.\"\n\n\"I'm only saying.\"\n\n\"Don't say it here.\"\n\nThe First Shareholder answers the Concord forty minutes later, on the same speakers. I'm in my mother's room on the Ninth by then, sitting on the end of her cot with my boots still on, and we listen to it together by the light of her work-lamp, with her filters laid out on the bench under it in their neat sooty rows.\n\nLucan Strand doesn't sound tired at all. He sounds the way he sounded in the nave: warm, unhurried, certain.\n\nHe says that the people of Patience have heard the Concord's message. He says that the city of Patience is a free city, established by lawful purchase in the year twenty-three ninety-one, and that it does not recognise the claim of the Concord of Vey or of any other body to its people, its labour, or its air. He says that he has spoken with the Council of Shareholders, and that the Council is unanimous. He says that the city has weathered worse than a fleet, that it was built by people who knew how to be patient, and that it will be patient now. He says that the dipper fleet is recalled and the surface locks are sealed and the city's defences, which have not been tested in a hundred years but which have been maintained, every one of them, are manned. He says that the people of Patience are not tenants. He says it the way you would say a thing about the weather.\n\n\"In the meantime,\" he says, \"the Council has adopted certain emergency measures, which will be posted on every tier tonight. I ask every citizen of Patience to observe them, for the common good. Our air is our life. We must husband it. Happy Lampfast, and good night.\"\n\nThe measures are posted at midnight. I read them on my wrist, sitting on my mother's cot, while she sleeps.\n\nThere are eleven of them. Most are what you'd expect: curfews, rationing of heat, a ban on unlicensed movement between tiers. The ninth says that the dipper fleet is suspended until further notice, which means that nobody will be going up into Gall's sky for fuel while there are thirty-eight Concord ships between us and it. The tenth says that the refinery reserves are to be husbanded accordingly.\n\nThe eleventh says that, for the duration of the emergency, the air-tithe payable by unshared households is doubled, and that the floor is lowered by a third, and that air-wardens are to apply the new rates from the first of the next cycle.\n\nI read it three times. Then I turn off my wrist, and sit in the dark with the fans sighing, and listen to my mother breathe.\n\nThe first slug hits the surface just before dawn.\n\nI don't know that's what it is. Nobody does. I'm asleep sitting up, and I wake because the whole city rings: a deep enormous note that comes up through the floor and the walls and the cot and my own bones, like being inside a struck bell. It goes on a long time. Ice dust sifts down from the ceiling and settles on my mother's filters. Somewhere above us, forty metres up, something has hit the shell of Kettle at a speed I can't imagine, and the whole moon has taken it and passed it down to us, tier by tier, all the way to the bottom of the sea.\n\nMy mother sits up in her cot with her hair full of frost.\n\n\"Isa,\" she says. \"Is it the Lamp?\"\n\n\"No, Mama,\" I tell her. \"It's the Concord.\"\n\nThe bell is still ringing.\n\n\n# The Blank Share\n\n## Under the floor\n\n[\n  Place: #The Ninth Tier\n  Characters: @@Isaura Venn @@Pilar Ocampo\n  When: 30 June 2654\n]\n\nOn the eighteenth day of the siege the Ocampos' grandmother dies on the floor.\n\nI'm the one who finds her. That's the way it falls out; I'm doing my rounds on the Ninth South with the new rates loaded in my ledger, and when I get to the eleventh door I knock and say _air-warden_ and nobody answers, and I knock again, and then I put my ear to the hatch the way the old wardens taught us, to listen for the household breathing, and I hear only the fans. So I open it with my key. We're allowed to. The Ordinance says a warden may enter any unshared household to read its meter, at any hour, without notice, and I have never once done it before.\n\nThe room is dark and very cold. The Ninth's rooms are all one room: a sleeping platform at the back, a bench and a heater and a basin at the front, a curtain between. The heater's off, because heat costs air. The curtain's open. On the sleeping platform, under three blankets and a coat, lies an old woman with a grey face and her mouth a little open, and beside her, sitting on the edge of the platform with her knees drawn up and her cracked grey gloves on, is Pilar.\n\n\"Abuela's asleep,\" she says.\n\nI go and look. I'm not a medic, but you learn what you need to learn on the Ninth. The old woman's been dead some hours. Her hands are folded on the blanket, which means somebody folded them.\n\n\"Where's your mother, Pilar?\"\n\n\"At the plant. They're doing double shifts. Because of the Concord.\" She looks at me. \"Papa's at the plant too. Tomás and Juli are at the crèche on the Seventh. Abuela was sleeping. I was minding her.\"\n\n\"How long has she been sleeping?\"\n\nPilar thinks about it seriously. \"Since before the morning bell,\" she says. \"She said she was tired. She said her chest was tight. She said it was like breathing through a sock.\" She looks back at her grandmother. \"Then she stopped saying things.\"\n\nI stand in the cold dark room with my ledger on my wrist. The meter by the door, under its frosted window, reads two hundred litres an hour for five people. That is the new floor. Two hundred for five. It came in on the first of the cycle, along with the doubled tithe, by Council order, and I loaded the new figures myself and turned the valves myself, every door on my section that was in arrears, which on the Ninth South was very nearly every door. I put the Ocampos to the new floor on the second. I remember the valve. It was stiff.\n\nNobody dies on the floor.\n\n\"She had the ice cough,\" I say. \"Your grandmother. She'd had it for years. I heard it every time I came. Didn't she?\"\n\n\"She coughed,\" Pilar agrees.\n\n\"It's the cough. When people get old, the cough gets into their chest, and their heart gets tired. It isn't anybody's fault.\" I hear my own voice, very even, very kind. The warden's voice. \"I'm going to call the medics on the Seventh. They'll come and look after her. And I'm going to send a message to the plant, to your mother. All right?\"\n\n\"All right,\" says Pilar.\n\nI call the medics. I send the message. I file the death in my ledger, as the Ordinance requires, under _cause_, in the space provided: _Ice cough, pre-existing. Age._ My finger hovers over the line for a moment before I submit it, and then I submit it, because it's true. She did have the cough. She was old.\n\nWhile I wait for the medics I sit on the bench by the dead heater, and Pilar sits on the platform beside her grandmother, and neither of us says anything. Through the ceiling, faintly, very far up, I can hear the surface being hit. It's a sound we've all learned to stop hearing, these eighteen days: a long dull boom like a door slammed in another house, every hour or so, as one of Grieve's slugs comes down out of the black and strikes the shell of Kettle somewhere over the city. He is careful, the Commodore. Everyone says so. He doesn't hit the tiers. He hits the refinery vents and the dipper docks and the old surface sheds where the fuel was stored, and the city's lungs on the far ice, the great intakes where the water is cracked for air. He is not trying to break us. He is trying to make us breathe less.\n\nOn the wall of the corridor outside, every tier now has a board, posted by the Council at the start of each shift. It says RESERVE, and then a number of days. When the siege began it said ninety-four. This morning it says sixty-one.\n\n\"Warden,\" says Pilar.\n\n\"Yes.\"\n\n\"When Mama pays, does it go straight back?\"\n\n\"Yes.\"\n\n\"Even now?\"\n\n\"Even now. The ledger tells the plant. She doesn't have to find me.\"\n\nPilar considers this. Then she gets down off the platform and goes to the hatch and looks at the meter under its frosted window, the needle lying on the red, and wipes the frost off the glass with her cracked glove, the way I do.\n\n\"It's very low,\" she says.\n\n\"It's the floor.\"\n\n\"Nobody dies on the floor,\" says Pilar, to the meter, quite seriously, as if she were reminding it.\n\n[\n  Place: #The Spine\n  Characters: @@Isaura Venn @@Malachy Orr @@Lucan Strand\n  Items: ^The Share Plate:#The Archive ^Isaura's gauge:@Isaura Venn\n  When: same day\n]\n\nIn the afternoon I'm sent to the Spine.\n\nThe order comes down from the Wardens' Office with no explanation, which is how orders always come down: _Venn, I., to report Spine nave, air survey, priority._ When I get there I find out why. A slug in the night came down closer than any before it, on the old dock heads over the Spine, and the shock went down through the hull like a hammer down an anvil, and somewhere in the nave's air system something cracked. The nave's air is the Council's air. It's shared air, untithed, drawn straight from the city's best intakes and scrubbed three times on its way; it's also, like all old systems, a mess of pipes and baffles and valves that nobody has drawn a proper plan of in a century. Somebody has to walk it with a gauge and find the leak. The Council's own engineers are busy on the refinery vents. So they send a warden from the Ninth.\n\nI walk it for three hours. I go up into the roof spaces above the nave on the old maintenance ladders, which were built for riggers two centuries ago and have been painted a dozen times since and never once mended, and crawl along the trunking with my gauge in one hand and my lamp in my teeth, listening. The nave below me is empty. Since the siege began the Council has met in the old bridge, which is deeper and safer, and the shared families have stopped coming up to sit on the benches under the Oculus and look at the Lamp. You can see it through the lens even from up here, sideways: a smear of greenish light much brighter now than it was at Lampfast, with a tail so long it crosses half the lens. The Lamp doesn't care about the Concord. It comes on in.\n\nI find the leak in the end over the drum, where a flange on the main trunk has cracked across its face and is whistling out the Council's good air into the roof void. I can feel it on my cheek. I mark it with chalk and log it, and I'm climbing back down the ladder at the drum's end when the next slug comes.\n\nIt's close. Much closer than the one in the night. I feel it before I hear it, a shove from the ladder against my hands and my knees, as if the whole Spine had been kicked; then the sound, which isn't a boom at all this close but a crack, enormous, a sound like the sky being split down the middle; and then the nave rings. The old hull takes the blow and passes it down its whole length like a struck bell, and the ladder hums under me so hard my teeth buzz, and dust comes down out of the roof in a grey sheet, and somewhere below me something lets go.\n\nI hang on. That's all you can do. When the ringing has gone down enough for me to hear myself think, I look down.\n\nThe Share Plate has fallen off the drum.\n\nIt must have been hanging on the same old fixings since the founding: four steel pins set into the drum's end, with the Plate's top corners hooked over two of them. The hull has rung and the pins have sheared. It's lying on the deck at the drum's foot, face down, in the dust, with one corner bent.\n\nI climb the rest of the way down and stand looking at it. I don't touch it. Nobody touches the Plate. There are shared children who have been taken up to it on their naming days and allowed to lay one finger on the edge of their ancestor's name, and that is all; there are unshared families who have lived in this city for a hundred years and never been within ten metres of it. And now here it is at my feet, face down on the deck like a dropped tray.\n\nThe back is grey.\n\nThat's what I notice. I've never seen the back of it, nobody has. It's covered, edge to edge, in a coat of thick old grey paint, the kind of hull sealant they used to put on the outside of ships, gone hard and crazed with age, like the skin on old milk. Somebody painted the back of the Share Plate with ship's sealant, a long time ago, carefully, all over. And under the paint, where the light from the Oculus falls across it at a low angle, there are lines.\n\nI crouch down. I still don't touch it. The lines are very faint, just a ridging in the sealant, the way the shape of a coin shows through a sheet of paper laid over it. Rows of them. Short marks, grouped. Something cut into the metal underneath and then painted over, so that only the ghost of the cutting comes through.\n\n\"Don't touch it,\" says a voice behind me.\n\nIt's Malachy. He's come up from the Archive in his slippers with his old grey coat thrown over his nightshirt, though it's the middle of the afternoon, and his white hair is full of dust, and he's out of breath. He comes across the nave to me at his slow crane's walk and stands beside me looking down at the Plate.\n\n\"I wasn't going to,\" I say.\n\n\"Good. Your hands are filthy.\" He crouches down beside me, which takes him some time, and puts his face close to the grey back of the Plate, and tilts his head to catch the light the way I did. He looks for a long time. He doesn't say anything. Then he lets out a long breath through his nose.\n\n\"Well,\" he says. \"Well, well.\"\n\n\"Is that writing?\"\n\n\"It's something.\"\n\nThere are footsteps on the nave floor, a lot of them. The Council's stewards, in their grey coats, four of them, with the First Shareholder walking behind. Lucan Strand looks tired. He has dust on his shoulders, too, and a cut over one eye with a dressing on it, and he moves like a man who has been awake for most of eighteen days; but his face when he sees the Plate on the floor goes very still, and then very gentle, the way a man's face goes when he sees a child hurt.\n\n\"Is it damaged?\"\n\n\"One corner bent, First Shareholder,\" says Malachy, not getting up. \"The fixings sheared. I'd like to look at it before it goes back up.\"\n\n\"It must go back up.\" Strand comes and stands over it. \"Today. The people need to see it there. With what's happening—\"\n\n\"It'll go back up,\" says Malachy, \"on new pins, in a proper frame, when I've made sure that bend hasn't cracked the steel. If you hang it today on the old pins it'll be on the floor again in a week, and next time it might break.\" He looks up at the First Shareholder with his mild old eyes. \"You wouldn't want to be the Shareholder who broke the Plate, Lucan.\"\n\nStrand looks at him. I think for a moment that he's going to say no. I can see him weighing it: the steward at his elbow, the empty nave, the Lamp over his head in the Oculus, the slugs.\n\n\"How long?\" he says.\n\n\"A week. Two at most.\"\n\n\"In the Archive.\"\n\n\"In the Archive, under lock, where it's safe. You can come and look at it any time you like.\"\n\nStrand lets out a breath. \"Very well. A week.\" He turns to the stewards. \"Help the Archivist carry it. Gently.\" He looks down at me as if noticing me for the first time. \"You found it?\"\n\n\"I was surveying the air, First Shareholder. There's a cracked flange on the main trunk, over the drum. I've marked it.\"\n\n\"Thank you.\" He's already turning away. \"Thank you, warden. Good work.\"\n\nThe stewards pick the Plate up between them, carefully, face down still, the grey back uppermost, and carry it toward the Archive stairs like a stretcher, with Malachy hovering behind. Nobody but me and Malachy looks at the back. The stewards are looking at their feet on the stairs. Strand is looking at the pins.\n\nAs Malachy goes past me, he puts his hand on my arm for a moment, very lightly.\n\n\"Come and see me tonight,\" he says. \"After curfew. Bring your lamp.\"","wordCount":3571,"createdAt":1793093847731},{"id":"Ef7AH1VPqfaCZpBfy26UP","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"pCAUFmAksTJpzvZJ8CLyF","text":"I don't get to the Archive that night. At the eighth bell, as I'm coming off shift, the city's guns open up for the first time in the siege.\n\nI didn't know we had guns. I don't think most people did. There are batteries, it turns out, in old pits on the surface ice around the city, built a hundred years ago in some war scare that never came to anything and maintained ever since by a few dozen shared families who have the right to do it the way other shared families have the right to the dipper fleet. They've waited eighteen days. Now, all at once, they fire, and the whole city hears them: a sound like heavy doors being slammed, very fast, one after another, coming down through the ice.\n\nEverybody stops in the corridors and looks up.\n\nThe word comes down the speakers a few minutes later, crackling and excited. A Concord lander has come down low over the south ice, probing, the first time any of Grieve's ships has come close enough to touch, and the batteries have hit it. It's down. It's on the ice south of the city, a kilometre from South Lock. All damage-control parties to South Lock. All air-wardens with surface rating to South Lock.\n\nI have surface rating. All wardens do; we read the meters on the intakes. I go.\n\nSouth Lock is a vast old chamber cut in the ice at the bottom of a sloping ramp, with the surface doors at its top end and a long low gallery down one side where the suits hang on their racks like a row of hanged men. When I get there it's already full of people. Damage-control crews in orange. Wardens in grey. Militia in their blue armbands with their old rifles. And riggers, a lot of riggers, the big tattooed men and women of the dipper fleet, who've been grounded eighteen days by the Council's order and have nothing to do and are in the mood for something to do it to.\n\nThe doors are open when I get there. The lock's cycled. A team in surface suits has gone out across the ice on a crawler and is coming back, and on the big screen over the gallery we can all see the feed from the crawler's lamps: white ice, black sky, Gall's banded edge on the horizon, and a long smear of wreckage going away across the snow, burning green and orange where its fuel has caught. In the middle of the wreckage, something moving.\n\n\"There's one alive,\" someone says.\n\n\"Not for long.\"\n\nThe crawler comes back down the ramp with the outer doors grinding shut behind it, ice streaming off its tracks. The lock cycles. When the inner doors open, the crowd surges forward, and I'm pushed forward with it, and I see the damage-control crew climbing down off the crawler's bed with a body between them in a scorched white Concord pressure suit.\n\nThey put it down on the floor of the lock. The suit's helmet is cracked across the visor. There's frost on the inside of the crack. The figure inside it moves its hands, weakly, at the clasps of the helmet, as if it wants to get it off.\n\n\"Leave it,\" says somebody. \"It's on its own air.\"\n\n\"Its air's gone,\" says one of the damage-control crew, a woman with a burned face, crouching by the helmet. \"Tank's holed. It's breathing what's left in the suit.\" She looks up. \"Maybe ten minutes.\"\n\n\"Then leave it ten minutes,\" says a rigger at the front of the crowd, a huge man with comet-tails tattooed up both forearms, and there's a growl of agreement behind him. \"Let it breathe what's left. That's what they're doing to us.\"\n\n\"Put it out on the ice.\"\n\n\"Let it have the floor.\"\n\nThat gets a laugh, an ugly one. It goes round the lock like a wave. _Let it have the floor._ The Concord pilot's hands have stopped moving at the clasps. They lie on its chest. Through the cracked visor I can see a face, very young, very pale, with its eyes open, looking up at all of us.\n\nI'm not brave. I want to say that clearly, as I said the other thing clearly before. What I do next isn't brave. It's habit. I'm an air-warden. I have spent twelve years kneeling beside meters, and what I'm looking at is a meter reading red.\n\nI push through to the front, and kneel down beside the burned-faced woman, and take the spare bottle off my own belt. Every warden carries a spare, a little twenty-minute flask with a universal coupling, for when we're out on the intakes. I find the suit's emergency port under the left armpit, where every suit in eleven lanes has had it since before the founding, and I knock the frost off it with my glove and screw the coupling in, and open the valve.\n\nThe suit hisses. The frost on the inside of the visor starts, very slowly, to clear.\n\n\"What are you doing?\" says the tattooed rigger.\n\n\"Reading a meter,\" I say.\n\nThere is a silence in the lock. I can feel it on the back of my neck, a hundred people looking at me. I don't look round. I watch the frost clear on the visor, and the young pale face behind it blink, and its lips move.\n\n\"Warden,\" says the rigger, in a voice I don't like.\n\n\"It's my air,\" I say. \"It's on my account. If you want to take it off me, you'll have to take it off me.\"\n\nNobody moves. I don't know what would have happened next. I don't know, to this day, whether they would have; I think perhaps they would. But the militia have got to the front by then, three of them with rifles and blue armbands and an officer with a whistle, and the officer is shouting that the prisoner is the property of the Council and anybody who lays a hand on him will be on the floor for a year. The crowd backs off, growling. The burned-faced woman helps me get the cracked helmet off. Underneath it the pilot is a man, young, younger than me, with a soldier's cropped fair hair and a soldier's frightened eyes, and a smear of blood under his nose.\n\nHe looks at me. He breathes. It's the first thing I ever hear him do.\n\n\"Thank you,\" he says, in the clipped accent of the inner lanes.\n\n\"Don't,\" I say. \"It's on your account.\"\n\nThe militia take him. They lift him on to a stretcher and carry him up the ramp toward the inner city, and the officer with the whistle tells me to report to the Wardens' Office in the morning with my bottle receipt, and goes after them. The crowd breaks up, slowly, sullenly, back to whatever it was doing. The tattooed rigger stands looking at me a while longer and then goes. I'm left kneeling on the wet ice floor of the lock with my empty bottle in my hand.\n\nSomebody crouches down beside me. A woman, a rigger, forty-odd, small and wiry, with her sleeves rolled up over forearms tattooed from wrist to elbow with the long thin fans of comets, one inside another, like the rings in a tree.\n\n\"You gave him your air, warden,\" she says.\n\n\"I gave him a bottle.\"\n\n\"That's a first.\" She looks at me with a sort of amused curiosity, as if I were a dog that had started to talk. \"Twelve years I've lived on the Ninth North and I never once saw a warden give anybody air.\"\n\n\"It's not a warden's job to give air.\"\n\n\"No,\" she agrees. \"It's not.\" She stands up and dusts off her knees. \"I'm Dasha. Dasha Imre. Rigger. Grounded.\" She holds out her hand to pull me up. \"You want to be careful, warden. Giving people things. It gets to be a habit.\"\n\nI let her pull me up. \"Isaura,\" I say. \"Venn.\"\n\n\"I know who you are,\" says Dasha Imre. \"Everybody on the Ninth knows who you are.\" She grins, quite friendly. \"That's why it's a first.\"\n\nWhen I get back to my room on the Fourth it's past the tenth bell, and there's a message waiting on my wrist. It's from the Archive. It's very short, in Malachy's old-fashioned way, the way he used to write notes in the margins of my exercises when I was ten.\n\n_Isaura. There's writing under the paint. Come tomorrow. Come alone. M._\n\n\n# Ephemeris\n\n## Under the paint\n\n[\n  Place: #The Archive\n  Characters: @@Isaura Venn @@Malachy Orr\n  Items: ^The Share Plate:#The Archive\n  When: 1 July 2654\n]\n\nThe Archive is the Spine's old cargo deck, four levels down from the nave, and it smells the way I imagine the inside of a very old person's head smells: of dust, and paper, and cold, and something sweetish and faint like rot. There's no proper light. There never has been. Malachy works by lamps, a dozen of them on long arms clamped to his tables, so that the Archive is a great dark cave with little islands of yellow in it, and on every island, books, slates, rolled charts, folders of foil, ledgers bound in plastic gone brown, the whole two hundred and sixty years of Patience written down by people who mostly never expected anyone to read it.\n\nHe has the Plate on his biggest table, under three lamps, face down.\n\n\"Close the door,\" he says, when I come in. \"And lock it. There's a bar.\"\n\nI bar the door. When I turn round he's bending over the table with a magnifier strapped round his head on a leather band, like a jeweller, and a tiny brush in one hand and a dish of something in the other that smells sharp enough to make my eyes water.\n\n\"Solvent,\" he says, without looking up. \"Old dock solvent. The kind they used to strip hull paint, back when we had hulls to strip. There's a drum of it in the bottom store that's been there since my grandfather's time. It does the job, slowly. Too fast and it would take the scratches with it.\" He dabs the brush, very lightly, and wipes. \"Come and look. Don't breathe on it.\"\n\nI come and look.\n\nHe's cleaned a patch in the top corner of the Plate's back, no bigger than my palm. Inside it, the grey sealant is gone, and the steel underneath is dark and dull and pitted with age, and across it, cut into the metal, there are marks. Not deep. Scratched, rather than cut: thin uncertain lines, as if made with a point dragged slowly and hard, by somebody pressing with all their weight. They're figures. Numbers. A column of them, and beside the column, letters, single letters, like labels.\n\n\"Somebody scratched these with an awl,\" says Malachy. \"A rigger's scribe, probably. The kind they used for marking cable. You can see where the point skidded.\" He touches the air above a line with the end of his brush. \"Look at the sevens. They cross their sevens. Nobody's crossed a seven in this city for two hundred years.\"\n\n\"What are they?\"\n\n\"Numbers.\"\n\n\"Malachy.\"\n\n\"I don't know yet.\" He straightens up, with a little grunt, and pushes the magnifier up on to his forehead, where it sits like a third eye. \"I've done this much in a night. There's the whole back of the Plate still under paint, and the paint's harder in the middle, where it was thicker. A week. Two.\" He looks at me. \"I need you to keep this to yourself, Isaura.\"\n\n\"Who would I tell?\"\n\n\"Your mother. Your section chief. That rigger woman from South Lock who's been asking about you on the Ninth.\" He sees my face and smiles thinly. \"I hear things. I'm an archivist. Hearing things is most of the job.\"\n\n\"Why does it matter? It's numbers on the back of a plate.\"\n\n\"It matters,\" says Malachy, \"because somebody went to a great deal of trouble to put them there, and then went to a great deal more trouble to make sure nobody could see them.\" He lays the brush down across the dish. \"Think about it. This is the Share Plate. It's the first thing the founders made. It's been hanging in the nave since before there was a nave. Every child in Patience has stood in front of it. And somebody, two hundred and sixty years ago, took it down and cut something into the back of it with an awl, and then painted over it with hull sealant, carefully, edge to edge, so that it would look like nothing but the back of a piece of steel. And hung it up again.\" He spreads his old spotted hands. \"You don't do that with a shopping list.\"\n\n\"Then why not throw it away? If they didn't want it read.\"\n\n\"Because they did want it read.\" Malachy pulls the magnifier back down over his eye and bends to the Plate again. \"Eventually. Just not by whoever was standing in front of it at the time.\" He dabs with the brush. \"Those aren't the same thing, Isaura. Keeping a thing and hiding it. You'll find most of this room is one or the other. The trick is telling which.\"\n\n[\n  Place: #The Cells\n  Characters: @@Isaura Venn @@Mattias Ebb\n  Items: ^Isaura's gauge:@Isaura Venn\n  When: 10 July 2654\n]\n\nNine days after South Lock, the Wardens' Office takes me off the Ninth.\n\nI'm called in to see my section chief, a weary shared woman named Paske who has been running the South wardens since before I joined, and who looks at me across her desk with the expression of somebody who has been given a problem she didn't ask for. I'm not being disciplined, she says. Nobody's filed a complaint. The bottle's been paid for out of the Office budget; the militia were very grateful; there's even a commendation, which she pushes across the desk to me on a slip of foil. But there's been talk on the Ninth. About a warden giving away air to a Concord pilot while the Ninth's own children are on the floor. And there have been, Paske says delicately, incidents. A warden on the Ninth North had his ledger taken off him on the stairs and thrown down a shaft. Another had her valve key bent. It would be better for everybody, Paske says, if I were somewhere else for a while.\n\nSomewhere else is the Cells.\n\nThe Cells are under the Spine, below the Archive, below the old docks, in what was once the skimmer's keel: a long dim corridor of steel boxes, each with a door and a grille and a meter. In peacetime they hold drunks and thieves and the occasional unshared rioter. Now, eight days into July and twenty-eight days into the siege, they hold a few dozen of each and one Concord lieutenant. Somebody has to read the meters. That's me.\n\nIt's quiet work. It's almost restful, after the Ninth. The prisoners are on a fixed allowance set by the Council, a little above the old floor, and nobody pays tithe, so nobody falls into arrears, so nobody has to be cut. I walk the corridor twice a shift with my gauge and read each meter aloud into the ledger and check the seals on the doors, and the prisoners mostly ignore me. Some swear. One old man on the end, a tannery thief from the Fifth, asks me every shift whether the Lamp's still in the sky, and I tell him yes, and he says _good_, and turns over.\n\nThe lieutenant's cell is the eleventh.\n\n\"Ebb, Mattias,\" I say to my ledger, on the first morning, outside his grille. \"Concord Lane Service. Allowance three-twenty an hour. Draw this cycle, three-oh-five.\" I look through the grille. \"You're breathing light, Lieutenant.\"\n\nHe's sitting on his bunk with his back against the wall and his knees up, in a grey prison smock with the sleeves too short, his cropped fair hair grown out a little into a pale fuzz. The bruising on his face has gone yellow. He looks up when I speak, and I see him recognise me, and something complicated happens in his face.\n\n\"I was told to,\" he says. \"In training. _In captivity, conserve._ Every ration. Breathe slow, move slow, sleep a lot.\" He shrugs. \"I'm very good at sleeping.\"\n\n\"You don't have to conserve here. It's your allowance. It doesn't go back in the tank if you don't use it.\"\n\n\"Doesn't it?\"\n\n\"No. It's just wasted.\"\n\nHe thinks about this with a sort of grave interest. \"That's very inefficient.\"\n\n\"Welcome to Patience,\" I say, and go on to the twelfth.\n\nHe's there on the second day, and the third, and every day after, and after the third day we talk. Not much. A few minutes, across the grille, while I take the reading and check the seal. It isn't permitted, exactly. It isn't forbidden either; nobody's thought to forbid it, because nobody's imagined a warden would want to. I'm not sure I want to. But he's the only person in the city who knows less about it than I do, and there's a strange relief in that.\n\nHis name is Mattias. He's twenty-four. He comes from a world called Corran, three lanes in, an old Concord holding where everybody works in the canneries. His father owed the Concord a great deal of money for something to do with a fishing boat that sank, and when his father died the debt came down to Mattias, and the Concord, which is efficient, offered him the choice of the canneries for forty years or the Lane Service for twelve. He chose the Lane Service. He's done four years of the twelve. He flies landers. He was flying a lander over Kettle's south ice on the thirtieth of June, on a probe, because his captain wanted to see whether the city had any guns, and the city did.\n\n\"That's what it's like everywhere,\" he says, on the fifth day, when I tell him about the floor. \"The Concord. The tithe, the floor. They don't call it that. They call it _allocation_. But it's the same.\" He looks at me through the grille with his frightened soldier's eyes, which are, I've decided, not frightened at all, only very tired. \"You'd think you'd be different here. You threw the Company out. Didn't you? You bought your own air. That's what they told us in the briefings. _The occupiers claim to have purchased the claim._ And then you went and did the same thing to each other.\"\n\n\"We didn't do anything. I wasn't born.\"\n\n\"No. Nor was I.\" He leans his head back against the wall. \"Nobody's ever born when it happens. Have you noticed? It's always already happened.\"\n\nOn the sixth day he asks me why I gave him the bottle.\n\n\"It's my job,\" I say.\n\n\"It isn't, though. Is it? Your job's taking it away.\" He says it without any edge. \"The militia officer told me. On the stretcher, when he thought I couldn't hear. He said, _that's the warden from the Ninth, she's cut more air than the plague_. He was laughing.\"\n\nI look at the meter. Three-oh-eight.\n\n\"I don't know,\" I say, which is the truth.\n\n\"Well,\" says Mattias Ebb, after a while. \"Thank you anyway. Whatever it was.\"","wordCount":3250,"createdAt":1793109049060},{"id":"F3VEfoGliEQZqtkOl2OTI","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"pCAUFmAksTJpzvZJ8CLyF","text":"I don't get to the Archive that night. At the eighth bell, as I'm coming off shift, the city's guns open up for the first time in the siege.\n\nI didn't know we had guns. I don't think most people did. There are batteries, it turns out, in old pits on the surface ice around the city, built a hundred years ago in some war scare that never came to anything and maintained ever since by a few dozen shared families who have the right to do it the way other shared families have the right to the dipper fleet. They've waited eighteen days. Now, all at once, they fire, and the whole city hears them: a sound like heavy doors being slammed, very fast, one after another, coming down through the ice.\n\nEverybody stops in the corridors and looks up.\n\nThe word comes down the speakers a few minutes later, crackling and excited. A Concord lander has come down low over the south ice, probing, the first time any of Grieve's ships has come close enough to touch, and the batteries have hit it. It's down. It's on the ice south of the city, a kilometre from South Lock. All damage-control parties to South Lock. All air-wardens with surface rating to South Lock.\n\nI have surface rating. All wardens do; we read the meters on the intakes. I go.\n\nSouth Lock is a vast old chamber cut in the ice at the bottom of a sloping ramp, with the surface doors at its top end and a long low gallery down one side where the suits hang on their racks like a row of hanged men. When I get there it's already full of people. Damage-control crews in orange. Wardens in grey. Militia in their blue armbands with their old rifles. And riggers, a lot of riggers, the big tattooed men and women of the dipper fleet, who've been grounded eighteen days by the Council's order and have nothing to do and are in the mood for something to do it to.\n\nThe doors are open when I get there. The lock's cycled. A team in surface suits has gone out across the ice on a crawler and is coming back, and on the big screen over the gallery we can all see the feed from the crawler's lamps: white ice, black sky, Gall's banded edge on the horizon, and a long smear of wreckage going away across the snow, burning green and orange where its fuel has caught. In the middle of the wreckage, something moving.\n\n\"There's one alive,\" someone says.\n\n\"Not for long.\"\n\nThe crawler comes back down the ramp with the outer doors grinding shut behind it, ice streaming off its tracks. The lock cycles. When the inner doors open, the crowd surges forward, and I'm pushed forward with it, and I see the damage-control crew climbing down off the crawler's bed with a body between them in a scorched white Concord pressure suit.\n\nThey put it down on the floor of the lock. The suit's helmet is cracked across the visor. There's frost on the inside of the crack. The figure inside it moves its hands, weakly, at the clasps of the helmet, as if it wants to get it off.\n\n\"Leave it,\" says somebody. \"It's on its own air.\"\n\n\"Its air's gone,\" says one of the damage-control crew, a woman with a burned face, crouching by the helmet. \"Tank's holed. It's breathing what's left in the suit.\" She looks up. \"Maybe ten minutes.\"\n\n\"Then leave it ten minutes,\" says a rigger at the front of the crowd, a huge man with comet-tails tattooed up both forearms, and there's a growl of agreement behind him. \"Let it breathe what's left. That's what they're doing to us.\"\n\n\"Put it out on the ice.\"\n\n\"Let it have the floor.\"\n\nThat gets a laugh, an ugly one. It goes round the lock like a wave. _Let it have the floor._ The Concord pilot's hands have stopped moving at the clasps. They lie on its chest. Through the cracked visor I can see a face, very young, very pale, with its eyes open, looking up at all of us.\n\nI'm not brave. I want to say that clearly, as I said the other thing clearly before. What I do next isn't brave. It's habit. I'm an air-warden. I have spent twelve years kneeling beside meters, and what I'm looking at is a meter reading red.\n\nI push through to the front, and kneel down beside the burned-faced woman, and take the spare bottle off my own belt. Every warden carries a spare, a little twenty-minute flask with a universal coupling, for when we're out on the intakes. I find the suit's emergency port under the left armpit, where every suit in eleven lanes has had it since before the founding, and I knock the frost off it with my glove and screw the coupling in, and open the valve.\n\nThe suit hisses. The frost on the inside of the visor starts, very slowly, to clear.\n\n\"What are you doing?\" says the tattooed rigger.\n\n\"Reading a meter,\" I say.\n\nThere is a silence in the lock. I can feel it on the back of my neck, a hundred people looking at me. I don't look round. I watch the frost clear on the visor, and the young pale face behind it blink, and its lips move.\n\n\"Warden,\" says the rigger, in a voice I don't like.\n\n\"It's my air,\" I say. \"It's on my account. If you want to take it off me, you'll have to take it off me.\"\n\nNobody moves. I don't know what would have happened next. I don't know, to this day, whether they would have; I think perhaps they would. But the militia have got to the front by then, three of them with rifles and blue armbands and an officer with a whistle, and the officer is shouting that the prisoner is the property of the Council and anybody who lays a hand on him will be on the floor for a year. The crowd backs off, growling. The burned-faced woman helps me get the cracked helmet off. Underneath it the pilot is a man, young, younger than me, with a soldier's cropped fair hair and a soldier's frightened eyes, and a smear of blood under his nose.\n\nHe looks at me. He breathes. It's the first thing I ever hear him do.\n\n\"Thank you,\" he says, in the clipped accent of the inner lanes.\n\n\"Don't,\" I say. \"It's on your account.\"\n\nThe militia take him. They lift him on to a stretcher and carry him up the ramp toward the inner city, and the officer with the whistle tells me to report to the Wardens' Office in the morning with my bottle receipt, and goes after them. The crowd breaks up, slowly, sullenly, back to whatever it was doing. The tattooed rigger stands looking at me a while longer and then goes. I'm left kneeling on the wet ice floor of the lock with my empty bottle in my hand.\n\nSomebody crouches down beside me. A woman, a rigger, forty-odd, small and wiry, with her sleeves rolled up over forearms tattooed from wrist to elbow with the long thin fans of comets, one inside another, like the rings in a tree.\n\n\"You gave him your air, warden,\" she says.\n\n\"I gave him a bottle.\"\n\n\"That's a first.\" She looks at me with a sort of amused curiosity, as if I were a dog that had started to talk. \"Twelve years I've lived on the Ninth North and I never once saw a warden give anybody air.\"\n\n\"It's not a warden's job to give air.\"\n\n\"No,\" she agrees. \"It's not.\" She stands up and dusts off her knees. \"I'm Dasha. Dasha Imre. Rigger. Grounded.\" She holds out her hand to pull me up. \"You want to be careful, warden. Giving people things. It gets to be a habit.\"\n\nI let her pull me up. \"Isaura,\" I say. \"Venn.\"\n\n\"I know who you are,\" says Dasha Imre. \"Everybody on the Ninth knows who you are.\" She grins, quite friendly. \"That's why it's a first.\"\n\nWhen I get back to my room on the Fourth it's past the tenth bell, and there's a message waiting on my wrist. It's from the Archive. It's very short, in Malachy's old-fashioned way, the way he used to write notes in the margins of my exercises when I was ten.\n\n_Isaura. There's writing under the paint. Come tomorrow. Come alone. M._\n\n\n# Ephemeris\n\n[\n  Place: #The Archive\n  Characters: @@Isaura Venn @@Malachy Orr\n  Items: ^The Share Plate:#The Archive\n  When: 1 July 2654\n]\n\nThe Archive is the Spine's old cargo deck, four levels down from the nave, and it smells the way I imagine the inside of a very old person's head smells: of dust, and paper, and cold, and something sweetish and faint like rot. There's no proper light. There never has been. Malachy works by lamps, a dozen of them on long arms clamped to his tables, so that the Archive is a great dark cave with little islands of yellow in it, and on every island, books, slates, rolled charts, folders of foil, ledgers bound in plastic gone brown, the whole two hundred and sixty years of Patience written down by people who mostly never expected anyone to read it.\n\nHe has the Plate on his biggest table, under three lamps, face down.\n\n\"Close the door,\" he says, when I come in. \"And lock it. There's a bar.\"\n\nI bar the door. When I turn round he's bending over the table with a magnifier strapped round his head on a leather band, like a jeweller, and a tiny brush in one hand and a dish of something in the other that smells sharp enough to make my eyes water.\n\n\"Solvent,\" he says, without looking up. \"Old dock solvent. The kind they used to strip hull paint, back when we had hulls to strip. There's a drum of it in the bottom store that's been there since my grandfather's time. It does the job, slowly. Too fast and it would take the scratches with it.\" He dabs the brush, very lightly, and wipes. \"Come and look. Don't breathe on it.\"\n\nI come and look.\n\nHe's cleaned a patch in the top corner of the Plate's back, no bigger than my palm. Inside it, the grey sealant is gone, and the steel underneath is dark and dull and pitted with age, and across it, cut into the metal, there are marks. Not deep. Scratched, rather than cut: thin uncertain lines, as if made with a point dragged slowly and hard, by somebody pressing with all their weight. They're figures. Numbers. A column of them, and beside the column, letters, single letters, like labels.\n\n\"Somebody scratched these with an awl,\" says Malachy. \"A rigger's scribe, probably. The kind they used for marking cable. You can see where the point skidded.\" He touches the air above a line with the end of his brush. \"Look at the sevens. They cross their sevens. Nobody's crossed a seven in this city for two hundred years.\"\n\n\"What are they?\"\n\n\"Numbers.\"\n\n\"Malachy.\"\n\n\"I don't know yet.\" He straightens up, with a little grunt, and pushes the magnifier up on to his forehead, where it sits like a third eye. \"I've done this much in a night. There's the whole back of the Plate still under paint, and the paint's harder in the middle, where it was thicker. A week. Two.\" He looks at me. \"I need you to keep this to yourself, Isaura.\"\n\n\"Who would I tell?\"\n\n\"Your mother. Your section chief. That rigger woman from South Lock who's been asking about you on the Ninth.\" He sees my face and smiles thinly. \"I hear things. I'm an archivist. Hearing things is most of the job.\"\n\n\"Why does it matter? It's numbers on the back of a plate.\"\n\n\"It matters,\" says Malachy, \"because somebody went to a great deal of trouble to put them there, and then went to a great deal more trouble to make sure nobody could see them.\" He lays the brush down across the dish. \"Think about it. This is the Share Plate. It's the first thing the founders made. It's been hanging in the nave since before there was a nave. Every child in Patience has stood in front of it. And somebody, two hundred and sixty years ago, took it down and cut something into the back of it with an awl, and then painted over it with hull sealant, carefully, edge to edge, so that it would look like nothing but the back of a piece of steel. And hung it up again.\" He spreads his old spotted hands. \"You don't do that with a shopping list.\"\n\n\"Then why not throw it away? If they didn't want it read.\"\n\n\"Because they did want it read.\" Malachy pulls the magnifier back down over his eye and bends to the Plate again. \"Eventually. Just not by whoever was standing in front of it at the time.\" He dabs with the brush. \"Those aren't the same thing, Isaura. Keeping a thing and hiding it. You'll find most of this room is one or the other. The trick is telling which.\"","wordCount":2228,"createdAt":1793109049368},{"id":"H_js1jt0XQd8tq4H7QC4I","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"KUeDnmR-PMrQG7-kIhydF","text":"The infirmary was the one place on the _Patience_ that was ever warm. Ekene kept it that way on purpose, cooking the heat exchangers past their rating and fiddling the logs, because, he said, sick people healed better warm and well people talked more truthfully; and it was true that you heard things in the infirmary at night that you did not hear anywhere else on the ship. It was a narrow white room with eight bunks, a dispensary cage, a surgical bay behind a curtain, and a single round port the size of a dinner plate that looked out along the hull toward Gall's limb. Ekene had hung a dried flower in a bag over the port. Nobody knew where he had got a flower.\n\nHe was sitting at the dispensary counter when she came in, writing up the day by the light of a single lamp. He looked up, and took off his reading lenses, and looked at her for a long moment without saying anything. Then he got up and came round the counter and put his arms round her, and she stood in them with her face against the stiff cotton of his coat and her fist in her pocket and did not cry, because she had not cried in nine years and was not about to start now in front of a dispensary cage.\n\n\"I heard it,\" he said into her hair. \"Half the ship was on the line channel. I heard you talking to her.\"\n\n\"I didn't do anything.\"\n\n\"You talked to her.\"\n\n\"I couldn't do anything, Ekene. The Gull's thruster was stripped. It's been stripped three weeks. I put in for the part three times.\" She let go of him and stepped back. \"I ran the line. That's what I did. I sat there and ran the dip and I listened to her go.\"\n\n\"If you'd stopped the dip—\"\n\n\"If I'd stopped the dip the line would have walked and we'd have lost Odile as well. And the Bucket. And the drum, maybe. And they'd have docked the whole crew for the load.\" She sat down on the end of the nearest bunk. \"That's the arithmetic. I did the arithmetic.\"\n\nEkene went back behind the counter and filled two cups from the urn and brought them over. It was the infirmary's tea, which was not tea at all but something he grew in a tray under the ultraviolet lamp in the surgical bay and dried and smoked, and which tasted like a wet fire. She drank it. He sat beside her on the bunk. He was fifty-two, eleven years older than she was, a big soft-spoken man with grey in his beard and the long patient hands of somebody who had spent his life doing small things carefully to people in pain. He had come to Corva on a medical contract six years ago, not bonded, which made him a strange thing on the _Patience_, a free man who could have left on any _Clement_. He had not left. Maren had asked him why, once, and he had said that he was a coward and the Combine's other postings were worse; and then, later, in the dark, that it was her.\n\n\"The factor,\" he said.\n\n\"You saw him?\"\n\n\"He came by. Before the hall. He wanted to see the infirmary.\" Ekene turned his cup round in his hands. \"He asked about our stock of painkillers. How many beds. Whether we had a cold store and what was in it. He was polite. He asked very good questions.\"\n\n\"What kind of questions?\"\n\n\"The kind an auditor asks. What things cost. What could be moved.\" He looked at her sideways. \"What do you think _changes_ means, Maren?\"\n\n\"I think the _Clement_'s eleven days early,\" Maren said. \"I think nobody sends a new factor to a skimmer that's making its numbers just to say hello.\" She drank the rest of her cup in one swallow, burning her throat. \"And I think somebody cut Lusine's line.\"\n\nShe took her fist out of her pocket and opened it.\n\nEkene looked at the clip for a long time. Then he took it from her palm, gently, the way he took everything, and turned it under the lamp, and found the stub of the gate spring and the bright clean face of the cut, two-thirds of the way through.\n\n\"A blade,\" he said.\n\n\"A fine one. Not a cutter. Cutters crush. That's a saw cut, or a knife that's been honed. Somebody took that spring two-thirds through, so it'd hold in calm and go in the first hard shock.\" She heard her own voice, very level, the tether-chief's voice. \"Every runner checks her clip at the lock. You snap it, you load it, you look at the gate. You don't look at the spring. Nobody looks at the spring.\"\n\n\"Who could do this?\"\n\n\"Anybody who could get to her harness. Anybody in the runners' lock, between her last check yesterday and the dip. Riggers. Runners. Dock crew. Wardens.\" She stopped. \"Me.\"\n\n\"Not you.\"\n\n\"No. Not me.\" She took the clip back. \"She said something on the way down. On four, so it's not on the log. She said she'd read a dispatch on the relay, something that came ahead of the _Clement_ on the beacon. She said it was about all of us. She said she'd told someone, and she shouldn't have.\"\n\n\"Told who?\"\n\n\"She didn't say. She went into the static.\" Maren closed her hand on the clip again. \"She said, _I don't think it was the clip._\"\n\nThey sat for a while without talking. Through the port, over Ekene's shoulder, she could see the long curve of the _Patience_'s hull lit by Gall-shine, rust-coloured, and beyond it the edge of Gall itself, and beyond that the black. It took her a moment to see what she was looking at. There was a smudge in the black, just above the planet's limb: a faint pale patch no bigger than a thumbprint, like a breath on glass, with the barest suggestion of a tail.\n\n\"There it is,\" said Ekene, following her eyes. \"Teska's comet.\"\n\n\"The Lamp.\"\n\n\"She says it takes the dead out.\"\n\n\"She says a lot of things.\" Maren stood up. She was very tired. She put the clip back in her pocket and felt its small weight there, against her hip, where her line knife hung on her coat. \"I'm going to find out who she told.\"\n\n\"Maren.\"\n\n\"What.\"\n\n\"Be careful who you ask,\" said Ekene.\n\n\n# Consolidation\n\n## Lusine's locker\n\n[\n  Place: #The Patience\n  Characters: @@Maren Tsolo @@Odile Arda\n  Items: ^Lusine's clip:@Maren Tsolo\n  When: 5 November 2391\n]\n\nThe runners lived aft of the drum, in a long low compartment the crew called the Shelf, where the bunks were stacked four high along both walls and the air came in through a single overworked fan that had been rattling since before any of them were born. Each runner had a bunk and a locker. When a runner went into Gall, the locker was emptied by the warden's office, and anything of value was sold against the account, and the rest went into the waste cycler. It had been three days. The warden's office had not got round to Lusine's yet. Maren had made sure of that, by giving Bram Kovač two dips' worth of overtime on the drum.\n\nOdile was sitting on her sister's bunk when Maren came in, with the locker open beside her and its contents laid out on the blanket in rows, as if for an inventory. A spare undersuit. A comb. A packet of the cheap dried fruit they sold in the Camp at Midwinter. A cloth bag of hair ties. A stack of letters from somebody in the Camp, tied with string. A small battered slate with a cracked screen. A carved wooden fish, no bigger than a thumb, very old.\n\n\"That was our mother's,\" Odile said, without looking up. \"The fish. She carved it. She used to carve things. She said she'd teach me but she didn't.\"\n\nMaren sat down on the bunk opposite. \"I'm sorry, Odile.\"\n\n\"You keep saying that.\"\n\n\"I keep meaning it.\"\n\nOdile picked up the fish and turned it over in her fingers. Her face was swollen and blotched and fierce, and she had not slept, by the look of her, since the dip; she had done her shifts anyway, both of them, on the line, at six kilometres, and run them clean, and Maren had watched her dot on the board and said nothing, because there was nothing to say to a runner who wanted to be on the line except _clamps on_.\n\n\"The warden came round,\" Odile said. \"Hale. Yesterday. With the form.\" She put the fish down in its place in the row. \"Said I'd got her account now. Said it was standard. Two hundred and eighty days, carried forward, at the standard rate. For her suit and her bottle and her beacon and the inspection on the crawler. He was very sorry.\"\n\n\"He's always very sorry.\"\n\n\"I said I'd pay it.\" Odile looked up at last. \"I said I'd pay it, Chief, because what else do you say? And he said that was very good of me and wrote it down. And then he said, was there anything of hers I'd found, any papers, any messages. For the inquiry.\" She was watching Maren's face. \"I said no. Because I hadn't looked yet.\"\n\n\"And now you have.\"\n\n\"And now I have.\"\n\nOdile reached under the pillow and brought out a strip of grey foil, the kind the relay printers used for hardcopy, folded small and soft with handling. She held it out.\n\n\"It was in her boot,\" she said. \"Her deck boot. The left one. Inside the liner, under the heel. She always kept her money there when we were kids, in case somebody went through her pockets. I knew where to look.\" Her mouth moved. \"Nobody else would.\"\n\nMaren unfolded the foil.\n\nIt was a relay transcript, printed in the cramped type the old relay printers used, and it had been printed by hand, one line at a time, as if somebody had been feeding the printer a little at a time so it wouldn't log a full job. It was headed with the Halloran-Vey wheel and a string of routing codes, and below the codes, a single block of text.\n\n_FROM: Combine Operations, Halloran. TO: Factor-designate A. QUIST, by beacon ahead of CLEMENT. SUBJECT: Consolidation of Corva Operation._\n\n_1. Corva Operation to close effective arrival of factor-designate. Operation no longer commercially viable following Sorrel price adjustment. Board resolution 2391/114 refers._\n\n_2. Skimmer PATIENCE to complete current season dips to maximise final load. Vessel to be decommissioned and scuttled in Gall at season end. Salvage value does not justify transit._\n\n_3. Skilled bonded (est. 300, PATIENCE complement) to be transferred with accounts aboard CLEMENT to Levy Office, Sorrel Station, for assignment under Combine-Levy labour agreement 2390/22. Transfer to be presented as relocation._\n\n_4. Kettle Camp installations and bonded accounts (est. 2,100 households) to remain in place. Supply to cease on departure of CLEMENT. Accounts to be offered at discount to secondary holders._\n\n_5. Factor to manage expectations. Contingency authority (Schedule H) confirmed. ADMONITION to follow as escort._\n\nMaren read it once, slowly, and then again. The fan rattled. Somewhere forward of the Shelf the drum was beginning its spin-up for the second dip, a long rising groan that came through the deck like a tide.\n\n\"What's the Levy,\" said Odile.\n\n\"The Levy Office is how the Combine rents bonded to the Sorrel lane forts,\" Maren said. Her own voice sounded strange to her. \"For the war. Diggers. Loaders. People to stand on gun-decks and fill sandbags with ice. They pay the Combine by the head. The Combine pays the bonded the standard rate against their account. Most of them never come back up the lane.\"\n\n\"And the Camp.\"\n\n\"_Supply to cease._\"\n\n\"What does that mean?\"\n\nMaren looked at her. Odile was nineteen. She had been born on Kettle, in the Camp, in the warrens of the third shaft, where her mother had carved fish and her father had died of the ice cough when she was two; she had never been anywhere else. She knew what supply meant. She was asking because she wanted somebody to say it so she would not have to.\n\n\"It means nobody's coming back,\" said Maren. \"It means the _Clement_ leaves and doesn't come again, and the Camp has what's in its tanks and its stores, and when that's gone, it's gone. The refinery runs on what the _Patience_ brings it, and the _Patience_ will be at the bottom of Gall. They'll have three months, maybe. Four, if they're careful. Then the air plant stops.\"\n\n\"Two thousand households.\"\n\n\"Twenty-one hundred.\"\n\n\"And then somebody buys their accounts,\" said Odile, very quietly. \"At a discount. Somebody buys the debts of dead people.\"\n\n\"Somebody always does.\"\n\nOdile put her face in her hands. She didn't cry. She sat there with her hands over her face and her shoulders very still, breathing, and after a while she said through her fingers, \"She told someone.\"\n\n\"She said so. On the line.\"\n\n\"She'd have told me. She told me everything. She didn't tell me this.\" Odile took her hands away. Her eyes were dry and terrible. \"She'd only not tell me if she was scared for me. If she'd told somebody else first and it had gone wrong. If she thought they'd—\" She stopped. \"Who'd she tell, Chief?\"\n\n\"I don't know.\"\n\n\"She'd have told someone she trusted. Someone she—\" Odile's mouth twisted. \"She was seeing somebody. The last couple of months. She wouldn't say who. She went all quiet and pleased about it, like when we were kids and she'd stolen something. I thought it was one of the dock boys.\"\n\n\"Was it?\"\n\n\"I don't know. She said—she said he was funny. She said he made her laugh in the lock.\" Odile looked at the rows of her sister's things on the blanket: the comb, the fruit, the fish. \"She said he was always in debt and he didn't care. She said it was restful.\"\n\nMaren's hands had gone very cold. She folded the foil up again along its old creases, small and soft, and held it.\n\n\"Keep this between us,\" she said. \"Not Hale. Not anyone. Not even the runners.\"\n\n\"Why?\"\n\n\"Because the last person who read it told somebody,\" said Maren, \"and she's in Gall.\"\n\n## Relocation\n\n[\n  Place: #The Drum\n  Characters: @@Maren Tsolo @@Aurelian Quist @@Corwin Hale @@Abel Tsolo @@Danek Sorell @@Grandam Teska @@Bram Kovac @@Odile Arda\n  When: same day\n]\n\nQuist told them that evening, at the change of shift, in the drum hall, under the names.\n\nHe did it well. Maren had to give him that, afterward, when she had the stomach to give him anything. He stood on the gallery with Hale beside him and the marine sergeant at his back, in his plain dark coat with the wheel on the lapel, and he did not read from a slate. He told them that the Combine had reviewed its operations in the Corva system and had concluded, with regret, that the market for Corva deuterium could no longer sustain them. He told them that the _Patience_ was an old ship, older than most of them, and that she would finish her season and then be retired. He told them that the Combine valued its skilled bonded very highly, and that every one of the _Patience_'s complement would be relocated, with their accounts intact and in good standing, to new postings in the Sorrel lanes, where the work was steady and the air was cheap. He told them the _Clement_ would carry them. He told them it would sail at the end of the month.\n\nHe told them nothing about the Levy, or the war, or the Camp.\n\nHe did not lie about the Camp. That was the clever thing. When old Pirro from the Bucket crew shouted up from the floor, _What about our families? What about the Camp?_, Quist turned to look at him with his long grave lined face and said that the Kettle installations would be transferred to a successor operator under the usual terms, and that the Combine's obligations to the Camp's residents would pass with them, and that family members of relocated bonded who wished to follow on were welcome to apply for passage at their own account. Every word of it was true. Maren, standing at the back of the hall under the drum with the foil in her pocket, could hear exactly how true each word was, and exactly how much it weighed.\n\n_At their own account._ A passage on the _Clement_ to Sorrel cost more than a rigger earned against his debt in eight years.\n\nThe hall took it the way bonded halls took things. There was a long silence, and then a noise, a sort of collective exhalation like a fan spinning down, and then the arguments began, small ones, everywhere at once, people turning to their neighbours. A woman was crying near the slot. Somebody was laughing. Danek Sorell, beside Maren, said \"Sorrel,\" three or four times, as if he were trying to remember where he had heard the word.\n\n\"I've got kids in the Camp, Chief,\" he said. \"Three. Tamar's in the third shaft. What's he mean, apply?\"\n\n\"He means you can't.\"\n\n\"So we go to Sorrel and they stay.\"\n\n\"That's what he means.\"\n\n\"For how long?\"\n\nMaren didn't answer him.\n\nUp on the gallery, Quist had stepped back, and Hale had stepped forward with his slate under his arm and his soft patient voice raised just enough. Order, the warden said. Questions to be raised with section chiefs, who would be meeting with the factor individually over the next days. Dips to continue as rostered. Air rations unchanged. Any bonded found organising, or refusing duty, or damaging Combine property, would have their accounts reviewed, with all that that implied, and their families' accounts likewise. He said it gently. Bram Kovač and two other trusties stood at the foot of the gallery stair with their shock-sticks loose in their hands, looking at nobody in particular.\n\n\"Organising,\" said Teska, loudly, from the bench near the drum where she always sat. \"What's that, organising? Is that talking? Is it organising if I talk?\"\n\n\"Grandam,\" said Hale, with great kindness, \"nobody's going to stop you talking.\"\n\n\"No,\" said Teska. \"You never have.\" She turned her head toward the hall, with her one good eye. \"I've been on this ship sixty-one years. I came out on her in pieces. I've buried two husbands and a daughter on that line. Now they say they're going to sink her.\" She spat on the deck. \"Gall can have her. Gall's had everything else.\"\n\nSome of the hall laughed. Most of it didn't.\n\nMaren found her brother at the edge of the crowd near the riggers' stair, where he always was, where the talk was. He was flushed and bright-eyed and talking fast to a knot of young riggers, his hands moving, and when he saw her coming he broke off and came to meet her with his arms open like a man at a party.\n\n\"Sorrel,\" he said. \"Did you hear him? Sorrel, Maren.\"\n\n\"I heard him.\"\n\n\"Off this rock. Off this ship. Do you know what they've got on Sorrel? Real gravity, on the forts. They've got markets. They've got—God, I don't know what they've got, I've never been anywhere. Neither have you.\" He caught her by the shoulders. His breath smelled of the illegal still in the dock section, which meant he had been celebrating since before the hall. \"We're getting out. Both of us. Thirty years they've had us hanging off this planet on a string and now they're letting us go.\"\n\n\"They're not letting us go.\"\n\n\"Same thing.\"\n\n\"It isn't, Abel.\"\n\nHe looked at her face, and some of the brightness went out of his. He let go of her shoulders.\n\n\"You've got that look,\" he said. \"Your chief's look. Like something's about to walk.\"\n\n\"Something is.\"\n\n\"What?\"\n\nShe looked at him. Her little brother, twenty-nine years old, the same height as her and twice as handsome, with their mother's eyes and their father's absence and a laugh that had been getting him out of trouble since he was four. Everyone on the _Patience_ liked Abel. Everyone on the _Patience_ was owed money by Abel, or owed him a favour, or both. He had never kept a credit in his account for longer than a week in his life. It was, Lusine had said to her sister, restful.\n\n\"Not here,\" Maren said.\n\n[\n  Place: #The factor's cabin\n  Characters: @@Maren Tsolo @@Aurelian Quist\n  When: same day\n]\n\nThe factor sent for her two hours after the hall.\n\nHe had taken Moberly's old cabin, forward of the bridge, and done nothing to it; it was still Moberly's, with the fat man's soft chairs and his hideous picture of a sailing ship on a green sea, and his stains on the carpet. Quist sat behind Moberly's desk with a single slate in front of him and a cup of real coffee, which Maren could smell from the door, and he got up when she came in, which no factor had ever done.\n\n\"Chief Tsolo. Thank you. Sit down, please.\"\n\nShe stood.\n\nHe looked at her for a moment, and then sat down again himself, without fuss. \"As you like. Would you like coffee? It's real. I'm told there hasn't been any on this ship in ten years.\"\n\n\"No.\"\n\n\"No.\" He turned the cup a little on its saucer. \"I'll come to the point, then. I need a tether-chief to manage the end of the season. You're the senior chief on this ship and the crew listen to you, which is not true of the others, or of the warden, though he'd like to think so. I need the last dips run clean, the last loads brought up, and the _Patience_ ready for decommission on the twenty-ninth. I need the crew calm while it happens. I can offer you something for it.\"\n\n\"What?\"\n\n\"An assessment,\" said Quist. \"When you reach Sorrel. As supervisory rather than general labour. It would mean a different rate against your account, a different kind of work. You'd be off the gun-decks.\" He paused. \"You'd keep your air.\"\n\n\"And Abel?\"\n\n\"Your brother? I could put him on the same assessment. I'd have to bend it.\"\n\n\"And Danek Sorell's three children in the third shaft?\"\n\nQuist did not answer at once. He looked down at the slate in front of him, and then up at her again, and his long lined face did not change, but something in it went still, the way a man goes still when he hears a sound in the dark.\n\n\"You've read the dispatch,\" he said.\n\nMaren said nothing.\n\n\"The advance dispatch. On the beacon. The one that came ahead of me.\" He nodded slowly. \"There was a runner on the relay. The one who died on the line. I'm told she worked the relay on her off-shifts.\"\n\n\"Lusine Arda.\"\n\n\"Lusine Arda. And now you've read it.\" He sat back. \"I wondered how long it would take. I wondered who it would be. I'd have said you, if you'd asked me. I've been in this work a long time, Chief Tsolo, and there's always one.\"\n\n\"Then you know.\"\n\n\"I know what I was sent to do.\" He picked up the coffee and drank some of it and put it down. \"The Corva operation is finished. It's been finished for two years; it just hasn't been told. The Sorrel yards went over to catalysed helium last spring, and the price of deuterium in the outer lanes fell by two-thirds in a quarter, and there is no longer any way to bring Corva gas up the lane and sell it for more than it costs to get it out of the sky. So the Board has done what boards do. It has cut its losses. The ship is worth nothing; it goes into Gall. The crew are worth something, to the Levy; they go to Sorrel. The Camp is worth less than nothing. The Camp is a liability. So the Camp is left in place, and its accounts are sold to a discount house in Halloran for a fraction of a mark on the hundred, and the discount house will never send anybody to collect, because there will be nobody to collect from.\"\n\n\"Two thousand households.\"\n\n\"Twenty-one hundred.\"\n\n\"You're going to leave them to die.\"\n\n\"I'm going to leave them,\" said Quist, \"to be somebody else's problem. That's the form of words. I didn't write it.\" He looked at her steadily. \"I want you to understand that I'm not a stupid man, Chief Tsolo. Nor a cruel one, I think. I've done this before. I closed Bellamy Deep in eighty-four and the Hollow Moons in eighty-seven. Bellamy went quietly; most of them got out on the last ore boats, as stowaways, and I looked the other way. The Hollow Moons didn't go quietly, and it didn't help them. It's always worse when it isn't quiet.\"\n\n\"And Tamsin's Rock?\" said Maren.\n\nIt was a guess, a name she had heard in the infirmary once, late, from Ekene, and never asked about. She saw it land. He did not flinch; he was too old and too practised to flinch. But he put the cup down very carefully, so that it made no sound on the saucer, and he took his hand away from it.\n\n\"I wasn't the factor at Tamsin's Rock,\" he said.\n\n\"But you know what happened there.\"\n\n\"Everybody in the Combine knows what happened there. That's what Tamsin's Rock is for.\" He looked at her for a long moment. \"If you know what happened at Tamsin's Rock, then you know why I'm telling you the truth. Because you're going to do something, Chief Tsolo. I can see it in you. You're going to talk to your crew, and the crew are going to talk to the Camp, and somebody is going to have an idea. And I'd rather you did it knowing exactly what you're up against than not.\" He spread his hands on the desk. \"The _Admonition_ is two weeks behind me. She has sixty marines and a torpedo bay. And I have contingency authority. Whatever you do, you can't make it end any better than it's going to end now. You can only make it worse.\"\n\n\"For who?\"\n\n\"For everyone,\" said Quist. \"For you. For them. For me.\" He paused. \"Most of all for them.\"\n\nMaren looked at him across Moberly's desk, at his plain coat and his good coffee and his long sorrowful face. She thought of Lusine's voice going faint on channel four. _I don't think it was the clip._\n\n\"Was it you?\" she said. \"Lusine. Did you have her line cut?\"\n\nFor the first time Quist looked genuinely surprised.\n\n\"Her line was cut?\"\n\n\"Her clip. Somebody took the spring two-thirds through.\"\n\nHe was quiet for a moment. Then he said, \"No. It wasn't me. I didn't know her name until this morning.\" He looked down at the slate. \"But I'd look closer to home, if I were you. I'd look at who on this ship would have wanted the Combine to be grateful to them. There's always somebody. There's always somebody who'd like to be on the right list.\" He looked up. \"The offer stands, Chief. Supervisory. You and your brother. Think about it.\"\n\n\"I've thought about it,\" said Maren, and walked out.","wordCount":4620,"createdAt":1793093707146},{"id":"HcLL24Lj_HsVT51EIH0hv","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"KUeDnmR-PMrQG7-kIhydF","text":"The infirmary was the one place on the _Patience_ that was ever warm. Ekene kept it that way on purpose, cooking the heat exchangers past their rating and fiddling the logs, because, he said, sick people healed better warm and well people talked more truthfully; and it was true that you heard things in the infirmary at night that you did not hear anywhere else on the ship. It was a narrow white room with eight bunks, a dispensary cage, a surgical bay behind a curtain, and a single round port the size of a dinner plate that looked out along the hull toward Gall's limb. Ekene had hung a dried flower in a bag over the port. Nobody knew where he had got a flower.\n\nHe was sitting at the dispensary counter when she came in, writing up the day by the light of a single lamp. He looked up, and took off his reading lenses, and looked at her for a long moment without saying anything. Then he got up and came round the counter and put his arms round her, and she stood in them with her face against the stiff cotton of his coat and her fist in her pocket and did not cry, because she had not cried in nine years and was not about to start now in front of a dispensary cage.\n\n\"I heard it,\" he said into her hair. \"Half the ship was on the line channel. I heard you talking to her.\"\n\n\"I didn't do anything.\"\n\n\"You talked to her.\"\n\n\"I couldn't do anything, Ekene. The Gull's thruster was stripped. It's been stripped three weeks. I put in for the part three times.\" She let go of him and stepped back. \"I ran the line. That's what I did. I sat there and ran the dip and I listened to her go.\"\n\n\"If you'd stopped the dip—\"\n\n\"If I'd stopped the dip the line would have walked and we'd have lost Odile as well. And the Bucket. And the drum, maybe. And they'd have docked the whole crew for the load.\" She sat down on the end of the nearest bunk. \"That's the arithmetic. I did the arithmetic.\"\n\nEkene went back behind the counter and filled two cups from the urn and brought them over. It was the infirmary's tea, which was not tea at all but something he grew in a tray under the ultraviolet lamp in the surgical bay and dried and smoked, and which tasted like a wet fire. She drank it. He sat beside her on the bunk. He was fifty-two, eleven years older than she was, a big soft-spoken man with grey in his beard and the long patient hands of somebody who had spent his life doing small things carefully to people in pain. He had come to Corva on a medical contract six years ago, not bonded, which made him a strange thing on the _Patience_, a free man who could have left on any _Clement_. He had not left. Maren had asked him why, once, and he had said that he was a coward and the Combine's other postings were worse; and then, later, in the dark, that it was her.\n\n\"The factor,\" he said.\n\n\"You saw him?\"\n\n\"He came by. Before the hall. He wanted to see the infirmary.\" Ekene turned his cup round in his hands. \"He asked about our stock of painkillers. How many beds. Whether we had a cold store and what was in it. He was polite. He asked very good questions.\"\n\n\"What kind of questions?\"\n\n\"The kind an auditor asks. What things cost. What could be moved.\" He looked at her sideways. \"What do you think _changes_ means, Maren?\"\n\n\"I think the _Clement_'s eleven days early,\" Maren said. \"I think nobody sends a new factor to a skimmer that's making its numbers just to say hello.\" She drank the rest of her cup in one swallow, burning her throat. \"And I think somebody cut Lusine's line.\"\n\nShe took her fist out of her pocket and opened it.\n\nEkene looked at the clip for a long time. Then he took it from her palm, gently, the way he took everything, and turned it under the lamp, and found the stub of the gate spring and the bright clean face of the cut, two-thirds of the way through.\n\n\"A blade,\" he said.\n\n\"A fine one. Not a cutter. Cutters crush. That's a saw cut, or a knife that's been honed. Somebody took that spring two-thirds through, so it'd hold in calm and go in the first hard shock.\" She heard her own voice, very level, the tether-chief's voice. \"Every runner checks her clip at the lock. You snap it, you load it, you look at the gate. You don't look at the spring. Nobody looks at the spring.\"\n\n\"Who could do this?\"\n\n\"Anybody who could get to her harness. Anybody in the runners' lock, between her last check yesterday and the dip. Riggers. Runners. Dock crew. Wardens.\" She stopped. \"Me.\"\n\n\"Not you.\"\n\n\"No. Not me.\" She took the clip back. \"She said something on the way down. On four, so it's not on the log. She said she'd read a dispatch on the relay, something that came ahead of the _Clement_ on the beacon. She said it was about all of us. She said she'd told someone, and she shouldn't have.\"\n\n\"Told who?\"\n\n\"She didn't say. She went into the static.\" Maren closed her hand on the clip again. \"She said, _I don't think it was the clip._\"\n\nThey sat for a while without talking. Through the port, over Ekene's shoulder, she could see the long curve of the _Patience_'s hull lit by Gall-shine, rust-coloured, and beyond it the edge of Gall itself, and beyond that the black. It took her a moment to see what she was looking at. There was a smudge in the black, just above the planet's limb: a faint pale patch no bigger than a thumbprint, like a breath on glass, with the barest suggestion of a tail.\n\n\"There it is,\" said Ekene, following her eyes. \"Teska's comet.\"\n\n\"The Lamp.\"\n\n\"She says it takes the dead out.\"\n\n\"She says a lot of things.\" Maren stood up. She was very tired. She put the clip back in her pocket and felt its small weight there, against her hip, where her line knife hung on her coat. \"I'm going to find out who she told.\"\n\n\"Maren.\"\n\n\"What.\"\n\n\"Be careful who you ask,\" said Ekene.\n","wordCount":1088,"createdAt":1793093706932},{"id":"Le9J23E8AUnBcrKo_cnCf","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"0T46v5SbLeM2hWt1bnUYG","text":"She found Abel at the third bell of the night, in the blister.\n\nThe blister was a dome of thick old glass on the _Patience_'s dorsal hull, a relic of the days when skimmers had carried passengers who wanted to look at things. It was cold, and badly lit, and the crew used it for courting and drinking and the kind of conversations that couldn't be had anywhere else, and nobody ever cleaned it. Abel was sitting on the floor with his back against the frame and a bottle of dock-still between his knees, looking up. He didn't turn round when she came in. He held the bottle up over his shoulder.\n\nShe took it, and drank, and gave it back, and sat down beside him.\n\nAbove them, through the scratched glass, Gall filled half the sky, ochre and purple, a storm the size of a world turning slowly on its southern limb. Above the storm, in the black, the Lamp hung like a thumbprint of light. It was brighter than it had been three days ago. You could see the tail properly now, a long faint fan of pale green going away from the sun, so delicate that if you looked straight at it it disappeared, and came back when you looked to the side.\n\n\"Teska says it takes the dead out,\" said Abel.\n\n\"Teska says a lot of things.\"\n\n\"She says it'll be back when our grandchildren are dead.\" He drank. \"That's a long time to be a comet.\"\n\n\"It's not a long time for a comet.\"\n\n\"No.\" He laughed a little. \"I suppose not.\" He held the bottle up to the glass and looked at the Lamp through it, through the cloudy brown spirit, so that it wobbled. \"I keep thinking about her. Lusine. Out there. Going in.\"\n\n\"So do I.\"\n\n\"You talked to her. The whole way. I heard you.\" He lowered the bottle. \"That was a good thing you did, Mar.\"\n\n\"I didn't do anything.\"\n\n\"You did, though.\" He turned his head and looked at her for the first time. His face was grey and his eyes were wet and red-rimmed, and she could not tell how much of it was the still. \"You always think you didn't do anything. You do more than anybody.\"\n\nShe looked at him for a long moment, at his handsome tired face in the Gall-light, her brother, whom she had carried on her hip through the third shaft when their mother went into the cloud.\n\n\"Were you seeing her, Abel?\"\n\nHe didn't move. He didn't look away. But she had known him all his life, and she saw the small thing happen behind his eyes, the thing that happened when he was eight and she asked him who had got into the dried fruit, the half-second of arithmetic.\n\n\"Seeing her?\"\n\n\"Lusine. Odile says she was seeing somebody. Somebody funny. Somebody always in debt who didn't care.\"\n\nAbel laughed. It was almost his real laugh. \"That's half the riggers on the ship.\"\n\n\"Were you?\"\n\n\"We were friendly.\" He shrugged. \"A bit. Now and then. She was—she was good fun, Mar. She liked a joke. We'd have a drink in the lock after shift. It wasn't serious. She wasn't serious about anybody.\" He drank. \"Why?\"\n\n\"Did she tell you anything? Before she died? About the _Clement_? About a dispatch?\"\n\n\"A dispatch?\" He frowned. \"What dispatch?\"\n\n\"Did she?\"\n\n\"No.\" He shook his head. \"No. Why would she tell me about a dispatch? I'm a rigger. I can barely read the duty board.\" He smiled at her, the old smile, _don't worry, it's me_. \"What's this about?\"\n\nMaren looked at the Lamp.\n\n\"Nothing,\" she said. \"It's late. I'm tired.\"\n\n\"You're always tired.\"\n\n\"I'm always tired.\"\n\nHe put his arm around her shoulders, the way he used to when he was sixteen and had just grown taller than her and wanted her to know it, and she let him, and they sat together in the cold blister and looked at the comet. His arm was warm and heavy and familiar. His hand, where it hung over her shoulder, was shaking, very slightly, with a small fine tremor, the kind of tremor that a man gets when he has been drinking for three days because he cannot stop seeing something.\n\nShe did not say anything about it. She sat there in her brother's arm and looked at the Lamp and thought, very clearly, _he's lying to me_, and then, because she was the tether-chief and that was what tether-chiefs did, she began to do the arithmetic.\n\n\n# Sanitation\n\n## The Belly\n\n[\n  Place: #The Belly\n  Characters: @@Maren Tsolo @@Odile Arda @@Grandam Teska @@Danek Sorell @@Corwin Hale @@Bram Kovac @@Abel Tsolo\n  When: 11 November 2391\n]\n\nUnder the drum there was a space nobody had ever found a use for.\n\nThe drum sat in a cradle of girders that went down through three decks to the keel, and between the girders, under the drum's great curved belly, the shipwrights had left a hollow the size of a chapel: a ribbed, dark, echoing void full of cable runs and bearing housings and old grease, where the noise of the drum when it was turning was so loud you could not hear your own voice, and when it was not turning, so quiet you could hear the hull tick. The crew called it the Belly. You got into it by a maintenance hatch behind the number four brake, and a ladder, and a long crawl on your hands and knees along a cable tray. Riggers went there to sleep off shifts and to do things they did not want logged. Wardens did not go there, because wardens were big men and the cable tray was narrow.\n\nMaren called the meeting for the fourth bell of the night, in the dead hour between dips, when the drum was still.\n\nEleven of them came. She had asked for twelve. They sat on the girders and the bearing housings in a rough ring, with one lamp turned low on the deck plates between them, and their faces came and went in its light: Teska, wrapped in two coats, with her white eye shining; Odile, very upright, very quiet; Danek Sorell, too big for the space, folded up on a girder with his knees under his chin; old Pirro from the Bucket crew; two dock hands, a married pair called Senna and Ivo, who between them knew every valve on the forward collar; three riggers Maren trusted and two she trusted less, because you needed the ones who talked as well as the ones who didn't. Ekene was not there. She had not asked him. A free man could be hanged for what the bonded only had their accounts reviewed for.\n\nAbel was not there either. She had asked him. He had said yes, and smiled, and not come.\n\n\"Read it,\" said Teska. \"Read the paper. I want to hear it in my own ears.\"\n\nMaren read it. She read it in the tether-chief's voice, without any expression at all, every line, the routing codes and the board resolution and the numbers, _est. 300_, _est. 2,100 households_, _supply to cease_. When she had finished nobody said anything for a long time. Somewhere in the hull below them a pump came on and ran and went off again.\n\n\"Sorrel,\" said Danek at last, in the same voice he had used in the hall. \"The forts.\"\n\n\"The forts.\"\n\n\"And the Camp.\"\n\n\"Three months. Four if they're careful.\"\n\n\"Tamar's got the cough already. She had it last winter.\" Danek looked at his own big hands. \"Four months she won't make.\"\n\n\"Nobody'll make it,\" said Pirro. \"Not the old ones. Not the little ones. The plant'll go first, then the heat. You'll have people burning their bunks.\" He spat into the dark. \"I was in the Camp when the third shaft caved in sixty-eight. We were nine days without the plant. I saw what nine days did.\"\n\n\"So we don't go,\" said Senna, from the dock. \"We refuse. Strike. They can't move three hundred people on to the _Clement_ if three hundred people won't walk.\"\n\n\"They can if they've got sticks.\"\n\n\"They've got six marines and a dozen trusties. We're three hundred.\"\n\n\"And the _Admonition_,\" said Maren. \"Two weeks behind the factor. Sixty marines and a torpedo bay. Due on the twenty-second.\" She looked round the ring. \"And then they don't need us to walk.\"\n\n\"Then we take the ship,\" said Teska.\n\nThey all looked at her. She was sitting hunched on her bearing housing in her two coats, very small, with her good eye glittering in the lamp.\n\n\"We take her,\" she said. \"She's ours. We built her. Well, they built her, but we've had her sixty years; we've kept her flying when they wouldn't send the parts. Every bolt in her's been turned by one of us. We take her and we don't sink her. We keep dipping. We keep the Camp breathing.\" She shrugged inside the coats. \"Let the Combine come and get her.\"\n\n\"The Combine will,\" said Maren.\n\n\"Then we'll be dead in a month instead of four. I'm eighty-three. I can spare a month.\"\n\n\"Danek's children can't.\"\n\n\"Danek's children,\" said Teska, with great gentleness, \"are going to die on the ice anyway, Maren. That paper says so. All you're doing is choosing which way.\"\n\nNobody said anything to that.\n\nMaren had known it was coming. She had known since the night in the Shelf, with the foil in her hand and Odile's face in front of her, that it would come to this: a ring of tired people in the dark under the drum, with nothing in front of them but a wall, and somebody saying the thing out loud. She had spent four days running the arithmetic, in the gallery, at the board, in Ekene's bunk with her eyes open. It came out the same every time. Strike, and they would be broken. Comply, and the Camp would die. Fight, and the _Admonition_ would come, and then the Camp would die and so would they.\n\n\"If we take her,\" she said, \"we have to take the _Clement_ too. Same night. Same hour. Otherwise the factor gets on her and casts off and he's two weeks from the _Admonition_ and he tells them everything. And the _Clement_'s got the marines, and the marines have guns.\"\n\n\"How many?\"\n\n\"Six. Sergeant called Oyelowo. They're good. They're not like the trusties. They've done this before.\"\n\n\"We'll need sticks,\" said a voice from the dark at the edge of the ring. \"At least.\"\n\nThe lamp didn't reach where it came from. It didn't need to. Everybody knew that voice, soft and patient and reasonable, and the ring went still the way a rigger goes still on the line when the trace jumps.\n\nCorwin Hale came forward into the light at his slow walk, ducking under a girder. Behind him, in the dark, Maren could see the shape of Bram Kovač crouched at the end of the cable tray, blocking it.\n\n\"I'm sorry to interrupt,\" said Hale. \"I didn't mean to listen. Sound carries in here. It's a terrible place for a secret.\"\n\n\"How did you get in?\" said Odile. \"The tray's too narrow for you.\"\n\n\"There's a hatch from the keel side, if you know where it is.\" Hale smiled faintly. \"I've been on this ship twenty years, Arda. I know where everything is.\" He looked round the ring. His eyes rested on each of them in turn, mild and unhurried, as if he were taking a register: Teska, Danek, Pirro, Senna, Ivo, the riggers. Last of all he looked at Maren. \"May I sit down?\"\n\nNobody answered. He sat anyway, on the end of Pirro's girder, so that the old man had to shift up.\n\n\"You've read the dispatch,\" he said. \"I know you have. Arda's sister had it in her boot. I've been waiting for you to do something about it.\" He folded his big hands on his knee. \"I'm on the list too, you know. I'm bonded. I've got an account. My mother's in the Camp, on the second shaft, and she's sixty-eight, and she doesn't have four months either.\" He looked at Danek. \"Trusties go to Sorrel with everybody else, Sorell. They don't need wardens on the forts. They've got officers for that. I'll be filling sandbags beside you.\"\n\n\"You'll be filling sandbags,\" said Teska, \"when Gall freezes.\"\n\n\"Grandam,\" said Hale, \"I know what you think of me. I know what you all think of me. You think I'm the Combine's dog. You're right. I've been the Combine's dog for twenty years, because the Combine fed me.\" He opened his hands. \"The Combine's stopped feeding me. That's all. I'd like to eat.\"\n\n\"What are you offering?\" said Maren.\n\n\"Twelve trusties with sticks. The keys to the bridge and the armoury, such as it is. Two old flechette carbines that the Combine forgot it issued. And the warden's office, which means the logs, which means that whatever happens, the Combine won't hear about it from this ship until we want it to.\" He met her eyes. \"And me. Who knows where everything is.\"\n\nMaren looked at him. She thought of Lusine's voice on channel four. _I told someone._ She thought of Quist across Moberly's desk, turning his coffee cup: _I'd look at who on this ship would have wanted the Combine to be grateful to them._ She thought of the form on Hale's slate, already filled in, in his neat hand, before she ever came down the gallery ladder.\n\nShe thought of six marines with guns.\n\n\"What's Schedule H?\" she said.\n\nHale blinked. \"I'm sorry?\"\n\n\"In the dispatch. Paragraph five. _Contingency authority, Schedule H, confirmed._ What's Schedule H?\"\n\n\"I've no idea,\" said Hale. \"Factors' business. I'm a warden.\" He shrugged. \"Contingency means _if things go wrong_. I expect it means the _Admonition_.\"\n\nHe said it easily. Maren watched him say it. She could not tell. She had been watching Hale for twenty years, and she had never once been able to tell what was behind that mild patient face, and she could not tell now.\n\n\"We'll think about your offer,\" she said.\n\n\"Don't think too long,\" said Hale, getting up. \"The twenty-second isn't far.\" He looked round the ring once more, taking his register. \"And none of you need worry about me. I can keep a secret. I've kept a great many.\" He ducked back under the girder into the dark, and they heard him go, slow and heavy, toward his hatch in the keel; and after a moment Bram Kovač's shape at the end of the cable tray went too.\n\nThe ring sat in silence.\n\n\"Well,\" said Pirro. \"Now we have to.\"\n\n## A crushed hand\n\n[\n  Place: #The infirmary\n  Characters: @@Ekene Adu @@Maren Tsolo\n  When: 11 November 2391\n]\n\nThe _Clement_'s crew were not bonded. They were Combine contract hands, hired for the run at Halloran, and they kept to their own ship mostly, and looked at the _Patience_'s bonded the way people look at animals in a pen: without malice, without much interest. But the _Clement_'s medic had been left at Halloran with a fever, and so when one of her cargo hands got his left hand caught in the closing door of a cold-hold hatch, on the morning of the eleventh, they brought him across the collar to Ekene.\n\nMaren heard about it from Ekene that evening. She came to the infirmary after the second dip and found him at the counter, not writing, sitting with his reading lenses in his hand and his face the colour of the counter.\n\n\"His name's Brandt,\" Ekene said. \"Yusuf Brandt. He's twenty-three. He's from Halloran, from the yards. He's never been out of the inner lanes before. He thinks Corva is the most boring place he has ever been in his life.\" He turned the lenses over. \"I had to take two fingers. The hatch was a cryo-hatch, the heavy kind, with the frost seals. It crushed them flat. So I gave him a lot of the good painkiller, which the Combine charges at nine marks a dose, and while I was working, he talked.\"\n\n\"What about?\"\n\n\"About his ship. About the cold hold. About how he's on cold-hold duty this run, which means checking the cryostats every four hours, and how it's the worst duty on the ship because the hold's at sixty below and the gloves are useless. About how there's nothing in the cold hold this run except the usual medical stocks and one other thing.\" Ekene put the lenses down on the counter, very carefully. \"About how the factor comes down to look at the other thing every day. Every single day. With the sergeant. And stands and looks at it. And how the hands call it the egg.\"\n\nMaren said nothing.\n\n\"I asked him what kind of egg,\" said Ekene. \"He laughed. He said a grey one, about this long\"—he held his hands apart, the length of a forearm and a half—\"in its own cryostat, with its own power and its own alarm, and a stencil on the casing that he'd read so many times on cold-hold duty he could say it in his sleep. And then he said it for me. In his sleep, nearly. The painkiller was very good.\" Ekene looked at her. \"_Sanitation Agent. Pattern H. Factor's authority only._\"\n\n\"Pattern H.\"\n\n\"Schedule H. Pattern H.\" His voice was steady and quite empty. \"I've seen that stencil before, Maren. I didn't think I'd ever see it again. I think I came to the end of the lanes so that I wouldn't.\"\n\n\"Tamsin's Rock,\" said Maren.\n\nHe closed his eyes.\n\n\"Tell me,\" she said.\n\n\"Not here.\" He opened them again and looked toward the curtained bay where Yusuf Brandt was asleep, two fingers lighter, dreaming his painkiller dreams of Halloran. \"Not tonight. I need to know you've seen it first. I need to know I'm not a frightened old man hearing things in a boy's babbling.\" He put out his hand and took hers on the counter, hard, the way he never did, his long gentle fingers cold as the cold hold. \"If it's there, Maren, then everything you've been planning in the Belly is something else. Everything. Do you understand? You can't take a ship with that thing on the other end of the collar. You can't do anything.\"\n\n\"I can look at it,\" said Maren.\n\n[\n  Place: #The cold hold\n  Characters: @@Maren Tsolo @@Odile Arda @@Marta Oyelowo @@Aurelian Quist\n  Items: ^The Hush:#The cold hold\n  When: 12 November 2391\n]\n\nThe _Clement_ was mated to the _Patience_ at the forward collar, a great ring of armoured coupling with its own lock and its own guard, and on the _Clement_'s side of the collar there was a marine on duty all day and all night. There was no going through the collar.\n\nThere was going round it.\n\n\"It's eleven metres,\" said Odile, in the suit lock on the forward hull, checking Maren's harness for the third time. \"Outside. Along the collar fairing, then down the _Clement_'s spine to her number two maintenance hatch, which opens from outside, because they always do, in case somebody's stuck in a hold. Senna says the hatch is never alarmed. Senna says nobody on the _Clement_ thinks anybody's mad enough to go outside.\"\n\n\"Senna's never been outside.\"\n\n\"Senna's never been mad.\" Odile snapped the last clip and pulled on it. \"We're runners, Chief. Eleven metres is nothing. Eleven metres is the length of the drum hall.\"\n\n\"Eleven metres with Gall underneath it.\"\n\n\"Gall's always underneath it.\" Odile looked at her through her visor, her young fierce face very pale in the lock lights. \"You were a runner. You told me. You did four years at twenty kilometres. Before Hesketh made you chief.\"\n\n\"I was younger.\"\n\n\"You were braver,\" said Odile, and opened the outer door.\n\nIt was the second bell of the night shift, the dead time, and the hull was dark. They went out on to it on their hands and knees, clipped to a running line that Odile had rigged the night before, along the dorsal fairing of the collar, where the two ships' hulls met in a seam of scarred armour. Above them, to the left, the black was full of stars and the Lamp, which had grown again, a long pale streamer of light now with its tail split in two. Below them, to the right, was Gall.\n\nMaren had not been outside the _Patience_ in nine years. She had forgotten. You forgot, on the gallery, with the board in front of you and the line a green trace on a screen. You forgot that the line was real, that it hung down out of the keel slot into that, into the endless ochre floor of the world, banded and boiling and so close it seemed you could reach down and put your hand in it. You forgot the size of it. Lusine had fallen into it from eleven kilometres. From here, Maren thought, holding the running line with both hands and not looking down, from here you would fall for a long time.\n\n\"Don't look at it, Chief,\" said Odile on the suit channel. \"Look at your hands.\"\n\n\"I know.\"\n\n\"I know you know.\"\n\nThey went along the collar fairing and down the _Clement_'s long dull spine, hand over hand, past the green wheel of the Combine painted twenty metres high on her flank and lit from below by Gall-shine, so that it looked like a rusted sun. The number two maintenance hatch was where Senna had said it would be, a square of grey armour set flush in the hull with a recessed handle and a stencil that said NO ENTRY EXCEPT IN EMERGENCY. It was not alarmed. Odile opened it, and they went in feet first, and pulled it to behind them.\n\nThe cold hold was very dark and very cold, so cold that the moment the inner door of the maintenance lock opened, Maren's visor frosted at the edges and her suit heaters came on with a whine. They switched their lamps on low.\n\nIt was a long low hold, ribbed like the inside of a fish, with racks of sealed medical crates along both sides under a rime of frost, and at the far end, by itself, in a clear space on the deck, a cryostat.\n\nIt was smaller than she had imagined. A cylinder of brushed grey steel on a squat base, waist-high, with a ring of status lights round its upper rim glowing a steady green, and a frosted window in its lid. A thick power cable ran from its base to a socket in the hold wall. A second, thinner cable ran from its side to a box on the wall beside the socket, a grey box with a single red light on it and a keyhole.\n\nMaren went and stood beside it. She did not touch it. She bent and looked through the frosted window in the lid.\n\nInside the cryostat, cradled in a nest of white foam that smoked faintly with cold, lay an egg.\n\nIt was grey. Matte grey, the grey of good ceramic, without any shine at all, so that the lamp's light seemed to sink into it rather than lie on it. It was about the length of her forearm and a half, smooth, slightly irregular, like a real egg, an egg from some enormous bird; and it had a seam running round its widest part, very fine, like the join of a cup and a saucer. On its upper surface, stencilled in black, in neat Combine capitals, were three lines.\n\n  SANITATION AGENT\n  PATTERN H\n  FACTOR'S AUTHORITY ONLY\n\nBeneath the lines, small, the green wheel of Halloran-Vey.\n\nOdile came and looked over her shoulder. Her breath frosted the inside of her visor.\n\n\"What is it?\" she whispered.\n\n\"I don't know,\" said Maren.\n\nThat was true. It was also, she understood even as she said it, the last true thing she would be able to say about it. Because she was looking at it, at its smooth grey indifferent surface in its nest of smoking foam, and the cold of the hold was coming in through her suit, and something in the back of her skull, some old animal thing that had lived through twenty-six years on the line, was telling her very clearly and very quietly to back away.\n\nThere was a sound at the hold's forward end. A door.\n\nOdile caught Maren's arm. They killed their lamps together and stood still in the dark, by the cryostat, with its ring of green lights glowing between them; and the forward door of the cold hold slid open and let in a wedge of yellow light, and in the wedge, two figures in heavy cold-weather jackets with the green wheel on the shoulder. A short broad woman with a sidearm. A tall thin man.\n\n\"Every day,\" said Sergeant Oyelowo's voice, flat and bored, echoing down the hold. \"You know it's still there, sir. The board says it's still there. The light's green.\"\n\n\"I know,\" said Quist. \"Humour me, Sergeant.\"\n\nHe did not come in. He stood in the doorway in the wedge of light with his hands in the pockets of his jacket, looking down the long dark hold toward the cryostat; looking, it seemed to Maren, straight at her, though he could not have seen her, with her lamp out, behind the glow of the status lights. He stood there for a long moment. His face was in shadow. Then he took one hand out of his pocket and touched something at his throat, a cord, a small shape on it that caught the light for an instant, the size of a key.\n\n\"Thank you, Sergeant,\" he said, and stepped back, and the door slid shut.\n\nThey stood in the dark for a long time afterward.","wordCount":4333,"createdAt":1793108902059},{"id":"OcosIDnVHM77V-73UArgk","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"KUeDnmR-PMrQG7-kIhydF","text":"The infirmary was the one place on the _Patience_ that was ever warm. Ekene kept it that way on purpose, cooking the heat exchangers past their rating and fiddling the logs, because, he said, sick people healed better warm and well people talked more truthfully; and it was true that you heard things in the infirmary at night that you did not hear anywhere else on the ship. It was a narrow white room with eight bunks, a dispensary cage, a surgical bay behind a curtain, and a single round port the size of a dinner plate that looked out along the hull toward Gall's limb. Ekene had hung a dried flower in a bag over the port. Nobody knew where he had got a flower.\n\nHe was sitting at the dispensary counter when she came in, writing up the day by the light of a single lamp. He looked up, and took off his reading lenses, and looked at her for a long moment without saying anything. Then he got up and came round the counter and put his arms round her, and she stood in them with her face against the stiff cotton of his coat and her fist in her pocket and did not cry, because she had not cried in nine years and was not about to start now in front of a dispensary cage.\n\n\"I heard it,\" he said into her hair. \"Half the ship was on the line channel. I heard you talking to her.\"\n\n\"I didn't do anything.\"\n\n\"You talked to her.\"\n\n\"I couldn't do anything, Ekene. The Gull's thruster was stripped. It's been stripped three weeks. I put in for the part three times.\" She let go of him and stepped back. \"I ran the line. That's what I did. I sat there and ran the dip and I listened to her go.\"\n\n\"If you'd stopped the dip—\"\n\n\"If I'd stopped the dip the line would have walked and we'd have lost Odile as well. And the Bucket. And the drum, maybe. And they'd have docked the whole crew for the load.\" She sat down on the end of the nearest bunk. \"That's the arithmetic. I did the arithmetic.\"\n\nEkene went back behind the counter and filled two cups from the urn and brought them over. It was the infirmary's tea, which was not tea at all but something he grew in a tray under the ultraviolet lamp in the surgical bay and dried and smoked, and which tasted like a wet fire. She drank it. He sat beside her on the bunk. He was fifty-two, eleven years older than she was, a big soft-spoken man with grey in his beard and the long patient hands of somebody who had spent his life doing small things carefully to people in pain. He had come to Corva on a medical contract six years ago, not bonded, which made him a strange thing on the _Patience_, a free man who could have left on any _Clement_. He had not left. Maren had asked him why, once, and he had said that he was a coward and the Combine's other postings were worse; and then, later, in the dark, that it was her.\n\n\"The factor,\" he said.\n\n\"You saw him?\"\n\n\"He came by. Before the hall. He wanted to see the infirmary.\" Ekene turned his cup round in his hands. \"He asked about our stock of painkillers. How many beds. Whether we had a cold store and what was in it. He was polite. He asked very good questions.\"\n\n\"What kind of questions?\"\n\n\"The kind an auditor asks. What things cost. What could be moved.\" He looked at her sideways. \"What do you think _changes_ means, Maren?\"\n\n\"I think the _Clement_'s eleven days early,\" Maren said. \"I think nobody sends a new factor to a skimmer that's making its numbers just to say hello.\" She drank the rest of her cup in one swallow, burning her throat. \"And I think somebody cut Lusine's line.\"\n\nShe took her fist out of her pocket and opened it.\n\nEkene looked at the clip for a long time. Then he took it from her palm, gently, the way he took everything, and turned it under the lamp, and found the stub of the gate spring and the bright clean face of the cut, two-thirds of the way through.\n\n\"A blade,\" he said.\n\n\"A fine one. Not a cutter. Cutters crush. That's a saw cut, or a knife that's been honed. Somebody took that spring two-thirds through, so it'd hold in calm and go in the first hard shock.\" She heard her own voice, very level, the tether-chief's voice. \"Every runner checks her clip at the lock. You snap it, you load it, you look at the gate. You don't look at the spring. Nobody looks at the spring.\"\n\n\"Who could do this?\"\n\n\"Anybody who could get to her harness. Anybody in the runners' lock, between her last check yesterday and the dip. Riggers. Runners. Dock crew. Wardens.\" She stopped. \"Me.\"\n\n\"Not you.\"\n\n\"No. Not me.\" She took the clip back. \"She said something on the way down. On four, so it's not on the log. She said she'd read a dispatch on the relay, something that came ahead of the _Clement_ on the beacon. She said it was about all of us. She said she'd told someone, and she shouldn't have.\"\n\n\"Told who?\"\n\n\"She didn't say. She went into the static.\" Maren closed her hand on the clip again. \"She said, _I don't think it was the clip._\"\n\nThey sat for a while without talking. Through the port, over Ekene's shoulder, she could see the long curve of the _Patience_'s hull lit by Gall-shine, rust-coloured, and beyond it the edge of Gall itself, and beyond that the black. It took her a moment to see what she was looking at. There was a smudge in the black, just above the planet's limb: a faint pale patch no bigger than a thumbprint, like a breath on glass, with the barest suggestion of a tail.\n\n\"There it is,\" said Ekene, following her eyes. \"Teska's comet.\"\n\n\"The Lamp.\"\n\n\"She says it takes the dead out.\"\n\n\"She says a lot of things.\" Maren stood up. She was very tired. She put the clip back in her pocket and felt its small weight there, against her hip, where her line knife hung on her coat. \"I'm going to find out who she told.\"\n\n\"Maren.\"\n\n\"What.\"\n\n\"Be careful who you ask,\" said Ekene.\n\n\n# Consolidation\n\n## Lusine's locker\n\n[\n  Place: #The Patience\n  Characters: @@Maren Tsolo @@Odile Arda\n  Items: ^Lusine's clip:@Maren Tsolo\n  When: 5 November 2391\n]\n\nThe runners lived aft of the drum, in a long low compartment the crew called the Shelf, where the bunks were stacked four high along both walls and the air came in through a single overworked fan that had been rattling since before any of them were born. Each runner had a bunk and a locker. When a runner went into Gall, the locker was emptied by the warden's office, and anything of value was sold against the account, and the rest went into the waste cycler. It had been three days. The warden's office had not got round to Lusine's yet. Maren had made sure of that, by giving Bram Kovač two dips' worth of overtime on the drum.\n\nOdile was sitting on her sister's bunk when Maren came in, with the locker open beside her and its contents laid out on the blanket in rows, as if for an inventory. A spare undersuit. A comb. A packet of the cheap dried fruit they sold in the Camp at Midwinter. A cloth bag of hair ties. A stack of letters from somebody in the Camp, tied with string. A small battered slate with a cracked screen. A carved wooden fish, no bigger than a thumb, very old.\n\n\"That was our mother's,\" Odile said, without looking up. \"The fish. She carved it. She used to carve things. She said she'd teach me but she didn't.\"\n\nMaren sat down on the bunk opposite. \"I'm sorry, Odile.\"\n\n\"You keep saying that.\"\n\n\"I keep meaning it.\"\n\nOdile picked up the fish and turned it over in her fingers. Her face was swollen and blotched and fierce, and she had not slept, by the look of her, since the dip; she had done her shifts anyway, both of them, on the line, at six kilometres, and run them clean, and Maren had watched her dot on the board and said nothing, because there was nothing to say to a runner who wanted to be on the line except _clamps on_.\n\n\"The warden came round,\" Odile said. \"Hale. Yesterday. With the form.\" She put the fish down in its place in the row. \"Said I'd got her account now. Said it was standard. Two hundred and eighty days, carried forward, at the standard rate. For her suit and her bottle and her beacon and the inspection on the crawler. He was very sorry.\"\n\n\"He's always very sorry.\"\n\n\"I said I'd pay it.\" Odile looked up at last. \"I said I'd pay it, Chief, because what else do you say? And he said that was very good of me and wrote it down. And then he said, was there anything of hers I'd found, any papers, any messages. For the inquiry.\" She was watching Maren's face. \"I said no. Because I hadn't looked yet.\"\n\n\"And now you have.\"\n\n\"And now I have.\"\n\nOdile reached under the pillow and brought out a strip of grey foil, the kind the relay printers used for hardcopy, folded small and soft with handling. She held it out.\n\n\"It was in her boot,\" she said. \"Her deck boot. The left one. Inside the liner, under the heel. She always kept her money there when we were kids, in case somebody went through her pockets. I knew where to look.\" Her mouth moved. \"Nobody else would.\"\n\nMaren unfolded the foil.\n\nIt was a relay transcript, printed in the cramped type the old relay printers used, and it had been printed by hand, one line at a time, as if somebody had been feeding the printer a little at a time so it wouldn't log a full job. It was headed with the Halloran-Vey wheel and a string of routing codes, and below the codes, a single block of text.\n\n_FROM: Combine Operations, Halloran. TO: Factor-designate A. QUIST, by beacon ahead of CLEMENT. SUBJECT: Consolidation of Corva Operation._\n\n_1. Corva Operation to close effective arrival of factor-designate. Operation no longer commercially viable following Sorrel price adjustment. Board resolution 2391/114 refers._\n\n_2. Skimmer PATIENCE to complete current season dips to maximise final load. Vessel to be decommissioned and scuttled in Gall at season end. Salvage value does not justify transit._\n\n_3. Skilled bonded (est. 300, PATIENCE complement) to be transferred with accounts aboard CLEMENT to Levy Office, Sorrel Station, for assignment under Combine-Levy labour agreement 2390/22. Transfer to be presented as relocation._\n\n_4. Kettle Camp installations and bonded accounts (est. 2,100 households) to remain in place. Supply to cease on departure of CLEMENT. Accounts to be offered at discount to secondary holders._\n\n_5. Factor to manage expectations. Contingency authority (Schedule H) confirmed. ADMONITION to follow as escort._\n\nMaren read it once, slowly, and then again. The fan rattled. Somewhere forward of the Shelf the drum was beginning its spin-up for the second dip, a long rising groan that came through the deck like a tide.\n\n\"What's the Levy,\" said Odile.\n\n\"The Levy Office is how the Combine rents bonded to the Sorrel lane forts,\" Maren said. Her own voice sounded strange to her. \"For the war. Diggers. Loaders. People to stand on gun-decks and fill sandbags with ice. They pay the Combine by the head. The Combine pays the bonded the standard rate against their account. Most of them never come back up the lane.\"\n\n\"And the Camp.\"\n\n\"_Supply to cease._\"\n\n\"What does that mean?\"\n\nMaren looked at her. Odile was nineteen. She had been born on Kettle, in the Camp, in the warrens of the third shaft, where her mother had carved fish and her father had died of the ice cough when she was two; she had never been anywhere else. She knew what supply meant. She was asking because she wanted somebody to say it so she would not have to.\n\n\"It means nobody's coming back,\" said Maren. \"It means the _Clement_ leaves and doesn't come again, and the Camp has what's in its tanks and its stores, and when that's gone, it's gone. The refinery runs on what the _Patience_ brings it, and the _Patience_ will be at the bottom of Gall. They'll have three months, maybe. Four, if they're careful. Then the air plant stops.\"\n\n\"Two thousand households.\"\n\n\"Twenty-one hundred.\"\n\n\"And then somebody buys their accounts,\" said Odile, very quietly. \"At a discount. Somebody buys the debts of dead people.\"\n\n\"Somebody always does.\"\n\nOdile put her face in her hands. She didn't cry. She sat there with her hands over her face and her shoulders very still, breathing, and after a while she said through her fingers, \"She told someone.\"\n\n\"She said so. On the line.\"\n\n\"She'd have told me. She told me everything. She didn't tell me this.\" Odile took her hands away. Her eyes were dry and terrible. \"She'd only not tell me if she was scared for me. If she'd told somebody else first and it had gone wrong. If she thought they'd—\" She stopped. \"Who'd she tell, Chief?\"\n\n\"I don't know.\"\n\n\"She'd have told someone she trusted. Someone she—\" Odile's mouth twisted. \"She was seeing somebody. The last couple of months. She wouldn't say who. She went all quiet and pleased about it, like when we were kids and she'd stolen something. I thought it was one of the dock boys.\"\n\n\"Was it?\"\n\n\"I don't know. She said—she said he was funny. She said he made her laugh in the lock.\" Odile looked at the rows of her sister's things on the blanket: the comb, the fruit, the fish. \"She said he was always in debt and he didn't care. She said it was restful.\"\n\nMaren's hands had gone very cold. She folded the foil up again along its old creases, small and soft, and held it.\n\n\"Keep this between us,\" she said. \"Not Hale. Not anyone. Not even the runners.\"\n\n\"Why?\"\n\n\"Because the last person who read it told somebody,\" said Maren, \"and she's in Gall.\"\n\n[\n  Place: #The Drum\n  Characters: @@Maren Tsolo @@Aurelian Quist @@Corwin Hale @@Abel Tsolo @@Danek Sorell @@Grandam Teska @@Bram Kovac @@Odile Arda\n  When: same day\n]\n\nQuist told them that evening, at the change of shift, in the drum hall, under the names.\n\nHe did it well. Maren had to give him that, afterward, when she had the stomach to give him anything. He stood on the gallery with Hale beside him and the marine sergeant at his back, in his plain dark coat with the wheel on the lapel, and he did not read from a slate. He told them that the Combine had reviewed its operations in the Corva system and had concluded, with regret, that the market for Corva deuterium could no longer sustain them. He told them that the _Patience_ was an old ship, older than most of them, and that she would finish her season and then be retired. He told them that the Combine valued its skilled bonded very highly, and that every one of the _Patience_'s complement would be relocated, with their accounts intact and in good standing, to new postings in the Sorrel lanes, where the work was steady and the air was cheap. He told them the _Clement_ would carry them. He told them it would sail at the end of the month.\n\nHe told them nothing about the Levy, or the war, or the Camp.\n\nHe did not lie about the Camp. That was the clever thing. When old Pirro from the Bucket crew shouted up from the floor, _What about our families? What about the Camp?_, Quist turned to look at him with his long grave lined face and said that the Kettle installations would be transferred to a successor operator under the usual terms, and that the Combine's obligations to the Camp's residents would pass with them, and that family members of relocated bonded who wished to follow on were welcome to apply for passage at their own account. Every word of it was true. Maren, standing at the back of the hall under the drum with the foil in her pocket, could hear exactly how true each word was, and exactly how much it weighed.\n\n_At their own account._ A passage on the _Clement_ to Sorrel cost more than a rigger earned against his debt in eight years.\n\nThe hall took it the way bonded halls took things. There was a long silence, and then a noise, a sort of collective exhalation like a fan spinning down, and then the arguments began, small ones, everywhere at once, people turning to their neighbours. A woman was crying near the slot. Somebody was laughing. Danek Sorell, beside Maren, said \"Sorrel,\" three or four times, as if he were trying to remember where he had heard the word.\n\n\"I've got kids in the Camp, Chief,\" he said. \"Three. Tamar's in the third shaft. What's he mean, apply?\"\n\n\"He means you can't.\"\n\n\"So we go to Sorrel and they stay.\"\n\n\"That's what he means.\"\n\n\"For how long?\"\n\nMaren didn't answer him.\n\nUp on the gallery, Quist had stepped back, and Hale had stepped forward with his slate under his arm and his soft patient voice raised just enough. Order, the warden said. Questions to be raised with section chiefs, who would be meeting with the factor individually over the next days. Dips to continue as rostered. Air rations unchanged. Any bonded found organising, or refusing duty, or damaging Combine property, would have their accounts reviewed, with all that that implied, and their families' accounts likewise. He said it gently. Bram Kovač and two other trusties stood at the foot of the gallery stair with their shock-sticks loose in their hands, looking at nobody in particular.\n\n\"Organising,\" said Teska, loudly, from the bench near the drum where she always sat. \"What's that, organising? Is that talking? Is it organising if I talk?\"\n\n\"Grandam,\" said Hale, with great kindness, \"nobody's going to stop you talking.\"\n\n\"No,\" said Teska. \"You never have.\" She turned her head toward the hall, with her one good eye. \"I've been on this ship sixty-one years. I came out on her in pieces. I've buried two husbands and a daughter on that line. Now they say they're going to sink her.\" She spat on the deck. \"Gall can have her. Gall's had everything else.\"\n\nSome of the hall laughed. Most of it didn't.\n\nMaren found her brother at the edge of the crowd near the riggers' stair, where he always was, where the talk was. He was flushed and bright-eyed and talking fast to a knot of young riggers, his hands moving, and when he saw her coming he broke off and came to meet her with his arms open like a man at a party.\n\n\"Sorrel,\" he said. \"Did you hear him? Sorrel, Maren.\"\n\n\"I heard him.\"\n\n\"Off this rock. Off this ship. Do you know what they've got on Sorrel? Real gravity, on the forts. They've got markets. They've got—God, I don't know what they've got, I've never been anywhere. Neither have you.\" He caught her by the shoulders. His breath smelled of the illegal still in the dock section, which meant he had been celebrating since before the hall. \"We're getting out. Both of us. Thirty years they've had us hanging off this planet on a string and now they're letting us go.\"\n\n\"They're not letting us go.\"\n\n\"Same thing.\"\n\n\"It isn't, Abel.\"\n\nHe looked at her face, and some of the brightness went out of his. He let go of her shoulders.\n\n\"You've got that look,\" he said. \"Your chief's look. Like something's about to walk.\"\n\n\"Something is.\"\n\n\"What?\"\n\nShe looked at him. Her little brother, twenty-nine years old, the same height as her and twice as handsome, with their mother's eyes and their father's absence and a laugh that had been getting him out of trouble since he was four. Everyone on the _Patience_ liked Abel. Everyone on the _Patience_ was owed money by Abel, or owed him a favour, or both. He had never kept a credit in his account for longer than a week in his life. It was, Lusine had said to her sister, restful.\n\n\"Not here,\" Maren said.","wordCount":3460,"createdAt":1793093707334},{"id":"QUmPXa2s3g6hllgu4KnO6","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"pCAUFmAksTJpzvZJ8CLyF","text":"I don't get to the Archive that night. At the eighth bell, as I'm coming off shift, the city's guns open up for the first time in the siege.\n\nI didn't know we had guns. I don't think most people did. There are batteries, it turns out, in old pits on the surface ice around the city, built a hundred years ago in some war scare that never came to anything and maintained ever since by a few dozen shared families who have the right to do it the way other shared families have the right to the dipper fleet. They've waited eighteen days. Now, all at once, they fire, and the whole city hears them: a sound like heavy doors being slammed, very fast, one after another, coming down through the ice.\n\nEverybody stops in the corridors and looks up.\n\nThe word comes down the speakers a few minutes later, crackling and excited. A Concord lander has come down low over the south ice, probing, the first time any of Grieve's ships has come close enough to touch, and the batteries have hit it. It's down. It's on the ice south of the city, a kilometre from South Lock. All damage-control parties to South Lock. All air-wardens with surface rating to South Lock.\n\nI have surface rating. All wardens do; we read the meters on the intakes. I go.\n\nSouth Lock is a vast old chamber cut in the ice at the bottom of a sloping ramp, with the surface doors at its top end and a long low gallery down one side where the suits hang on their racks like a row of hanged men. When I get there it's already full of people. Damage-control crews in orange. Wardens in grey. Militia in their blue armbands with their old rifles. And riggers, a lot of riggers, the big tattooed men and women of the dipper fleet, who've been grounded eighteen days by the Council's order and have nothing to do and are in the mood for something to do it to.\n\nThe doors are open when I get there. The lock's cycled. A team in surface suits has gone out across the ice on a crawler and is coming back, and on the big screen over the gallery we can all see the feed from the crawler's lamps: white ice, black sky, Gall's banded edge on the horizon, and a long smear of wreckage going away across the snow, burning green and orange where its fuel has caught. In the middle of the wreckage, something moving.\n\n\"There's one alive,\" someone says.\n\n\"Not for long.\"\n\nThe crawler comes back down the ramp with the outer doors grinding shut behind it, ice streaming off its tracks. The lock cycles. When the inner doors open, the crowd surges forward, and I'm pushed forward with it, and I see the damage-control crew climbing down off the crawler's bed with a body between them in a scorched white Concord pressure suit.\n\nThey put it down on the floor of the lock. The suit's helmet is cracked across the visor. There's frost on the inside of the crack. The figure inside it moves its hands, weakly, at the clasps of the helmet, as if it wants to get it off.\n\n\"Leave it,\" says somebody. \"It's on its own air.\"\n\n\"Its air's gone,\" says one of the damage-control crew, a woman with a burned face, crouching by the helmet. \"Tank's holed. It's breathing what's left in the suit.\" She looks up. \"Maybe ten minutes.\"\n\n\"Then leave it ten minutes,\" says a rigger at the front of the crowd, a huge man with comet-tails tattooed up both forearms, and there's a growl of agreement behind him. \"Let it breathe what's left. That's what they're doing to us.\"\n\n\"Put it out on the ice.\"\n\n\"Let it have the floor.\"\n\nThat gets a laugh, an ugly one. It goes round the lock like a wave. _Let it have the floor._ The Concord pilot's hands have stopped moving at the clasps. They lie on its chest. Through the cracked visor I can see a face, very young, very pale, with its eyes open, looking up at all of us.\n\nI'm not brave. I want to say that clearly, as I said the other thing clearly before. What I do next isn't brave. It's habit. I'm an air-warden. I have spent twelve years kneeling beside meters, and what I'm looking at is a meter reading red.\n\nI push through to the front, and kneel down beside the burned-faced woman, and take the spare bottle off my own belt. Every warden carries a spare, a little twenty-minute flask with a universal coupling, for when we're out on the intakes. I find the suit's emergency port under the left armpit, where every suit in eleven lanes has had it since before the founding, and I knock the frost off it with my glove and screw the coupling in, and open the valve.\n\nThe suit hisses. The frost on the inside of the visor starts, very slowly, to clear.\n\n\"What are you doing?\" says the tattooed rigger.\n\n\"Reading a meter,\" I say.\n\nThere is a silence in the lock. I can feel it on the back of my neck, a hundred people looking at me. I don't look round. I watch the frost clear on the visor, and the young pale face behind it blink, and its lips move.\n\n\"Warden,\" says the rigger, in a voice I don't like.\n\n\"It's my air,\" I say. \"It's on my account. If you want to take it off me, you'll have to take it off me.\"\n\nNobody moves. I don't know what would have happened next. I don't know, to this day, whether they would have; I think perhaps they would. But the militia have got to the front by then, three of them with rifles and blue armbands and an officer with a whistle, and the officer is shouting that the prisoner is the property of the Council and anybody who lays a hand on him will be on the floor for a year. The crowd backs off, growling. The burned-faced woman helps me get the cracked helmet off. Underneath it the pilot is a man, young, younger than me, with a soldier's cropped fair hair and a soldier's frightened eyes, and a smear of blood under his nose.\n\nHe looks at me. He breathes. It's the first thing I ever hear him do.\n\n\"Thank you,\" he says, in the clipped accent of the inner lanes.\n\n\"Don't,\" I say. \"It's on your account.\"\n\nThe militia take him. They lift him on to a stretcher and carry him up the ramp toward the inner city, and the officer with the whistle tells me to report to the Wardens' Office in the morning with my bottle receipt, and goes after them. The crowd breaks up, slowly, sullenly, back to whatever it was doing. The tattooed rigger stands looking at me a while longer and then goes. I'm left kneeling on the wet ice floor of the lock with my empty bottle in my hand.\n\nSomebody crouches down beside me. A woman, a rigger, forty-odd, small and wiry, with her sleeves rolled up over forearms tattooed from wrist to elbow with the long thin fans of comets, one inside another, like the rings in a tree.\n\n\"You gave him your air, warden,\" she says.\n\n\"I gave him a bottle.\"\n\n\"That's a first.\" She looks at me with a sort of amused curiosity, as if I were a dog that had started to talk. \"Twelve years I've lived on the Ninth North and I never once saw a warden give anybody air.\"\n\n\"It's not a warden's job to give air.\"\n\n\"No,\" she agrees. \"It's not.\" She stands up and dusts off her knees. \"I'm Dasha. Dasha Imre. Rigger. Grounded.\" She holds out her hand to pull me up. \"You want to be careful, warden. Giving people things. It gets to be a habit.\"\n\nI let her pull me up. \"Isaura,\" I say. \"Venn.\"\n\n\"I know who you are,\" says Dasha Imre. \"Everybody on the Ninth knows who you are.\" She grins, quite friendly. \"That's why it's a first.\"\n\nWhen I get back to my room on the Fourth it's past the tenth bell, and there's a message waiting on my wrist. It's from the Archive. It's very short, in Malachy's old-fashioned way, the way he used to write notes in the margins of my exercises when I was ten.\n\n_Isaura. There's writing under the paint. Come tomorrow. Come alone. M._\n","wordCount":1431,"createdAt":1793109048691},{"id":"RHHiMVFtLvPpQ3_WaBpBu","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"pCAUFmAksTJpzvZJ8CLyF","text":"I don't get to the Archive that night. At the eighth bell, as I'm coming off shift, the city's guns open up for the first time in the siege.\n\nI didn't know we had guns. I don't think most people did. There are batteries, it turns out, in old pits on the surface ice around the city, built a hundred years ago in some war scare that never came to anything and maintained ever since by a few dozen shared families who have the right to do it the way other shared families have the right to the dipper fleet. They've waited eighteen days. Now, all at once, they fire, and the whole city hears them: a sound like heavy doors being slammed, very fast, one after another, coming down through the ice.\n\nEverybody stops in the corridors and looks up.\n\nThe word comes down the speakers a few minutes later, crackling and excited. A Concord lander has come down low over the south ice, probing, the first time any of Grieve's ships has come close enough to touch, and the batteries have hit it. It's down. It's on the ice south of the city, a kilometre from South Lock. All damage-control parties to South Lock. All air-wardens with surface rating to South Lock.\n\nI have surface rating. All wardens do; we read the meters on the intakes. I go.\n\nSouth Lock is a vast old chamber cut in the ice at the bottom of a sloping ramp, with the surface doors at its top end and a long low gallery down one side where the suits hang on their racks like a row of hanged men. When I get there it's already full of people. Damage-control crews in orange. Wardens in grey. Militia in their blue armbands with their old rifles. And riggers, a lot of riggers, the big tattooed men and women of the dipper fleet, who've been grounded eighteen days by the Council's order and have nothing to do and are in the mood for something to do it to.\n\nThe doors are open when I get there. The lock's cycled. A team in surface suits has gone out across the ice on a crawler and is coming back, and on the big screen over the gallery we can all see the feed from the crawler's lamps: white ice, black sky, Gall's banded edge on the horizon, and a long smear of wreckage going away across the snow, burning green and orange where its fuel has caught. In the middle of the wreckage, something moving.\n\n\"There's one alive,\" someone says.\n\n\"Not for long.\"\n\nThe crawler comes back down the ramp with the outer doors grinding shut behind it, ice streaming off its tracks. The lock cycles. When the inner doors open, the crowd surges forward, and I'm pushed forward with it, and I see the damage-control crew climbing down off the crawler's bed with a body between them in a scorched white Concord pressure suit.\n\nThey put it down on the floor of the lock. The suit's helmet is cracked across the visor. There's frost on the inside of the crack. The figure inside it moves its hands, weakly, at the clasps of the helmet, as if it wants to get it off.\n\n\"Leave it,\" says somebody. \"It's on its own air.\"\n\n\"Its air's gone,\" says one of the damage-control crew, a woman with a burned face, crouching by the helmet. \"Tank's holed. It's breathing what's left in the suit.\" She looks up. \"Maybe ten minutes.\"\n\n\"Then leave it ten minutes,\" says a rigger at the front of the crowd, a huge man with comet-tails tattooed up both forearms, and there's a growl of agreement behind him. \"Let it breathe what's left. That's what they're doing to us.\"\n\n\"Put it out on the ice.\"\n\n\"Let it have the floor.\"\n\nThat gets a laugh, an ugly one. It goes round the lock like a wave. _Let it have the floor._ The Concord pilot's hands have stopped moving at the clasps. They lie on its chest. Through the cracked visor I can see a face, very young, very pale, with its eyes open, looking up at all of us.\n\nI'm not brave. I want to say that clearly, as I said the other thing clearly before. What I do next isn't brave. It's habit. I'm an air-warden. I have spent twelve years kneeling beside meters, and what I'm looking at is a meter reading red.\n\nI push through to the front, and kneel down beside the burned-faced woman, and take the spare bottle off my own belt. Every warden carries a spare, a little twenty-minute flask with a universal coupling, for when we're out on the intakes. I find the suit's emergency port under the left armpit, where every suit in eleven lanes has had it since before the founding, and I knock the frost off it with my glove and screw the coupling in, and open the valve.\n\nThe suit hisses. The frost on the inside of the visor starts, very slowly, to clear.\n\n\"What are you doing?\" says the tattooed rigger.\n\n\"Reading a meter,\" I say.\n\nThere is a silence in the lock. I can feel it on the back of my neck, a hundred people looking at me. I don't look round. I watch the frost clear on the visor, and the young pale face behind it blink, and its lips move.\n\n\"Warden,\" says the rigger, in a voice I don't like.\n\n\"It's my air,\" I say. \"It's on my account. If you want to take it off me, you'll have to take it off me.\"\n\nNobody moves. I don't know what would have happened next. I don't know, to this day, whether they would have; I think perhaps they would. But the militia have got to the front by then, three of them with rifles and blue armbands and an officer with a whistle, and the officer is shouting that the prisoner is the property of the Council and anybody who lays a hand on him will be on the floor for a year. The crowd backs off, growling. The burned-faced woman helps me get the cracked helmet off. Underneath it the pilot is a man, young, younger than me, with a soldier's cropped fair hair and a soldier's frightened eyes, and a smear of blood under his nose.\n\nHe looks at me. He breathes. It's the first thing I ever hear him do.\n\n\"Thank you,\" he says, in the clipped accent of the inner lanes.\n\n\"Don't,\" I say. \"It's on your account.\"\n\nThe militia take him. They lift him on to a stretcher and carry him up the ramp toward the inner city, and the officer with the whistle tells me to report to the Wardens' Office in the morning with my bottle receipt, and goes after them. The crowd breaks up, slowly, sullenly, back to whatever it was doing. The tattooed rigger stands looking at me a while longer and then goes. I'm left kneeling on the wet ice floor of the lock with my empty bottle in my hand.\n\nSomebody crouches down beside me. A woman, a rigger, forty-odd, small and wiry, with her sleeves rolled up over forearms tattooed from wrist to elbow with the long thin fans of comets, one inside another, like the rings in a tree.\n\n\"You gave him your air, warden,\" she says.\n\n\"I gave him a bottle.\"\n\n\"That's a first.\" She looks at me with a sort of amused curiosity, as if I were a dog that had started to talk. \"Twelve years I've lived on the Ninth North and I never once saw a warden give anybody air.\"\n\n\"It's not a warden's job to give air.\"\n\n\"No,\" she agrees. \"It's not.\" She stands up and dusts off her knees. \"I'm Dasha. Dasha Imre. Rigger. Grounded.\" She holds out her hand to pull me up. \"You want to be careful, warden. Giving people things. It gets to be a habit.\"\n\nI let her pull me up. \"Isaura,\" I say. \"Venn.\"\n\n\"I know who you are,\" says Dasha Imre. \"Everybody on the Ninth knows who you are.\" She grins, quite friendly. \"That's why it's a first.\"\n\nWhen I get back to my room on the Fourth it's past the tenth bell, and there's a message waiting on my wrist. It's from the Archive. It's very short, in Malachy's old-fashioned way, the way he used to write notes in the margins of my exercises when I was ten.\n\n_Isaura. There's writing under the paint. Come tomorrow. Come alone. M._\n\n\n# Ephemeris\n\n## Under the paint\n\n[\n  Place: #The Archive\n  Characters: @@Isaura Venn @@Malachy Orr\n  Items: ^The Share Plate:#The Archive\n  When: 1 July 2654\n]\n\nThe Archive is the Spine's old cargo deck, four levels down from the nave, and it smells the way I imagine the inside of a very old person's head smells: of dust, and paper, and cold, and something sweetish and faint like rot. There's no proper light. There never has been. Malachy works by lamps, a dozen of them on long arms clamped to his tables, so that the Archive is a great dark cave with little islands of yellow in it, and on every island, books, slates, rolled charts, folders of foil, ledgers bound in plastic gone brown, the whole two hundred and sixty years of Patience written down by people who mostly never expected anyone to read it.\n\nHe has the Plate on his biggest table, under three lamps, face down.\n\n\"Close the door,\" he says, when I come in. \"And lock it. There's a bar.\"\n\nI bar the door. When I turn round he's bending over the table with a magnifier strapped round his head on a leather band, like a jeweller, and a tiny brush in one hand and a dish of something in the other that smells sharp enough to make my eyes water.\n\n\"Solvent,\" he says, without looking up. \"Old dock solvent. The kind they used to strip hull paint, back when we had hulls to strip. There's a drum of it in the bottom store that's been there since my grandfather's time. It does the job, slowly. Too fast and it would take the scratches with it.\" He dabs the brush, very lightly, and wipes. \"Come and look. Don't breathe on it.\"\n\nI come and look.\n\nHe's cleaned a patch in the top corner of the Plate's back, no bigger than my palm. Inside it, the grey sealant is gone, and the steel underneath is dark and dull and pitted with age, and across it, cut into the metal, there are marks. Not deep. Scratched, rather than cut: thin uncertain lines, as if made with a point dragged slowly and hard, by somebody pressing with all their weight. They're figures. Numbers. A column of them, and beside the column, letters, single letters, like labels.\n\n\"Somebody scratched these with an awl,\" says Malachy. \"A rigger's scribe, probably. The kind they used for marking cable. You can see where the point skidded.\" He touches the air above a line with the end of his brush. \"Look at the sevens. They cross their sevens. Nobody's crossed a seven in this city for two hundred years.\"\n\n\"What are they?\"\n\n\"Numbers.\"\n\n\"Malachy.\"\n\n\"I don't know yet.\" He straightens up, with a little grunt, and pushes the magnifier up on to his forehead, where it sits like a third eye. \"I've done this much in a night. There's the whole back of the Plate still under paint, and the paint's harder in the middle, where it was thicker. A week. Two.\" He looks at me. \"I need you to keep this to yourself, Isaura.\"\n\n\"Who would I tell?\"\n\n\"Your mother. Your section chief. That rigger woman from South Lock who's been asking about you on the Ninth.\" He sees my face and smiles thinly. \"I hear things. I'm an archivist. Hearing things is most of the job.\"\n\n\"Why does it matter? It's numbers on the back of a plate.\"\n\n\"It matters,\" says Malachy, \"because somebody went to a great deal of trouble to put them there, and then went to a great deal more trouble to make sure nobody could see them.\" He lays the brush down across the dish. \"Think about it. This is the Share Plate. It's the first thing the founders made. It's been hanging in the nave since before there was a nave. Every child in Patience has stood in front of it. And somebody, two hundred and sixty years ago, took it down and cut something into the back of it with an awl, and then painted over it with hull sealant, carefully, edge to edge, so that it would look like nothing but the back of a piece of steel. And hung it up again.\" He spreads his old spotted hands. \"You don't do that with a shopping list.\"\n\n\"Then why not throw it away? If they didn't want it read.\"\n\n\"Because they did want it read.\" Malachy pulls the magnifier back down over his eye and bends to the Plate again. \"Eventually. Just not by whoever was standing in front of it at the time.\" He dabs with the brush. \"Those aren't the same thing, Isaura. Keeping a thing and hiding it. You'll find most of this room is one or the other. The trick is telling which.\"\n\n## The cells\n\n[\n  Place: #The Cells\n  Characters: @@Isaura Venn @@Mattias Ebb\n  Items: ^Isaura's gauge:@Isaura Venn\n  When: 10 July 2654\n]\n\nNine days after South Lock, the Wardens' Office takes me off the Ninth.\n\nI'm called in to see my section chief, a weary shared woman named Paske who has been running the South wardens since before I joined, and who looks at me across her desk with the expression of somebody who has been given a problem she didn't ask for. I'm not being disciplined, she says. Nobody's filed a complaint. The bottle's been paid for out of the Office budget; the militia were very grateful; there's even a commendation, which she pushes across the desk to me on a slip of foil. But there's been talk on the Ninth. About a warden giving away air to a Concord pilot while the Ninth's own children are on the floor. And there have been, Paske says delicately, incidents. A warden on the Ninth North had his ledger taken off him on the stairs and thrown down a shaft. Another had her valve key bent. It would be better for everybody, Paske says, if I were somewhere else for a while.\n\nSomewhere else is the Cells.\n\nThe Cells are under the Spine, below the Archive, below the old docks, in what was once the skimmer's keel: a long dim corridor of steel boxes, each with a door and a grille and a meter. In peacetime they hold drunks and thieves and the occasional unshared rioter. Now, eight days into July and twenty-eight days into the siege, they hold a few dozen of each and one Concord lieutenant. Somebody has to read the meters. That's me.\n\nIt's quiet work. It's almost restful, after the Ninth. The prisoners are on a fixed allowance set by the Council, a little above the old floor, and nobody pays tithe, so nobody falls into arrears, so nobody has to be cut. I walk the corridor twice a shift with my gauge and read each meter aloud into the ledger and check the seals on the doors, and the prisoners mostly ignore me. Some swear. One old man on the end, a tannery thief from the Fifth, asks me every shift whether the Lamp's still in the sky, and I tell him yes, and he says _good_, and turns over.\n\nThe lieutenant's cell is the eleventh.\n\n\"Ebb, Mattias,\" I say to my ledger, on the first morning, outside his grille. \"Concord Lane Service. Allowance three-twenty an hour. Draw this cycle, three-oh-five.\" I look through the grille. \"You're breathing light, Lieutenant.\"\n\nHe's sitting on his bunk with his back against the wall and his knees up, in a grey prison smock with the sleeves too short, his cropped fair hair grown out a little into a pale fuzz. The bruising on his face has gone yellow. He looks up when I speak, and I see him recognise me, and something complicated happens in his face.\n\n\"I was told to,\" he says. \"In training. _In captivity, conserve._ Every ration. Breathe slow, move slow, sleep a lot.\" He shrugs. \"I'm very good at sleeping.\"\n\n\"You don't have to conserve here. It's your allowance. It doesn't go back in the tank if you don't use it.\"\n\n\"Doesn't it?\"\n\n\"No. It's just wasted.\"\n\nHe thinks about this with a sort of grave interest. \"That's very inefficient.\"\n\n\"Welcome to Patience,\" I say, and go on to the twelfth.\n\nHe's there on the second day, and the third, and every day after, and after the third day we talk. Not much. A few minutes, across the grille, while I take the reading and check the seal. It isn't permitted, exactly. It isn't forbidden either; nobody's thought to forbid it, because nobody's imagined a warden would want to. I'm not sure I want to. But he's the only person in the city who knows less about it than I do, and there's a strange relief in that.\n\nHis name is Mattias. He's twenty-four. He comes from a world called Corran, three lanes in, an old Concord holding where everybody works in the canneries. His father owed the Concord a great deal of money for something to do with a fishing boat that sank, and when his father died the debt came down to Mattias, and the Concord, which is efficient, offered him the choice of the canneries for forty years or the Lane Service for twelve. He chose the Lane Service. He's done four years of the twelve. He flies landers. He was flying a lander over Kettle's south ice on the thirtieth of June, on a probe, because his captain wanted to see whether the city had any guns, and the city did.\n\n\"That's what it's like everywhere,\" he says, on the fifth day, when I tell him about the floor. \"The Concord. The tithe, the floor. They don't call it that. They call it _allocation_. But it's the same.\" He looks at me through the grille with his frightened soldier's eyes, which are, I've decided, not frightened at all, only very tired. \"You'd think you'd be different here. You threw the Company out. Didn't you? You bought your own air. That's what they told us in the briefings. _The occupiers claim to have purchased the claim._ And then you went and did the same thing to each other.\"\n\n\"We didn't do anything. I wasn't born.\"\n\n\"No. Nor was I.\" He leans his head back against the wall. \"Nobody's ever born when it happens. Have you noticed? It's always already happened.\"\n\nOn the sixth day he asks me why I gave him the bottle.\n\n\"It's my job,\" I say.\n\n\"It isn't, though. Is it? Your job's taking it away.\" He says it without any edge. \"The militia officer told me. On the stretcher, when he thought I couldn't hear. He said, _that's the warden from the Ninth, she's cut more air than the plague_. He was laughing.\"\n\nI look at the meter. Three-oh-eight.\n\n\"I don't know,\" I say, which is the truth.\n\n\"Well,\" says Mattias Ebb, after a while. \"Thank you anyway. Whatever it was.\"\n\n[\n  Place: #The Archive\n  Characters: @@Isaura Venn @@Malachy Orr @@Lucan Strand\n  Items: ^The Share Plate:#The Archive\n  When: same day\n]\n\nThat afternoon Malachy sends for me again, and when I get to the Archive, the First Shareholder is there.\n\nHe's standing at the end of Malachy's big table with his hands behind his back, looking down at the Plate under its lamps, and he doesn't turn round when I come in. Two of his stewards wait by the door. Malachy, at the table, gives me a look over the top of his magnifier that I've known since I was eight years old, the look that means _say nothing, you'll only make it worse_.\n\nTen days of solvent have cleared a long strip down the left side of the Plate's back, about the width of my hand, from the top almost to the bottom. In the strip, the scratched figures go down in a column, with their letters beside them. Six lines. Below the six lines, a gap, and then more scratches, different, less regular, still half under the paint. The rest of the Plate is grey.\n\n\"Come in, warden,\" says Lucan Strand. \"The Archivist tells me you were the first to see this. When it fell.\"\n\n\"Yes, First Shareholder.\"\n\n\"And you've said nothing to anyone.\"\n\n\"No, First Shareholder.\"\n\n\"Good.\" He turns his head and looks at me, and smiles a little, his tired silver smile. \"Brother Malachy has been telling me what he thinks it is. I'd like you to hear it. Since you were there at the beginning.\" He nods to the old man. \"Go on, Brother.\"\n\nMalachy straightens up. He doesn't push the magnifier up this time; he takes it off altogether and lays it on the table, which with Malachy means that he's about to say something he's sure of.\n\n\"They're orbital elements,\" he says. \"Six of them. Semi-major axis, eccentricity, inclination, the longitude of the node, the argument of perihelion, and a time.\" He touches the air above each line with his brush. \"That's how dippers wrote down an orbit. They had to know about orbits to do their work, much better than we do; they lived in them. These are in the old dippers' notation, with the old dippers' units. Whoever scratched this knew exactly what they were doing.\"\n\n\"An orbit of what?\" says Strand.\n\n\"Something long,\" says Malachy. \"And very eccentric. Something that goes a very long way out and comes back.\" He purses his lips. \"I'd need to run the figures to be sure, and I can't run them yet. There's a time on the last line, the time of perihelion, and it's under a flaw in the steel. Somebody's awl slipped.\"\n\nStrand is quiet for a moment.\n\n\"And the rest?\" He nods at the half-cleared scratches below the gap. \"There's more. Writing?\"\n\n\"Letters, yes. Words, I think. I haven't got to them.\" Malachy picks up his magnifier again and turns it over in his fingers. \"Another week. Perhaps two. The paint's very hard in the middle.\"\n\n\"Faster, Brother.\"\n\n\"If I go faster I'll take the words off with the paint.\"\n\n\"Then don't go faster,\" says Strand mildly. \"But don't go slower.\" He comes round the end of the table and looks down at the strip of scratched figures for a long moment, and I see his face in the lamplight and I see something in it I've never seen in it before: not the warmth he wears in the nave or the patience he wears on the speakers, but hunger, plain and sharp, like a man looking at a meal.\n\n\"The founders wrote this,\" he says softly. \"On the Plate. And then they hid it.\"\n\n\"Somebody did,\" says Malachy.\n\n\"The founders,\" Strand says again, as if correcting him. He looks up. \"Do you know what reserve stood at this morning, Brother? Fifty-two days. Grieve's slugs took out the third intake on the far ice last night. Fifty-two. A month ago it was ninety-four.\" He's not raising his voice; he never raises his voice. \"The Council meets tomorrow. If the reserve falls below twenty days, we will have to consider measures. Measures nobody in this city wants to consider. Do you understand me?\"\n\n\"I understand you,\" says Malachy.\n\n\"Then you understand why I want to know what the founders thought was worth hiding.\" Strand straightens his coat. \"Nobody sees this but the three of us. Not the Council. Not my son. When you have the words, you send for me first. Before anyone.\" He turns to me. \"And you, warden. Not a word. Not to your mother. Not to the Ninth. If this city ever needed its founders, it needs them now, and I won't have them turned into a Lamper rumour on the stairs.\" He smiles. \"Do you understand?\"\n\n\"Yes, First Shareholder.\"\n\n\"Good,\" he says, and goes out with his stewards.\n\nWhen the door's barred behind him, Malachy sits down heavily on his stool and puts his face in his hands. He sits like that for a long time.\n\n\"_Measures_,\" he says at last, through his fingers.\n\n\"What measures?\"\n\nHe takes his hands away and looks at me. \"You've been a warden twelve years, Isaura,\" he says. \"You know what a city does when it runs short of air. You've done it on a small scale every day of your working life. Think about it on a large one.\"\n\nI think about it.\n\nI think about the floor, and the doors on the Ninth, and the grandmother under her three blankets with her hands folded. I think about a hundred and seventy thousand unshared and twelve thousand shared, and a reserve going down like a needle on a meter. And I understand what he means, all at once, the way you understand the cold when you step out of a lock, and I sit down too, on the bench by the door, and for a while neither of us says anything at all.","wordCount":4244,"createdAt":1793109048893},{"id":"UHsT7bZ4bcp7nAifVfccI","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"0T46v5SbLeM2hWt1bnUYG","text":"She found Abel at the third bell of the night, in the blister.\n\nThe blister was a dome of thick old glass on the _Patience_'s dorsal hull, a relic of the days when skimmers had carried passengers who wanted to look at things. It was cold, and badly lit, and the crew used it for courting and drinking and the kind of conversations that couldn't be had anywhere else, and nobody ever cleaned it. Abel was sitting on the floor with his back against the frame and a bottle of dock-still between his knees, looking up. He didn't turn round when she came in. He held the bottle up over his shoulder.\n\nShe took it, and drank, and gave it back, and sat down beside him.\n\nAbove them, through the scratched glass, Gall filled half the sky, ochre and purple, a storm the size of a world turning slowly on its southern limb. Above the storm, in the black, the Lamp hung like a thumbprint of light. It was brighter than it had been three days ago. You could see the tail properly now, a long faint fan of pale green going away from the sun, so delicate that if you looked straight at it it disappeared, and came back when you looked to the side.\n\n\"Teska says it takes the dead out,\" said Abel.\n\n\"Teska says a lot of things.\"\n\n\"She says it'll be back when our grandchildren are dead.\" He drank. \"That's a long time to be a comet.\"\n\n\"It's not a long time for a comet.\"\n\n\"No.\" He laughed a little. \"I suppose not.\" He held the bottle up to the glass and looked at the Lamp through it, through the cloudy brown spirit, so that it wobbled. \"I keep thinking about her. Lusine. Out there. Going in.\"\n\n\"So do I.\"\n\n\"You talked to her. The whole way. I heard you.\" He lowered the bottle. \"That was a good thing you did, Mar.\"\n\n\"I didn't do anything.\"\n\n\"You did, though.\" He turned his head and looked at her for the first time. His face was grey and his eyes were wet and red-rimmed, and she could not tell how much of it was the still. \"You always think you didn't do anything. You do more than anybody.\"\n\nShe looked at him for a long moment, at his handsome tired face in the Gall-light, her brother, whom she had carried on her hip through the third shaft when their mother went into the cloud.\n\n\"Were you seeing her, Abel?\"\n\nHe didn't move. He didn't look away. But she had known him all his life, and she saw the small thing happen behind his eyes, the thing that happened when he was eight and she asked him who had got into the dried fruit, the half-second of arithmetic.\n\n\"Seeing her?\"\n\n\"Lusine. Odile says she was seeing somebody. Somebody funny. Somebody always in debt who didn't care.\"\n\nAbel laughed. It was almost his real laugh. \"That's half the riggers on the ship.\"\n\n\"Were you?\"\n\n\"We were friendly.\" He shrugged. \"A bit. Now and then. She was—she was good fun, Mar. She liked a joke. We'd have a drink in the lock after shift. It wasn't serious. She wasn't serious about anybody.\" He drank. \"Why?\"\n\n\"Did she tell you anything? Before she died? About the _Clement_? About a dispatch?\"\n\n\"A dispatch?\" He frowned. \"What dispatch?\"\n\n\"Did she?\"\n\n\"No.\" He shook his head. \"No. Why would she tell me about a dispatch? I'm a rigger. I can barely read the duty board.\" He smiled at her, the old smile, _don't worry, it's me_. \"What's this about?\"\n\nMaren looked at the Lamp.\n\n\"Nothing,\" she said. \"It's late. I'm tired.\"\n\n\"You're always tired.\"\n\n\"I'm always tired.\"\n\nHe put his arm around her shoulders, the way he used to when he was sixteen and had just grown taller than her and wanted her to know it, and she let him, and they sat together in the cold blister and looked at the comet. His arm was warm and heavy and familiar. His hand, where it hung over her shoulder, was shaking, very slightly, with a small fine tremor, the kind of tremor that a man gets when he has been drinking for three days because he cannot stop seeing something.\n\nShe did not say anything about it. She sat there in her brother's arm and looked at the Lamp and thought, very clearly, _he's lying to me_, and then, because she was the tether-chief and that was what tether-chiefs did, she began to do the arithmetic.\n\n\n# Sanitation\n\n## The Belly\n\n[\n  Place: #The Belly\n  Characters: @@Maren Tsolo @@Odile Arda @@Grandam Teska @@Danek Sorell @@Corwin Hale @@Bram Kovac @@Abel Tsolo\n  When: 11 November 2391\n]\n\nUnder the drum there was a space nobody had ever found a use for.\n\nThe drum sat in a cradle of girders that went down through three decks to the keel, and between the girders, under the drum's great curved belly, the shipwrights had left a hollow the size of a chapel: a ribbed, dark, echoing void full of cable runs and bearing housings and old grease, where the noise of the drum when it was turning was so loud you could not hear your own voice, and when it was not turning, so quiet you could hear the hull tick. The crew called it the Belly. You got into it by a maintenance hatch behind the number four brake, and a ladder, and a long crawl on your hands and knees along a cable tray. Riggers went there to sleep off shifts and to do things they did not want logged. Wardens did not go there, because wardens were big men and the cable tray was narrow.\n\nMaren called the meeting for the fourth bell of the night, in the dead hour between dips, when the drum was still.\n\nEleven of them came. She had asked for twelve. They sat on the girders and the bearing housings in a rough ring, with one lamp turned low on the deck plates between them, and their faces came and went in its light: Teska, wrapped in two coats, with her white eye shining; Odile, very upright, very quiet; Danek Sorell, too big for the space, folded up on a girder with his knees under his chin; old Pirro from the Bucket crew; two dock hands, a married pair called Senna and Ivo, who between them knew every valve on the forward collar; three riggers Maren trusted and two she trusted less, because you needed the ones who talked as well as the ones who didn't. Ekene was not there. She had not asked him. A free man could be hanged for what the bonded only had their accounts reviewed for.\n\nAbel was not there either. She had asked him. He had said yes, and smiled, and not come.\n\n\"Read it,\" said Teska. \"Read the paper. I want to hear it in my own ears.\"\n\nMaren read it. She read it in the tether-chief's voice, without any expression at all, every line, the routing codes and the board resolution and the numbers, _est. 300_, _est. 2,100 households_, _supply to cease_. When she had finished nobody said anything for a long time. Somewhere in the hull below them a pump came on and ran and went off again.\n\n\"Sorrel,\" said Danek at last, in the same voice he had used in the hall. \"The forts.\"\n\n\"The forts.\"\n\n\"And the Camp.\"\n\n\"Three months. Four if they're careful.\"\n\n\"Tamar's got the cough already. She had it last winter.\" Danek looked at his own big hands. \"Four months she won't make.\"\n\n\"Nobody'll make it,\" said Pirro. \"Not the old ones. Not the little ones. The plant'll go first, then the heat. You'll have people burning their bunks.\" He spat into the dark. \"I was in the Camp when the third shaft caved in sixty-eight. We were nine days without the plant. I saw what nine days did.\"\n\n\"So we don't go,\" said Senna, from the dock. \"We refuse. Strike. They can't move three hundred people on to the _Clement_ if three hundred people won't walk.\"\n\n\"They can if they've got sticks.\"\n\n\"They've got six marines and a dozen trusties. We're three hundred.\"\n\n\"And the _Admonition_,\" said Maren. \"Two weeks behind the factor. Sixty marines and a torpedo bay. Due on the twenty-second.\" She looked round the ring. \"And then they don't need us to walk.\"\n\n\"Then we take the ship,\" said Teska.\n\nThey all looked at her. She was sitting hunched on her bearing housing in her two coats, very small, with her good eye glittering in the lamp.\n\n\"We take her,\" she said. \"She's ours. We built her. Well, they built her, but we've had her sixty years; we've kept her flying when they wouldn't send the parts. Every bolt in her's been turned by one of us. We take her and we don't sink her. We keep dipping. We keep the Camp breathing.\" She shrugged inside the coats. \"Let the Combine come and get her.\"\n\n\"The Combine will,\" said Maren.\n\n\"Then we'll be dead in a month instead of four. I'm eighty-three. I can spare a month.\"\n\n\"Danek's children can't.\"\n\n\"Danek's children,\" said Teska, with great gentleness, \"are going to die on the ice anyway, Maren. That paper says so. All you're doing is choosing which way.\"\n\nNobody said anything to that.\n\nMaren had known it was coming. She had known since the night in the Shelf, with the foil in her hand and Odile's face in front of her, that it would come to this: a ring of tired people in the dark under the drum, with nothing in front of them but a wall, and somebody saying the thing out loud. She had spent four days running the arithmetic, in the gallery, at the board, in Ekene's bunk with her eyes open. It came out the same every time. Strike, and they would be broken. Comply, and the Camp would die. Fight, and the _Admonition_ would come, and then the Camp would die and so would they.\n\n\"If we take her,\" she said, \"we have to take the _Clement_ too. Same night. Same hour. Otherwise the factor gets on her and casts off and he's two weeks from the _Admonition_ and he tells them everything. And the _Clement_'s got the marines, and the marines have guns.\"\n\n\"How many?\"\n\n\"Six. Sergeant called Oyelowo. They're good. They're not like the trusties. They've done this before.\"\n\n\"We'll need sticks,\" said a voice from the dark at the edge of the ring. \"At least.\"\n\nThe lamp didn't reach where it came from. It didn't need to. Everybody knew that voice, soft and patient and reasonable, and the ring went still the way a rigger goes still on the line when the trace jumps.\n\nCorwin Hale came forward into the light at his slow walk, ducking under a girder. Behind him, in the dark, Maren could see the shape of Bram Kovač crouched at the end of the cable tray, blocking it.\n\n\"I'm sorry to interrupt,\" said Hale. \"I didn't mean to listen. Sound carries in here. It's a terrible place for a secret.\"\n\n\"How did you get in?\" said Odile. \"The tray's too narrow for you.\"\n\n\"There's a hatch from the keel side, if you know where it is.\" Hale smiled faintly. \"I've been on this ship twenty years, Arda. I know where everything is.\" He looked round the ring. His eyes rested on each of them in turn, mild and unhurried, as if he were taking a register: Teska, Danek, Pirro, Senna, Ivo, the riggers. Last of all he looked at Maren. \"May I sit down?\"\n\nNobody answered. He sat anyway, on the end of Pirro's girder, so that the old man had to shift up.\n\n\"You've read the dispatch,\" he said. \"I know you have. Arda's sister had it in her boot. I've been waiting for you to do something about it.\" He folded his big hands on his knee. \"I'm on the list too, you know. I'm bonded. I've got an account. My mother's in the Camp, on the second shaft, and she's sixty-eight, and she doesn't have four months either.\" He looked at Danek. \"Trusties go to Sorrel with everybody else, Sorell. They don't need wardens on the forts. They've got officers for that. I'll be filling sandbags beside you.\"\n\n\"You'll be filling sandbags,\" said Teska, \"when Gall freezes.\"\n\n\"Grandam,\" said Hale, \"I know what you think of me. I know what you all think of me. You think I'm the Combine's dog. You're right. I've been the Combine's dog for twenty years, because the Combine fed me.\" He opened his hands. \"The Combine's stopped feeding me. That's all. I'd like to eat.\"\n\n\"What are you offering?\" said Maren.\n\n\"Twelve trusties with sticks. The keys to the bridge and the armoury, such as it is. Two old flechette carbines that the Combine forgot it issued. And the warden's office, which means the logs, which means that whatever happens, the Combine won't hear about it from this ship until we want it to.\" He met her eyes. \"And me. Who knows where everything is.\"\n\nMaren looked at him. She thought of Lusine's voice on channel four. _I told someone._ She thought of Quist across Moberly's desk, turning his coffee cup: _I'd look at who on this ship would have wanted the Combine to be grateful to them._ She thought of the form on Hale's slate, already filled in, in his neat hand, before she ever came down the gallery ladder.\n\nShe thought of six marines with guns.\n\n\"What's Schedule H?\" she said.\n\nHale blinked. \"I'm sorry?\"\n\n\"In the dispatch. Paragraph five. _Contingency authority, Schedule H, confirmed._ What's Schedule H?\"\n\n\"I've no idea,\" said Hale. \"Factors' business. I'm a warden.\" He shrugged. \"Contingency means _if things go wrong_. I expect it means the _Admonition_.\"\n\nHe said it easily. Maren watched him say it. She could not tell. She had been watching Hale for twenty years, and she had never once been able to tell what was behind that mild patient face, and she could not tell now.\n\n\"We'll think about your offer,\" she said.\n\n\"Don't think too long,\" said Hale, getting up. \"The twenty-second isn't far.\" He looked round the ring once more, taking his register. \"And none of you need worry about me. I can keep a secret. I've kept a great many.\" He ducked back under the girder into the dark, and they heard him go, slow and heavy, toward his hatch in the keel; and after a moment Bram Kovač's shape at the end of the cable tray went too.\n\nThe ring sat in silence.\n\n\"Well,\" said Pirro. \"Now we have to.\"\n\n[\n  Place: #The infirmary\n  Characters: @@Ekene Adu @@Maren Tsolo\n  When: 11 November 2391\n]\n\nThe _Clement_'s crew were not bonded. They were Combine contract hands, hired for the run at Halloran, and they kept to their own ship mostly, and looked at the _Patience_'s bonded the way people look at animals in a pen: without malice, without much interest. But the _Clement_'s medic had been left at Halloran with a fever, and so when one of her cargo hands got his left hand caught in the closing door of a cold-hold hatch, on the morning of the eleventh, they brought him across the collar to Ekene.\n\nMaren heard about it from Ekene that evening. She came to the infirmary after the second dip and found him at the counter, not writing, sitting with his reading lenses in his hand and his face the colour of the counter.\n\n\"His name's Brandt,\" Ekene said. \"Yusuf Brandt. He's twenty-three. He's from Halloran, from the yards. He's never been out of the inner lanes before. He thinks Corva is the most boring place he has ever been in his life.\" He turned the lenses over. \"I had to take two fingers. The hatch was a cryo-hatch, the heavy kind, with the frost seals. It crushed them flat. So I gave him a lot of the good painkiller, which the Combine charges at nine marks a dose, and while I was working, he talked.\"\n\n\"What about?\"\n\n\"About his ship. About the cold hold. About how he's on cold-hold duty this run, which means checking the cryostats every four hours, and how it's the worst duty on the ship because the hold's at sixty below and the gloves are useless. About how there's nothing in the cold hold this run except the usual medical stocks and one other thing.\" Ekene put the lenses down on the counter, very carefully. \"About how the factor comes down to look at the other thing every day. Every single day. With the sergeant. And stands and looks at it. And how the hands call it the egg.\"\n\nMaren said nothing.\n\n\"I asked him what kind of egg,\" said Ekene. \"He laughed. He said a grey one, about this long\"—he held his hands apart, the length of a forearm and a half—\"in its own cryostat, with its own power and its own alarm, and a stencil on the casing that he'd read so many times on cold-hold duty he could say it in his sleep. And then he said it for me. In his sleep, nearly. The painkiller was very good.\" Ekene looked at her. \"_Sanitation Agent. Pattern H. Factor's authority only._\"\n\n\"Pattern H.\"\n\n\"Schedule H. Pattern H.\" His voice was steady and quite empty. \"I've seen that stencil before, Maren. I didn't think I'd ever see it again. I think I came to the end of the lanes so that I wouldn't.\"\n\n\"Tamsin's Rock,\" said Maren.\n\nHe closed his eyes.\n\n\"Tell me,\" she said.\n\n\"Not here.\" He opened them again and looked toward the curtained bay where Yusuf Brandt was asleep, two fingers lighter, dreaming his painkiller dreams of Halloran. \"Not tonight. I need to know you've seen it first. I need to know I'm not a frightened old man hearing things in a boy's babbling.\" He put out his hand and took hers on the counter, hard, the way he never did, his long gentle fingers cold as the cold hold. \"If it's there, Maren, then everything you've been planning in the Belly is something else. Everything. Do you understand? You can't take a ship with that thing on the other end of the collar. You can't do anything.\"\n\n\"I can look at it,\" said Maren.","wordCount":3078,"createdAt":1793108902456},{"id":"YYlfRF_S5kpl-48U3-vSW","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"F6DSf6VLOavx87_UDZc5D","text":"The _Dray_ is not beautiful.\n\nTil will be the first to say it. She's a deep-salvage tug of the old Tarn pattern, built sixty years ago for hauling dead hulks off the Harrow and the other wreck-fields of the outer Reach, and she looks it: a squat, blunt, armoured wedge of a hull, scarred and patched and painted over so many times that nobody knows any more what colour she started, with a stubby drive cluster at the back, a long grapple-and-winch boom slung under her belly like a folded insect's leg, and a forward cabin so small that two people can only pass in it if one of them is asleep. She has a fusion core that runs hot and an air plant that runs cold and a winch that will haul a hundred kilometres of cable and has hauled most of it. She is slow. She is ugly. She cannot be killed. Til has tried.\n\nOz spends two days going over her from the drive cones to the forward lamps, while Til spends two days spending other people's money. They buy cable. They buy reaction mass. They buy air, eleven tanks of it, more air than the _Dray_ has carried at one time in her life; they buy ice-anchors and screw-pitons and a thermal lance and two new pressure suits, one of them small, which Til buys without saying anything and Oz watches her buy without saying anything either. They buy food. Cato Marchetti comes down to the dock twice to look things over and goes away again, courteous, attentive, saying almost nothing; on the second visit he brings four long crates of his own, sealed, and asks for them to go in the cargo bay, and Til opens one with Oz standing by, because it's her ship, and finds medical supplies, and closes it again.\n\n\"He didn't mind,\" says Oz, afterward. \"You opening it.\"\n\n\"No.\"\n\n\"He wanted you to.\"\n\n\"Yes,\" says Til.\n\nThey're in the cargo bay, on the night before departure, stowing the last of the cable. The bay's lit by work-lamps clipped to the ribs and smells of old grease and cold metal and the dust that gets into everything on Cinderhaven, fine grey dust from the ring's ore-mills that you can taste for a week after you leave. Oz is coiling cable on to a drum with his delicate hands, talking to himself in the old Roundsman cant his mother taught him, half prayer and half swearing.\n\n\"My mother's people came out of Corva,\" he says, unexpectedly.\n\nTil looks up from the anchors. \"You never said.\"\n\n\"You never asked. It was a long way back. Two hundred years and more. Before the lane went dark.\" He finishes the coil, ties it off. \"Dippers. They used to go down into the giant's air on ropes, she said, forty kilometres of rope, and scoop the weather up in a bucket. And when they died they gave them to the giant. Lowered them down on the rope and let them go. And they had the comet, and they had a saying about it. The Lamp takes the dead out and brings them back.\" He picks up the next coil. \"That's where we got it. The Roundsmen. All of it. The salt and the loops and the going-out. It's dipper stuff. It's from Corva.\"\n\n\"Then the Hoard's dipper stuff too.\"\n\n\"The Hoard's drunk stuff,\" says Oz. \"There's no Hoard. Dippers didn't have anything to hoard. They had debts.\" He tugs the cable. \"But it's funny. That we're going there. Back round.\"\n\n\"It's not funny. It's thirty thousand marks.\"\n\n\"That too.\"\n\nThe hatch at the forward end of the bay grinds open and lets in a slab of yellow dock light, and a figure in it with a bag over its shoulder.\n\nJuno has a grey house coat on over a rigger's undersuit, and a cheap pair of dock boots, and the bag, which is small and old and has belonged to someone else before her. She stops in the hatch. She looks at Oz, and at the cable, and at the work-lamps, and at the stained ribs of the hull, and finally at Til.\n\n\"Mother Szabo sent me,\" she says.\n\n\"I know.\"\n\n\"I'm to witness the recovery. And log the cargo. And report back to the house.\" She says it like something learned off a slate. \"I'm not crew. I'm not under your orders. Mother Szabo says if you put me to work I'm to log it and she'll bill you.\"\n\n\"That sounds like her.\"\n\n\"Where do I sleep?\"\n\n\"There's a bunk aft of the galley,\" Til says. \"It's the warm one. There's a new suit in the locker by it that ought to fit you. You'll need to try it before we go through the lane. Oz will check your seals.\"\n\nJuno looks at her for a long moment. Til waits for it, whatever it's going to be, and is ready for it, she thinks; she has had eleven years to get ready for it.\n\n\"Don't talk to me,\" says Juno Brask, quite politely. \"Unless it's about the job.\"\n\nShe goes past them down the bay toward the galley hatch, and Oz moves out of her way with his coil of cable, and she doesn't look at either of them; and then the galley hatch closes behind her and it's just the two of them in the work-light with the cable and the cold.\n\nOz goes back to his coiling. After a while he says, without looking up, \"She's got Mags's walk.\"\n\n\"I know.\"\n\n\"Tall, though. Taller than Mags. That's from the father, whoever he was.\"\n\n\"I know, Oz.\"\n\n\"She'll come round.\"\n\n\"She won't,\" says Til. \"And she shouldn't.\"\n\nThe client comes aboard at the first bell of the morning, an hour before the departure slot. Til has been expecting a sick old man in a chair. What comes up the ramp out of the dock's grey half-light is a coffin.\n\nIt's a medical cradle, she knows that; she's seen them before, on the Directorate's hospital ships, though never one this fine. It's a long, low, gleaming shell of white composite on a powered sled, with a clear canopy over the upper half and racks of quiet instruments along its sides, humming. Two dock porters walk it up the ramp, and Cato Marchetti walks behind it with a hand resting lightly on its rim, the way a man walks beside a horse. Under the canopy, propped on pillows, is Hollis Vey.\n\nHe is very thin. That's the first thing. He's a long man, and the illness has eaten everything from him but the length, so that he lies in his white shell like a heron in a nest, all bones and joints. His skin has the papery yellow-grey of the very sick. His hair is white and wispy and was once, you can see, thick and fair. He's seventy, perhaps, or a hard sixty. His eyes are pale blue, and wet, and completely alert, and they move over the _Dray_'s cargo bay, its ribs and its lamps and its drums of cable, with an expression that Til, after a moment, recognises as delight.\n\n\"Captain Brask,\" he says. His voice comes through a speaker grille in the cradle's rim, thin and dry and slightly delayed. \"Forgive me for not getting up.\"\n\n\"Mr Vey.\"\n\n\"This is a very ugly ship.\"\n\n\"Yes.\"\n\n\"Good.\" He smiles. His teeth are perfect and slightly too large for his face. \"Ugly ships last. My family built beautiful ones. You'll notice we haven't got any left.\" He turns his head on the pillow, with some effort, to look at her properly. \"Mother Szabo tells me you're the best deep-salvage captain on the Ring.\"\n\n\"Mother Szabo tells people what makes her money.\"\n\n\"Then we understand each other. She also tells me you've no wish to know my business, which I very much appreciate, and which I don't for a moment believe.\" The pale eyes are amused. \"We have a long way to go together, Captain. I'll tell you my business, when I've decided how much of it I can bear to say aloud. In the meantime, I would be grateful for a place to plug this thing in, and a window, if your ship runs to windows. I'd like to see it, when we get there.\"\n\n\"The Lamp?\"\n\n\"Corva,\" says Hollis Vey. \"All of it. My family hasn't seen it in five hundred years.\"\n\nThey undock at the second bell. Til takes the _Dray_ out herself, by hand, the way she always does, backing her off the dock on her manoeuvring jets with the yard-master swearing at her on the traffic channel for doing it by hand, and swings her round in the long shadow of the ring, and lights her drive. Cinderhaven falls away behind them, a great grey wheel turning slowly in the light of Tarn, with its docks and its chapels and its stone vaults full of paper. Ahead, two days off, is the Throat of the Corva lane.\n\nOz comes up into the cockpit as the ring shrinks. He leans on the back of her chair and looks at the rear display for a while without saying anything.\n\n\"Something just came off the ring behind us,\" he says. \"Dock Two. Big hull. Running quiet.\"\n\nTil looks. She knows the hull. Everybody on Cinderhaven knows the hull: a long black repossession cutter with a ram bow and four turrets, the house mark of a ledger and a pen painted small on her flank, the _Carrion Hymn_.\n\n\"Well,\" says Til. \"Mother's coming too.\"\n\n\n# The Throat\n\n## The raw lane\n\n[\n  Place: #The Dray\n  Characters: @@Til Brask @@Juno Brask @@Ozias Mbeki @@Hollis Vey @@Cato Marchetti\n  When: 10 April 2917\n]\n\nA lane is not a road. People who have never been through one think it is, and draw it on their charts as a line between two dots, and talk about _going down the Corva lane_ as if it were a corridor with a door at each end. Til has been through forty-one lanes in her life, some of them many times, and she has stopped trying to say what they are. The nearest she has come is this: a lane is a place where the dark has been folded, and a ship in it is a crease.\n\nAn anchored lane is a good crease. Somebody, a long time ago, built a station at each end of it that holds the fold flat, and as long as the anchors hold, a ship goes in at one end and comes out at the other with nothing worse than a headache and a strange taste in the mouth, like licking a battery. An unanchored lane is called raw. The fold moves. It ripples like a flag in a wind. Nobody knows what the wind is.\n\nThe Corva lane has been raw for longer than anybody alive has been alive, and for most of that time it was closed. Two years ago it opened again, the way a healed bone sometimes aches and opens, and nobody knows why that either.\n\n\"Shear coming,\" says Oz, from the engine space. \"Big one. Twelve seconds.\"\n\n\"I see it.\"\n\n\"You don't see it, you feel it. Hold on to something.\"\n\nTil holds on to the yoke. In the forward seat beside her Juno is strapped in tight, her new suit sealed and her helmet clipped to her shoulder, and she is holding on to both armrests with both gloved hands and staring straight ahead at the cockpit glass, where there is nothing to see. In a lane there is never anything to see. The glass shows a dim grey flicker, like the inside of an eyelid, and occasionally a long slow ripple of brighter grey crossing it from one side to the other, which is the fold moving, and which you learn very fast not to look at.\n\nThe shear hits.\n\nIt's like being kicked by the whole universe at once. The _Dray_ doesn't shake so much as change shape: for one long, sick, impossible moment Til can feel the cockpit getting longer, the yoke in her hands drawing out away from her like taffy, her own arms stretching to follow it; and then it snaps back, and every rivet in the old tug's hull screams at once, a high thin chorus like a choir of kettles, and something aft goes bang.\n\n\"Coolant,\" says Oz, quite calmly, on the intercom. \"Number two loop. That was the coupling.\"\n\n\"How bad?\"\n\n\"Bad enough that I'd like some help, please, Captain.\"\n\nTil looks at the board. The core temperature is climbing, not fast but steadily, a line going up at the angle of a cheap staircase. She can't leave the yoke. In a raw lane you never leave the yoke; the autopilot doesn't know what the fold is going to do any more than you do, and it doesn't have the sense to be frightened.\n\n\"Juno,\" she says.\n\nJuno doesn't move.\n\n\"Juno. I need you to go aft and help Oz.\"\n\n\"I'm not crew.\" Juno's voice is very small and very flat. She's still staring at the glass. \"Mother Szabo said—\"\n\n\"Mother Szabo isn't in a raw lane with a coolant leak. Mother Szabo is a day behind us in a much bigger ship with a much better engineer. If the core goes, it goes, and you go with it, and then she'll bill me.\" Til doesn't look at her. She keeps her eyes on the board and her hands on the yoke and her voice exactly the way it would be if she were asking for a cup of tea. \"Unstrap. Clip your helmet on. Go aft along the rail, hand over hand, don't let go of the rail for anything. Oz will tell you what to do. He's very good at telling people what to do.\"\n\n\"I am,\" says Oz on the intercom.\n\nJuno sits for another two seconds. Then she unstraps.\n\nTil doesn't watch her go. She hears her: the click of the harness, the clunk of the helmet seal, the scrape of boots on the deck, the hand-over-hand rattle of the rail. She hears the aft hatch cycle. She keeps her eyes on the board and her hands on the yoke and flies the _Dray_ through the dark that isn't dark, feeling for the fold the way you feel for a step in a black stairwell, and she listens to the intercom.\n\n\"There,\" Oz is saying. \"That clamp. No, the big one. Get both hands on it. Now push. Harder than that. Pretend it's me.\"\n\nA grunt.\n\n\"Good. Hold it there. Don't let go of it, whatever happens.\"\n\n\"It's hot.\"\n\n\"It's very hot. Your gloves are rated. Hold it. I'm going to put a sleeve on the coupling and it's going to take me forty seconds, and if you let go of that clamp in the next forty seconds the loop'll blow out past my hands and the core'll scram and we'll be sitting dead in a raw lane, so don't.\"\n\n\"I won't.\"\n\n\"Shear coming,\" says Til. \"Eight seconds.\"\n\n\"Wonderful,\" says Oz.\n\n\"Hold on to the clamp, Juno.\"\n\n\"I'm _holding on to the clamp_.\"\n\nThe second shear is worse than the first. The cockpit stretches and snaps and the kettles scream and the board flickers, and Til, flying, feels the fold go under the _Dray_ like a wave under a small boat, a long sickening rise and fall, and holds the yoke against it and does not breathe. Aft, on the intercom, she hears Juno shout something wordless and furious, and Oz swearing in the Roundsman cant, a long liquid stream of it, and then silence.\n\n\"Oz.\"\n\nNothing.\n\n\"Oz.\"\n\n\"Sleeve's on,\" says Oz. He sounds out of breath. \"Loop's holding. She held the clamp.\"\n\n\"Juno?\"\n\nA pause. Then Juno's voice, shaking, very young. \"I held the clamp.\"\n\n\"Good,\" says Til. \"That was good.\"\n\nShe keeps her eyes on the board. She doesn't let her voice change. She flies the _Dray_ on through the shifting dark for another nine hours, through four more shears, none of them as bad, and she never once takes her hands off the yoke. And at some point in the fifth hour, without either of them saying anything about it, Juno comes forward again and straps into the second seat and stays there, and when Til asks her to read off the core temperature every ten minutes, she does.\n\n[\n  Place: #The Throat\n  Characters: @@Til Brask @@Juno Brask @@Ozias Mbeki @@Hollis Vey @@Cato Marchetti\n  When: 12 April 2917\n]\n\nThey come out of the Corva lane on the twelfth of April at the fourth bell, ship's time, into a silence so complete that for a long moment Til thinks the board has failed.\n\nThe board hasn't failed. It's showing her exactly what's there. The glass has gone from grey to black, real black, star-black, with real stars in it, a great spilled field of them; and ahead and a little below, so close and so huge that her eye refuses it at first as a planet and reads it as a wall, there's Gall.\n\nShe has seen gas giants before. Every salvager has; the wreck-fields of the outer Reach are full of them, and the dead hulks always fall toward the big ones in the end. She has never seen one like this. Gall is close, the lane mouth hanging in the dark only a few hundred thousand kilometres off its trailing edge, and it fills a third of the sky: a vast striped curve of ochre and rust and old-bruise purple, banded like the grain in a slab of wood, with storms in the bands the size of worlds, turning. At its southern limb there's a white cap. Across its face, very small and very sharp, a moon throws a round black shadow. And above it, high on the left, laid across a quarter of the sky like a scarf thrown on a floor, is the Lamp.\n\nIt's enormous. That's what nobody tells you. In the Observatory's pictures it was a bright head and a long dim tail; out here it's a smear of pale green light as wide as Til's hand at arm's length, with a head that hurts to look at and a tail that goes on and on and on, splitting into two, three, four fainter streamers, fanning out across the stars until it's lost in them. It's so bright Gall's night side is faintly lit by it.\n\nNobody in the cockpit says anything for a while.\n\n\"Well,\" says Oz eventually, from the hatch. \"There it is.\"\n\nTil runs the board. She does it automatically, the way she would coming out of any lane: traffic, beacons, anchor station, comms. There's no traffic. There are no beacons. There's no anchor station where the anchor station should be, at the lane's mouth, only a faint scatter of radar returns drifting in a loose cloud, metal-sized, like the debris from something that once was there and isn't any more. Whatever held this throat open has been gone a long time. Comms are open on every band she's got, and every band is empty: hiss, and the low growling roar of Gall's radio belts, and under that nothing at all. No traffic control. No nav pings. No voices.\n\n\"Nobody home,\" says Juno quietly.\n\n\"Lanes go dark for a reason,\" says Til. \"Usually it's because nobody's left to keep them lit.\"\n\n\"It was a city once,\" says Oz. \"Kettle. My mother said. The ice moon. There was a city under the ice.\"\n\n\"Was or is?\"\n\n\"She didn't know. Nobody's been through in two hundred years and more. Nobody's said a word on the radio.\"\n\n\"Somebody'd say something,\" says Juno. \"If they were there. Wouldn't they? After two hundred years. If a ship came.\"\n\nNobody answers her.\n\nThe cradle is in the main cabin, aft of the cockpit, where there's room for it, clamped to the deck by its sled and plugged into the _Dray_'s power with a cable Oz rigged out of three adaptors and a prayer. When Til goes back, Hollis Vey is propped up on his pillows with the cradle's canopy slid back and his face turned to the cabin's only port. Cato Marchetti is sitting beside the cradle on a crate, very still, as he always is, with his hands on his knees.\n\nVey's face is wet.\n\nHe doesn't wipe it. He doesn't seem to know it's wet. He's looking at Gall, at the bruised bands and the white cap and the moon's small shadow crossing, and at the Lamp above it, and his face is a long thin yellowish wreck of a face with the tears running down it into the pillow, and he looks happier than Til has seen anybody look in years.\n\n\"Captain,\" he says. \"Look at it.\"\n\n\"I've looked.\"\n\n\"Five hundred years,\" says Hollis Vey. \"My family owned this. All of it. That planet. That moon. That sky.\" The thin voice through the speaker grille is shaking with something like laughter. \"Do you know, we never came? Not one of us. Not one Vey ever came to Corva. We owned it for sixty years and sent factors and took the money and never once came to look. And then we lost it, and spent five hundred years wondering how.\" He turns his head on the pillow. \"I'm the first Vey ever to see it. And the last. That's rather funny, isn't it?\"\n\n\"I wouldn't know, Mr Vey.\"\n\n\"No. You wouldn't.\" He smiles at her with his perfect too-large teeth. \"Sit down, Captain. I promised I'd tell you my business, when I could bear to. I can bear a little of it now.\"\n\nTil sits on the edge of the bunk across from him. Marchetti doesn't move. Through the hatch she can hear Juno and Oz in the cockpit talking in low voices; she can hear the _Dray_'s air plant coughing, the way it always coughs after a lane.\n\n\"My family's company was called Halloran-Vey,\" says Hollis. \"It was a combine of the old sort, in the old lanes, before the Concord swallowed it and before the Concord choked on it in its turn. It dug things out of places and sold them. Gas from giants. Ice from moons. Labour from people.\" He says it lightly. \"It held this system for sixty years. It ran a skimmer that dipped Gall for deuterium, and a camp of bonded workers on Kettle to refine what the skimmer brought up. And then, in twenty-three ninety-one, it lost it.\"\n\n\"Lost it how?\"\n\n\"That,\" says Hollis, \"is the question I've spent my life on. The records are very bad. The Combine had a habit, when something went wrong, of writing as little about it as possible. There's a register—a loss register, the Combine kept them for every operation—that says Corva was lost in that year, and that certain assets were not recovered. And then nothing. Two hundred and sixty years later the Concord came here to take it back, and the records of that are worse.\"\n\n\"Took it back from who?\"\n\n\"From whoever was here.\" He shrugs, a movement of one bony shoulder under the blanket. \"The Concord's archives are a midden. Half of them burned when it fell. I have spent a great deal of money buying the other half off the people who looted them, and they tell me almost nothing. That a fleet was sent. Whether it took anything back, or came back at all, they don't say.\" He looks back at the port, at the Lamp. \"And then, in the dock-houses of Tarn, this story. That the founders of Corva hid something on their comet. That it comes back.\"\n\n\"The Hoard.\"\n\n\"The Hoard.\" He smiles. \"You don't believe in it.\"\n\n\"I've bought two maps to it.\"\n\n\"So have I,\" says Hollis Vey. \"Eleven. All different. All forged.\" He closes his eyes for a moment, as if the talking has tired him. \"But my family lost something here, Captain. Something the register calls an asset not recovered. And the Lamp was in the sky the year they lost it. And it has come back only once since, and the Concord's fleet went to Corva that same year. And now it is coming back for the last time, because Gall is going to eat it.\" He opens his eyes. \"If you were me, and had three months to live, where would you look?\"\n\nTil doesn't answer. Beside her, very quietly, Cato Marchetti shifts his weight on the crate, the first movement she has seen him make.\n\n\"What's the asset?\" Til says. \"The one not recovered.\"\n\n\"The register doesn't say,\" says Hollis. \"It gives it a number. That's all.\"\n\nHe's lying. Til knows it the way she knows when a hull plate is about to go: by a change in the sound of things. It's not in his face, which is as open and amused and wrecked as before. It's in Marchetti, who has gone still again, still in a different way, the stillness of a man who has just heard his employer say something he was told not to say and is waiting to see whether anybody noticed.\n\n\"All right,\" says Til, and gets up. \"Get some rest, Mr Vey. We'll be at Gall in six days.\"","wordCount":4223,"createdAt":1793108733146},{"id":"dSoq2P5WxvUQk1Wtyn6j3","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"KUeDnmR-PMrQG7-kIhydF","text":"The infirmary was the one place on the _Patience_ that was ever warm. Ekene kept it that way on purpose, cooking the heat exchangers past their rating and fiddling the logs, because, he said, sick people healed better warm and well people talked more truthfully; and it was true that you heard things in the infirmary at night that you did not hear anywhere else on the ship. It was a narrow white room with eight bunks, a dispensary cage, a surgical bay behind a curtain, and a single round port the size of a dinner plate that looked out along the hull toward Gall's limb. Ekene had hung a dried flower in a bag over the port. Nobody knew where he had got a flower.\n\nHe was sitting at the dispensary counter when she came in, writing up the day by the light of a single lamp. He looked up, and took off his reading lenses, and looked at her for a long moment without saying anything. Then he got up and came round the counter and put his arms round her, and she stood in them with her face against the stiff cotton of his coat and her fist in her pocket and did not cry, because she had not cried in nine years and was not about to start now in front of a dispensary cage.\n\n\"I heard it,\" he said into her hair. \"Half the ship was on the line channel. I heard you talking to her.\"\n\n\"I didn't do anything.\"\n\n\"You talked to her.\"\n\n\"I couldn't do anything, Ekene. The Gull's thruster was stripped. It's been stripped three weeks. I put in for the part three times.\" She let go of him and stepped back. \"I ran the line. That's what I did. I sat there and ran the dip and I listened to her go.\"\n\n\"If you'd stopped the dip—\"\n\n\"If I'd stopped the dip the line would have walked and we'd have lost Odile as well. And the Bucket. And the drum, maybe. And they'd have docked the whole crew for the load.\" She sat down on the end of the nearest bunk. \"That's the arithmetic. I did the arithmetic.\"\n\nEkene went back behind the counter and filled two cups from the urn and brought them over. It was the infirmary's tea, which was not tea at all but something he grew in a tray under the ultraviolet lamp in the surgical bay and dried and smoked, and which tasted like a wet fire. She drank it. He sat beside her on the bunk. He was fifty-two, eleven years older than she was, a big soft-spoken man with grey in his beard and the long patient hands of somebody who had spent his life doing small things carefully to people in pain. He had come to Corva on a medical contract six years ago, not bonded, which made him a strange thing on the _Patience_, a free man who could have left on any _Clement_. He had not left. Maren had asked him why, once, and he had said that he was a coward and the Combine's other postings were worse; and then, later, in the dark, that it was her.\n\n\"The factor,\" he said.\n\n\"You saw him?\"\n\n\"He came by. Before the hall. He wanted to see the infirmary.\" Ekene turned his cup round in his hands. \"He asked about our stock of painkillers. How many beds. Whether we had a cold store and what was in it. He was polite. He asked very good questions.\"\n\n\"What kind of questions?\"\n\n\"The kind an auditor asks. What things cost. What could be moved.\" He looked at her sideways. \"What do you think _changes_ means, Maren?\"\n\n\"I think the _Clement_'s eleven days early,\" Maren said. \"I think nobody sends a new factor to a skimmer that's making its numbers just to say hello.\" She drank the rest of her cup in one swallow, burning her throat. \"And I think somebody cut Lusine's line.\"\n\nShe took her fist out of her pocket and opened it.\n\nEkene looked at the clip for a long time. Then he took it from her palm, gently, the way he took everything, and turned it under the lamp, and found the stub of the gate spring and the bright clean face of the cut, two-thirds of the way through.\n\n\"A blade,\" he said.\n\n\"A fine one. Not a cutter. Cutters crush. That's a saw cut, or a knife that's been honed. Somebody took that spring two-thirds through, so it'd hold in calm and go in the first hard shock.\" She heard her own voice, very level, the tether-chief's voice. \"Every runner checks her clip at the lock. You snap it, you load it, you look at the gate. You don't look at the spring. Nobody looks at the spring.\"\n\n\"Who could do this?\"\n\n\"Anybody who could get to her harness. Anybody in the runners' lock, between her last check yesterday and the dip. Riggers. Runners. Dock crew. Wardens.\" She stopped. \"Me.\"\n\n\"Not you.\"\n\n\"No. Not me.\" She took the clip back. \"She said something on the way down. On four, so it's not on the log. She said she'd read a dispatch on the relay, something that came ahead of the _Clement_ on the beacon. She said it was about all of us. She said she'd told someone, and she shouldn't have.\"\n\n\"Told who?\"\n\n\"She didn't say. She went into the static.\" Maren closed her hand on the clip again. \"She said, _I don't think it was the clip._\"\n\nThey sat for a while without talking. Through the port, over Ekene's shoulder, she could see the long curve of the _Patience_'s hull lit by Gall-shine, rust-coloured, and beyond it the edge of Gall itself, and beyond that the black. It took her a moment to see what she was looking at. There was a smudge in the black, just above the planet's limb: a faint pale patch no bigger than a thumbprint, like a breath on glass, with the barest suggestion of a tail.\n\n\"There it is,\" said Ekene, following her eyes. \"Teska's comet.\"\n\n\"The Lamp.\"\n\n\"She says it takes the dead out.\"\n\n\"She says a lot of things.\" Maren stood up. She was very tired. She put the clip back in her pocket and felt its small weight there, against her hip, where her line knife hung on her coat. \"I'm going to find out who she told.\"\n\n\"Maren.\"\n\n\"What.\"\n\n\"Be careful who you ask,\" said Ekene.\n\n\n# Consolidation\n\n## Lusine's locker\n\n[\n  Place: #The Patience\n  Characters: @@Maren Tsolo @@Odile Arda\n  Items: ^Lusine's clip:@Maren Tsolo\n  When: 5 November 2391\n]\n\nThe runners lived aft of the drum, in a long low compartment the crew called the Shelf, where the bunks were stacked four high along both walls and the air came in through a single overworked fan that had been rattling since before any of them were born. Each runner had a bunk and a locker. When a runner went into Gall, the locker was emptied by the warden's office, and anything of value was sold against the account, and the rest went into the waste cycler. It had been three days. The warden's office had not got round to Lusine's yet. Maren had made sure of that, by giving Bram Kovač two dips' worth of overtime on the drum.\n\nOdile was sitting on her sister's bunk when Maren came in, with the locker open beside her and its contents laid out on the blanket in rows, as if for an inventory. A spare undersuit. A comb. A packet of the cheap dried fruit they sold in the Camp at Midwinter. A cloth bag of hair ties. A stack of letters from somebody in the Camp, tied with string. A small battered slate with a cracked screen. A carved wooden fish, no bigger than a thumb, very old.\n\n\"That was our mother's,\" Odile said, without looking up. \"The fish. She carved it. She used to carve things. She said she'd teach me but she didn't.\"\n\nMaren sat down on the bunk opposite. \"I'm sorry, Odile.\"\n\n\"You keep saying that.\"\n\n\"I keep meaning it.\"\n\nOdile picked up the fish and turned it over in her fingers. Her face was swollen and blotched and fierce, and she had not slept, by the look of her, since the dip; she had done her shifts anyway, both of them, on the line, at six kilometres, and run them clean, and Maren had watched her dot on the board and said nothing, because there was nothing to say to a runner who wanted to be on the line except _clamps on_.\n\n\"The warden came round,\" Odile said. \"Hale. Yesterday. With the form.\" She put the fish down in its place in the row. \"Said I'd got her account now. Said it was standard. Two hundred and eighty days, carried forward, at the standard rate. For her suit and her bottle and her beacon and the inspection on the crawler. He was very sorry.\"\n\n\"He's always very sorry.\"\n\n\"I said I'd pay it.\" Odile looked up at last. \"I said I'd pay it, Chief, because what else do you say? And he said that was very good of me and wrote it down. And then he said, was there anything of hers I'd found, any papers, any messages. For the inquiry.\" She was watching Maren's face. \"I said no. Because I hadn't looked yet.\"\n\n\"And now you have.\"\n\n\"And now I have.\"\n\nOdile reached under the pillow and brought out a strip of grey foil, the kind the relay printers used for hardcopy, folded small and soft with handling. She held it out.\n\n\"It was in her boot,\" she said. \"Her deck boot. The left one. Inside the liner, under the heel. She always kept her money there when we were kids, in case somebody went through her pockets. I knew where to look.\" Her mouth moved. \"Nobody else would.\"\n\nMaren unfolded the foil.\n\nIt was a relay transcript, printed in the cramped type the old relay printers used, and it had been printed by hand, one line at a time, as if somebody had been feeding the printer a little at a time so it wouldn't log a full job. It was headed with the Halloran-Vey wheel and a string of routing codes, and below the codes, a single block of text.\n\n_FROM: Combine Operations, Halloran. TO: Factor-designate A. QUIST, by beacon ahead of CLEMENT. SUBJECT: Consolidation of Corva Operation._\n\n_1. Corva Operation to close effective arrival of factor-designate. Operation no longer commercially viable following Sorrel price adjustment. Board resolution 2391/114 refers._\n\n_2. Skimmer PATIENCE to complete current season dips to maximise final load. Vessel to be decommissioned and scuttled in Gall at season end. Salvage value does not justify transit._\n\n_3. Skilled bonded (est. 300, PATIENCE complement) to be transferred with accounts aboard CLEMENT to Levy Office, Sorrel Station, for assignment under Combine-Levy labour agreement 2390/22. Transfer to be presented as relocation._\n\n_4. Kettle Camp installations and bonded accounts (est. 2,100 households) to remain in place. Supply to cease on departure of CLEMENT. Accounts to be offered at discount to secondary holders._\n\n_5. Factor to manage expectations. Contingency authority (Schedule H) confirmed. ADMONITION to follow as escort._\n\nMaren read it once, slowly, and then again. The fan rattled. Somewhere forward of the Shelf the drum was beginning its spin-up for the second dip, a long rising groan that came through the deck like a tide.\n\n\"What's the Levy,\" said Odile.\n\n\"The Levy Office is how the Combine rents bonded to the Sorrel lane forts,\" Maren said. Her own voice sounded strange to her. \"For the war. Diggers. Loaders. People to stand on gun-decks and fill sandbags with ice. They pay the Combine by the head. The Combine pays the bonded the standard rate against their account. Most of them never come back up the lane.\"\n\n\"And the Camp.\"\n\n\"_Supply to cease._\"\n\n\"What does that mean?\"\n\nMaren looked at her. Odile was nineteen. She had been born on Kettle, in the Camp, in the warrens of the third shaft, where her mother had carved fish and her father had died of the ice cough when she was two; she had never been anywhere else. She knew what supply meant. She was asking because she wanted somebody to say it so she would not have to.\n\n\"It means nobody's coming back,\" said Maren. \"It means the _Clement_ leaves and doesn't come again, and the Camp has what's in its tanks and its stores, and when that's gone, it's gone. The refinery runs on what the _Patience_ brings it, and the _Patience_ will be at the bottom of Gall. They'll have three months, maybe. Four, if they're careful. Then the air plant stops.\"\n\n\"Two thousand households.\"\n\n\"Twenty-one hundred.\"\n\n\"And then somebody buys their accounts,\" said Odile, very quietly. \"At a discount. Somebody buys the debts of dead people.\"\n\n\"Somebody always does.\"\n\nOdile put her face in her hands. She didn't cry. She sat there with her hands over her face and her shoulders very still, breathing, and after a while she said through her fingers, \"She told someone.\"\n\n\"She said so. On the line.\"\n\n\"She'd have told me. She told me everything. She didn't tell me this.\" Odile took her hands away. Her eyes were dry and terrible. \"She'd only not tell me if she was scared for me. If she'd told somebody else first and it had gone wrong. If she thought they'd—\" She stopped. \"Who'd she tell, Chief?\"\n\n\"I don't know.\"\n\n\"She'd have told someone she trusted. Someone she—\" Odile's mouth twisted. \"She was seeing somebody. The last couple of months. She wouldn't say who. She went all quiet and pleased about it, like when we were kids and she'd stolen something. I thought it was one of the dock boys.\"\n\n\"Was it?\"\n\n\"I don't know. She said—she said he was funny. She said he made her laugh in the lock.\" Odile looked at the rows of her sister's things on the blanket: the comb, the fruit, the fish. \"She said he was always in debt and he didn't care. She said it was restful.\"\n\nMaren's hands had gone very cold. She folded the foil up again along its old creases, small and soft, and held it.\n\n\"Keep this between us,\" she said. \"Not Hale. Not anyone. Not even the runners.\"\n\n\"Why?\"\n\n\"Because the last person who read it told somebody,\" said Maren, \"and she's in Gall.\"\n\n## Relocation\n\n[\n  Place: #The Drum\n  Characters: @@Maren Tsolo @@Aurelian Quist @@Corwin Hale @@Abel Tsolo @@Danek Sorell @@Grandam Teska @@Bram Kovac @@Odile Arda\n  When: same day\n]\n\nQuist told them that evening, at the change of shift, in the drum hall, under the names.\n\nHe did it well. Maren had to give him that, afterward, when she had the stomach to give him anything. He stood on the gallery with Hale beside him and the marine sergeant at his back, in his plain dark coat with the wheel on the lapel, and he did not read from a slate. He told them that the Combine had reviewed its operations in the Corva system and had concluded, with regret, that the market for Corva deuterium could no longer sustain them. He told them that the _Patience_ was an old ship, older than most of them, and that she would finish her season and then be retired. He told them that the Combine valued its skilled bonded very highly, and that every one of the _Patience_'s complement would be relocated, with their accounts intact and in good standing, to new postings in the Sorrel lanes, where the work was steady and the air was cheap. He told them the _Clement_ would carry them. He told them it would sail at the end of the month.\n\nHe told them nothing about the Levy, or the war, or the Camp.\n\nHe did not lie about the Camp. That was the clever thing. When old Pirro from the Bucket crew shouted up from the floor, _What about our families? What about the Camp?_, Quist turned to look at him with his long grave lined face and said that the Kettle installations would be transferred to a successor operator under the usual terms, and that the Combine's obligations to the Camp's residents would pass with them, and that family members of relocated bonded who wished to follow on were welcome to apply for passage at their own account. Every word of it was true. Maren, standing at the back of the hall under the drum with the foil in her pocket, could hear exactly how true each word was, and exactly how much it weighed.\n\n_At their own account._ A passage on the _Clement_ to Sorrel cost more than a rigger earned against his debt in eight years.\n\nThe hall took it the way bonded halls took things. There was a long silence, and then a noise, a sort of collective exhalation like a fan spinning down, and then the arguments began, small ones, everywhere at once, people turning to their neighbours. A woman was crying near the slot. Somebody was laughing. Danek Sorell, beside Maren, said \"Sorrel,\" three or four times, as if he were trying to remember where he had heard the word.\n\n\"I've got kids in the Camp, Chief,\" he said. \"Three. Tamar's in the third shaft. What's he mean, apply?\"\n\n\"He means you can't.\"\n\n\"So we go to Sorrel and they stay.\"\n\n\"That's what he means.\"\n\n\"For how long?\"\n\nMaren didn't answer him.\n\nUp on the gallery, Quist had stepped back, and Hale had stepped forward with his slate under his arm and his soft patient voice raised just enough. Order, the warden said. Questions to be raised with section chiefs, who would be meeting with the factor individually over the next days. Dips to continue as rostered. Air rations unchanged. Any bonded found organising, or refusing duty, or damaging Combine property, would have their accounts reviewed, with all that that implied, and their families' accounts likewise. He said it gently. Bram Kovač and two other trusties stood at the foot of the gallery stair with their shock-sticks loose in their hands, looking at nobody in particular.\n\n\"Organising,\" said Teska, loudly, from the bench near the drum where she always sat. \"What's that, organising? Is that talking? Is it organising if I talk?\"\n\n\"Grandam,\" said Hale, with great kindness, \"nobody's going to stop you talking.\"\n\n\"No,\" said Teska. \"You never have.\" She turned her head toward the hall, with her one good eye. \"I've been on this ship sixty-one years. I came out on her in pieces. I've buried two husbands and a daughter on that line. Now they say they're going to sink her.\" She spat on the deck. \"Gall can have her. Gall's had everything else.\"\n\nSome of the hall laughed. Most of it didn't.\n\nMaren found her brother at the edge of the crowd near the riggers' stair, where he always was, where the talk was. He was flushed and bright-eyed and talking fast to a knot of young riggers, his hands moving, and when he saw her coming he broke off and came to meet her with his arms open like a man at a party.\n\n\"Sorrel,\" he said. \"Did you hear him? Sorrel, Maren.\"\n\n\"I heard him.\"\n\n\"Off this rock. Off this ship. Do you know what they've got on Sorrel? Real gravity, on the forts. They've got markets. They've got—God, I don't know what they've got, I've never been anywhere. Neither have you.\" He caught her by the shoulders. His breath smelled of the illegal still in the dock section, which meant he had been celebrating since before the hall. \"We're getting out. Both of us. Thirty years they've had us hanging off this planet on a string and now they're letting us go.\"\n\n\"They're not letting us go.\"\n\n\"Same thing.\"\n\n\"It isn't, Abel.\"\n\nHe looked at her face, and some of the brightness went out of his. He let go of her shoulders.\n\n\"You've got that look,\" he said. \"Your chief's look. Like something's about to walk.\"\n\n\"Something is.\"\n\n\"What?\"\n\nShe looked at him. Her little brother, twenty-nine years old, the same height as her and twice as handsome, with their mother's eyes and their father's absence and a laugh that had been getting him out of trouble since he was four. Everyone on the _Patience_ liked Abel. Everyone on the _Patience_ was owed money by Abel, or owed him a favour, or both. He had never kept a credit in his account for longer than a week in his life. It was, Lusine had said to her sister, restful.\n\n\"Not here,\" Maren said.\n\n## The factor's cabin\n\n[\n  Place: #The factor's cabin\n  Characters: @@Maren Tsolo @@Aurelian Quist\n  When: same day\n]\n\nThe factor sent for her two hours after the hall.\n\nHe had taken Moberly's old cabin, forward of the bridge, and done nothing to it; it was still Moberly's, with the fat man's soft chairs and his hideous picture of a sailing ship on a green sea, and his stains on the carpet. Quist sat behind Moberly's desk with a single slate in front of him and a cup of real coffee, which Maren could smell from the door, and he got up when she came in, which no factor had ever done.\n\n\"Chief Tsolo. Thank you. Sit down, please.\"\n\nShe stood.\n\nHe looked at her for a moment, and then sat down again himself, without fuss. \"As you like. Would you like coffee? It's real. I'm told there hasn't been any on this ship in ten years.\"\n\n\"No.\"\n\n\"No.\" He turned the cup a little on its saucer. \"I'll come to the point, then. I need a tether-chief to manage the end of the season. You're the senior chief on this ship and the crew listen to you, which is not true of the others, or of the warden, though he'd like to think so. I need the last dips run clean, the last loads brought up, and the _Patience_ ready for decommission on the twenty-ninth. I need the crew calm while it happens. I can offer you something for it.\"\n\n\"What?\"\n\n\"An assessment,\" said Quist. \"When you reach Sorrel. As supervisory rather than general labour. It would mean a different rate against your account, a different kind of work. You'd be off the gun-decks.\" He paused. \"You'd keep your air.\"\n\n\"And Abel?\"\n\n\"Your brother? I could put him on the same assessment. I'd have to bend it.\"\n\n\"And Danek Sorell's three children in the third shaft?\"\n\nQuist did not answer at once. He looked down at the slate in front of him, and then up at her again, and his long lined face did not change, but something in it went still, the way a man goes still when he hears a sound in the dark.\n\n\"You've read the dispatch,\" he said.\n\nMaren said nothing.\n\n\"The advance dispatch. On the beacon. The one that came ahead of me.\" He nodded slowly. \"There was a runner on the relay. The one who died on the line. I'm told she worked the relay on her off-shifts.\"\n\n\"Lusine Arda.\"\n\n\"Lusine Arda. And now you've read it.\" He sat back. \"I wondered how long it would take. I wondered who it would be. I'd have said you, if you'd asked me. I've been in this work a long time, Chief Tsolo, and there's always one.\"\n\n\"Then you know.\"\n\n\"I know what I was sent to do.\" He picked up the coffee and drank some of it and put it down. \"The Corva operation is finished. It's been finished for two years; it just hasn't been told. The Sorrel yards went over to catalysed helium last spring, and the price of deuterium in the outer lanes fell by two-thirds in a quarter, and there is no longer any way to bring Corva gas up the lane and sell it for more than it costs to get it out of the sky. So the Board has done what boards do. It has cut its losses. The ship is worth nothing; it goes into Gall. The crew are worth something, to the Levy; they go to Sorrel. The Camp is worth less than nothing. The Camp is a liability. So the Camp is left in place, and its accounts are sold to a discount house in Halloran for a fraction of a mark on the hundred, and the discount house will never send anybody to collect, because there will be nobody to collect from.\"\n\n\"Two thousand households.\"\n\n\"Twenty-one hundred.\"\n\n\"You're going to leave them to die.\"\n\n\"I'm going to leave them,\" said Quist, \"to be somebody else's problem. That's the form of words. I didn't write it.\" He looked at her steadily. \"I want you to understand that I'm not a stupid man, Chief Tsolo. Nor a cruel one, I think. I've done this before. I closed Bellamy Deep in eighty-four and the Hollow Moons in eighty-seven. Bellamy went quietly; most of them got out on the last ore boats, as stowaways, and I looked the other way. The Hollow Moons didn't go quietly, and it didn't help them. It's always worse when it isn't quiet.\"\n\n\"And Tamsin's Rock?\" said Maren.\n\nIt was a guess, a name she had heard in the infirmary once, late, from Ekene, and never asked about. She saw it land. He did not flinch; he was too old and too practised to flinch. But he put the cup down very carefully, so that it made no sound on the saucer, and he took his hand away from it.\n\n\"I wasn't the factor at Tamsin's Rock,\" he said.\n\n\"But you know what happened there.\"\n\n\"Everybody in the Combine knows what happened there. That's what Tamsin's Rock is for.\" He looked at her for a long moment. \"If you know what happened at Tamsin's Rock, then you know why I'm telling you the truth. Because you're going to do something, Chief Tsolo. I can see it in you. You're going to talk to your crew, and the crew are going to talk to the Camp, and somebody is going to have an idea. And I'd rather you did it knowing exactly what you're up against than not.\" He spread his hands on the desk. \"The _Admonition_ is two weeks behind me. She has sixty marines and a torpedo bay. And I have contingency authority. Whatever you do, you can't make it end any better than it's going to end now. You can only make it worse.\"\n\n\"For who?\"\n\n\"For everyone,\" said Quist. \"For you. For them. For me.\" He paused. \"Most of all for them.\"\n\nMaren looked at him across Moberly's desk, at his plain coat and his good coffee and his long sorrowful face. She thought of Lusine's voice going faint on channel four. _I don't think it was the clip._\n\n\"Was it you?\" she said. \"Lusine. Did you have her line cut?\"\n\nFor the first time Quist looked genuinely surprised.\n\n\"Her line was cut?\"\n\n\"Her clip. Somebody took the spring two-thirds through.\"\n\nHe was quiet for a moment. Then he said, \"No. It wasn't me. I didn't know her name until this morning.\" He looked down at the slate. \"But I'd look closer to home, if I were you. I'd look at who on this ship would have wanted the Combine to be grateful to them. There's always somebody. There's always somebody who'd like to be on the right list.\" He looked up. \"The offer stands, Chief. Supervisory. You and your brother. Think about it.\"\n\n\"I've thought about it,\" said Maren, and walked out.\n\n[\n  Place: #The blister\n  Characters: @@Maren Tsolo @@Abel Tsolo\n  When: same day\n]\n\nShe found Abel at the third bell of the night, in the blister.\n\nThe blister was a dome of thick old glass on the _Patience_'s dorsal hull, a relic of the days when skimmers had carried passengers who wanted to look at things. It was cold, and badly lit, and the crew used it for courting and drinking and the kind of conversations that couldn't be had anywhere else, and nobody ever cleaned it. Abel was sitting on the floor with his back against the frame and a bottle of dock-still between his knees, looking up. He didn't turn round when she came in. He held the bottle up over his shoulder.\n\nShe took it, and drank, and gave it back, and sat down beside him.\n\nAbove them, through the scratched glass, Gall filled half the sky, ochre and purple, a storm the size of a world turning slowly on its southern limb. Above the storm, in the black, the Lamp hung like a thumbprint of light. It was brighter than it had been three days ago. You could see the tail properly now, a long faint fan of pale green going away from the sun, so delicate that if you looked straight at it it disappeared, and came back when you looked to the side.\n\n\"Teska says it takes the dead out,\" said Abel.\n\n\"Teska says a lot of things.\"\n\n\"She says it'll be back when our grandchildren are dead.\" He drank. \"That's a long time to be a comet.\"\n\n\"It's not a long time for a comet.\"\n\n\"No.\" He laughed a little. \"I suppose not.\" He held the bottle up to the glass and looked at the Lamp through it, through the cloudy brown spirit, so that it wobbled. \"I keep thinking about her. Lusine. Out there. Going in.\"\n\n\"So do I.\"\n\n\"You talked to her. The whole way. I heard you.\" He lowered the bottle. \"That was a good thing you did, Mar.\"\n\n\"I didn't do anything.\"\n\n\"You did, though.\" He turned his head and looked at her for the first time. His face was grey and his eyes were wet and red-rimmed, and she could not tell how much of it was the still. \"You always think you didn't do anything. You do more than anybody.\"\n\nShe looked at him for a long moment, at his handsome tired face in the Gall-light, her brother, whom she had carried on her hip through the third shaft when their mother went into the cloud.\n\n\"Were you seeing her, Abel?\"\n\nHe didn't move. He didn't look away. But she had known him all his life, and she saw the small thing happen behind his eyes, the thing that happened when he was eight and she asked him who had got into the dried fruit, the half-second of arithmetic.\n\n\"Seeing her?\"\n\n\"Lusine. Odile says she was seeing somebody. Somebody funny. Somebody always in debt who didn't care.\"\n\nAbel laughed. It was almost his real laugh. \"That's half the riggers on the ship.\"\n\n\"Were you?\"\n\n\"We were friendly.\" He shrugged. \"A bit. Now and then. She was—she was good fun, Mar. She liked a joke. We'd have a drink in the lock after shift. It wasn't serious. She wasn't serious about anybody.\" He drank. \"Why?\"\n\n\"Did she tell you anything? Before she died? About the _Clement_? About a dispatch?\"\n\n\"A dispatch?\" He frowned. \"What dispatch?\"\n\n\"Did she?\"\n\n\"No.\" He shook his head. \"No. Why would she tell me about a dispatch? I'm a rigger. I can barely read the duty board.\" He smiled at her, the old smile, _don't worry, it's me_. \"What's this about?\"\n\nMaren looked at the Lamp.\n\n\"Nothing,\" she said. \"It's late. I'm tired.\"\n\n\"You're always tired.\"\n\n\"I'm always tired.\"\n\nHe put his arm around her shoulders, the way he used to when he was sixteen and had just grown taller than her and wanted her to know it, and she let him, and they sat together in the cold blister and looked at the comet. His arm was warm and heavy and familiar. His hand, where it hung over her shoulder, was shaking, very slightly, with a small fine tremor, the kind of tremor that a man gets when he has been drinking for three days because he cannot stop seeing something.\n\nShe did not say anything about it. She sat there in her brother's arm and looked at the Lamp and thought, very clearly, _he's lying to me_, and then, because she was the tether-chief and that was what tether-chiefs did, she began to do the arithmetic.\n","wordCount":5398,"createdAt":1793093706956},{"id":"eTNR0TjcTwDZwqmuiusgA","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"KUeDnmR-PMrQG7-kIhydF","text":"The infirmary was the one place on the _Patience_ that was ever warm. Ekene kept it that way on purpose, cooking the heat exchangers past their rating and fiddling the logs, because, he said, sick people healed better warm and well people talked more truthfully; and it was true that you heard things in the infirmary at night that you did not hear anywhere else on the ship. It was a narrow white room with eight bunks, a dispensary cage, a surgical bay behind a curtain, and a single round port the size of a dinner plate that looked out along the hull toward Gall's limb. Ekene had hung a dried flower in a bag over the port. Nobody knew where he had got a flower.\n\nHe was sitting at the dispensary counter when she came in, writing up the day by the light of a single lamp. He looked up, and took off his reading lenses, and looked at her for a long moment without saying anything. Then he got up and came round the counter and put his arms round her, and she stood in them with her face against the stiff cotton of his coat and her fist in her pocket and did not cry, because she had not cried in nine years and was not about to start now in front of a dispensary cage.\n\n\"I heard it,\" he said into her hair. \"Half the ship was on the line channel. I heard you talking to her.\"\n\n\"I didn't do anything.\"\n\n\"You talked to her.\"\n\n\"I couldn't do anything, Ekene. The Gull's thruster was stripped. It's been stripped three weeks. I put in for the part three times.\" She let go of him and stepped back. \"I ran the line. That's what I did. I sat there and ran the dip and I listened to her go.\"\n\n\"If you'd stopped the dip—\"\n\n\"If I'd stopped the dip the line would have walked and we'd have lost Odile as well. And the Bucket. And the drum, maybe. And they'd have docked the whole crew for the load.\" She sat down on the end of the nearest bunk. \"That's the arithmetic. I did the arithmetic.\"\n\nEkene went back behind the counter and filled two cups from the urn and brought them over. It was the infirmary's tea, which was not tea at all but something he grew in a tray under the ultraviolet lamp in the surgical bay and dried and smoked, and which tasted like a wet fire. She drank it. He sat beside her on the bunk. He was fifty-two, eleven years older than she was, a big soft-spoken man with grey in his beard and the long patient hands of somebody who had spent his life doing small things carefully to people in pain. He had come to Corva on a medical contract six years ago, not bonded, which made him a strange thing on the _Patience_, a free man who could have left on any _Clement_. He had not left. Maren had asked him why, once, and he had said that he was a coward and the Combine's other postings were worse; and then, later, in the dark, that it was her.\n\n\"The factor,\" he said.\n\n\"You saw him?\"\n\n\"He came by. Before the hall. He wanted to see the infirmary.\" Ekene turned his cup round in his hands. \"He asked about our stock of painkillers. How many beds. Whether we had a cold store and what was in it. He was polite. He asked very good questions.\"\n\n\"What kind of questions?\"\n\n\"The kind an auditor asks. What things cost. What could be moved.\" He looked at her sideways. \"What do you think _changes_ means, Maren?\"\n\n\"I think the _Clement_'s eleven days early,\" Maren said. \"I think nobody sends a new factor to a skimmer that's making its numbers just to say hello.\" She drank the rest of her cup in one swallow, burning her throat. \"And I think somebody cut Lusine's line.\"\n\nShe took her fist out of her pocket and opened it.\n\nEkene looked at the clip for a long time. Then he took it from her palm, gently, the way he took everything, and turned it under the lamp, and found the stub of the gate spring and the bright clean face of the cut, two-thirds of the way through.\n\n\"A blade,\" he said.\n\n\"A fine one. Not a cutter. Cutters crush. That's a saw cut, or a knife that's been honed. Somebody took that spring two-thirds through, so it'd hold in calm and go in the first hard shock.\" She heard her own voice, very level, the tether-chief's voice. \"Every runner checks her clip at the lock. You snap it, you load it, you look at the gate. You don't look at the spring. Nobody looks at the spring.\"\n\n\"Who could do this?\"\n\n\"Anybody who could get to her harness. Anybody in the runners' lock, between her last check yesterday and the dip. Riggers. Runners. Dock crew. Wardens.\" She stopped. \"Me.\"\n\n\"Not you.\"\n\n\"No. Not me.\" She took the clip back. \"She said something on the way down. On four, so it's not on the log. She said she'd read a dispatch on the relay, something that came ahead of the _Clement_ on the beacon. She said it was about all of us. She said she'd told someone, and she shouldn't have.\"\n\n\"Told who?\"\n\n\"She didn't say. She went into the static.\" Maren closed her hand on the clip again. \"She said, _I don't think it was the clip._\"\n\nThey sat for a while without talking. Through the port, over Ekene's shoulder, she could see the long curve of the _Patience_'s hull lit by Gall-shine, rust-coloured, and beyond it the edge of Gall itself, and beyond that the black. It took her a moment to see what she was looking at. There was a smudge in the black, just above the planet's limb: a faint pale patch no bigger than a thumbprint, like a breath on glass, with the barest suggestion of a tail.\n\n\"There it is,\" said Ekene, following her eyes. \"Teska's comet.\"\n\n\"The Lamp.\"\n\n\"She says it takes the dead out.\"\n\n\"She says a lot of things.\" Maren stood up. She was very tired. She put the clip back in her pocket and felt its small weight there, against her hip, where her line knife hung on her coat. \"I'm going to find out who she told.\"\n\n\"Maren.\"\n\n\"What.\"\n\n\"Be careful who you ask,\" said Ekene.\n\n\n# Consolidation\n\n[\n  Place: #The Patience\n  Characters: @@Maren Tsolo @@Odile Arda\n  Items: ^Lusine's clip:@Maren Tsolo\n  When: 5 November 2391\n]\n\nThe runners lived aft of the drum, in a long low compartment the crew called the Shelf, where the bunks were stacked four high along both walls and the air came in through a single overworked fan that had been rattling since before any of them were born. Each runner had a bunk and a locker. When a runner went into Gall, the locker was emptied by the warden's office, and anything of value was sold against the account, and the rest went into the waste cycler. It had been three days. The warden's office had not got round to Lusine's yet. Maren had made sure of that, by giving Bram Kovač two dips' worth of overtime on the drum.\n\nOdile was sitting on her sister's bunk when Maren came in, with the locker open beside her and its contents laid out on the blanket in rows, as if for an inventory. A spare undersuit. A comb. A packet of the cheap dried fruit they sold in the Camp at Midwinter. A cloth bag of hair ties. A stack of letters from somebody in the Camp, tied with string. A small battered slate with a cracked screen. A carved wooden fish, no bigger than a thumb, very old.\n\n\"That was our mother's,\" Odile said, without looking up. \"The fish. She carved it. She used to carve things. She said she'd teach me but she didn't.\"\n\nMaren sat down on the bunk opposite. \"I'm sorry, Odile.\"\n\n\"You keep saying that.\"\n\n\"I keep meaning it.\"\n\nOdile picked up the fish and turned it over in her fingers. Her face was swollen and blotched and fierce, and she had not slept, by the look of her, since the dip; she had done her shifts anyway, both of them, on the line, at six kilometres, and run them clean, and Maren had watched her dot on the board and said nothing, because there was nothing to say to a runner who wanted to be on the line except _clamps on_.\n\n\"The warden came round,\" Odile said. \"Hale. Yesterday. With the form.\" She put the fish down in its place in the row. \"Said I'd got her account now. Said it was standard. Two hundred and eighty days, carried forward, at the standard rate. For her suit and her bottle and her beacon and the inspection on the crawler. He was very sorry.\"\n\n\"He's always very sorry.\"\n\n\"I said I'd pay it.\" Odile looked up at last. \"I said I'd pay it, Chief, because what else do you say? And he said that was very good of me and wrote it down. And then he said, was there anything of hers I'd found, any papers, any messages. For the inquiry.\" She was watching Maren's face. \"I said no. Because I hadn't looked yet.\"\n\n\"And now you have.\"\n\n\"And now I have.\"\n\nOdile reached under the pillow and brought out a strip of grey foil, the kind the relay printers used for hardcopy, folded small and soft with handling. She held it out.\n\n\"It was in her boot,\" she said. \"Her deck boot. The left one. Inside the liner, under the heel. She always kept her money there when we were kids, in case somebody went through her pockets. I knew where to look.\" Her mouth moved. \"Nobody else would.\"\n\nMaren unfolded the foil.\n\nIt was a relay transcript, printed in the cramped type the old relay printers used, and it had been printed by hand, one line at a time, as if somebody had been feeding the printer a little at a time so it wouldn't log a full job. It was headed with the Halloran-Vey wheel and a string of routing codes, and below the codes, a single block of text.\n\n_FROM: Combine Operations, Halloran. TO: Factor-designate A. QUIST, by beacon ahead of CLEMENT. SUBJECT: Consolidation of Corva Operation._\n\n_1. Corva Operation to close effective arrival of factor-designate. Operation no longer commercially viable following Sorrel price adjustment. Board resolution 2391/114 refers._\n\n_2. Skimmer PATIENCE to complete current season dips to maximise final load. Vessel to be decommissioned and scuttled in Gall at season end. Salvage value does not justify transit._\n\n_3. Skilled bonded (est. 300, PATIENCE complement) to be transferred with accounts aboard CLEMENT to Levy Office, Sorrel Station, for assignment under Combine-Levy labour agreement 2390/22. Transfer to be presented as relocation._\n\n_4. Kettle Camp installations and bonded accounts (est. 2,100 households) to remain in place. Supply to cease on departure of CLEMENT. Accounts to be offered at discount to secondary holders._\n\n_5. Factor to manage expectations. Contingency authority (Schedule H) confirmed. ADMONITION to follow as escort._\n\nMaren read it once, slowly, and then again. The fan rattled. Somewhere forward of the Shelf the drum was beginning its spin-up for the second dip, a long rising groan that came through the deck like a tide.\n\n\"What's the Levy,\" said Odile.\n\n\"The Levy Office is how the Combine rents bonded to the Sorrel lane forts,\" Maren said. Her own voice sounded strange to her. \"For the war. Diggers. Loaders. People to stand on gun-decks and fill sandbags with ice. They pay the Combine by the head. The Combine pays the bonded the standard rate against their account. Most of them never come back up the lane.\"\n\n\"And the Camp.\"\n\n\"_Supply to cease._\"\n\n\"What does that mean?\"\n\nMaren looked at her. Odile was nineteen. She had been born on Kettle, in the Camp, in the warrens of the third shaft, where her mother had carved fish and her father had died of the ice cough when she was two; she had never been anywhere else. She knew what supply meant. She was asking because she wanted somebody to say it so she would not have to.\n\n\"It means nobody's coming back,\" said Maren. \"It means the _Clement_ leaves and doesn't come again, and the Camp has what's in its tanks and its stores, and when that's gone, it's gone. The refinery runs on what the _Patience_ brings it, and the _Patience_ will be at the bottom of Gall. They'll have three months, maybe. Four, if they're careful. Then the air plant stops.\"\n\n\"Two thousand households.\"\n\n\"Twenty-one hundred.\"\n\n\"And then somebody buys their accounts,\" said Odile, very quietly. \"At a discount. Somebody buys the debts of dead people.\"\n\n\"Somebody always does.\"\n\nOdile put her face in her hands. She didn't cry. She sat there with her hands over her face and her shoulders very still, breathing, and after a while she said through her fingers, \"She told someone.\"\n\n\"She said so. On the line.\"\n\n\"She'd have told me. She told me everything. She didn't tell me this.\" Odile took her hands away. Her eyes were dry and terrible. \"She'd only not tell me if she was scared for me. If she'd told somebody else first and it had gone wrong. If she thought they'd—\" She stopped. \"Who'd she tell, Chief?\"\n\n\"I don't know.\"\n\n\"She'd have told someone she trusted. Someone she—\" Odile's mouth twisted. \"She was seeing somebody. The last couple of months. She wouldn't say who. She went all quiet and pleased about it, like when we were kids and she'd stolen something. I thought it was one of the dock boys.\"\n\n\"Was it?\"\n\n\"I don't know. She said—she said he was funny. She said he made her laugh in the lock.\" Odile looked at the rows of her sister's things on the blanket: the comb, the fruit, the fish. \"She said he was always in debt and he didn't care. She said it was restful.\"\n\nMaren's hands had gone very cold. She folded the foil up again along its old creases, small and soft, and held it.\n\n\"Keep this between us,\" she said. \"Not Hale. Not anyone. Not even the runners.\"\n\n\"Why?\"\n\n\"Because the last person who read it told somebody,\" said Maren, \"and she's in Gall.\"","wordCount":2420,"createdAt":1793093707667},{"id":"gkuXbBAuxEJQePlYmOxbZ","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"F6DSf6VLOavx87_UDZc5D","text":"The _Dray_ is not beautiful.\n\nTil will be the first to say it. She's a deep-salvage tug of the old Tarn pattern, built sixty years ago for hauling dead hulks off the Harrow and the other wreck-fields of the outer Reach, and she looks it: a squat, blunt, armoured wedge of a hull, scarred and patched and painted over so many times that nobody knows any more what colour she started, with a stubby drive cluster at the back, a long grapple-and-winch boom slung under her belly like a folded insect's leg, and a forward cabin so small that two people can only pass in it if one of them is asleep. She has a fusion core that runs hot and an air plant that runs cold and a winch that will haul a hundred kilometres of cable and has hauled most of it. She is slow. She is ugly. She cannot be killed. Til has tried.\n\nOz spends two days going over her from the drive cones to the forward lamps, while Til spends two days spending other people's money. They buy cable. They buy reaction mass. They buy air, eleven tanks of it, more air than the _Dray_ has carried at one time in her life; they buy ice-anchors and screw-pitons and a thermal lance and two new pressure suits, one of them small, which Til buys without saying anything and Oz watches her buy without saying anything either. They buy food. Cato Marchetti comes down to the dock twice to look things over and goes away again, courteous, attentive, saying almost nothing; on the second visit he brings four long crates of his own, sealed, and asks for them to go in the cargo bay, and Til opens one with Oz standing by, because it's her ship, and finds medical supplies, and closes it again.\n\n\"He didn't mind,\" says Oz, afterward. \"You opening it.\"\n\n\"No.\"\n\n\"He wanted you to.\"\n\n\"Yes,\" says Til.\n\nThey're in the cargo bay, on the night before departure, stowing the last of the cable. The bay's lit by work-lamps clipped to the ribs and smells of old grease and cold metal and the dust that gets into everything on Cinderhaven, fine grey dust from the ring's ore-mills that you can taste for a week after you leave. Oz is coiling cable on to a drum with his delicate hands, talking to himself in the old Roundsman cant his mother taught him, half prayer and half swearing.\n\n\"My mother's people came out of Corva,\" he says, unexpectedly.\n\nTil looks up from the anchors. \"You never said.\"\n\n\"You never asked. It was a long way back. Two hundred years and more. Before the lane went dark.\" He finishes the coil, ties it off. \"Dippers. They used to go down into the giant's air on ropes, she said, forty kilometres of rope, and scoop the weather up in a bucket. And when they died they gave them to the giant. Lowered them down on the rope and let them go. And they had the comet, and they had a saying about it. The Lamp takes the dead out and brings them back.\" He picks up the next coil. \"That's where we got it. The Roundsmen. All of it. The salt and the loops and the going-out. It's dipper stuff. It's from Corva.\"\n\n\"Then the Hoard's dipper stuff too.\"\n\n\"The Hoard's drunk stuff,\" says Oz. \"There's no Hoard. Dippers didn't have anything to hoard. They had debts.\" He tugs the cable. \"But it's funny. That we're going there. Back round.\"\n\n\"It's not funny. It's thirty thousand marks.\"\n\n\"That too.\"\n\nThe hatch at the forward end of the bay grinds open and lets in a slab of yellow dock light, and a figure in it with a bag over its shoulder.\n\nJuno has a grey house coat on over a rigger's undersuit, and a cheap pair of dock boots, and the bag, which is small and old and has belonged to someone else before her. She stops in the hatch. She looks at Oz, and at the cable, and at the work-lamps, and at the stained ribs of the hull, and finally at Til.\n\n\"Mother Szabo sent me,\" she says.\n\n\"I know.\"\n\n\"I'm to witness the recovery. And log the cargo. And report back to the house.\" She says it like something learned off a slate. \"I'm not crew. I'm not under your orders. Mother Szabo says if you put me to work I'm to log it and she'll bill you.\"\n\n\"That sounds like her.\"\n\n\"Where do I sleep?\"\n\n\"There's a bunk aft of the galley,\" Til says. \"It's the warm one. There's a new suit in the locker by it that ought to fit you. You'll need to try it before we go through the lane. Oz will check your seals.\"\n\nJuno looks at her for a long moment. Til waits for it, whatever it's going to be, and is ready for it, she thinks; she has had eleven years to get ready for it.\n\n\"Don't talk to me,\" says Juno Brask, quite politely. \"Unless it's about the job.\"\n\nShe goes past them down the bay toward the galley hatch, and Oz moves out of her way with his coil of cable, and she doesn't look at either of them; and then the galley hatch closes behind her and it's just the two of them in the work-light with the cable and the cold.\n\nOz goes back to his coiling. After a while he says, without looking up, \"She's got Mags's walk.\"\n\n\"I know.\"\n\n\"Tall, though. Taller than Mags. That's from the father, whoever he was.\"\n\n\"I know, Oz.\"\n\n\"She'll come round.\"\n\n\"She won't,\" says Til. \"And she shouldn't.\"\n\nThe client comes aboard at the first bell of the morning, an hour before the departure slot. Til has been expecting a sick old man in a chair. What comes up the ramp out of the dock's grey half-light is a coffin.\n\nIt's a medical cradle, she knows that; she's seen them before, on the Directorate's hospital ships, though never one this fine. It's a long, low, gleaming shell of white composite on a powered sled, with a clear canopy over the upper half and racks of quiet instruments along its sides, humming. Two dock porters walk it up the ramp, and Cato Marchetti walks behind it with a hand resting lightly on its rim, the way a man walks beside a horse. Under the canopy, propped on pillows, is Hollis Vey.\n\nHe is very thin. That's the first thing. He's a long man, and the illness has eaten everything from him but the length, so that he lies in his white shell like a heron in a nest, all bones and joints. His skin has the papery yellow-grey of the very sick. His hair is white and wispy and was once, you can see, thick and fair. He's seventy, perhaps, or a hard sixty. His eyes are pale blue, and wet, and completely alert, and they move over the _Dray_'s cargo bay, its ribs and its lamps and its drums of cable, with an expression that Til, after a moment, recognises as delight.\n\n\"Captain Brask,\" he says. His voice comes through a speaker grille in the cradle's rim, thin and dry and slightly delayed. \"Forgive me for not getting up.\"\n\n\"Mr Vey.\"\n\n\"This is a very ugly ship.\"\n\n\"Yes.\"\n\n\"Good.\" He smiles. His teeth are perfect and slightly too large for his face. \"Ugly ships last. My family built beautiful ones. You'll notice we haven't got any left.\" He turns his head on the pillow, with some effort, to look at her properly. \"Mother Szabo tells me you're the best deep-salvage captain on the Ring.\"\n\n\"Mother Szabo tells people what makes her money.\"\n\n\"Then we understand each other. She also tells me you've no wish to know my business, which I very much appreciate, and which I don't for a moment believe.\" The pale eyes are amused. \"We have a long way to go together, Captain. I'll tell you my business, when I've decided how much of it I can bear to say aloud. In the meantime, I would be grateful for a place to plug this thing in, and a window, if your ship runs to windows. I'd like to see it, when we get there.\"\n\n\"The Lamp?\"\n\n\"Corva,\" says Hollis Vey. \"All of it. My family hasn't seen it in five hundred years.\"\n\nThey undock at the second bell. Til takes the _Dray_ out herself, by hand, the way she always does, backing her off the dock on her manoeuvring jets with the yard-master swearing at her on the traffic channel for doing it by hand, and swings her round in the long shadow of the ring, and lights her drive. Cinderhaven falls away behind them, a great grey wheel turning slowly in the light of Tarn, with its docks and its chapels and its stone vaults full of paper. Ahead, two days off, is the Throat of the Corva lane.\n\nOz comes up into the cockpit as the ring shrinks. He leans on the back of her chair and looks at the rear display for a while without saying anything.\n\n\"Something just came off the ring behind us,\" he says. \"Dock Two. Big hull. Running quiet.\"\n\nTil looks. She knows the hull. Everybody on Cinderhaven knows the hull: a long black repossession cutter with a ram bow and four turrets, the house mark of a ledger and a pen painted small on her flank, the _Carrion Hymn_.\n\n\"Well,\" says Til. \"Mother's coming too.\"\n\n\n# The Throat\n\n## The raw lane\n\n[\n  Place: #The Dray\n  Characters: @@Til Brask @@Juno Brask @@Ozias Mbeki @@Hollis Vey @@Cato Marchetti\n  When: 10 April 2917\n]\n\nA lane is not a road. People who have never been through one think it is, and draw it on their charts as a line between two dots, and talk about _going down the Corva lane_ as if it were a corridor with a door at each end. Til has been through forty-one lanes in her life, some of them many times, and she has stopped trying to say what they are. The nearest she has come is this: a lane is a place where the dark has been folded, and a ship in it is a crease.\n\nAn anchored lane is a good crease. Somebody, a long time ago, built a station at each end of it that holds the fold flat, and as long as the anchors hold, a ship goes in at one end and comes out at the other with nothing worse than a headache and a strange taste in the mouth, like licking a battery. An unanchored lane is called raw. The fold moves. It ripples like a flag in a wind. Nobody knows what the wind is.\n\nThe Corva lane has been raw for longer than anybody alive has been alive, and for most of that time it was closed. Two years ago it opened again, the way a healed bone sometimes aches and opens, and nobody knows why that either.\n\n\"Shear coming,\" says Oz, from the engine space. \"Big one. Twelve seconds.\"\n\n\"I see it.\"\n\n\"You don't see it, you feel it. Hold on to something.\"\n\nTil holds on to the yoke. In the forward seat beside her Juno is strapped in tight, her new suit sealed and her helmet clipped to her shoulder, and she is holding on to both armrests with both gloved hands and staring straight ahead at the cockpit glass, where there is nothing to see. In a lane there is never anything to see. The glass shows a dim grey flicker, like the inside of an eyelid, and occasionally a long slow ripple of brighter grey crossing it from one side to the other, which is the fold moving, and which you learn very fast not to look at.\n\nThe shear hits.\n\nIt's like being kicked by the whole universe at once. The _Dray_ doesn't shake so much as change shape: for one long, sick, impossible moment Til can feel the cockpit getting longer, the yoke in her hands drawing out away from her like taffy, her own arms stretching to follow it; and then it snaps back, and every rivet in the old tug's hull screams at once, a high thin chorus like a choir of kettles, and something aft goes bang.\n\n\"Coolant,\" says Oz, quite calmly, on the intercom. \"Number two loop. That was the coupling.\"\n\n\"How bad?\"\n\n\"Bad enough that I'd like some help, please, Captain.\"\n\nTil looks at the board. The core temperature is climbing, not fast but steadily, a line going up at the angle of a cheap staircase. She can't leave the yoke. In a raw lane you never leave the yoke; the autopilot doesn't know what the fold is going to do any more than you do, and it doesn't have the sense to be frightened.\n\n\"Juno,\" she says.\n\nJuno doesn't move.\n\n\"Juno. I need you to go aft and help Oz.\"\n\n\"I'm not crew.\" Juno's voice is very small and very flat. She's still staring at the glass. \"Mother Szabo said—\"\n\n\"Mother Szabo isn't in a raw lane with a coolant leak. Mother Szabo is a day behind us in a much bigger ship with a much better engineer. If the core goes, it goes, and you go with it, and then she'll bill me.\" Til doesn't look at her. She keeps her eyes on the board and her hands on the yoke and her voice exactly the way it would be if she were asking for a cup of tea. \"Unstrap. Clip your helmet on. Go aft along the rail, hand over hand, don't let go of the rail for anything. Oz will tell you what to do. He's very good at telling people what to do.\"\n\n\"I am,\" says Oz on the intercom.\n\nJuno sits for another two seconds. Then she unstraps.\n\nTil doesn't watch her go. She hears her: the click of the harness, the clunk of the helmet seal, the scrape of boots on the deck, the hand-over-hand rattle of the rail. She hears the aft hatch cycle. She keeps her eyes on the board and her hands on the yoke and flies the _Dray_ through the dark that isn't dark, feeling for the fold the way you feel for a step in a black stairwell, and she listens to the intercom.\n\n\"There,\" Oz is saying. \"That clamp. No, the big one. Get both hands on it. Now push. Harder than that. Pretend it's me.\"\n\nA grunt.\n\n\"Good. Hold it there. Don't let go of it, whatever happens.\"\n\n\"It's hot.\"\n\n\"It's very hot. Your gloves are rated. Hold it. I'm going to put a sleeve on the coupling and it's going to take me forty seconds, and if you let go of that clamp in the next forty seconds the loop'll blow out past my hands and the core'll scram and we'll be sitting dead in a raw lane, so don't.\"\n\n\"I won't.\"\n\n\"Shear coming,\" says Til. \"Eight seconds.\"\n\n\"Wonderful,\" says Oz.\n\n\"Hold on to the clamp, Juno.\"\n\n\"I'm _holding on to the clamp_.\"\n\nThe second shear is worse than the first. The cockpit stretches and snaps and the kettles scream and the board flickers, and Til, flying, feels the fold go under the _Dray_ like a wave under a small boat, a long sickening rise and fall, and holds the yoke against it and does not breathe. Aft, on the intercom, she hears Juno shout something wordless and furious, and Oz swearing in the Roundsman cant, a long liquid stream of it, and then silence.\n\n\"Oz.\"\n\nNothing.\n\n\"Oz.\"\n\n\"Sleeve's on,\" says Oz. He sounds out of breath. \"Loop's holding. She held the clamp.\"\n\n\"Juno?\"\n\nA pause. Then Juno's voice, shaking, very young. \"I held the clamp.\"\n\n\"Good,\" says Til. \"That was good.\"\n\nShe keeps her eyes on the board. She doesn't let her voice change. She flies the _Dray_ on through the shifting dark for another nine hours, through four more shears, none of them as bad, and she never once takes her hands off the yoke. And at some point in the fifth hour, without either of them saying anything about it, Juno comes forward again and straps into the second seat and stays there, and when Til asks her to read off the core temperature every ten minutes, she does.\n\n## Corva\n\n[\n  Place: #The Throat\n  Characters: @@Til Brask @@Juno Brask @@Ozias Mbeki @@Hollis Vey @@Cato Marchetti\n  When: 12 April 2917\n]\n\nThey come out of the Corva lane on the twelfth of April at the fourth bell, ship's time, into a silence so complete that for a long moment Til thinks the board has failed.\n\nThe board hasn't failed. It's showing her exactly what's there. The glass has gone from grey to black, real black, star-black, with real stars in it, a great spilled field of them; and ahead and a little below, so close and so huge that her eye refuses it at first as a planet and reads it as a wall, there's Gall.\n\nShe has seen gas giants before. Every salvager has; the wreck-fields of the outer Reach are full of them, and the dead hulks always fall toward the big ones in the end. She has never seen one like this. Gall is close, the lane mouth hanging in the dark only a few hundred thousand kilometres off its trailing edge, and it fills a third of the sky: a vast striped curve of ochre and rust and old-bruise purple, banded like the grain in a slab of wood, with storms in the bands the size of worlds, turning. At its southern limb there's a white cap. Across its face, very small and very sharp, a moon throws a round black shadow. And above it, high on the left, laid across a quarter of the sky like a scarf thrown on a floor, is the Lamp.\n\nIt's enormous. That's what nobody tells you. In the Observatory's pictures it was a bright head and a long dim tail; out here it's a smear of pale green light as wide as Til's hand at arm's length, with a head that hurts to look at and a tail that goes on and on and on, splitting into two, three, four fainter streamers, fanning out across the stars until it's lost in them. It's so bright Gall's night side is faintly lit by it.\n\nNobody in the cockpit says anything for a while.\n\n\"Well,\" says Oz eventually, from the hatch. \"There it is.\"\n\nTil runs the board. She does it automatically, the way she would coming out of any lane: traffic, beacons, anchor station, comms. There's no traffic. There are no beacons. There's no anchor station where the anchor station should be, at the lane's mouth, only a faint scatter of radar returns drifting in a loose cloud, metal-sized, like the debris from something that once was there and isn't any more. Whatever held this throat open has been gone a long time. Comms are open on every band she's got, and every band is empty: hiss, and the low growling roar of Gall's radio belts, and under that nothing at all. No traffic control. No nav pings. No voices.\n\n\"Nobody home,\" says Juno quietly.\n\n\"Lanes go dark for a reason,\" says Til. \"Usually it's because nobody's left to keep them lit.\"\n\n\"It was a city once,\" says Oz. \"Kettle. My mother said. The ice moon. There was a city under the ice.\"\n\n\"Was or is?\"\n\n\"She didn't know. Nobody's been through in two hundred years and more. Nobody's said a word on the radio.\"\n\n\"Somebody'd say something,\" says Juno. \"If they were there. Wouldn't they? After two hundred years. If a ship came.\"\n\nNobody answers her.\n\nThe cradle is in the main cabin, aft of the cockpit, where there's room for it, clamped to the deck by its sled and plugged into the _Dray_'s power with a cable Oz rigged out of three adaptors and a prayer. When Til goes back, Hollis Vey is propped up on his pillows with the cradle's canopy slid back and his face turned to the cabin's only port. Cato Marchetti is sitting beside the cradle on a crate, very still, as he always is, with his hands on his knees.\n\nVey's face is wet.\n\nHe doesn't wipe it. He doesn't seem to know it's wet. He's looking at Gall, at the bruised bands and the white cap and the moon's small shadow crossing, and at the Lamp above it, and his face is a long thin yellowish wreck of a face with the tears running down it into the pillow, and he looks happier than Til has seen anybody look in years.\n\n\"Captain,\" he says. \"Look at it.\"\n\n\"I've looked.\"\n\n\"Five hundred years,\" says Hollis Vey. \"My family owned this. All of it. That planet. That moon. That sky.\" The thin voice through the speaker grille is shaking with something like laughter. \"Do you know, we never came? Not one of us. Not one Vey ever came to Corva. We owned it for sixty years and sent factors and took the money and never once came to look. And then we lost it, and spent five hundred years wondering how.\" He turns his head on the pillow. \"I'm the first Vey ever to see it. And the last. That's rather funny, isn't it?\"\n\n\"I wouldn't know, Mr Vey.\"\n\n\"No. You wouldn't.\" He smiles at her with his perfect too-large teeth. \"Sit down, Captain. I promised I'd tell you my business, when I could bear to. I can bear a little of it now.\"\n\nTil sits on the edge of the bunk across from him. Marchetti doesn't move. Through the hatch she can hear Juno and Oz in the cockpit talking in low voices; she can hear the _Dray_'s air plant coughing, the way it always coughs after a lane.\n\n\"My family's company was called Halloran-Vey,\" says Hollis. \"It was a combine of the old sort, in the old lanes, before the Concord swallowed it and before the Concord choked on it in its turn. It dug things out of places and sold them. Gas from giants. Ice from moons. Labour from people.\" He says it lightly. \"It held this system for sixty years. It ran a skimmer that dipped Gall for deuterium, and a camp of bonded workers on Kettle to refine what the skimmer brought up. And then, in twenty-three ninety-one, it lost it.\"\n\n\"Lost it how?\"\n\n\"That,\" says Hollis, \"is the question I've spent my life on. The records are very bad. The Combine had a habit, when something went wrong, of writing as little about it as possible. There's a register—a loss register, the Combine kept them for every operation—that says Corva was lost in that year, and that certain assets were not recovered. And then nothing. Two hundred and sixty years later the Concord came here to take it back, and the records of that are worse.\"\n\n\"Took it back from who?\"\n\n\"From whoever was here.\" He shrugs, a movement of one bony shoulder under the blanket. \"The Concord's archives are a midden. Half of them burned when it fell. I have spent a great deal of money buying the other half off the people who looted them, and they tell me almost nothing. That a fleet was sent. Whether it took anything back, or came back at all, they don't say.\" He looks back at the port, at the Lamp. \"And then, in the dock-houses of Tarn, this story. That the founders of Corva hid something on their comet. That it comes back.\"\n\n\"The Hoard.\"\n\n\"The Hoard.\" He smiles. \"You don't believe in it.\"\n\n\"I've bought two maps to it.\"\n\n\"So have I,\" says Hollis Vey. \"Eleven. All different. All forged.\" He closes his eyes for a moment, as if the talking has tired him. \"But my family lost something here, Captain. Something the register calls an asset not recovered. And the Lamp was in the sky the year they lost it. And it has come back only once since, and the Concord's fleet went to Corva that same year. And now it is coming back for the last time, because Gall is going to eat it.\" He opens his eyes. \"If you were me, and had three months to live, where would you look?\"\n\nTil doesn't answer. Beside her, very quietly, Cato Marchetti shifts his weight on the crate, the first movement she has seen him make.\n\n\"What's the asset?\" Til says. \"The one not recovered.\"\n\n\"The register doesn't say,\" says Hollis. \"It gives it a number. That's all.\"\n\nHe's lying. Til knows it the way she knows when a hull plate is about to go: by a change in the sound of things. It's not in his face, which is as open and amused and wrecked as before. It's in Marchetti, who has gone still again, still in a different way, the stillness of a man who has just heard his employer say something he was told not to say and is waiting to see whether anybody noticed.\n\n\"All right,\" says Til, and gets up. \"Get some rest, Mr Vey. We'll be at Gall in six days.\"\n\n[\n  Place: #The Dray\n  Characters: @@Til Brask @@Juno Brask\n  When: 13 April 2917\n]\n\nOn the second night out from the Throat, Til has the watch from the eighth bell to the twelfth, and Juno comes up at the ninth and sits in the second seat without being asked.\n\nShe doesn't say anything. She's in her undersuit and a borrowed jumper of Oz's that comes down to her knees, with her knees drawn up inside it and her arms round them, and she sits in the dark cockpit looking out at the Lamp. It's on their left now, high and enormous, and Gall is ahead and below, filling the lower glass with its slow bands. The _Dray_'s drive is running at a quarter, a low steady rumble aft. On the board, nothing moves.\n\nTil does the things you do on watch. She checks the core. She checks the air. She checks the course, which is a long falling curve toward Gall that will take them past the giant and use its gravity to swing them out to meet the Lamp's path; Oz's idea, an old dipper's trick he says his mother told him about. She checks the rear scope. Nothing behind them yet. She checks the comms. Hiss and the roar of the belts.\n\nAfter a long time, Juno says, \"Szabo says you cut her line.\"\n\nTil doesn't look round.\n\n\"On the Harrow,\" Juno says. \"My mother's line. She says when the hulk spun up and started dragging you both, you had a choice, and you cut her line to save yourself. She says that's why you went to the prison, after. For the job being illegal and for that.\" Her voice is very level. \"She says everybody on the Ring knows it.\"\n\n\"Everybody on the Ring knows a lot of things.\"\n\n\"Is it true?\"\n\nThe Lamp hangs in the glass. Til looks at it.\n\nThere are things she has said to herself about this moment, over eleven years. She has had a lot of time to say them: four years of it in the Directorate's yard at Cold Harbour, and seven since on the _Dray_, alone mostly, on long hauls. She has rehearsed what she would say if Juno ever asked. She had it worked out, at one point, very carefully. She can't remember any of it now.\n\n\"There was a hulk,\" she says. \"A big one. A Directorate ore carrier, dead forty years, out on the edge of the Harrow, where nobody's allowed to go. Your mother found it. She said there was a fortune in its tanks, and there was, if we could get it. It was a bad job. We knew it was a bad job. We went anyway, because we owed money, and because your mother never in her life saw a bad job she didn't want to go and look at.\" She stops. \"We got a line on to it. Both of us, on one line. And the hulk spun up. Something in its old stabilisers woke up, and it spun, and the line went round it, and it started winding us in.\"\n\nJuno says nothing.\n\n\"There was a knife,\" Til says. \"On the line. There's always a knife on the line. Whoever's nearest the hulk can cut. Your mother was nearest the hulk.\" She takes a breath. \"The line got cut. I came off and she didn't. The hulk took her in. I was picked up by a Directorate patrol eleven hours later with my air on red and they charged me with unlicensed salvage and I did four years in Cold Harbour.\" She looks at the board. \"And Szabo bought your mother's debts off the Harrow brokers and bought you with them, and you were six.\"\n\n\"Who cut the line?\"\n\n\"The line got cut, Juno.\"\n\n\"Who cut it?\"\n\nTil is silent.\n\n\"You won't say,\" says Juno.\n\n\"I've said what I've got to say.\"\n\n\"You've said _the line got cut_.\" Juno's voice is shaking now, just slightly, just at the edge. \"You've said it like it was weather. Like it just happened. Like nobody did it.\" She uncurls her legs and puts her feet on the deck. \"I was six. I waited for her at the dock for two days. Mother Szabo came and got me and said she'd gone round and she wasn't coming back, and said my aunt had cut the line. And then you came out of the prison and you never once came to see me. Not once. In seven years. You'd walk past the counting-house window. I saw you. I used to watch for you.\"\n\n\"I know.\"\n\n\"Then why?\"\n\nTil looks at her at last. In the dark of the cockpit, lit only by the board and the Lamp, Juno's face is her mother's face exactly, broad and stubborn and furious, with the straight black brows drawn down.\n\n\"Because you'd have asked me that,\" Til says. \"And I'd have said what I just said.\"\n\nJuno stares at her. Then she gets up, and goes out of the cockpit, and down the passage to the warm bunk aft of the galley, and Til hears the bunk curtain rattle shut.\n\nShe sits in the dark with the board.\n\nAt the eleventh bell the rear scope pings. Til looks. Far behind them, back at the Throat, where the lane's mouth is a faint distortion in the stars, something has come out of the fold: a long black hull with a ram bow, running dark, decelerating hard. She doesn't need the transponder. She knows the shape.\n\n\"Hello, Mother,\" she says to the glass.\n\nShe logs it, and turns back to the forward board, and that's when she sees the other thing.\n\nIt's very small. It's almost nothing. A single pulse on the radar warning, a bright green flick in the corner of the board, there and gone in half a second: somebody, somewhere ahead, has painted the _Dray_ with a ranging radar. One sweep. Then nothing. The warning light goes back to dark.\n\nTil sits very still.\n\nShe runs the bearing. It's ahead and a little below, toward Gall. Toward the small white moon whose shadow she has been watching cross the giant's face for two days: a cracked white ball, very bright against the bands, that Oz's mother called Kettle.\n\nShe watches the board for the rest of her watch. The pulse doesn't come again. Comms stay empty, hiss and the roar of the belts. Nobody calls. Nobody says a word.\n\nIt could be automatic. Old systems run for a long time. A radar left on in some dead station under the ice, sweeping the sky for two centuries out of habit, the way a dead man's heart sometimes twitches on a slab.\n\nWhen Oz comes up at the twelfth bell to relieve her, she tells him about the _Carrion Hymn_. She doesn't tell him about the pulse. She isn't sure why. She lies in her bunk afterward with her eyes open in the dark and thinks about it: one sweep, from a moon where nobody has said a word in two hundred years. One look.\n\nAs if somebody down there had raised their head, and seen them, and put it down again.\n","wordCount":5427,"createdAt":1793108732998},{"id":"hWEsCTkrQXJLCEhHvOJVm","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"F6DSf6VLOavx87_UDZc5D","text":"The _Dray_ is not beautiful.\n\nTil will be the first to say it. She's a deep-salvage tug of the old Tarn pattern, built sixty years ago for hauling dead hulks off the Harrow and the other wreck-fields of the outer Reach, and she looks it: a squat, blunt, armoured wedge of a hull, scarred and patched and painted over so many times that nobody knows any more what colour she started, with a stubby drive cluster at the back, a long grapple-and-winch boom slung under her belly like a folded insect's leg, and a forward cabin so small that two people can only pass in it if one of them is asleep. She has a fusion core that runs hot and an air plant that runs cold and a winch that will haul a hundred kilometres of cable and has hauled most of it. She is slow. She is ugly. She cannot be killed. Til has tried.\n\nOz spends two days going over her from the drive cones to the forward lamps, while Til spends two days spending other people's money. They buy cable. They buy reaction mass. They buy air, eleven tanks of it, more air than the _Dray_ has carried at one time in her life; they buy ice-anchors and screw-pitons and a thermal lance and two new pressure suits, one of them small, which Til buys without saying anything and Oz watches her buy without saying anything either. They buy food. Cato Marchetti comes down to the dock twice to look things over and goes away again, courteous, attentive, saying almost nothing; on the second visit he brings four long crates of his own, sealed, and asks for them to go in the cargo bay, and Til opens one with Oz standing by, because it's her ship, and finds medical supplies, and closes it again.\n\n\"He didn't mind,\" says Oz, afterward. \"You opening it.\"\n\n\"No.\"\n\n\"He wanted you to.\"\n\n\"Yes,\" says Til.\n\nThey're in the cargo bay, on the night before departure, stowing the last of the cable. The bay's lit by work-lamps clipped to the ribs and smells of old grease and cold metal and the dust that gets into everything on Cinderhaven, fine grey dust from the ring's ore-mills that you can taste for a week after you leave. Oz is coiling cable on to a drum with his delicate hands, talking to himself in the old Roundsman cant his mother taught him, half prayer and half swearing.\n\n\"My mother's people came out of Corva,\" he says, unexpectedly.\n\nTil looks up from the anchors. \"You never said.\"\n\n\"You never asked. It was a long way back. Two hundred years and more. Before the lane went dark.\" He finishes the coil, ties it off. \"Dippers. They used to go down into the giant's air on ropes, she said, forty kilometres of rope, and scoop the weather up in a bucket. And when they died they gave them to the giant. Lowered them down on the rope and let them go. And they had the comet, and they had a saying about it. The Lamp takes the dead out and brings them back.\" He picks up the next coil. \"That's where we got it. The Roundsmen. All of it. The salt and the loops and the going-out. It's dipper stuff. It's from Corva.\"\n\n\"Then the Hoard's dipper stuff too.\"\n\n\"The Hoard's drunk stuff,\" says Oz. \"There's no Hoard. Dippers didn't have anything to hoard. They had debts.\" He tugs the cable. \"But it's funny. That we're going there. Back round.\"\n\n\"It's not funny. It's thirty thousand marks.\"\n\n\"That too.\"\n\nThe hatch at the forward end of the bay grinds open and lets in a slab of yellow dock light, and a figure in it with a bag over its shoulder.\n\nJuno has a grey house coat on over a rigger's undersuit, and a cheap pair of dock boots, and the bag, which is small and old and has belonged to someone else before her. She stops in the hatch. She looks at Oz, and at the cable, and at the work-lamps, and at the stained ribs of the hull, and finally at Til.\n\n\"Mother Szabo sent me,\" she says.\n\n\"I know.\"\n\n\"I'm to witness the recovery. And log the cargo. And report back to the house.\" She says it like something learned off a slate. \"I'm not crew. I'm not under your orders. Mother Szabo says if you put me to work I'm to log it and she'll bill you.\"\n\n\"That sounds like her.\"\n\n\"Where do I sleep?\"\n\n\"There's a bunk aft of the galley,\" Til says. \"It's the warm one. There's a new suit in the locker by it that ought to fit you. You'll need to try it before we go through the lane. Oz will check your seals.\"\n\nJuno looks at her for a long moment. Til waits for it, whatever it's going to be, and is ready for it, she thinks; she has had eleven years to get ready for it.\n\n\"Don't talk to me,\" says Juno Brask, quite politely. \"Unless it's about the job.\"\n\nShe goes past them down the bay toward the galley hatch, and Oz moves out of her way with his coil of cable, and she doesn't look at either of them; and then the galley hatch closes behind her and it's just the two of them in the work-light with the cable and the cold.\n\nOz goes back to his coiling. After a while he says, without looking up, \"She's got Mags's walk.\"\n\n\"I know.\"\n\n\"Tall, though. Taller than Mags. That's from the father, whoever he was.\"\n\n\"I know, Oz.\"\n\n\"She'll come round.\"\n\n\"She won't,\" says Til. \"And she shouldn't.\"\n\nThe client comes aboard at the first bell of the morning, an hour before the departure slot. Til has been expecting a sick old man in a chair. What comes up the ramp out of the dock's grey half-light is a coffin.\n\nIt's a medical cradle, she knows that; she's seen them before, on the Directorate's hospital ships, though never one this fine. It's a long, low, gleaming shell of white composite on a powered sled, with a clear canopy over the upper half and racks of quiet instruments along its sides, humming. Two dock porters walk it up the ramp, and Cato Marchetti walks behind it with a hand resting lightly on its rim, the way a man walks beside a horse. Under the canopy, propped on pillows, is Hollis Vey.\n\nHe is very thin. That's the first thing. He's a long man, and the illness has eaten everything from him but the length, so that he lies in his white shell like a heron in a nest, all bones and joints. His skin has the papery yellow-grey of the very sick. His hair is white and wispy and was once, you can see, thick and fair. He's seventy, perhaps, or a hard sixty. His eyes are pale blue, and wet, and completely alert, and they move over the _Dray_'s cargo bay, its ribs and its lamps and its drums of cable, with an expression that Til, after a moment, recognises as delight.\n\n\"Captain Brask,\" he says. His voice comes through a speaker grille in the cradle's rim, thin and dry and slightly delayed. \"Forgive me for not getting up.\"\n\n\"Mr Vey.\"\n\n\"This is a very ugly ship.\"\n\n\"Yes.\"\n\n\"Good.\" He smiles. His teeth are perfect and slightly too large for his face. \"Ugly ships last. My family built beautiful ones. You'll notice we haven't got any left.\" He turns his head on the pillow, with some effort, to look at her properly. \"Mother Szabo tells me you're the best deep-salvage captain on the Ring.\"\n\n\"Mother Szabo tells people what makes her money.\"\n\n\"Then we understand each other. She also tells me you've no wish to know my business, which I very much appreciate, and which I don't for a moment believe.\" The pale eyes are amused. \"We have a long way to go together, Captain. I'll tell you my business, when I've decided how much of it I can bear to say aloud. In the meantime, I would be grateful for a place to plug this thing in, and a window, if your ship runs to windows. I'd like to see it, when we get there.\"\n\n\"The Lamp?\"\n\n\"Corva,\" says Hollis Vey. \"All of it. My family hasn't seen it in five hundred years.\"\n\nThey undock at the second bell. Til takes the _Dray_ out herself, by hand, the way she always does, backing her off the dock on her manoeuvring jets with the yard-master swearing at her on the traffic channel for doing it by hand, and swings her round in the long shadow of the ring, and lights her drive. Cinderhaven falls away behind them, a great grey wheel turning slowly in the light of Tarn, with its docks and its chapels and its stone vaults full of paper. Ahead, two days off, is the Throat of the Corva lane.\n\nOz comes up into the cockpit as the ring shrinks. He leans on the back of her chair and looks at the rear display for a while without saying anything.\n\n\"Something just came off the ring behind us,\" he says. \"Dock Two. Big hull. Running quiet.\"\n\nTil looks. She knows the hull. Everybody on Cinderhaven knows the hull: a long black repossession cutter with a ram bow and four turrets, the house mark of a ledger and a pen painted small on her flank, the _Carrion Hymn_.\n\n\"Well,\" says Til. \"Mother's coming too.\"\n\n\n# The Throat\n\n[\n  Place: #The Dray\n  Characters: @@Til Brask @@Juno Brask @@Ozias Mbeki @@Hollis Vey @@Cato Marchetti\n  When: 10 April 2917\n]\n\nA lane is not a road. People who have never been through one think it is, and draw it on their charts as a line between two dots, and talk about _going down the Corva lane_ as if it were a corridor with a door at each end. Til has been through forty-one lanes in her life, some of them many times, and she has stopped trying to say what they are. The nearest she has come is this: a lane is a place where the dark has been folded, and a ship in it is a crease.\n\nAn anchored lane is a good crease. Somebody, a long time ago, built a station at each end of it that holds the fold flat, and as long as the anchors hold, a ship goes in at one end and comes out at the other with nothing worse than a headache and a strange taste in the mouth, like licking a battery. An unanchored lane is called raw. The fold moves. It ripples like a flag in a wind. Nobody knows what the wind is.\n\nThe Corva lane has been raw for longer than anybody alive has been alive, and for most of that time it was closed. Two years ago it opened again, the way a healed bone sometimes aches and opens, and nobody knows why that either.\n\n\"Shear coming,\" says Oz, from the engine space. \"Big one. Twelve seconds.\"\n\n\"I see it.\"\n\n\"You don't see it, you feel it. Hold on to something.\"\n\nTil holds on to the yoke. In the forward seat beside her Juno is strapped in tight, her new suit sealed and her helmet clipped to her shoulder, and she is holding on to both armrests with both gloved hands and staring straight ahead at the cockpit glass, where there is nothing to see. In a lane there is never anything to see. The glass shows a dim grey flicker, like the inside of an eyelid, and occasionally a long slow ripple of brighter grey crossing it from one side to the other, which is the fold moving, and which you learn very fast not to look at.\n\nThe shear hits.\n\nIt's like being kicked by the whole universe at once. The _Dray_ doesn't shake so much as change shape: for one long, sick, impossible moment Til can feel the cockpit getting longer, the yoke in her hands drawing out away from her like taffy, her own arms stretching to follow it; and then it snaps back, and every rivet in the old tug's hull screams at once, a high thin chorus like a choir of kettles, and something aft goes bang.\n\n\"Coolant,\" says Oz, quite calmly, on the intercom. \"Number two loop. That was the coupling.\"\n\n\"How bad?\"\n\n\"Bad enough that I'd like some help, please, Captain.\"\n\nTil looks at the board. The core temperature is climbing, not fast but steadily, a line going up at the angle of a cheap staircase. She can't leave the yoke. In a raw lane you never leave the yoke; the autopilot doesn't know what the fold is going to do any more than you do, and it doesn't have the sense to be frightened.\n\n\"Juno,\" she says.\n\nJuno doesn't move.\n\n\"Juno. I need you to go aft and help Oz.\"\n\n\"I'm not crew.\" Juno's voice is very small and very flat. She's still staring at the glass. \"Mother Szabo said—\"\n\n\"Mother Szabo isn't in a raw lane with a coolant leak. Mother Szabo is a day behind us in a much bigger ship with a much better engineer. If the core goes, it goes, and you go with it, and then she'll bill me.\" Til doesn't look at her. She keeps her eyes on the board and her hands on the yoke and her voice exactly the way it would be if she were asking for a cup of tea. \"Unstrap. Clip your helmet on. Go aft along the rail, hand over hand, don't let go of the rail for anything. Oz will tell you what to do. He's very good at telling people what to do.\"\n\n\"I am,\" says Oz on the intercom.\n\nJuno sits for another two seconds. Then she unstraps.\n\nTil doesn't watch her go. She hears her: the click of the harness, the clunk of the helmet seal, the scrape of boots on the deck, the hand-over-hand rattle of the rail. She hears the aft hatch cycle. She keeps her eyes on the board and her hands on the yoke and flies the _Dray_ through the dark that isn't dark, feeling for the fold the way you feel for a step in a black stairwell, and she listens to the intercom.\n\n\"There,\" Oz is saying. \"That clamp. No, the big one. Get both hands on it. Now push. Harder than that. Pretend it's me.\"\n\nA grunt.\n\n\"Good. Hold it there. Don't let go of it, whatever happens.\"\n\n\"It's hot.\"\n\n\"It's very hot. Your gloves are rated. Hold it. I'm going to put a sleeve on the coupling and it's going to take me forty seconds, and if you let go of that clamp in the next forty seconds the loop'll blow out past my hands and the core'll scram and we'll be sitting dead in a raw lane, so don't.\"\n\n\"I won't.\"\n\n\"Shear coming,\" says Til. \"Eight seconds.\"\n\n\"Wonderful,\" says Oz.\n\n\"Hold on to the clamp, Juno.\"\n\n\"I'm _holding on to the clamp_.\"\n\nThe second shear is worse than the first. The cockpit stretches and snaps and the kettles scream and the board flickers, and Til, flying, feels the fold go under the _Dray_ like a wave under a small boat, a long sickening rise and fall, and holds the yoke against it and does not breathe. Aft, on the intercom, she hears Juno shout something wordless and furious, and Oz swearing in the Roundsman cant, a long liquid stream of it, and then silence.\n\n\"Oz.\"\n\nNothing.\n\n\"Oz.\"\n\n\"Sleeve's on,\" says Oz. He sounds out of breath. \"Loop's holding. She held the clamp.\"\n\n\"Juno?\"\n\nA pause. Then Juno's voice, shaking, very young. \"I held the clamp.\"\n\n\"Good,\" says Til. \"That was good.\"\n\nShe keeps her eyes on the board. She doesn't let her voice change. She flies the _Dray_ on through the shifting dark for another nine hours, through four more shears, none of them as bad, and she never once takes her hands off the yoke. And at some point in the fifth hour, without either of them saying anything about it, Juno comes forward again and straps into the second seat and stays there, and when Til asks her to read off the core temperature every ten minutes, she does.","wordCount":2739,"createdAt":1793108733409},{"id":"hs84_Y7Mr5llMexwxLJOU","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"pCAUFmAksTJpzvZJ8CLyF","text":"I don't get to the Archive that night. At the eighth bell, as I'm coming off shift, the city's guns open up for the first time in the siege.\n\nI didn't know we had guns. I don't think most people did. There are batteries, it turns out, in old pits on the surface ice around the city, built a hundred years ago in some war scare that never came to anything and maintained ever since by a few dozen shared families who have the right to do it the way other shared families have the right to the dipper fleet. They've waited eighteen days. Now, all at once, they fire, and the whole city hears them: a sound like heavy doors being slammed, very fast, one after another, coming down through the ice.\n\nEverybody stops in the corridors and looks up.\n\nThe word comes down the speakers a few minutes later, crackling and excited. A Concord lander has come down low over the south ice, probing, the first time any of Grieve's ships has come close enough to touch, and the batteries have hit it. It's down. It's on the ice south of the city, a kilometre from South Lock. All damage-control parties to South Lock. All air-wardens with surface rating to South Lock.\n\nI have surface rating. All wardens do; we read the meters on the intakes. I go.\n\nSouth Lock is a vast old chamber cut in the ice at the bottom of a sloping ramp, with the surface doors at its top end and a long low gallery down one side where the suits hang on their racks like a row of hanged men. When I get there it's already full of people. Damage-control crews in orange. Wardens in grey. Militia in their blue armbands with their old rifles. And riggers, a lot of riggers, the big tattooed men and women of the dipper fleet, who've been grounded eighteen days by the Council's order and have nothing to do and are in the mood for something to do it to.\n\nThe doors are open when I get there. The lock's cycled. A team in surface suits has gone out across the ice on a crawler and is coming back, and on the big screen over the gallery we can all see the feed from the crawler's lamps: white ice, black sky, Gall's banded edge on the horizon, and a long smear of wreckage going away across the snow, burning green and orange where its fuel has caught. In the middle of the wreckage, something moving.\n\n\"There's one alive,\" someone says.\n\n\"Not for long.\"\n\nThe crawler comes back down the ramp with the outer doors grinding shut behind it, ice streaming off its tracks. The lock cycles. When the inner doors open, the crowd surges forward, and I'm pushed forward with it, and I see the damage-control crew climbing down off the crawler's bed with a body between them in a scorched white Concord pressure suit.\n\nThey put it down on the floor of the lock. The suit's helmet is cracked across the visor. There's frost on the inside of the crack. The figure inside it moves its hands, weakly, at the clasps of the helmet, as if it wants to get it off.\n\n\"Leave it,\" says somebody. \"It's on its own air.\"\n\n\"Its air's gone,\" says one of the damage-control crew, a woman with a burned face, crouching by the helmet. \"Tank's holed. It's breathing what's left in the suit.\" She looks up. \"Maybe ten minutes.\"\n\n\"Then leave it ten minutes,\" says a rigger at the front of the crowd, a huge man with comet-tails tattooed up both forearms, and there's a growl of agreement behind him. \"Let it breathe what's left. That's what they're doing to us.\"\n\n\"Put it out on the ice.\"\n\n\"Let it have the floor.\"\n\nThat gets a laugh, an ugly one. It goes round the lock like a wave. _Let it have the floor._ The Concord pilot's hands have stopped moving at the clasps. They lie on its chest. Through the cracked visor I can see a face, very young, very pale, with its eyes open, looking up at all of us.\n\nI'm not brave. I want to say that clearly, as I said the other thing clearly before. What I do next isn't brave. It's habit. I'm an air-warden. I have spent twelve years kneeling beside meters, and what I'm looking at is a meter reading red.\n\nI push through to the front, and kneel down beside the burned-faced woman, and take the spare bottle off my own belt. Every warden carries a spare, a little twenty-minute flask with a universal coupling, for when we're out on the intakes. I find the suit's emergency port under the left armpit, where every suit in eleven lanes has had it since before the founding, and I knock the frost off it with my glove and screw the coupling in, and open the valve.\n\nThe suit hisses. The frost on the inside of the visor starts, very slowly, to clear.\n\n\"What are you doing?\" says the tattooed rigger.\n\n\"Reading a meter,\" I say.\n\nThere is a silence in the lock. I can feel it on the back of my neck, a hundred people looking at me. I don't look round. I watch the frost clear on the visor, and the young pale face behind it blink, and its lips move.\n\n\"Warden,\" says the rigger, in a voice I don't like.\n\n\"It's my air,\" I say. \"It's on my account. If you want to take it off me, you'll have to take it off me.\"\n\nNobody moves. I don't know what would have happened next. I don't know, to this day, whether they would have; I think perhaps they would. But the militia have got to the front by then, three of them with rifles and blue armbands and an officer with a whistle, and the officer is shouting that the prisoner is the property of the Council and anybody who lays a hand on him will be on the floor for a year. The crowd backs off, growling. The burned-faced woman helps me get the cracked helmet off. Underneath it the pilot is a man, young, younger than me, with a soldier's cropped fair hair and a soldier's frightened eyes, and a smear of blood under his nose.\n\nHe looks at me. He breathes. It's the first thing I ever hear him do.\n\n\"Thank you,\" he says, in the clipped accent of the inner lanes.\n\n\"Don't,\" I say. \"It's on your account.\"\n\nThe militia take him. They lift him on to a stretcher and carry him up the ramp toward the inner city, and the officer with the whistle tells me to report to the Wardens' Office in the morning with my bottle receipt, and goes after them. The crowd breaks up, slowly, sullenly, back to whatever it was doing. The tattooed rigger stands looking at me a while longer and then goes. I'm left kneeling on the wet ice floor of the lock with my empty bottle in my hand.\n\nSomebody crouches down beside me. A woman, a rigger, forty-odd, small and wiry, with her sleeves rolled up over forearms tattooed from wrist to elbow with the long thin fans of comets, one inside another, like the rings in a tree.\n\n\"You gave him your air, warden,\" she says.\n\n\"I gave him a bottle.\"\n\n\"That's a first.\" She looks at me with a sort of amused curiosity, as if I were a dog that had started to talk. \"Twelve years I've lived on the Ninth North and I never once saw a warden give anybody air.\"\n\n\"It's not a warden's job to give air.\"\n\n\"No,\" she agrees. \"It's not.\" She stands up and dusts off her knees. \"I'm Dasha. Dasha Imre. Rigger. Grounded.\" She holds out her hand to pull me up. \"You want to be careful, warden. Giving people things. It gets to be a habit.\"\n\nI let her pull me up. \"Isaura,\" I say. \"Venn.\"\n\n\"I know who you are,\" says Dasha Imre. \"Everybody on the Ninth knows who you are.\" She grins, quite friendly. \"That's why it's a first.\"\n\nWhen I get back to my room on the Fourth it's past the tenth bell, and there's a message waiting on my wrist. It's from the Archive. It's very short, in Malachy's old-fashioned way, the way he used to write notes in the margins of my exercises when I was ten.\n\n_Isaura. There's writing under the paint. Come tomorrow. Come alone. M._\n\n\n# Ephemeris\n\n## Under the paint\n\n[\n  Place: #The Archive\n  Characters: @@Isaura Venn @@Malachy Orr\n  Items: ^The Share Plate:#The Archive\n  When: 1 July 2654\n]\n\nThe Archive is the Spine's old cargo deck, four levels down from the nave, and it smells the way I imagine the inside of a very old person's head smells: of dust, and paper, and cold, and something sweetish and faint like rot. There's no proper light. There never has been. Malachy works by lamps, a dozen of them on long arms clamped to his tables, so that the Archive is a great dark cave with little islands of yellow in it, and on every island, books, slates, rolled charts, folders of foil, ledgers bound in plastic gone brown, the whole two hundred and sixty years of Patience written down by people who mostly never expected anyone to read it.\n\nHe has the Plate on his biggest table, under three lamps, face down.\n\n\"Close the door,\" he says, when I come in. \"And lock it. There's a bar.\"\n\nI bar the door. When I turn round he's bending over the table with a magnifier strapped round his head on a leather band, like a jeweller, and a tiny brush in one hand and a dish of something in the other that smells sharp enough to make my eyes water.\n\n\"Solvent,\" he says, without looking up. \"Old dock solvent. The kind they used to strip hull paint, back when we had hulls to strip. There's a drum of it in the bottom store that's been there since my grandfather's time. It does the job, slowly. Too fast and it would take the scratches with it.\" He dabs the brush, very lightly, and wipes. \"Come and look. Don't breathe on it.\"\n\nI come and look.\n\nHe's cleaned a patch in the top corner of the Plate's back, no bigger than my palm. Inside it, the grey sealant is gone, and the steel underneath is dark and dull and pitted with age, and across it, cut into the metal, there are marks. Not deep. Scratched, rather than cut: thin uncertain lines, as if made with a point dragged slowly and hard, by somebody pressing with all their weight. They're figures. Numbers. A column of them, and beside the column, letters, single letters, like labels.\n\n\"Somebody scratched these with an awl,\" says Malachy. \"A rigger's scribe, probably. The kind they used for marking cable. You can see where the point skidded.\" He touches the air above a line with the end of his brush. \"Look at the sevens. They cross their sevens. Nobody's crossed a seven in this city for two hundred years.\"\n\n\"What are they?\"\n\n\"Numbers.\"\n\n\"Malachy.\"\n\n\"I don't know yet.\" He straightens up, with a little grunt, and pushes the magnifier up on to his forehead, where it sits like a third eye. \"I've done this much in a night. There's the whole back of the Plate still under paint, and the paint's harder in the middle, where it was thicker. A week. Two.\" He looks at me. \"I need you to keep this to yourself, Isaura.\"\n\n\"Who would I tell?\"\n\n\"Your mother. Your section chief. That rigger woman from South Lock who's been asking about you on the Ninth.\" He sees my face and smiles thinly. \"I hear things. I'm an archivist. Hearing things is most of the job.\"\n\n\"Why does it matter? It's numbers on the back of a plate.\"\n\n\"It matters,\" says Malachy, \"because somebody went to a great deal of trouble to put them there, and then went to a great deal more trouble to make sure nobody could see them.\" He lays the brush down across the dish. \"Think about it. This is the Share Plate. It's the first thing the founders made. It's been hanging in the nave since before there was a nave. Every child in Patience has stood in front of it. And somebody, two hundred and sixty years ago, took it down and cut something into the back of it with an awl, and then painted over it with hull sealant, carefully, edge to edge, so that it would look like nothing but the back of a piece of steel. And hung it up again.\" He spreads his old spotted hands. \"You don't do that with a shopping list.\"\n\n\"Then why not throw it away? If they didn't want it read.\"\n\n\"Because they did want it read.\" Malachy pulls the magnifier back down over his eye and bends to the Plate again. \"Eventually. Just not by whoever was standing in front of it at the time.\" He dabs with the brush. \"Those aren't the same thing, Isaura. Keeping a thing and hiding it. You'll find most of this room is one or the other. The trick is telling which.\"\n\n## The cells\n\n[\n  Place: #The Cells\n  Characters: @@Isaura Venn @@Mattias Ebb\n  Items: ^Isaura's gauge:@Isaura Venn\n  When: 10 July 2654\n]\n\nNine days after South Lock, the Wardens' Office takes me off the Ninth.\n\nI'm called in to see my section chief, a weary shared woman named Paske who has been running the South wardens since before I joined, and who looks at me across her desk with the expression of somebody who has been given a problem she didn't ask for. I'm not being disciplined, she says. Nobody's filed a complaint. The bottle's been paid for out of the Office budget; the militia were very grateful; there's even a commendation, which she pushes across the desk to me on a slip of foil. But there's been talk on the Ninth. About a warden giving away air to a Concord pilot while the Ninth's own children are on the floor. And there have been, Paske says delicately, incidents. A warden on the Ninth North had his ledger taken off him on the stairs and thrown down a shaft. Another had her valve key bent. It would be better for everybody, Paske says, if I were somewhere else for a while.\n\nSomewhere else is the Cells.\n\nThe Cells are under the Spine, below the Archive, below the old docks, in what was once the skimmer's keel: a long dim corridor of steel boxes, each with a door and a grille and a meter. In peacetime they hold drunks and thieves and the occasional unshared rioter. Now, eight days into July and twenty-eight days into the siege, they hold a few dozen of each and one Concord lieutenant. Somebody has to read the meters. That's me.\n\nIt's quiet work. It's almost restful, after the Ninth. The prisoners are on a fixed allowance set by the Council, a little above the old floor, and nobody pays tithe, so nobody falls into arrears, so nobody has to be cut. I walk the corridor twice a shift with my gauge and read each meter aloud into the ledger and check the seals on the doors, and the prisoners mostly ignore me. Some swear. One old man on the end, a tannery thief from the Fifth, asks me every shift whether the Lamp's still in the sky, and I tell him yes, and he says _good_, and turns over.\n\nThe lieutenant's cell is the eleventh.\n\n\"Ebb, Mattias,\" I say to my ledger, on the first morning, outside his grille. \"Concord Lane Service. Allowance three-twenty an hour. Draw this cycle, three-oh-five.\" I look through the grille. \"You're breathing light, Lieutenant.\"\n\nHe's sitting on his bunk with his back against the wall and his knees up, in a grey prison smock with the sleeves too short, his cropped fair hair grown out a little into a pale fuzz. The bruising on his face has gone yellow. He looks up when I speak, and I see him recognise me, and something complicated happens in his face.\n\n\"I was told to,\" he says. \"In training. _In captivity, conserve._ Every ration. Breathe slow, move slow, sleep a lot.\" He shrugs. \"I'm very good at sleeping.\"\n\n\"You don't have to conserve here. It's your allowance. It doesn't go back in the tank if you don't use it.\"\n\n\"Doesn't it?\"\n\n\"No. It's just wasted.\"\n\nHe thinks about this with a sort of grave interest. \"That's very inefficient.\"\n\n\"Welcome to Patience,\" I say, and go on to the twelfth.\n\nHe's there on the second day, and the third, and every day after, and after the third day we talk. Not much. A few minutes, across the grille, while I take the reading and check the seal. It isn't permitted, exactly. It isn't forbidden either; nobody's thought to forbid it, because nobody's imagined a warden would want to. I'm not sure I want to. But he's the only person in the city who knows less about it than I do, and there's a strange relief in that.\n\nHis name is Mattias. He's twenty-four. He comes from a world called Corran, three lanes in, an old Concord holding where everybody works in the canneries. His father owed the Concord a great deal of money for something to do with a fishing boat that sank, and when his father died the debt came down to Mattias, and the Concord, which is efficient, offered him the choice of the canneries for forty years or the Lane Service for twelve. He chose the Lane Service. He's done four years of the twelve. He flies landers. He was flying a lander over Kettle's south ice on the thirtieth of June, on a probe, because his captain wanted to see whether the city had any guns, and the city did.\n\n\"That's what it's like everywhere,\" he says, on the fifth day, when I tell him about the floor. \"The Concord. The tithe, the floor. They don't call it that. They call it _allocation_. But it's the same.\" He looks at me through the grille with his frightened soldier's eyes, which are, I've decided, not frightened at all, only very tired. \"You'd think you'd be different here. You threw the Company out. Didn't you? You bought your own air. That's what they told us in the briefings. _The occupiers claim to have purchased the claim._ And then you went and did the same thing to each other.\"\n\n\"We didn't do anything. I wasn't born.\"\n\n\"No. Nor was I.\" He leans his head back against the wall. \"Nobody's ever born when it happens. Have you noticed? It's always already happened.\"\n\nOn the sixth day he asks me why I gave him the bottle.\n\n\"It's my job,\" I say.\n\n\"It isn't, though. Is it? Your job's taking it away.\" He says it without any edge. \"The militia officer told me. On the stretcher, when he thought I couldn't hear. He said, _that's the warden from the Ninth, she's cut more air than the plague_. He was laughing.\"\n\nI look at the meter. Three-oh-eight.\n\n\"I don't know,\" I say, which is the truth.\n\n\"Well,\" says Mattias Ebb, after a while. \"Thank you anyway. Whatever it was.\"\n\n## Numbers\n\n[\n  Place: #The Archive\n  Characters: @@Isaura Venn @@Malachy Orr @@Lucan Strand\n  Items: ^The Share Plate:#The Archive\n  When: same day\n]\n\nThat afternoon Malachy sends for me again, and when I get to the Archive, the First Shareholder is there.\n\nHe's standing at the end of Malachy's big table with his hands behind his back, looking down at the Plate under its lamps, and he doesn't turn round when I come in. Two of his stewards wait by the door. Malachy, at the table, gives me a look over the top of his magnifier that I've known since I was eight years old, the look that means _say nothing, you'll only make it worse_.\n\nTen days of solvent have cleared a long strip down the left side of the Plate's back, about the width of my hand, from the top almost to the bottom. In the strip, the scratched figures go down in a column, with their letters beside them. Six lines. Below the six lines, a gap, and then more scratches, different, less regular, still half under the paint. The rest of the Plate is grey.\n\n\"Come in, warden,\" says Lucan Strand. \"The Archivist tells me you were the first to see this. When it fell.\"\n\n\"Yes, First Shareholder.\"\n\n\"And you've said nothing to anyone.\"\n\n\"No, First Shareholder.\"\n\n\"Good.\" He turns his head and looks at me, and smiles a little, his tired silver smile. \"Brother Malachy has been telling me what he thinks it is. I'd like you to hear it. Since you were there at the beginning.\" He nods to the old man. \"Go on, Brother.\"\n\nMalachy straightens up. He doesn't push the magnifier up this time; he takes it off altogether and lays it on the table, which with Malachy means that he's about to say something he's sure of.\n\n\"They're orbital elements,\" he says. \"Six of them. Semi-major axis, eccentricity, inclination, the longitude of the node, the argument of perihelion, and a time.\" He touches the air above each line with his brush. \"That's how dippers wrote down an orbit. They had to know about orbits to do their work, much better than we do; they lived in them. These are in the old dippers' notation, with the old dippers' units. Whoever scratched this knew exactly what they were doing.\"\n\n\"An orbit of what?\" says Strand.\n\n\"Something long,\" says Malachy. \"And very eccentric. Something that goes a very long way out and comes back.\" He purses his lips. \"I'd need to run the figures to be sure, and I can't run them yet. There's a time on the last line, the time of perihelion, and it's under a flaw in the steel. Somebody's awl slipped.\"\n\nStrand is quiet for a moment.\n\n\"And the rest?\" He nods at the half-cleared scratches below the gap. \"There's more. Writing?\"\n\n\"Letters, yes. Words, I think. I haven't got to them.\" Malachy picks up his magnifier again and turns it over in his fingers. \"Another week. Perhaps two. The paint's very hard in the middle.\"\n\n\"Faster, Brother.\"\n\n\"If I go faster I'll take the words off with the paint.\"\n\n\"Then don't go faster,\" says Strand mildly. \"But don't go slower.\" He comes round the end of the table and looks down at the strip of scratched figures for a long moment, and I see his face in the lamplight and I see something in it I've never seen in it before: not the warmth he wears in the nave or the patience he wears on the speakers, but hunger, plain and sharp, like a man looking at a meal.\n\n\"The founders wrote this,\" he says softly. \"On the Plate. And then they hid it.\"\n\n\"Somebody did,\" says Malachy.\n\n\"The founders,\" Strand says again, as if correcting him. He looks up. \"Do you know what reserve stood at this morning, Brother? Fifty-two days. Grieve's slugs took out the third intake on the far ice last night. Fifty-two. A month ago it was ninety-four.\" He's not raising his voice; he never raises his voice. \"The Council meets tomorrow. If the reserve falls below twenty days, we will have to consider measures. Measures nobody in this city wants to consider. Do you understand me?\"\n\n\"I understand you,\" says Malachy.\n\n\"Then you understand why I want to know what the founders thought was worth hiding.\" Strand straightens his coat. \"Nobody sees this but the three of us. Not the Council. Not my son. When you have the words, you send for me first. Before anyone.\" He turns to me. \"And you, warden. Not a word. Not to your mother. Not to the Ninth. If this city ever needed its founders, it needs them now, and I won't have them turned into a Lamper rumour on the stairs.\" He smiles. \"Do you understand?\"\n\n\"Yes, First Shareholder.\"\n\n\"Good,\" he says, and goes out with his stewards.\n\nWhen the door's barred behind him, Malachy sits down heavily on his stool and puts his face in his hands. He sits like that for a long time.\n\n\"_Measures_,\" he says at last, through his fingers.\n\n\"What measures?\"\n\nHe takes his hands away and looks at me. \"You've been a warden twelve years, Isaura,\" he says. \"You know what a city does when it runs short of air. You've done it on a small scale every day of your working life. Think about it on a large one.\"\n\nI think about it.\n\nI think about the floor, and the doors on the Ninth, and the grandmother under her three blankets with her hands folded. I think about a hundred and seventy thousand unshared and twelve thousand shared, and a reserve going down like a needle on a meter. And I understand what he means, all at once, the way you understand the cold when you step out of a lock, and I sit down too, on the bench by the door, and for a while neither of us says anything at all.\n\n[\n  Place: #The Cells\n  Characters: @@Isaura Venn @@Mattias Ebb\n  When: same day\n]\n\nOn the last round of my shift, at the tenth bell, I stop at the eleventh cell longer than I should.\n\nThe lieutenant's asleep, or pretending. He's lying on his back on the bunk with his arm over his eyes. I read his meter—three-one-nine, he's stopped conserving—and log it, and check the seal, and then I stand at the grille without moving on.\n\n\"You never told me,\" I say. \"Why you came.\"\n\nHe doesn't move his arm. \"I told you. I was flying a probe.\"\n\n\"Not you. The Concord. Thirty-eight ships, all the way out here to the end of the lanes, for a moon nobody's wanted in two hundred years. For a claim nobody's tried to collect since before your great-grandfather was born.\" The corridor's dim and cold and quiet, the tannery thief snoring at the far end. \"Grieve says the Concord holds the Combine's title. Fine. It's held it for a century. Why now?\"\n\nMattias lies still for a while. Then he takes his arm off his eyes and turns his head on the thin pillow and looks at me through the grille.\n\n\"For what's ours,\" he says. \"That's what they told us. _To recover the Concord's property._\"\n\n\"The city.\"\n\n\"The city. The claim. The accounts.\" He hesitates. \"And something else.\"\n\n\"What?\"\n\n\"I don't know.\" He sits up slowly, wincing at his ribs, and swings his feet down to the floor and sits on the edge of the bunk with his hands between his knees. \"I'm a lieutenant. They don't tell lieutenants things. But before we came through the Throat they briefed every lander crew in the fleet, all of us together, in the big bay on the _Steadfast_, and there was an officer from the Commodore's staff there, a commander I'd never seen before, and at the end of the briefing, after the guns and the pickets and the rules about civilians, he said there was one more thing.\" He looks at his hands. \"He said the Combine had lost something here. A long time ago. An item of Company property, never recovered. He said the Concord had reason to believe it was still in the system. He said if any of us, on any probe or landing, came across anything that looked like old Company equipment, anything at all, with the Combine's mark on it, we were to report it and not touch it.\" He looks up at me. \"And then he said, _and if you find it, you are not to open it. Under any circumstances. Not to look inside. Not to break the seal._ And then he said, _you'll know it if you see it._ And then he left.\"\n\n\"What does that mean?\"\n\n\"I've thought about it a lot,\" says Mattias Ebb. \"In here. I've had time.\" He's quiet for a moment. \"I think it means they're not afraid of you, warden. Not of your guns or your city or your Council. I think they're afraid of something your founders had.\" He lies back down on the bunk and puts his arm over his eyes again. \"Goodnight.\"\n\nI stand at the grille a while longer. Then I go on down the corridor to the end, where the tannery thief is snoring, and read his meter, and log it, and he wakes up and asks me if the Lamp's still in the sky.\n\n\"Yes,\" I say.\n\n\"Good,\" he says, and turns over.\n","wordCount":4826,"createdAt":1793109048711},{"id":"knCpt38claJtiyhDT3g05","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"uQcRzgdnq8Q_9APiGoKBS","text":"The Concord comes through the Throat during the evening bells.\n\nI'm on the Fourth by then, taking my mother home the long way round by the lifts, because she can't do the stairs any more. We're in the lift queue at Fourth Central when every speaker in the city clicks at once. That's what I remember: the click. Every speaker on every tier, all together, a single dry sound like a knuckle on a table, and then the hiss of an open channel, and then a voice.\n\n\"This is a message to the people of Kettle from the Concord of Vey.\"\n\nThe queue goes quiet. Everyone looks at the nearest speaker, which is a grey grille high on the wall above the lift doors, as if they might see the man through it.\n\nHe has a dry, educated, slightly tired voice. It sounds as though it is reading.\n\n\"My name is Anselm Grieve. I am a commodore of the Concord's Lane Service. At eighteen hundred today, Kettle time, a fleet under my command entered the Corva system through the lane mouth your people call the Throat. It consists of thirty-eight vessels. Their positions are being transmitted to your traffic control as I speak, as a courtesy, so that there may be no misunderstanding about our strength or our intentions.\"\n\nMy mother's arm tightens on mine.\n\n\"The Concord of Vey is the lawful successor to the Halloran-Vey Combine. It holds, by acquisition from the Combine's receivers, all of the Combine's titles, contracts, claims and accounts, including the claim to the Corva system and everything in it. The Combine never relinquished that claim. No instrument of sale exists. The occupation of the moon Kettle, and of the installations on it, and of the Combine vessel _Patience_, is therefore unlawful, and has been unlawful for two hundred and sixty-three years.\"\n\nSomebody in the queue laughs, a short shocked bark of a laugh. Nobody joins in.\n\n\"The Concord has no wish to harm the people of Kettle. You are, in law, the Concord's tenants. Your labour and your debts, like your city, are its property; it has a lawful interest in your welfare. Accordingly I am instructed to offer the following terms. The governing council of the occupation will stand down. The Concord's officers will be admitted to the city and its installations. The accounts of all residents will be assessed and regularised. In return, there will be no reprisals, and no resident will be removed from Kettle without due process.\" A pause. A rustle, very faint, like paper. \"You have three days to consider these terms. On the fourth day, if they are not accepted, I am instructed to take such steps as are necessary to secure the Concord's property. I would ask you to believe that I take no pleasure in saying so. This message will repeat.\"\n\nIt repeats. We stand in the queue and listen to it again, word for word, the same dry tired voice, the same small rustle of paper in the same place. Halfway through the second time the lift comes, and nobody gets in.\n\n\"Thirty-eight ships,\" someone says.\n\n\"They can't. They can't just—\"\n\n\"Tenants.\" An old man near the front, a dye-worker from the Fifth by his hands, spits on the floor. \"Tenants. We'll see about tenants.\"\n\nMy mother says nothing. She is looking at the speaker grille with the same face she turned up to the Oculus: wet-eyed, open-mouthed, almost glad.\n\n\"The Lamp comes round,\" she says, very quietly, to nobody, \"the debt comes due.\"\n\n\"Mama. Don't.\"\n\n\"I'm only saying.\"\n\n\"Don't say it here.\"\n\nThe First Shareholder answers the Concord forty minutes later, on the same speakers. I'm in my mother's room on the Ninth by then, sitting on the end of her cot with my boots still on, and we listen to it together by the light of her work-lamp, with her filters laid out on the bench under it in their neat sooty rows.\n\nLucan Strand doesn't sound tired at all. He sounds the way he sounded in the nave: warm, unhurried, certain.\n\nHe says that the people of Patience have heard the Concord's message. He says that the city of Patience is a free city, established by lawful purchase in the year twenty-three ninety-one, and that it does not recognise the claim of the Concord of Vey or of any other body to its people, its labour, or its air. He says that he has spoken with the Council of Shareholders, and that the Council is unanimous. He says that the city has weathered worse than a fleet, that it was built by people who knew how to be patient, and that it will be patient now. He says that the dipper fleet is recalled and the surface locks are sealed and the city's defences, which have not been tested in a hundred years but which have been maintained, every one of them, are manned. He says that the people of Patience are not tenants. He says it the way you would say a thing about the weather.\n\n\"In the meantime,\" he says, \"the Council has adopted certain emergency measures, which will be posted on every tier tonight. I ask every citizen of Patience to observe them, for the common good. Our air is our life. We must husband it. Happy Lampfast, and good night.\"\n\nThe measures are posted at midnight. I read them on my wrist, sitting on my mother's cot, while she sleeps.\n\nThere are eleven of them. Most are what you'd expect: curfews, rationing of heat, a ban on unlicensed movement between tiers. The ninth says that the dipper fleet is suspended until further notice, which means that nobody will be going up into Gall's sky for fuel while there are thirty-eight Concord ships between us and it. The tenth says that the refinery reserves are to be husbanded accordingly.\n\nThe eleventh says that, for the duration of the emergency, the air-tithe payable by unshared households is doubled, and that the floor is lowered by a third, and that air-wardens are to apply the new rates from the first of the next cycle.\n\nI read it three times. Then I turn off my wrist, and sit in the dark with the fans sighing, and listen to my mother breathe.\n\nThe first slug hits the surface just before dawn.\n\nI don't know that's what it is. Nobody does. I'm asleep sitting up, and I wake because the whole city rings: a deep enormous note that comes up through the floor and the walls and the cot and my own bones, like being inside a struck bell. It goes on a long time. Ice dust sifts down from the ceiling and settles on my mother's filters. Somewhere above us, forty metres up, something has hit the shell of Kettle at a speed I can't imagine, and the whole moon has taken it and passed it down to us, tier by tier, all the way to the bottom of the sea.\n\nMy mother sits up in her cot with her hair full of frost.\n\n\"Isa,\" she says. \"Is it the Lamp?\"\n\n\"No, Mama,\" I tell her. \"It's the Concord.\"\n\nThe bell is still ringing.\n\n\n# The Blank Share\n\n[\n  Place: #The Ninth Tier\n  Characters: @@Isaura Venn @@Pilar Ocampo\n  When: 30 June 2654\n]\n\nOn the eighteenth day of the siege the Ocampos' grandmother dies on the floor.\n\nI'm the one who finds her. That's the way it falls out; I'm doing my rounds on the Ninth South with the new rates loaded in my ledger, and when I get to the eleventh door I knock and say _air-warden_ and nobody answers, and I knock again, and then I put my ear to the hatch the way the old wardens taught us, to listen for the household breathing, and I hear only the fans. So I open it with my key. We're allowed to. The Ordinance says a warden may enter any unshared household to read its meter, at any hour, without notice, and I have never once done it before.\n\nThe room is dark and very cold. The Ninth's rooms are all one room: a sleeping platform at the back, a bench and a heater and a basin at the front, a curtain between. The heater's off, because heat costs air. The curtain's open. On the sleeping platform, under three blankets and a coat, lies an old woman with a grey face and her mouth a little open, and beside her, sitting on the edge of the platform with her knees drawn up and her cracked grey gloves on, is Pilar.\n\n\"Abuela's asleep,\" she says.\n\nI go and look. I'm not a medic, but you learn what you need to learn on the Ninth. The old woman's been dead some hours. Her hands are folded on the blanket, which means somebody folded them.\n\n\"Where's your mother, Pilar?\"\n\n\"At the plant. They're doing double shifts. Because of the Concord.\" She looks at me. \"Papa's at the plant too. Tomás and Juli are at the crèche on the Seventh. Abuela was sleeping. I was minding her.\"\n\n\"How long has she been sleeping?\"\n\nPilar thinks about it seriously. \"Since before the morning bell,\" she says. \"She said she was tired. She said her chest was tight. She said it was like breathing through a sock.\" She looks back at her grandmother. \"Then she stopped saying things.\"\n\nI stand in the cold dark room with my ledger on my wrist. The meter by the door, under its frosted window, reads two hundred litres an hour for five people. That is the new floor. Two hundred for five. It came in on the first of the cycle, along with the doubled tithe, by Council order, and I loaded the new figures myself and turned the valves myself, every door on my section that was in arrears, which on the Ninth South was very nearly every door. I put the Ocampos to the new floor on the second. I remember the valve. It was stiff.\n\nNobody dies on the floor.\n\n\"She had the ice cough,\" I say. \"Your grandmother. She'd had it for years. I heard it every time I came. Didn't she?\"\n\n\"She coughed,\" Pilar agrees.\n\n\"It's the cough. When people get old, the cough gets into their chest, and their heart gets tired. It isn't anybody's fault.\" I hear my own voice, very even, very kind. The warden's voice. \"I'm going to call the medics on the Seventh. They'll come and look after her. And I'm going to send a message to the plant, to your mother. All right?\"\n\n\"All right,\" says Pilar.\n\nI call the medics. I send the message. I file the death in my ledger, as the Ordinance requires, under _cause_, in the space provided: _Ice cough, pre-existing. Age._ My finger hovers over the line for a moment before I submit it, and then I submit it, because it's true. She did have the cough. She was old.\n\nWhile I wait for the medics I sit on the bench by the dead heater, and Pilar sits on the platform beside her grandmother, and neither of us says anything. Through the ceiling, faintly, very far up, I can hear the surface being hit. It's a sound we've all learned to stop hearing, these eighteen days: a long dull boom like a door slammed in another house, every hour or so, as one of Grieve's slugs comes down out of the black and strikes the shell of Kettle somewhere over the city. He is careful, the Commodore. Everyone says so. He doesn't hit the tiers. He hits the refinery vents and the dipper docks and the old surface sheds where the fuel was stored, and the city's lungs on the far ice, the great intakes where the water is cracked for air. He is not trying to break us. He is trying to make us breathe less.\n\nOn the wall of the corridor outside, every tier now has a board, posted by the Council at the start of each shift. It says RESERVE, and then a number of days. When the siege began it said ninety-four. This morning it says sixty-one.\n\n\"Warden,\" says Pilar.\n\n\"Yes.\"\n\n\"When Mama pays, does it go straight back?\"\n\n\"Yes.\"\n\n\"Even now?\"\n\n\"Even now. The ledger tells the plant. She doesn't have to find me.\"\n\nPilar considers this. Then she gets down off the platform and goes to the hatch and looks at the meter under its frosted window, the needle lying on the red, and wipes the frost off the glass with her cracked glove, the way I do.\n\n\"It's very low,\" she says.\n\n\"It's the floor.\"\n\n\"Nobody dies on the floor,\" says Pilar, to the meter, quite seriously, as if she were reminding it.","wordCount":2134,"createdAt":1793093847895},{"id":"lYtMOC4RKNIfi7eSmroiE","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"0T46v5SbLeM2hWt1bnUYG","text":"She found Abel at the third bell of the night, in the blister.\n\nThe blister was a dome of thick old glass on the _Patience_'s dorsal hull, a relic of the days when skimmers had carried passengers who wanted to look at things. It was cold, and badly lit, and the crew used it for courting and drinking and the kind of conversations that couldn't be had anywhere else, and nobody ever cleaned it. Abel was sitting on the floor with his back against the frame and a bottle of dock-still between his knees, looking up. He didn't turn round when she came in. He held the bottle up over his shoulder.\n\nShe took it, and drank, and gave it back, and sat down beside him.\n\nAbove them, through the scratched glass, Gall filled half the sky, ochre and purple, a storm the size of a world turning slowly on its southern limb. Above the storm, in the black, the Lamp hung like a thumbprint of light. It was brighter than it had been three days ago. You could see the tail properly now, a long faint fan of pale green going away from the sun, so delicate that if you looked straight at it it disappeared, and came back when you looked to the side.\n\n\"Teska says it takes the dead out,\" said Abel.\n\n\"Teska says a lot of things.\"\n\n\"She says it'll be back when our grandchildren are dead.\" He drank. \"That's a long time to be a comet.\"\n\n\"It's not a long time for a comet.\"\n\n\"No.\" He laughed a little. \"I suppose not.\" He held the bottle up to the glass and looked at the Lamp through it, through the cloudy brown spirit, so that it wobbled. \"I keep thinking about her. Lusine. Out there. Going in.\"\n\n\"So do I.\"\n\n\"You talked to her. The whole way. I heard you.\" He lowered the bottle. \"That was a good thing you did, Mar.\"\n\n\"I didn't do anything.\"\n\n\"You did, though.\" He turned his head and looked at her for the first time. His face was grey and his eyes were wet and red-rimmed, and she could not tell how much of it was the still. \"You always think you didn't do anything. You do more than anybody.\"\n\nShe looked at him for a long moment, at his handsome tired face in the Gall-light, her brother, whom she had carried on her hip through the third shaft when their mother went into the cloud.\n\n\"Were you seeing her, Abel?\"\n\nHe didn't move. He didn't look away. But she had known him all his life, and she saw the small thing happen behind his eyes, the thing that happened when he was eight and she asked him who had got into the dried fruit, the half-second of arithmetic.\n\n\"Seeing her?\"\n\n\"Lusine. Odile says she was seeing somebody. Somebody funny. Somebody always in debt who didn't care.\"\n\nAbel laughed. It was almost his real laugh. \"That's half the riggers on the ship.\"\n\n\"Were you?\"\n\n\"We were friendly.\" He shrugged. \"A bit. Now and then. She was—she was good fun, Mar. She liked a joke. We'd have a drink in the lock after shift. It wasn't serious. She wasn't serious about anybody.\" He drank. \"Why?\"\n\n\"Did she tell you anything? Before she died? About the _Clement_? About a dispatch?\"\n\n\"A dispatch?\" He frowned. \"What dispatch?\"\n\n\"Did she?\"\n\n\"No.\" He shook his head. \"No. Why would she tell me about a dispatch? I'm a rigger. I can barely read the duty board.\" He smiled at her, the old smile, _don't worry, it's me_. \"What's this about?\"\n\nMaren looked at the Lamp.\n\n\"Nothing,\" she said. \"It's late. I'm tired.\"\n\n\"You're always tired.\"\n\n\"I'm always tired.\"\n\nHe put his arm around her shoulders, the way he used to when he was sixteen and had just grown taller than her and wanted her to know it, and she let him, and they sat together in the cold blister and looked at the comet. His arm was warm and heavy and familiar. His hand, where it hung over her shoulder, was shaking, very slightly, with a small fine tremor, the kind of tremor that a man gets when he has been drinking for three days because he cannot stop seeing something.\n\nShe did not say anything about it. She sat there in her brother's arm and looked at the Lamp and thought, very clearly, _he's lying to me_, and then, because she was the tether-chief and that was what tether-chiefs did, she began to do the arithmetic.\n\n\n# Sanitation\n\n[\n  Place: #The Belly\n  Characters: @@Maren Tsolo @@Odile Arda @@Grandam Teska @@Danek Sorell @@Corwin Hale @@Bram Kovac @@Abel Tsolo\n  When: 11 November 2391\n]\n\nUnder the drum there was a space nobody had ever found a use for.\n\nThe drum sat in a cradle of girders that went down through three decks to the keel, and between the girders, under the drum's great curved belly, the shipwrights had left a hollow the size of a chapel: a ribbed, dark, echoing void full of cable runs and bearing housings and old grease, where the noise of the drum when it was turning was so loud you could not hear your own voice, and when it was not turning, so quiet you could hear the hull tick. The crew called it the Belly. You got into it by a maintenance hatch behind the number four brake, and a ladder, and a long crawl on your hands and knees along a cable tray. Riggers went there to sleep off shifts and to do things they did not want logged. Wardens did not go there, because wardens were big men and the cable tray was narrow.\n\nMaren called the meeting for the fourth bell of the night, in the dead hour between dips, when the drum was still.\n\nEleven of them came. She had asked for twelve. They sat on the girders and the bearing housings in a rough ring, with one lamp turned low on the deck plates between them, and their faces came and went in its light: Teska, wrapped in two coats, with her white eye shining; Odile, very upright, very quiet; Danek Sorell, too big for the space, folded up on a girder with his knees under his chin; old Pirro from the Bucket crew; two dock hands, a married pair called Senna and Ivo, who between them knew every valve on the forward collar; three riggers Maren trusted and two she trusted less, because you needed the ones who talked as well as the ones who didn't. Ekene was not there. She had not asked him. A free man could be hanged for what the bonded only had their accounts reviewed for.\n\nAbel was not there either. She had asked him. He had said yes, and smiled, and not come.\n\n\"Read it,\" said Teska. \"Read the paper. I want to hear it in my own ears.\"\n\nMaren read it. She read it in the tether-chief's voice, without any expression at all, every line, the routing codes and the board resolution and the numbers, _est. 300_, _est. 2,100 households_, _supply to cease_. When she had finished nobody said anything for a long time. Somewhere in the hull below them a pump came on and ran and went off again.\n\n\"Sorrel,\" said Danek at last, in the same voice he had used in the hall. \"The forts.\"\n\n\"The forts.\"\n\n\"And the Camp.\"\n\n\"Three months. Four if they're careful.\"\n\n\"Tamar's got the cough already. She had it last winter.\" Danek looked at his own big hands. \"Four months she won't make.\"\n\n\"Nobody'll make it,\" said Pirro. \"Not the old ones. Not the little ones. The plant'll go first, then the heat. You'll have people burning their bunks.\" He spat into the dark. \"I was in the Camp when the third shaft caved in sixty-eight. We were nine days without the plant. I saw what nine days did.\"\n\n\"So we don't go,\" said Senna, from the dock. \"We refuse. Strike. They can't move three hundred people on to the _Clement_ if three hundred people won't walk.\"\n\n\"They can if they've got sticks.\"\n\n\"They've got six marines and a dozen trusties. We're three hundred.\"\n\n\"And the _Admonition_,\" said Maren. \"Two weeks behind the factor. Sixty marines and a torpedo bay. Due on the twenty-second.\" She looked round the ring. \"And then they don't need us to walk.\"\n\n\"Then we take the ship,\" said Teska.\n\nThey all looked at her. She was sitting hunched on her bearing housing in her two coats, very small, with her good eye glittering in the lamp.\n\n\"We take her,\" she said. \"She's ours. We built her. Well, they built her, but we've had her sixty years; we've kept her flying when they wouldn't send the parts. Every bolt in her's been turned by one of us. We take her and we don't sink her. We keep dipping. We keep the Camp breathing.\" She shrugged inside the coats. \"Let the Combine come and get her.\"\n\n\"The Combine will,\" said Maren.\n\n\"Then we'll be dead in a month instead of four. I'm eighty-three. I can spare a month.\"\n\n\"Danek's children can't.\"\n\n\"Danek's children,\" said Teska, with great gentleness, \"are going to die on the ice anyway, Maren. That paper says so. All you're doing is choosing which way.\"\n\nNobody said anything to that.\n\nMaren had known it was coming. She had known since the night in the Shelf, with the foil in her hand and Odile's face in front of her, that it would come to this: a ring of tired people in the dark under the drum, with nothing in front of them but a wall, and somebody saying the thing out loud. She had spent four days running the arithmetic, in the gallery, at the board, in Ekene's bunk with her eyes open. It came out the same every time. Strike, and they would be broken. Comply, and the Camp would die. Fight, and the _Admonition_ would come, and then the Camp would die and so would they.\n\n\"If we take her,\" she said, \"we have to take the _Clement_ too. Same night. Same hour. Otherwise the factor gets on her and casts off and he's two weeks from the _Admonition_ and he tells them everything. And the _Clement_'s got the marines, and the marines have guns.\"\n\n\"How many?\"\n\n\"Six. Sergeant called Oyelowo. They're good. They're not like the trusties. They've done this before.\"\n\n\"We'll need sticks,\" said a voice from the dark at the edge of the ring. \"At least.\"\n\nThe lamp didn't reach where it came from. It didn't need to. Everybody knew that voice, soft and patient and reasonable, and the ring went still the way a rigger goes still on the line when the trace jumps.\n\nCorwin Hale came forward into the light at his slow walk, ducking under a girder. Behind him, in the dark, Maren could see the shape of Bram Kovač crouched at the end of the cable tray, blocking it.\n\n\"I'm sorry to interrupt,\" said Hale. \"I didn't mean to listen. Sound carries in here. It's a terrible place for a secret.\"\n\n\"How did you get in?\" said Odile. \"The tray's too narrow for you.\"\n\n\"There's a hatch from the keel side, if you know where it is.\" Hale smiled faintly. \"I've been on this ship twenty years, Arda. I know where everything is.\" He looked round the ring. His eyes rested on each of them in turn, mild and unhurried, as if he were taking a register: Teska, Danek, Pirro, Senna, Ivo, the riggers. Last of all he looked at Maren. \"May I sit down?\"\n\nNobody answered. He sat anyway, on the end of Pirro's girder, so that the old man had to shift up.\n\n\"You've read the dispatch,\" he said. \"I know you have. Arda's sister had it in her boot. I've been waiting for you to do something about it.\" He folded his big hands on his knee. \"I'm on the list too, you know. I'm bonded. I've got an account. My mother's in the Camp, on the second shaft, and she's sixty-eight, and she doesn't have four months either.\" He looked at Danek. \"Trusties go to Sorrel with everybody else, Sorell. They don't need wardens on the forts. They've got officers for that. I'll be filling sandbags beside you.\"\n\n\"You'll be filling sandbags,\" said Teska, \"when Gall freezes.\"\n\n\"Grandam,\" said Hale, \"I know what you think of me. I know what you all think of me. You think I'm the Combine's dog. You're right. I've been the Combine's dog for twenty years, because the Combine fed me.\" He opened his hands. \"The Combine's stopped feeding me. That's all. I'd like to eat.\"\n\n\"What are you offering?\" said Maren.\n\n\"Twelve trusties with sticks. The keys to the bridge and the armoury, such as it is. Two old flechette carbines that the Combine forgot it issued. And the warden's office, which means the logs, which means that whatever happens, the Combine won't hear about it from this ship until we want it to.\" He met her eyes. \"And me. Who knows where everything is.\"\n\nMaren looked at him. She thought of Lusine's voice on channel four. _I told someone._ She thought of Quist across Moberly's desk, turning his coffee cup: _I'd look at who on this ship would have wanted the Combine to be grateful to them._ She thought of the form on Hale's slate, already filled in, in his neat hand, before she ever came down the gallery ladder.\n\nShe thought of six marines with guns.\n\n\"What's Schedule H?\" she said.\n\nHale blinked. \"I'm sorry?\"\n\n\"In the dispatch. Paragraph five. _Contingency authority, Schedule H, confirmed._ What's Schedule H?\"\n\n\"I've no idea,\" said Hale. \"Factors' business. I'm a warden.\" He shrugged. \"Contingency means _if things go wrong_. I expect it means the _Admonition_.\"\n\nHe said it easily. Maren watched him say it. She could not tell. She had been watching Hale for twenty years, and she had never once been able to tell what was behind that mild patient face, and she could not tell now.\n\n\"We'll think about your offer,\" she said.\n\n\"Don't think too long,\" said Hale, getting up. \"The twenty-second isn't far.\" He looked round the ring once more, taking his register. \"And none of you need worry about me. I can keep a secret. I've kept a great many.\" He ducked back under the girder into the dark, and they heard him go, slow and heavy, toward his hatch in the keel; and after a moment Bram Kovač's shape at the end of the cable tray went too.\n\nThe ring sat in silence.\n\n\"Well,\" said Pirro. \"Now we have to.\"","wordCount":2458,"createdAt":1793108902647},{"id":"sJMT75433VCY6JpPd9hjR","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"0T46v5SbLeM2hWt1bnUYG","text":"She found Abel at the third bell of the night, in the blister.\n\nThe blister was a dome of thick old glass on the _Patience_'s dorsal hull, a relic of the days when skimmers had carried passengers who wanted to look at things. It was cold, and badly lit, and the crew used it for courting and drinking and the kind of conversations that couldn't be had anywhere else, and nobody ever cleaned it. Abel was sitting on the floor with his back against the frame and a bottle of dock-still between his knees, looking up. He didn't turn round when she came in. He held the bottle up over his shoulder.\n\nShe took it, and drank, and gave it back, and sat down beside him.\n\nAbove them, through the scratched glass, Gall filled half the sky, ochre and purple, a storm the size of a world turning slowly on its southern limb. Above the storm, in the black, the Lamp hung like a thumbprint of light. It was brighter than it had been three days ago. You could see the tail properly now, a long faint fan of pale green going away from the sun, so delicate that if you looked straight at it it disappeared, and came back when you looked to the side.\n\n\"Teska says it takes the dead out,\" said Abel.\n\n\"Teska says a lot of things.\"\n\n\"She says it'll be back when our grandchildren are dead.\" He drank. \"That's a long time to be a comet.\"\n\n\"It's not a long time for a comet.\"\n\n\"No.\" He laughed a little. \"I suppose not.\" He held the bottle up to the glass and looked at the Lamp through it, through the cloudy brown spirit, so that it wobbled. \"I keep thinking about her. Lusine. Out there. Going in.\"\n\n\"So do I.\"\n\n\"You talked to her. The whole way. I heard you.\" He lowered the bottle. \"That was a good thing you did, Mar.\"\n\n\"I didn't do anything.\"\n\n\"You did, though.\" He turned his head and looked at her for the first time. His face was grey and his eyes were wet and red-rimmed, and she could not tell how much of it was the still. \"You always think you didn't do anything. You do more than anybody.\"\n\nShe looked at him for a long moment, at his handsome tired face in the Gall-light, her brother, whom she had carried on her hip through the third shaft when their mother went into the cloud.\n\n\"Were you seeing her, Abel?\"\n\nHe didn't move. He didn't look away. But she had known him all his life, and she saw the small thing happen behind his eyes, the thing that happened when he was eight and she asked him who had got into the dried fruit, the half-second of arithmetic.\n\n\"Seeing her?\"\n\n\"Lusine. Odile says she was seeing somebody. Somebody funny. Somebody always in debt who didn't care.\"\n\nAbel laughed. It was almost his real laugh. \"That's half the riggers on the ship.\"\n\n\"Were you?\"\n\n\"We were friendly.\" He shrugged. \"A bit. Now and then. She was—she was good fun, Mar. She liked a joke. We'd have a drink in the lock after shift. It wasn't serious. She wasn't serious about anybody.\" He drank. \"Why?\"\n\n\"Did she tell you anything? Before she died? About the _Clement_? About a dispatch?\"\n\n\"A dispatch?\" He frowned. \"What dispatch?\"\n\n\"Did she?\"\n\n\"No.\" He shook his head. \"No. Why would she tell me about a dispatch? I'm a rigger. I can barely read the duty board.\" He smiled at her, the old smile, _don't worry, it's me_. \"What's this about?\"\n\nMaren looked at the Lamp.\n\n\"Nothing,\" she said. \"It's late. I'm tired.\"\n\n\"You're always tired.\"\n\n\"I'm always tired.\"\n\nHe put his arm around her shoulders, the way he used to when he was sixteen and had just grown taller than her and wanted her to know it, and she let him, and they sat together in the cold blister and looked at the comet. His arm was warm and heavy and familiar. His hand, where it hung over her shoulder, was shaking, very slightly, with a small fine tremor, the kind of tremor that a man gets when he has been drinking for three days because he cannot stop seeing something.\n\nShe did not say anything about it. She sat there in her brother's arm and looked at the Lamp and thought, very clearly, _he's lying to me_, and then, because she was the tether-chief and that was what tether-chiefs did, she began to do the arithmetic.\n","wordCount":761,"createdAt":1793108901761},{"id":"x7zLMU_5VmsfM-nhXwi8t","worldId":"qazoRpRKLPklIu-1YyQ3E","eventId":"uQcRzgdnq8Q_9APiGoKBS","text":"The Concord comes through the Throat during the evening bells.\n\nI'm on the Fourth by then, taking my mother home the long way round by the lifts, because she can't do the stairs any more. We're in the lift queue at Fourth Central when every speaker in the city clicks at once. That's what I remember: the click. Every speaker on every tier, all together, a single dry sound like a knuckle on a table, and then the hiss of an open channel, and then a voice.\n\n\"This is a message to the people of Kettle from the Concord of Vey.\"\n\nThe queue goes quiet. Everyone looks at the nearest speaker, which is a grey grille high on the wall above the lift doors, as if they might see the man through it.\n\nHe has a dry, educated, slightly tired voice. It sounds as though it is reading.\n\n\"My name is Anselm Grieve. I am a commodore of the Concord's Lane Service. At eighteen hundred today, Kettle time, a fleet under my command entered the Corva system through the lane mouth your people call the Throat. It consists of thirty-eight vessels. Their positions are being transmitted to your traffic control as I speak, as a courtesy, so that there may be no misunderstanding about our strength or our intentions.\"\n\nMy mother's arm tightens on mine.\n\n\"The Concord of Vey is the lawful successor to the Halloran-Vey Combine. It holds, by acquisition from the Combine's receivers, all of the Combine's titles, contracts, claims and accounts, including the claim to the Corva system and everything in it. The Combine never relinquished that claim. No instrument of sale exists. The occupation of the moon Kettle, and of the installations on it, and of the Combine vessel _Patience_, is therefore unlawful, and has been unlawful for two hundred and sixty-three years.\"\n\nSomebody in the queue laughs, a short shocked bark of a laugh. Nobody joins in.\n\n\"The Concord has no wish to harm the people of Kettle. You are, in law, the Concord's tenants. Your labour and your debts, like your city, are its property; it has a lawful interest in your welfare. Accordingly I am instructed to offer the following terms. The governing council of the occupation will stand down. The Concord's officers will be admitted to the city and its installations. The accounts of all residents will be assessed and regularised. In return, there will be no reprisals, and no resident will be removed from Kettle without due process.\" A pause. A rustle, very faint, like paper. \"You have three days to consider these terms. On the fourth day, if they are not accepted, I am instructed to take such steps as are necessary to secure the Concord's property. I would ask you to believe that I take no pleasure in saying so. This message will repeat.\"\n\nIt repeats. We stand in the queue and listen to it again, word for word, the same dry tired voice, the same small rustle of paper in the same place. Halfway through the second time the lift comes, and nobody gets in.\n\n\"Thirty-eight ships,\" someone says.\n\n\"They can't. They can't just—\"\n\n\"Tenants.\" An old man near the front, a dye-worker from the Fifth by his hands, spits on the floor. \"Tenants. We'll see about tenants.\"\n\nMy mother says nothing. She is looking at the speaker grille with the same face she turned up to the Oculus: wet-eyed, open-mouthed, almost glad.\n\n\"The Lamp comes round,\" she says, very quietly, to nobody, \"the debt comes due.\"\n\n\"Mama. Don't.\"\n\n\"I'm only saying.\"\n\n\"Don't say it here.\"\n\nThe First Shareholder answers the Concord forty minutes later, on the same speakers. I'm in my mother's room on the Ninth by then, sitting on the end of her cot with my boots still on, and we listen to it together by the light of her work-lamp, with her filters laid out on the bench under it in their neat sooty rows.\n\nLucan Strand doesn't sound tired at all. He sounds the way he sounded in the nave: warm, unhurried, certain.\n\nHe says that the people of Patience have heard the Concord's message. He says that the city of Patience is a free city, established by lawful purchase in the year twenty-three ninety-one, and that it does not recognise the claim of the Concord of Vey or of any other body to its people, its labour, or its air. He says that he has spoken with the Council of Shareholders, and that the Council is unanimous. He says that the city has weathered worse than a fleet, that it was built by people who knew how to be patient, and that it will be patient now. He says that the dipper fleet is recalled and the surface locks are sealed and the city's defences, which have not been tested in a hundred years but which have been maintained, every one of them, are manned. He says that the people of Patience are not tenants. He says it the way you would say a thing about the weather.\n\n\"In the meantime,\" he says, \"the Council has adopted certain emergency measures, which will be posted on every tier tonight. I ask every citizen of Patience to observe them, for the common good. Our air is our life. We must husband it. Happy Lampfast, and good night.\"\n\nThe measures are posted at midnight. I read them on my wrist, sitting on my mother's cot, while she sleeps.\n\nThere are eleven of them. Most are what you'd expect: curfews, rationing of heat, a ban on unlicensed movement between tiers. The ninth says that the dipper fleet is suspended until further notice, which means that nobody will be going up into Gall's sky for fuel while there are thirty-eight Concord ships between us and it. The tenth says that the refinery reserves are to be husbanded accordingly.\n\nThe eleventh says that, for the duration of the emergency, the air-tithe payable by unshared households is doubled, and that the floor is lowered by a third, and that air-wardens are to apply the new rates from the first of the next cycle.\n\nI read it three times. Then I turn off my wrist, and sit in the dark with the fans sighing, and listen to my mother breathe.\n\nThe first slug hits the surface just before dawn.\n\nI don't know that's what it is. Nobody does. I'm asleep sitting up, and I wake because the whole city rings: a deep enormous note that comes up through the floor and the walls and the cot and my own bones, like being inside a struck bell. It goes on a long time. Ice dust sifts down from the ceiling and settles on my mother's filters. Somewhere above us, forty metres up, something has hit the shell of Kettle at a speed I can't imagine, and the whole moon has taken it and passed it down to us, tier by tier, all the way to the bottom of the sea.\n\nMy mother sits up in her cot with her hair full of frost.\n\n\"Isa,\" she says. \"Is it the Lamp?\"\n\n\"No, Mama,\" I tell her. \"It's the Concord.\"\n\nThe bell is still ringing.\n\n\n# The Blank Share\n\n## Under the floor\n\n[\n  Place: #The Ninth Tier\n  Characters: @@Isaura Venn @@Pilar Ocampo\n  When: 30 June 2654\n]\n\nOn the eighteenth day of the siege the Ocampos' grandmother dies on the floor.\n\nI'm the one who finds her. That's the way it falls out; I'm doing my rounds on the Ninth South with the new rates loaded in my ledger, and when I get to the eleventh door I knock and say _air-warden_ and nobody answers, and I knock again, and then I put my ear to the hatch the way the old wardens taught us, to listen for the household breathing, and I hear only the fans. So I open it with my key. We're allowed to. The Ordinance says a warden may enter any unshared household to read its meter, at any hour, without notice, and I have never once done it before.\n\nThe room is dark and very cold. The Ninth's rooms are all one room: a sleeping platform at the back, a bench and a heater and a basin at the front, a curtain between. The heater's off, because heat costs air. The curtain's open. On the sleeping platform, under three blankets and a coat, lies an old woman with a grey face and her mouth a little open, and beside her, sitting on the edge of the platform with her knees drawn up and her cracked grey gloves on, is Pilar.\n\n\"Abuela's asleep,\" she says.\n\nI go and look. I'm not a medic, but you learn what you need to learn on the Ninth. The old woman's been dead some hours. Her hands are folded on the blanket, which means somebody folded them.\n\n\"Where's your mother, Pilar?\"\n\n\"At the plant. They're doing double shifts. Because of the Concord.\" She looks at me. \"Papa's at the plant too. Tomás and Juli are at the crèche on the Seventh. Abuela was sleeping. I was minding her.\"\n\n\"How long has she been sleeping?\"\n\nPilar thinks about it seriously. \"Since before the morning bell,\" she says. \"She said she was tired. She said her chest was tight. She said it was like breathing through a sock.\" She looks back at her grandmother. \"Then she stopped saying things.\"\n\nI stand in the cold dark room with my ledger on my wrist. The meter by the door, under its frosted window, reads two hundred litres an hour for five people. That is the new floor. Two hundred for five. It came in on the first of the cycle, along with the doubled tithe, by Council order, and I loaded the new figures myself and turned the valves myself, every door on my section that was in arrears, which on the Ninth South was very nearly every door. I put the Ocampos to the new floor on the second. I remember the valve. It was stiff.\n\nNobody dies on the floor.\n\n\"She had the ice cough,\" I say. \"Your grandmother. She'd had it for years. I heard it every time I came. Didn't she?\"\n\n\"She coughed,\" Pilar agrees.\n\n\"It's the cough. When people get old, the cough gets into their chest, and their heart gets tired. It isn't anybody's fault.\" I hear my own voice, very even, very kind. The warden's voice. \"I'm going to call the medics on the Seventh. They'll come and look after her. And I'm going to send a message to the plant, to your mother. All right?\"\n\n\"All right,\" says Pilar.\n\nI call the medics. I send the message. I file the death in my ledger, as the Ordinance requires, under _cause_, in the space provided: _Ice cough, pre-existing. Age._ My finger hovers over the line for a moment before I submit it, and then I submit it, because it's true. She did have the cough. She was old.\n\nWhile I wait for the medics I sit on the bench by the dead heater, and Pilar sits on the platform beside her grandmother, and neither of us says anything. Through the ceiling, faintly, very far up, I can hear the surface being hit. It's a sound we've all learned to stop hearing, these eighteen days: a long dull boom like a door slammed in another house, every hour or so, as one of Grieve's slugs comes down out of the black and strikes the shell of Kettle somewhere over the city. He is careful, the Commodore. Everyone says so. He doesn't hit the tiers. He hits the refinery vents and the dipper docks and the old surface sheds where the fuel was stored, and the city's lungs on the far ice, the great intakes where the water is cracked for air. He is not trying to break us. He is trying to make us breathe less.\n\nOn the wall of the corridor outside, every tier now has a board, posted by the Council at the start of each shift. It says RESERVE, and then a number of days. When the siege began it said ninety-four. This morning it says sixty-one.\n\n\"Warden,\" says Pilar.\n\n\"Yes.\"\n\n\"When Mama pays, does it go straight back?\"\n\n\"Yes.\"\n\n\"Even now?\"\n\n\"Even now. The ledger tells the plant. She doesn't have to find me.\"\n\nPilar considers this. Then she gets down off the platform and goes to the hatch and looks at the meter under its frosted window, the needle lying on the red, and wipes the frost off the glass with her cracked glove, the way I do.\n\n\"It's very low,\" she says.\n\n\"It's the floor.\"\n\n\"Nobody dies on the floor,\" says Pilar, to the meter, quite seriously, as if she were reminding it.\n\n## The fall of the Plate\n\n[\n  Place: #The Spine\n  Characters: @@Isaura Venn @@Malachy Orr @@Lucan Strand\n  Items: ^The Share Plate:#The Archive ^Isaura's gauge:@Isaura Venn\n  When: same day\n]\n\nIn the afternoon I'm sent to the Spine.\n\nThe order comes down from the Wardens' Office with no explanation, which is how orders always come down: _Venn, I., to report Spine nave, air survey, priority._ When I get there I find out why. A slug in the night came down closer than any before it, on the old dock heads over the Spine, and the shock went down through the hull like a hammer down an anvil, and somewhere in the nave's air system something cracked. The nave's air is the Council's air. It's shared air, untithed, drawn straight from the city's best intakes and scrubbed three times on its way; it's also, like all old systems, a mess of pipes and baffles and valves that nobody has drawn a proper plan of in a century. Somebody has to walk it with a gauge and find the leak. The Council's own engineers are busy on the refinery vents. So they send a warden from the Ninth.\n\nI walk it for three hours. I go up into the roof spaces above the nave on the old maintenance ladders, which were built for riggers two centuries ago and have been painted a dozen times since and never once mended, and crawl along the trunking with my gauge in one hand and my lamp in my teeth, listening. The nave below me is empty. Since the siege began the Council has met in the old bridge, which is deeper and safer, and the shared families have stopped coming up to sit on the benches under the Oculus and look at the Lamp. You can see it through the lens even from up here, sideways: a smear of greenish light much brighter now than it was at Lampfast, with a tail so long it crosses half the lens. The Lamp doesn't care about the Concord. It comes on in.\n\nI find the leak in the end over the drum, where a flange on the main trunk has cracked across its face and is whistling out the Council's good air into the roof void. I can feel it on my cheek. I mark it with chalk and log it, and I'm climbing back down the ladder at the drum's end when the next slug comes.\n\nIt's close. Much closer than the one in the night. I feel it before I hear it, a shove from the ladder against my hands and my knees, as if the whole Spine had been kicked; then the sound, which isn't a boom at all this close but a crack, enormous, a sound like the sky being split down the middle; and then the nave rings. The old hull takes the blow and passes it down its whole length like a struck bell, and the ladder hums under me so hard my teeth buzz, and dust comes down out of the roof in a grey sheet, and somewhere below me something lets go.\n\nI hang on. That's all you can do. When the ringing has gone down enough for me to hear myself think, I look down.\n\nThe Share Plate has fallen off the drum.\n\nIt must have been hanging on the same old fixings since the founding: four steel pins set into the drum's end, with the Plate's top corners hooked over two of them. The hull has rung and the pins have sheared. It's lying on the deck at the drum's foot, face down, in the dust, with one corner bent.\n\nI climb the rest of the way down and stand looking at it. I don't touch it. Nobody touches the Plate. There are shared children who have been taken up to it on their naming days and allowed to lay one finger on the edge of their ancestor's name, and that is all; there are unshared families who have lived in this city for a hundred years and never been within ten metres of it. And now here it is at my feet, face down on the deck like a dropped tray.\n\nThe back is grey.\n\nThat's what I notice. I've never seen the back of it, nobody has. It's covered, edge to edge, in a coat of thick old grey paint, the kind of hull sealant they used to put on the outside of ships, gone hard and crazed with age, like the skin on old milk. Somebody painted the back of the Share Plate with ship's sealant, a long time ago, carefully, all over. And under the paint, where the light from the Oculus falls across it at a low angle, there are lines.\n\nI crouch down. I still don't touch it. The lines are very faint, just a ridging in the sealant, the way the shape of a coin shows through a sheet of paper laid over it. Rows of them. Short marks, grouped. Something cut into the metal underneath and then painted over, so that only the ghost of the cutting comes through.\n\n\"Don't touch it,\" says a voice behind me.\n\nIt's Malachy. He's come up from the Archive in his slippers with his old grey coat thrown over his nightshirt, though it's the middle of the afternoon, and his white hair is full of dust, and he's out of breath. He comes across the nave to me at his slow crane's walk and stands beside me looking down at the Plate.\n\n\"I wasn't going to,\" I say.\n\n\"Good. Your hands are filthy.\" He crouches down beside me, which takes him some time, and puts his face close to the grey back of the Plate, and tilts his head to catch the light the way I did. He looks for a long time. He doesn't say anything. Then he lets out a long breath through his nose.\n\n\"Well,\" he says. \"Well, well.\"\n\n\"Is that writing?\"\n\n\"It's something.\"\n\nThere are footsteps on the nave floor, a lot of them. The Council's stewards, in their grey coats, four of them, with the First Shareholder walking behind. Lucan Strand looks tired. He has dust on his shoulders, too, and a cut over one eye with a dressing on it, and he moves like a man who has been awake for most of eighteen days; but his face when he sees the Plate on the floor goes very still, and then very gentle, the way a man's face goes when he sees a child hurt.\n\n\"Is it damaged?\"\n\n\"One corner bent, First Shareholder,\" says Malachy, not getting up. \"The fixings sheared. I'd like to look at it before it goes back up.\"\n\n\"It must go back up.\" Strand comes and stands over it. \"Today. The people need to see it there. With what's happening—\"\n\n\"It'll go back up,\" says Malachy, \"on new pins, in a proper frame, when I've made sure that bend hasn't cracked the steel. If you hang it today on the old pins it'll be on the floor again in a week, and next time it might break.\" He looks up at the First Shareholder with his mild old eyes. \"You wouldn't want to be the Shareholder who broke the Plate, Lucan.\"\n\nStrand looks at him. I think for a moment that he's going to say no. I can see him weighing it: the steward at his elbow, the empty nave, the Lamp over his head in the Oculus, the slugs.\n\n\"How long?\" he says.\n\n\"A week. Two at most.\"\n\n\"In the Archive.\"\n\n\"In the Archive, under lock, where it's safe. You can come and look at it any time you like.\"\n\nStrand lets out a breath. \"Very well. A week.\" He turns to the stewards. \"Help the Archivist carry it. Gently.\" He looks down at me as if noticing me for the first time. \"You found it?\"\n\n\"I was surveying the air, First Shareholder. There's a cracked flange on the main trunk, over the drum. I've marked it.\"\n\n\"Thank you.\" He's already turning away. \"Thank you, warden. Good work.\"\n\nThe stewards pick the Plate up between them, carefully, face down still, the grey back uppermost, and carry it toward the Archive stairs like a stretcher, with Malachy hovering behind. Nobody but me and Malachy looks at the back. The stewards are looking at their feet on the stairs. Strand is looking at the pins.\n\nAs Malachy goes past me, he puts his hand on my arm for a moment, very lightly.\n\n\"Come and see me tonight,\" he says. \"After curfew. Bring your lamp.\"\n\n[\n  Place: #South Lock\n  Characters: @@Isaura Venn @@Mattias Ebb @@Dasha Imre\n  Items: ^Isaura's gauge:@Isaura Venn\n  When: same day\n]\n\nI don't get to the Archive that night. At the eighth bell, as I'm coming off shift, the city's guns open up for the first time in the siege.\n\nI didn't know we had guns. I don't think most people did. There are batteries, it turns out, in old pits on the surface ice around the city, built a hundred years ago in some war scare that never came to anything and maintained ever since by a few dozen shared families who have the right to do it the way other shared families have the right to the dipper fleet. They've waited eighteen days. Now, all at once, they fire, and the whole city hears them: a sound like heavy doors being slammed, very fast, one after another, coming down through the ice.\n\nEverybody stops in the corridors and looks up.\n\nThe word comes down the speakers a few minutes later, crackling and excited. A Concord lander has come down low over the south ice, probing, the first time any of Grieve's ships has come close enough to touch, and the batteries have hit it. It's down. It's on the ice south of the city, a kilometre from South Lock. All damage-control parties to South Lock. All air-wardens with surface rating to South Lock.\n\nI have surface rating. All wardens do; we read the meters on the intakes. I go.\n\nSouth Lock is a vast old chamber cut in the ice at the bottom of a sloping ramp, with the surface doors at its top end and a long low gallery down one side where the suits hang on their racks like a row of hanged men. When I get there it's already full of people. Damage-control crews in orange. Wardens in grey. Militia in their blue armbands with their old rifles. And riggers, a lot of riggers, the big tattooed men and women of the dipper fleet, who've been grounded eighteen days by the Council's order and have nothing to do and are in the mood for something to do it to.\n\nThe doors are open when I get there. The lock's cycled. A team in surface suits has gone out across the ice on a crawler and is coming back, and on the big screen over the gallery we can all see the feed from the crawler's lamps: white ice, black sky, Gall's banded edge on the horizon, and a long smear of wreckage going away across the snow, burning green and orange where its fuel has caught. In the middle of the wreckage, something moving.\n\n\"There's one alive,\" someone says.\n\n\"Not for long.\"\n\nThe crawler comes back down the ramp with the outer doors grinding shut behind it, ice streaming off its tracks. The lock cycles. When the inner doors open, the crowd surges forward, and I'm pushed forward with it, and I see the damage-control crew climbing down off the crawler's bed with a body between them in a scorched white Concord pressure suit.\n\nThey put it down on the floor of the lock. The suit's helmet is cracked across the visor. There's frost on the inside of the crack. The figure inside it moves its hands, weakly, at the clasps of the helmet, as if it wants to get it off.\n\n\"Leave it,\" says somebody. \"It's on its own air.\"\n\n\"Its air's gone,\" says one of the damage-control crew, a woman with a burned face, crouching by the helmet. \"Tank's holed. It's breathing what's left in the suit.\" She looks up. \"Maybe ten minutes.\"\n\n\"Then leave it ten minutes,\" says a rigger at the front of the crowd, a huge man with comet-tails tattooed up both forearms, and there's a growl of agreement behind him. \"Let it breathe what's left. That's what they're doing to us.\"\n\n\"Put it out on the ice.\"\n\n\"Let it have the floor.\"\n\nThat gets a laugh, an ugly one. It goes round the lock like a wave. _Let it have the floor._ The Concord pilot's hands have stopped moving at the clasps. They lie on its chest. Through the cracked visor I can see a face, very young, very pale, with its eyes open, looking up at all of us.\n\nI'm not brave. I want to say that clearly, as I said the other thing clearly before. What I do next isn't brave. It's habit. I'm an air-warden. I have spent twelve years kneeling beside meters, and what I'm looking at is a meter reading red.\n\nI push through to the front, and kneel down beside the burned-faced woman, and take the spare bottle off my own belt. Every warden carries a spare, a little twenty-minute flask with a universal coupling, for when we're out on the intakes. I find the suit's emergency port under the left armpit, where every suit in eleven lanes has had it since before the founding, and I knock the frost off it with my glove and screw the coupling in, and open the valve.\n\nThe suit hisses. The frost on the inside of the visor starts, very slowly, to clear.\n\n\"What are you doing?\" says the tattooed rigger.\n\n\"Reading a meter,\" I say.\n\nThere is a silence in the lock. I can feel it on the back of my neck, a hundred people looking at me. I don't look round. I watch the frost clear on the visor, and the young pale face behind it blink, and its lips move.\n\n\"Warden,\" says the rigger, in a voice I don't like.\n\n\"It's my air,\" I say. \"It's on my account. If you want to take it off me, you'll have to take it off me.\"\n\nNobody moves. I don't know what would have happened next. I don't know, to this day, whether they would have; I think perhaps they would. But the militia have got to the front by then, three of them with rifles and blue armbands and an officer with a whistle, and the officer is shouting that the prisoner is the property of the Council and anybody who lays a hand on him will be on the floor for a year. The crowd backs off, growling. The burned-faced woman helps me get the cracked helmet off. Underneath it the pilot is a man, young, younger than me, with a soldier's cropped fair hair and a soldier's frightened eyes, and a smear of blood under his nose.\n\nHe looks at me. He breathes. It's the first thing I ever hear him do.\n\n\"Thank you,\" he says, in the clipped accent of the inner lanes.\n\n\"Don't,\" I say. \"It's on your account.\"\n\nThe militia take him. They lift him on to a stretcher and carry him up the ramp toward the inner city, and the officer with the whistle tells me to report to the Wardens' Office in the morning with my bottle receipt, and goes after them. The crowd breaks up, slowly, sullenly, back to whatever it was doing. The tattooed rigger stands looking at me a while longer and then goes. I'm left kneeling on the wet ice floor of the lock with my empty bottle in my hand.\n\nSomebody crouches down beside me. A woman, a rigger, forty-odd, small and wiry, with her sleeves rolled up over forearms tattooed from wrist to elbow with the long thin fans of comets, one inside another, like the rings in a tree.\n\n\"You gave him your air, warden,\" she says.\n\n\"I gave him a bottle.\"\n\n\"That's a first.\" She looks at me with a sort of amused curiosity, as if I were a dog that had started to talk. \"Twelve years I've lived on the Ninth North and I never once saw a warden give anybody air.\"\n\n\"It's not a warden's job to give air.\"\n\n\"No,\" she agrees. \"It's not.\" She stands up and dusts off her knees. \"I'm Dasha. Dasha Imre. Rigger. Grounded.\" She holds out her hand to pull me up. \"You want to be careful, warden. Giving people things. It gets to be a habit.\"\n\nI let her pull me up. \"Isaura,\" I say. \"Venn.\"\n\n\"I know who you are,\" says Dasha Imre. \"Everybody on the Ninth knows who you are.\" She grins, quite friendly. \"That's why it's a first.\"\n\nWhen I get back to my room on the Fourth it's past the tenth bell, and there's a message waiting on my wrist. It's from the Archive. It's very short, in Malachy's old-fashioned way, the way he used to write notes in the margins of my exercises when I was ten.\n\n_Isaura. There's writing under the paint. Come tomorrow. Come alone. M._\n","wordCount":5027,"createdAt":1793093847531}],"tombstones":[{"id":"ZT_D0k7Ur6moa-U72r--q","worldId":"qazoRpRKLPklIu-1YyQ3E","entityType":"event","entityId":"hluVZWRg-EaYLsx6Auey1","version":9,"deviceId":"F_qjMKm6ssdVmUcLSIiQq","deletedAt":1793092984739}],"blobs":[{"id":"dQ4zgB5BfBQpRTYERW9bX","worldId":"qazoRpRKLPklIu-1YyQ3E","mimeType":"image/png","dataBase64":"","createdAt":1793092647442}]}