 for the Lamp Run.","x":320,"y":767,"imageId":null,"iconType":"custom","tags":[],"factionId":null,"createdAt":1793092647442,"updatedAt":1793092647442},{"id":"8eR25D-izsDjjeANM5Xc9","worldId":"qazoRpRKLPklIu-1YyQ3E","mapLayerId":"uKU7vxBMqFnq6vDOH-25S","linkedMapLayerId":"LxPoK5yLqQ1ZWR47hr9nd","name":"Cinderhaven","description":"Tarn's ring-station, all ledgers and repossession yards.","x":800,"y":500,"imageId":null,"iconType":"city","tags":[],"factionId":null,"createdAt":1793092647442,"updatedAt":1793092647442},{"id":"BHm47p2wHqPiaEiVPYXW0","worldId":"qazoRpRKLPklIu-1YyQ3E","mapLayerId":"Cd7Yd2rO_7I1AbIgTxMy-","linkedMapLayerId":null,"name":"The infirmary","description":"Ekene Adu's infirmary.","x":373,"y":500,"imageId":null,"iconType":"building","tags":[],"factionId":null,"createdAt":1793092647442,"updatedAt":1793092647442},{"id":"Df9ChpU0WnUq_pF2QnWOo","worldId":"qazoRpRKLPklIu-1YyQ3E","mapLayerId":"Cd7Yd2rO_7I1AbIgTxMy-","linkedMapLayerId":null,"name":"The bridge","description":"The Patience's bridge.","x":373,"y":767,"imageId":null,"iconType":"building","tags":[],"factionId":null,"createdAt":1793092647442,"updatedAt":1793092647442},{"id":"ERtwQtgKRFntqrjHNDUWr","worldId":"qazoRpRKLPklIu-1YyQ3E","mapLayerId":"4o-_1YN0gPygZOPzLdtTP","linkedMapLayerId":null,"name":"The Deep","description":"Gall below the cloud deck: thousands of kilometres of crushing heat. Dippers give their dead to it.","x":480,"y":500,"imageId":null,"iconType":"region","tags":[],"factionId":null,"createdAt":1793092647442,"updatedAt":1793092647442},{"id":"F04q_aUNrnRTy83UMXQHh","worldId":"qazoRpRKLPklIu-1YyQ3E","mapLayerId":"GuSCi2SF9D-U0AOs7WScb","linkedMapLayerId":"uKU7vxBMqFnq6vDOH-25S","name":"Tarn","description":"A poor system of debt and docks, two lanes from Corva.","x":1120,"y":500,"imageId":null,"iconType":"region","tags":[],"factionId":null,"createdAt":1793092647442,"updatedAt":1793092647442},{"id":"HUZeye6elZuj2Q3eVtmQ6","worldId":"qazoRpRKLPklIu-1YyQ3E","mapLayerId":"-3FUCPr-YvwqnxSW