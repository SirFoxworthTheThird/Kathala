{"version":19,"type":"full","exportedAt":1793110171021,"world":{"id":"qazoRpRKLPklIu-1YyQ3E","name":"The Long Round","description":"A gritty space opera in three eras. A weapon nobody could destroy is sent out on a comet in 2391, and every time the Lamp comes round, someone has to decide what to do with it.","coverImageId":null,"theme":"theme-dystopian","continuityStaleThreshold":5,"calendar":{"week":{"days":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"first":1},"leap":{"month":1,"days":1,"every":4,"skip":100,"keep":400},"startYear":2391,"yearSuffix":"","months":[{"name":"January","days":31},{"name":"February","days":28},{"name":"March","days":31},{"name":"April","days":30},{"name":"May","days":31},{"name":"June","days":30},{"name":"July","days":31},{"name":"August","days":31},{"name":"September","days":30},{"name":"October","days":31},{"name":"November","days":30},{"name":"December","days":31}]},"pinsSetClock":true,"createdAt":1793092128746,"updatedAt":1793092447428,"wordTarget":90000},"mapLayers":[{"id":"-3FUCPr-YvwqnxSWDncm8","worldId":"qazoRpRKLPklIu-1YyQ3E","parentMapId":"GuSCi2SF9D-U0AOs7WScb","name":"Corva","description":"","imageId":"dQ4zgB5BfBQpRTYERW9bX","imageWidth":1600,"imageHeight":1000,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":"","createdAt":1793092647442,"updatedAt":1793092647442},{"id":"4o-_1YN0gPygZOPzLdtTP","worldId":"qazoRpRKLPklIu-1YyQ3E","parentMapId":"-3FUCPr-YvwqnxSWDncm8","name":"Gall","description":"","imageId":"dQ4zgB5BfBQpRTYERW9bX","imageWidth":1600,"imageHeight":1000,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":"","createdAt":1793092647442,"updatedAt":1793092647442},{"id":"BjqRUSF6ANg3YL8Aw4pE8","worldId":"qazoRpRKLPklIu-1YyQ3E","parentMapId":"-3FUCPr-YvwqnxSWDncm8","name":"Kettle","description":"","imageId":"dQ4zgB5BfBQpRTYERW9bX","imageWidth":1600,"imageHeight":1000,"scalePixelsPerUnit":null,"scaleUnit":null,"lev