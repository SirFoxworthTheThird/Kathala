{"version":18,"type":"full","exportedAt":1792365675442,"world":{"id":"U9mo43OyNFRbbaPDICLDY","name":"The Glass Ledger","description":"Venice and Murano, spring 1605. A glassmaker's widow, a disgraced notary, a forging friar and a lacemaker from Burano plan to steal a dead man's recipe book out of the Secret Chancery of the Council of Ten on Ascension Day, while the Doge marries the sea.","coverImageId":null,"theme":null,"continuityStaleThreshold":5,"calendar":{"week":{"days":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"first":5},"leap":{"month":1,"days":1,"every":4,"skip":100,"keep":400},"startYear":1605,"yearSuffix":"","months":[{"name":"January","days":31},{"name":"February","days":28},{"name":"March","days":31},{"name":"April","days":30},{"name":"May","days":31},{"name":"June","days":30},{"name":"July","days":31},{"name":"August","days":31},{"name":"September","days":30},{"name":"October","days":31},{"name":"November","days":30},{"name":"December","days":31}]},"pinsSetClock":true,"createdAt":1792359834157,"updatedAt":1792365576074,"chapterHeading":"chapter-words-title"},"mapLayers":[],"locationMarkers":[{"id":"16n4XsLlP2uBUeYAjKEZ8","worldId":"U9mo43OyNFRbbaPDICLDY","mapLayerId":null,"linkedMapLayerId":null,"name":"Santa Maria dei Servi","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1792361283646,"updatedAt":1792361283646,"version":1},{"id":"R0mBkBDRVyMFq2o3ZwHQx","worldId":"U9mo43OyNFRbbaPDICLDY","mapLayerId":null,"linkedMapLayerId":null,"name":"The Rialto","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1792361435206,"updatedAt":1792361435206,"version":1},{"id":"TpWw4M_ER2lzjchkpeZre","worldId":"U9mo43OyNFRbbaPDICLDY","mapLayerId":null,"linkedMapLayerId":null,"name":"The Ferro furnace","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1792360127902,"updatedAt":1792360127902,"version":1},{"id":"VVFAYhCHNEZmUDaywx44W","worldId":"U9mo43OyNFRbbaPDICLDY","mapLayerId":null,"linkedMapLayerId":null,"name":"Dolfin's garden","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1792361116983,"updatedAt":1792361116983,"version":1},{"id":"ZRxpwEGBQgpISsQVxOTeh","worldId":"U9mo43OyNFRbbaPDICLDY","mapLayerId":null,"linkedMapLayerId":null,"name":"The malvasia at San Zulian","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1792361097531,"updatedAt":1792361097531,"version":1},{"id":"_lztiLYMaqmi8Wbfy2JH7","worldId":"U9mo43OyNFRbbaPDICLDY","mapLayerId":null,"linkedMapLayerId":null,"name":"The Pozzi","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1792361023569,"updatedAt":1792361023569,"version":1},{"id":"fuQHrWJ_w-Rc2lnVm8U7d","worldId":"U9mo43OyNFRbbaPDICLDY","mapLayerId":null,"linkedMapLayerId":null,"name":"The Doge's Palace","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1792360994302,"updatedAt":1792360994302,"version":1},{"id":"h7jXxDVdwGXsevyp4xWyG","worldId":"U9mo43OyNFRbbaPDICLDY","mapLayerId":null,"linkedMapLayerId":null,"name":"The Secret Chancery","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1792362048386,"updatedAt":1792362048386,"version":1},{"id":"lMtVspjqa8QVfxKbrC85X","worldId":"U9mo43OyNFRbbaPDICLDY","mapLayerId":null,"linkedMapLayerId":null,"name":"The Fleming's lodging","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1792361447021,"updatedAt":1792361447021,"version":1},{"id":"lSDR1CvNDo8Foq3aD9Itp","worldId":"U9mo43OyNFRbbaPDICLDY","mapLayerId":null,"linkedMapLayerId":null,"name":"The Molo","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1792361935403,"updatedAt":1792361935403,"version":1},{"id":"umLXg1rws6szq095hI_q1","worldId":"U9mo43OyNFRbbaPDICLDY","mapLayerId":null,"linkedMapLayerId":null,"name":"The Zen house on Burano","description":"","x":0,"y":0,"imageId":null,"iconType":"landmark","tags":[],"factionId":null,"createdAt":1792361191482,"updatedAt":1792361191482,"version":1}],"characters":[{"id":"5Rhfebe9llBmAD8a7c-7Z","worldId":"U9mo43OyNFRbbaPDICLDY","name":"Matteo Lion","aliases":[],"description":"Forty. Once a notary of the Avogaria, struck from the roll for selling copies of sealed depositions. Knows the Palace stairs like his own debts. Owes Zuane Dolfin two hundred ducats, and therefore owes him everything.","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1792360843271,"updatedAt":1792360843271},{"id":"9dHiE7EeTioUNE8vV0KFG","worldId":"U9mo43OyNFRbbaPDICLDY","name":"Pieter Vos","aliases":[],"description":"A Flemish merchant lodging near the Rialto, buyer of oil, currants and secrets for an Antwerp glasshouse. Generous with wine and promises.","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1792360846464,"updatedAt":1792360846464},{"id":"AczlTPP9E3_oBwWVaHyee","worldId":"U9mo43OyNFRbbaPDICLDY","name":"Alvise Contarini","aliases":[],"description":"One of the three Capi of the Council of Ten this year. Seventy, deaf in one ear, incorruptible in the way of men who have never needed money. Once trusted a young notary called Matteo Lion.","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1792362065315,"updatedAt":1792362065315},{"id":"VYmV5MC0GNPpKG9aYeDrl","worldId":"U9mo43OyNFRbbaPDICLDY","name":"Fra Anselmo","aliases":[],"description":"A Servite friar at Santa Maria dei Servi, sixty, half-blind in one eye. Cuts seals and copies hands for the scriptorium, and for anyone else who brings him a good reason and a better wine.","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1792360844372,"updatedAt":1792360844372},{"id":"WgRrnwA_j52q6qMwngup2","worldId":"U9mo43OyNFRbbaPDICLDY","name":"Bortolo Ferro","aliases":[],"description":"Master glassmaker of Murano, dead before the story opens. Found the lost calcedonio glass in the last winter of his life.","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1792360848512,"updatedAt":1792360848512},{"id":"_x741Dso4igMjm3KHsYLZ","worldId":"U9mo43OyNFRbbaPDICLDY","name":"Orsato","aliases":[],"description":"","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1792360197934,"updatedAt":1792360197934},{"id":"b5oBGejtY2kQ7Age1-x-o","worldId":"U9mo43OyNFRbbaPDICLDY","name":"Sanudo","aliases":[],"description":"","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1792362044250,"updatedAt":1792362044250},{"id":"i-7K4GpRSz6BeCfFM6Xo4","worldId":"U9mo43OyNFRbbaPDICLDY","name":"Isotta Ferro","aliases":[],"description":"Thirty-eight. Widow of the master glassmaker Bortolo Ferro of Murano. Knows the furnace better than he did and was never allowed to say so. Her son Nane is in the prisons of the Ten.","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1792359931434,"updatedAt":1792359931434},{"id":"ovmu-1zRoQUHJcKMDmj3J","worldId":"U9mo43OyNFRbbaPDICLDY","name":"Lucia Zen","aliases":[],"description":"","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1792360794049,"updatedAt":1792360794049},{"id":"pNOF6-elHY4Ah992NcN4a","worldId":"U9mo43OyNFRbbaPDICLDY","name":"Nane Ferro","aliases":[],"description":"Giovanni, called Nane. Seventeen. Isotta's son, burnt hand, his father's talent and none of his patience. Caught boarding a Flemish ship and held in the Pozzi.","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1792360847530,"updatedAt":1792360847530},{"id":"txMWhAmoQ5MKX1y3i93KU","worldId":"U9mo43OyNFRbbaPDICLDY","name":"Zuane Dolfin","aliases":[],"description":"Secretary to the Council of Ten. Patient, courteous, never raises his voice. Means to give the Republic the calcedonio receipt and himself the credit, or failing that, to sell it.","portraitImageId":null,"tags":[],"isAlive":true,"color":null,"birthDate":null,"version":1,"createdAt":1792360845415,"updatedAt":1792360845415}],"items":[{"id":"MJYhBoZeAPreO4Kr6mblb","imageId":null,"worldId":"U9mo43OyNFRbbaPDICLDY","name":"The Glass Ledger","description":"","iconType":"misc","tags":[],"version":1},{"id":"R4e-2sxbj_gZaRB_D1LcN","imageId":null,"worldId":"U9mo43OyNFRbbaPDICLDY","name":"The lattimo bead","description":"","iconType":"misc","tags":[],"version":1},{"id":"RsSfekRKuEOEmCxw_xMa_","imageId":null,"worldId":"U9mo43OyNFRbbaPDICLDY","name":"The false ledger","description":"","iconType":"misc","tags":[],"version":1},{"id":"_FPN4RxC6yV2A7mHlLaae","imageId":null,"worldId":"U9mo43OyNFRbbaPDICLDY","name":"The forged warrant","description":"","iconType":"misc","tags":[],"version":1},{"id":"g6ad0oJFJt4lFIuMDaJBm","imageId":null,"worldId":"U9mo43OyNFRbbaPDICLDY","name":"Dolfin's letter to Vos","description":"","iconType":"misc","tags":[],"version":1},{"id":"gCM3h3dUMJDLAM-5ZyRUn","imageId":null,"worldId":"U9mo43OyNFRbbaPDICLDY","name":"The calcedonio lace","description":"","iconType":"misc","tags":[],"version":1},{"id":"nrIW7KtdfsAJXeZeqVJzw","imageId":null,"worldId":"U9mo43OyNFRbbaPDICLDY","name":"The calcedonio leaf","description":"","iconType":"misc","tags":[],"version":1}],"characterSnapshots":[{"worldId":"U9mo43OyNFRbbaPDICLDY","characterId":"VYmV5MC0GNPpKG9aYeDrl","eventId":"skVwObWMZbfNYo854ju6n","isAlive":true,"currentLocationMarkerId":"16n4XsLlP2uBUeYAjKEZ8","currentMapLayerId":null,"inventoryItemIds":["_FPN4RxC6yV2A7mHlLaa