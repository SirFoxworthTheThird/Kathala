Id":"WrAObMdV1iWydr79-9UFa","relationshipId":"ydxefG87J2WfnByzHGZVU","eventId":"A-FY7Nsk-WNvo5oEcOFBQ","label":"Allies","strength":"moderate","sentiment":"neutral","description":"","isActive":true,"sortKey":5.000002,"createdAt":1792003195114,"updatedAt":1792003195114,"version":1},{"id":"e7ImB5aSts0qh2ehmhBPh","worldId":"WrAObMdV1iWydr79-9UFa","relationshipId":"fUEFNpaVhsKWPtLwbQ3pZ","eventId":"aPPcTYkeKSmaIe0ROn2nf","label":"Betrayed and forgiven","strength":"moderate","sentiment":"neutral","description":"","isActive":true,"sortKey":17.000002,"createdAt":1792003218522,"updatedAt":1792003372940,"version":2},{"id":"jy_zgDdYKzT2HjX0RXt3f","worldId":"WrAObMdV1iWydr79-9UFa","relationshipId":"ydxefG87J2WfnByzHGZVU","eventId":"PT3XmRi-JWp5KBrckDnPd","label":"Lovers","strength":"moderate","sentiment":"neutral","description":"","isActive":true,"sortKey":17.000001,"createdAt":1792003210586,"updatedAt":1792003210586,"version":1},{"id":"o-ps6dNtvy45WbIur0Jm4","worldId":"WrAObMdV1iWydr79-9UFa","relationshipId":"_dCXYDHEhJm63n-7yqUgk","eventId":"sF9VgWmMxXsRL0Uof77T-","label":"Defied","strength":"moderate","sentiment":"neutral","description":"","isActive":true,"sortKey":20.000002,"createdAt":1792003226618,"updatedAt":1792003380436,"version":2}],"timelines":[{"id":"2C_KFJInWvb7XqYycox3b","dayOffset":113491,"worldId":"WrAObMdV1iWydr79-9UFa","name":"The Compact","description":"","color":"#34d399","createdAt":1791998679696,"version":8},{"id":"XiOosvS4HJ4RDWPn0l1G-","dayOffset":301,"worldId":"WrAObMdV1iWydr79-9UFa","name":"The Mercy","description":"","color":"#6366f1","createdAt":1791998174249,"version":5},{"id":"cWTtwvDU23FxyxXommY3Q","dayOffset":271041,"worldId":"WrAObMdV1iWydr79-9UFa","name":"The Quiet","description":"","color":"#f87171","createdAt":1791998719461,"version":6}],"chapters":[{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"cWTtwvDU23FxyxXommY3Q","number":3,"title":"Salvage Rights","synopsis":"","id":"0g4q4BKsONbyeafpVgUBB","createdAt":1792001382267,"updatedAt":1792001568010,"version":4},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"cWTtwvDU23FxyxXommY3Q","number":12,"title":"Fane's Terms","synopsis":"Fane takes the Sixpence as surety and claims the Choir is the Mercy's lost reactor cores. Brother Lio tells the Litany of the Opener and a burned heresy: she kept faith.","id":"15yYcAyVI-VduP-pMCafa","createdAt":1792001820664,"updatedAt":1792001820664,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"2C_KFJInWvb7XqYycox3b","number":20,"title":"Tricentennial","synopsis":"The last rows decoded. On the Tricentennial Neve puts the First Warden's words on every screen; the Kin take the last pages. Rhee sounds the ice, sees four thousand warm points, and fires into empty ice.","id":"AhvaLzd1_DzHbxEM1-M_s","createdAt":1792001999041,"updatedAt":1792001999041,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"cWTtwvDU23FxyxXommY3Q","number":21,"title":"The Cold Choir","synopsis":"Fane dies at the first pod he tries to strip. In the pilot cell, Ilse Varga and her letter. Kit chooses Row Thirty-One, berth twelve, and Ama Okafor wakes.","id":"Ck65lz4jRJq0djTW0CzcT","createdAt":1792002020674,"updatedAt":1792002020674,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"2C_KFJInWvb7XqYycox3b","number":11,"title":"Interdict","synopsis":"Rhee Salvador's marines fire on the Shaft Twelve barricade; a boy dies. In the twelfth vault Neve finds the Interdict order and the Breach report with the Opener's name cut out.","id":"GIN0a3iJUiFcMzJ9OZdNt","createdAt":1792001799100,"updatedAt":1792001799100,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"2C_KFJInWvb7XqYycox3b","number":5,"title":"Margins","synopsis":"Neve finds iron-gall pinpricks in the Roll's margins \u2014 a cipher \u2014 and a line pricked inside the back board. At the talks the Warden-General refuses, flatly, to lift the Interdict.","id":"KekU-ws-szDMyNAVY7-BP","createdAt":1792001663075,"updatedAt":1792001663075,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"2C_KFJInWvb7XqYycox3b","number":8,"title":"The Key of Office","synopsis":"The Investiture: Neve sees the Key of Office is an engineer's wrench with I.V. on its collar. Mother Calloway: the Four Thousand were never struck through; the ice sings.","id":"LnOKE6c2uqJnrYU0gjRN3","createdAt":1792001727811,"updatedAt":1792001727811,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"XiOosvS4HJ4RDWPn0l1G-","number":7,"title":"Ninth Deck Order","synopsis":"Hollin's watch secures Deck Nine and engineers measure the clamps for release. Tamsin overheard Kesh: vent the hold and let it go into Hesper at the Landfall burn.","id":"NnF4ev2igEnpDYNYpBuPm","createdAt":1792001706021,"updatedAt":1792001706021,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"cWTtwvDU23FxyxXommY3Q","number":6,"title":"The Names","synopsis":"Kit sings the Kin map-song and reads her book of Names. Saba Nkemelu, Osh's old partner, knows where a Navy cutter's flight recorder lies in the Grind.","id":"OsY1Ye8KaJWppV3uVVpLI","createdAt":1792001684561,"updatedAt":1792001684561,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"XiOosvS4HJ4RDWPn0l1G-","number":13,"title":"Quartermaster","synopsis":"The quartermaster's store burns; Bram throws Ilse the Ledger and dies holding the door. Kesh names Ilse on the address. Ilse gives the Ledger to Tamsin.","id":"_4LrF9-wwXs0Rvr1hBdaP","createdAt":1792001842262,"updatedAt":1792001842262,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"XiOosvS4HJ4RDWPn0l1G-","number":10,"title":"The Charter","synopsis":"Bram opens the strongbox: the Charter makes the sleepers the owners and the crew their servants \u2014 unless the sleepers die. Ilse refuses Kesh the key; Hollin's men head for the stores.","id":"f4EVtAU7tmtftyqY2cYt2","createdAt":1792001771262,"updatedAt":1792001771262,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"2C_KFJInWvb7XqYycox3b","number":14,"title":"Plaintext","synopsis":"Keyed to the name counted thirty-three times, the cipher opens: the Opener kept faith. Hal confesses forty years of silence and begs Neve to burn it.","id":"gfJN8Gg16zIjd9_3HzYxL","createdAt":1792001864105,"updatedAt":1792001864105,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"XiOosvS4HJ4RDWPn0l1G-","number":4,"title":"The Air Budget","synopsis":"Lund's numbers: the Mercy is three million tonnes too heavy to make orbit, and the sleeper hold is the only thing big enough to lose. Bram shows Ilse his daughter's name in the Ledger.","id":"hX5cQ9km1A5cSpLTB03Lr","createdAt":1792001636485,"updatedAt":1792001636485,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"2C_KFJInWvb7XqYycox3b","number":17,"title":"The Informer","synopsis":"Jory is arrested on information received. Hal admits he informed, and gives Neve the Prime's authority over the Spine screens and a dead woman's note: the First Warden was the navigator.","id":"kYRq_sE9MbMt5Zk_QFd2A","createdAt":1792001933993,"updatedAt":1792001933993,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"XiOosvS4HJ4RDWPn0l1G-","number":1,"title":"Deceleration","synopsis":"","id":"k_z2PIql-8qcLDlb0MTPd","createdAt":1791998174267,"updatedAt":1791999380445,"version":2},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"cWTtwvDU23FxyxXommY3Q","number":15,"title":"Ninefold","synopsis":"Gallows Town, dead; the Union Hall's plaque. At the point on the ice, a made thing at 284 metres, a hum in the ice \u2014 and Fane's people plan for after the drilling.","id":"oPWoEdpyY6J8pdLSlJ8bA","createdAt":1792001885654,"updatedAt":1792001885654,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"2C_KFJInWvb7XqYycox3b","number":2,"title":"The Hall of Muster","synopsis":"","id":"oXhX3ITuXvpp7IFjGi5Zw","createdAt":1792001226780,"updatedAt":1792001558156,"version":5},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"cWTtwvDU23FxyxXommY3Q","number":9,"title":"The Obedient","synopsis":"Through the Grind to the wreck of the Obedient. Her recorder gives the Navy's station-keeping point on Ninefold \u2014 and a sealed fire-control file dated Landfall Day 311.","id":"p1gACkws7FAJfKlFrdi07","createdAt":1792001749351,"updatedAt":1792001749351,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"XiOosvS4HJ4RDWPn0l1G-","number":16,"title":"The Drop Bay","synopsis":"In the Drop Bay, Ilse finds the yard drawings: Deck Nine is a lander. Tamsin agrees to plot the burn and to lie on the bridge.","id":"x18zpiVbxRLSVn2V_mZWm","createdAt":1792001907509,"updatedAt":1792001907509,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"cWTtwvDU23FxyxXommY3Q","number":18,"title":"The Key","synopsis":"The drill finds a hatch with a lock only the Key fits. Osh and Saba steal it from Fane's dome; Saba is shot. Kit reads the Names and Osh sees what they are.","id":"xwB20wMZks1BcFbZ9v1rz","createdAt":1792001955856,"updatedAt":1792001955856,"version":1},{"notes":"","wordGoal":null,"worldId":"WrAObMdV1iWydr79-9UFa","timelineId":"XiOosvS4HJ4RDWPn0l1G-","number":19,"title":"Landfall","synopsis":"The Landfall burn. Tamsin lies about frozen valves; Hollin looks at a wall; Ilse opens the clamps and flies Deck Nine down to Ninefold. Kesh makes Tamsin Warden, and she begins to prick the Ledger.","id":"ygLpgGRW39eXKIpU2ip-k","createdAt":1792001977551,"updatedAt":1792001977551,"version":1}],"events":[{"travelDays":1,"inWorldTime":null,"tension":3,"structureBeat":null,"status":"revised","povCharacterId":"YTdh3UFvZumhwAMKsW3EX","isFlashback":false,"mentionedCharacterIds":[],"threadIds":["1kPY9Aa68t44xY4D8Ph9Z","1C3jNaaOIU09WYBVXM8Ex"],"motifIds":["RYypNETDzf1D236Rrktvm"],"worldId":"WrAObMdV1iWydr79-9UFa","chapterId":"LnOKE6c2uqJnrYU0gjRN3","timelineId":"2C_KFJInWvb7XqYycox3b","title":"Mother Calloway's Song","description":"","locationMarkerId":"V6KUDzVSv4lmRZMLasSVx","involvedCharacterIds":["YTdh3UFvZumhwAMKsW3EX","_IRYdIL6_P3jdFlS5mLgo","WIHijinlYh_XtLLwh55Wj"],"involvedItemIds":[],"tags":[],"id":"-xco6-C-HrTUTl2ffNwzy","sortOrder":2,"createdAt":1792001735350,"updatedAt":1792004563736,"version":8,"remoteCharacterIds":[]},{"travelDays":null,"inWorldTime":40,"tension":3,"structureBeat":null,"status":"revised","povCharacterId":"YTdh3UFvZumhwAMKsW3EX","isFlashback":false,"mentionedCharacterIds":["guiFYjTdkRUB3YoIW0Qu-"],"threadIds":["5huREWH_2f-0OvhIlUhfv","GgFoQDftKVZPZs2LOSL63"],"motifIds":[],"worldId":"WrAObMdV1iWydr79-9UFa","chapterId":"LnOKE6c2uqJnrYU0gjRN3","timelineId":"2C_KFJInWvb7XqYycox3b","title":"Investiture","description":"","locationMarkerId":"FjkJFggKTvQonCgHoICS1","involvedCharacterIds":["YTdh3UFvZumhwAMKsW3EX","Siy2D1Sem0I7mSho9bIsU","ROPxwJaWAjd8IneEw1TTo","Em986PAmamkpIkk5l0tev"],"involvedItemIds":["Q_DoL-UpW5ZUBmO9bwT-v"],"tags":[],"id":"1JGfbSDxpkibhrsZzFBIJ","sortOrder":1,"createdAt":1792001733694,"updatedAt":1792004558274,"version":9,"remoteCharacterIds":[]},{"travelDays":1,"inWorldTime":null,"tension":4,"structureBeat":null,"status":"revised","povCharacterId":"UmIFHig8VkkgpbF8ao84U","isFlashback":false,"mentionedCharacterIds":["0O4hn5qD0gGcfRwtJRZqF","rF9q0I-cFStCoUa92LlLq"],"threadIds":["P8on_ihLyj1W6hQ8gz1A_"],"motifIds":["RYypNETDzf1D236Rrktvm"],"worldId":"WrAObMdV1iWydr79-9UFa","chapterId":"_4LrF9-wwXs0Rvr1hBdaP","timelineId":"XiOosvS4HJ4RDWPn0l1G-","title":"Tamsin Takes the Book","description":"","locationMarkerId":"4jf9axgqen2qDyUdWny3I","involvedCharacterIds":["UmIFHig8VkkgpbF8ao84U","XaxoK6B9LtT