  "lorePages": [
    {
      "worldId": "os-maias-world",
      "createdAt": 1789387200000,
      "updatedAt": 1789387200000,
      "id": "os-maias-lore-fonte",
      "categoryId": "os-maias-lore-category-fonte",
      "title": "Texto integral em domínio público",
      "body": "O manuscrito reproduz integralmente os 18 capítulos de Os Maias: episodios da vida romantica, edição Ernesto Chardron de 1888, transcrição Project Gutenberg n.º 40409, https://www.gutenberg.org/ebooks/40409. Os títulos descritivos, as divisões em cenas e o calendário são editoriais. A ortografia histórica da transcrição foi preservada.",
      "tags": [
        "fonte",
        "domínio público"
      ],
      "coverImageId": "os-maias-image-world-cover",
      "linkedEntityIds": [],
      "visibleFromEventId": null
    },
    {
      "worldId": "os-maias-world",
      "createdAt": 1789387200000,
      "updatedAt": 1789387200000,
      "id": "os-maias-lore-regeneracao",
      "categoryId": "os-maias-lore-category-portugal",
      "title": "Lisboa e a Regeneração",
      "body": "A modernização material da capital convive com instituições frágeis, dependência cultural e uma elite que substitui ação por conversa.",
      "tags": [
        "história",
        "Lisboa"
      ],
      "coverImageId": "os-maias-image-location-avenida",
      "linkedEntityIds": [
        "os-maias-loc-avenida"
      ],
      "visibleFromEventId": "os-maias-event-001"
    },
    {
      "worldId": "os-maias-world",
      "createdAt": 1789387200000,
      "updatedAt": 1789387200000,
      "id": "os-maias-lore-calendario",
      "categoryId": "os-maias-lore-category-fonte",
      "title": "Cronologia editorial",
      "body": "As datas relativas organizam analepses e ação principal sem fingir precisão que o romance não fornece. Os primeiros capítulos recuam na história familiar; a sequência principal começa no outono de 1875 e o epílogo decorre em 1887.",
      "tags": [
        "calendário",
        "editorial"
      ],
      "coverImageId": "os-maias-image-item-relogio-afonso",
      "linkedEntityIds": [],
      "visibleFromEventId": null
    }
  ],
