  "characterGoals": [
    {
      "worldId": "jekyll-hyde-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "jekyll-hyde-goal-1",
      "characterId": "jekyll-hyde-char-utterson",
      "startEventId": "jekyll-hyde-event-1",
      "endEventId": "jekyll-hyde-event-33",
      "type": "want",
      "text": "Discover who Hyde is and protect Jekyll from coercion or murder."
    },
    {
      "worldId": "jekyll-hyde-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "jekyll-hyde-goal-2",
      "characterId": "jekyll-hyde-char-jekyll",
      "startEventId": "jekyll-hyde-event-40",
      "endEventId": "jekyll-hyde-event-47",
      "type": "want",
      "text": "Separate forbidden desire from respectable identity while preserving both lives."
    },
    {
      "worldId": "jekyll-hyde-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "jekyll-hyde-goal-3",
      "characterId": "jekyll-hyde-char-hyde",
      "startEventId": "jekyll-hyde-event-41",
      "endEventId": "jekyll-hyde-event-32",
      "type": "want",
      "text": "Live without Jekyll’s conscience, social limits, or legal consequences."
    },
    {
      "worldId": "jekyll-hyde-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "jekyll-hyde-goal-4",
      "characterId": "jekyll-hyde-char-lanyon",
      "startEventId": "jekyll-hyde-event-34",
      "endEventId": "jekyll-hyde-event-38",
      "type": "want",
      "text": "Carry out Jekyll’s instructions and record the impossible truth accurately."
    },
    {
      "worldId": "jekyll-hyde-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "jekyll-hyde-goal-5",
      "characterId": "jekyll-hyde-char-poole",
      "startEventId": "jekyll-hyde-event-11",
      "endEventId": "jekyll-hyde-event-32",
      "type": "want",
      "text": "Serve Jekyll faithfully and act when the cabinet occupant threatens him."
    },
    {
      "worldId": "jekyll-hyde-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "jekyll-hyde-goal-6",
