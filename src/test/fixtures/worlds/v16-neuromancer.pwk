  "timelines": [
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-timeline-main",
      "name": "The Straylight Run",
      "description": "One forward chronology measured in editorial mission days from the opening in Chiba; memories and simulations are marked as flashbacks within it.",
      "color": "#2bd7ca",
      "dayOffset": 0
    }
  ],
  "chapters": [
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-01",
      "timelineId": "neuromancer-timeline-main",
      "number": 1,
      "title": "Chapter 1",
      "summary": "Case’s debts, Linda’s deception, and Molly’s arrival close his last Night City circuit.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-02",
      "timelineId": "neuromancer-timeline-main",
      "number": 2,
      "title": "Chapter 2",
      "summary": "Armitage buys Case’s repair, binds him with toxin sacs, and Linda is killed.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-03",
      "timelineId": "neuromancer-timeline-main",
      "number": 3,
      "title": "Chapter 3",
      "summary": "In the Sprawl, Case receives a deck, learns the Sense/Net target, and returns to the matrix.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-04",
      "timelineId": "neuromancer-timeline-main",
