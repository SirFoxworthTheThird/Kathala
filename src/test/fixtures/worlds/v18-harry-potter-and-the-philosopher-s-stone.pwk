ctionBId":"faction-voldemort","stance":"hostile","notes":"Harry and his Gryffindor friends directly thwart Voldemort's attempt to take the Stone.","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"fr-hogwarts-gryffindor","worldId":"hp-ps-world","factionAId":"faction-hogwarts","factionBId":"faction-gryffindor","stance":"allied","notes":"Gryffindor is one of Hogwarts' four constituent houses.","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"fr-hogwarts-slytherin","worldId":"hp-ps-world","factionAId":"faction-hogwarts","factionBId":"faction-slytherin","stance":"allied","notes":"Slytherin is one of Hogwarts' four constituent houses.","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"fr-hogwarts-voldemort","worldId":"hp-ps-world","factionAId":"faction-hogwarts","factionBId":"faction-voldemort","stance":"hostile","notes":"Hogwarts protects the Stone and opposes Voldemort's return.","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"fr-weasley-gryffindor","worldId":"hp-ps-world","factionAId":"faction-weasley","factionBId":"faction-gryffindor","stance":"allied","notes":"The Weasley children in the book are strongly connected to Gryffindor.","createdAt":1784505600000,"updatedAt":1784505600000}],"knowledgeFacts":[{"id":"kf-broom-jinx","worldId":"hp-ps-world","title":"Quirrell jinxed Harry's broom","description":"Quirrell caused Harry's broom to buck during the first Quidditch match while Snape tried to counter the curse.","tags":["quidditch","quirrell","snape"],"readerLearnsAtEventId":"ev-quirrell","originEventId":"ev-quidditch","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"kf-flamel-stone","worldId":"hp-ps-world","title":"Nicolas Flamel created the Philosopher's Stone","description":"Flamel is the alchemist connected to the object being protected at Hogwarts.","tags":["alchemy","stone","flamel"],"readerLearnsAtEventId":"ev-flamel","originEventId":null,"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"kf-fluffy-guards","worldId":"hp-ps-world","title":"Fluffy guards a trapdoor","description":"The three-headed dog in the forbidden corridor is protecting a trapdoor and something valuable beneath it.","tags":["fluffy","stone","secret"],"readerLearnsAtEventId":"ev-fluffy","originEventId":null,"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"kf-fluffy-music","worldId":"hp-ps-world","title":"Music sends Fluffy to sleep","description":"Fluffy's reliable weakness is music, a secret Hagrid reveals to a disguised stranger.","tags":["fluffy","weakness","secret"],"readerLearnsAtEventId":"ev-stone-in-danger","originEventId":null,"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"kf-harry-survived","worldId":"hp-ps-world","title":"Harry survived Voldemort's curse","description":"Voldemort's killing curse failed against infant Harry, leaving only a lightning-shaped scar.","tags":["history","mystery","voldemort"],"readerLearnsAtEventId":"ev-potters-truth","originEventId":null,"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"kf-harry-wizard","worldId":"hp-ps-world","title":"Harry is a wizard","description":"Harry was born magical and has a place at Hogwarts despite the Dursleys' concealment.","tags":["identity","magic"],"readerLearnsAtEventId":"ev-hut","originEventId":null,"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"kf-lily-protection","worldId":"hp-ps-world","title":"Lily's sacrifice protects Harry","description":"Lily Potter's willing sacrifice created a protection that makes Harry's touch destructive to Quirrell while he carries Voldemort.","tags":["protection","sacrifice","ancient-magic"],"readerLearnsAtEventId":"ev-hospital-explanations","originEventId":null,"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"kf-mirror-stone","worldId":"hp-ps-world","title":"The Mirror conceals the Stone","description":"Dumbledore arranged for the Mirror to give the Stone only to someone who wanted to find it without using it.","tags":["mirror","stone","protection"],"readerLearnsAtEventId":"ev-quirrell","originEventId":null,"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"kf-norbert-hatched","worldId":"hp-ps-world","title":"Hagrid is keeping an illegal dragon","description":"Hagrid's egg hatches into a Norwegian Ridgeback that cannot safely or legally remain at Hogwarts.","tags":["dragon","norbert","secret"],"readerLearnsAtEventId":"ev-dragon-egg-hatches","originEventId":"ev-dragon-egg-hatches","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"kf-potters-murder","worldId":"hp-ps-world","title":"Voldemort killed Harry's parents","description":"James and Lily Potter were murdered by Voldemort rather than dying in the car crash described by the Dursleys.","tags":["history","secret","voldemort"],"readerLearnsAtEventId":"ev-potters-truth","originEventId":null,"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"kf-quirrell-thief","worldId":"hp-ps-world","title":"Quirrell is attempting to steal the Stone","description":"Quirrell, not Snape, is the servant who broke into Gringotts and passed the protections beneath Hogwarts.","tags":["quirrell","stone","reveal"],"readerLearnsAtEventId":"ev-quirrell","originEventId":null,"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"kf-quirrell-voldemort","worldId":"hp-ps-world","title":"Voldemort inhabits Quirrell","description":"Voldemort shares Quirrell's body and directs his attempt to recover the Stone.","tags":["quirrell","voldemort","possession"],"readerLearnsAtEventId":"ev-quirrell","originEventId":null,"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"kf-stone-destroyed","worldId":"hp-ps-world","title":"The Philosopher's Stone will be destroyed","description":"Dumbledore and Flamel agree to destroy the Stone, ending the immediate route to the Elixir of Life.","tags":["stone","resolution"],"readerLearnsAtEventId":"ev-hospital-explanations","originEventId":"ev-hospital-explanations","createdAt":1784505600000,"updatedAt":17845