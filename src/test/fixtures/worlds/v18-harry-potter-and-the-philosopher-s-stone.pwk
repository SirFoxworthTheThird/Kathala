","char-dumbledore","char-dean","char-flitwick","char-nick","char-seamus","char-sorting-hat","char-sprout"],"mentionedCharacterIds":["char-binns","char-fat-lady"],"involvedItemIds":[],"tags":["hogwarts","house"],"threadIds":["thread-identity"],"sortOrder":1,"travelDays":0,"inWorldTime":3893,"tension":2,"structureBeat":null,"status":"final","povCharacterId":"char-harry","isFlashback":false,"createdAt":1784505600000,"updatedAt":1784578870204,"motifIds":[]},{"id":"ev-stone-in-danger","worldId":"hp-ps-world","chapterId":"ch-16","timelineId":"tl-first-year","title":"The Stone Is in Immediate Danger","description":"Hagrid admits he revealed Fluffy's weakness to a stranger, and the trio finds Dumbledore has been summoned away.","locationMarkerId":"loc-hagrids-hut","involvedCharacterIds":["char-harry","char-ron","char-hermione","char-hagrid","char-mcgonagall"],"mentionedCharacterIds":["char-dumbledore","char-quirrell","char-voldemort"],"involvedItemIds":["item-philosophers-stone"],"tags":["deadline","decision"],"threadIds":["thread-stone","thread-snape","thread-voldemort","thread-friendship"],"sortOrder":-3,"travelDays":21,"inWorldTime":4169,"tension":4,"structureBeat":"climax_setup","status":"final","povCharacterId":"char-harry","isFlashback":false,"createdAt":1784505600000,"updatedAt":1784578870204,"motifIds":[]},{"id":"ev-train-friendship","worldId":"hp-ps-world","chapterId":"ch-6","timelineId":"tl-first-year","title":"Sweets and New Friends","description":"Harry and Ron share food, stories, and Chocolate Frogs, beginning Harry's first genuine friendship.","locationMarkerId":"loc-hogwarts-express","involvedCharacterIds":["char-harry","char-ron","char-scabbers"],"mentionedCharacterIds":["char-dumbledore","char-flamel"],"involvedItemIds":["item-nicolas-card"],"tags":["friendship","train"],"threadIds":["thread-identity","thread-friendship"],"sortOrder":-1,"travelDays":0,"inWorldTime":3893,"tension":1,"structureBeat":null,"status":"final","povCharacterId":"char-harry","isFlashback":false,"createdAt":1784505600000,"updatedAt":1784578870204,"motifIds":[]},{"id":"ev-troll","worldId":"hp-ps-world","chapterId":"ch-10","timelineId":"tl-first-year","title":"The Mountain Troll","description":"Harry and Ron rescue Hermione from a troll in the girls' bathroom. Their shared danger makes them friends.","locationMarkerId":"loc-girls-bathroom","involvedCharacterIds":["char-harry","char-ron","char-hermione"],"mentionedCharacterIds":["char-quirrell"],"involvedItemIds":[],"tags":["danger","friendship"],"threadIds":["thread-friendship"],"sortOrder":0,"travelDays":0,"inWorldTime":3953,"tension":4,"structureBeat":"first_plot_point","status":"final","povCharacterId":"char-harry","isFlashback":false,"createdAt":1784505600000,"updatedAt":1784578870204,"motifIds":[]},{"id":"ev-vernon-strange-day","worldId":"hp-ps-world","chapterId":"ch-1","timelineId":"tl-first-year","title":"A Peculiar Day for Vernon","description":"Vernon notices owls, cloaked strangers, and whispered celebrations of the Potters while trying to preserve an ordinary day.","locationMarkerId":"loc-privet-drive","involvedCharacterIds":["char-vernon","char-petunia","char-dudley"],"mentionedCharacterIds":["char-harry","char-voldemort"],"involvedItemIds":[],"tags":["muggle-view","foreshadowing"],"threadIds":["thread-dursleys"],"sortOrder":-2,"travelDays":0,"inWorldTime":304,"tension":1,"structureBeat":"setup","status":"final","povCharacterId":"char-vernon","isFlashback":false,"createdAt":1784505600000,"updatedAt":1784578870204,"motifIds":[]},{"id":"ev-wand-chooses-harry","worldId":"hp-ps-world","chapterId":"ch-5","timelineId":"tl-first-year","title":"The Wand Chooses Harry","description":"Ollivander matches Harry with a holly wand whose phoenix-feather core is twin to Voldemort's wand.","locationMarkerId":"loc-ollivanders","involvedCharacterIds":["char-harry","char-ollivander"],"mentionedCharacterIds":["char-voldemort"],"involvedItemIds":["item-wand"],"tags":["wand","connection"],"threadIds":["thread-identity","thread-voldemort"],"sortOrder":1,"travelDays":0,"inWorldTime":3861,"tension":3,"structureBeat":null,"status":"final","povCharacterId":"char-harry","isFlashback":false,"createdAt":1784505600000,"updatedAt":1784578870204,"motifIds":[]},{"id":"ev-welcome-feast","worldId":"hp-ps-world","chapterId":"ch-7","timelineId":"tl-first-year","title":"Welcome Feast and Forbidden Warning","description":"Dumbledore welcomes the students, warns them away from the forest and third-floor corridor, and Harry notices Snape watching him.","locationMarkerId":"loc-great-hall","involvedCharacterIds":["char-harry","char-ron","char-hermione","char-dumbledore","char-snape","char-mcgonagall","char-nick","char-sorting-hat"],"mentionedCharacterIds":[],"involvedItemIds":[],"tags":["welcome","foreshadowing"],"threadIds":[],"sortOrder":2,"travelDays":0,"inWorldTime":3893,"tension":2,"structureBeat":null,"status":"final","povCharacterId":"char-harry","isFlashback":false,"createdAt":1784505600000,"updatedAt":1784578870204,"motifIds":[]},{"id":"ev-winged-keys","worldId":"hp-ps-world","chapterId":"ch-16","timelineId":"tl-first-year","title":"The Chamber of Winged Keys","description":"Harry mounts a broom and catches the battered silver key that unlocks the way forward.","locationMarkerId":"loc-underground-chambers","involvedCharacterIds":["char-harry","char-ron","char-hermione"],"mentionedCharacterIds":["char-flitwick"],"involvedItemIds":["item-winged-key","item-nimbus"],"tags":["defense","flying"],"threadIds":["thread-stone","thread-friendship"],"sortOrder":-0.5,"travelDays":0,"inWorldTime":4169,"tension":4,"structureBeat":"climax","status":"final","povCharacterId":"char-harry","isFlashback":false,"createdAt":1784505600000,"updatedAt":1784578870204,"motifIds":[]},{"id":"ev-zoo-punishment","worldId":"hp-ps-world","chapterId":"ch-2","timelineId":"tl-first-year","title":"Punished for Accidental Magic","description":"After the vanishing glass incident, the Dursleys lock Harry in his cupboard and refuse to believe his explanation.","locationMarkerId":"loc-privet-drive","involvedCharacterIds":["char-harry","char-vernon","char-petunia","char-dudley"],"mentionedCharacterIds":[],"involvedItemIds":[],"tags":["consequence","magic"],"threadIds":["thread-dursleys","thread-identity"],"sortOrder":1,"travelDays":0.25,"inWorldTime":3822,"tension":2,"structureBeat":null,"status":"final","povCharacterId":"char-harry","isFlashback":false,"createdAt":1784505600000,"updatedAt":1784578870204,"motifIds":[]}],"travelModes":[],"timelineRelationships":[],"crossTimelineArtifacts":[],"mapRoutes":[],"mapRegions":[],"mapRegionSnapshots":[],"mapAnnotations":[],"loreCategories":[{"id":"lore-cat-creatures","worldId":"hp-ps-world","name":"Magical Creatures","color":"#059669","sortOrder":3},{"id":"lore-cat-history","worldId":"hp-ps-world","name":"History and Secrets","color":"#7c3aed","sortOrder":0},{"id":"lore-cat-magic","worldId":"hp-ps-world","name":"Magic and Artifacts","color":"#d4af37","sortOrder":1},{"id":"lore-cat-school","worldId":"hp-ps-world","name":"Hogwarts Life","color":"#dc2626","sortOrder":4},{"id":"lore-cat-society","worldId":"hp-ps-world","name":"Wizarding Society","color":"#2563eb","sortOrder":2}],"lorePages":[{"id":"lore-centaurs","worldId":"hp-ps-world","categoryId":"lore-cat-creatures","title":"Centaurs of the Forbidden Forest","body":"The centaurs study the heavens and guard their independence. Firenze intervenes directly to save Harry and interprets the unicorn attacks as evidence that Voldemort seeks the Stone.","tags":["centaurs","forest","divination"],"coverImageId":null,"linkedEntityIds":["char-firenze","loc-forbidden-forest"],"visibleFromEventId":"ev-firenze-warning","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"lore-cloak","worldId":"hp-ps-world","categoryId":"lore-cat-magic","title":"The Invisibility Cloak","body":"Harry receives the cloak that belonged to his father. It conceals its wearer and enables several nighttime investigations, including the discovery of the Mirror and the journey through the trapdoor.","tags":["artifact","invisibility","potter-family"],"coverImageId":null,"linkedEntityIds":["item-invisibility-cloak","char-harry","char-james"],"visibleFromEventId":"ev-christmas-gifts","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"lore-dragons","worldId":"hp-ps-world","categoryId":"lore-cat-creatures","title":"Dragons and Norwegian Ridgebacks","body":"Dragon breeding is illegal, but Hagrid acquires an egg that hatches into a Norwegian Ridgeback named Norbert. The fast-growing dragon is eventually sent to Charlie Weasley's colleagues.","tags":["dragons","law","norbert"],"coverImageId":null,"linkedEntityIds":["char-norbert","char-hagrid","char-charlie","item-dragon-egg"],"visibleFromEventId":"ev-dragon-egg-hatches","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"lore-fluffy","worldId":"hp-ps-world","categoryId":"lore-cat-creatures","title":"Fluffy","body":"Fluffy is Hagrid's enormous three-headed dog and the first guardian protecting the trapdoor. Despite his appearance, music reliably sends him to sleep.","tags":["creature","guardian","weakness"],"coverImageId":null,"linkedEntityIds":["char-fluffy","char-hagrid","loc-third-floor","item-flute"],"visibleFromEventId":"ev-fluffy","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"lore-gringotts","worldId":"hp-ps-world","categoryId":"lore-cat-society","title":"Gringotts Wizarding Bank","body":"Gringotts is the wizarding bank in Diagon Alley, operated by goblins. Its underground vaults hold wizarding wealth and exceptionally valuable objects behind magical and physical defenses.","tags":["bank","goblins","diagon-alley"],"coverImageId":null,"linkedEntityIds":["loc-gringotts","loc-gringotts-vaults","char-griphook"],"visibleFromEventId":"ev-gringotts-vaults","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"lore-gryffindor","worldId":"hp-ps-world","categoryId":"lore-cat-school","title":"Gryffindor House","body":"Gryffindor values courage and nerve. Harry, Ron, Hermione, and Neville share the house, whose students live in Gryffindor Tower and compete in scarlet and gold.","tags":["gryffindor","house"],"coverImageId":null,"linkedEntityIds":["char-harry","char-ron","char-hermione","char-neville","loc-gryffindor-common-room","faction-gryffindor"],"visibleFromEventId":"ev-sorting","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"lore-hogwarts","worldId":"hp-ps-world","categoryId":"lore-cat-school","title":"Hogwarts School of Witchcraft and Wizardry","body":"Hogwarts is a boarding school in the Scottish Highlands. Students arrive at eleven, study magical subjects, live in one of four houses, and are governed by school rules, prefects, professors, and the headmaster.","tags":["school","institution"],"coverImageId":null,"linkedEntityIds":["loc-hogwarts-root","loc-hogwarts-castle","char-dumbledore"],"visibleFromEventId":"ev-crossing-black-lake","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"lore-lily-protection","worldId":"hp-ps-world","categoryId":"lore-cat-history","title":"Lily Potter's Protection","body":"Lily chose to die rather than step aside. Her sacrifice placed a lasting magical protection in Harry's blood, making Quirrell unable to touch Harry safely while carrying Voldemort.","tags":["ancient-magic","protection","sacrifice"],"coverImageId":null,"linkedEntityIds":["char-lily","char-harry","char-quirrell","char-voldemort"],"visibleFromEventId":"ev-hospital-explanations","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"lore-mirror","worldId":"hp-ps-world","categoryId":"lore-cat-magic","title":"The Mirror of Erised","body":"The Mirror of Erised shows the viewer's deepest desire rather than truth or knowledge. Dumbledore later uses it as the final protection for the Stone: only someone seeking the Stone without intending to use it can retrieve it.","tags":["artifact","desire","protection"],"coverImageId":null,"linkedEntityIds":["item-erised","loc-mirror-chamber","char-dumbledore"],"visibleFromEventId":"ev-mirror","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"lore-quidditch","worldId":"hp-ps-world","categoryId":"lore-cat-school","title":"Quidditch","body":"Quidditch is played in the air by two teams of seven. Chasers score with the Quaffle, Beaters manage Bludgers, Keepers defend the hoops, and Seekers pursue the Golden Snitch that usually decides the match.","tags":["sport","flying"],"coverImageId":null,"linkedEntityIds":["char-harry","char-wood","loc-quidditch-pitch","item-nimbus"],"visibleFromEventId":"ev-nimbus-training","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"lore-slytherin","worldId":"hp-ps-world","categoryId":"lore-cat-school","title":"Slytherin House","body":"Slytherin prizes ambition and cunning. Draco Malfoy, Vincent Crabbe, and Gregory Goyle join the house, while Severus Snape serves as its head.","tags":["slytherin","house"],"coverImageId":null,"linkedEntityIds":["char-draco","char-crabbe","char-goyle","char-snape","faction-slytherin"],"visibleFromEventId":"ev-sorting","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"lore-sorting-houses","worldId":"hp-ps-world","categoryId":"lore-cat-school","title":"The Sorting and the Four Houses","body":"At the opening feast, the Sorting Hat assigns each new student to Gryffindor, Hufflepuff, Ravenclaw, or Slytherin. Houses provide community and compete for points and the annual House Cup.","tags":["houses","sorting","tradition"],"coverImageId":null,"linkedEntityIds":["char-sorting-hat","loc-great-hall"],"visibleFromEventId":"ev-sorting","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"lore-stone","worldId":"hp-ps-world","categoryId":"lore-cat-magic","title":"The Philosopher's Stone","body":"Nicolas Flamel created the Philosopher's Stone. It transforms metal into gold and produces the Elixir of Life, making it a target for anyone seeking wealth or continued life.","tags":["alchemy","artifact","immortality"],"coverImageId":null,"linkedEntityIds":["item-philosophers-stone","char-flamel"],"visibleFromEventId":"ev-flamel","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"lore-stone-defenses","worldId":"hp-ps-world","categoryId":"lore-cat-magic","title":"The Defenses Beneath the Trapdoor","body":"Hogwarts professors contribute layered protections for the Stone: Fluffy, Devil's Snare, winged keys, giant wizard chess, a troll, a potions riddle, and the Mirror of Erised.","tags":["protections","stone","magic"],"coverImageId":null,"linkedEntityIds":["loc-underground-chambers","char-dumbledore","char-mcgonagall","char-flitwick","char-sprout","char-snape","char-quirrell"],"visibleFromEventId":"ev-fluffy-devils-snare","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"lore-unicorn-blood","worldId":"hp-ps-world","categoryId":"lore-cat-creatures","title":"Unicorn Blood","body":"Unicorn blood can preserve a life that is near death, but killing such a pure creature condemns the drinker to a cursed existence. Voldemort uses it in the Forbidden Forest while seeking the Stone.","tags":["unicorns","dark-magic","curse"],"coverImageId":null,"linkedEntityIds":["char-voldemort","loc-forbidden-forest"],"visibleFromEventId":"ev-forest","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"lore-voldemort-fall","worldId":"hp-ps-world","categoryId":"lore-cat-history","title":"The Fall of Voldemort","body":"The dark wizard Voldemort killed James and Lily Potter at Godric's Hollow, but his curse failed against their infant son. Voldemort vanished, and Harry became known throughout wizarding Britain as the Boy Who Lived.","tags":["history","voldemort","potter-family"],"coverImageId":null,"linkedEntityIds":["char-harry","char-voldemort","char-james","char-lily","loc-godrics-hollow"],"visibleFromEventId":"ev-dumbledore-mcgonagall","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"lore-wands","worldId":"hp-ps-world","categoryId":"lore-cat-magic","title":"Wands and Twin Cores","body":"A wand chooses its witch or wizard. Harry's holly wand contains a phoenix feather whose only other feather entered Voldemort's wand, creating a rare connection between the two.","tags":["wands","magic","foreshadowing"],"coverImageId":null,"linkedEntityIds":["item-wand","char-harry","char-voldemort","char-ollivander","loc-ollivanders"],"visibleFromEventId":"ev-wand-chooses-harry","createdAt":1784505600000,"updatedAt":1784572369772},{"id":"lore-wizarding-secrecy","worldId":"hp-ps-world","categoryId":"lore-cat-society","title":"The Hidden Wizarding World","body":"Wizarding Britain exists alongside ordinary Britain while concealing its people, institutions, transport, and commercial districts from Muggles. Entrances such as the Leaky Cauldron and Platform Nine and Three-Quarters bridge the two worlds.","tags":["society","secrecy","muggles"],"coverImageId":null,"linkedEntityIds":["loc-diagon-alley-entrance","loc-platform-nine","loc-kings-cross"],"visibleFromEventId":"ev-leaky-cauldron","createdAt":1784505600000,"updatedAt":1784505600000}],"factions":[{"id":"faction-dursley","worldId":"hp-ps-world","name":"The Dursley Household","description":"Harry's Muggle relatives, who conceal his origins and resist contact with the wizarding world.","color":"#92400e","coverImageId":null,"tags":["family","muggle"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"faction-gryffindor","worldId":"hp-ps-world","name":"Gryffindor House","description":"A Hogwarts house associated with courage, nerve, and chivalry.","color":"#b91c1c","coverImageId":null,"tags":["hogwarts-house","gryffindor"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"faction-hogwarts","worldId":"hp-ps-world","name":"Hogwarts School","description":"The faculty, staff, and enrolled students of the school.","color":"#4338ca","coverImageId":null,"tags":["school","wizarding"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"faction-slytherin","worldId":"hp-ps-world","name":"Slytherin House","description":"A Hogwarts house associated with ambition, cunning, and resourcefulness.","color":"#047857","coverImageId":null,"tags":["hogwarts-house","slytherin"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"faction-voldemort","worldId":"hp-ps-world","name":"Voldemort and His Servants","description":"The remnants of Voldemort's power and the followers working to restore him.","color":"#111827","coverImageId":null,"tags":["dark-magic","antagonist"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"faction-weasley","worldId":"hp-ps-world","name":"The Weasley Family","description":"A close-knit wizarding family that welcomes Harry and provides his first model of a loving magical household.","color":"#ea580c","coverImageId":null,"tags":["family","wizarding"],"createdAt":1784505600000,"updatedAt":1784505600000}],"factionMemberships":[{"id":"fm-1","worldId":"hp-ps-world","factionId":"faction-hogwarts","characterId":"char-dumbledore","role":"Headmaster","startEventId":null,"endEventId":null,"notes":"","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"fm-10","worldId":"hp-ps-world","factionId":"faction-hogwarts","characterId":"char-pomfrey","role":"Matron","startEventId":null,"endEventId":null,"notes":"","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"fm-11","worldId":"hp-ps-world","factionId":"faction-hogwarts","characterId":"char-binns","role":"Professor","startEventId":null,"endEventId":null,"notes":"","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"fm-12","worldId":"hp-ps-world","factionId":"faction-hogwarts","characterId":"char-harry","role":"Student","startEventId":"ev-sorting","endEventId":null,"notes":"","createdAt":1784505600000,"updatedAt":1784505600000},{"id":"fm-13","worldId":"hp-ps-world","factionId":"faction-hogwarts","characterId":"char-ron","role":"Student","startEventId":"ev-sorting","endEventId":null,"notes":"","createdAt":1784505600000,"updatedAt":1784505600000},{"id":