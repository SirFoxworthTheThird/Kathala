:"hp-map-hogwarts","inventoryItemIds":[],"inventoryNotes":"","statusNotes":"Enforces Harry’s isolation and insists that nothing unusual be tolerated.","travelModeId":null,"sortKey":1.999999,"createdAt":1784505600000,"updatedAt":1784578680582},{"id":"snap-ev-defenses-char-harry","worldId":"hp-ps-world","characterId":"char-harry","eventId":"ev-defenses","isAlive":true,"currentLocationMarkerId":"loc-underground-chambers","currentMapLayerId":"wmlBSPVS4Laplfi6JomE6","inventoryItemIds":[],"inventoryNotes":"","statusNotes":"Acts as a chess piece and obeys Ron’s strategy to reach the opposing king.","travelModeId":null,"sortKey":16,"createdAt":1784505600000,"updatedAt":1784578680582},{"id":"snap-ev-defenses-char-hermione","worldId":"hp-ps-world","characterId":"char-hermione","eventId":"ev-defenses","isAlive":true,"currentLocationMarkerId":"loc-underground-chambers","currentMapLayerId":"wmlBSPVS4Laplfi6JomE6","inventoryItemIds":[],"inventoryNotes":"","statusNotes":"Follows Ron’s tactical instructions and stays with him after his sacrifice.","travelModeId":null,"sortKey":16,"createdAt":1784505600000,"updatedAt":1784578680582},{"id":"snap-ev-defenses-char-ron","worldId":"hp-ps-world","characterId":"char-ron","eventId":"ev-defenses","isAlive":true,"currentLocationMarkerId":"loc-underground-chambers","currentMapLayerId":"wmlBSPVS4Laplfi6JomE6","inventoryItemIds":[],"inventoryNotes":"","statusNotes":"Commands the giant chess match and deliberately sacrifices himself so Harry can advance.","travelModeId":null,"sortKey":16,"createdAt":1784505600000,"updatedAt":1784578680582},{"id":"snap-ev-diagon-char-draco","worldId":"hp-ps-world","characterId":"char-draco","eventId":"ev-diagon","isAlive":true,"currentLocationMarkerId":"loc-diagon-alley","currentMapLayerId":"hp-map-london","inventoryItemIds":[],"inventoryNotes":"","statusNotes":"Boasts about wizarding blood and Hogwarts houses while being fitted for robes.","travelModeId":null,"sortKey":5,"createdAt":1784505600000,"updatedAt":1784