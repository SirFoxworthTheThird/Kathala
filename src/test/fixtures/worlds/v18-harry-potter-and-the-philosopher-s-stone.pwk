iases":[],"description":"A Slytherin first-year and one of Draco's constant companions.","portraitImageId":"z5Uq6VGf-5ebHztxuXljU","color":"#047857","tags":["slytherin","student"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784572128766,"birthDate":null,"version":1},{"id":"char-dean","worldId":"hp-ps-world","name":"Dean Thomas","aliases":[],"description":"A Gryffindor first-year and one of Harry's dormitory roommates.","portraitImageId":"Ary8W2DL8t7k8f226rW_p","color":"#d97706","tags":["gryffindor","student"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570190887,"birthDate":null,"version":1},{"id":"char-draco","worldId":"hp-ps-world","name":"Draco Malfoy","aliases":[],"description":"A Slytherin student who tries to recruit Harry and becomes his school rival.","portraitImageId":"vbQqNvbgEZn6xahDA_6bm","color":"#0f766e","tags":["rival","slytherin"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570284777,"birthDate":null,"version":1},{"id":"char-dudley","worldId":"hp-ps-world","name":"Dudley Dursley","aliases":[],"description":"Harry's spoiled cousin and childhood bully.","portraitImageId":"z42i_W-_uBSEJ54Oks216","color":"#ca8a04","tags":["dursley","family","muggle"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570315825,"birthDate":null,"version":1},{"id":"char-dumbledore","worldId":"hp-ps-world","name":"Albus Dumbledore","aliases":["Professor Dumbledore"],"description":"Headmaster of Hogwarts and one of the Stone's protectors. He understands why the Stone must be kept from Voldemort.","portraitImageId":"BElX8asznaRKdAJ9OzDYZ","color":"#7c3aed","tags":["headmaster","mentor"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784569991110,"birthDate":null,"version":1},{"id":"char-fang","worldId":"hp-ps-world","name":"Fang","aliases":[],"description":"Hagrid's large but timid boarhound.","portraitImageId":"dTNqfFa1WUCGXdssMfNSv","color":"#92400e","tags":["creature","companion"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570373506,"birthDate":null,"version":1},{"id":"char-fat-lady","worldId":"hp-ps-world","name":"The Fat Lady","aliases":[],"description":"The portrait guarding the entrance to Gryffindor Tower.","portraitImageId":"CnG0xPtZfyKJTDXwRd5Ic","color":"#ec4899","tags":["portrait","gryffindor"],"isAlive":false,"createdAt":1784505600000,"updatedAt":1784572007093,"birthDate":null,"version":1},{"id":"char-filch","worldId":"hp-ps-world","name":"Argus Filch","aliases":["Mr Filch"],"description":"Hogwarts caretaker, perpetually hunting rule-breaking students.","portraitImageId":"sDWKRpWpyxw5MpYeDpIGi","color":"#57534e","tags":["staff","caretaker"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570048063,"birthDate":null,"version":1},{"id":"char-firenze","worldId":"hp-ps-world","name":"Firenze","aliases":[],"description":"A centaur who saves Harry from Voldemort in the Forbidden Forest.","portraitImageId":"LLWGwPunjo9ggkSKhdCHd","color":"#a16207","tags":["centaur","ally"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570459991,"birthDate":null,"version":1},{"id":"char-flamel","worldId":"hp-ps-world","name":"Nicolas Flamel","aliases":[],"description":"Ancient alchemist, Dumbledore's friend, and creator of the Philosopher's Stone.","portraitImageId":"40Bmo_POPuPRFUOzjb2NC","color":"#a855f7","tags":["alchemist","mentioned"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571361393,"birthDate":null,"version":1},{"id":"char-flitwick","worldId":"hp-ps-world","name":"Filius Flitwick","aliases":["Professor Flitwick"],"description":"Charms professor and head of Ravenclaw House.","portraitImageId":"Bgd5QU5JYeG3u9Hw_6RME","color":"#2563eb","tags":["staff","ravenclaw"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570408649,"birthDate":null,"version":1},{"id":"char-fluffy","worldId":"hp-ps-world","name":"Fluffy","aliases":[],"description":"Hagrid's three-headed dog, guarding the trapdoor above the Stone's defenses.","portraitImageId":"s9AwUKKRoAHu6E-ZjrEeW","color":"#78350f","tags":["creature","guardian"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570524989,"birthDate":null,"version":1},{"id":"char-fred","worldId":"hp-ps-world","name":"Fred Weasley","aliases":[],"description":"One of Ron's mischievous older twin brothers.","portraitImageId":"3dw6zccdKPGdBCQlUxY-K","color":"#ef4444","tags":["weasley","gryffindor","student"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570566104,"birthDate":null,"version":1},{"id":"char-george","worldId":"hp-ps-world","name":"George Weasley","aliases":[],"description":"One of Ron's mischievous older twin brothers.","portraitImageId":"W_HDf7lUL-Vg4trXOz_iD","color":"#f97316","tags":["weasley","gryffindor","student"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570697956,"birthDate":null,"version":1},{"id":"char-ginny","worldId":"hp-ps-world","name":"Ginny Weasley","aliases":[],"description":"Ron's younger sister, seen with the family at King's Cross.","portraitImageId":"IDIm0EDDznmEoSDwT4XL9","color":"#e11d48","tags":["weasley","family"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570730731,"birthDate":null,"version":1},{"id":"char-goyle","worldId":"hp-ps-world","name":"Gregory Goyle","aliases":[],"description":"A Slytherin first-year and one of Draco's constant companions.","portraitImageId":"8TJOT_YoG_yv5Yp_icbRJ","color":"#065f46","tags":["slytherin","student"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570760717,"birthDate":null,"version":1},{"id":"char-griphook","worldId":"hp-ps-world","name":"Griphook","aliases":[],"description":"The Gringotts goblin who escorts Harry and Hagrid to the vaults.","portraitImageId":"sxIbESUtZKhKS4bZ3XiRH","color":"#166534","tags":["goblin","gringotts"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570797627,"birthDate":null,"version":1},{"id":"char-hagrid","worldId":"hp-ps-world","name":"Rubeus Hagrid","aliases":["Hagrid"],"description":"Hogwarts gamekeeper and Keeper of Keys and Grounds. He introduces Harry to the wizarding world and unwittingly reveals how Fluffy can be calmed.","portraitImageId":"f0vFpSQsN1Zh1hFtCR9wy","color":"#15803d","tags":["mentor","staff"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571829463,"birthDate":null,"version":1},{"id":"char-harry","worldId":"hp-ps-world","name":"Harry Potter","aliases":["The Boy Who Lived"],"description":"An eleven-year-old orphan who discovers he is a wizard and begins his first year at Hogwarts. He is drawn into the mystery surrounding the Philosopher's Stone.","portraitImageId":"8DVj7RGDjGLAwPHzMnQRI","color":"#b91c1c","tags":["protagonist","gryffindor"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570846193,"birthDate":null,"version":1},{"id":"char-hedwig","worldId":"hp-ps-world","name":"Hedwig","aliases":[],"description":"Harry's snowy owl and first birthday gift from Hagrid.","portraitImageId":"gxQlRfyt7PyO6GQH20bo9","color":"#e5e7eb","tags":["creature","companion"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570882624,"birthDate":null,"version":1},{"id":"char-hermione","worldId":"hp-ps-world","name":"Hermione Granger","aliases":[],"description":"A brilliant, determined first-year student. Initially distant from Harry and Ron, she becomes an essential member of their friendship and investigation.","portraitImageId":"5VHZFfMwe1L5I_ML6UfqA","color":"#d97706","tags":["friend","gryffindor"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570929209,"birthDate":null,"version":1},{"id":"char-hooch","worldId":"hp-ps-world","name":"Rolanda Hooch","aliases":["Madam Hooch"],"description":"Flying instructor and Quidditch referee.","portraitImageId":"9hREYIDy2g3V10fi7ER2K","color":"#4b5563","tags":["staff","quidditch"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571743338,"birthDate":null,"version":1},{"id":"char-james","worldId":"hp-ps-world","name":"James Potter","aliases":[],"description":"Harry's late father, murdered by Voldemort at Godric's Hollow.","portraitImageId":"HQfRcYyw_Q0bahU-f0eRr","color":"#991b1b","tags":["potter-family","parent","deceased"],"isAlive":false,"createdAt":1784505600000,"updatedAt":1784570961546,"birthDate":null,"version":1},{"id":"char-lee","worldId":"hp-ps-world","name":"Lee Jordan","aliases":[],"description":"Gryffindor student, friend of the twins, and Quidditch commentator.","portraitImageId":"8WV0qjhTyZLnJfYJ90UrR","color":"#c026d3","tags":["gryffindor","quidditch","student"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571018510,"birthDate":null,"version":1},{"id":"char-lily","worldId":"hp-ps-world","name":"Lily Potter","aliases":["Lily Evans"],"description":"Harry's late mother, whose sacrifice protects him from Voldemort.","portraitImageId":"BCMwgpcUcjc0BXdHR_FNT","color":"#15803d","tags":["potter-family","parent","deceased"],"isAlive":false,"createdAt":1784505600000,"updatedAt":1784571055371,"birthDate":null,"version":1},{"id":"char-malkin","worldId":"hp-ps-world","name":"Madam Malkin","aliases":[],"description":"The Diagon Alley robe-maker in whose shop Harry first meets Draco.","portraitImageId":"FmuB1sRWp_Q0WnvLOOtUR","color":"#be185d","tags":["shopkeeper","diagon-alley"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571127066,"birthDate":null,"version":1},{"id":"char-mcgonagall","worldId":"hp-ps-world","name":"Minerva McGonagall","aliases":["Professor McGonagall"],"description":"Deputy Headmistress, Transfiguration professor, and head of Gryffindor House. Strict but protective of her students.","portraitImageId":"11OTarz3Gk0R4OniYSrJ0","color":"#2563eb","tags":["staff","gryffindor"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571156166,"birthDate":null,"version":1},{"id":"char-molly","worldId":"hp-ps-world","name":"Molly Weasley","aliases":["Mrs Weasley"],"description":"Ron’s mother, who helps Harry reach the platform and sends him Christmas gifts.","portraitImageId":"DVy0JwxtUO8FjF7kOFx9n","color":"#dc2626","tags":["weasley","family"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571196650,"birthDate":null,"version":1},{"id":"char-mrs-norris","worldId":"hp-ps-world","name":"Mrs Norris","aliases":[],"description":"Filch's watchful cat and constant companion.","portraitImageId":"8Zfs1b3s_FOSqcDh-bg9l","color":"#78716c","tags":["creature","companion"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571223208,"birthDate":null,"version":1},{"id":"char-neville","worldId":"hp-ps-world","name":"Neville Longbottom","aliases":[],"description":"A nervous Gryffindor first-year who nonetheless stands up to his friends when he believes they are breaking rules.","portraitImageId":"23rqpqPT-8CX9Ikvbhb41","color":"#65a30d","tags":["gryffindor","friend"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571319570,"birthDate":null,"version":1},{"id":"char-nick","worldId":"hp-ps-world","name":"Nearly Headless Nick","aliases":["Sir Nicholas de Mimsy-Porpington"],"description":"The friendly Gryffindor house ghost.","portraitImageId":"JeiWW4zJ6jBgK9PHx65Dn","color":"#cbd5e1","tags":["ghost","gryffindor"],"isAlive":false,"createdAt":1784505600000,"updatedAt":1784571270206,"birthDate":null,"version":1},{"id":"char-norbert","worldId":"hp-ps-world","name":"Norbert","aliases":["Norberta"],"description":"Hagrid's illegally acquired baby dragon. Caring for Norbert leads Harry and Hermione into detention.","portraitImageId":"X7DosMbuEWz8IOiKpt5kp","color":"#b45309","tags":["creature","dragon"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571389622,"birthDate":null,"version":1},{"id":"char-ollivander","worldId":"hp-ps-world","name":"Garrick Ollivander","aliases":["Mr Ollivander"],"description":"The wandmaker who matches Harry with his holly wand.","portraitImageId":"TZswjtQ8WjQzNEEDJZOgc","color":"#7e22ce","tags":["wandmaker","diagon-alley"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784570596569,"birthDate":null,"version":1},{"id":"char-peeves","worldId":"hp-ps-world","name":"Peeves","aliases":[],"description":"The disruptive Hogwarts poltergeist.","portraitImageId":"13qwtDrLEbrL12VkuBI1I","color":"#8b5cf6","tags":["poltergeist","hogwarts"],"isAlive":false,"createdAt":1784505600000,"updatedAt":1784571546697,"birthDate":null,"version":1},{"id":"char-percy","worldId":"hp-ps-world","name":"Percy Weasley","aliases":[],"description":"Ron's rule-conscious older brother and a Gryffindor prefect.","portraitImageId":"X-cb-sVwkY2IJNi0cX8W7","color":"#b91c1c","tags":["weasley","gryffindor","prefect"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571595408,"birthDate":null,"version":1},{"id":"char-petunia","worldId":"hp-ps-world","name":"Petunia Dursley","aliases":["Aunt Petunia"],"description":"Harry's aunt and Lily Potter's sister, resentful of magic and fiercely protective of appearances.","portraitImageId":"LcsFTh4rauMhxCenER5J-","color":"#a16207","tags":["dursley","family","muggle"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571503864,"birthDate":null,"version":1},{"id":"char-pomfrey","worldId":"hp-ps-world","name":"Poppy Pomfrey","aliases":["Madam Pomfrey"],"description":"The Hogwarts matron who treats injured and ill students.","portraitImageId":"V3i6N6IShT0nEJe4qwqQA","color":"#db2777","tags":["staff","healer"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571651940,"birthDate":null,"version":1},{"id":"char-quirrell","worldId":"hp-ps-world","name":"Quirinus Quirrell","aliases":["Professor Quirrell"],"description":"The timid Defense Against the Dark Arts professor who is secretly serving Voldemort and seeking the Stone.","portraitImageId":"TRppTFTguOiK3dP057Wes","color":"#6b21a8","tags":["antagonist","staff"],"isAlive":false,"createdAt":1784505600000,"updatedAt":1784571674674,"birthDate":null,"version":1},{"id":"char-ron","worldId":"hp-ps-world","name":"Ron Weasley","aliases":[],"description":"Harry's loyal first friend at Hogwarts. A chess player from a large wizarding family, he joins Harry in investigating the Stone.","portraitImageId":"du0dIp-Kbm47LMyV8Okat","color":"#dc2626","tags":["friend","gryffindor"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571794392,"birthDate":null,"version":1},{"id":"char-scabbers","worldId":"hp-ps-world","name":"Scabbers","aliases":[],"description":"Ron's apparently ordinary pet rat.","portraitImageId":"phH0mz9u7HdHxMeFzONm7","color":"#a8a29e","tags":["creature","companion"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571861937,"birthDate":null,"version":1},{"id":"char-seamus","worldId":"hp-ps-world","name":"Seamus Finnigan","aliases":[],"description":"A Gryffindor first-year and one of Harry's dormitory roommates.","portraitImageId":"lRTK2tO_FR54Rx945dN_u","color":"#f59e0b","tags":["gryffindor","student"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571904496,"birthDate":null,"version":1},{"id":"char-snape","worldId":"hp-ps-world","name":"Severus Snape","aliases":["Professor Snape"],"description":"The forbidding Potions master. His apparent interest in the Stone makes him the trio's primary suspect, though his real role is more complicated.","portraitImageId":"LcqA1nLVmj1hs7gNEHBk9","color":"#374151","tags":["staff","suspect"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571956653,"birthDate":null,"version":1},{"id":"char-sorting-hat","worldId":"hp-ps-world","name":"The Sorting Hat","aliases":[],"description":"The sentient hat that assigns new Hogwarts students to their houses.","portraitImageId":"uSHsFIcLFeUC25-cU-1Lt","color":"#713f12","tags":["artifact-character","hogwarts"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784572042228,"birthDate":null,"version":1},{"id":"char-sprout","worldId":"hp-ps-world","name":"Pomona Sprout","aliases":["Professor Sprout"],"description":"Herbology professor and head of Hufflepuff House.","portraitImageId":"0mk3cKUFDO4q-4m_eYNE0","color":"#854d0e","tags":["staff","hufflepuff"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571620028,"birthDate":null,"version":1},{"id":"char-trevor","worldId":"hp-ps-world","name":"Trevor","aliases":[],"description":"Neville's frequently lost pet toad.","portraitImageId":"ChNEBE_CSccy_xkiM_kuS","color":"#65a30d","tags":["creature","companion"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784572071047,"birthDate":null,"version":1},{"id":"char-vernon","worldId":"hp-ps-world","name":"Vernon Dursley","aliases":["Uncle Vernon"],"description":"Harry's domineering Muggle uncle, determined to suppress every sign of magic.","portraitImageId":"AnwW1Eimc4CZAixkkR4YH","color":"#78716c","tags":["dursley","family","muggle"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784572101068,"birthDate":null,"version":1},{"id":"char-voldemort","worldId":"hp-ps-world","name":"Lord Voldemort","aliases":["He-Who-Must-Not-Be-Named","You-Know-Who"],"description":"The dark wizard who murdered Harry's parents. Reduced to a shadow of himself, he attempts to regain a body and power through the Stone.","portraitImageId":"ADVVwCLf99TZUzZcPwTi0","color":"#111827","tags":["antagonist","dark-wizard"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571094276,"birthDate":null,"version":1},{"id":"char-wood","worldId":"hp-ps-world","name":"Oliver Wood","aliases":[],"description":"Gryffindor Quidditch captain and Keeper, who trains Harry as Seeker.","portraitImageId":"Xnl7BbOZw64Zzhff8afzr","color":"#be123c","tags":["gryffindor","quidditch","student"],"isAlive":true,"createdAt":1784505600000,"updatedAt":1784571450498,"birthDate":null,"version":1}],"items":[{"id":"item-birthday-cake","worldId":"hp-ps-world","name":"Hagrid's Birthday Cake","description":"The misspelled birthday cake Hagrid brings Harry at the hut.","iconType":"other","imageId":"_N-43ul-bbYamAEeRwK9Q","tags":["gift","food"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"item-chess-set","worldId":"hp-ps-world","name":"Giant Wizard Chess Set","description":"McGonagall's enchanted chess defense beneath Hogwarts.","iconType":"artifact","imageId":"xsm_1tkJRT09V3dLsvagA","tags":["magical","defense"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"item-deluminator","worldId":"hp-ps-world","name":"Deluminator","description":"Dumbledore's device for extinguishing and restoring street lamps.","iconType":"artifact","imageId":"Xw-UJ0ahu9uyiqNSXRpIt","tags":["magical","tool"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"item-dragon-egg","worldId":"hp-ps-world","name":"Norwegian Ridgeback Egg","description":"The dragon egg Hagrid wins from a disguised stranger.","iconType":"other","imageId":"XB4YOSvXo8YJ9fpqwLuEh","tags":["dragon","illegal"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"item-erised","worldId":"hp-ps-world","name":"Mirror of Erised","description":"A mirror that shows the viewer their deepest desire. Dumbledore adapts it as the final defense for the Stone.","iconType":"artifact","imageId":"C-BXgQhAL2zF8ZOqtDqFn","tags":["magical","defense"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"item-flute","worldId":"hp-ps-world","name":"Wooden Flute","description":"Hagrid's Christmas gift to Harry, later used to keep Fluffy asleep.","iconType":"other","imageId":"_uTk0zjlRQ12L8cytzDNM","tags":["music","gift"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"item-invisibility-cloak","worldId":"hp-ps-world","name":"Invisibility Cloak","description":"A silvery cloak that conceals its wearer. It belonged to Harry's father and is returned to Harry anonymously.","iconType":"clothing","imageId":"j2sNIfhjhclPq6-8NUGsK","tags":["magical","heirloom"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"item-letter","worldId":"hp-ps-world","name":"Hogwarts Letter","description":"Harry's acceptance letter, which finally reveals that he has a place at Hogwarts.","iconType":"document","imageId":"OrGFvhl4gW0RnD8-Fvsjs","tags":["invitation"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"item-motorcycle","worldId":"hp-ps-world","name":"Flying Motorcycle","description":"The enchanted motorcycle Hagrid uses to bring baby Harry to Privet Drive.","iconType":"other","imageId":"7dCB7do7ngGKh9PP1PBn4","tags":["magical","transport"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"item-nicolas-card","worldId":"hp-ps-world","name":"Nicolas Flamel Card","description":"A Chocolate Frog card that provides the clue linking Nicolas Flamel to the Philosopher's Stone.","iconType":"document","imageId":"7agl0CVJk9L9I0Xrrhex4","tags":["clue"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"item-nimbus","worldId":"hp-ps-world","name":"Nimbus 2000","description":"Harry's first broomstick, supplied for his role as Gryffindor Seeker.","iconType":"other","imageId":"FHUTPNq_CbSbZoT1wgMIB","tags":["quidditch","broom"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"item-philosophers-stone","worldId":"hp-ps-world","name":"Philosopher's Stone","description":"An alchemical stone capable of producing the Elixir of Life and transforming metal into gold. It is hidden at Hogwarts for safekeeping.","iconType":"artifact","imageId":"mZQYmVgCSrTNLm4r9aj3h","tags":["magical","objective"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"item-remembrall","worldId":"hp-ps-world","name":"Neville's Remembrall","description":"A glass ball that glows red when its owner has forgotten something.","iconType":"artifact","imageId":"Ds03NXDiEYY3dJgkprveJ","tags":["magical","school"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"item-vault-package","worldId":"hp-ps-world","name":"Vault 713 Package","description":"The small paper-wrapped package Hagrid retrieves for Dumbledore, containing the Stone.","iconType":"container","imageId":"8HPNOtifK2vDGp6Ja7Hh1","tags":["mystery","stone"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"item-wand","worldId":"hp-ps-world","name":"Harry's Wand","description":"A holly wand with a phoenix-feather core, paired with the wand that gave Harry his scar.","iconType":"artifact","imageId":"S9wiM0QXz4njN0fNFhUwg","tags":["magic","wand"],"createdAt":1784505600000,"updatedAt":1784505600000},{"id":"item-winged-key","worldId":"hp-ps-world","name":"Winged Key","description":"The battered silver key Harry catches to unlock the next chamber.","iconType":"key","imageId":"zYtDGRv_pWRCn_CYWqUdk","tags":["magical","defense"],"createdAt":1784505600000,"updatedAt":1784505600000}],"characterSnapshots":[{"id":"snap-ev-baby-harry-char-dumbledore","worldId":"hp-ps-world","characterId":"char-dumbledore","eventId":"ev-baby-harry","isAlive":true,"currentLocationMarkerId":"loc-privet-drive","currentMapLayerId":"hp-map-hogwarts","inventoryItemIds":[],"inventoryNotes":"","statusNotes":"Leaves Harry with a letter explaining the child's history and trusts the protection of his relatives.","travelModeId":null,"sortKey":1,"createdAt":1784505600000,"updatedAt":1784578680582},{"id":"snap-ev-baby-harry-char-hagrid","worldId":"hp-ps-world","characterId":"char-hagrid","eventId":"ev-baby-harry","isAlive":true,"currentLocationMarkerId":"loc-privet-drive","currentMapLayerId":"hp-map-hogwarts","inventoryItemIds":[],"inventoryNotes":"","statusNotes":"Heartbroken to part with Harry after carrying him safely from Godric’s Hollow.","travelModeId":null,"sortKey":1,"createdAt":1784505600000,"updatedAt":1784578680582},{"id":"snap-ev-baby-harry-char-mcgonagall","worldId":"hp-ps-world","characterId":"char-mcgonagall","eventId":"ev-baby-harry","isAlive":true,"currentLocationMarkerId":"loc-privet-drive","currentMapLayerId":"hp-map-hogwarts","inventoryItemIds":[],"inventoryNotes":"","statusNotes":"Reluctantly accepts Dumbledore’s plan while watching over the sleeping child.","travelModeId":null,"sortKey":1,"createdAt":1784505600000,"updatedAt":1784578680582},{"id":"snap-ev-caught-after-norbert-char-draco","worldId":"hp-ps-world","characterId":"char-draco","eventId":"ev-caught-after-n